{"id": "q_235a381439c8", "type": "number", "answer": 2744100, "_code": "import pandas as pd\no=data['BanHang_HoaDon'].drop_duplicates('Order ID').copy(); p=data['BanHang_PhieuThu'].drop_duplicates()\no['d']=parse_date(o['Ngày bán']); asof=pd.Timestamp(as_of_date)\no=o[(o['Trạng thái']!='Không giao được')&(o['Phương thức TT']!='Thu hộ (COD)')&(o['Nguồn đơn']!='tmdt')]\no=o[(asof-o.d).dt.days>7]\np['t']=pd.to_datetime(p['Thời gian thu'],errors='coerce')\np=p[p.t<asof+pd.Timedelta(days=1)]\npaid=p.assign(a=to_num(p['Số tiền thu'])).groupby('Mã bill').a.sum()\no['debt']=to_num(o['Tong tien'])-o['Order ID'].map(paid).fillna(0)\nRESULT=int(o[o.debt>0].debt.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3d33c5ce3a37", "type": "number", "answer": 396800, "_code": "\nn=DanhSachNhapHang.copy(); d=DanhSachChiTietNhapHang.copy()\nn['dt']=parse_date(n['Thời gian'])\nn=n[(n['Trạng thái']!='Hủy')&(n.dt>='2026-01-01')&(n.dt<='2026-01-31')]\nd=d[(d['Mã hàng']=='SP0014')&d['Mã nhập hàng'].isin(n['Mã nhập hàng'])&(d['ĐVT']=='thùng')]\nq=to_num(d['Số lượng']);p=to_num(d['Đơn giá'])\nRESULT=round((q*p).sum()/q.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_23cc3324f032", "type": "percent", "answer": 12.26, "_code": "\nimport unicodedata\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày']); d['v']=to_num(d['Thành tiền'])\nst=d['Trạng thái']\nd=d[~st.str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\n\nhh=[v for k,v in data.items() if unicodedata.normalize('NFC',k)=='Danh sách hàng hóa'][0]\ngrp=dict(zip(hh['Tên hàng hóa'],hh['Nhóm hàng hóa']))\nm=d[(d.dt>='2026-04-01')&(d.dt<='2026-04-30')]\ng=m['Tên hàng hóa'].map(grp)\nRESULT=f\"{m[g=='gas & nước']['v'].sum()/m['v'].sum()*100:.2f}%\"\n\n", "_attempts": 1, "_verdict": "correct"}
