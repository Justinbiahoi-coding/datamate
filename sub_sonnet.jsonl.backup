{"id": "q_9fdf729a60b4", "type": "number", "answer": 97765, "_code": "import re,unicodedata as u\nnm=lambda s:' '.join(u.normalize('NFC',str(s)).casefold().split())\ndef money(x):\n    s=str(x).strip().lower().replace('đ','')\n    if s in('','nan','none'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m: v=int(m.group(1))*1e6+(int((m.group(2)+'000')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    else:\n        s=s.replace(',','') if re.search(r',\\d{3}',s) else s.replace(',','.')\n        if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): s=s.replace('.','')\n        v=float(s)\n    return -v if neg else v\nsp=DuLieuBanHang['DanhSachSanPham']\ncode=sp[sp['Tên hàng'].map(nm)=='nước suối lavie 1.5l']['Mã hàng'].iloc[0]\nh=DuLieuBanHang['DanhSachNhapHang'].copy(); h['d']=parse_date(h['Thời gian'])\nh=h[(h.d>='2025-03-01')&(h.d<='2025-03-31')&~h['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nc=DuLieuBanHang['DanhSachChiTietNhapHang'].merge(h[['Mã nhập hàng']],on='Mã nhập hàng')\nc=c[(c['Mã hàng']==code)&(c['ĐVT']=='thùng')]\nq=c['Số lượng'].map(money); p=c['Đơn giá'].map(money)\nRESULT=int(round((q*p).sum()/q.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d5e26f1aba13", "type": "percent", "answer": 7.49, "_code": "import re,unicodedata as u\nnm=lambda s:' '.join(u.normalize('NFC',str(s)).casefold().split())\ndef money(x):\n    s=str(x).strip().lower().replace('đ','')\n    if s in('','nan','none'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m: v=int(m.group(1))*1e6+(int((m.group(2)+'000')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    else:\n        s=s.replace(',','') if re.search(r',\\d{3}',s) else s.replace(',','.')\n        if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): s=s.replace('.','')\n        v=float(s)\n    return -v if neg else v\nna=lambda s:' '.join(''.join(c for c in u.normalize('NFD',str(s).casefold().replace('đ','d')) if not u.combining(c)).split())\ns=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates()\nbad=s[s['Trạng thái'].str.contains('hủy|huỷ|trả|không giao',case=False,na=False)]['Mã đơn hàng'].unique()\ns=s[~s['Mã đơn hàng'].isin(bad)].copy()\ns['d']=parse_date(s['Ngày'])\ns=s[(s.d>='2025-08-01')&(s.d<='2025-08-31')]\ns['v']=s['Thành tiền'].map(money)\ng=Bao_cao_ban_hang['Danh sách hàng hóa']\nm={na(a):b for a,b in zip(g['Tên hàng hóa'],g['Nhóm hàng hóa'])}\ns['g']=s['Tên hàng hóa'].map(na).map(m)\nRESULT=f\"{round(s[s.g=='ống nước'].v.sum()/s.v.sum()*100,2)}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_5811b4c066de", "type": "percent", "answer": -14.26, "_code": "import re,unicodedata as u\nnm=lambda s:' '.join(u.normalize('NFC',str(s)).casefold().split())\ndef money(x):\n    s=str(x).strip().lower().replace('đ','')\n    if s in('','nan','none'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m: v=int(m.group(1))*1e6+(int((m.group(2)+'000')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    else:\n        s=s.replace(',','') if re.search(r',\\d{3}',s) else s.replace(',','.')\n        if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): s=s.replace('.','')\n        v=float(s)\n    return -v if neg else v\ndf=SoBanHang__all.drop_duplicates().copy()\nbad=df[df['Ghi chú TT'].str.contains('hủy|huỷ|trả|hoàn trả|không giao',case=False,na=False)]['Mã phiếu'].unique()\ndf=df[~df['Mã phiếu'].isin(bad)]\ndf['d']=pd.to_datetime(df['Giờ'],errors='coerce').dt.normalize()\ndf=df[df.d.notna()&df['Mã phiếu'].notna()]\ndf['v']=df['Tiền'].map(money)\na=df[(df.d>='2025-04-01')&(df.d<='2025-04-10')].v.sum(); b=df[(df.d>='2025-03-01')&(df.d<='2025-03-10')].v.sum()\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
