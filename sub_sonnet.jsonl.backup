{"id": "q_995dd5d94d45", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Thái Nam Phương", 151000], ["Vương Hằng Phúc", 117500], ["Trương Bình Nam", 116500], ["Lưu Phong Bình", 98000], ["Vũ Nhung Trung", 94000]]}, "_code": "N=5\nh = DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nst = h['Trạng thái'].astype(str)\nh = h[~st.str.contains('hủy|huỷ|cancel', case=False, na=False)]\nh = h[h['Phương thức thanh toán']!='Thu hộ (COD)']\nh = h[h['Mã KH'].notna()]\nh['tot'] = to_num(h['Tổng sau giảm giá'])\nsq = SoQuy.copy()\nsq['v'] = sq['Giá trị'].astype(str).str.replace('đ','').str.replace('.','').astype(float)\nsq['t'] = parse_date(sq['Thời gian'])\nsq = sq[sq['t']<=pd.Timestamp(as_of_date)+pd.Timedelta(days=1)-pd.Timedelta(seconds=1)]\npaid = sq.groupby('Mã hóa đơn')['v'].sum()\nh['owe'] = h['tot'] - h['Mã hóa đơn'].map(paid).fillna(0)\nh = h[h['owe']>0]\ng = h.groupby('Mã KH')['owe'].sum().reset_index().sort_values(['owe','Mã KH'],ascending=[False,True]).head(N)\nk = DanhSachKhachHang.set_index('Mã khách hàng')['Tên khách hàng'].str.replace(r'\\s*-\\s*[\\d ]+$', '', regex=True)\nRESULT = {\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[k[r['Mã KH']], int(round(r['owe']))] for _,r in g.iterrows()]}\n", "_attempts": 2, "_verdict": "correct"}
