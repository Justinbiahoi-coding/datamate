{"id": "q_6ee842fa8f92", "type": "percent", "answer": 19.79, "_code": "def money(x):\n    x=str(x).strip()\n    if x.endswith('tr'): return round(float(x[:-2].replace(',','.'))*1e6)\n    return int(x.replace('.','').replace('đ',''))\nc=chi_tiet_don.copy(); c['a']=c['Tiền bán'].map(money)\no=don_hang.copy(); o['d']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\nt=c.groupby('Số CT').a.sum(); o['tt']=o['Số phiếu'].map(t).fillna(0)\nk=khach_hang[khach_hang['Nhóm']=='thân thiết']['Mã khách lẻ/sỉ']\nx=o[(o.d>='2025-06-01')&(o.d<='2025-06-30')]\nRESULT=f\"{round(x[x['Mã khách mua'].isin(k)].tt.sum()/x.tt.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1f722c6a3bec", "type": "number", "answer": 202375900, "_code": "h=don_hang.drop_duplicates().copy()\nh['d']=parse_date(h['NgayLap'])\nh=h[~h['TinhTrang'].str.contains('cancel|return',case=False,na=False)]\nh=h[(h.d>='2025-10-01')&(h.d<='2025-10-31')]\nc=chi_tiet_don.drop_duplicates()\nc=c[c['MaHoaDon'].isin(h['MaHoaDon'])]\nRESULT=int(round(to_num(c['TriGia']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f0ba4122749b", "type": "number", "answer": 1240050, "_code": "o=don_hang.copy(); p=thanh_toan.copy()\no['od']=pd.to_datetime(o['ThoiGianLap']).dt.normalize()\no=o[~o['TinhTrang'].isin(['cancelled'])&(o['PhuongThucTT']!='cod')&(o.od<='2025-08-24')]\np['pd']=pd.to_datetime(p['NgayGioThu']).dt.normalize()\np=p[p.pd<='2025-08-24']\npaid=p.groupby('MaHoaDon').SoTienThu.sum()\no['rem']=o['TongThanhToan']-o['MaHoaDon'].map(paid).fillna(0)\nRESULT=int(o[o.rem>0].rem.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9749171b4480", "type": "percent", "answer": -39.81, "_code": "a=So_chi_tiet_ban_hang__all.drop_duplicates().reset_index(drop=True)\na['d']=parse_date(a['Ngày']); a['m']=a.d.dt.strftime('%Y-%m')\na=a[a['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng'])]\nbad=So_chi_tiet_ban_hang__all.drop_duplicates()\ns=a.groupby('m')['Thành tiền'].apply(lambda x:to_num(x).sum())\nRESULT=f\"{round((s['2026-02']-s['2026-01'])/s['2026-01']*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b622d7d743bc", "type": "list", "answer": [1186031600, 1153886300, 1219569100], "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nd=SoBanHang__all.drop_duplicates().copy()\nd=d[d['Mã phiếu'].astype(str).str.startswith('ORD')].copy()\nd['gio']=pd.to_datetime(d['Giờ']); d['dt']=d.gio.dt.normalize()\nd['t']=mon(d['Tiền'])\nd['q']=d['Số lượng hàng'].astype(str).str.extract(r'(-?\\d+(?:[.,]\\d+)?)')[0].str.replace(',','.').astype(float)\nbadst=d['Ghi chú TT'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nbad=set(d[badst|(d.q<0)]['Mã phiếu'])\nd=d[~d['Mã phiếu'].isin(bad)]\nRESULT=[int(d[(d.dt>=a)&(d.dt<=b)].t.sum()) for a,b in [('2025-10-01','2025-10-31'),('2025-11-01','2025-11-30'),('2025-12-01','2025-12-31')]]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_486e3139b1e7", "type": "list", "answer": [284057494, 269017873, 291874314], "_code": "d=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True)\nd=d[d['Mã hóa đơn'].notna()].drop_duplicates().copy()\nd['dt']=pd.to_datetime(d['Giờ'],errors='coerce')\nbad=set(d[d['Status'].str.contains('hủy|huỷ|cancel|trả|Hoàn trả',case=False,na=False)]['Mã hóa đơn'])\nd=d[~d['Mã hóa đơn'].isin(bad)].copy()\nd['v']=d['Trị giá'].astype(str).str.replace(r'[^\\d\\-]','',regex=True).astype(float)\nm=d.groupby(d.dt.dt.to_period('M')).v.sum()\nRESULT=[int(m[pd.Period(p)]) for p in ('2025-08','2025-09','2025-10')]\n", "_attempts": 1, "_verdict": "wrong"}
{"id": "q_2e6869364adf", "type": "number", "answer": 5160000, "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    sg=-1 if s.startswith('-') else 1\n    s=s.lstrip('-').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return sg*(int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0))\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)\\s*k',s)\n    if m: return sg*float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return sg*float(s)\n    except: return float('nan')\n\na=SoBanHang.dropna(subset=['ngay_ban']).copy()\na['dt']=parse_date(a['ngay_ban'])\na['t']=a['Tổng tiền'].map(money)\nv=a[a['Trạng thái xử lý'].isin(['Đã hoàn thành','đang gửi'])&(a.dt>='2025-11-01')&(a.dt<='2025-11-30')&(a['Nội dung'].str.strip().str.lower()=='sữa tắm lifebuoy 850g')]\nRESULT=int(v.t.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2a79a2115ada", "type": "list", "answer": ["Siro ho Bổ phế Nam Hà Chỉ Khái Lộ chai 125ml", "Siro ho cảm Ích Nhi chai 90ml", "Voltaren Emulgel 1% tuýp 20g", "Metformin Stella 500mg hộp 6 vỉ x 10 viên", "Magne-B6 Corbière hộp 5 vỉ x 10 viên", "Otrivin 0,1% xịt mũi chai 10ml", "Amoxicillin 500mg Domesco hộp 10 vỉ x 10 viên", "Alaxan hộp 25 vỉ x 4 viên", "Savi Losartan 50mg hộp 3 vỉ x 10 viên", "Clorpheniramin 4mg DHG hộp 10 vỉ x 20 viên", "Bio-acimin Gold men vi sinh hộp 30 gói"], "_code": "o=don_hang[~don_hang.TinhTrang.isin(['cancelled'])][['MaHoaDon']]\nl=chi_tiet_don_lo.merge(o,on='MaHoaDon')\nsold=(l.SLQuyDoi-l.SLTraQuyDoi).groupby(l.MaLo).sum()\ng=lo_hang.copy()\ng['rem']=g.SLNhapQuyDoi-g.MaLo.map(sold).fillna(0)\ng['hd']=pd.to_datetime(g.HanSuDung)\ng=g[(g.rem>0)&(g.hd>='2026-06-28')&(g.hd<='2026-10-26')]\nm=g.groupby('MaHangHoa').hd.min().reset_index().sort_values(['hd','MaHangHoa'])\nn=san_pham.set_index('MaHangHoa')['TenGoi']\nRESULT=[n[x] for x in m.MaHangHoa]\n", "_attempts": 1, "_verdict": "correct"}
