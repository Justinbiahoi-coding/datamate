{"id": "q_14e3b0722461", "type": "list", "answer": [3, 17], "_code": "import pandas as pd\nct=data['DuLieuXuat__DonNhapHang_ChiTiet']; pn=data['DuLieuXuat__DonNhapHang']; lo=data['DuLieuXuat__DonHang_Lo']\nh=data['DonHang_ChiTiet'].copy()\nh[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']]=h[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']].ffill()\no=h.drop_duplicates('Mã đơn hàng')[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']]\no['d']=pd.to_datetime(o['Ngày đặt hàng'],format='%d/%m/%Y')\npn['d']=pd.to_datetime(pn['Ngày nhập'],format='%d/%m/%Y')\nc=ct[ct['Mã SKU']=='SP0034'].merge(pn[['Mã đơn nhập','d']],on='Mã đơn nhập')\nc=c[c.d<=as_of_date]\nnhap=to_num(c['Số lượng nhập']).sum()\nl=lo[lo['Mã lô'].isin(ct[ct['Mã SKU']=='SP0034']['Mã lô'])].merge(o,on='Mã đơn hàng')\nl=l[(l.d<=as_of_date)&(~l['Trạng thái đơn hàng'].str.contains('hủy'))]\nban=to_num(l['Số lượng']).sum(); tra=to_num(l['Số lượng trả']).sum()\nt=int(nhap-ban+tra)\nRESULT=[t//24,t%24]\n", "_attempts": 1, "_verdict": "correct"}
