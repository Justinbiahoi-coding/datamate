{"id": "q_f1fad9500cbd", "type": "number", "answer": 85165, "_code": "import re\ndef pm(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,'0')[:3])*1000 if f else 0) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    if re.fullmatch(r'\\d+[.,]\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\ndf=DonHang_ChiTiet_1__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[h]=df[h].ffill()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf['t']=df['Tổng tiền'].apply(pm)\nprint(df.t.isna().sum(), df[df.t.isna()]['Tổng tiền'].head().tolist())\ndf=df[(df.d>='2026-04-13')&(df.d<='2026-04-19')]\ndf=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng',case=False,na=False)]\ndf=df.drop_duplicates()\nRESULT=round(df.t.sum()/df['Mã đơn hàng'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d345bddf40bc", "type": "unanswerable", "answer": "unanswerable", "_code": "RESULT='unanswerable'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3811bb0ccc39", "type": "list", "answer": ["Thái Hồng Hiếu", "Kiều Thanh Loan", "Triệu Khánh Tâm", "Kiều Lan Thắng", "Vương Hạnh Linh"], "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=SoBanHang__all.copy()\ndf['amt']=df['Tiền'].map(m)\nst=df['Ghi chú TT'].astype(str).str.lower()\nbad=set(df.loc[st.str.contains('hủy|huỷ|trả'),'Mã phiếu'])\ndf=df[~df['Mã phiếu'].isin(bad)].drop_duplicates()\ndf['d']=parse_date(df['Giờ'])\nw=df[(df.d>='2026-01-05')&(df.d<'2026-01-12')]\nw=w[~w.TenKH.astype(str).str.lower().str.strip().isin(['khách lẻ','kl','lẻ'])]\nRESULT=list(w.groupby('TenKH').amt.sum().sort_values(ascending=False).head(5).index)\n", "_attempts": 1, "_verdict": "correct"}
