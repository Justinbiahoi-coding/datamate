{"id": "q_58b4641d44b5", "type": "number", "answer": 29, "_code": "d=DonHang_ChiTiet__all.copy()\nd[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']]=d[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[(d.dt>='2025-04-01')&(d.dt<='2025-04-30')]\nRESULT=int(d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False,na=False)]['Mã đơn hàng'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7b54bc2ca239", "type": "number", "answer": 146456, "_code": "h=DuLieuBanHang__DanhSachHoaDon.drop_duplicates().copy()\nh['d']=parse_date(h['Thời gian'])\nh['st']=h['Trạng thái'].astype(str).str.lower()\nok=h[~h.st.str.contains('hủy|huỷ|trả|cancel')].drop_duplicates('Mã hóa đơn')\nd=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nd['tt']=to_num(d['Thành tiền'])\nrev=d.groupby('Mã hóa đơn').tt.sum()\nok=ok.assign(rev=ok['Mã hóa đơn'].map(rev).fillna(0))\ndef R(a,b): return ok[(ok.d>=a)&(ok.d<=b)]\nk=DuLieuBanHang__DanhSachKhachHang\ng=set(k[k['Nhóm khách hàng'].astype(str).str.contains('thân thiết',case=False)]['Mã khách hàng'])\nx=R('2025-05-01','2025-05-31'); x=x[x['Mã KH'].isin(g)]\nRESULT=int(round(x.rev.sum()/len(x)+1e-9))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_78928d7dfc95", "type": "percent", "answer": 10.95, "_code": "\nh=DanhSachHoaDon__all.drop_duplicates().copy()\nh=h.drop_duplicates(subset=['Mã hóa đơn'])\nh['d']=parse_date(h['Thời gian'])\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả|đổi',case=False,na=False)\nh=h[(h['d'].dt.year==2026)&(h['d'].dt.month==6)&~bad]\ndt=DanhSachHoaDonChiTiet.drop_duplicates().copy()\ndt=dt[dt['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\ndt['v']=to_num(dt['Thành tiền'])\nsp=DanhSachSanPham.set_index('Mã hàng')['Nhóm hàng(3 Cấp)']\ndt['g']=dt['Mã hàng'].map(sp)\nRESULT=f\"{round(dt.loc[dt.g=='gỏi','v'].sum()/dt.v.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ef10692b3089", "type": "number", "answer": 74, "_code": "\nd=ban_hang.copy().drop_duplicates()\nd['d']=parse_date(d['Ngày bán'])\nok=d['Trạng thái xử lý'].isin(['Đã hoàn thành','Đang xử lý'])\nd=d[ok&(d['d'].dt.year==2025)&(d['d'].dt.month==12)&(d['Hàng bán'].str.strip().str.lower()=='má heo nướng nước mắm')]\nRESULT=int(to_num(d['Số lượng lẻ']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5e0ac8c57127", "type": "percent", "answer": -3.76, "_code": "import re, numpy as np, unicodedata\ndef money(x):\n    if x is None or (isinstance(x,float) and np.isnan(x)): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan'): return np.nan\n    if 'tr' in s:\n        a,b=s.split('tr',1); a=a.strip().replace(',','.')\n        v=float(a)*1e6 if a else 0\n        b=b.strip()\n        if b: v+=int(b.ljust(3,'0')[:3])*1000\n        return v\n    if s.endswith('k'):\n        return float(s[:-1].replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.fullmatch(r'-?\\d+,\\d+',s) else float(s)\ndef nt(s):\n    return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower()\nimport pandas as pd\na=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[oc]=a[oc].ffill()\na=a.drop_duplicates()\na['d']=pd.to_datetime(a['Ngày đặt hàng'],format='%d/%m/%Y')\na['v']=a['Tổng tiền'].map(money)\nst=a['Trạng thái đơn hàng']\na['cancel']=st.str.contains('hủy|huỷ',case=False,na=False)\na['ret']=st.str.contains('hoàn hàng|trả',case=False,na=False)\nok=a[~a.cancel&~a.ret]\ndef rev(s,e): return ok[(ok.d>=s)&(ok.d<=e)].v.sum()\ncur=rev('2025-03-01','2025-03-09'); prev=rev('2025-02-01','2025-02-09')\nRESULT=f\"{(cur-prev)/prev*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bcefac430dea", "type": "percent", "answer": 0.83, "_code": "import re, numpy as np, unicodedata\ndef money(x):\n    if x is None or (isinstance(x,float) and np.isnan(x)): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan'): return np.nan\n    if 'tr' in s:\n        a,b=s.split('tr',1); a=a.strip().replace(',','.')\n        v=float(a)*1e6 if a else 0\n        b=b.strip()\n        if b: v+=int(b.ljust(3,'0')[:3])*1000\n        return v\n    if s.endswith('k'):\n        return float(s[:-1].replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.fullmatch(r'-?\\d+,\\d+',s) else float(s)\ndef nt(s):\n    return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower()\nimport pandas as pd\na=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[oc]=a[oc].ffill()\na=a.drop_duplicates()\na['d']=pd.to_datetime(a['Ngày đặt hàng'],format='%d/%m/%Y')\na['v']=a['Tổng tiền'].map(money)\nst=a['Trạng thái đơn hàng']\na['cancel']=st.str.contains('hủy|huỷ',case=False,na=False)\na['ret']=st.str.contains('hoàn hàng|trả',case=False,na=False)\nok=a[~a.cancel&~a.ret]\ndef rev(s,e): return ok[(ok.d>=s)&(ok.d<=e)].v.sum()\nm=a[(a.d>='2025-06-01')&(a.d<='2025-06-30')].drop_duplicates('Mã đơn hàng')\nRESULT=f\"{m.cancel.sum()/len(m)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5a4149617845", "type": "number", "answer": 2432510700, "_code": "import re, numpy as np, unicodedata\ndef money(x):\n    if x is None or (isinstance(x,float) and np.isnan(x)): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan'): return np.nan\n    if 'tr' in s:\n        a,b=s.split('tr',1); a=a.strip().replace(',','.')\n        v=float(a)*1e6 if a else 0\n        b=b.strip()\n        if b: v+=int(b.ljust(3,'0')[:3])*1000\n        return v\n    if s.endswith('k'):\n        return float(s[:-1].replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.fullmatch(r'-?\\d+,\\d+',s) else float(s)\ndef nt(s):\n    return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower()\nimport pandas as pd\na=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[oc]=a[oc].ffill()\na=a.drop_duplicates()\na['d']=pd.to_datetime(a['Ngày đặt hàng'],format='%d/%m/%Y')\na['v']=a['Tổng tiền'].map(money)\nst=a['Trạng thái đơn hàng']\na['cancel']=st.str.contains('hủy|huỷ',case=False,na=False)\na['ret']=st.str.contains('hoàn hàng|trả',case=False,na=False)\nok=a[~a.cancel&~a.ret]\ndef rev(s,e): return ok[(ok.d>=s)&(ok.d<=e)].v.sum()\nRESULT=round(rev('2025-01-01','2025-11-08'))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a54b40273b31", "type": "percent", "answer": 9.43, "_code": "d=DanhSachHoaDon.copy().drop_duplicates()\nd['dt']=parse_date(d['Thời gian'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd['amt']=pd.to_numeric(d['Tổng tiền hàng'].astype(str).str.replace(r'[^\\d.\\-]','',regex=True),errors='coerce')\na=pd.Timestamp(as_of_date)\ncur=d[(d.dt>=a.replace(day=1))&(d.dt<=a)].amt.sum()\npm=(a.replace(day=1)-pd.Timedelta(days=1))\nprev=d[(d.dt>=pm.replace(day=1))&(d.dt<=pm.replace(day=min(a.day,pm.day)))].amt.sum()\nRESULT=f\"{(cur/prev-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_784bf8f76796", "type": "percent", "answer": -7.23, "_code": "h=DanhSachHoaDon.drop_duplicates().copy()\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates()\nh['t']=pd.to_datetime(h['Thời gian tạo'])\nok=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|Hoàn trả',case=False,na=False)]\nc=c[c['Mã hóa đơn'].isin(ok['Mã hóa đơn'])].merge(ok[['Mã hóa đơn','t']],on='Mã hóa đơn')\nc=c[c['Tên hàng'].map(vn_normalize)==vn_normalize('Trà sữa trân châu (M)')]\nc['q']=to_num(c['Số lượng quy đổi'])\nD=pd.Timestamp('2026-04-23')\na=c[(c.t>=D)&(c.t<D+pd.Timedelta(days=30))].q.sum()\nb=c[(c.t>=D-pd.Timedelta(days=30))&(c.t<D)].q.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_166ae673a2b0", "type": "number", "answer": 27437500, "_code": "h=DanhSachHoaDon.drop_duplicates().copy()\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates()\nh['t']=pd.to_datetime(h['Thời gian tạo'])\nok=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|Hoàn trả',case=False,na=False)]\nok=ok[(ok.t>='2025-09-15')&(ok.t<'2025-09-22')&(ok.t.dt.hour>=14)&(ok.t.dt.hour<22)]\nc=c[c['Mã hóa đơn'].isin(ok['Mã hóa đơn'])]\nRESULT=int(round(to_num(c['Thành tiền']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_cbd09f3b56dc", "type": "number", "answer": 2398, "_code": "import re, numpy as np, unicodedata\ndef money(x):\n    if x is None or (isinstance(x,float) and np.isnan(x)): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan'): return np.nan\n    if 'tr' in s:\n        a,b=s.split('tr',1); a=a.strip().replace(',','.')\n        v=float(a)*1e6 if a else 0\n        b=b.strip()\n        if b: v+=int(b.ljust(3,'0')[:3])*1000\n        return v\n    if s.endswith('k'):\n        return float(s[:-1].replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.fullmatch(r'-?\\d+,\\d+',s) else float(s)\ndef nt(s):\n    return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower()\nimport pandas as pd\na=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\noc=['Ngày','Mã đơn hàng','Trạng thái']\na[oc]=a[oc].ffill()\na['d']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na=a[a['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng'])]\nm=a[(a.d>='2025-10-29')&(a.d<='2025-11-27')]\nRESULT=int(m['Mã đơn hàng'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_492d842402e0", "type": "percent", "answer": -5.47, "_code": "\no=don_hang.drop_duplicates('Mã chứng từ').copy()\no['d']=parse_date(o['NgayBan'])\no=o[o['Xử lý'].isin(['completed','shipping'])]\nc=chi_tiet_don.copy(); c['v']=to_num(c['T.Tiền'])\nrev=c.groupby('Ma don')['v'].sum()\no['rev']=o['Mã chứng từ'].map(rev).fillna(0)\ndef R(y,m): return o.loc[(o.d.dt.year==y)&(o.d.dt.month==m),'rev'].sum()\nRESULT=f\"{round((R(2026,2)/R(2025,2)-1)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0872d9f34f31", "type": "percent", "answer": -31.57, "_code": "d=DonHang_ChiTiet.copy()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['v']=to_num(d['Tổng tiền'])\nbad=d[d['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False)]['Mã đơn hàng'].unique()\ng=d[~d['Mã đơn hàng'].isin(bad)]\ndef R(a,b): return g[(g.dt>=a)&(g.dt<=b)].v.sum()\na=R('2026-02-01','2026-02-28');b=R('2026-01-01','2026-01-31')\nRESULT=f'{(a-b)/b*100:.2f}%'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_56927a1f062a", "type": "number", "answer": 173, "_code": "\no=don_hang.drop_duplicates('Mã chứng từ').copy()\no['d']=parse_date(o['NgayBan'])\no=o[o['Xử lý'].isin(['completed','shipping'])]\nc=chi_tiet_don.copy(); c['v']=to_num(c['T.Tiền'])\nc['q']=to_num(c['SL quy đổi'])\nsp=san_pham.set_index('SKU')['Đơn vị']\nc['u']=c['ID SP'].map(sp)\nc=c[c['Ma don'].isin(o.loc[o.d==pd.Timestamp(as_of_date)-pd.Timedelta(days=1),'Mã chứng từ'])]\nRESULT=int(c.loc[c.u=='ly','q'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ebcb60ec63ac", "type": "number", "answer": 198041000, "_code": "d=DonHang_ChiTiet.copy()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['v']=to_num(d['Tổng tiền'])\nbad=d[d['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False)]['Mã đơn hàng'].unique()\ng=d[~d['Mã đơn hàng'].isin(bad)]\ndef R(a,b): return g[(g.dt>=a)&(g.dt<=b)].v.sum()\nRESULT=int(R('2026-01-01','2026-01-31'))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_cd5692898ae3", "type": "percent", "answer": 41.43, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    m=re.match(r'^(\\d+)tr(\\d{3})?$',s)\n    if m: return int(m.group(1))*1000000+int(m.group(2) or 0)*1000\n    return float(re.sub(r'[^\\d\\-]','',s) or 0)\no=don_hang.copy()\no['dt']=parse_date(o['Ngày'])\no=o[(o.dt>='2025-10-01')&(o.dt<='2025-10-31')&(o['Tình trạng'].isin(['completed','shipping']))]\nc=chi_tiet_don.drop_duplicates().copy(); c['a']=c['Amount'].map(money)\ns=c.groupby('Mã đơn hàng').a.sum()\no['t']=o['Mã chứng từ'].map(s).fillna(0)\nRESULT='%.2f%%'%(o[o['Trả bằng']=='transfer'].t.sum()/o.t.sum()*100)\n", "_attempts": 4, "_verdict": "correct"}
{"id": "q_def63a60c035", "type": "percent", "answer": 3.4, "_code": "d=DonHang_ChiTiet__all.copy()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[(d.dt>='2026-03-01')&(d.dt<='2026-03-31')]\no=d.drop_duplicates('Mã đơn hàng')\nc=o['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|cancel',case=False).sum()\nRESULT=f\"{c/len(o)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_19ea6f41a869", "type": "percent", "answer": -12.74, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\nd=d[d['Mã đơn hàng'].notna()].drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]\nd=d[d['Tên hàng hóa'].map(normalize_text)==normalize_text('Đậu hũ chiên giòn')]\nq=pd.to_numeric(d['Số lượng quy đổi'],errors='coerce')\nD=pd.Timestamp('2025-12-01')\nafter=q[(d.dt>=D)&(d.dt<D+pd.Timedelta(days=30))].sum()\nbefore=q[(d.dt>=D-pd.Timedelta(days=30))&(d.dt<D)].sum()\nRESULT=f\"{(after/before-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c594737e01f2", "type": "percent", "answer": 4.33, "_code": "import re, numpy as np, unicodedata\ndef money(x):\n    if x is None or (isinstance(x,float) and np.isnan(x)): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan'): return np.nan\n    if 'tr' in s:\n        a,b=s.split('tr',1); a=a.strip().replace(',','.')\n        v=float(a)*1e6 if a else 0\n        b=b.strip()\n        if b: v+=int(b.ljust(3,'0')[:3])*1000\n        return v\n    if s.endswith('k'):\n        return float(s[:-1].replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.fullmatch(r'-?\\d+,\\d+',s) else float(s)\ndef nt(s):\n    return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower()\nimport pandas as pd\nh=DanhSachHoaDon.copy(); d=DanhSachHoaDonChiTiet.copy()\nh['dt']=pd.to_datetime(h['Thời gian'],format='%d/%m/%Y')\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh=h[(h.dt>='2025-07-01')&(h.dt<='2025-07-31')]\nd=d[d['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nd['v']=d['Thành tiền'].map(money)\ng=DanhSachSanPham.set_index('Mã hàng')['Nhóm hàng(3 Cấp)']\nd['g']=d['Mã hàng'].map(g)\nRESULT=f\"{d[d.g=='bia'].v.sum()/d.v.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_07f86ff2d62b", "type": "number", "answer": 1016912500, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in('nan','','none'): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+[,.]\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): v=float(s.replace(',',''))\n    else: v=float(s.replace(',','.'))\n    return -v if neg else v\nh=don_hang.drop_duplicates().copy(); c=chi_tiet_don.drop_duplicates().copy()\nh['d']=parse_date(h['Ngày bán'])\nok=h[~h['Tình trạng đơn'].str.contains('cancel|return',case=False,na=False)&(h.d>='2026-03-01')&(h.d<='2026-03-31')]\nc=c[c['Số CT'].isin(ok['Số phiếu'])]\nRESULT=int(round(c['Tiền bán'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c06729907fcc", "type": "number", "answer": 4598548, "_code": "\nh=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh['od']=pd.to_datetime(h['Giờ tạo đơn']).dt.normalize()\nh=h[(h['Phương thức TT']=='Ghi nợ')&(h['Trạng thái']!='Không giao được')]\np=BanHang_PhieuThu.drop_duplicates().copy()\np['pd']=pd.to_datetime(p['Thời gian thu']).dt.normalize()\np['v']=to_num(p['Số tiền thu'])\np=p.merge(h[['Order ID','od']],left_on='Mã bill',right_on='Order ID')\np=p[p.pd>p.od]\ns=pd.Timestamp('2026-05-01'); e=pd.Timestamp(as_of_date)\nRESULT=int(p.loc[(p.pd>=s)&(p.pd<=e),'v'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_39fd6a84690d", "type": "number", "answer": 2837562, "_code": "\nh=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh['od']=pd.to_datetime(h['Giờ tạo đơn']).dt.normalize()\nh=h[(h['Phương thức TT']=='Ghi nợ')&(h['Trạng thái']!='Không giao được')]\np=BanHang_PhieuThu.drop_duplicates().copy()\np['pd']=pd.to_datetime(p['Thời gian thu']).dt.normalize()\np['v']=to_num(p['Số tiền thu'])\np=p.merge(h[['Order ID','od']],left_on='Mã bill',right_on='Order ID')\np=p[p.pd>p.od]\ns=pd.Timestamp('2025-05-01'); e=pd.Timestamp('2025-05-31')\nRESULT=int(p.loc[(p.pd>=s)&(p.pd<=e),'v'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_706fd1892b0b", "type": "number", "answer": 528611, "_code": "h=DanhSachHoaDon__all.drop_duplicates().copy()\nh['d']=parse_date(h['Thời gian'])\nbad=h['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả|Đổi trả',case=False,na=False)\nok=h[~bad]\ndet=DanhSachHoaDonChiTiet.drop_duplicates().copy()\ndet['tt']=to_num(det['Thành tiền'])\nrev_by=det.groupby('Mã hóa đơn')['tt'].sum()\nok=ok.assign(rev=ok['Mã hóa đơn'].map(rev_by).fillna(0))\nm=ok[(ok.d>='2025-04-01')&(ok.d<='2025-04-30')]\nRESULT=int(round(m.rev.mean()+1e-9))\n", "_attempts": 2, "_verdict": "correct"}
