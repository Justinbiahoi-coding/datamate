{"id": "q_f34ec327ae03", "type": "number", "answer": 33130300, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return 0.0\n    m=re.match(r'^(-?\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)tr$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000000)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)k$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000)\n    if re.match(r'^-?\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(re.sub(r'[^\\d.\\-]','',s) or 0)\ndf=So_chi_tiet_ban_hang__all\ndf=df[df['Mã đơn hàng'].notna()&df['Tên hàng hóa'].notna()].drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày'])\ndf['v']=df['Thành tiền'].map(money)\nbad=df['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)\nbo=set(df.loc[bad,'Mã đơn hàng'])\nok=df[~df['Mã đơn hàng'].isin(bo)]\nRESULT=int(round(ok[ok.d==as_of_date].v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_64912d7a8d99", "type": "percent", "answer": 12.66, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return 0.0\n    m=re.match(r'^(-?\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)tr$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000000)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)k$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000)\n    if re.match(r'^-?\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(re.sub(r'[^\\d.\\-]','',s) or 0)\ndf=So_chi_tiet_ban_hang__all\ndf=df[df['Mã đơn hàng'].notna()&df['Tên hàng hóa'].notna()].drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày'])\ndf['v']=df['Thành tiền'].map(money)\nbad=df['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)\nbo=set(df.loc[bad,'Mã đơn hàng'])\nok=df[~df['Mã đơn hàng'].isin(bo)]\ndef m(y,mo): return ok[(ok.d.dt.year==y)&(ok.d.dt.month==mo)].v.sum()\na,b=m(2026,1),m(2025,12)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3f4652018f1e", "type": "number", "answer": 11615500, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=float('nan')\n    return -v if neg else v\n\nd=SoBanHang.copy()\nd['t']=parse_date(d['Ngày tháng']).dt.normalize(); d['m']=d['Thành tiền (đ)'].apply(money)\nd=d[~d['Trạng thái đơn'].str.contains('hủy|huỷ|trả',case=False,na=False)]\ny=pd.Timestamp(as_of_date)-pd.Timedelta(days=1)\nRESULT=round(d[d.t==y].m.sum())\n", "_attempts": 1, "_verdict": "correct"}
