{"id": "q_41a920e55256", "type": "list", "answer": ["Bia Tiger lon", "Lẩu Thái tôm cá (nhỏ)", "Bia Tiger Bạc lon"], "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^(\\d+)[,.](\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    m=re.match(r'^[\\d,]+\\.\\d{4}$',s)       # 1,500.0000\n    if m: return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\no=don_hang.drop_duplicates().copy(); o['d']=parse_date(o['Ngày bán'])\nv=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\nl=chi_tiet_don.drop_duplicates().merge(v[['Số phiếu','d']],left_on='Số CT',right_on='Số phiếu')\nl=l[(l.d>='2026-01-01')&(l.d<'2026-02-01')]\nl=l.merge(san_pham[['Mã HH','Tên sản phẩm']],left_on='Mã hàng bán',right_on='Mã HH')\nl=l[~l['Tên sản phẩm'].str.contains('Phí phục vụ',case=False)]\nl['q']=pd.to_numeric(l['Quy ra ĐV lẻ'],errors='coerce')\ns=l.groupby(['Mã HH','Tên sản phẩm'])['q'].sum().reset_index().sort_values(['q','Mã HH'],ascending=[False,True])\nRESULT=s['Tên sản phẩm'].head(3).tolist()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b1c861c1c7e2", "type": "number", "answer": 37, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^(\\d+)[,.](\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    m=re.match(r'^[\\d,]+\\.\\d{4}$',s)       # 1,500.0000\n    if m: return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\no=don_hang.drop_duplicates().copy(); o['d']=parse_date(o['Ngày bán'])\nx=o[(o.d>='2026-06-01')&(o.d<'2026-07-01')&(o['Tình trạng đơn']=='cancelled')]\nRESULT=x['Số phiếu'].nunique()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a9d7d7a4e827", "type": "date", "answer": "2025-07", "_code": "\nd=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày']); d['v']=to_num(d['Thành tiền'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd=d[(d.dt>='2025-07-01')&(d.dt<='2025-09-30')]\ns=d.groupby(d.dt.dt.strftime('%Y-%m'))['v'].sum()\nRESULT=s.idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8f42ec85b989", "type": "number", "answer": 27671000, "_code": "\nd=ban_hang.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày bán']); d['v']=to_num(d['Amount'])\nd=d[~d['Trạng thái xử lý'].str.contains('hủy|huỷ|trả',case=False,na=False)]\ny=pd.Timestamp(as_of_date)-pd.Timedelta(days=1)\nRESULT=int(d[d.dt==y]['v'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_688c9a88b70f", "type": "list", "answer": ["Cà phê sữa (M)", "Trà đào cam sả (M)", "Cà phê đen (M)", "Trà sữa trân châu (M)", "Bạc xỉu (M)"], "_code": "d=pd.concat([SoBanHang_1__all,SoBanHang_2026__all]).drop_duplicates().copy()\nd['dt']=pd.to_datetime(d['Giờ'])\nd['q']=to_num(d['so_luong'])\nd['q']=d['q'].where(d['Unit'].isin(['ly','cái','phần','chai','lon','cốc']) | ~d['Hàng'].isin(DanhMuc['Tên món']), d['q'])\nf=d['Hàng'].map(dict(zip(DanhMuc['Tên món'],DanhMuc['Hệ số'])))\nd['q']=d['q']*((d['Unit']=='hộp')*(f.fillna(1)-1)+1)\nbad=d.groupby('Mã hóa đơn').apply(lambda g: (g['q']<0).any() or g['Status'].str.contains('hủy|Trả|trả|Hoàn|Đổi',regex=True).any())\nm=d[(d.dt>='2026-01-12')&(d.dt<'2026-01-19')]\nm=m[~m['Mã hóa đơn'].isin(bad[bad].index)]\nm=m[m['Hàng'].notna()]\nm['k']=m['Hàng'].map(normalize_text)\ng=m.groupby('k').agg(q=('q','sum'),n=('Hàng',lambda s:s.value_counts().index[0])).sort_values('q',ascending=False)\nRESULT=list(g.head(5)['n'])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9d402b0095ac", "type": "percent", "answer": 4.37, "_code": "import re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    if not s: return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    m=re.fullmatch(r'([\\d.,]+)tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d+,\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\n\ndf=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill()\ndf=df.drop_duplicates().reset_index(drop=True)\ndf['d']=parse_date(df['Ngày đặt hàng']); df['v']=df['Tổng tiền'].map(money)\ndf=df[df['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nm=df[(df.d>='2026-07-01')&(df.d<='2026-07-17')]\nj=DanhSachSanPham.merge(DanhSachThuoc,on='Mã SKU')\nrx=set(normalize_text(x) for x in j[j['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1'])]['Tên sản phẩm'])\nm=m.assign(n=m['Tên sản phẩm'].map(normalize_text))\nRESULT=f\"{m[m.n.isin(rx)].v.sum()/m.v.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4293a4130594", "type": "percent", "answer": 1.81, "_code": "\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt>='2026-03-01')&(d.dt<='2026-03-31')]\no=d.drop_duplicates('Mã đơn hàng')\nc=o['Trạng thái'].str.contains('hủy|huỷ|Không giao được',case=False,na=False).sum()\nRESULT=f\"{round(c/len(o)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5e400b00c3ac", "type": "list", "answer": ["Lưu Thảo Hùng", "Đỗ Phúc Khoa", "Đinh Thu Tâm"], "_code": "import re\ndef money(s):\n    s=str(s).strip()\n    if s.endswith('tr'): return round(float(s[:-2].replace(',','.'))*1e6)\n    return float(re.sub(r'\\D','',s) or 0)\no=data['don_hang'].copy(); c=data['chi_tiet_don'].drop_duplicates(); k=data['khach_hang']\no['d']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])&(o.d>='2026-07-01')&(o.d<='2026-07-31')&o['Mã khách mua'].notna()]\nc=c[c['Số CT'].isin(o['Số phiếu'])].copy(); c['t']=c['Tiền bán'].map(money)\nc=c.merge(o[['Số phiếu','Mã khách mua']],left_on='Số CT',right_on='Số phiếu')\ns=c.groupby('Mã khách mua').t.sum().reset_index().sort_values(['t','Mã khách mua'],ascending=[False,True]).head(3)\nnm=k.set_index('Mã khách lẻ/sỉ')['KH']\nRESULT=[nm[x] for x in s['Mã khách mua']]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8a08a59c83a2", "type": "percent", "answer": 20.16, "_code": "\no=don_hang.copy(); o['dt']=parse_date(o['NgayBan'])\no=o[o['Xử lý'].isin(['completed','shipping'])]\nc=chi_tiet_don.copy(); c['tt']=to_num(c['T.Tiền'])\nr=c.groupby('Ma don').tt.sum().rename('rev')\no=o.merge(r,left_on='Mã chứng từ',right_index=True,how='left')\n\nx=o[(o.dt>='2026-01-01')&(o.dt<='2026-01-31')]\ng=x.merge(khach_hang[['ma_kh','Nhóm']],left_on='Số KH',right_on='ma_kh',how='left')\nRESULT=f\"{round(g[g['Nhóm']=='thân thiết'].rev.sum()/x.rev.sum()*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d79ae5268504", "type": "date", "answer": "2025-05-03", "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^(\\d+)[,.](\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    m=re.match(r'^[\\d,]+\\.\\d{4}$',s)       # 1,500.0000\n    if m: return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\nh=BanHang_HoaDon.drop_duplicates().copy(); h['d']=parse_date(h['Ngày bán'])\nh=h[h['Trạng thái'].isin(['Đã giao','Đang vận chuyển'])]\nl=BanHang_ChiTietHoaDon.drop_duplicates().copy(); l['tt']=l['Thanh tien'].map(money)\nl=l.merge(h[['Order ID','d']],left_on='Mã giao dịch',right_on='Order ID')\nx=l[(l.d>='2025-05-01')&(l.d<'2025-06-01')]\nRESULT=x.groupby('d')['tt'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9045737fcddf", "type": "date", "answer": "2026-02", "_code": "\nd=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['v']=to_num(d['Tổng tiền'])\nst=d['Trạng thái đơn hàng']\n\nok=d[~st.str.contains('hủy|huỷ|trả',case=False,na=False)]\nok=ok[(ok.dt>='2026-01-01')&(ok.dt<='2026-03-31')]\nRESULT=ok.groupby(ok.dt.dt.strftime('%Y-%m'))['v'].sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
