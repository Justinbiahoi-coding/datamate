{"id": "q_1b0a47e42b97", "type": "percent", "answer": 7.35, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^(\\d+)[,.](\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    m=re.match(r'^[\\d,]+\\.\\d{4}$',s)       # 1,500.0000\n    if m: return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\nh=BanHang_HoaDon.drop_duplicates().copy(); h['d']=parse_date(h['Ngày bán'])\nh=h[h['Trạng thái'].isin(['Đã giao','Đang vận chuyển'])]\nl=BanHang_ChiTietHoaDon.drop_duplicates().copy(); l['tt']=l['Thanh tien'].map(money)\nl=l.merge(h[['Order ID','d']],left_on='Mã giao dịch',right_on='Order ID')\n# as_of 2026-02-11: tháng này 1..11/2 so với 1..11/1\na=l[(l.d>='2026-02-01')&(l.d<='2026-02-11')]['tt'].sum()\nb=l[(l.d>='2026-01-01')&(l.d<='2026-01-11')]['tt'].sum()\nRESULT=f\"{(a/b-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bc31d4d1636d", "type": "number", "answer": 246039400, "_code": "df=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nfor c in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: df[c]=df[c].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndef money(x):\n    x=str(x).strip().lower()\n    k=x.endswith('k')\n    v=float(x.rstrip('kđ').replace('.','').replace(',',''))\n    return v*1000 if k else v\ndf['t']=df['Tổng tiền'].map(money)\nst=df['Trạng thái đơn hàng'].map(normalize_text)\nbad=set(df.loc[st.str.contains('huy|hoan hang|tra'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\nRESULT=int(round(df[(df.d>='2025-05-01')&(df.d<='2025-05-31')].t.sum()))\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_72f43cc7a0bc", "type": "date", "answer": "2025-04-04", "_code": "d=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=pd.to_datetime(d['Ngày'],format='%d/%m/%Y')\nd=d[~d['Trạng thái'].isin(['Không giao được','Trả hàng','hàng trả về','hủy'])]\nd['tt']=to_num(d['Thành tiền'])\nx=d[(d.dt>='2025-04-01')&(d.dt<='2025-04-30')].groupby('dt').tt.sum()\nRESULT=x.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9cdc5b4ca39f", "type": "percent", "answer": 22.23, "_code": "d=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=pd.to_datetime(d['Ngày'],format='%d/%m/%Y')\nd=d[~d['Trạng thái'].isin(['Không giao được','Trả hàng','hàng trả về','hủy'])]\nd['tt']=to_num(d['Thành tiền'])\nh=[v for k,v in data.items() if not k.startswith('_') and 'Nhóm hàng hóa' in getattr(v,'columns',[])][0]\ng=dict(zip(h['Tên hàng hóa'].map(normalize_text),h['Nhóm hàng hóa']))\nd=d[(d.dt>='2025-06-01')&(d.dt<='2025-06-30')]\nd['g']=d['Tên hàng hóa'].map(normalize_text).map(g)\nassert d.g.isna().sum()==0\nRESULT=f\"{round(d[d.g=='điện'].tt.sum()/d.tt.sum()*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6a9f246e5aa7", "type": "list", "answer": [6950600, 7684400], "_code": "import re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    if not s: return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    m=re.fullmatch(r'([\\d.,]+)tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d+,\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\n\no=don_hang.drop_duplicates().copy()\no['d']=parse_date(o['NgayBan'])\no=o[o['Xử lý'].isin(['completed','shipping'])&(o.d>='2026-08-01')&(o.d<='2026-08-19')]\nc=chi_tiet_don.drop_duplicates().copy(); c['v']=c['T.Tiền'].map(money)\nx=c.merge(o[['Mã chứng từ','Bán qua']],left_on='Ma don',right_on='Mã chứng từ')\ng=x.groupby('Bán qua').v.sum()\nRESULT=[int(round(g.get('phone',0))),int(round(g.get('zalo_oa',0)))]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_54b290255208", "type": "date", "answer": "2025-01-18", "_code": "\no=don_hang.copy(); o['dt']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\nc=chi_tiet_don.copy(); c['tt']=to_num(c['Tiền bán'])\no=o.merge(c.groupby('Số CT').tt.sum().rename('rev'),left_on='Số phiếu',right_index=True,how='left')\n\nx=o[(o.dt>='2025-01-01')&(o.dt<='2025-01-31')]\nRESULT=str(x.groupby(x.dt.dt.date).rev.sum().idxmax())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_28850fd1adbd", "type": "percent", "answer": -50.0, "_code": "df=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nfor c in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: df[c]=df[c].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndef money(x):\n    x=str(x).strip().lower()\n    k=x.endswith('k')\n    v=float(x.rstrip('kđ').replace('.','').replace(',',''))\n    return v*1000 if k else v\ndf['t']=df['Tổng tiền'].map(money)\nst=df['Trạng thái đơn hàng'].map(normalize_text)\nbad=set(df.loc[st.str.contains('huy|hoan hang|tra'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\nx=df[df['Tên sản phẩm']=='Betadine Gargle súc họng chai 125ml'].copy()\nx['q']=to_num(x['Số lượng sản phẩm'])\nD=pd.Timestamp('2026-01-22')\na=x[(x.d>=D)&(x.d<D+pd.Timedelta(days=14))].q.sum()\nb=x[(x.d>=D-pd.Timedelta(days=14))&(x.d<D)].q.sum()\nprint(a,b)\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_01b914589609", "type": "number", "answer": 730984600, "_code": "import re\ndef pm(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)(?:,(\\d+))?tr(\\d+)?',s)\n    if m:\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0')[:3])*1e3\n        else: a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        return -a if neg else a\n    m=re.fullmatch(r'(\\d+(?:,\\d+)?)k',s)\n    if m: v=float(m.group(1).replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except Exception: return float('nan')\n    return -v if neg else v\nd=SoBanHang__all.drop_duplicates().copy()\nd['dt']=pd.to_datetime(d['Giờ'],errors='coerce'); d=d[d.dt.notna()].copy(); d['amt']=d['Tiền'].map(pm)\nbad=d[d['Ghi chú TT'].str.lower().str.contains('hủy|trả')]['Mã phiếu'].unique()\nm=d[(d.dt>='2025-01-21')&(d.dt<'2025-02-20')&~d['Mã phiếu'].isin(bad)]\nRESULT=int(round(m.amt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_09ac426d8fa6", "type": "date", "answer": "2029-04-20", "_code": "p=san_pham[san_pham['TenGoi'].str.contains('Oresol 245 DHG',case=False)]['MaHangHoa'].iloc[0]\nlots=lo_hang[lo_hang['MaHangHoa']==p].copy()\nok=don_hang[don_hang['TinhTrang']!='cancelled']['MaHoaDon']\nu=chi_tiet_don_lo[chi_tiet_don_lo['MaHoaDon'].isin(ok)&chi_tiet_don_lo['MaLo'].isin(lots['MaLo'])].copy()\nu['n']=pd.to_numeric(u['SLQuyDoi'])-pd.to_numeric(u['SLTraQuyDoi'],errors='coerce').fillna(0)\nused=u.groupby('MaLo')['n'].sum()\nlots['rem']=pd.to_numeric(lots['SLNhapQuyDoi'])-lots['MaLo'].map(used).fillna(0)\nlots['hsd']=parse_date(lots['HanSuDung'])\nx=lots[(lots.rem>0)&(lots.hsd>=as_of_date)].sort_values('hsd')\nRESULT=x['hsd'].iloc[0].strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_050132b11a75", "type": "number", "answer": 75500, "_code": "import re\na=data['SoBanHang__all']; a=a[a['Giờ'].astype(str).str.match(r'\\d{4}-\\d\\d-\\d\\d \\d')].copy()\na['d']=pd.to_datetime(a['Giờ']).dt.strftime('%Y-%m-%d')\nx=a[(a['d']=='2026-03-19')&(a['Tên SP'].str.contains('Nước kiềm Ion Life 19L',case=False,na=False))]\ndef money(s):\n    s=str(s).strip()\n    if s.endswith('tr'): return round(float(s[:-2].replace(',','.'))*1e6)\n    return float(re.sub(r'\\D','',s) or 0)\nRESULT=int(x['Giá'].map(money).iloc[0]) if x['Giá'].map(money).nunique()==1 else str(x['Giá'].tolist())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5560e3426394", "type": "number", "answer": 7257, "_code": "d=DonHang_ChiTiet__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd['dt']=pd.to_datetime(d['Ngày đặt hàng'],format='%d/%m/%Y')\nd=d[d['Trạng thái đơn hàng'].isin(['đã lấy','Thành công','Đang giao dịch'])]\nd['tt']=to_num(d['Tổng tiền'])\nRESULT=int(d[(d.dt>='2026-01-01')&(d.dt<='2026-06-28')]['Mã đơn hàng'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2b36065a8adc", "type": "percent", "answer": 0.92, "_code": "d=DonHang_ChiTiet__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd['dt']=pd.to_datetime(d['Ngày đặt hàng'],format='%d/%m/%Y')\nd=d[d['Trạng thái đơn hàng'].isin(['đã lấy','Thành công','Đang giao dịch'])]\nd['tt']=to_num(d['Tổng tiền'])\na=d[(d.dt>='2025-09-01')&(d.dt<='2025-09-27')].tt.sum()\nb=d[(d.dt>='2025-08-01')&(d.dt<='2025-08-27')].tt.sum()\nRESULT=f\"{round((a/b-1)*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f3d26f111d55", "type": "percent", "answer": -55.17, "_code": "import pandas as pd\na=data['SoBanHang__all']; a=a[a['Giờ'].astype(str).str.match(r'\\d{4}-\\d\\d-\\d\\d \\d')].drop_duplicates().copy()\na['t']=pd.to_datetime(a['Giờ'])\ndef qty(s):\n    import re; return float(re.match(r'-?[\\d.,]+',str(s).strip()).group().replace(',','.'))\na['q']=a['Số lượng hàng'].map(qty)\n# order-level: status per order (take any non-null), returned if neg qty or status\ndef stt(g):\n    s=' '.join(g['Ghi chú TT'].astype(str)).lower()\n    bad=('hủy' in s) or ('huỷ' in s) or ('trả' in s) or (g.q<0).any()\n    return pd.Series({'bad':bad,'t':g.t.min()})\no=a.groupby('Mã phiếu').apply(stt)\no=o[~o.bad&(o.t>='2025-10-06')&(o.t<'2025-10-13')]\nh=o.t.dt.hour\nsang=((h>=6)&(h<14)).sum(); chieu=((h>=14)&(h<22)).sum()\nRESULT=f\"{(chieu-sang)/sang*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_54b290255208", "type": "date", "answer": "2025-01-18", "_code": "\ndef money(v):\n    v=str(v).strip()\n    if v.endswith('tr'): return round(float(v[:-2].replace(',','.'))*1e6)\n    return float(v.replace('đ','').replace('.','').replace(',','') or 0)\no=don_hang.copy(); o['dt']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\nc=chi_tiet_don.copy(); c['tt']=c['Tiền bán'].map(money)\no=o.merge(c.groupby('Số CT').tt.sum().rename('rev'),left_on='Số phiếu',right_index=True,how='left')\n\nx=o[(o.dt>='2025-01-01')&(o.dt<='2025-01-31')]\nRESULT=str(x.groupby(x.dt.dt.date).rev.sum().idxmax())\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_237a88f0c7e3", "type": "list", "answer": [21961500, 204504500], "_code": "\ndef money(v):\n    v=str(v).strip()\n    if v.endswith('tr'): return round(float(v[:-2].replace(',','.'))*1e6)\n    return float(v.replace('đ','').replace('.','').replace(',','') or 0)\no=don_hang.copy(); o['dt']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\nc=chi_tiet_don.copy(); c['tt']=c['Tiền bán'].map(money)\no=o.merge(c.groupby('Số CT').tt.sum().rename('rev'),left_on='Số phiếu',right_index=True,how='left')\n\nx=o[(o.dt>='2026-08-01')&(o.dt<='2026-08-14')]\nRESULT=[int(x[x['Hình thức thanh toán']==k].rev.sum()) for k in ('cod','cash')]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_2674d035b36f", "type": "number", "answer": 590, "_code": "import re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    if not s: return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    m=re.fullmatch(r'([\\d.,]+)tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d+,\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\n\no=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\no['t']=pd.to_datetime(o['Thời gian tạo'],errors='coerce')\no=o[o['Trạng thái'].isin(['xong','Thành công','Đang giao hàng'])]\nm=o[(o.t>='2025-08-01')&(o.t<'2025-09-01')&(o.t.dt.hour>=6)&(o.t.dt.hour<14)]\nRESULT=int(len(m))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5b2c830cb331", "type": "date", "answer": "2026-07-22", "_code": "import re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    if not s: return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    m=re.fullmatch(r'([\\d.,]+)tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d+,\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\n\no=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\no['d']=parse_date(o['Thời gian'])\nok=o[o['Trạng thái'].isin(['xong','Thành công','Đang giao hàng'])]['Mã hóa đơn']\nc=DanhSachHoaDonChiTiet.drop_duplicates().merge(o[['Mã hóa đơn','d']],on='Mã hóa đơn')\nc=c[c['Mã hóa đơn'].isin(ok)&(c.d>='2026-07-01')&(c.d<='2026-07-31')]\nc['v']=c['Thành tiền'].map(money)\nRESULT=c.groupby('d').v.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_80899b2e0227", "type": "percent", "answer": 3.08, "_code": "d=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy(); d['dt']=parse_date(d['Thời gian'])\nm=d[(d.dt>='2026-05-01')&(d.dt<='2026-05-29')]\nRESULT=f\"{m['Trạng thái'].str.contains('hủy|huỷ').sum()/len(m)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bc49bb9a2d10", "type": "date", "answer": "2025-03-05", "_code": "d=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy(); d['dt']=parse_date(d['Thời gian'])\nd=d[d['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['amt']=to_num(c['Thành tiền'])\nj=c.merge(d[['Mã hóa đơn','dt']],on='Mã hóa đơn')\nm=j[(j.dt.dt.year==2025)&(j.dt.dt.month==3)]\nRESULT=str(m.groupby(m.dt.dt.date)['amt'].sum().idxmax())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9bf4d9e880d9", "type": "percent", "answer": 11.76, "_code": "h=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nst=h['Trạng thái'].map(normalize_text)\nh=h[~st.str.contains('huy|tra hang')]\nlo=DanhSachHoaDonChiTietLo\nret=set(lo.loc[to_num(lo['Số lượng trả (ĐVT cơ bản)'])>0,'Mã hóa đơn'])\nh=h[~h['Mã hóa đơn'].isin(ret)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['t']=to_num(c['Thành tiền']); c['q']=to_num(c['Số lượng quy đổi'])\nc=c.merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\na=c[(c.d>='2026-01-01')&(c.d<='2026-01-31')].t.sum()\nb=c[(c.d>='2025-12-01')&(c.d<='2025-12-31')].t.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6af0bd86e70d", "type": "list", "answer": ["Decolgen Forte hộp 30 vỉ x 4 viên", "Khẩu trang y tế 4 lớp Khánh An hộp 50 cái", "Hapacol 250 hộp 24 gói"], "_code": "h=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nst=h['Trạng thái'].map(normalize_text)\nh=h[~st.str.contains('huy|tra hang')]\nlo=DanhSachHoaDonChiTietLo\nret=set(lo.loc[to_num(lo['Số lượng trả (ĐVT cơ bản)'])>0,'Mã hóa đơn'])\nh=h[~h['Mã hóa đơn'].isin(ret)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['t']=to_num(c['Thành tiền']); c['q']=to_num(c['Số lượng quy đổi'])\nc=c.merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\nx=c[(c.d>='2025-11-01')&(c.d<='2025-11-30')]\ng=x.groupby('Mã hàng').q.sum().sort_values(ascending=False)\nprint(g.head(5))\nnm=DanhSachSanPham.set_index('Mã hàng')['Tên hàng'].to_dict()\nRESULT=[nm[k] for k in g.index[:3]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3335fb31c17c", "type": "number", "answer": 1462400, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^(\\d+)[,.](\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    m=re.match(r'^[\\d,]+\\.\\d{4}$',s)       # 1,500.0000\n    if m: return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\nh=DanhSachHoaDon__all.drop_duplicates().copy(); h['d']=parse_date(h['Thời gian']); h=h[h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\nl=DanhSachHoaDonChiTiet.drop_duplicates().copy(); l['tt']=l['Thành tiền'].map(money)\nl=l.merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\nms=DanhSachThuoc[DanhSachThuoc['Hoạt chất'].astype(str).str.strip().str.lower()=='paracetamol']['Mã hàng']\nx=l[l['Mã hàng'].isin(ms)&(l.d>='2026-07-01')&(l.d<='2026-07-13')]\nRESULT=int(round(x['tt'].sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_933f5e7df01b", "type": "date", "answer": "2026-02-28", "_code": "\no=don_hang[don_hang['Tình trạng đơn'].isin(['completed','shipping'])].copy()\no['dt']=parse_date(o['Ngày bán'])\nl=chi_tiet_don.merge(o[['Số phiếu','dt']],left_on='Số CT',right_on='Số phiếu')\nl['amt']=l['S.L']*l['Giá 1 đv']-l['Giảm giá']\nl=l.merge(san_pham[['Mã HH','Tên sản phẩm','Nhom hang']],left_on='Mã hàng bán',right_on='Mã HH')\n\nm=l[(l.dt>='2026-02-01')&(l.dt<='2026-02-28')]\nRESULT=m.groupby('dt').amt.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
