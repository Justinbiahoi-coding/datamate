{"id": "q_4e417d863271", "type": "number", "answer": 186720900.0, "_code": "o=DanhSachHoaDon__all.drop_duplicates().copy()\no['d']=parse_date(o['Thời gian'])\no=o[(o.d.dt.year==2025)&(o.d.dt.month==8)]\no=o[~o['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh=pd.to_datetime(o['Thời gian tạo'],errors='coerce').dt.hour\no=o[(h>=14)&(h<=21)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(o['Mã hóa đơn'])]\nRESULT=float(to_num(c['Thành tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2889186ce0d8", "type": "number", "answer": 150182, "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)[.,]?(\\d*)tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if c: return float(a)*1e6+float(c)*10**(6-len(c))\n        return float(a+'.'+(b or '0'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m:\n        t=m.group(1)\n        return float(t.replace('.','').replace(',',''))*1000 if re.search(r'[.,]\\d{3}$',t) else float(t.replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\nn=SoTay_NhapHang.drop_duplicates().copy()\nn['dt']=parse_date(n['Ngày nhập'])\ng=n[n.Product.str.contains('Gaviscon hộp 24 gói x 10ml')&(n.dt>='2025-11-01')&(n.dt<='2025-11-30')]\nsl=pd.to_numeric(g['SL nhập']); tt=g['Thành tiền'].apply(money)\ngn=g['Giá nhập'].apply(money)\nprint(len(g),tt.sum()/sl.sum(),(sl*gn).sum()/sl.sum())\nRESULT=round((sl*gn).sum()/sl.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6e15d25c8e48", "type": "number", "answer": 1303510500, "_code": "a=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2])\na=a[a['Mã đơn hàng'].notna()].drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na['tt']=to_num(a['Thành tiền'])\ndef rev(s,e):\n    x=a[(a.dt>=s)&(a.dt<=e)&(a['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng']))]\n    return x.tt.sum()\nRESULT=int(round(rev('2025-07-01','2025-07-31')))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_71ec879acf5b", "type": "percent", "answer": 1.63, "_code": "a=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2])\na=a[a['Mã đơn hàng'].notna()].drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na['tt']=to_num(a['Thành tiền'])\ndef rev(s,e):\n    x=a[(a.dt>=s)&(a.dt<=e)&(a['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng']))]\n    return x.tt.sum()\nx=a[(a.dt>='2025-09-01')&(a.dt<='2025-09-30')].drop_duplicates('Mã đơn hàng')\nRESULT=str(round((x['Trạng thái']=='Đã hủy').mean()*100,2))+'%'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_981a28043fd6", "type": "percent", "answer": 1.29, "_code": "a=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2])\na=a[a['Mã đơn hàng'].notna()].drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na['tt']=to_num(a['Thành tiền'])\ndef rev(s,e):\n    x=a[(a.dt>=s)&(a.dt<=e)&(a['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng']))]\n    return x.tt.sum()\ncur=rev('2026-05-01','2026-05-19'); prev=rev('2026-04-01','2026-04-19')\nRESULT=str(round((cur-prev)/prev*100,2))+'%'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8710e092dd39", "type": "percent", "answer": 18.61, "_code": "h=DanhSachHoaDon.drop_duplicates().drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh=h[(h.d.dt.year==2025)&(h.d.dt.month==6)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['v']=to_num(c['Thành tiền'])\ngm=dict(zip(DanhSachSanPham['Mã hàng'],DanhSachSanPham['Nhóm hàng(3 Cấp)']))\nc['g']=c['Mã hàng'].map(gm)\nRESULT=f\"{round(c[c.g=='hoá phẩm'].v.sum()/c.v.sum()*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_69c1fb01fb60", "type": "number", "answer": 3, "_code": "d=So_chi_tiet_ban_hang__all.copy()\nd['dt']=parse_date(d['Ngày'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\nd['k']=d['Tên hàng hóa'].map(normalize_text)\nend=pd.Timestamp(as_of_date); st=end-pd.Timedelta(days=6)\nbefore=set(d[d.dt<st].k); inp=set(d[(d.dt>=st)&(d.dt<=end)].k)\nRESULT=len(before-inp)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5412252566a0", "type": "number", "answer": 327, "_code": "h=DanhSachHoaDon__all.copy()\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh['d']=parse_date(h['Thời gian'])\nh=h[h.d==pd.Timestamp(as_of_date)-pd.Timedelta(days=1)]\nc=DanhSachHoaDonChiTiet[DanhSachHoaDonChiTiet['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nu=DanhSachSanPham.set_index('Mã hàng')['ĐVT']\nc['u']=c['Mã hàng'].map(u).map(normalize_text)\nRESULT=int(to_num(c[c.u=='goi']['Số lượng quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c4e68a8c35b1", "type": "percent", "answer": 0.64, "_code": "d=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nd['dt']=pd.to_datetime(d['Thời gian tạo'].astype(str).str[:10])\nm=d[(d.dt>='2026-02-01')&(d.dt<='2026-02-28')]\nc=m['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False).sum()\nRESULT=f\"{round(c/len(m)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_aa9b48472c8b", "type": "percent", "answer": 2.06, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s.startswith('-'): return -money(s[1:])\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        a,b=m.groups(); return int(a)*1000000+(int(b)*10**(6-len(b)) if b else 0)\n    m=re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return int(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\na=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates().copy()\na['q']=pd.to_numeric(a['so_luong'],errors='coerce')\na['v']=a['Trị giá'].map(money)\na['d']=parse_date(a['Ngày giao dịch'])\nbad=a['Status'].str.contains('hủy|huỷ|trả|Đổi trả',case=False,na=False)|(a['q']<0)\nbadids=set(a.loc[bad,'Mã hóa đơn'])\ng=a[~a['Mã hóa đơn'].isin(badids)]\ncur=g[(g['d']>='2025-05-01')&(g['d']<='2025-05-14')]['v'].sum()\nprv=g[(g['d']>='2025-04-01')&(g['d']<='2025-04-14')]['v'].sum()\nRESULT=f\"{round((cur-prv)/prv*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_cfc505734c65", "type": "number", "answer": 23, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\ndf=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates()\nd=parse_date(df['Ngày'])\nbad=df['Trạng thái'].str.contains(BAD,case=False,na=False)\nbadord=set(df.loc[bad,'Mã đơn hàng'])\nm=(d>='2025-10-01')&(d<='2025-10-31')&~df['Mã đơn hàng'].isin(badord)\nx=df[m].assign(n=df[m]['Tên hàng hóa'].map(normalize_text)).groupby('n')['Mã đơn hàng'].nunique()\nRESULT=int((x>=124).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6b01da01500d", "type": "number", "answer": 188, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\ndf=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates()\nd=parse_date(df['Ngày'])\nbad=df['Trạng thái'].str.contains(BAD,case=False,na=False)\nbadord=set(df.loc[bad,'Mã đơn hàng'])\nm=(d=='2025-11-02')&~df['Mã đơn hàng'].isin(badord)\nRESULT=int(df.loc[m,'Mã đơn hàng'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6902a9f52492", "type": "percent", "answer": 127.27, "_code": "s=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\ns=s[s['Tên SP'].str.contains('Weber.tai fix xám 25kg',na=False)]\ns=s[~s['Ghi chú TT'].str.contains('hủy|huỷ|trả|hoàn hàng',case=False,na=False)]\ns['d']=pd.to_datetime(s['Giờ'],errors='coerce').dt.normalize()\ns['q']=s['Số lượng hàng'].astype(str).str.extract(r'([\\d.]+)')[0].astype(float)\nD=pd.Timestamp('2026-01-17')\na=s[(s.d>=D)&(s.d<=D+pd.Timedelta(days=6))].q.sum()\nb=s[(s.d>=D-pd.Timedelta(days=7))&(s.d<D)].q.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ab6f568c8295", "type": "number", "answer": 4, "_code": "import re\ndf=Bao_cao_ban_hang__So_chi_tiet_ban_hang.drop_duplicates()\nok=~df['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)\ndf=df[ok].copy(); d=parse_date(df['Ngày'])\nk=df['Tên hàng hóa'].map(lambda s: normalize_text(str(s).lower().replace('đ','d')))\nbefore=set(k[d<'2026-02-12']); inp=set(k[(d>='2026-02-12')&(d<='2026-02-18')])\nimport sys; print(len(before),len(inp),sorted(before-inp),file=sys.stderr)\n\nRESULT=len(before-inp)\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_d7fe2fd5ad61", "type": "percent", "answer": 30.79, "_code": "h=DanhSachHoaDon.drop_duplicates().copy()\nh['dt']=pd.to_datetime(h['Thời gian'],format='%d/%m/%Y')\nh['hr']=pd.to_datetime(h['Thời gian tạo']).dt.hour\nh=h[(h.dt>='2026-02-16')&(h.dt<='2026-02-22')&h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['tt']=to_num(c['Thành tiền'])\nm=c.merge(h[['Mã hóa đơn','hr']],on='Mã hóa đơn')\ns=m[(m.hr>=6)&(m.hr<14)].tt.sum(); ch=m[(m.hr>=14)&(m.hr<22)].tt.sum()\nRESULT=str(round((ch-s)/s*100,2))+'%'\n", "_attempts": 1, "_verdict": "correct"}
