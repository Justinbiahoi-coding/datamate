{"id": "q_e7837d5638fb", "type": "number", "answer": 248572900, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in('','nan','none'): return 0.0\n    m=1\n    if s.endswith('k'): m=1000; s=s[:-1]\n    elif s.endswith('tr'): m=1e6; s=s[:-2]\n    s=re.sub(r'[đd₫\\s]|vnd','',s)\n    if re.fullmatch(r'-?\\d{1,3}([.,]\\d{3})+',s): s=re.sub(r'[.,]','',s)\n    else: s=s.replace(',','.')\n    return float(s)*m\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nfor c in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: d[c]=d[c].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[(d.dt>='2025-09-01')&(d.dt<='2025-09-30')&(d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch']))]\nRESULT=int(round(d['Tổng tiền'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9b23c0d87092", "type": "number", "answer": 744142500, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in('','nan','none'): return 0.0\n    m=1\n    if s.endswith('k'): m=1000; s=s[:-1]\n    elif s.endswith('tr'): m=1e6; s=s[:-2]\n    s=re.sub(r'[đd₫\\s]|vnd','',s)\n    if re.fullmatch(r'-?\\d{1,3}([.,]\\d{3})+',s): s=re.sub(r'[.,]','',s)\n    else: s=s.replace(',','.')\n    return float(s)*m\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nfor c in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: d[c]=d[c].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[(d.dt>='2025-10-01')&(d.dt<='2025-12-31')&(d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch']))]\nRESULT=int(round(d['Tổng tiền'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
