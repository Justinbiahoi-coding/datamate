{"id": "q_09427a977b31", "type": "list", "answer": ["Bia Sài Gòn Special lon", "Bia Tiger Bạc lon", "Bia Heineken lon", "Bò lúc lắc khoai tây", "Cánh gà chiên nước mắm"], "_code": "df = pd.concat([So_chi_tiet_ban_hang_1, So_chi_tiet_ban_hang_2], ignore_index=True)\ndf['d'] = parse_date(df['Ngày'])\na = pd.Timestamp(as_of_date)\nstart = a - pd.Timedelta(days=a.weekday()+7); end = start + pd.Timedelta(days=6)\nm = df['d'].between(start, end) & ~df['Trạng thái'].str.contains('hủy|huỷ|trả', case=False, na=False) & (df['Tên hàng hóa'] != 'Phí phục vụ')\ng = df[m].groupby('Tên hàng hóa')['Số lượng quy đổi'].apply(lambda s: to_num(s).sum()).sort_values(ascending=False)\nRESULT = list(g.head(5).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fe680ecf01d9", "type": "percent", "answer": -29.73, "_code": "df = So_chi_tiet_ban_hang_1__all.copy()\ndf = pd.concat([df, So_chi_tiet_ban_hang_2026__all], ignore_index=True)\ndf['d'] = parse_date(df['Ngày'])\nbad = df['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả|hoàn trả', case=False, na=False)\nbadord = set(df.loc[bad,'Mã đơn hàng'])\nok = df[~df['Mã đơn hàng'].isin(badord)]\nok = ok[ok['Tên hàng hóa'].str.lower().str.strip()=='soda chanh dây (m)']\nD = pd.Timestamp('2025-09-10')\nq = to_num(ok['Số lượng quy đổi'])\nafter = q[(ok['d']>=D)&(ok['d']<=D+pd.Timedelta(days=13))].sum()\nbefore = q[(ok['d']>=D-pd.Timedelta(days=14))&(ok['d']<=D-pd.Timedelta(days=1))].sum()\nRESULT = f\"{round((after-before)/before*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
