_verdict": "correct"}
{"id": "q_14ea21a5b6a1", "type": "list", "answer": [16970600, 244446600], "_code": "h=DanhSachHoaDon.copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])&(h.d>='2026-05-01')&(h.d<='2026-05-29')]\nc=DanhSachHoaDonChiTiet.copy(); c['a']=to_num(c['Thành tiền'])\nt=c.groupby('Mã hóa đơn').a.sum()\nh['tt']=h['Mã hóa đơn'].map(t).fillna(0)\ns=h.groupby('Kênh bán').tt.sum()\nRESULT=[int(s[\"zalo_oa\"]),int(s[\"store\"])]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8d5736c69340", "type": "number", "answer": 156698000, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all]).dropna(subset=['Mã hóa đơn']).drop_duplicates().reset_index(drop=True)\nd['q']=to_num(d['so_luong']) if d['so_luong'].dtype==object else d['so_luong']\nd['q']=pd.to_numeric(d['so_luong'],errors='coerce')\nbad=set(d[(d.q<0)|d['Status'].str.contains('hủy|huỷ|trả',case=False)]['Mã hóa đơn'])\nd['dt']=parse_date(d['Ngày giao dịch']); d['gio']=pd.to_datetime(d['Giờ']).dt.hour\nd=d[~d['Mã hóa đơn'].isin(bad)&(d.q>0)]\nd['a']=mser(d['Trị giá'])\nd=d[(d.dt.dt.year==2025)&(d.dt.dt.month==3)&(d.gio>=14)&(d.gio<=21)]\nRESULT=int(round(d.a.sum()))\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_6716fba9f56e", "type": "number", "answer": 24, "_code": "d=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nm=d[(d.dt>='2026-03-01')&(d.dt<='2026-03-31')]\nRESULT=int(m[m['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel',case=False,na=False)]['Mã đơn hàng'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f5fd1585c5c6", "type": "number", "answer": 910179600, "_code": "s=SoBanHang.copy()\ns['d']=parse_date(s['Ngày mua'])\ns=s[s['Ghi chú TT'].isin(['xong','Đang vận chuyển'])&(s.d>='2025-06-01')&(s.d<='2025-06-30')]\nRESULT=int(to_num(s['thanh_tien']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_122c8d717bba", "type": "number", "answer": 11111900, "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    sg=-1 if s.startswith('-') else 1\n    s=s.lstrip('-').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return sg*(int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0))\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)\\s*k',s)\n    if m: return sg*float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return sg*float(s)\n    except: return float('nan')\n\na=DonHang_ChiTiet__all.drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày đặt hàng'],format='%d/%m/%Y')\na['t']=a['Tổng tiền'].map(money)\nbad=set(a[a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'])\nv=a[~a['Mã đơn hàng'].isin(bad)]\nRESULT=int(v[v.dt==as_of_date].t.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_26f9e148ca7f", "type": "list", "answer": ["Xi măng Hà Tiên PCB40 bao 50kg", "Lưới B40 mạ kẽm khổ 1.5m", "Gạch ống 8x8x18 Tuynel"], "_code": "DSHH=[v for k,v in data.items() if k.startswith('Danh')][0]\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nbad=set(d[d['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]['Mã đơn hàng'])\nm=d[(d.dt>='2025-05-01')&(d.dt<='2025-05-31')&~d['Mã đơn hàng'].isin(bad)&(d['Tên hàng hóa']!='Phí phục vụ')].copy()\nm['q']=to_num(m['Số lượng quy đổi'])\ng=m.groupby('Tên hàng hóa').q.sum().reset_index().merge(DSHH[['Mã hàng hóa','Tên hàng hóa']],on='Tên hàng hóa',how='left').sort_values(['q','Mã hàng hóa'],ascending=[False,True])\nRESULT=list(g['Tên hàng hóa'].head(3))\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_2e8a1220169c", "type": "list", "answer": ["Triệu Cường Thanh", "Nghiêm Bình Hằng", "Triệu Mai Huy", "Châu Châu Anh", "Tạ Quang Khánh"], "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\n\nh=DanhSachHoaDon__all.drop_duplicates().drop_duplicates('Mã hóa đơn').reset_index(drop=True)\nh['dt']=pdate(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|Đổi trả',case=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates(); c=c.assign(v=money(c['Thành tiền']))\nr=c.groupby('Mã hóa đơn').v.sum()\nh['v']=h['Mã hóa đơn'].map(r).fillna(0)\nm=h[(h.dt>='2026-05-01')&(h.dt<='2026-05-31')&h['Mã KH'].notna()]\ng=m.groupby('Mã KH').v.sum().sort_values(ascending=False)\nnm=DanhSachKhachHang.drop_duplicates('Mã khách hàng').set_index('Mã khách hàng')['Tên khách hàng']\nRESULT=[nm[k] for k in g.head(5).index]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5023d3652206", "type": "number", "answer": 250, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\n\nd=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).dropna(subset=['Mã đơn hàng']).drop_duplicates().reset_index(drop=True)\nd['dt']=pdate(d['Ngày']); d['v']=money(d['Thành tiền'])\nbad=set(d[d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bad)]\no=d.groupby('Mã đơn hàng').agg(v=('v','sum'),dt=('dt','min'))\no=o[(o.dt>='2026-07-01')&(o.dt<='2026-07-31')]\nRESULT=int((o.v>=1100000).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3b1947e15f4d", "type": "list", "answer": ["Xi măng Hà Tiên PCB40 bao 50kg", "Xi măng INSEE Power-S bao 50kg", "Băng keo điện Nano 20 yard"], "_code": "d=Bao_cao_ban_hang__So_chi_tiet_ban_hang.copy()\nd=d[d['Mã đơn hàng'].notna()].drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nbad=set(d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bad)&(d.dt>='2025-07-01')&(d.dt<='2025-07-31')].copy()\nd['q']=to_num(d['Số lượng quy đổi'])\nhh=Bao_cao_ban_hang__Danh_sách_hàng_hóa\nmp={normalize_text(n):(c,n) for c,n in zip(hh['Mã hàng hóa'],hh['Tên hàng hóa'])}\nd['c']=d['Tên hàng hóa'].map(lambda x: mp.get(normalize_text(x),(x,x))[0])\ns=d.groupby('c')['q'].sum().reset_index().sort_values(['q','c'],ascending=[False,True])\nnm={c:n for c,n in mp.values()}\nRESULT=[nm.get(c,c) for c in s['c'].head(3)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_be3b60280c31", "type": "list", "answer": ["Hà An Hương", "Tô Hạnh Phong", "Đỗ Hằng Đức"], "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt>='2025-04-28')&(d.dt<='2025-05-04')]\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False)]\nd=d[~d['Khách hàng'].str.lower().str.strip().isin(['lẻ','khách lẻ','kl'])]\nd['a']=mser(d['Thành tiền'])\nd['k']=d['Khách hàng'].map(normalize_text)\ns=d.groupby('k').a.sum().sort_values(ascending=False,kind='stable')\nnm=d.groupby('k')['Khách hàng'].first()\nRESULT=[nm[k] for k in s.index[:3]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_21a7c98568e0", "type": "date", "answer": "2025-10", "_code": "d=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).drop_duplicates()\nd=d[d['Ngày'].notna()].copy()\nd['dt']=parse_date(d['Ngày']); d['a']=to_num(d['Thành tiền'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd['m']=d.dt.dt.strftime('%Y-%m')\ns=d[d.m.isin(['2025-10','2025-11','2025-12'])].groupby('m').a.sum()\nRESULT=s.idxmax()\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_cbaf5d921e3c", "type": "list", "answer": [21961500, 190847000], "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\no=don_hang.drop_duplicates().copy()\no['dt']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])&(o.dt>='2026-08-01')&(o.dt<='2026-08-14')]\nc=chi_tiet_don.drop_duplicates()\nc=c[c['Số CT'].isin(o['Số phiếu'])].copy(); c['t']=mon(c['Tiền bán'])\ns=c.groupby('Số CT').t.sum()\no['rev']=o['Số phiếu'].map(s)\nRESULT=[int(o[o['Hình thức thanh toán']=='cod'].rev.sum()),int(o[o['Hình thức thanh toán']=='transfer'].rev.sum())]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8cb56eea9997", "type": "percent", "answer": 1.98, "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    sg=-1 if s.startswith('-') else 1\n    s=s.lstrip('-').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return sg*(int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0))\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)\\s*k',s)\n    if m: return sg*float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return sg*float(s)\n    except: return float('nan')\n\no=don_hang.drop_duplicates('Mã chứng từ').copy(); c=chi_tiet_don.drop_duplicates().copy()\no['dt']=parse_date(o['NgayBan'])\nc['t']=c['T.Tiền'].map(money)\no['r']=o['Mã chứng từ'].map(c.groupby('Ma don').t.sum())\nv=o[o['Xử lý'].isin(['completed','shipping'])]\n\nj=v[(v.dt>='2025-06-01')&(v.dt<='2025-06-30')].r.sum(); m=v[(v.dt>='2025-05-01')&(v.dt<='2025-05-31')].r.sum()\nRESULT=f\"{(j-m)/m*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
