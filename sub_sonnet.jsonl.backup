{"id": "q_de25efb21b9a", "type": "string", "answer": "Đỗ Bích Linh", "_code": "\ndf=DonHang_ChiTiet.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[(df.d>='2025-05-01')&(df.d<='2025-05-31')&~df['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|hoàn hàng|trả',case=False)]\ndf=df[~df['Tên khách hàng'].astype(str).str.contains('lẻ|^kl$',case=False)]\nRESULT=df.groupby('Tên khách hàng')['Mã đơn hàng'].nunique().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
