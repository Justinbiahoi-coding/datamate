{"id": "q_d15bde861202", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Ông Quang Hoàng", 145500], ["Tô Quân Bình", 125500], ["Từ Hải Thanh", 123000], ["Võ Tâm Phong", 111000], ["Vũ Khánh Tâm", 101000]]}, "_code": "o=don_hang.copy(); o['d']=parse_date(o['NgayBan'])\no=o[(o['Xử lý']!='cancelled')&(~o['Bán qua'].astype(str).str.lower().isin(['cod'])|False)&(o['Phương thức TT']!='cod')&(o.d<=as_of_date)]\no=o[~o['Bán qua'].astype(str).str.lower().str.contains('shopee|lazada|tiktok|sàn|tmđt|sendo')]\np=thanh_toan.copy(); p['t']=parse_date(p['Thời gian thu'].astype(str).str[:10]); p=p[p.t<=as_of_date]\np['Tiền']=to_num(p['Tiền']); paid=p.groupby('Số HĐ')['Tiền'].sum()\no['paid']=o['Mã chứng từ'].map(paid).fillna(0)\no['debt']=to_num(o['Tổng bill'])-o['paid']\no=o[(o.debt>0)&o['Số KH'].notna()]\ng=o.groupby('Số KH').debt.sum().sort_values(ascending=False).head(5)\nnm=khach_hang.set_index(\"ma_kh\")[\"Khách lẻ/sỉ\"].astype(str).str.replace(r\"[\\s\\(\\-]*\\d{9,11}\\)?\",\"\",regex=True).str.strip()\nRESULT={\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[nm.get(k,k),int(v)] for k,v in g.items()]}\n", "_attempts": 2, "_verdict": "correct"}
