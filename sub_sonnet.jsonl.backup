{"id": "q_301e64ea77a9", "type": "percent", "answer": -10.35, "_code": "import re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=_re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f)*10**(6-len(f)) if f else 0)\n    m=_re.fullmatch(r'(\\d+),(\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s)\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[oc]=d[oc].ffill()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nd['amt']=d['Tổng tiền'].map(money)\na=d[(d.dt>='2025-08-01')&(d.dt<='2025-08-31')].amt.sum(); b=d[(d.dt>='2025-07-01')&(d.dt<='2025-07-31')].amt.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5bc7c4b613cf", "type": "number", "answer": 84126, "_code": "import re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=_re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f)*10**(6-len(f)) if f else 0)\n    m=_re.fullmatch(r'(\\d+),(\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s)\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[oc]=d[oc].ffill()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nd['amt']=d['Tổng tiền'].map(money)\nx=d[(d.dt>='2026-06-15')&(d.dt<='2026-06-21')]\nRESULT=int(round(x.amt.sum()/x['Mã đơn hàng'].nunique()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_30b0438e60ab", "type": "number", "answer": 3878164.0, "_code": "o=don_hang.copy()\no=o[(o['Trả bằng']=='debt')&~o['Tình trạng'].isin(['cancelled'])]\no['od']=pd.to_datetime(o['Ngày']).dt.normalize()\nt=thanh_toan.copy(); t['pd']=pd.to_datetime(t['Ngày thu'],errors='coerce')\nm=t.merge(o[['Mã chứng từ','od']],left_on='Số CT',right_on='Mã chứng từ')\nm=m[(m.pd.dt.normalize()>m.od)&(m.pd.dt.year==2025)&(m.pd.dt.month==12)]\nRESULT=float(to_num(m['Giá trị']).sum())\nprint(len(o),o.od.min(),len(m))\n", "_attempts": 1, "_verdict": "correct"}
