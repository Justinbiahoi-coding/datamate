{"id": "q_4c974b445a53", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Lâm Bảo Ngọc", 632000], ["Nghiêm Duy Linh", 620000], ["Lương Huy Quang", 360500], ["Lương Thanh Hương", 230000], ["Tống Ngọc Trung", 168000]]}, "_code": "d=don_hang.drop_duplicates().copy()\nd=d[~d[\"Tình trạng\"].str.contains(\"cancel|hủy|huỷ\",case=False,na=False)]\nd=d[(d[\"Trả bằng\"]!=\"cod\")&(~d[\"Loại bán\"].str.contains(\"cod|shopee|lazada|tiktok|sàn|ecom|tmđt\",case=False,na=False))]\nd[\"d\"]=parse_date(d[\"Ngày\"]); d=d[d[\"d\"]<=\"2026-07-28\"]\nt=thanh_toan.copy(); t[\"tt\"]=parse_date(t[\"Ngày thu\"]); t=t[t[\"tt\"]<\"2026-07-29\"]\npaid=t.groupby(\"Số CT\")[\"Giá trị\"].apply(lambda s:to_num(s).sum())\nd[\"owe\"]=to_num(d[\"Tổng đơn\"])-d[\"Mã chứng từ\"].map(paid).fillna(0)\nd=d[d[\"owe\"]>0]\nd=d[d[\"Customer ID\"].notna()].merge(khach_hang[[\"Mã KH\",\"Khách hàng (tên)\"]],left_on=\"Customer ID\",right_on=\"Mã KH\",how=\"left\")\ns=d.groupby([\"Customer ID\",\"Khách hàng (tên)\"])[\"owe\"].sum().sort_values(ascending=False).head(5)\nRESULT={\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[k[1],int(v)] for k,v in s.items()]}\n", "_attempts": 1, "_verdict": "correct"}
