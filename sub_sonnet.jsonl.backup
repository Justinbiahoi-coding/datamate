{"id": "q_864c9d9c036a", "type": "percent", "answer": -12.06, "_code": "d=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill(); d=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['a']=to_num(d['Tổng tiền'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả',case=False,na=False)]\ndef r(a,b): return d[(d.dt>=a)&(d.dt<=b)].a.sum()\nx=r('2026-05-01','2026-05-09'); y=r('2026-04-01','2026-04-09')\nRESULT=f\"{round((x-y)/y*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
