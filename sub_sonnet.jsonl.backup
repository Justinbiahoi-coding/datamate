{"id": "q_b32d159109ba", "type": "number", "answer": 1054300, "_code": "import pandas as pd, re\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\ndef money(s):\n    s=str(s).strip().lower()\n    k=s.endswith('k')\n    v=float(re.sub(r'[^\\d]','',s) or 0)\n    return v*1000 if k else v\nd['v']=d['Tổng tiền'].map(money)\nd['dt']=pd.to_datetime(d['Ngày đặt hàng'],format='%d/%m/%Y')\nd['nm']=d['Tên sản phẩm'].str.lower().str.strip()\nok=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nx=ok[(ok.nm.str.contains('alaxan'))&(ok.dt>='2026-01-01')&(ok.dt<'2026-02-01')]\nRESULT=int(x['v'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c64f75d0203d", "type": "number", "answer": 166200, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in('','nan','none'): return 0.0\n    m=1\n    if s.endswith('tr'): m=1e6; s=s[:-2]\n    elif s.endswith('k'): m=1000; s=s[:-1]\n    s=re.sub(r'[đd₫\\s]|vnd','',s)\n    if re.fullmatch(r'-?\\d{1,3}([.,]\\d{3})+',s): s=re.sub(r'[.,]','',s)\n    else: s=s.replace(',','.')\n    return float(s)*m\nn=DanhSachNhapHang.copy()\nn=n[~n['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nn['d']=parse_date(n['Thời gian'])\nn=n[(n.d>='2025-07-01')&(n.d<='2025-07-31')]\nL=DanhSachChiTietNhapHang.merge(n[['Mã nhập hàng']],on='Mã nhập hàng')\nL=L[(L['Mã hàng']=='SP0067')&(L['ĐVT']=='hộp')]\nL['g']=L['Đơn giá'].map(money); L['q']=L['Số lượng'].map(money)\nRESULT=int(round((L.g*L.q).sum()/L.q.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7b7d5819e674", "type": "number", "answer": 211400, "_code": "n=phieu_nhap[phieu_nhap.TinhTrang!='cancelled'].copy()\nn=n[(n.NgayNhapKho>='2025-08-01')&(n.NgayNhapKho<='2025-08-31')]\nL=chi_tiet_nhap.merge(n[['MaPhieuNhap']],on='MaPhieuNhap')\nL=L[(L.MaHangHoa=='SP0048')&(L.DonViTinh=='hộp')]\nL['g']=pd.to_numeric(L.DonGiaNhap); L['q']=pd.to_numeric(L.SL)\nRESULT=int(round((L.g*L.q).sum()/L.q.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_112c84a433a5", "type": "percent", "answer": -1.79, "_code": "d=DonHang_ChiTiet__all.copy().drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd['m']=to_num(d['Tổng tiền'])\nbad=d['Trạng thái đơn hàng'].str.lower().str.contains('hủy|huỷ|hoàn hàng|trả')\nbadord=set(d.loc[bad,'Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(badord)]\nR=lambda a,b:d[(d.dt>=a)&(d.dt<=b)].m.sum()\na=R('2026-05-01','2026-05-31'); b=R('2026-04-01','2026-04-30')\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_39698eb3a76b", "type": "number", "answer": 7, "_code": "import pandas as pd, re\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\ndef money(s):\n    s=str(s).strip().lower()\n    k=s.endswith('k')\n    v=float(re.sub(r'[^\\d]','',s) or 0)\n    return v*1000 if k else v\nd['v']=d['Tổng tiền'].map(money)\nd['dt']=pd.to_datetime(d['Ngày đặt hàng'],format='%d/%m/%Y')\nd['nm']=d['Tên sản phẩm'].str.lower().str.strip()\nok=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nx=ok[(ok.dt>='2025-01-01')&(ok.dt<'2025-02-01')]\ns=x.groupby('dt')['v'].sum()\nRESULT=int((s>=8600000).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7c955f4e323d", "type": "number", "answer": 158, "_code": "import pandas as pd, re\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\ndef money(s):\n    s=str(s).strip().lower()\n    k=s.endswith('k')\n    v=float(re.sub(r'[^\\d]','',s) or 0)\n    return v*1000 if k else v\nd['v']=d['Tổng tiền'].map(money)\nd['dt']=pd.to_datetime(d['Ngày đặt hàng'],format='%d/%m/%Y')\nd['nm']=d['Tên sản phẩm'].str.lower().str.strip()\nok=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nx=ok[(ok.nm.str.contains('nurofen for children'))&(ok.dt>='2025-01-01')&(ok.dt<'2025-02-01')]\nRESULT=int(to_num(x['Số lượng sản phẩm']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b062e81ad64a", "type": "number", "answer": 867904100, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in('','nan','none'): return 0.0\n    m=1\n    if s.endswith('tr'): m=1e6; s=s[:-2]\n    elif s.endswith('k'): m=1000; s=s[:-1]\n    s=re.sub(r'[đd₫\\s]|vnd','',s)\n    if re.fullmatch(r'-?\\d{1,3}([.,]\\d{3})+',s): s=re.sub(r'[.,]','',s)\n    else: s=s.replace(',','.')\n    return float(s)*m\nH=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nH=H[~H['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nH['d']=parse_date(H['Thời gian'])\nH=H[(H.d>='2025-04-01')&(H.d<='2025-06-30')]\nC=DanhSachHoaDonChiTiet.drop_duplicates().merge(H[['Mã hóa đơn']],on='Mã hóa đơn')\nRESULT=int(round(C['Thành tiền'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_10bc8425f884", "type": "number", "answer": 20455, "_code": "import pandas as pd, re\ndef money(s):\n    s=str(s).strip().lower()\n    if s.endswith('tr'): return float(s[:-2].replace(',','.'))*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1e3\n    return float(re.sub(r'[^\\d]','',s))\nn=SoTay_NhapHang.copy(); n['dt']=parse_date(n['Ngày nhập'])\nn=n[n.Product.str.contains('Oresol 245 DHG hộp 20 gói',case=False,na=False)&(n.dt>='2025-08-01')&(n.dt<='2025-08-31')]\nRESULT=round(n['Thành tiền'].map(money).sum()/to_num(n['SL nhập']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_83f255a9aa36", "type": "number", "answer": 76813, "_code": "h=DanhSachHoaDon__all.copy()\nh['d']=parse_date(h['Thời gian'])\nl=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nl['t']=to_num(l['Thành tiền'])\nok=h[h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\nx=ok[(ok['d']>='2025-06-01')&(ok['d']<='2025-06-30')]\nRESULT=int(l[l['Mã hóa đơn'].isin(set(x['Mã hóa đơn']))]['t'].sum()/len(x)+0.5)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b2550bf9eec6", "type": "number", "answer": 1929900, "_code": "h=DanhSachHoaDon__all.copy()\nh['d']=parse_date(h['Thời gian'])\nl=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nl['t']=to_num(l['Thành tiền'])\nok=h[h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\nx=ok[(ok['d']>='2026-04-01')&(ok['d']<='2026-04-30')]\ncodes=set(DanhSachThuoc[DanhSachThuoc['Hoạt chất'].str.strip().str.lower()=='loratadin']['Mã hàng'])\ny=l[l['Mã hóa đơn'].isin(set(x['Mã hóa đơn']))&l['Mã hàng'].isin(codes)]\nRESULT=int(y['t'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_56724d89c623", "type": "number", "answer": 35, "_code": "h=DanhSachHoaDon.drop_duplicates().copy()\nh['dt']=parse_date(h['Thời gian tạo'])\nh=h[(h.dt<'2026-06-20')&(h['Phương thức thanh toán']=='Ghi nợ')&~h['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\ns=SoQuy.drop_duplicates().copy()\ns['t']=parse_date(s['Thời gian']); s=s[s.t<'2026-06-20']\ns['v']=s['Giá trị'].astype(str).str.replace('đ','').str.replace('.','',regex=False).astype(float)\npaid=s.groupby('Mã hóa đơn').v.sum()\nh['due']=to_num(h['Tổng sau giảm giá'])-h['Mã hóa đơn'].map(paid).fillna(0)\nRESULT=int(h[h.due>0]['Mã KH'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5143882a58d9", "type": "number", "answer": 49000, "_code": "h=DanhSachHoaDon__all.copy()\nh['d']=parse_date(h['Thời gian'])\nl=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nl['t']=to_num(l['Thành tiền'])\nok=h[h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\nx=h[(h['d']=='2026-01-16')]\ny=l[l['Mã hóa đơn'].isin(set(x['Mã hóa đơn']))&(l['Mã hàng']=='SP0056')]\nRESULT=int((to_num(y['Đơn giá'])/(y['Số lượng quy đổi'].astype(float)/to_num(y['Số lượng']))).round().iloc[0]) if len(y) else 'unanswerable'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a96587cbb62d", "type": "number", "answer": 203470, "_code": "import re, unicodedata\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    t=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=t.startswith('-'); t=t.lstrip('-')\n    m0=re.fullmatch(r'(\\d+[,.]\\d+)tr',t)\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',t)\n    if m0: v=round(float(m0.group(1).replace(',','.'))*1_000_000)\n    elif m:\n        a=int(m.group(1))*1_000_000; r=m.group(2)\n        v=a+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n    elif t.endswith('k'): v=float(t[:-1].replace(',','.'))*1000\n    else: v=float(re.sub(r'[.,]','',t))\n    return -v if neg else v\ndef qty(x):\n    if isinstance(x,(int,float)): return float(x)\n    m=re.match(r'\\s*(-?\\d+(?:[.,]\\d+)?)',str(x)); return float(m.group(1).replace(',','.'))\nn=SoNhapHang.copy()\nn['dt']=parse_date(n['Ngày nhập'])\nn=n[(n.Product=='Bộ van dây gas Namilux')&(n.dt>='2026-04-01')&(n.dt<'2026-05-01')].drop_duplicates()\nRESULT=int(round(n['Thành tiền'].map(money).sum()/n['SL nhập'].map(qty).sum()+1e-9))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_be2c1e544b63", "type": "number", "answer": 533299, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in('','nan','none'): return 0.0\n    mm=re.fullmatch(r'(\\d+)tr(\\d+)',s)\n    if mm: return float(mm.group(1))*1e6+float(mm.group(2).ljust(6,'0')[:6] if len(mm.group(2))>=3 else mm.group(2).ljust(6,'0'))\n    m=1\n    if s.endswith('tr'): m=1e6; s=s[:-2]\n    elif s.endswith('k'): m=1000; s=s[:-1]\n    s=re.sub(r'[đd₫\\s]|vnd','',s)\n    if re.fullmatch(r'-?\\d{1,3}([.,]\\d{3})+',s): s=re.sub(r'[.,]','',s)\n    else: s=s.replace(',','.')\n    return float(s)*m\nO=don_hang.drop_duplicates('Mã chứng từ').copy()\nO=O[O['Tình trạng'].isin(['completed','shipping'])]\nO['d']=parse_date(O['Ngày'])\nO=O[(O.d>='2025-04-01')&(O.d<='2025-04-30')]\nC=chi_tiet_don.drop_duplicates().merge(O[['Mã chứng từ']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\nrev=C['Amount'].map(money).sum()\nRESULT=int(rev/len(O)+0.5)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7f283f673cee", "type": "percent", "answer": 37.14, "_code": "import unicodedata,re\nd=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\no=d[hc].drop_duplicates('Mã đơn hàng').copy()\no['dt']=parse_date(o['Ngày đặt hàng'])\nbad=o['Trạng thái đơn hàng'].str.lower().str.contains('hủy|huỷ|trả')\no=o[~bad]\no=o[(o.dt>='2025-08-01')&(o.dt<='2025-08-31')]\ndef norm(s):\n    s=unicodedata.normalize('NFC',str(s)).lower()\n    s=re.sub(r'[\\d\\s\\-\\.\\(\\)]+$','',s.strip()) if False else s\n    return re.sub(r'\\s+',' ',s).strip()\no['k']=o['Tên khách hàng'].map(norm)\no=o[~o.k.isin(['khách lẻ','khach le','lẻ'])]\nn=o.groupby('k').size()\nRESULT=f\"{round((n>=4).mean()*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
