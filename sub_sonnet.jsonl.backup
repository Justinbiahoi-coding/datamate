{"id": "q_410092466d7f", "type": "percent", "answer": 2.84, "_code": "\nh=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').reset_index(drop=True)\nh['dt']=parse_date(h['Thời gian'])\nm=h[(h.dt>='2025-06-01')&(h.dt<='2025-06-30')]\nRESULT=f\"{m['Trạng thái'].str.contains('hủy|huỷ',case=False).sum()/len(m)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0bb2685c3a94", "type": "list", "answer": ["Tạ Hoàng Lan", "Đoàn Thảo Quang", "Doãn Bảo Đức", "Huỳnh Đức Huy", "Từ Nam Lan"], "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\nd=DonHang_ChiTiet_2026__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[(d.dt>='2026-06-01')&(d.dt<='2026-06-30')]\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False)]\nd=d[d['Tên khách hàng'].str.lower().str.strip()!='khách lẻ']\nd['a']=mser(d['Tổng tiền'])\nd['k']=d['Tên khách hàng'].map(normalize_text)\ns=d.groupby('k').a.sum().sort_values(ascending=False,kind='stable')\nnm=d.groupby('k')['Tên khách hàng'].first()\nRESULT=[nm[k] for k in s.index[:5]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8537fb573ddc", "type": "percent", "answer": 14.48, "_code": "h=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[(h.dt>='2026-04-01')&(h.dt<='2026-04-30')]\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nc['tt']=to_num(c['Thành tiền'])\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\nkh=DanhSachKhachHang.set_index('Mã khách hàng')['Nhóm khách hàng']\nm=h.set_index('Mã hóa đơn')['Mã KH'].map(kh)\nc['g']=c['Mã hóa đơn'].map(m)\ntot=c.tt.sum()\nRESULT=f\"{c[c.g.str.strip().str.lower()=='thân thiết'].tt.sum()/tot*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3401f1835289", "type": "percent", "answer": -16.26, "_code": "h=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\ndef rev(y,m):\n    x=h[(h.dt.dt.year==y)&(h.dt.dt.month==m)]\n    x=x[~x['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]\n    c=DanhSachHoaDonChiTiet.drop_duplicates()\n    return to_num(c[c['Mã hóa đơn'].isin(x['Mã hóa đơn'])]['Thành tiền']).sum()\na,b=rev(2025,2),rev(2025,1)\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e56ff73230f4", "type": "number", "answer": 55, "_code": "h=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nok=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)&(h.dt>='2025-04-01')&(h.dt<='2025-04-30')]\nsp=DanhSachSanPham[DanhSachSanPham['Tên hàng'].str.contains('voltaren emulgel 1% tuýp 20g',case=False,na=False)]\nc=DanhSachHoaDonChiTiet[DanhSachHoaDonChiTiet['Mã hóa đơn'].isin(ok['Mã hóa đơn'])&DanhSachHoaDonChiTiet['Mã hàng'].isin(sp['Mã hàng'])].drop_duplicates()\nRESULT=int(to_num(c['Số lượng quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d2c5d949e232", "type": "list", "answer": [194600, 22400], "_code": "h=DuLieuBanHang__DanhSachHoaDon.copy(); s=DuLieuBanHang__SoQuy.copy()\nh['od']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh['tot']=to_num(h['Tổng sau giảm giá'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel',case=False)&(h['Phương thức thanh toán']=='Ghi nợ')&(h['Mã KH']=='KH0067')]\ns['pd']=pd.to_datetime(s['Thời gian']).dt.normalize(); s['v']=to_num(s['Giá trị'])\ns=s.merge(h[['Mã hóa đơn','od']],on='Mã hóa đơn')\nsame=s[s.pd==s.od].groupby('Mã hóa đơn').v.sum()\nf=h[(h.od>='2026-02-01')&(h.od<='2026-02-28')].copy()\nf['same']=f['Mã hóa đơn'].map(same).fillna(0)\nadd=(f.tot-f.same).clip(lower=0).sum()\npaid=s[(s.pd>s.od)&(s.pd>='2026-02-01')&(s.pd<='2026-02-28')].v.sum()\nRESULT=[int(add),int(paid)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f448394fcfee", "type": "list", "answer": [13759000, 16074900], "_code": "h=DanhSachHoaDon__all.copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[h['Trạng thái'].isin(['Thành công','ok','Đang xử lý'])&(h.d>='2025-09-01')&(h.d<='2025-09-30')]\nc=DanhSachHoaDonChiTiet.copy(); c['a']=to_num(c['Thành tiền'])\nt=c.groupby('Mã hóa đơn').a.sum()\nh['tt']=h['Mã hóa đơn'].map(t).fillna(0)\ns=h.groupby('Kênh bán').tt.sum()\nRESULT=[int(s['phone']),int(s['zalo_oa'])]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_df88bdab431d", "type": "number", "answer": 29100000, "_code": "df=SoBanHang.copy()\ndf['d']=parse_date(df['Ngày mua'])\ndf=df[(df.d>='2026-06-01')&(df.d<='2026-06-30')&(df['Mặt hàng'].str.strip()=='Keo dán gạch Weber.tai fix xám 25kg')]\ndf=df[~df['Ghi chú TT'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]\nRESULT=int(round(to_num(df['thanh_tien']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a466e64f5e76", "type": "string", "answer": "Cao Bình Dương", "_code": "h=DanhSachHoaDon.copy(); c=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nh['od']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)]\nc['a']=to_num(c['Thành tiền'])\nt=c.groupby('Mã hóa đơn').a.sum()\nh['rev']=h['Mã hóa đơn'].map(t).fillna(0)\nx=h[(h.od>='2026-03-01')&(h.od<='2026-03-31')&h['Mã KH'].notna()]\nk=x.groupby('Mã KH').rev.sum().sort_values(ascending=False,kind='stable')\nn=DanhSachKhachHang.set_index('Mã khách hàng')['Tên khách hàng']\nRESULT=n[k.index[0]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_70827096caa6", "type": "percent", "answer": 2.16, "_code": "df=data['So_chi_tiet_ban_hang__all'].copy()\ndf['d']=parse_date(df['Ngày'])\ndf=df[(df.d>='2025-10-01')&(df.d<='2025-10-31')]\nst=df.groupby('Mã đơn hàng')['Trạng thái'].first()\ncanc=st.str.contains('hủy|huỷ|cancel',case=False,na=False).sum()\nRESULT=f\"{round(canc/len(st)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d7dbc4edf96e", "type": "number", "answer": 1176170, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\nh=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[(h.dt<='2025-10-17')&~h['Trạng thái'].str.contains('hủy|huỷ',case=False)&~h['Phương thức thanh toán'].str.contains('COD')]\nh['tot']=mser(h['Tổng sau giảm giá'])\np=SoQuy.copy(); p['dt']=pd.to_datetime(p['Thời gian']).dt.normalize()\np=p[p.dt<='2025-10-17']; p['v']=mser(p['Giá trị'])\npaid=p.groupby('Mã hóa đơn').v.sum()\nh['paid']=h['Mã hóa đơn'].map(paid).fillna(0)\nr=(h.tot-h.paid)\nRESULT=int(round(r[r>0].sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bf80bd92e113", "type": "percent", "answer": 2.32, "_code": "\nd=SoBanHang__all.drop_duplicates().reset_index(drop=True)\nd['dt']=pd.to_datetime(d['Giờ'].astype(str).str[:10],errors='coerce')\nm=d[(d.dt>='2025-04-01')&(d.dt<='2025-04-30')]\no=m.groupby('Mã phiếu')['Ghi chú TT'].agg(lambda s:' '.join(s.astype(str)))\nRESULT=f\"{o.str.contains('hủy|huỷ',case=False).sum()/len(o)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8de2cbc8727d", "type": "number", "answer": 725786500, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\n\nd=ban_hang.drop_duplicates().reset_index(drop=True)\nd['dt']=parse_date(d['Ngày bán'])\nm=d[(d.dt>='2025-10-01')&(d.dt<='2025-10-31')].copy()\nbad=set(m[m['Trạng thái xử lý'].str.contains('Huỷ|hủy|trả',case=False)]['Số phiếu'])\nm=m[~m['Số phiếu'].isin(bad)]\nRESULT=int(round(money(m['Amount']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_313dfc683558", "type": "list", "answer": [337066700, 266675100, 263443400], "_code": "h=DuLieuBanHang__DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nprint(h['Trạng thái'].unique())\nh=h[~h['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả|hoàn|không giao',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nc['tt']=to_num(c['Thành tiền'])\nc=c.merge(h[['Mã hóa đơn','dt']],on='Mã hóa đơn')\nout=[]\nfor m in (2,3,4):\n    out.append(int(round(c[(c.dt.dt.year==2025)&(c.dt.dt.month==m)].tt.sum())))\nRESULT=out\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9704b8976187", "type": "number", "answer": 1365534500, "_code": "d=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nbad=d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|không giao',case=False,na=False)\noid=d[bad]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(oid)&(d.dt>='2025-08-01')&(d.dt<='2025-08-31')]\nRESULT=round(to_num(d['Thành tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bf22965b9ea7", "type": "date", "answer": "2028-07-06", "_code": "lo=BanHang_LoHang[BanHang_LoHang['Mã món']=='SP0056'].copy()\nbl=BanHang_BanTheoLo.copy()\nbl['net']=to_num(bl['SL quy ra lẻ'])-to_num(bl['SL trả (ĐVT cơ bản)'])\nsold=bl.groupby('Lô')['net'].sum()\nlo['ton']=to_num(lo['SL nhập (ĐVT cơ bản)'])-lo['Lô'].map(sold).fillna(0)\nlo['h']=pd.to_datetime(lo['HSD'],format='%d/%m/%Y')\nlo=lo[(lo.ton>0)&(lo.h>=as_of_date)].sort_values('h')\nRESULT=lo.iloc[0]['h'].strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e04060a8515a", "type": "number", "answer": 459715500.0, "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return float(s)\n    except: return float('nan')\n\no=don_hang.drop_duplicates('Mã chứng từ').copy(); ct=chi_tiet_don.drop_duplicates().copy()\no['dt']=pd.to_datetime(o['Ngày'].astype(str).str[:10])\nct['a']=ct['Amount'].map(money)\nok=o[(o['Tình trạng'].isin(['completed','shipping']))&(o.dt>='2025-10-01')&(o.dt<='2025-10-31')&(o['Trả bằng']=='cash')]\nRESULT=ok['Mã chứng từ'].map(ct.groupby('Mã đơn hàng').a.sum()).sum()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1dbb93afc51e", "type": "date", "answer": "2026-04-25", "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return float(s)\n    except: return float('nan')\n\no=don_hang.drop_duplicates('Mã chứng từ').copy(); ct=chi_tiet_don.drop_duplicates().copy()\no['dt']=pd.to_datetime(o['Ngày'].astype(str).str[:10])\nct['a']=ct['Amount'].map(money)\nok=o[(o['Tình trạng'].isin(['completed','shipping']))&(o.dt>='2026-04-01')&(o.dt<='2026-04-30')]\nok=ok.assign(r=ok['Mã chứng từ'].map(ct.groupby('Mã đơn hàng').a.sum()))\nRESULT=str(ok.groupby('dt').r.sum().idxmax().date())\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_b82bd614f8e3", "type": "list", "answer": [234297800, 246039400, 238021100], "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['t']=mon(d['Tổng tiền'])\nd=d[~d['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nRESULT=[int(d[(d.dt>=a)&(d.dt<=b)].t.sum()) for a,b in [('2025-04-01','2025-04-30'),('2025-05-01','2025-05-31'),('2025-06-01','2025-06-30')]]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_302e0a7d6e89", "type": "list", "answer": [8, 8], "_code": "import sys\nd=DonHang_ChiTiet.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[oc]=d[oc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nsku='SP0053'\nimp=DuLieuXuat__DonNhapHang_ChiTiet; nh=DuLieuXuat__DonNhapHang.copy(); nh['dt']=parse_date(nh['Ngày nhập'])\nimp=imp.merge(nh[['Mã đơn nhập','dt']],on='Mã đơn nhập'); imp=imp[(imp['Mã SKU']==sku)&(imp.dt<='2026-09-20')]\ntin=to_num(imp['Số lượng nhập']).sum()\nlots=set(imp['Mã lô'])\nlo=DuLieuXuat__DonHang_Lo; lo=lo[lo['Mã lô'].isin(lots)]\nst=d.drop_duplicates('Mã đơn hàng').set_index('Mã đơn hàng')['Trạng thái đơn hàng']\nlo=lo.assign(s=lo['Mã đơn hàng'].map(st), dt=lo['Mã đơn hàng'].map(d.drop_duplicates('Mã đơn hàng').set_index('Mã đơn hàng')['dt']))\nlo=lo[(lo.dt<='2026-09-20')]\nprint(tin, lo.groupby('s')[['Số lượng','Số lượng trả']].sum(),file=sys.stderr)\ncancel=lo['s'].str.contains('hủy|huỷ',na=False)\nsold=to_num(lo[~cancel]['Số lượng']).sum()-to_num(lo[~cancel]['Số lượng trả']).sum()\ntot=int(tin-sold)\nprint(tot,file=sys.stderr)\nRESULT=[tot//10,tot%10]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f750d1f1110c", "type": "percent", "answer": -12.94, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\no=don_hang.drop_duplicates('Số phiếu').copy(); o['dt']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().copy(); c['a']=mser(c['Tiền bán'])\nrev=lambda y,m: c[c['Số CT'].isin(o[(o.dt.dt.year==y)&(o.dt.dt.month==m)]['Số phiếu'])].a.sum()\na,b_=rev(2026,5),rev(2025,5)\nRESULT=f\"{(a-b_)/b_*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_12829de2ae90", "type": "percent", "answer": 9.75, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\no=don_hang.drop_duplicates('Số phiếu').copy(); o['dt']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])&(o.dt.dt.year==2025)&(o.dt.dt.month==12)]\nc=chi_tiet_don.drop_duplicates().copy(); c['a']=mser(c['Tiền bán'])\nc=c[c['Số CT'].isin(o['Số phiếu'])].merge(san_pham[['Mã HH','Nhom hang']],left_on='Mã hàng bán',right_on='Mã HH',how='left')\nRESULT=f\"{c[c['Nhom hang']=='gỏi'].a.sum()/c.a.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_56f805cae3a8", "type": "percent", "answer": 13.83, "_code": "d=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nbad=d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|không giao',case=False,na=False)\noid=d[bad]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(oid)&(d.dt>='2025-07-01')&(d.dt<='2025-07-31')]\nd['tt']=to_num(d['Thành tiền'])\ng=Bao_cao_ban_hang['Danh sách hàng hóa'].set_index('Tên hàng hóa')['Nhóm hàng hóa']\nd['g']=d['Tên hàng hóa'].map(g)\nprint(d.g.unique())\nRESULT=f\"{d[d.g.str.strip().str.lower()=='cát đá'].tt.sum()/d.tt.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f87ae1288ec0", "type": "percent", "answer": 1.37, "_code": "d=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt>='2025-08-01')&(d.dt<='2025-08-31')]\nst=d.groupby('Mã đơn hàng')['Trạng thái'].first()\nRESULT=f\"{st.str.contains('hủy|huỷ|cancel',case=False).sum()/len(st)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fefc6fe34685", "type": "percent", "answer": 4.76, "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['t']=mon(d['Tổng tiền'])\nd=d[~d['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nimport re\nn=lambda s: re.sub(r'\\s+',' ',vn_normalize(s))\nd=d[(d.dt>='2025-02-01')&(d.dt<='2025-02-28')]\nrx=DanhSachThuoc[DanhSachThuoc['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1'])]['Mã SKU']\nnames=set(DanhSachSanPham[DanhSachSanPham['Mã SKU'].isin(rx)]['Tên sản phẩm'].apply(n))\nprint(d['Tên sản phẩm'].apply(n).isin(set(DanhSachSanPham['Tên sản phẩm'].apply(n))).mean())\nRESULT=f\"{round(d[d['Tên sản phẩm'].apply(n).isin(names)].t.sum()/d.t.sum()*100,2):.2f}%\"\n", "_attempts": 3, "_verdict": "correct"}
{"id": "q_fb2984e65ce3", "type": "number", "answer": 387513000, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\n\nd=danh_sach_hoa_don.drop_duplicates().drop_duplicates('Mã bill').reset_index(drop=True)\nd['dt']=parse_date(d['Ngày giao dịch'])\nm=d[(d.dt>='2026-01-01')&(d.dt<='2026-03-31')]\nm=m[~m['Status'].str.contains('hủy|huỷ|hoàn trả|trả|cancel',case=False,na=False)]\nRESULT=int(round(money(m['Tien hang']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a98ebd61ce5e", "type": "date", "answer": "2025-12-05", "_code": "d=SoBanHang.copy(); d=d[d['ngay_ban'].notna()]\nd['dt']=parse_date(d['ngay_ban']); d['a']=to_num(d['Tổng tiền'])\nd=d[~d['Trạng thái xử lý'].str.contains('hủy|huỷ|trả|Không giao',case=False)]\nx=d[(d.dt>='2025-12-01')&(d.dt<='2025-12-31')]\nRESULT=x.groupby('dt').a.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
