{"id": "q_b47b19c7ecb4", "type": "number", "answer": 566800200, "_code": "import re\nd=SoBanHang.copy()\nd['dt']=parse_date(d['Ngày tháng'])\ndef money(x):\n    s=str(x).strip().lower().replace('đ','')\n    s=re.sub(r'[.,](?=\\d{3}(\\D|$))','',s)\n    return float(s)\nd['m']=d['Thành tiền (đ)'].map(money)\nd=d[~d['Trạng thái đơn'].str.lower().str.contains('hủy|huỷ|trả')]\nx=d[(d.dt>='2026-05-01')&(d.dt<='2026-05-31')]\nRESULT=int(round(x.m.sum()))\n", "_attempts": 1, "_verdict": "correct"}
