{"id": "q_94ec5f7f1c70", "type": "percent", "answer": 3.19, "_code": "h=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)&(h.dt>='2026-01-01')&(h.dt<='2026-01-31')]\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True)\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].drop_duplicates()\nc['v']=to_num(c['Thành tiền'])\ng=DanhSachSanPham.set_index('Mã hàng')['Nhóm hàng(3 Cấp)']\nRESULT=f\"{c[c['Mã hàng'].map(g)=='bánh'].v.sum()/c.v.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_78d79672169c", "type": "number", "answer": 104965300, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\nh=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy(); h['dt']=parse_date(h['Thời gian'])\nh['hr']=pd.to_datetime(h['Thời gian tạo']).dt.hour\nh=h[(h.dt.dt.year==2025)&(h.dt.dt.month==3)&(h.hr>=6)&(h.hr<=13)&~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)]\nc=DanhSachHoaDonChiTiet[DanhSachHoaDonChiTiet['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\nRESULT=int(round(mser(c['Thành tiền']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_773310350f81", "type": "list", "answer": ["Cà phê sữa (M)", "Trà đào cam sả (M)", "Cà phê đen (M)"], "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\n\ns=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates().reset_index(drop=True)\ns['dt']=pdate(s['Ngày giao dịch'])\ns['q']=pd.to_numeric(s['so_luong'],errors='coerce')\nneg=set(s[s.q<0]['Mã hóa đơn'])\nbad=set(s[s['Status'].str.contains('hủy|huỷ|trả|cancel|Đổi trả',case=False,na=False)]['Mã hóa đơn'])|neg\ns=s[~s['Mã hóa đơn'].isin(bad)]\nf=dict(zip(DanhMuc['Tên món'],DanhMuc['Hệ số']))\ns['qb']=s.q*s.apply(lambda r:f.get(r['Hàng'],1) if r['Unit']!=r['Hàng'] and r['Unit'] in ('hộp','thùng') else 1,axis=1)\nm=s[(s.dt>='2026-04-06')&(s.dt<='2026-04-12')]\nprint(m['Unit'].value_counts())\ng=m.groupby('Hàng').qb.sum().sort_values(ascending=False)\nprint(g.head(6))\nRESULT=list(g.head(3).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5055becf7714", "type": "list", "answer": ["Vương Phương Loan", "Kiều Hà Tâm", "Đào Dương Giang"], "_code": "h=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)&(h.dt>='2026-03-01')&(h.dt<='2026-03-31')&h['Mã KH'].notna()].copy()\nh['v']=to_num(h['Tổng tiền hàng'])\ns=h.groupby('Mã KH')['v'].sum().reset_index().sort_values(['v','Mã KH'],ascending=[False,True]).head(3)\nnm=DanhSachKhachHang.set_index('Mã khách hàng')['Tên khách hàng']\nimport re\nRESULT=[re.sub(r'\\s*-\\s*[\\d ]+$','',nm[c]).strip() for c in s['Mã KH']]\n", "_attempts": 2, "_verdict": "correct"}
