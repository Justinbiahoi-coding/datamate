{"id": "q_c6293f0e92c8", "type": "date", "answer": "2025-05-10", "_code": "def money(x):\n    s=str(x).replace('đ','').replace('.','').replace(',','').strip()\n    return float(s)\ndf=SoBanHang.copy()\ndf['d']=parse_date(df['Ngày tháng'])\ndf=df[(df.d>='2025-05-01')&(df.d<'2025-06-01')&df['Trạng thái đơn'].isin(['Đã giao','đang gửi'])]\ns=df.assign(v=df['Thành tiền (đ)'].map(money)).groupby('d')['v'].sum()\nRESULT=s.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f71cc29e045f", "type": "list", "answer": ["Kiều Khoa Thu", "Kiều Thắng Linh", "Cao Thắng Phong"], "_code": "import re\ndf=DonHang_ChiTiet.copy()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[(df.d>='2026-01-01')&(df.d<'2026-02-01')&df['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\ndf=df.drop_duplicates()\nn=df['Tên khách hàng'].astype(str).str.replace(r'[\\s\\-–]*\\(?\\d{8,}\\)?\\s*$','',regex=True).str.strip()\ndf['k']=n.str.lower().str.replace(r'\\s+',' ',regex=True)\ndf=df[~df.k.isin(['khách lẻ','kl','lẻ','khach le','nan',''])]\ndf['v']=to_num(df['Tổng tiền'])\ns=df.groupby('k')['v'].sum().sort_values(ascending=False)\nprint(s.head(5))\ndisp=df.assign(n=n).groupby('k')['n'].agg(lambda x:x.value_counts().index[0])\nRESULT=[disp[k] for k in s.index[:3]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_512fd71eda30", "type": "number", "answer": 24819000, "_code": "def money(x):\n    s=str(x).strip().lower().replace('đ','')\n    if s in ('','nan'): return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); return float(a.replace(',','').replace('.',''))*1e6+(float((b+'000')[:3]) *1e3 if b else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','').replace('.',''))*1e3\n    return float(s.replace(',','').replace('.',''))\no=don_hang[don_hang['Tình trạng'].isin(['completed','shipping'])]\ndt=pd.to_datetime(o['Ngày'],errors='coerce')\no=o[(dt>='2026-05-01')&(dt<'2026-06-01')]\nsp=san_pham[san_pham['Tên SP'].str.lower().str.contains('nghêu hấp sả')]\nprint(sp[['Mã sản phẩm bán','Tên SP']])\nd=chi_tiet_don.drop_duplicates()\nd=d[d['Mã đơn hàng'].isin(o['Mã chứng từ'])&d['Mã mặt hàng'].isin(sp['Mã sản phẩm bán'])]\nRESULT=int(d['Amount'].map(money).sum())\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_7dded87ba54e", "type": "percent", "answer": 0.44, "_code": "def rev(sh):\n    inv=sh[~sh['Trạng thái'].isin(['Đã hủy','Đã trả hàng'])]\n    return to_num(inv['Tổng tiền hàng']).sum()\na=rev(DanhSachHoaDon__T04_2026); b=rev(DanhSachHoaDon__T03_2026)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
