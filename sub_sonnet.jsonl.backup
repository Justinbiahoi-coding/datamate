{"id": "q_998a15f3e0f0", "type": "number", "answer": 7400.0, "_code": "\nimport re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s=='' : return 0.0\n    m=_re.match(r'^(-?\\d+)(?:[.,](\\d+))?\\s*tr\\s*(\\d+)?$',s)\n    if m:\n        a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0'))*1e3\n        return a\n    m=_re.match(r'^(-?\\d+(?:[.,]\\d+)?)\\s*k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.match(r'^-?\\d{1,3}([.,]\\d{3})+$',s): return float(_re.sub(r'[.,]','',s))\n    if _re.match(r'^-?\\d+[.,]\\d{4}$',s): return float(s.replace(',','.'))\n    s2=s.replace(',','.')\n    try: return float(s2)\n    except: return float('nan')\n\nd=DonHang_ChiTiet.copy()\nd[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']]=d[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']].ffill()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nx=d[(d['Tên sản phẩm']=='Clarityne 10mg hộp 1 vỉ x 10 viên')&(d.dt=='2026-06-14')].copy()\nqd=DuLieuXuat['DanhSachQuyDoi']\nf=dict(zip(zip(qd['Tên sản phẩm'],qd['Đơn vị quy đổi']),qd['Tỉ lệ quy đổi']))\nx['f']=[f.get((n,u),1) for n,u in zip(x['Tên sản phẩm'],x['Đơn vị tính'])]\nx['p']=x['Giá sản phẩm'].map(money)/pd.to_numeric(x['f'])\nRESULT=float(x.p.iloc[0])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_827672805082", "type": "number", "answer": 11370500, "_code": "def money(x):\n    import re, math\n    if x is None or (isinstance(x,float) and math.isnan(x)): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in ('','nan'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr',1)\n        v=float(a.replace(',','.'))*1e6 if a else 0.0\n        if b: v+=float(b)*10**(6-len(b)) if len(b)<=3 else float(b)\n        r=v\n    elif s.endswith('k'):\n        r=float(s[:-1].replace(',','.'))*1000\n    else:\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): r=float(s.replace(',',''))\n        elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): r=float(s.replace('.',''))\n        elif re.fullmatch(r'\\d+(\\.\\d+)?',s): r=float(s)\n        else: r=float(re.sub(r'[^\\d.]','',s))\n    return -r if neg else r\n\na=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True)\na=a[a['Mã hóa đơn'].notna()].drop_duplicates()\na['d']=parse_date(a['Ngày giao dịch'])\na['v']=a['Trị giá'].map(money)\na['q']=pd.to_numeric(a['so_luong'],errors='coerce')\nbad=a['Status'].astype(str).str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)\nbo=set(a.loc[bad|(a.q<0),'Mã hóa đơn'])\na=a[~a['Mã hóa đơn'].isin(bo)]\n\nRESULT=int(round(a.loc[a.d==pd.Timestamp(as_of_date),'v'].sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_48d55e816a7d", "type": "percent", "answer": -4.49, "_code": "def money(x):\n    import re, math\n    if x is None or (isinstance(x,float) and math.isnan(x)): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in ('','nan'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr',1)\n        v=float(a.replace(',','.'))*1e6 if a else 0.0\n        if b: v+=float(b)*10**(6-len(b)) if len(b)<=3 else float(b)\n        r=v\n    elif s.endswith('k'):\n        r=float(s[:-1].replace(',','.'))*1000\n    else:\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): r=float(s.replace(',',''))\n        elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): r=float(s.replace('.',''))\n        elif re.fullmatch(r'\\d+(\\.\\d+)?',s): r=float(s)\n        else: r=float(re.sub(r'[^\\d.]','',s))\n    return -r if neg else r\n\na=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True)\na=a[a['Mã hóa đơn'].notna()].drop_duplicates()\na['d']=parse_date(a['Ngày giao dịch'])\na['v']=a['Trị giá'].map(money)\na['q']=pd.to_numeric(a['so_luong'],errors='coerce')\nbad=a['Status'].astype(str).str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)\nbo=set(a.loc[bad|(a.q<0),'Mã hóa đơn'])\na=a[~a['Mã hóa đơn'].isin(bo)]\n\nt=pd.Timestamp(as_of_date); s=t.replace(day=1); ps=s-pd.DateOffset(months=1)\npe=min(ps+pd.Timedelta(days=t.day-1), s-pd.Timedelta(days=1))\ncur=a.loc[(a.d>=s)&(a.d<=t),'v'].sum(); prev=a.loc[(a.d>=ps)&(a.d<=pe),'v'].sum()\nRESULT=f\"{round((cur/prev-1)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d401c0884402", "type": "percent", "answer": -18.92, "_code": "a=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\na=a[a['Mã đơn hàng'].notna()].drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y',errors='coerce')\na['v']=a['Thành tiền'].astype(str).str.replace(',','').astype(float)\nbad=a[a['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả',case=False)]['Mã đơn hàng'].unique()\na=a[~a['Mã đơn hàng'].isin(bad)]\ne=pd.Timestamp(as_of_date); s=e.replace(day=1)\nps=(s-pd.Timedelta(days=1)).replace(day=1); pe=ps+pd.Timedelta(days=e.day-1)\ncur=a[(a.dt>=s)&(a.dt<=e)].v.sum(); prev=a[(a.dt>=ps)&(a.dt<=pe)].v.sum()\nRESULT='%.2f%%'%((cur/prev-1)*100)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9616f4d55ee6", "type": "number", "answer": 452292400, "_code": "import re, numpy as np, unicodedata\ndef money(x):\n    if x is None or (isinstance(x,float) and np.isnan(x)): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan'): return np.nan\n    if 'tr' in s:\n        a,b=s.split('tr',1); a=a.strip().replace(',','.')\n        v=float(a)*1e6 if a else 0\n        b=b.strip()\n        if b: v+=int(b.ljust(3,'0')[:3])*1000\n        return v\n    if s.endswith('k'):\n        return float(s[:-1].replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.fullmatch(r'-?\\d+,\\d+',s) else float(s)\ndef nt(s):\n    return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower()\nimport pandas as pd\na=DonHang_ChiTiet__all.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[oc]=a[oc].ffill()\na=a.drop_duplicates()\na['d']=parse_date(a['Ngày đặt hàng'])\na['v']=a['Tổng tiền'].map(money)\na=a[~a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nRESULT=round(a[(a.d>='2026-01-01')&(a.d<='2026-02-27')].v.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_596000d1710e", "type": "number", "answer": 5671, "_code": "d=don_hang.drop_duplicates().copy(); d['dt']=parse_date(d['NgayLap'])\nd=d[~d.TinhTrang.isin(['cancelled','returned'])]\nRESULT=int(d[(d.dt>='2025-07-01')&(d.dt<='2025-09-30')].MaHoaDon.nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2e9fdb1dcd17", "type": "percent", "answer": 9.85, "_code": "h=BanHang_HoaDon.drop_duplicates().copy(); h['dt']=parse_date(h['Ngày bán'])\nh=h[~h['Trạng thái'].isin(['Không giao được','Đổi trả'])]\nh=h[(h.dt>='2025-11-01')&(h.dt<='2025-11-30')]\nc=BanHang_ChiTietHoaDon.drop_duplicates().copy(); c['tt']=to_num(c['Thanh tien'])\nc=c[c['Mã giao dịch'].isin(h['Order ID'])].merge(BanHang_HangHoa[['ma_sp','Phân loại']].drop_duplicates('ma_sp'),left_on='Ma hang',right_on='ma_sp',how='left')\nRESULT=f\"{round(c[c['Phân loại']=='tiêu hoá'].tt.sum()/c.tt.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a8aeb33b648d", "type": "percent", "answer": 10.82, "_code": "\nimport re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s=='' : return 0.0\n    m=_re.match(r'^(-?\\d+)(?:[.,](\\d+))?\\s*tr\\s*(\\d+)?$',s)\n    if m:\n        a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0'))*1e3\n        return a\n    m=_re.match(r'^(-?\\d+(?:[.,]\\d+)?)\\s*k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.match(r'^-?\\d{1,3}([.,]\\d{3})+$',s): return float(_re.sub(r'[.,]','',s))\n    if _re.match(r'^-?\\d+[.,]\\d{4}$',s): return float(s.replace(',','.'))\n    s2=s.replace(',','.')\n    try: return float(s2)\n    except: return float('nan')\n\nd=don_hang.copy(); d['dt']=parse_date(d['NgayBan'])\nd=d[d['Xử lý'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().copy(); c['v']=c['T.Tiền'].map(money)\nrev=c.groupby('Ma don')['v'].sum()\nd['rev']=d['Mã chứng từ'].map(rev).fillna(0)\ndef r(y): \n    x=d[(d.dt>=f'{y}-03-01')&(d.dt<=f'{y}-03-31')]; return x.rev.sum()\na,b=r(2026),r(2025)\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d00cf44a3dbd", "type": "percent", "answer": -16.75, "_code": "import re\ndef money(v):\n    s=str(v).strip().lower().replace('đ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1000000+int((m.group(3)+'000')[:3] if m.group(3) else 0)*1000)\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',','')) if re.fullmatch(r'-?[\\d,]*\\.?\\d+',s) else float('nan')\nd=SoBanHang__all.drop_duplicates().copy()\nd['dt']=pd.to_datetime(d['Giờ'],errors='coerce')\nd['v']=d['Tiền'].map(money)\nbad=d[d['Ghi chú TT'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False)]['Mã phiếu'].unique()\ng=d[~d['Mã phiếu'].isin(bad)]\na=g[(g.dt>='2026-02-01')&(g.dt<'2026-02-22')].v.sum(); b=g[(g.dt>='2026-01-01')&(g.dt<'2026-01-22')].v.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_62f1f06a4801", "type": "percent", "answer": -4.95, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in('nan','','none'): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+[,.]\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): v=float(s.replace(',',''))\n    else: v=float(s.replace(',','.'))\n    return -v if neg else v\nd=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\nhc=['Ngày','Mã đơn hàng','Trạng thái']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates().copy()\nd['d']=parse_date(d['Ngày'])\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn hàng',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nd=d[d['Tên hàng hóa'].map(vn_normalize)==vn_normalize('Cá lóc nướng trui')].copy()\nd['q']=to_num(d['Số lượng quy đổi'])\nD=pd.Timestamp('2025-08-05')\na=d[(d.d>=D)&(d.d<D+pd.Timedelta(days=14))].q.sum(); b=d[(d.d>=D-pd.Timedelta(days=14))&(d.d<D)].q.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_80410ed452fc", "type": "number", "answer": 988489400, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in('nan','','none'): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+[,.]\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): v=float(s.replace(',',''))\n    else: v=float(s.replace(',','.'))\n    return -v if neg else v\nd=SoBanHang.copy()\nd['d']=parse_date(d['Ngày mua'])\nd=d[~d['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd=d[(d.d>='2025-10-01')&(d.d<='2025-10-31')]\nRESULT=int(round(d['thanh_tien'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_29eb2ce0741a", "type": "percent", "answer": -24.9, "_code": "\nh=DanhSachHoaDon.drop_duplicates().drop_duplicates('Mã hóa đơn').copy()\nh['t']=pd.to_datetime(h['Thời gian tạo'])\nh['d']=h['t'].dt.normalize()\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn trả',case=False,na=False)]\nd=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates()\nd['v']=to_num(d['Thành tiền'])\nd=d[d['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\nh['rev']=h['Mã hóa đơn'].map(d.groupby('Mã hóa đơn')['v'].sum()).fillna(0)\n\nt=pd.Timestamp(as_of_date); ms=t-pd.Timedelta(days=t.weekday()+7); me=ms+pd.Timedelta(days=6)\nw=h[(h.d>=ms)&(h.d<=me)]\nsa=w.loc[(w.t.dt.hour>=6)&(w.t.dt.hour<14),'rev'].sum(); ch=w.loc[(w.t.dt.hour>=14)&(w.t.dt.hour<22),'rev'].sum()\nRESULT=f\"{round((ch-sa)/sa*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_54ee9f17dc31", "type": "percent", "answer": 3.69, "_code": "\nh=DanhSachHoaDon.drop_duplicates().drop_duplicates('Mã hóa đơn').copy()\nh['t']=pd.to_datetime(h['Thời gian tạo'])\nh['d']=h['t'].dt.normalize()\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn trả',case=False,na=False)]\nd=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates()\nd['v']=to_num(d['Thành tiền'])\nd=d[d['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\nh['rev']=h['Mã hóa đơn'].map(d.groupby('Mã hóa đơn')['v'].sum()).fillna(0)\n\nt=pd.Timestamp(as_of_date); s=t.replace(day=1); ps=s-pd.DateOffset(months=1)\npe=min(ps+pd.Timedelta(days=t.day-1), s-pd.Timedelta(days=1))\ncur=h.loc[(h.d>=s)&(h.d<=t),'rev'].sum(); prev=h.loc[(h.d>=ps)&(h.d<=pe),'rev'].sum()\nRESULT=f\"{round((cur/prev-1)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_516ed0dbe40c", "type": "number", "answer": 70569, "_code": "\nh=DanhSachHoaDon.drop_duplicates().drop_duplicates('Mã hóa đơn').copy()\nh['t']=pd.to_datetime(h['Thời gian tạo'])\nh['d']=h['t'].dt.normalize()\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn trả',case=False,na=False)]\nd=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates()\nd['v']=to_num(d['Thành tiền'])\nd=d[d['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\nh['rev']=h['Mã hóa đơn'].map(d.groupby('Mã hóa đơn')['v'].sum()).fillna(0)\n\nw=h[(h.d.dt.year==2025)&(h.d.dt.month==9)]\nfrom decimal import Decimal, ROUND_HALF_UP\nRESULT=int(Decimal(str(w.rev.sum()))/Decimal(len(w))//1 + (1 if (Decimal(str(w.rev.sum()))/Decimal(len(w)))%1>=Decimal('0.5') else 0))\n", "_attempts": 1, "_verdict": "correct"}
