{"id": "q_74aff62b9ef4", "type": "number", "answer": 82768500, "_code": "d=don_hang.drop_duplicates().copy()\nd['t']=pd.to_datetime(d['ThoiGianLap'])\nd=d[(d.t>='2026-05-01')&(d.t<'2026-06-01')&d.TinhTrang.isin(['completed','shipping'])]\nd=d[(d.t.dt.hour>=6)&(d.t.dt.hour<14)]\nc=chi_tiet_don.drop_duplicates()\nRESULT=int(round(to_num(c[c.MaHoaDon.isin(d.MaHoaDon)].TriGia).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_229f2e23c3c6", "type": "number", "answer": 10, "_code": "d=don_hang.copy(); d['t']=pd.to_datetime(d['ThoiGianLap'])\nd=d[(d.t>='2026-01-01')&(d.t<'2026-02-01')&d.TinhTrang.isin(['completed','shipping'])]\nc=chi_tiet_don[(chi_tiet_don.MaHangHoa=='SP0009')&chi_tiet_don.MaHoaDon.isin(d.MaHoaDon)]\nban=to_num(c.SLQuyDoi).sum()\np=phieu_nhap.copy(); p['t']=pd.to_datetime(p['NgayNhapKho'],errors='coerce')\np=p[(p.t>='2026-01-01')&(p.t<'2026-02-01')&(p.TinhTrang!='cancelled')]\nn=chi_tiet_nhap[(chi_tiet_nhap.MaHangHoa=='SP0009')&chi_tiet_nhap.MaPhieuNhap.isin(p.MaPhieuNhap)].copy()\nhs=to_num(don_vi_sp[don_vi_sp.MaHangHoa=='SP0009'].set_index('DonViTinh').HeSoQuyDoi)\nn['f']=n.DonViTinh.map(hs).fillna(1)\nnhap=(to_num(n.SL)*n.f).sum()\nRESULT=int(nhap-ban)\n", "_attempts": 1, "_verdict": "correct"}
