{"id": "q_9eb743549bbc", "type": "number", "answer": 1127784900, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    m=re.match(r'^(\\d+)tr(\\d{3})?$',s)\n    if m: return int(m.group(1))*1000000+int(m.group(2) or 0)*1000\n    return float(re.sub(r'[^\\d\\-]','',s) or 0)\nd=SoBanHang__all.drop_duplicates().copy()\nd['dt']=pd.to_datetime(d['Giờ'],errors='coerce')\nd['od']=d.groupby('Mã phiếu').dt.transform('min').dt.normalize()\nbad=d[d['Ghi chú TT'].astype(str).str.contains('hủy|huỷ|trả',case=False)]['Mã phiếu'].unique()\nd=d[~d['Mã phiếu'].isin(bad)]\ne=pd.Timestamp(as_of_date); s=e-pd.Timedelta(days=29)\nd=d[(d.od>=s)&(d.od<=e)]\nRESULT=int(d['Tiền'].map(money).sum())\n", "_attempts": 1, "_verdict": "correct"}
