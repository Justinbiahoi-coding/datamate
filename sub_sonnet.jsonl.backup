{"id": "q_ab5e0a06f4c1", "type": "date", "answer": "2025-04", "_code": "a=pd.concat([v for k,v in data.items() if k.startswith(\"So_chi_tiet_ban_hang\") and \"__\" not in k and isinstance(v,pd.DataFrame)],ignore_index=True)\nbad=a[\"Trạng thái\"].str.contains(\"hủy|huỷ|cancel|trả\",case=False,na=False)\na=a[~a[\"Mã đơn hàng\"].isin(set(a.loc[bad,\"Mã đơn hàng\"]))].copy()\na[\"d\"]=parse_date(a[\"Ngày\"]); a[\"amt\"]=to_num(a[\"Thành tiền\"])\nm=a.groupby(a[\"d\"].dt.to_period(\"M\"))[\"amt\"].sum()\nm=m[[pd.Period(p) for p in (\"2025-02\",\"2025-03\",\"2025-04\")]]\nRESULT=str(m.idxmax())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6b90b5fe0a20", "type": "list", "answer": [9788500, 156637000], "_code": "d=don_hang[~don_hang[\"Xử lý\"].isin([\"cancelled\",\"returned\"])].copy()\nd[\"d\"]=parse_date(d[\"NgayBan\"])\nd=d[(d[\"d\"]>=\"2026-02-01\")&(d[\"d\"]<=\"2026-02-28\")]\nr=chi_tiet_don.assign(a=to_num(chi_tiet_don[\"T.Tiền\"])).groupby(\"Ma don\")[\"a\"].sum()\nd[\"rev\"]=d[\"Mã chứng từ\"].map(r).fillna(0)\ns=d.groupby(\"Bán qua\")[\"rev\"].sum()\nRESULT=[int(s[\"zalo_oa\"]),int(s[\"store\"])]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_25e68617a9f7", "type": "number", "answer": 1088, "_code": "h=DanhSachHoaDon[~DanhSachHoaDon[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả\",case=False,na=False)].copy()\nh[\"d\"]=pd.to_datetime(h[\"Thời gian tạo\"]).dt.normalize()\nok=set(h[(h[\"d\"]>=\"2026-09-01\")&(h[\"d\"]<=\"2026-09-14\")][\"Mã hóa đơn\"])\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates()\nc=c[c[\"Mã hóa đơn\"].isin(ok)]\np=DanhSachSanPham\nly=set(p[(p[\"ĐVT\"]==\"ly\")&p[\"Tên hàng\"].str.contains(r\"\\(L\\)\\s*$\",na=False)][\"Mã hàng\"])\nRESULT=int(to_num(c[c[\"Mã hàng\"].isin(ly)][\"Số lượng quy đổi\"]).sum())\n", "_attempts": 2, "_verdict": "correct"}
