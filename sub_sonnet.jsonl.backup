{"id": "q_f5a2e8472196", "type": "number", "answer": 256542200, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1000 if m.group(2) else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    return float(re.sub(r'[^\\d]','',s))\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['tt']=d['Tổng tiền'].map(money)\nd=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nRESULT=int(round(d[(d.dt>='2026-01-01')&(d.dt<='2026-01-31')].tt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
