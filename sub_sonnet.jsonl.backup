{"id": "q_8659862171ab", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Thân Thu Phương", 949334], ["Ngô Anh Phong", 415000], ["Nghiêm Hà Phương", 391000], ["Hứa An Giang", 356250], ["Châu Quân Tâm", 241000]]}, "_code": "d=don_hang.copy()\nd['dt']=parse_date(d['Ngày bán'])\nd=d[(d['Tình trạng đơn']!='cancelled')&(d['Hình thức thanh toán']!='cod')&(d['dt']<=pd.Timestamp(as_of_date))]\nd=d.drop_duplicates('Số phiếu')\nt=thanh_toan.copy(); t['dt']=parse_date(t['Thời điểm']); t['Tiền']=to_num(t['Tiền'])\nt=t[t['dt']<pd.Timestamp(as_of_date)+pd.Timedelta(days=1)]\npaid=t.groupby('Mã giao dịch')['Tiền'].sum()\nd['owe']=to_num(d['Phải thu'])-d['Số phiếu'].map(paid).fillna(0)\nd=d[(d['owe']>0)&d['Mã khách mua'].notna()]\ng=d.groupby('Mã khách mua')['owe'].sum().sort_values(ascending=False).head(5)\nnm=khach_hang.set_index('Mã khách lẻ/sỉ')['KH']\nRESULT={\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[nm[k],int(round(v))] for k,v in g.items()]}\n", "_attempts": 1, "_verdict": "correct"}
