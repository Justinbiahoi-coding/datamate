{"id": "q_d9f6efd2a92c", "type": "boolean", "answer": true, "_code": "o = DonHang_ChiTiet.copy()\nh = ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\no[h] = o[h].ffill()\no['d'] = pd.to_datetime(o['Ngày đặt hàng'], format='%d/%m/%Y')\no['amt'] = to_num(o['Tổng tiền'])\no['q'] = to_num(o['Số lượng sản phẩm'])\nbad = set(o[o['Trạng thái đơn hàng'].isin(['Đã hủy','Đã hoàn hàng'])]['Mã đơn hàng'])\ng = o[~o['Mã đơn hàng'].isin(bad)]\nm = g.groupby(g.d.dt.to_period('M')).amt.sum()\na,b,c = [m[pd.Period(x)] for x in ['2026-06','2026-07','2026-08']]\nRESULT = bool(a<b<c)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a65c9b7217bc", "type": "number", "answer": 1415000.0, "_code": "def pm(s):\n    s = str(s).strip()\n    if 'tr' in s:\n        a, b = s.split('tr'); return int(a) * 1e6 + (int(b.ljust(3, '0')) * 1e3 if b else 0)\n    return float(s.replace('đ', '').replace('.', '').replace(',', ''))\no = don_hang.copy(); o['d'] = parse_date(o['Ngày'])\no = o[o['d'].between('2026-03-01','2026-03-31') & ~o['Tình trạng'].isin(['cancelled','returned'])]\nl = chi_tiet_don.drop_duplicates(['Mã đơn hàng','No.']).merge(san_pham[['Mã sản phẩm bán','Tên SP']], left_on='Mã mặt hàng', right_on='Mã sản phẩm bán')\nl = l[l['Mã đơn hàng'].isin(o['Mã chứng từ']) & l['Tên SP'].str.lower().str.contains('trà đá')]\nRESULT = float(l['Amount'].map(pm).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_046b262bd6a7", "type": "percent", "answer": 10.35, "_code": "def pm(s):\n    s = str(s).strip()\n    if 'tr' in s:\n        a, b = s.split('tr'); return int(a) * 1e6 + (int(b.ljust(3, '0')) * 1e3 if b else 0)\n    return float(s.replace('đ', '').replace('.', '').replace(',', ''))\no = don_hang.copy(); o['d'] = parse_date(o['Ngày'])\no = o[~o['Tình trạng'].isin(['cancelled','returned'])]\nl = chi_tiet_don.drop_duplicates(['Mã đơn hàng','No.']).copy(); l['a'] = l['Amount'].map(pm)\nrev = l.groupby('Mã đơn hàng')['a'].sum()\no['rev'] = o['Mã chứng từ'].map(rev).fillna(0)\ncur = o[o['d'].between('2026-05-01','2026-05-31')]['rev'].sum()\nprev = o[o['d'].between('2025-05-01','2025-05-31')]['rev'].sum()\nRESULT = f\"{round((cur-prev)/prev*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3b6fe798cd47", "type": "percent", "answer": 50.0, "_code": "o = DonHang_ChiTiet.copy()\nh = ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\no[h] = o[h].ffill()\no['d'] = pd.to_datetime(o['Ngày đặt hàng'], format='%d/%m/%Y')\no['amt'] = to_num(o['Tổng tiền'])\no['q'] = to_num(o['Số lượng sản phẩm'])\nbad = set(o[o['Trạng thái đơn hàng'].isin(['Đã hủy','Đã hoàn hàng'])]['Mã đơn hàng'])\ng = o[~o['Mã đơn hàng'].isin(bad)]\np = g[g['Tên sản phẩm']=='Clarityne 10mg hộp 1 vỉ x 10 viên'].copy()\np['base'] = p.q * p['Đơn vị tính'].map({'hộp':10,'viên':1})\nD = pd.Timestamp('2026-06-17')\nafter = p[(p.d>=D)&(p.d<D+pd.Timedelta(days=7))].base.sum()\nbefore = p[(p.d>=D-pd.Timedelta(days=7))&(p.d<D)].base.sum()\nRESULT = f\"{round((after-before)/before*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
