{"id": "q_8063763ff391", "type": "number", "answer": 1004447500.0, "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    return float(s.replace('.','').replace(',',''))\no=don_hang.copy()\no['d']=parse_date(o['Ngày'])\no=o[~o['Tình trạng'].isin(['cancelled','returned'])]\nc=chi_tiet_don.drop_duplicates().copy()\nc['t']=c['Amount'].apply(money)\nx=c.merge(o[['Mã chứng từ','d']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\ndef rev(a,b): return x[(x.d>=a)&(x.d<=b)].t.sum()\n\nRESULT=float(rev('2025-06-01','2025-06-30'))\n", "_attempts": 1, "_verdict": "correct"}
