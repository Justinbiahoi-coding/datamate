{"id": "q_a0b2d8694b3d", "type": "percent", "answer": 20.42, "_code": "h=DanhSachHoaDon.copy(); h['d']=parse_date(h['Thời gian']); h['v']=to_num(h['Tổng tiền hàng'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\n\nm=h[(h.d>='2025-02-01')&(h.d<='2025-02-28')]\nRESULT=f\"{m[m['Phương thức thanh toán']=='Ví điện tử'].v.sum()/m.v.sum()*100:.2f}%\"", "_attempts": 1, "_verdict": "correct"}
{"id": "q_81d6b5a181f4", "type": "date", "answer": "2026-03", "_code": "h=DanhSachHoaDon.copy(); h['d']=parse_date(h['Thời gian']); h['v']=to_num(h['Tổng tiền hàng'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\n\nr=[(h[(h.d>=s)&(h.d<=e)].v.sum(),s[:7]) for s,e in [('2026-01-01','2026-01-31'),('2026-02-01','2026-02-28'),('2026-03-01','2026-03-31')]]\nRESULT=max(r)[1]", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2b3dc5e6e597", "type": "number", "answer": 286621500, "_code": "n = DanhSachNhapHang.copy()\nn['d'] = pd.to_datetime(n['Thời gian'], format='%d/%m/%Y', errors='coerce')\nn['a'] = to_num(n['Cần trả NCC'])\nm = n[(n.d>='2025-09-01')&(n.d<='2025-09-30')&(n['Trạng thái']!='Đã hủy')]\nRESULT = int(m.a.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8ae4326131f8", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Nghiêm Châu Anh", 152134], ["Lê An Đức", 129600], ["Hồ Long Hoa", 101600]]}, "_code": "o=BanHang_HoaDon.copy(); o['d']=parse_date(o['Ngày bán'])\no=o[(o.d<=as_of_date)&(o['Trạng thái']!='Không giao được')&(o['Phương thức TT']!='Thu hộ (COD)')&o['Mã KH mua'].notna()]\nt=BanHang_PhieuThu.copy(); t['dt']=pd.to_datetime(t['Thời gian thu']).dt.normalize()\npaid=t[t.dt<=as_of_date].groupby('Mã bill')['Số tiền thu'].apply(lambda s:to_num(s).sum())\no['debt']=to_num(o['Tong tien'])-o['Order ID'].map(paid).fillna(0)\no=o[o.debt>0]\ns=o.groupby('Mã KH mua').debt.sum().nlargest(3)\nnm=BanHang_KhachHang.set_index('Customer ID')['ten_kh']\nRESULT={\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[nm[k],int(v)] for k,v in s.items()]}", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2b300a0c0e75", "type": "list", "answer": ["Bia Tiger lon", "Bia Sài Gòn Special lon", "Rau muống xào tỏi", "Bia Tiger Bạc lon", "Cánh gà chiên nước mắm"], "_code": "h = DanhSachHoaDon__all.copy(); h['d'] = parse_date(h['Thời gian'])\nh = h[h['d'].between('2026-02-01','2026-02-28') & ~h['Trạng thái'].str.contains('hủy|huỷ|trả', case=False, na=False)]\nc = DanhSachHoaDonChiTiet.drop_duplicates(['Mã hóa đơn','STT'])\nc = c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['q'] = to_num(c['Số lượng quy đổi'])\nnames = DanhSachSanPham.set_index('Mã hàng')['Tên hàng']\ng = c.groupby('Mã hàng')['q'].sum().sort_values(ascending=False)\nRESULT = [names[k] for k in g.index if names[k] != 'Phí phục vụ'][:5]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4e360649b9fc", "type": "string", "answer": "Cty Ông Hải", "_code": "n = SoTay_NhapHang.copy()\ndef money(s):\n    s = str(s).strip().lower().replace('đ','').replace(' ','')\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if s.endswith('tr'): return float(s[:-2].replace(',','.'))*1e6\n    return float(s.replace('.','').replace(',',''))\nn['d'] = parse_date(n['Ngày nhập'])\nn['t'] = n['Thành tiền'].map(money)\nx = n[(n['d']>='2025-04-01')&(n['d']<='2025-04-30')]\ng = x.groupby('Nhà cung cấp')['t'].sum().sort_values(ascending=False)\nRESULT = g.index[0]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_a264d94a0492", "type": "string", "answer": "Snack Oishi tôm cay 40g", "_code": "df = ban_hang.copy(); df['d'] = parse_date(df['Ngày tháng'])\nbad = set(df.loc[df['Kết quả'].str.contains('hủy|huỷ|trả', case=False, na=False), 'Mã hóa đơn'])\nm = df['d'].between('2025-09-01','2025-09-30') & ~df['Mã hóa đơn'].isin(bad)\nx = df[m].copy(); x['q'] = to_num(x['Quy ra ĐV lẻ']); x['n'] = x['Nội dung'].str.strip().str.lower()\ng = x.groupby('n')['q'].sum().sort_values(ascending=False)\ntop = g.index[0]\nRESULT = x[x['n']==top]['Nội dung'].str.strip().value_counts().index[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0eef1e74b13e", "type": "date", "answer": "2028-08-06", "_code": "hh = BanHang_HangHoa\ncode = hh.loc[hh['Món'].str.lower().str.contains('ích nhi plus'),'ma_sp'].iloc[0]\nlo = BanHang_LoHang[BanHang_LoHang['Mã món']==code].copy()\nlo['hsd'] = parse_date(lo['HSD'])\nh = BanHang_HoaDon.drop_duplicates('Order ID')\nh = h[h['Trạng thái']!='Không giao được']  # cancelled orders don't consume stock\nbt = BanTheoLo.merge(h[['Order ID']], left_on='Mã hóa đơn', right_on='Order ID') if False else BanHang_BanTheoLo.merge(h[['Order ID']], left_on='Mã hóa đơn', right_on='Order ID')\nbt['net'] = to_num(bt['SL quy ra lẻ']) - to_num(bt['SL trả (ĐVT cơ bản)'])\nsold = bt.groupby('Lô')['net'].sum()\nlo['stock'] = to_num(lo['SL nhập (ĐVT cơ bản)']) - lo['Lô'].map(sold).fillna(0)\nx = lo[(lo['stock']>0)&(lo['hsd']>=pd.Timestamp(as_of_date))].sort_values('hsd')\nRESULT = x['hsd'].iloc[0].strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c26a816e7c91", "type": "boolean", "answer": false, "_code": "import re\na=SoBanHang_1__all.copy()\nif 'SoBanHang_2026__all' in data: a=pd.concat([a,SoBanHang_2026__all],ignore_index=True)\ndef money(x):\n    s=str(x).strip().lower(); neg=s.startswith('-'); s=s.lstrip('-')\n    m=1000 if s.endswith('k') else 1\n    s=re.sub(r'[^\\d]','',s)\n    v=float(s)*m if s else 0.0\n    return -v if neg else v\nbad=a['Status'].str.contains('hủy|huỷ|trả',case=False,na=False)\nbadids=set(a.loc[bad,'Mã hóa đơn'])\na=a[~a['Mã hóa đơn'].isin(badids)].copy()\na['d']=parse_date(a['Ngày giao dịch']); a['v']=a['Trị giá'].map(money)\nmv=[a[(a.d>=s)&(a.d<=e)].v.sum() for s,e in [('2025-07-01','2025-07-31'),('2025-08-01','2025-08-31'),('2025-09-01','2025-09-30')]]\nRESULT=bool(mv[0]<mv[1]<mv[2])", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e9559c100321", "type": "date", "answer": "2025-02-03", "_code": "a=So_chi_tiet_ban_hang__all.copy()\na=a[~a['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)].copy()\na['d']=parse_date(a['Ngày']); a['v']=to_num(a['Thành tiền'])\nm=a[(a.d>='2025-02-01')&(a.d<='2025-02-28')]\nRESULT=str(m.groupby('d').v.sum().idxmax().date())", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b4a4c7135e0a", "type": "boolean", "answer": true, "_code": "a=DonHang_ChiTiet__all.copy()\nc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[c]=a[c].ffill()\na=a[~a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả',case=False,na=False)].copy()\na['d']=parse_date(a['Ngày đặt hàng']); a['v']=to_num(a['Tổng tiền'])\n\nmv=[a[(a.d>=s)&(a.d<=e)].v.sum() for s,e in [('2025-11-01','2025-11-30'),('2025-12-01','2025-12-31'),('2026-01-01','2026-01-31')]]\nRESULT=bool(mv[0]<mv[1]<mv[2])", "_attempts": 1, "_verdict": "correct"}
