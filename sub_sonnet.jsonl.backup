{"id": "q_e2ea7a9d48c2", "type": "boolean", "answer": true, "_code": "h = BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh = h[~h['Trạng thái'].isin(['Không giao được','Đổi trả'])]\nh['d'] = parse_date(h['Ngày bán'])\nl = BanHang_ChiTietHoaDon.copy()\nl['t'] = to_num(l['Thanh tien'])\nm = l.merge(h[['Order ID','d']], left_on='Mã giao dịch', right_on='Order ID')\nm['ym'] = m['d'].dt.to_period('M').astype(str)\nr = m.groupby('ym')['t'].sum()\nv = [r['2025-09'], r['2025-10'], r['2025-11']]\nRESULT = bool(v[0] < v[1] < v[2])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b97a6a037819", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Thân Thu Phương", 949334], ["Ngô Anh Phong", 415000], ["Nghiêm Hà Phương", 391000]]}, "_code": "o=don_hang.copy(); o['d']=parse_date(o['Ngày bán'])\no=o[(o.d<=as_of_date)&(o['Tình trạng đơn']!='cancelled')&(o['Hình thức thanh toán']!='cod')&o['Mã khách mua'].notna()]\nt=thanh_toan.copy(); t['dt']=pd.to_datetime(t['Thời điểm']).dt.normalize()\npaid=t[t.dt<=as_of_date].groupby('Mã giao dịch').Tiền.sum()\no['debt']=to_num(o['Phải thu'])-o['Số phiếu'].map(paid).fillna(0)\no=o[o.debt>0]\ns=o.groupby('Mã khách mua').debt.sum().nlargest(3)\nnm=khach_hang.set_index('Mã khách lẻ/sỉ')['KH']\nRESULT={\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[nm[k],int(v)] for k,v in s.items()]}", "_attempts": 1, "_verdict": "correct"}
