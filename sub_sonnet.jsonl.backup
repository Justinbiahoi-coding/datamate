{"id": "q_8d681ea2db80", "type": "percent", "answer": 6.35, "_code": "import re\ndef money(x):\n    x=str(x).strip().lower()\n    m=re.match(r'^(-?\\d+)\\s*tr(\\d*)$',x)\n    if m: return int(m.group(1))*1000000+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    s=re.sub(r'[^\\d\\-]','',x)\n    return float(s) if s not in ('','-') else 0.0\no=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\no['t']=pd.to_datetime(o['Thời gian tạo'])\no=o[~o['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates(['Mã hóa đơn','STT']).copy()\nc['v']=c['Thành tiền'].map(money)\nrv=c.groupby('Mã hóa đơn').v.sum()\no['rev']=o['Mã hóa đơn'].map(rv).fillna(0)\ndef mrev(y,m): return o.loc[(o.t.dt.year==y)&(o.t.dt.month==m),'rev'].sum()\na,b=mrev(2026,4),mrev(2025,4)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_db64c1b7436d", "type": "string", "answer": "Cà phê sữa (M)", "_code": "d=DonHang_ChiTiet.copy()\nd['d']=parse_date(d['Ngày đặt hàng'])\nbad=d.loc[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False),'Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)&(d.d>='2025-04-01')&(d.d<='2025-04-30')]\nq=pd.to_numeric(d['Số lượng sản phẩm'].astype(str).str.replace(',','.'),errors='coerce')\nf=DanhSachQuyDoi.set_index('Tên sản phẩm')['Tỉ lệ quy đổi'].astype(float)\nbig=DanhSachQuyDoi.set_index('Tên sản phẩm')['Đơn vị quy đổi']\nmult=d.apply(lambda r: f.get(r['Tên sản phẩm'],1) if r['Đơn vị tính']==big.get(r['Tên sản phẩm']) else 1,axis=1)\nd['q']=q*mult\nRESULT=d.groupby('Tên sản phẩm').q.sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1a8f8da9b500", "type": "list", "answer": ["Đàm Long Dũng", "Nguyễn Quang Dũng", "Kiều Thắng Hằng", "Vương Huy Giang", "Trần Bảo Đức"], "_code": "import re\ndef money(x):\n    x=str(x).strip().lower()\n    m=re.match(r'^(-?\\d+)\\s*tr(\\d*)$',x)\n    if m: return int(m.group(1))*1000000+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    s=re.sub(r'[^\\d\\-]','',x.split('.')[0] if re.match(r'^\\d+\\.0+$',x) else x)\n    return float(s) if s not in ('','-') else 0.0\nd=DonHang_ChiTiet.copy()\nd['d']=parse_date(d['Ngày đặt hàng'])\nbad=d.loc[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False),'Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)&(d.d>='2025-10-01')&(d.d<='2025-10-31')]\nd=d[~d['Tên khách hàng'].str.strip().str.lower().isin(['khách lẻ','kl','lẻ'])]\nd['v']=d['Tổng tiền'].map(money)\nRESULT=list(d.groupby('Tên khách hàng').v.sum().sort_values(ascending=False).head(5).index)\n", "_attempts": 1, "_verdict": "correct"}
