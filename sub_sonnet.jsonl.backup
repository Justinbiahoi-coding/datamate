{"id": "q_5fd698a99bce", "type": "percent", "answer": 2.62, "_code": "o=don_hang.copy(); o['d']=parse_date(o['Ngày bán'])\no=o[(o.d>='2026-08-01')&(o.d<=as_of_date)]\nRESULT=f\"{round((o['Tình trạng đơn']=='cancelled').sum()/len(o)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a05aeaae5493", "type": "percent", "answer": 2.7, "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().replace('đ','').replace(' ','').lower()\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr'); \n        v=float(a.replace(',','.'))*1e6 if (b=='' or ',' in a) else float(a)*1e6+float(b.ljust(3,'0'))*1e3\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\ndf=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\ndf['d']=parse_date(df['Giờ'])\ndf['amt']=df['Tiền'].apply(money)\nbad=df[df['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã phiếu'].unique()\nneg=df[df['Số lượng hàng'].astype(str).str.startswith('-')]['Mã phiếu'].unique()\nok=df[~df['Mã phiếu'].isin(set(bad)|set(neg))]\n\nm=df[(df.d>='2026-02-01')&(df.d<'2026-03-01')]\no=m.drop_duplicates('Mã phiếu')\nc=o['Ghi chú TT'].str.contains('hủy|huỷ',case=False).sum()\nRESULT=f\"{c/len(o)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6d5e6a76a910", "type": "string", "answer": "Đinh Quang Phúc", "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().replace('đ','').replace(' ','').lower()\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr'); \n        v=float(a.replace(',','.'))*1e6 if (b=='' or ',' in a) else float(a)*1e6+float(b.ljust(3,'0'))*1e3\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\ndf=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\ndf['d']=parse_date(df['Giờ'])\ndf['amt']=df['Tiền'].apply(money)\nbad=df[df['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã phiếu'].unique()\nneg=df[df['Số lượng hàng'].astype(str).str.startswith('-')]['Mã phiếu'].unique()\nok=df[~df['Mã phiếu'].isin(set(bad)|set(neg))]\n\nm=ok[(ok.d>='2025-11-01')&(ok.d<'2025-12-01')]\nm=m[~m.TenKH.str.lower().isin(['khách lẻ','kl','lẻ'])]\nRESULT=m.drop_duplicates('Mã phiếu').TenKH.value_counts().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_18a3c0b665fe", "type": "date", "answer": "2025-03-24", "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().replace('đ','').replace(' ','').lower()\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr'); \n        v=float(a.replace(',','.'))*1e6 if (b=='' or ',' in a) else float(a)*1e6+float(b.ljust(3,'0'))*1e3\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\ndf=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\ndf['d']=parse_date(df['Giờ'])\ndf['amt']=df['Tiền'].apply(money)\nbad=df[df['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã phiếu'].unique()\nneg=df[df['Số lượng hàng'].astype(str).str.startswith('-')]['Mã phiếu'].unique()\nok=df[~df['Mã phiếu'].isin(set(bad)|set(neg))]\n\nm=ok[(ok.d>='2025-03-01')&(ok.d<'2025-04-01')]\ns=m.groupby(m.d.dt.date).amt.sum()\nRESULT=str(s.idxmax())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4d8da48b964e", "type": "string", "answer": "Cty Phạm Giang", "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().replace('đ','').replace(' ','').lower()\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr'); \n        v=float(a.replace(',','.'))*1e6 if (b=='' or ',' in a) else float(a)*1e6+float(b.ljust(3,'0'))*1e3\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\ndf=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\ndf['d']=parse_date(df['Giờ'])\ndf['amt']=df['Tiền'].apply(money)\nbad=df[df['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã phiếu'].unique()\nneg=df[df['Số lượng hàng'].astype(str).str.startswith('-')]['Mã phiếu'].unique()\nok=df[~df['Mã phiếu'].isin(set(bad)|set(neg))]\n\nn=SoNhapHang.copy(); n['d']=parse_date(n['Ngày nhập']); n['amt']=n['Thành tiền'].apply(money)\nn=n[(n.d>='2025-11-01')&(n.d<'2025-12-01')]\nRESULT=n.groupby('Nhà cung cấp').amt.sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3bdc21e5f7f8", "type": "string", "answer": "Cty Thân Ngọc", "_code": "n=pd.read_excel('/dev/null') if False else None\ns=SoNhapHang.copy(); s['d']=parse_date(s['Ngày nhập'])\ns=s[(s.d>='2026-06-01')&(s.d<=as_of_date)]\ns['t']=pd.to_numeric(s['Thành tiền'],errors='coerce')\nRESULT=s.groupby('Nhà cung cấp').t.sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4e75fd94c469", "type": "date", "answer": "2025-09-30", "_code": "\nd=Bao_cao_ban_hang__So_chi_tiet_ban_hang.copy()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nd['m']=d['Thành tiền'].astype(str).str.replace(',','').astype(float)\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao',case=False,na=False)]['Mã đơn hàng'].unique()\nx=d[~d['Mã đơn hàng'].isin(bad)&(d.dt>='2025-09-01')&(d.dt<='2025-09-30')]\ns=x.groupby('dt')['m'].sum()\nRESULT=s.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
