{"id": "q_65a476bc63df", "type": "list", "answer": ["Bia Tiger lon", "Bia Sài Gòn Special lon", "Nước suối"], "_code": "o=don_hang.drop_duplicates().drop_duplicates('Mã chứng từ').copy()\no['d']=parse_date(o['Ngày'])\no=o[o['Tình trạng'].isin(['completed','shipping'])]\no=o[(o.d>='2026-03-01')&(o.d<='2026-03-31')]\nc=chi_tiet_don.drop_duplicates()\nc=c[c['Mã đơn hàng'].isin(o['Mã chứng từ'])].copy()\nc['q']=to_num(c['Số lượng lẻ'])\nnm=san_pham.set_index('Mã sản phẩm bán')['Tên SP'].to_dict()\nc['n']=c['Mã mặt hàng'].map(nm)\nc=c[c.n.notna()&~c.n.astype(str).str.contains('Phí phục vụ',case=False)]\ng=c.groupby('n').q.sum().sort_values(ascending=False)\nprint(g.head(5))\nRESULT=list(g.index[:3])\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_7b97af265e75", "type": "date", "answer": "2025-04-01", "_code": "d=So_chi_tiet_ban_hang__all.drop_duplicates().copy(); d['dt']=parse_date(d['Ngày']); d['amt']=to_num(d['Thành tiền'])\nst=d.groupby('Mã đơn hàng')['Trạng thái'].transform(lambda s: s.dropna().iloc[0] if s.notna().any() else None)\nd=d[st.isin(['Đã hoàn thành','Đang giao hàng'])]\nm=d[(d.dt.dt.year==2025)&(d.dt.dt.month==4)]\nRESULT=str(m.groupby(m.dt.dt.date)['amt'].sum().idxmax())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_abf2c0f910bf", "type": "date", "answer": "2025-05-15", "_code": "o=data['danh_sach_hoa_don'].drop_duplicates('Mã bill').copy()\no['d']=parse_date(o['Ngày giao dịch'])\no=o[o['Status'].isin(['Hoàn thành','Chờ giao'])&(o.d>='2025-05-01')&(o.d<='2025-05-31')]\no['t']=to_num(o['Tien hang'])\ns=o.groupby('d').t.sum().sort_values(ascending=False,kind='stable')\nRESULT=s.index[0].strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_09fe8610d418", "type": "number", "answer": 273, "_code": "\nH=DuLieuBanHang['DanhSachHoaDon'].drop_duplicates().copy()\nH['dt']=parse_date(H['Thời gian'])\nH=H[H['Trạng thái'].isin(['đã lấy','Hoàn thành','Đang xử lý'])]\nC=DanhSachHoaDonChiTiet.drop_duplicates().merge(H[['Mã hóa đơn','dt']],on='Mã hóa đơn')\nC['tt']=to_num(C['Thành tiền']); C['qd']=to_num(C['Số lượng quy đổi'])\n\nx=C[(C.dt>='2026-04-01')&(C.dt<='2026-04-30')&(C['Mã hàng']=='SP0008')]\nRESULT=int(x.qd.sum())\n", "_attempts": 1, "_verdict": "correct"}
