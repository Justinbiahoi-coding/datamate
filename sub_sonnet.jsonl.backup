{"id": "q_cd1f0f0fa1aa", "type": "number", "answer": 70201, "_code": "h=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[(h.dt>='2025-08-01')&(h.dt<='2025-08-31')]\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|hoàn',case=False,na=False)]\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2]).drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\nRESULT=int(round(to_num(c['Thành tiền']).sum()/len(h)+1e-9))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6a561b61690c", "type": "list", "answer": ["Đoàn Sơn Sơn", "Vương Duy Quang", "Kiều Ngọc Hoàng", "Thân Lan Nam", "Lý Mai Hồng"], "_code": "df=data['So_chi_tiet_ban_hang__all'].drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày'])\nbad=df[df['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)]['Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf=df[(df.d>='2025-08-01')&(df.d<='2025-08-31')]\ndf=df[df['Khách hàng'].notna() & ~df['Khách hàng'].str.strip().str.lower().isin(['lẻ','khách lẻ','kl'])]\ndf['tt']=to_num(df['Thành tiền'])\ndf['k']=df['Khách hàng'].apply(normalize_text)\ng=df.groupby('k').agg(t=('tt','sum'),n=('Khách hàng','first')).sort_values('t',ascending=False)\nRESULT=list(g.n[:5])\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_84675b30970f", "type": "percent", "answer": 2.32, "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nh=DanhSachHoaDon__all.drop_duplicates().copy()\nh['dt']=parse_date(h['Thời gian'])\nok=h[~h['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False,na=False)&(h.dt>='2026-01-01')&(h.dt<='2026-01-31')]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(ok['Mã hóa đơn'])].copy()\nc['t']=mon(c['Thành tiền'])\nrx=set(DanhSachThuoc[DanhSachThuoc['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1'])]['Mã hàng'])\nRESULT=f\"{round(c[c['Mã hàng'].isin(rx)].t.sum()/c.t.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a39f397a9580", "type": "percent", "answer": -3.77, "_code": "import re\ndef money(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    m=re.match(r'^([\\d.,]+)\\s*tr\\s*(\\d*)$',s)\n    if m:\n        a=float(m.group(1).replace(',','.')) if m.group(2)=='' else float(m.group(1))+0\n        if m.group(2)!='': return a*1e6+float(m.group(2).ljust(3,'0'))*1e3\n        return a*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^\\d{1,3}([.,]\\d{3})+$',s): return float(re.sub(r'[.,]','',s))\n    if re.match(r'^[\\d,]+\\.\\d+$',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.match(r'^[\\d.,]+$',s) else 0.0\nd=DonHang_ChiTiet.copy()\nd=d[d['Tên sản phẩm'].notna()]\nd[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']]=d[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['a']=d['Tổng tiền'].map(money)\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\ndef r(a,b): return d[(d.dt>=a)&(d.dt<=b)].a.sum()\nx=r('2026-04-01','2026-04-30'); y=r('2026-03-01','2026-03-31')\nRESULT=f\"{round((x-y)/y*100,2)}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_b58b1a9fde2d", "type": "percent", "answer": 3.23, "_code": "\nh=DanhSachHoaDon.copy(); l=DanhSachHoaDonChiTiet.copy(); p=DanhSachSanPham.copy()\nprint(p['Nhóm hàng(3 Cấp)'].unique())\nh['dt']=pd.to_datetime(h['Thời gian tạo'])\nh=h.drop_duplicates('Mã hóa đơn')\nok=h[(h.dt>='2025-08-01')&(h.dt<'2025-09-01')&h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\nl=l.drop_duplicates()\nl=l[l['Mã hóa đơn'].isin(ok['Mã hóa đơn'])].copy()\nl['t']=to_num(l['Thành tiền'])\nl['g']=l['Mã hàng'].map(dict(zip(p['Mã hàng'],p['Nhóm hàng(3 Cấp)'])))\nRESULT=f\"{l[l.g=='mì gói'].t.sum()/l.t.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_749c22cb85cd", "type": "number", "answer": 3000, "_code": "\nd=DonHang_ChiTiet[DonHang_ChiTiet['Mã đơn hàng'].notna()].reset_index(drop=True)\nd['dt']=pd.to_datetime(d['Ngày đặt hàng'],format='%d/%m/%Y',errors='coerce')\nd=d.drop_duplicates()\nbad=set(d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|hoàn hàng',case=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bad)]\nm=d[(d.dt>='2026-01-01')&(d.dt<='2026-01-31')&d['Tên sản phẩm'].str.strip().str.lower().str.endswith('(m)')]\nRESULT=int(m['Số lượng sản phẩm'].sum())\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_c8ec04a9f407", "type": "percent", "answer": 5.77, "_code": "d=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nbad=d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\noid=d[bad]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(oid)&(d.dt>='2025-08-01')&(d.dt<='2025-08-31')]\nd['tt']=to_num(d['Thành tiền'])\ng=data[[k for k in data if k.startswith('Danh') and '__' not in k][0]].set_index('Tên hàng hóa')['Nhóm hàng hóa']\nd['g']=d['Tên hàng hóa'].map(g)\nRESULT=f\"{d[d.g.str.strip().str.lower()=='xi măng'].tt.sum()/d.tt.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_86a3ae25144a", "type": "percent", "answer": -48.84, "_code": "df=data['So_chi_tiet_ban_hang__all'].drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày'])\nbad=df[df['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)]['Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf=df[df['Tên hàng hóa'].str.strip()=='Công tắc 1 chiều Panasonic Wide kèm mặt']\ndf['q']=to_num(df['Số lượng quy đổi'])\nD=pd.Timestamp('2025-08-20')\na=df[(df.d>=D)&(df.d<D+pd.Timedelta(days=14))].q.sum()\nb=df[(df.d>=D-pd.Timedelta(days=14))&(df.d<D)].q.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d2b4f14d86e8", "type": "list", "answer": [4, 9], "_code": "sku='SP0039'; fac=10\nimp=DonNhapHang_ChiTiet.merge(DonNhapHang,on='Mã đơn nhập')\nimp['d']=parse_date(imp['Ngày nhập'])\nimp=imp[(imp.d<=as_of_date)&(imp['Mã SKU']==sku)]\nlots=set(imp['Mã lô'])\ntot=to_num(imp['Số lượng nhập']).sum()\nod=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all])[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']].drop_duplicates('Mã đơn hàng').reset_index(drop=True)\nod['d']=parse_date(od['Ngày đặt hàng'])\nod=od[(od.d<=as_of_date)&~od['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel',case=False,na=False)]\nlo=pd.concat([DonHang_Lo_1,DonHang_Lo_2])\nlo=lo[lo['Mã lô'].isin(lots)&lo['Mã đơn hàng'].isin(od['Mã đơn hàng'])]\nst=tot-to_num(lo['Số lượng']).sum()+to_num(lo['Số lượng trả']).sum()\nst=int(st)\nRESULT=[st//fac, st%fac]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4deb7fd6f277", "type": "list", "answer": [2, 22], "_code": "sku='SP0052'; fac=30\nimp=DonNhapHang_ChiTiet.merge(DonNhapHang,on='Mã đơn nhập')\nimp['d']=parse_date(imp['Ngày nhập'])\nimp=imp[(imp.d<=as_of_date)&(imp['Mã SKU']==sku)]\nlots=set(imp['Mã lô'])\ntot=to_num(imp['Số lượng nhập']).sum()\nod=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all])[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']].drop_duplicates('Mã đơn hàng').reset_index(drop=True)\nod['d']=parse_date(od['Ngày đặt hàng'])\nod=od[(od.d<=as_of_date)&~od['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel',case=False,na=False)]\nlo=pd.concat([DonHang_Lo_1,DonHang_Lo_2])\nlo=lo[lo['Mã lô'].isin(lots)&lo['Mã đơn hàng'].isin(od['Mã đơn hàng'])]\nst=tot-to_num(lo['Số lượng']).sum()+to_num(lo['Số lượng trả']).sum()\nst=int(st)\nRESULT=[st//fac, st%fac]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_07fd86b575da", "type": "list", "answer": ["Bia Tiger lon", "Bia Tiger Bạc lon", "Rau muống xào tỏi"], "_code": "DSHH=[v for k,v in data.items() if k.startswith('Danh')][0]\nd=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nbad=set(d[d['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]['Mã đơn hàng'])\nm=d[(d.dt>='2026-05-18')&(d.dt<='2026-05-22')&~d['Mã đơn hàng'].isin(bad)&(d['Tên hàng hóa']!='Phí phục vụ')].copy()\nm['q']=to_num(m['Số lượng quy đổi'])\ng=m.groupby('Tên hàng hóa').q.sum().reset_index().merge(DSHH[['Mã hàng hóa','Tên hàng hóa']],on='Tên hàng hóa',how='left').sort_values(['q','Mã hàng hóa'],ascending=[False,True])\nRESULT=list(g['Tên hàng hóa'].head(3))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_58b6ceccb433", "type": "list", "answer": [13167600, 240535800], "_code": "h=DanhSachHoaDon__all.copy(); c=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nt=c.assign(a=to_num(c['Thành tiền'])).groupby('Mã hóa đơn').a.sum()\nx=h[(h.dt>='2025-02-01')&(h.dt<='2025-02-28')].copy()\nx['r']=x['Mã hóa đơn'].map(t).fillna(0)\ns=x.groupby('Kênh bán').r.sum()\nRESULT=[int(s.get('zalo_oa',0)),int(s.get('store',0))]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_dcab2f85301d", "type": "number", "answer": 213028800, "_code": "n=DanhSachNhapHang.copy()\nn['dt']=parse_date(n['Thời gian'])\nn=n[~n['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nx=n[(n.dt>='2025-11-01')&(n.dt<='2025-11-30')]\nRESULT=int(to_num(x['Cần trả NCC']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6e4042769558", "type": "list", "answer": ["Cà phê đen (M)", "Cà phê sữa (M)", "Trà sữa trân châu (M)"], "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    sg=-1 if s.startswith('-') else 1\n    s=s.lstrip('-').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return sg*(int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0))\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)\\s*k',s)\n    if m: return sg*float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return sg*float(s)\n    except: return float('nan')\n\na=pd.concat([SoBanHang_1__all,SoBanHang_2026__all]).dropna(subset=['Mã hóa đơn']).drop_duplicates().copy()\na['q']=pd.to_numeric(a['so_luong'],errors='coerce')\na['t']=a['Trị giá'].map(money)\na['dt']=pd.to_datetime(a['Giờ'])\nbad_st=a['Status'].astype(str).str.contains('hủy|huỷ|trả|hoàn',case=False)\nbad=set(a[bad_st|(a.q<0)]['Mã hóa đơn'])\nv=a[~a['Mã hóa đơn'].isin(bad)].copy()\n\nv['ds']=v.dt.dt.normalize()\nw=v[(v.ds>='2026-02-02')&(v.ds<='2026-02-05')].copy()\nf={r['Tên món']:(r['ĐV nhập'],float(r['Hệ số'])) for _,r in DanhMuc.iterrows()}\nw['b']=w.apply(lambda r: r.q*f[r['Hàng']][1] if r['Hàng'] in f and r['Unit']==f[r['Hàng']][0] else r.q,axis=1)\ng=w.groupby('Hàng').b.sum().sort_values(ascending=False)\nprint(g.head(5))\nRESULT=list(g.head(3).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d38db8d16c38", "type": "list", "answer": [348311500, 379300800, 359106000], "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    sg=-1 if s.startswith('-') else 1\n    s=s.lstrip('-').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return sg*(int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0))\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)\\s*k',s)\n    if m: return sg*float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return sg*float(s)\n    except: return float('nan')\n\na=pd.concat([SoBanHang_1__all,SoBanHang_2026__all]).dropna(subset=['Mã hóa đơn']).drop_duplicates().copy()\na['q']=pd.to_numeric(a['so_luong'],errors='coerce')\na['t']=a['Trị giá'].map(money)\na['dt']=pd.to_datetime(a['Giờ'])\nbad_st=a['Status'].astype(str).str.contains('hủy|huỷ|trả|hoàn',case=False)\nbad=set(a[bad_st|(a.q<0)]['Mã hóa đơn'])\nv=a[~a['Mã hóa đơn'].isin(bad)].copy()\n\nRESULT=[int(v[(v.dt>=f'{m}-01')&(v.dt<pd.Timestamp(f'{m}-01')+pd.offsets.MonthBegin(1))].t.sum()) for m in ['2025-09','2025-10','2025-11']]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_790a875887b6", "type": "list", "answer": ["Cà phê sữa (M)", "Cà phê đen (M)", "Trà đào cam sả (M)"], "_code": "d=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt>='2025-11-24')&(d.dt<='2025-11-30')]\nbad=d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nd=d[~d['Mã đơn hàng'].isin(d[bad]['Mã đơn hàng'])]\nd['k']=d['Tên hàng hóa'].map(lambda s:' '.join(str(s).lower().split()))\nd['q']=to_num(d['Số lượng quy đổi'])\ncanon=d.groupby('k')['Tên hàng hóa'].agg(lambda x:x.value_counts().index[0])\ns=d.groupby('k').q.sum().sort_values(ascending=False)\nRESULT=[canon[k] for k in s.index[:3]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7024d934baf7", "type": "list", "answer": ["Xi măng Hà Tiên PCB40 bao 50kg", "Xi măng INSEE Power-S bao 50kg", "Thép cuộn phi 6 Hòa Phát", "Gạch ống 8x8x18 Tuynel", "Thép Pomina D16 cây 11.7m"], "_code": "import re\nd=SoBanHang__all.copy()\nd=d[d['Mã phiếu'].notna()].copy()\nd['dt']=pd.to_datetime(d['Giờ'],errors='coerce')\nd=d.drop_duplicates()\nbad=set(d[d['Ghi chú TT'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]['Mã phiếu'])\nd=d[~d['Mã phiếu'].isin(bad)&(d.dt>='2026-02-09')&(d.dt<'2026-02-16')].copy()\ndef num(x):\n    m=re.match(r'\\s*([\\d]+(?:[.,]\\d+)?)',str(x)); return float(m.group(1).replace(',','.')) if m else 0\nd['n']=d['Số lượng hàng'].map(num)\nd['k']=d['Tên SP'].map(normalize_text)\nf={normalize_text(r['Hàng']):(r['ĐV lớn'],r['Hệ số QĐ']) for _,r in DanhMuc.iterrows()}\ndef base(r):\n    u=f.get(r['k'])\n    return r['n']*float(u[1]) if u and normalize_text(r['DonVi'])==normalize_text(u[0]) else r['n']\nd['b']=d.apply(base,axis=1)\ns=d.groupby('k').agg(q=('b','sum'),nm=('Tên SP','first')).sort_values('q',ascending=False)\nRESULT=s['nm'].head(5).tolist()\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_8f42e0c8d88a", "type": "list", "answer": [46892500, 108264500], "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\n\nh=don_hang.drop_duplicates().drop_duplicates('Mã chứng từ')\nh=h[~h['Tình trạng'].isin(['cancelled','returned'])]\nh=h.assign(dt=pdate(h['Ngày']))\nh=h[(h.dt>='2025-10-01')&(h.dt<='2025-10-31')]\nc=chi_tiet_don.drop_duplicates(); c=c.assign(v=money(c['Amount']))\nr=c.groupby('Mã đơn hàng').v.sum()\nh=h.assign(v=h['Mã chứng từ'].map(r).fillna(0))\nRESULT=[int(h[h['Trả bằng']==k].v.sum()) for k in ['cod','ewallet']]\n", "_attempts": 1, "_verdict": "correct"}
