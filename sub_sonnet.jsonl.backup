{"id": "q_f83927bd9a18", "type": "number", "answer": 179927, "_code": "\nimport pandas as pd\nh=DuLieuBanHang['DanhSachHoaDon'].drop_duplicates('Mã hóa đơn').copy()\nh['dt']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nbad=h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nh=h[~bad]\nasof=pd.Timestamp(as_of_date)\nmon=asof-pd.Timedelta(days=asof.weekday()+7); sun=mon+pd.Timedelta(days=6)\nh=h[(h.dt>=mon)&(h.dt<=sun)]\nd=DanhSachHoaDonChiTiet[DanhSachHoaDonChiTiet['Mã hóa đơn'].isin(h['Mã hóa đơn'])].drop_duplicates()\nt=pd.to_numeric(d['Thành tiền'].astype(str).str.replace(',',''),errors='coerce').groupby(d['Mã hóa đơn']).sum()\nimport decimal\nRESULT=int(decimal.Decimal(str(t.sum()/len(h))).quantize(decimal.Decimal('1'),rounding=decimal.ROUND_HALF_UP))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5bacacf2e035", "type": "number", "answer": 156305, "_code": "\nimport pandas as pd\nh=DuLieuBanHang['DanhSachHoaDon'].drop_duplicates('Mã hóa đơn').copy()\nh['dt']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nbad=h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nh=h[~bad]\nasof=pd.Timestamp(as_of_date)\nmon=asof-pd.Timedelta(days=asof.weekday()+7); sun=mon+pd.Timedelta(days=6)\nh=h[(h.dt>=mon)&(h.dt<=sun)]\nd=DanhSachHoaDonChiTiet[DanhSachHoaDonChiTiet['Mã hóa đơn'].isin(h['Mã hóa đơn'])].drop_duplicates()\nt=pd.to_numeric(d['Thành tiền'].astype(str).str.replace(',',''),errors='coerce').groupby(d['Mã hóa đơn']).sum()\nimport decimal\nRESULT=int(decimal.Decimal(str(t.sum()/len(h))).quantize(decimal.Decimal('1'),rounding=decimal.ROUND_HALF_UP))\n", "_attempts": 1, "_verdict": "correct"}
