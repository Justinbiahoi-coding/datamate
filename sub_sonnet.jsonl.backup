{"id": "q_0c20dcf7fc9f", "type": "date", "answer": "2025-12-07", "_code": "import re\ndef money(x):\n    x=str(x).strip()\n    m=re.match(r'^(\\d+)tr(\\d*)$',x)\n    if m:\n        return int(m.group(1))*1000000+(int(m.group(2).ljust(3,'0')) if m.group(2) else 0)*1000\n    return int(re.sub(r'\\D','',x))\nh=don_hang[don_hang['Tình trạng'].isin(['completed','shipping'])].copy()\nh['dt']=pd.to_datetime(h['Ngày'])\nc=chi_tiet_don.drop_duplicates().copy()\nc['a']=c['Amount'].map(money)\nt=c.groupby('Mã đơn hàng').a.sum().rename('tt')\nh=h.join(t,on='Mã chứng từ')\nx=h[(h.dt>='2025-12-01')&(h.dt<='2025-12-31')].groupby('dt').tt.sum()\nRESULT=x.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8a42d124b5cb", "type": "list", "answer": [174800, 7000], "_code": "\nh=DuLieuBanHang__DanhSachHoaDon.drop_duplicates().copy()\nkh=DuLieuBanHang__DanhSachKhachHang\ncode=kh.loc[kh['Tên khách hàng'].map(vn_normalize)==vn_normalize('Thái Nhung Hải'),'Mã khách hàng'].iloc[0]\nh['od']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh=h[(h['Mã KH']==code)&(h['Phương thức thanh toán']=='Ghi nợ')&~h['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nh['tot']=to_num(h['Tổng sau giảm giá'])\nsq=DuLieuBanHang__SoQuy.copy(); sq['d']=pd.to_datetime(sq['Thời gian']).dt.normalize()\nsq=sq[sq['Mã hóa đơn'].isin(h['Mã hóa đơn'])].merge(h[['Mã hóa đơn','od']],on='Mã hóa đơn')\nsq['v']=to_num(sq['Giá trị'])\nsame=sq[sq.d==sq.od].groupby('Mã hóa đơn').v.sum()\ninp=h[(h.od>='2026-08-01')&(h.od<='2026-08-05')]\nadd=(inp.tot-inp['Mã hóa đơn'].map(same).fillna(0)).sum()\npay=sq[(sq.d>sq.od)&(sq.d>='2026-08-01')&(sq.d<='2026-08-05')].v.sum()\nRESULT=[int(round(add)),int(round(pay))]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e6c4184d2b83", "type": "list", "answer": [345000, 102000], "_code": "\nh=DuLieuBanHang__DanhSachHoaDon.drop_duplicates().copy()\nkh=DuLieuBanHang__DanhSachKhachHang\ncode=kh.loc[kh['Tên khách hàng'].map(vn_normalize)==vn_normalize('Hà Anh Tâm'),'Mã khách hàng'].iloc[0]\nh['od']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh=h[(h['Mã KH']==code)&(h['Phương thức thanh toán']=='Ghi nợ')&~h['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nh['tot']=to_num(h['Tổng sau giảm giá'])\nsq=DuLieuBanHang__SoQuy.copy(); sq['d']=pd.to_datetime(sq['Thời gian']).dt.normalize()\nsq=sq[sq['Mã hóa đơn'].isin(h['Mã hóa đơn'])].merge(h[['Mã hóa đơn','od']],on='Mã hóa đơn')\nsq['v']=to_num(sq['Giá trị'])\nsame=sq[sq.d==sq.od].groupby('Mã hóa đơn').v.sum()\ninp=h[(h.od>='2025-08-01')&(h.od<='2025-08-31')]\nadd=(inp.tot-inp['Mã hóa đơn'].map(same).fillna(0)).sum()\npay=sq[(sq.d>sq.od)&(sq.d>='2025-08-01')&(sq.d<='2025-08-31')].v.sum()\nRESULT=[int(round(add)),int(round(pay))]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1969df5e8f80", "type": "number", "answer": 723839400, "_code": "h=don_hang.drop_duplicates('MaHoaDon').copy()\nh['d']=pd.to_datetime(h['ThoiGianLap']).dt.normalize()\nh=h[h.TinhTrang.isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates()\nc=c[c.MaHoaDon.isin(h.MaHoaDon)].copy()\nc['t']=to_num(c['TriGia']); c['q']=to_num(c['SLQuyDoi'])\nc=c.merge(h[['MaHoaDon','d']],on='MaHoaDon')\nRESULT=int(round(c[(c.d>='2025-01-01')&(c.d<='2025-04-13')].t.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fa48e43bff04", "type": "list", "answer": ["Panadol Extra hộp 15 vỉ x 12 viên", "Enervon hộp 10 vỉ x 10 viên", "Panadol 500mg hộp 10 vỉ x 12 viên", "Tiffy Dey hộp 25 vỉ x 4 viên", "Amoxicillin 500mg Domesco hộp 10 vỉ x 10 viên"], "_code": "h=don_hang.drop_duplicates('MaHoaDon').copy()\nh['d']=pd.to_datetime(h['ThoiGianLap']).dt.normalize()\nh=h[h.TinhTrang.isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates()\nc=c[c.MaHoaDon.isin(h.MaHoaDon)].copy()\nc['t']=to_num(c['TriGia']); c['q']=to_num(c['SLQuyDoi'])\nc=c.merge(h[['MaHoaDon','d']],on='MaHoaDon')\nx=c[(c.d>='2025-06-01')&(c.d<='2025-06-30')]\ng=x.groupby('MaHangHoa').q.sum().sort_values(ascending=False)\nnm=san_pham.set_index('MaHangHoa')['TenGoi'].to_dict()\nRESULT=[nm[k] for k in g.index[:5]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a21f3807940b", "type": "list", "answer": ["Thân Giang Giang", "Tô Hằng Phong", "Phạm Ngân Huy", "Lâm Minh Hồng", "Bùi Hoàng Cường"], "_code": "import re\ndef pm(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)(?:,(\\d+))?tr(\\d+)?',s)\n    if m:\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0')[:3])*1e3\n        else: a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        return -a if neg else a\n    m=re.fullmatch(r'(\\d+(?:,\\d+)?)k',s)\n    if m: v=float(m.group(1).replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except Exception: return float('nan')\n    return -v if neg else v\nd=DonHang_ChiTiet__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['amt']=d['Tổng tiền'].map(pm)\nd=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nm=d[(d.dt.dt.year==2025)&(d.dt.dt.month==7)].copy()\nimport re\ndef key(n):\n    n=normalize_text(n); return re.sub(r'\\s*\\d[\\d\\s\\-\\.]{6,}$','',n).strip()\nm['k']=m['Tên khách hàng'].map(key)\nm=m[~m.k.isin(['khach le','le','khach vang lai','kl','kh le',''])]\nprint(m['Tên khách hàng'].map(repr).value_counts().head(0))\ng=m.groupby('k').agg(a=('amt','sum'),n=('Tên khách hàng',lambda s:s.value_counts().index[0])).sort_values('a',ascending=False)\nRESULT=list(g.head(5)['n'])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5d85d2cf1622", "type": "number", "answer": 18631000, "_code": "\nh=DuLieuBanHang__DanhSachHoaDon.drop_duplicates().copy()\nh['od']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả hàng',case=False,na=False)]\nl=DanhSachHoaDonChiTiet.merge(h[['Mã hóa đơn','od']],on='Mã hóa đơn')\nsp=DuLieuBanHang__DanhSachSanPham[['Mã hàng','Nhóm hàng(3 Cấp)']]\nl=l.merge(sp,on='Mã hàng',how='left')\nl['amt']=to_num(l['Thành tiền'])\n\nm=l[(l.od>='2025-02-01')&(l.od<='2025-02-28')&(l['Nhóm hàng(3 Cấp)']=='gạo')]\nRESULT=int(round(m.amt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_325abab88a13", "type": "number", "answer": 41262283, "_code": "\nh=DuLieuBanHang__DanhSachHoaDon.drop_duplicates().copy()\nh['od']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả hàng',case=False,na=False)]\nl=DanhSachHoaDonChiTiet.merge(h[['Mã hóa đơn','od']],on='Mã hóa đơn')\nsp=DuLieuBanHang__DanhSachSanPham[['Mã hàng','Nhóm hàng(3 Cấp)']]\nl=l.merge(sp,on='Mã hàng',how='left')\nl['amt']=to_num(l['Thành tiền'])\n\nm=l[(l.od>='2025-08-01')&(l.od<='2025-08-31')]\nRESULT=int(round((m.amt-m['Số lượng']*to_num(m['Giá vốn'])).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fe7efca0973e", "type": "number", "answer": 238810400, "_code": "import re\ndef pm(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)(?:,(\\d+))?tr(\\d+)?',s)\n    if m:\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0')[:3])*1e3\n        else: a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        return -a if neg else a\n    m=re.fullmatch(r'(\\d+(?:,\\d+)?)k',s)\n    if m: v=float(m.group(1).replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except Exception: return float('nan')\n    return -v if neg else v\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['amt']=d['Tổng tiền'].map(pm)\nd['sq']=pd.to_numeric(d['Số lượng sản phẩm'].astype(str).str.extract(r'([\\d.]+)')[0],errors='coerce')\nd['k']=d['Tên sản phẩm'].map(normalize_text)\nsp=DanhSachSanPham[['Mã SKU','Tên sản phẩm']].merge(DanhSachThuoc,on='Mã SKU')\nsp['k']=sp['Tên sản phẩm'].map(normalize_text)\nrx=set(sp[sp['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1','1.0'])]['k'])\nd=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nm=d[(d.dt.dt.year==2026)&(d.dt.dt.month==2)&~d.k.isin(rx)]\nRESULT=int(round(m.amt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_406dd570776d", "type": "number", "answer": 50864400, "_code": "\nh=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian']).dt.normalize()\nst=h['Trạng thái']\n\nok=h[~st.str.contains('hủy|huỷ|trả',case=False,na=False)]\nk=DanhSachKhachHang\nkc=set(k[k['Nhóm khách hàng']=='thân thiết']['Mã khách hàng'])\nok=ok[ok['Mã KH'].isin(kc)&(ok.dt>='2026-03-01')&(ok.dt<='2026-03-31')]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(ok['Mã hóa đơn'])]\nRESULT=int(round(to_num(c['Thành tiền']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
