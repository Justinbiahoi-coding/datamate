{"id": "q_8f503c0b707e", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Quách Trang Nhung", 368000], ["Nghiêm Dương Khoa", 193900], ["Tô Chi Huy", 112267]]}, "_code": "dg=lambda s: pd.to_numeric(s.astype(str).str.replace(r'[^\\d\\-]','',regex=True),errors='coerce').fillna(0)\nh=BanHang_HoaDon.copy(); h['d']=parse_date(h['Ngày bán'])\nh=h[(h['Trạng thái']!='Không giao được')&(h['Phương thức TT']!='Thu hộ (COD)')&(h.d<=as_of_date)]\np=BanHang_PhieuThu.copy(); p['t']=pd.to_datetime(p['Thời gian thu'].astype(str).str[:10],errors='coerce'); p=p[p.t<=as_of_date]\npaid=p.assign(v=dg(p['Số tiền thu'])).groupby('Mã bill').v.sum()\nh['debt']=dg(h['Tong tien'])-h['Order ID'].map(paid).fillna(0)\nh=h[(h.debt>0)&h['Mã KH mua'].notna()]\ng=h.groupby('Mã KH mua').debt.sum().sort_values(ascending=False).head(3)\nnm=BanHang_KhachHang.set_index('Customer ID')['ten_kh'].astype(str).str.replace(r'\\s*[-\\(]*\\s*[\\d\\s]{9,}\\)?','',regex=True).str.strip()\nRESULT={\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[nm.get(k,k),int(v)] for k,v in g.items()]}\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8cdd31591189", "type": "boolean", "answer": true, "_code": "dg=lambda s: pd.to_numeric(s.astype(str).str.replace(r'[^\\d\\-]','',regex=True),errors='coerce').fillna(0)\nh=BanHang_HoaDon.copy(); h['d']=parse_date(h['Ngày bán'])\nh=h[h['Trạng thái'].isin(['Đã giao','Đang vận chuyển'])]\nc=BanHang_ChiTietHoaDon[BanHang_ChiTietHoaDon['Mã giao dịch'].isin(h['Mã giao dịch'] if 'Mã giao dịch' in h else h['Order ID'])].copy()\nc=c.merge(h[['Order ID','d']],left_on='Mã giao dịch',right_on='Order ID'); c['v']=dg(c['Thanh tien'])\nm=lambda y,mo: c[(c.d.dt.year==y)&(c.d.dt.month==mo)].v.sum()\nRESULT=bool(m(2025,6)<m(2025,7)<m(2025,8))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6e13d0978b21", "type": "list", "answer": [23000, 15332], "_code": "dg=lambda s: pd.to_numeric(s.astype(str).str.replace(r'[^\\d\\-]','',regex=True),errors='coerce').fillna(0)\nnorm=lambda s: s.astype(str).str.replace(r'[\\s\\d\\(\\)\\-]+',' ',regex=True).str.strip().str.lower()\nk=BanHang_KhachHang; ids=k[norm(k['ten_kh'])=='bạch hằng long']['Customer ID'].tolist()\nh=BanHang_HoaDon.copy(); h['d']=parse_date(h['Ngày bán'])\nh=h[(h['Phương thức TT']=='Ghi nợ')&(h['Trạng thái']!='Không giao được')&h['Mã KH mua'].isin(ids)]\np=BanHang_PhieuThu.copy(); p['t']=pd.to_datetime(p['Thời gian thu'].astype(str).str[:10]); p['v']=dg(p['Số tiền thu'])\np=p.merge(h[['Order ID','d','Tong tien']],left_on='Mã bill',right_on='Order ID')\nst,en=pd.Timestamp('2026-05-01'),pd.Timestamp(as_of_date)\nsame=p[p.t==p.d].groupby('Order ID').v.sum()\nho=h[(h.d>=st)&(h.d<=en)]\nadd=int((dg(ho['Tong tien'])-ho['Order ID'].map(same).fillna(0)).sum())\npay=int(p[(p.t>p.d)&(p.t>=st)&(p.t<=en)].v.sum())\nRESULT=[add,pay]\n", "_attempts": 1, "_verdict": "correct"}
