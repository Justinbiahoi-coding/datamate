{"id": "q_087a4081a1a9", "type": "number", "answer": 946, "_code": "\nimport pandas as pd, unicodedata as ud\nd=[v for k,v in data.items() if ud.normalize('NFC',k).startswith('Bảng kê')][0].copy()\nd['dt']=parse_date(d['Ngày giao hàng'])\nd=d[(d.dt>='2026-04-01')&(d.dt<='2026-04-30')]\nRESULT=int(d[['Mã đơn hàng','Lần giao']].drop_duplicates().shape[0])", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8b1ebf37838d", "type": "number", "answer": 158609000, "_code": "\nimport pandas as pd, unicodedata as ud, re\ndef nz(x):\n    x=ud.normalize('NFD',str(x).lower().replace('đ','d')).encode('ascii','ignore').decode()\n    return re.sub(r'\\s+',' ',x).strip()\ns=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].copy()\ng=[v for k,v in Bao_cao_ban_hang.items() if ud.normalize('NFC',k).startswith('Danh sách')][0]\ns['dt']=parse_date(s['Ngày'])\ns['a']=pd.to_numeric(s['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\ns['n']=s['Tên hàng hóa'].map(nz)\ngrp=g.assign(n=g['Tên hàng hóa'].map(nz)).set_index('n')['Nhóm hàng hóa'].to_dict()\ns['g']=s.n.map(grp)\ns=s.drop_duplicates()\nok=s[~s['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao',case=False,na=False)]\nx=ok[(ok.dt>='2025-09-01')&(ok.dt<='2025-09-30')&(ok.g.map(nz)==nz('gas & nước'))]\nRESULT=int(round(x.a.sum()))", "_attempts": 1, "_verdict": "correct"}
