{"id": "q_ee530fc682e1", "type": "percent", "answer": 3.23, "_code": "import re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=_re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f)*10**(6-len(f)) if f else 0)\n    m=_re.fullmatch(r'(\\d+),(\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s)\nimport unicodedata as _u\ndef nz(s): return normalize_text(str(s).lower().replace('đ','d'))\ngk=[k for k in data if k.startswith('Danh')][0]\ng=data[gk]\ngm={nz(n):grp for n,grp in zip(g['Tên hàng hóa'],g['Nhóm hàng hóa'])}\nd=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)]\nd=d[(d.dt>='2026-02-01')&(d.dt<='2026-02-28')]\nd['amt']=d['Thành tiền'].map(money); d['g']=d['Tên hàng hóa'].map(nz).map(gm)\nprint(d.g.isna().sum())\nRESULT=f\"{d[d.g=='bánh'].amt.sum()/d.amt.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
