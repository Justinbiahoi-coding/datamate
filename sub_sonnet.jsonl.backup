{"id": "q_fcfafaa99bb4", "type": "percent", "answer": -1.43, "_code": "df = DonHang_ChiTiet__all.drop_duplicates().copy()\ndf['d'] = parse_date(df['Ngày đặt hàng'])\ndf['amt'] = pd.to_numeric(df['Tổng tiền'].astype(str).str.replace(',', ''), errors='coerce')\nbad = df.groupby('Mã đơn hàng')['Trạng thái đơn hàng'].apply(lambda s: s.str.contains('hủy|huỷ|hoàn hàng|trả|cancel', case=False, na=False).any())\ndf = df[~df['Mã đơn hàng'].map(bad)]\ndef rev(y, m):\n    return df[(df.d.dt.year == y) & (df.d.dt.month == m)]['amt'].sum()\ncur = rev(2025, 8)\npm, py = (8 - 1, 2025) if 8 > 1 else (12, 2025 - 1)\nprev = rev(py, pm)\nRESULT = f\"{round((cur - prev) / prev * 100, 2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4192ef63e140", "type": "number", "answer": 23, "_code": "\nimport pandas as pd\nH=DanhSachHoaDon.copy()\nD=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2]).drop_duplicates()\nH['d']=parse_date(H['Thời gian'])\ndef money(s): return pd.to_numeric(s.astype(str).str.replace(',',''),errors='coerce')\nst=H['Trạng thái'].astype(str).str.lower()\nbad=st.str.contains('hủy|huỷ|trả|hoàn trả')\n\nHs=H[(~bad)&(H.d>='2026-03-01')&(H.d<='2026-03-31')]\nx=D[D['Mã hóa đơn'].isin(Hs['Mã hóa đơn'])].drop_duplicates(['Mã hóa đơn','Mã hàng'])\nc=x.groupby('Mã hàng')['Mã hóa đơn'].nunique()\nRESULT=int((c>=123).sum())\n", "_attempts": 1, "_verdict": "correct"}
