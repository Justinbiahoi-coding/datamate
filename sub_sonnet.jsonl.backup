{"id": "q_a302479ed1e5", "type": "number", "answer": 19741500, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\no=don_hang.drop_duplicates('MaHoaDon'); o=o[o.TinhTrang.isin(['completed','shipping'])]\no=o[(parse_date(o.NgayLap)>='2025-02-01')&(parse_date(o.NgayLap)<='2025-02-28')]\ncodes=set(san_pham[san_pham.DanhMuc=='tiêu hoá'].MaHangHoa)\nc=chi_tiet_don.drop_duplicates(); c=c[c.MaHoaDon.isin(o.MaHoaDon)&c.MaHangHoa.isin(codes)]\nRESULT=int(round(c.TriGia.map(m).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0fadd3291fbe", "type": "percent", "answer": 44.5, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\no=don_hang.drop_duplicates('Mã chứng từ'); o=o[o['Tình trạng'].isin(['completed','shipping'])]\no=o[(parse_date(o['Ngày'])>='2026-07-01')&(parse_date(o['Ngày'])<='2026-07-28')]\nc=chi_tiet_don.drop_duplicates(); c=c[c['Mã đơn hàng'].isin(o['Mã chứng từ'])].copy(); c['a']=c.Amount.map(m)\ncash=set(o[o['Trả bằng']=='cash']['Mã chứng từ'])\nRESULT=f\"{c[c['Mã đơn hàng'].isin(cash)].a.sum()/c.a.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8897bef8c60e", "type": "number", "answer": 84444, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nn=DanhSachNhapHang[DanhSachNhapHang['Trạng thái'].str.contains('Đã nhập')]\ndt=parse_date(n['Thời gian']); n=n[(dt>='2026-02-01')&(dt<='2026-02-28')]\nx=DanhSachChiTietNhapHang[DanhSachChiTietNhapHang['Mã nhập hàng'].isin(n['Mã nhập hàng'])&(DanhSachChiTietNhapHang['Mã hàng']=='SP0008')]\nq=to_num(x['Số lượng']); p=x['Đơn giá'].map(m)\nRESULT=int(round((q*p).sum()/q.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c7e48902ab25", "type": "percent", "answer": -3.22, "_code": "import re as _re\ndef money(s):\n    if s is None or (isinstance(s,float) and s!=s): return float('nan')\n    if isinstance(s,(int,float)): return float(s)\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if not s: return float('nan')\n    try:\n        if 'tr' in s:\n            a,b=s.split('tr',1)\n            a=a or '0'\n            if b=='': return float(a.replace(',','.'))*1e6\n            return int(a.replace('.','').replace(',',''))*1e6+int(b.ljust(3,'0')[:3])*1e3\n        if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n        if ',' in s and '.' in s:\n            return float(s.replace(',','')) if s.rfind('.')>s.rfind(',') else float(s.replace('.','').replace(',','.'))\n        if '.' in s:\n            return float(s.replace('.','')) if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s) else float(s)\n        if ',' in s:\n            return float(s.replace(',','')) if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+',s) else float(s.replace(',','.'))\n        return float(s)\n    except Exception: return float('nan')\nd=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày']); d['v']=d['Thành tiền'].map(money)\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được|hoàn hàng',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nt=pd.Timestamp(as_of_date); s=t.replace(day=1)\nps=s-pd.DateOffset(months=1); pe=min(ps.replace(day=t.day) if t.day<=ps.days_in_month else ps+pd.offsets.MonthEnd(0),ps+pd.offsets.MonthEnd(0))\na=d[(d.dt>=s)&(d.dt<=t)]['v'].sum(); b=d[(d.dt>=ps)&(d.dt<=pe)]['v'].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d54a51609099", "type": "number", "answer": 325164000, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn')\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nt=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh=h[(t>='2025-03-01')&(t<='2025-03-31')]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\nRESULT=int(round(c['Thành tiền'].map(m).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9f4fdbb1d382", "type": "percent", "answer": 15.25, "_code": "import re as _re\ndef money(s):\n    if s is None or (isinstance(s,float) and s!=s): return float('nan')\n    if isinstance(s,(int,float)): return float(s)\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if not s: return float('nan')\n    try:\n        if 'tr' in s:\n            a,b=s.split('tr',1)\n            a=a or '0'\n            if b=='': return float(a.replace(',','.'))*1e6\n            return int(a.replace('.','').replace(',',''))*1e6+int(b.ljust(3,'0')[:3])*1e3\n        if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n        if ',' in s and '.' in s:\n            return float(s.replace(',','')) if s.rfind('.')>s.rfind(',') else float(s.replace('.','').replace(',','.'))\n        if '.' in s:\n            return float(s.replace('.','')) if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s) else float(s)\n        if ',' in s:\n            return float(s.replace(',','')) if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+',s) else float(s.replace(',','.'))\n        return float(s)\n    except Exception: return float('nan')\nd=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được|hoàn hàng',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nd=d[d['Tên hàng hóa'].map(normalize_text)==normalize_text('Khoai tây chiên')]\nD=pd.Timestamp('2026-03-24')\nq=pd.to_numeric(d['Số lượng quy đổi'],errors='coerce')\na=q[(d.dt>=D)&(d.dt<D+pd.Timedelta(days=7))].sum(); b=q[(d.dt>=D-pd.Timedelta(days=7))&(d.dt<D)].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ded88393f7d8", "type": "number", "answer": 293647, "_code": "n = DanhSachChiTietNhapHang.merge(DanhSachNhapHang[['Mã nhập hàng', 'Thời gian', 'Trạng thái']], on='Mã nhập hàng')\nn['d'] = parse_date(n['Thời gian'])\nn = n[~n['Trạng thái'].str.contains('hủy|huỷ', case=False, na=False)]\ncode = DanhSachSanPham[DanhSachSanPham['Tên hàng'] == 'Nước rửa chén Sunlight 750g']['Mã hàng'].iloc[0]\nn = n[(n['Mã hàng'] == code) & (n['ĐVT'] == 'thùng') & (n.d.dt.year == 2025) & (n.d.dt.month == 2)]\nq = pd.to_numeric(n['Số lượng'], errors='coerce')\np = pd.to_numeric(n['Đơn giá'].astype(str).str.replace(r'[^\\d]', '', regex=True), errors='coerce')\nRESULT = int(round((q * p).sum() / q.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a35033f903d1", "type": "number", "answer": 10.0, "_code": "d=SoBanHang.copy(); d[\"od\"]=parse_date(d[\"ngay_ban\"])\nok=d[~d[\"Trạng thái xử lý\"].str.contains(\"hủy|huỷ|trả|Không giao được|cancel\",case=False,na=False)]\nt=ok[(ok.od>=\"2025-08-01\")&(ok.od<=\"2025-08-31\")&(ok[\"Nội dung\"]==\"Nếp cái hoa vàng\")]\nRESULT=float(to_num(t[\"Số lượng lẻ\"]).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7c987a3271e6", "type": "percent", "answer": 7.0, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nh=DuLieuBanHang__DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates(['Mã hóa đơn','STT']).copy()\nc['v']=c['Thành tiền'].map(money)\nc=c.merge(h[['Mã hóa đơn','dt']],on='Mã hóa đơn')\n\ng=DuLieuBanHang__DanhSachSanPham.set_index('Mã hàng')['Nhóm hàng(3 Cấp)']\nc['g']=c['Mã hàng'].map(g)\nx=c[(c.dt.dt.year==2025)&(c.dt.dt.month==9)]\nRESULT=f\"{round(x[x.g=='nước giải khát'].v.sum()/x.v.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_657bc80121e8", "type": "percent", "answer": 8.99, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nh=DuLieuBanHang__DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates(['Mã hóa đơn','STT']).copy()\nc['v']=c['Thành tiền'].map(money)\nc=c.merge(h[['Mã hóa đơn','dt']],on='Mã hóa đơn')\n\na=c[(c.dt>='2025-08-01')&(c.dt<='2025-08-17')].v.sum()\nb=c[(c.dt>='2025-07-01')&(c.dt<='2025-07-17')].v.sum()\nRESULT=f\"{round((a/b-1)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6dcc411a2f2c", "type": "number", "answer": 70371249.0, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nt=DuLieuBanHang__BaoCaoTonKho.set_index('Mã hàng')['Tồn cuối kỳ'].map(money)\ngv=DuLieuBanHang__DanhSachSanPham.set_index('Mã hàng')['Giá vốn'].map(money)\nRESULT=float((t*gv.reindex(t.index)).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b7f5f5af45dc", "type": "number", "answer": 171901, "_code": "h = DanhSachHoaDon.copy()\nh['d'] = parse_date(h['Thời gian'])\nh = h[~h['Trạng thái'].str.contains('hủy|huỷ|trả', case=False, na=False)]\nl = DanhSachHoaDonChiTiet.drop_duplicates().copy()\nl['amt'] = pd.to_numeric(l['Thành tiền'].astype(str).str.replace(r'[^\\d]', '', regex=True), errors='coerce')\nl = l.merge(h[['Mã hóa đơn', 'd']], on='Mã hóa đơn')\nm = l[(l.d.dt.year == 2025) & (l.d.dt.month == 8)]\nRESULT = int(m['amt'].sum() / m['Mã hóa đơn'].nunique() + 0.5)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_328566752555", "type": "percent", "answer": -21.21, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\nd=d[d['Tên hàng hóa'].map(vn_normalize).str.contains('mcb 2p 20a')&d['Tên hàng hóa'].map(vn_normalize).str.contains('panasonic')]\ndt=parse_date(d['Ngày']); q=d['Số lượng quy đổi'].map(m)\na=q[(dt>='2026-02-01')&(dt<='2026-02-14')].sum(); b=q[(dt>='2026-01-18')&(dt<='2026-01-31')].sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a5048eb3d182", "type": "number", "answer": 130333400, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\nb=SoBanHang.copy()\nb['dt']=parse_date(b['ngay_ban'])\nb=b[~b['Trạng thái xử lý'].str.contains('hủy|huỷ|trả|không giao',case=False,na=False)]\nb=b[(b.dt.dt.year==2025)&(b.dt.dt.month==10)]\nRESULT=int(round(b['Tổng tiền'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_aa330a8cbd4e", "type": "number", "answer": 59.0, "_code": "import re as _re\ndef money(s):\n    if s is None or (isinstance(s,float) and s!=s): return float('nan')\n    if isinstance(s,(int,float)): return float(s)\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if not s: return float('nan')\n    try:\n        if 'tr' in s:\n            a,b=s.split('tr',1)\n            a=a or '0'\n            if b=='': return float(a.replace(',','.'))*1e6\n            return int(a.replace('.','').replace(',',''))*1e6+int(b.ljust(3,'0')[:3])*1e3\n        if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n        if ',' in s and '.' in s:\n            return float(s.replace(',','')) if s.rfind('.')>s.rfind(',') else float(s.replace('.','').replace(',','.'))\n        if '.' in s:\n            return float(s.replace('.','')) if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s) else float(s)\n        if ',' in s:\n            return float(s.replace(',','')) if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+',s) else float(s.replace(',','.'))\n        return float(s)\n    except Exception: return float('nan')\no=don_hang.drop_duplicates().copy(); c=chi_tiet_don.drop_duplicates().copy()\no['dt']=parse_date(o['Ngày bán'])\nok=o[~o['Tình trạng đơn'].str.contains('cancel|return',case=False,na=False)]\ny=pd.Timestamp(as_of_date)-pd.Timedelta(days=1)\nids=set(ok[ok.dt==y]['Số phiếu'])\nlon=set(san_pham[san_pham['Đơn vị tính']=='lon']['Mã HH'])\nx=c[c['Số CT'].isin(ids)&c['Mã hàng bán'].isin(lon)]\nRESULT=float(pd.to_numeric(x['Quy ra ĐV lẻ'],errors='coerce').sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4cbb6b73939c", "type": "percent", "answer": 39.21, "_code": "import re as _re\ndef money(s):\n    if s is None or (isinstance(s,float) and s!=s): return float('nan')\n    if isinstance(s,(int,float)): return float(s)\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if not s: return float('nan')\n    try:\n        if 'tr' in s:\n            a,b=s.split('tr',1)\n            a=a or '0'\n            if b=='': return float(a.replace(',','.'))*1e6\n            return int(a.replace('.','').replace(',',''))*1e6+int(b.ljust(3,'0')[:3])*1e3\n        if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n        if ',' in s and '.' in s:\n            return float(s.replace(',','')) if s.rfind('.')>s.rfind(',') else float(s.replace('.','').replace(',','.'))\n        if '.' in s:\n            return float(s.replace('.','')) if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s) else float(s)\n        if ',' in s:\n            return float(s.replace(',','')) if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+',s) else float(s.replace(',','.'))\n        return float(s)\n    except Exception: return float('nan')\no=don_hang.drop_duplicates().copy(); c=chi_tiet_don.drop_duplicates().copy()\no['dt']=parse_date(o['Ngày bán'])\nok=o[~o['Tình trạng đơn'].str.contains('cancel|return',case=False,na=False)]\nok=ok[(ok.dt.dt.year==2025)&(ok.dt.dt.month==4)]\nc['v']=c['Tiền bán'].map(money)\nrv=c.groupby('Số CT')['v'].sum()\nok=ok.assign(rev=ok['Số phiếu'].map(rv).fillna(0))\nRESULT=f\"{round(ok[ok['Hình thức thanh toán']=='transfer']['rev'].sum()/ok['rev'].sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_95827d19e775", "type": "percent", "answer": -0.41, "_code": "import re\ndef mny(s):\n    s=str(s).strip().lower().replace(\"đ\",\"\").replace(\" \",\"\")\n    if s in (\"\",\"nan\",\"none\"): return float(\"nan\")\n    m=re.fullmatch(r\"(\\d+)tr(\\d*)\",s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,\"0\")[:3])*1000 if f else 0) if len(f)<=3 else float(\"nan\")\n    m=re.fullmatch(r\"([\\d.,]+)tr\",s)\n    if m: return round(float(m.group(1).replace(\",\",\".\"))*1e6)\n    m=re.fullmatch(r\"([\\d.,]+)k\",s)\n    if m: return round(float(m.group(1).replace(\",\",\".\"))*1000)\n    if re.fullmatch(r\"\\d+[.,]\\d{1,2}0*\",s) and not re.fullmatch(r\"\\d{1,3}([.,]\\d{3})+\",s): return round(float(s.replace(\",\",\".\")))\n    return float(re.sub(r\"[^\\d]\",\"\",s))\nd=DonHang_ChiTiet.copy()\nhc=[\"Mã đơn hàng\",\"Ngày đặt hàng\",\"Trạng thái đơn hàng\",\"Tên khách hàng\"]\nd[hc]=d[hc].ffill(); d=d.drop_duplicates()\nd[\"od\"]=parse_date(d[\"Ngày đặt hàng\"]); d[\"a\"]=d[\"Tổng tiền\"].map(mny)\nok=d[~d[\"Trạng thái đơn hàng\"].str.contains(\"hủy|huỷ|hoàn hàng|trả\",case=False,na=False)]\nr=lambda s,e: ok[(ok.od>=s)&(ok.od<=e)].a.sum()\nx,y=r(\"2025-07-01\",\"2025-07-15\"),r(\"2025-06-01\",\"2025-06-15\")\nRESULT=f\"{(x-y)/y*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8aeed472de30", "type": "percent", "answer": -17.58, "_code": "h=DanhSachHoaDon__all.copy(); h[\"od\"]=parse_date(h[\"Thời gian\"])\nh=h[~h[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả|cancel\",case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates(); c=c.assign(a=to_num(c[\"Thành tiền\"]))\nh[\"v\"]=h[\"Mã hóa đơn\"].map(c.groupby(\"Mã hóa đơn\").a.sum()).fillna(0)\nr=lambda s,e: h[(h.od>=s)&(h.od<=e)].v.sum()\nx,y=r(\"2026-01-01\",\"2026-01-31\"),r(\"2025-01-01\",\"2025-01-31\")\nRESULT=f\"{(x-y)/y*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ca469cc6d8c0", "type": "percent", "answer": 5.96, "_code": "h=DuLieuBanHang[\"DanhSachHoaDon\"].copy(); h[\"od\"]=parse_date(h[\"Thời gian\"])\nh=h[~h[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả|cancel\",case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates(); c=c.assign(a=to_num(c[\"Thành tiền\"]))\nh[\"v\"]=h[\"Mã hóa đơn\"].map(c.groupby(\"Mã hóa đơn\").a.sum()).fillna(0)\nr=lambda s,e: h[(h.od>=s)&(h.od<=e)].v.sum()\nx,y=r(\"2026-05-01\",\"2026-05-31\"),r(\"2026-04-01\",\"2026-04-30\")\nRESULT=f\"{(x-y)/y*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9aba8eb100b3", "type": "number", "answer": 23548500, "_code": "import re as _re\ndef money(x):\n    s=str(x).strip().lower()\n    if s.startswith('-'): return -money(s[1:])\n    if s in ('','nan','none'): return float('nan')\n    m=_re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1_000_000+(int(f.ljust(3,'0')[:3])*1000 if f else 0)\n    m=_re.match(r'^(\\d+),(\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1_000_000)\n    m=_re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    s=_re.sub(r'[đd₫\\s]','',s)\n    if _re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if _re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\nd=don_hang.drop_duplicates().copy(); d['od']=parse_date(d['Ngày bán'])\nd=d[~d['Tình trạng đơn'].str.contains('cancel|returned|hủy|huỷ|trả',case=False)]\nc=chi_tiet_don.drop_duplicates().copy(); c['a']=c['Tiền bán'].map(money)\nd['v']=d['Số phiếu'].map(c.groupby('Số CT').a.sum()).fillna(0)\nRESULT=int(round(d[d.od=='2026-04-20'].v.sum()))+0*int(d.od.isna().sum()+c.a.isna().sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f063b216adce", "type": "percent", "answer": 51.87, "_code": "\nimport re\nX=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\nX['d']=parse_date(X['Giờ'])\nst=X['Ghi chú TT'].astype(str).str.lower()\nX=X[~st.str.contains('hủy|huỷ|cancel|trả')]\ndef pm(v):\n    s=str(v).strip().lower()\n    if s in('nan',''): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr'); val=int(re.sub(r'\\D','',a) or 0)*1_000_000+(int(re.sub(r'\\D','',b).ljust(3,'0')[:3])*1000 if re.sub(r'\\D','',b) else 0)\n    else: val=int(re.sub(r'\\D','',s) or 0)\n    return -val if neg else val\nX['amt']=X['Tiền'].map(pm)\nt=pd.Timestamp(as_of_date); a0=t.replace(day=1); p0=a0-pd.DateOffset(months=1); pe=min(p0+pd.Timedelta(days=t.day-1),a0-pd.Timedelta(days=1))\na=X[(X.d>=a0)&(X.d<=t)].amt.sum(); b=X[(X.d>=p0)&(X.d<=pe)].amt.sum()\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 2, "_verdict": "wrong"}
{"id": "q_f4c328691e9b", "type": "percent", "answer": -29.18, "_code": "\nimport re\nX=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\nX['d']=parse_date(X['Giờ'])\nst=X['Ghi chú TT'].astype(str).str.lower()\nX=X[~st.str.contains('hủy|huỷ|cancel|trả')]\ndef pm(v):\n    s=str(v).strip().lower()\n    if s in('nan',''): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr'); val=int(re.sub(r'\\D','',a) or 0)*1_000_000+(int(re.sub(r'\\D','',b).ljust(3,'0')[:3])*1000 if re.sub(r'\\D','',b) else 0)\n    else: val=int(re.sub(r'\\D','',s) or 0)\n    return -val if neg else val\nX['amt']=X['Tiền'].map(pm)\nt=pd.Timestamp(as_of_date); a0=t.replace(day=1); p0=a0-pd.DateOffset(months=1); pe=min(p0+pd.Timedelta(days=t.day-1),a0-pd.Timedelta(days=1))\na=X[(X.d>=a0)&(X.d<=t)].amt.sum(); b=X[(X.d>=p0)&(X.d<=pe)].amt.sum()\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 2, "_verdict": "wrong"}
{"id": "q_d1dbec9ade2e", "type": "percent", "answer": -40.0, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nd=So_chi_tiet_ban_hang__all.drop_duplicates().reset_index(drop=True)\nbo=set(d[d['Trạng thái'].str.contains('hủy|huỷ|trả|không giao',case=False,na=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bo)].copy()\nd['dt']=parse_date(d['Ngày'])\nd['q']=pd.to_numeric(d['Số lượng quy đổi'].astype(str).str.extract(r'(-?[\\d.]+)')[0])\n\nx=d[d['Tên hàng hóa'].str.contains('jotashield chống kiềm',case=False,na=False)&d['Tên hàng hóa'].str.contains('5L',na=False)]\nD=pd.Timestamp('2026-08-02')\na=x[(x.dt>=D)&(x.dt<D+pd.Timedelta(days=30))].q.sum()\nb=x[(x.dt>=D-pd.Timedelta(days=30))&(x.dt<D)].q.sum()\nRESULT=f\"{round((a/b-1)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2b49741de9fa", "type": "number", "answer": 2, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nd=So_chi_tiet_ban_hang__all.drop_duplicates().reset_index(drop=True)\nbo=set(d[d['Trạng thái'].str.contains('hủy|huỷ|trả|không giao',case=False,na=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bo)].copy()\nd['dt']=parse_date(d['Ngày'])\nd['q']=pd.to_numeric(d['Số lượng quy đổi'].astype(str).str.extract(r'(-?[\\d.]+)')[0])\n\ns,e=pd.Timestamp('2026-03-13'),pd.Timestamp('2026-03-19')\nbefore=set(d[d.dt<s]['Tên hàng hóa'])\ninp=set(d[(d.dt>=s)&(d.dt<=e)]['Tên hàng hóa'])\nRESULT=len(before-inp)\n", "_attempts": 1, "_verdict": "correct"}
