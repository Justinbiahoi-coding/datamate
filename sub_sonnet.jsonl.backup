{"id": "q_9c276b8f8ba6", "type": "number", "answer": 23, "_code": "t=BaoCaoTonKho\nRESULT=int(to_num(t[t['Tên hàng'].str.contains('Enterogermina',case=False)]['Tồn cuối kỳ']).iloc[0])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_717e5f91d40b", "type": "percent", "answer": 9.01, "_code": "import unicodedata,re\ndef nk(x):\n    x=unicodedata.normalize('NFD',str(x)).replace('đ','d').replace('Đ','D')\n    x=''.join(c for c in x if unicodedata.category(c)!='Mn').lower()\n    return re.sub(r'\\s+',' ',x).strip()\ns=Bao_cao_ban_hang__So_chi_tiet_ban_hang.drop_duplicates().copy()\ng=Bao_cao_ban_hang['Danh sách hàng hóa'].copy()\ng['k']=g['Tên hàng hóa'].map(nk); g=g[['k','Nhóm hàng hóa']].drop_duplicates('k')\ns['k']=s['Tên hàng hóa'].map(nk)\ns['d']=parse_date(s['Ngày'])\nbad=s[s['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao',case=False,na=False)]['Mã đơn hàng'].unique()\ns=s[~s['Mã đơn hàng'].isin(bad)&(s.d.dt.year==2026)&(s.d.dt.month==1)]\ns['amt']=to_num(s['Thành tiền'].astype(str).str.replace(r'\\.0+$','',regex=True))\ns=s.merge(g,on='k',how='left')\nRESULT=f\"{s[s['Nhóm hàng hóa']=='ống nước'].amt.sum()/s.amt.sum()*100:.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_c4f58d6b9d7d", "type": "percent", "answer": -8.64, "_code": "h=BanHang_HoaDon.drop_duplicates().copy(); h['d']=parse_date(h['Ngày bán'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\nc=BanHang_ChiTietHoaDon.drop_duplicates().copy(); c['v']=to_num(c['Thanh tien'])\nh['r']=h['Order ID'].map(c.groupby('Mã giao dịch')['v'].sum()).fillna(0)\ndef m(y,mo): return h[(h.d.dt.year==y)&(h.d.dt.month==mo)].r.sum()\nRESULT=f\"{round((m(2025,2)/m(2025,1)-1)*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1a44598908e9", "type": "percent", "answer": 1.16, "_code": "a=DonHang_ChiTiet.copy()\nfor c in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: a[c]=a[c].ffill()\na=a.drop_duplicates()\na['dt']=parse_date(a['Ngày đặt hàng'])\nm=a[(a.dt>='2026-08-01')&(a.dt<='2026-08-31')]\nc=m[m['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False,na=False)]['Mã đơn hàng'].nunique()\nRESULT=f\"{round(c/m['Mã đơn hàng'].nunique()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_23e155632945", "type": "percent", "answer": 9.56, "_code": "import re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=_re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f)*10**(6-len(f)) if f else 0)\n    m=_re.fullmatch(r'(\\d+),(\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s)\nd=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].copy().drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\nd['amt']=d['Thành tiền'].map(money)\na=d[(d.dt>='2026-05-01')&(d.dt<='2026-05-31')].amt.sum(); b=d[(d.dt>='2026-04-01')&(d.dt<='2026-04-30')].amt.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9e90e058913b", "type": "percent", "answer": 2.71, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\nh=BanHang_HoaDon.drop_duplicates().copy(); l=BanHang_ChiTietHoaDon.drop_duplicates().copy()\nprint(h['Trạng thái'].value_counts().to_dict())\nd=parse_date(h['Ngày bán'])\nok=~h['Trạng thái'].str.contains(BAD+'|Đổi trả',case=False,na=False)\nh=h[ok&(d>='2026-05-01')&(d<='2026-05-25')]\nl=l[l['Mã giao dịch'].isin(h['Order ID'])].copy()\nl['t']=l['Thanh tien'].map(money)\nrx=set(BanHang_Thuoc.loc[BanHang_Thuoc['Kê đơn'].astype(str).str.lower().isin(['true','1','1.0']),'Mã HH'])\nr=l[l['Ma hang'].isin(rx)]['t'].sum()\nRESULT=f\"{round(r/l['t'].sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_13bc9963d9e4", "type": "number", "answer": 31173200, "_code": "import re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=_re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f)*10**(6-len(f)) if f else 0)\n    m=_re.fullmatch(r'(\\d+),(\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s)\nd=So_chi_tiet_ban_hang__all.copy().drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\nd=d[d.dt==pd.Timestamp(as_of_date)]\nRESULT=int(round(d['Thành tiền'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1bab154ec708", "type": "number", "answer": 25120700, "_code": "import re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=_re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f)*10**(6-len(f)) if f else 0)\n    m=_re.fullmatch(r'(\\d+),(\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s)\nd=So_chi_tiet_ban_hang__all.copy().drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\nd=d[d.dt==pd.Timestamp(as_of_date)]\nRESULT=int(round(d['Thành tiền'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fb33573520e0", "type": "number", "answer": 80600000, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d+\\.\\d{1,2}',s) and False: v=float(s)\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\ndef qty(x):\n    if isinstance(x,(int,float)): return float(x)\n    return float(re.match(r'-?[\\d\\.]+',str(x).strip()).group(0))\ndf=SoBanHang__all.copy()\ndf['dt']=pd.to_datetime(df['Giờ'],errors='coerce')\ndf=df[df['dt'].notna()&df['Mã phiếu'].notna()].drop_duplicates()\ndf['q']=df['Số lượng hàng'].map(qty); df['v']=df['Tiền'].map(money)\nbad=df['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)|(df['q']<0)\nbadids=set(df.loc[bad,'Mã phiếu'])\nm=(df['dt']>='2025-08-01')&(df['dt']<'2025-09-01')&df['Tên SP'].str.lower().str.contains('weathershield powerflexx 5l')&~df['Mã phiếu'].isin(badids)\nRESULT=int(df.loc[m,'v'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3596852d6b89", "type": "percent", "answer": 48.28, "_code": "import unicodedata as u, re\ndef key(s): return re.sub(r'\\s+',' ',u.normalize('NFD',str(s).replace('đ','d').replace('Đ','D')).encode('ascii','ignore').decode().lower()).strip()\na=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\na['d']=pd.to_datetime(a['Giờ']).dt.normalize()\na['q']=pd.to_numeric(a['Số lượng hàng'].astype(str).str.extract(r'(-?\\d+[.,]?\\d*)')[0].str.replace(',','.'),errors='coerce')\nretord=set(a[a.q<0]['Mã phiếu'])|set(a[a['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã phiếu'])\no=a[~a['Mã phiếu'].isin(retord)].drop_duplicates('Mã phiếu')\no=o[(o.d>='2026-03-01')&(o.d<='2026-03-31')].copy()\no['k']=o['TenKH'].map(key)\no=o[~o.k.isin(['khach le','kl','le',''])]\nn=o.groupby('k')['Mã phiếu'].nunique()\nRESULT=f\"{round((n>=4).mean()*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f83527adf40d", "type": "number", "answer": 456, "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)[.,]?(\\d*)tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if c: return float(a)*1e6+float(c)*10**(6-len(c))\n        return float(a+'.'+(b or '0'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m:\n        t=m.group(1)\n        return float(t.replace('.','').replace(',',''))*1000 if re.search(r'[.,]\\d{3}$',t) else float(t.replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\nd=DanhSachHoaDon.copy(); d['dt']=pd.to_datetime(d['Thời gian tạo'].astype(str).str[:10],errors='coerce')\nok=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|Hoàn trả',case=False,na=False)&(d.dt>='2025-12-01')&(d.dt<='2025-12-31')]\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates()\nc['v']=c['Thành tiền'].apply(money)\ns=c[c['Mã hóa đơn'].isin(ok['Mã hóa đơn'])].groupby('Mã hóa đơn').v.sum()\nRESULT=int((s>=130000).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3020c306a884", "type": "number", "answer": 445, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d+\\.\\d{1,2}',s) and False: v=float(s)\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\ndef qty(x):\n    if isinstance(x,(int,float)): return float(x)\n    return float(re.match(r'-?[\\d\\.]+',str(x).strip()).group(0))\ndf=SoBanHang__all.copy()\ndf['dt']=pd.to_datetime(df['Giờ'],errors='coerce')\ndf=df[df['dt'].notna()&df['Mã phiếu'].notna()].drop_duplicates()\ndf['q']=df['Số lượng hàng'].map(qty); df['v']=df['Tiền'].map(money)\nbad=df['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)|(df['q']<0)\nbadids=set(df.loc[bad,'Mã phiếu'])\nf=df[~df['Mã phiếu'].isin(badids)]\no=f.groupby('Mã phiếu').agg(v=('v','sum'),dt=('dt','min'))\no=o[(o['dt']>='2025-03-01')&(o['dt']<'2025-04-01')]\nRESULT=int((o['v']>=590000).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_88c1a733dfd0", "type": "percent", "answer": -2.94, "_code": "a=SoBanHang__all.drop_duplicates().copy()\na['q']=pd.to_numeric(a['Số lượng hàng'].astype(str).str.extract(r'(-?\\d+\\.?\\d*)')[0],errors='coerce')\na['gio']=pd.to_datetime(a['Giờ'],errors='coerce'); a['d']=a.gio.dt.normalize()\nbad=a['Ghi chú TT'].str.contains('hủy|Hủy|trả',na=False)|(a.q<0)\na=a[~a['Mã phiếu'].isin(set(a.loc[bad,'Mã phiếu']))]\na['f']=a.DonVi.map({'tấn':20}).fillna(1)\ndef chg(name,D,N):\n    D=pd.Timestamp(D); x=a[a['Tên SP']==name]; x=x.assign(qq=x.q*x.f)\n    s=lambda s0,e0: x[(x.d>=s0)&(x.d<=e0)].qq.sum()\n    n=s(D,D+pd.Timedelta(days=N-1)); p=s(D-pd.Timedelta(days=N),D-pd.Timedelta(days=1))\n    return str(round((n-p)/p*100,2))+'%'\nRESULT=chg('Sơn Maxilite trong nhà 18L','2025-04-06',30)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c8a0338cf101", "type": "number", "answer": 210845600.0, "_code": "import re\ndef money(x):\n    x=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=x.startswith('-'); x=x.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) and len(m.group(2))<=3 else (int(m.group(2)) if m.group(2) else 0))\n    elif x.endswith('k'): v=float(x[:-1].replace(',','.'))*1000\n    else: v=float(re.sub(r'[.,]','',x)) if x else 0\n    return -v if neg else v\ns=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\ns['t']=pd.to_datetime(s['Giờ'],errors='coerce')\nbad=s[s['Status'].str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)|s['so_luong'].astype(str).str.startswith('-')]['Mã hóa đơn'].unique()\ns=s[~s['Mã hóa đơn'].isin(bad)]\ns=s[(s.t.dt.year==2025)&(s.t.dt.month==12)&(s.t.dt.hour>=6)&(s.t.dt.hour<=13)]\nRESULT=float(s['Trị giá'].map(money).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5b77fcbc3ef3", "type": "percent", "answer": -46.63, "_code": "a=SoBanHang__all.drop_duplicates().copy()\na['q']=pd.to_numeric(a['Số lượng hàng'].astype(str).str.extract(r'(-?\\d+\\.?\\d*)')[0],errors='coerce')\na['gio']=pd.to_datetime(a['Giờ'],errors='coerce'); a['d']=a.gio.dt.normalize()\nbad=a['Ghi chú TT'].str.contains('hủy|Hủy|trả',na=False)|(a.q<0)\na=a[~a['Mã phiếu'].isin(set(a.loc[bad,'Mã phiếu']))]\na['f']=a.DonVi.map({'tấn':20}).fillna(1)\ndef chg(name,D,N):\n    D=pd.Timestamp(D); x=a[a['Tên SP']==name]; x=x.assign(qq=x.q*x.f)\n    s=lambda s0,e0: x[(x.d>=s0)&(x.d<=e0)].qq.sum()\n    n=s(D,D+pd.Timedelta(days=N-1)); p=s(D-pd.Timedelta(days=N),D-pd.Timedelta(days=1))\n    return str(round((n-p)/p*100,2))+'%'\nRESULT=chg('Xi măng INSEE Power-S bao 50kg','2026-01-30',14)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bf8cd59968b5", "type": "number", "answer": 174, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\nh=DuLieuBanHang__DanhSachHoaDon.copy()\nok=~h['Trạng thái'].str.contains(BAD,case=False,na=False)\nt=h['Thời gian tạo']\nh=h[ok&(t>='2026-03-01')&(t<'2026-04-01')&h['Mã KH'].notna()]\nRESULT=int(h.groupby('Mã KH').size().ge(3).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_404a85139d1f", "type": "number", "answer": 25.0, "_code": "d=DonHang_ChiTiet__all.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[oc]=d[oc].ffill()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd=d[(d.dt>='2025-09-01')&(d.dt<='2025-09-30')&(d['Tên sản phẩm']=='Nếp cái hoa vàng')]\nq=d['Số lượng sản phẩm'].astype(str).str.extract(r'([\\d.,]+)')[0].str.replace(',','.').astype(float)\nRESULT=float(q.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_08c12a0fd506", "type": "number", "answer": 20, "_code": "d=don_hang.copy(); d['dt']=pd.to_datetime(d['ThoiGianLap'])\nd=d[(d.dt<'2025-06-24')&(d.TinhTrang!='cancelled')&(d.PhuongThucTT!='cod')&(d.KenhBanHang!='zalo_oa')]\nd=d[d.KenhBanHang.isin(['store','phone'])]\np=thanh_toan.copy(); p['t']=pd.to_datetime(p['NgayGioThu']); p=p[p.t<'2025-06-24']\npaid=p.groupby('MaHoaDon').SoTienThu.apply(lambda s: to_num(s).sum())\nd['debt']=to_num(d.TongThanhToan)-d.MaHoaDon.map(paid).fillna(0)\nx=d[(d.debt>0)&d.MaKhachHang.notna()]\nRESULT=int(x.MaKhachHang.nunique())\n", "_attempts": 1, "_verdict": "correct"}
