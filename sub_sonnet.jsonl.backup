{"id": "q_26ec390f37d7", "type": "number", "answer": 40, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\ndf=ban_hang.drop_duplicates().copy()\nd=parse_date(df['Ngày tháng'])\nbad=df['Kết quả'].str.contains(BAD,case=False,na=False)\nbadord=set(df.loc[bad,'Mã hóa đơn'])\nm=(d=='2025-08-25')&~df['Mã hóa đơn'].isin(badord)\nRESULT=int(df.loc[m,'Mã hóa đơn'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bb5c733e0607", "type": "number", "answer": 1015, "_code": "import unicodedata as _u\ng=[v for k,v in data.items() if 'giao' in _u.normalize('NFC',k) and '__' not in k][0].copy()\ng['d']=parse_date(g['Ngày giao hàng'])\ng=g[(g['d']>='2025-03-01')&(g['d']<='2025-03-31')]\nRESULT=int(g[['Mã đơn hàng','Lần giao']].drop_duplicates().shape[0])\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_abdcbcc29bef", "type": "percent", "answer": 1.79, "_code": "import unicodedata as _u\na=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).dropna(subset=['Mã đơn hàng']).drop_duplicates().copy()\na['d']=parse_date(a['Ngày'])\na['v']=to_num(a['Thành tiền'])\nbad=a['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)\n_g=[v for k,v in data.items() if _u.normalize('NFC',k).startswith('Danh s')][0]\n_m=dict(zip(_g['Tên hàng hóa'].str.strip().str.lower(),_g['Nhóm hàng hóa']))\na['g']=a['Tên hàng hóa'].str.strip().str.lower().map(_m)\ndef per(y,m): return a[(a.d.dt.year==y)&(a.d.dt.month==m)]\ndef cancel(y,m):\n    o=per(y,m).drop_duplicates('Mã đơn hàng')\n    return round(o['Trạng thái'].str.contains('hủy|huỷ',case=False).mean()*100,2)\nRESULT=f\"{cancel(2026,5)}%\"\n", "_attempts": 1, "_verdict": "correct"}
