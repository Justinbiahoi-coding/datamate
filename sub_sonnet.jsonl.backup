{"id": "q_4587f4162dc9", "type": "percent", "answer": 28.48, "_code": "h=BanHang_HoaDon.drop_duplicates().copy()\nh['d']=parse_date(h['Ngày bán'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao',case=False,na=False)]\ng=BanHang_LichSuGia[BanHang_LichSuGia['Sản phẩm'].str.contains('Prospan siro ho chai 100ml')].copy()\ng['p']=to_num(g['Giá mới']); g['n']=parse_date(g['Ngày áp dụng'])\nsku=g['Mã sản phẩm'].iloc[0]\nD=g[g.p==97500].sort_values('n')['n'].iloc[0]\nl=BanHang_ChiTietHoaDon.drop_duplicates()\nl=l[(l['Ma hang']==sku)].merge(h[['Order ID','d']],left_on='Mã giao dịch',right_on='Order ID')\nl['q']=to_num(l['SL cơ bản'])\na=l[(l.d>=D)&(l.d<=D+pd.Timedelta(days=29))].q.sum()\nb=l[(l.d>=D-pd.Timedelta(days=30))&(l.d<=D-pd.Timedelta(days=1))].q.sum()\nRESULT=f\"{round((a/30-b/30)/(b/30)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7428165a9e0a", "type": "number", "answer": 22740500, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=float('nan')\n    return -v if neg else v\n\no=don_hang.copy(); o['t']=parse_date(o['Ngày bán']).dt.normalize()\ny=pd.Timestamp(as_of_date)-pd.Timedelta(days=1)\no=o[(o.t==y)&~o['Tình trạng đơn'].isin(['cancelled','returned'])]\nc=chi_tiet_don.drop_duplicates(); c=c[c['Số CT'].isin(o['Số phiếu'])]\nRESULT=round(c['Tiền bán'].apply(money).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_72da5e92ba64", "type": "number", "answer": 28676, "_code": "n=DanhSachNhapHang.copy(); n['d']=parse_date(n['Thời gian'])\nn=n[~n['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)&(n.d>='2026-01-01')&(n.d<='2026-01-31')]\nc=DanhSachChiTietNhapHang.drop_duplicates()\nx=c[c['Mã hàng']=='SP0024'].merge(n[['Mã nhập hàng']],on='Mã nhập hàng')\nx=x.assign(q=to_num(x['Số lượng']),p=to_num(x['Đơn giá']))\nRESULT=int(round((x.q*x.p).sum()/x.q.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f4966c224caa", "type": "percent", "answer": 2.19, "_code": "a=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True)\na=a[a['Mã hóa đơn'].notna()].drop_duplicates()\na['d']=parse_date(a['Ngày giao dịch'])\na=a[(a.d>='2026-03-01')&(a.d<='2026-03-31')]\no=a.groupby('Mã hóa đơn')['Status'].first()\nRESULT=f\"{o.str.contains('hủy|huỷ',case=False).sum()/len(o)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_34b623c642d7", "type": "number", "answer": 1045637500, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+,\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    else: v=float(s.replace('.','')) if s else float('nan')\n    return -v if neg else v\n\nd=don_hang.drop_duplicates('Mã chứng từ').copy()\nd['dt']=pd.to_datetime(d['Ngày'],errors='coerce')\no=d[d['Tình trạng'].isin(['completed','shipping'])&(d.dt>='2025-12-01')&(d.dt<='2025-12-31')]['Mã chứng từ']\nc=chi_tiet_don.drop_duplicates(); c=c[c['Mã đơn hàng'].isin(o)]\nRESULT=int(round(c['Amount'].map(money).sum()))\n", "_attempts": 2, "_verdict": "correct"}
