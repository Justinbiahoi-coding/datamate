{"id": "q_2dc155c6526d", "type": "percent", "answer": -21.87, "_code": "d=DonHang_ChiTiet.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[oc]=d[oc].ffill()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nd=d.drop_duplicates()\np=d[d['Tên sản phẩm']=='Calcium Corbière Extra 10ml hộp 30 ống'].copy()\nq=DuLieuXuat['DanhSachQuyDoi']; r=q[q['Tên sản phẩm']=='Calcium Corbière Extra 10ml hộp 30 ống'].set_index('Đơn vị quy đổi')['Tỉ lệ quy đổi'].astype(float).to_dict()\np['q']=to_num(p['Số lượng sản phẩm'])*p['Đơn vị tính'].map(lambda u:r.get(u,1))\nD=pd.Timestamp('2026-05-11')\na=p[(p.dt>=D)&(p.dt<=D+pd.Timedelta(days=29))].q.sum(); b=p[(p.dt>=D-pd.Timedelta(days=30))&(p.dt<D)].q.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
