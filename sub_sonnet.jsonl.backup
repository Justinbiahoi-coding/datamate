{"id": "q_290162064477", "type": "percent", "answer": 1.78, "_code": "df = SoBanHang_1__all.copy()\ndf['d'] = parse_date(df['Ngày giao dịch'])\ndf['q'] = pd.to_numeric(df['so_luong'], errors='coerce')\nret = set(df.loc[df['Status'].astype(str).str.contains('trả|đổi', case=False, na=False) | (df['q']<0), 'Mã hóa đơn'])\ndf = df[(df['d']>='2025-02-01')&(df['d']<='2025-02-28')]\ncanc = df['Status'].astype(str).str.contains('hủy|huỷ|cancel', case=False, na=False)\n\nc = set(df.loc[canc,'Mã hóa đơn'])\nn = df['Mã hóa đơn'].nunique()\nRESULT = f'{round(len(c)/n*100,2):.2f}%'\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_cea5121dec72", "type": "date", "answer": "2025-09-06", "_code": "h = DanhSachHoaDon__all.copy(); h['d'] = parse_date(h['Thời gian'])\nh = h[h['d'].between('2025-09-01','2025-09-30') & ~h['Trạng thái'].str.contains('hủy|huỷ|trả', case=False, na=False)].copy()\nh['t'] = to_num(h['Tổng tiền hàng'])\nRESULT = h.groupby('d')['t'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0b6552ce1b0d", "type": "string", "answer": "Lâm Hoa Long", "_code": "def mny(s): return pd.to_numeric(s.astype(str).str.replace(r'[^\\d\\-]','',regex=True),errors='coerce')\no = pd.concat([DonHang_ChiTiet_1__all, DonHang_ChiTiet_2026__all], ignore_index=True)\nhc = ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\no[hc] = o[hc].ffill()\no['d'] = parse_date(o['Ngày đặt hàng'])\no['amt'] = mny(o['Tổng tiền']); o['q'] = to_num(o['Số lượng sản phẩm'])\nbad = set(o[o['Trạng thái đơn hàng'].isin(['Đã hủy','Đã hoàn hàng'])]['Mã đơn hàng'])\ng = o[~o['Mã đơn hàng'].isin(bad)]\nw = g[(g.d>='2025-03-17')&(g.d<='2025-03-23')].copy()\nw['kh'] = w['Tên khách hàng'].astype(str).map(normalize_text)\nod = w.groupby('Mã đơn hàng').agg(kh=('kh','first'), nm=('Tên khách hàng','first'), a=('amt','sum'))\nod = od[~od.kh.isin(['khach le','kl','le',''])]\nt = od.groupby('kh').agg(a=('a','sum'), nm=('nm','first')).sort_values('a', ascending=False)\nRESULT = t.iloc[0].nm\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4f5c7c1e024b", "type": "string", "answer": "Berberin 100mg Mekophar chai 100 viên", "_code": "def mny(s): return pd.to_numeric(s.astype(str).str.replace(r'[^\\d\\-]','',regex=True),errors='coerce')\no = pd.concat([DonHang_ChiTiet_1__all, DonHang_ChiTiet_2026__all], ignore_index=True)\nhc = ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\no[hc] = o[hc].ffill()\no['d'] = parse_date(o['Ngày đặt hàng'])\no['amt'] = mny(o['Tổng tiền']); o['q'] = to_num(o['Số lượng sản phẩm'])\nbad = set(o[o['Trạng thái đơn hàng'].isin(['Đã hủy','Đã hoàn hàng'])]['Mã đơn hàng'])\ng = o[~o['Mã đơn hàng'].isin(bad)]\nw = g[(g.d>='2026-01-01')&(g.d<='2026-01-31')].copy()\nk = DanhSachQuyDoi.set_index(['Tên sản phẩm','Đơn vị quy đổi'])['Tỉ lệ quy đổi']\nbase = DanhSachSanPham.set_index('Tên sản phẩm')['Đơn vị']\nw['f'] = [1 if u==base.get(p) else k.get((p,u),1) for p,u in zip(w['Tên sản phẩm'], w['Đơn vị tính'])]\nw['b'] = w.q*w.f\nRESULT = w.groupby('Tên sản phẩm').b.sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_83ddbda300ed", "type": "boolean", "answer": false, "_code": "d = DonHang_ChiTiet.copy()\noc = ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[oc] = d[oc].ffill()\nd['d'] = parse_date(d['Ngày đặt hàng'])\nd = d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả', case=False, na=False)].copy()\nd['t'] = to_num(d['Tổng tiền'])\nm = lambda y, mo: d[(d['d'].dt.year==y) & (d['d'].dt.month==mo)]['t'].sum()\ns, o, n = m(2025,9), m(2025,10), m(2025,11)\nRESULT = bool(o > s and n > o)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6b2ff40d8d4d", "type": "number", "answer": 24920000, "_code": "s = Bao_cao_ban_hang__So_chi_tiet_ban_hang.copy()\ns['d'] = parse_date(s['Ngày'])\ns['a'] = pd.to_numeric(s['Thành tiền'].astype(str).str.replace(',',''), errors='coerce')\nbad = set(s[s['Trạng thái'].isin(['khách hủy','trả hàng','Đã trả hàng'])]['Mã đơn hàng'])\nx = s[~s['Mã đơn hàng'].isin(bad) & (s.d>='2025-12-01') & (s.d<='2025-12-31') & (s['Tên hàng hóa'].str.lower()=='thép pomina d10 cây 11.7m')]\nRESULT = int(round(x.a.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_31c024e7b485", "type": "list", "answer": ["Tăng Lan Hạnh", "Đoàn Cường Thắng", "Hứa Bảo Hùng"], "_code": "def money(s):\n    s = str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    if s.endswith('tr'): return float(s[:-2].replace(',','.'))*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    return float(s.replace('.','').replace(',',''))\ndf = Bao_cao_ban_hang__So_chi_tiet_ban_hang.copy()\ndf['d'] = parse_date(df['Ngày'])\nbad = df['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả', case=False, na=False)\ndf = df[~df['Mã đơn hàng'].isin(set(df.loc[bad,'Mã đơn hàng']))]\ndf = df[(df['d']>='2026-03-01')&(df['d']<='2026-03-31')]\ndf['kh'] = df['Khách hàng'].astype(str).str.replace(r'\\s*-\\s*[\\d ]+$','',regex=True).str.replace(r'\\s+',' ',regex=True).str.strip()\ndf = df[~df['kh'].str.contains('lẻ', case=False)]\ndf['t'] = df['Thành tiền'].map(money)\ng = df.groupby('kh')['t'].sum().sort_values(ascending=False)\nRESULT = list(g.head(3).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8c1f4d9752c8", "type": "number", "answer": 54, "_code": "df = DonHang_ChiTiet__all.copy()\nhc = ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc] = df[hc].ffill()\ndf['d'] = parse_date(df['Ngày đặt hàng'])\ndf = df[(df['d']>='2025-08-01')&(df['d']<='2025-08-31')]\nc = df.loc[df['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|cancel', case=False, na=False),'Mã đơn hàng']\nRESULT = int(c.nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_20e776dd4755", "type": "list", "answer": [5, 13], "_code": "name = 'Telfast HD 180mg hộp 3 vỉ x 10 viên'\nsp = DanhSachSanPham; sku = sp.loc[sp['Tên sản phẩm']==name, 'Mã SKU'].iloc[0]\nqd = DanhSachQuyDoi[DanhSachQuyDoi['Tên sản phẩm']==name]\nct = DonNhapHang_ChiTiet[DonNhapHang_ChiTiet['Mã SKU']==sku]\nlots = set(ct['Mã lô'])\nnhap = to_num(ct['Số lượng nhập']).sum()\ndl = pd.concat([DonHang_Lo_1, DonHang_Lo_2], ignore_index=True)\ndl = dl[dl['Mã lô'].isin(lots)]\nhdr = DonHang_ChiTiet_1__all.copy(); hdr = pd.concat([hdr, DonHang_ChiTiet_2026__all], ignore_index=True)\nhdr[['Mã đơn hàng','Trạng thái đơn hàng','Ngày đặt hàng']] = hdr[['Mã đơn hàng','Trạng thái đơn hàng','Ngày đặt hàng']].ffill()\nhdr['d'] = parse_date(hdr['Ngày đặt hàng'])\nst = hdr.drop_duplicates('Mã đơn hàng').set_index('Mã đơn hàng')[['Trạng thái đơn hàng','d']]\ndl = dl.join(st, on='Mã đơn hàng')\ndl = dl[(dl['d'] <= as_of_date) & ~dl['Trạng thái đơn hàng'].str.contains('hủy|huỷ', case=False, na=False)]\nban = to_num(dl['Số lượng']).sum(); tra = to_num(dl['Số lượng trả']).sum()\ntot = int(nhap - ban + tra)\nf = int(to_num(qd['Tỉ lệ quy đổi']).max())  # largest unit (hộp) in base units\nRESULT = [tot // f, tot % f]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4cca5b4efafc", "type": "string", "answer": "Berberin 100mg Mekophar chai 100 viên", "_code": "cal = pd.read_csv('train/calendar.csv')\ncal['date'] = pd.to_datetime(cal['date'])\ns = cal[(cal.lunar_year==2025)&(cal.lunar_month==12)&(cal.lunar_day==23)&(~cal.lunar_leap.astype(str).str.lower().eq('true'))]['date'].iloc[0]\ne = cal[(cal.lunar_year==2026)&(cal.lunar_month==1)&(cal.lunar_day==10)&(~cal.lunar_leap.astype(str).str.lower().eq('true'))]['date'].iloc[0]\no = don_hang.copy()\no['d'] = parse_date(o['NgayLap'])\no = o[~o['TinhTrang'].astype(str).str.contains('cancel|return|refund', case=False)]\nret = set(tra_hang['MaHoaDon'])\no = o[~o['MaHoaDon'].isin(ret)]\no = o[(o['d']>=s)&(o['d']<=e)]\nl = chi_tiet_don[chi_tiet_don['MaHoaDon'].isin(o['MaHoaDon'])].copy()\nl['q'] = to_num(l['SLQuyDoi'])\ng = l.groupby('MaHangHoa')['q'].sum().reset_index().sort_values(['q','MaHangHoa'], ascending=[False,True])\ncode = g.iloc[0]['MaHangHoa']\nRESULT = san_pham.loc[san_pham['MaHangHoa']==code,'TenGoi'].iloc[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b3104dec243e", "type": "boolean", "answer": false, "_code": "d = don_hang.copy(); d['d'] = parse_date(d['NgayLap'])\nd = d[~d['TinhTrang'].isin(['cancelled','returned'])]\nc = chi_tiet_don.drop_duplicates(['MaHoaDon','SoThuTu']).copy(); c['t'] = to_num(c['TriGia'])\nc = c[c['MaHoaDon'].isin(d['MaHoaDon'])].merge(d[['MaHoaDon','d']], on='MaHoaDon')\nm = c.groupby(c['d'].dt.to_period('M'))['t'].sum()\na, b, e = m[pd.Period('2025-12')], m[pd.Period('2026-01')], m[pd.Period('2026-02')]\nRESULT = bool(b > a and e > b)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c0c508d7fdfd", "type": "string", "answer": "Cty Tăng Giang", "_code": "p = phieu_nhap[phieu_nhap['TinhTrang'] != 'cancelled'].copy(); p['d'] = parse_date(p['NgayNhapKho'])\np = p[p['d'].between('2025-09-01','2025-09-30')].copy(); p['t'] = to_num(p['TongGiaTriNhap'])\ntop = p.groupby('MaNhaCungCap')['t'].sum().idxmax()\nRESULT = nha_cung_cap.set_index('MaNhaCungCap').loc[top, 'TenGoi']\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_985f9fd07819", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Phạm Thảo Trang", 193500], ["Đoàn Thu Mai", 80600], ["Tô Chi Khoa", 56000], ["Chung Nam Bảo", 42200], ["Trịnh Quang Huy", 33900]]}, "_code": "d = don_hang.copy(); d['d'] = parse_date(d['NgayLap'])\nd = d[(d['d'] <= as_of_date) & (d['TinhTrang'] != 'cancelled') & (d['PhuongThucTT'] != 'cod') & (d['KenhBanHang'].isin(['store','phone','zalo_oa'])) & (d['MaKhachHang'].fillna('None') != 'None')]\nt = thanh_toan.copy(); t['t'] = parse_date(t['NgayGioThu']); t = t[t['t'] < pd.Timestamp(as_of_date) + pd.Timedelta(days=1)]\npaid = t.groupby('MaHoaDon')['SoTienThu'].apply(lambda s: to_num(s).sum())\nd['debt'] = to_num(d['TongThanhToan']) - d['MaHoaDon'].map(paid).fillna(0)\nd = d[d['debt'] > 0]\ng = d.groupby('MaKhachHang')['debt'].sum().sort_values(ascending=False).head(5)\nnm = khach_hang.set_index('MaKhachHang')['TenGoi']\nRESULT = {\"columns\": [\"khach_hang\", \"so_tien_no\"], \"rows\": [[nm[k], int(v)] for k, v in g.items()]}\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8423c5cc4a42", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Bạch Giang Sơn", 2309400], ["Tạ Hiếu Thu", 1025500], ["Doãn Tâm Nam", 901667]]}, "_code": "N=3\nh = DuLieuBanHang__DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nst = h['Trạng thái'].astype(str)\nh = h[~st.str.contains('hủy|huỷ|cancel', case=False, na=False)]\nh = h[h['Phương thức thanh toán']!='Thu hộ (COD)']\nh = h[h['Mã KH'].notna()]\nh['tot'] = to_num(h['Tổng sau giảm giá'])\nsq = DuLieuBanHang__SoQuy.copy()\nsq['v'] = sq['Giá trị'].astype(str).str.replace('đ','').str.replace('.','').astype(float)\nsq['t'] = parse_date(sq['Thời gian'])\nsq = sq[sq['t']<=pd.Timestamp(as_of_date)+pd.Timedelta(days=1)-pd.Timedelta(seconds=1)]\npaid = sq.groupby('Mã hóa đơn')['v'].sum()\nh['owe'] = h['tot'] - h['Mã hóa đơn'].map(paid).fillna(0)\nh = h[h['owe']>0]\ng = h.groupby('Mã KH')['owe'].sum().reset_index().sort_values(['owe','Mã KH'],ascending=[False,True]).head(N)\nk = DuLieuBanHang__DanhSachKhachHang.set_index('Mã khách hàng')['Tên khách hàng'].str.replace(r'\\s*-\\s*[\\d ]+$', '', regex=True)\nRESULT = {\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[k[r['Mã KH']], int(round(r['owe']))] for _,r in g.iterrows()]}\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3cc5b189bbd9", "type": "percent", "answer": 7.59, "_code": "dm = [v for k,v in data.items() if k.startswith('Danh') and not isinstance(v, dict)][0]\ns = So_chi_tiet_ban_hang__all.copy()\ns['d'] = parse_date(s['Ngày'])\ns['a'] = pd.to_numeric(s['Thành tiền'].astype(str).str.replace(',',''), errors='coerce')\nbad = set(s[s['Trạng thái'].isin(['hủy','Trả hàng','hàng trả về','Không giao được'])]['Mã đơn hàng'])\nx = s[~s['Mã đơn hàng'].isin(bad) & (s.d>='2026-05-01') & (s.d<='2026-05-31')].copy()\ngrp = {k.strip().lower(): v for k, v in zip(dm['Tên hàng hóa'], dm['Nhóm hàng hóa'])}\nx['g'] = x['Tên hàng hóa'].str.strip().str.lower().map(grp)\nRESULT = f\"{round(x[x.g=='xi măng'].a.sum()/x.a.sum()*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_1a11488ed8c6", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Phạm Phong Hoàng", 243000], ["Đàm Ngọc Trung", 210100], ["Kiều Trung Nam", 151600]]}, "_code": "d = BanHang_HoaDon.copy(); d['d'] = parse_date(d['Ngày bán'])\nd = d[(d['d'] <= as_of_date) & (d['Trạng thái'] != 'Không giao được') & ~d['Phương thức TT'].str.contains('COD', na=False) & d['Mã KH mua'].notna()]\nt = BanHang_PhieuThu.copy(); t['t'] = parse_date(t['Thời gian thu']); t = t[t['t'] < pd.Timestamp(as_of_date) + pd.Timedelta(days=1)]\npaid = t.groupby('Mã bill')['Số tiền thu'].apply(lambda s: to_num(s).sum())\nd['debt'] = to_num(d['Tong tien']) - d['Order ID'].map(paid).fillna(0)\nd = d[d['debt'] > 0]\ng = d.groupby('Mã KH mua')['debt'].sum().sort_values(ascending=False).head(3)\nnm = BanHang_KhachHang.set_index('Customer ID')['ten_kh']\nRESULT = {\"columns\": [\"khach_hang\", \"so_tien_no\"], \"rows\": [[nm[k], int(v)] for k, v in g.items()]}\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_533a10584189", "type": "date", "answer": "2026-06-07", "_code": "def pm(s):\n    s = str(s).strip()\n    if 'tr' in s: return float(s.replace('tr', '').replace(',', '.')) * 1e6\n    return float(s.replace('đ', '').replace('.', ''))\no = don_hang.copy(); o['d'] = parse_date(o['Ngày bán'])\no = o[o['d'].between('2026-06-01','2026-06-30') & ~o['Tình trạng đơn'].isin(['cancelled','returned'])]\nl = chi_tiet_don[chi_tiet_don['Số CT'].isin(o['Số phiếu'])].copy(); l['t'] = l['Tiền bán'].map(pm)\nl = l.merge(o[['Số phiếu','d']], left_on='Số CT', right_on='Số phiếu')\nRESULT = l.groupby('d')['t'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3d58d52f4443", "type": "list", "answer": ["Berberin 100mg Mekophar chai 100 viên", "Eugica hộp 10 vỉ x 10 viên nang", "Panadol 500mg hộp 10 vỉ x 12 viên", "Oresol 245 DHG hộp 20 gói", "Salonpas cao dán hộp 24 gói x 10 miếng"], "_code": "h = DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d'] = parse_date(h['Thời gian'])\nbad = h['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả', case=False, na=False)\nh = h[~bad & (h['d']>='2025-10-01') & (h['d']<='2025-10-31')]\nl = DanhSachHoaDonChiTiet.drop_duplicates(subset=['Mã hóa đơn','Mã hàng','Số lượng','Đơn giá','Giảm giá','Thành tiền','Số lượng quy đổi'])\nl = l[l['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nl['q'] = to_num(l['Số lượng quy đổi'])\ng = l.groupby('Mã hàng')['q'].sum().reset_index().sort_values(['q','Mã hàng'], ascending=[False,True]).head(5)\nnm = DanhSachSanPham.set_index('Mã hàng')['Tên hàng']\nRESULT = [nm[c] for c in g['Mã hàng']]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_dd898501d52f", "type": "date", "answer": "2025-01-05", "_code": "d = ban_hang.copy(); d['d'] = parse_date(d['Ngày bán'])\nd = d[d['d'].between('2025-01-01','2025-01-31')]\nbad = set(d.loc[d['Trạng thái xử lý'].str.contains('hủy|huỷ|trả', case=False, na=False), 'Số phiếu'])\nd = d[~d['Số phiếu'].isin(bad)].copy(); d['t'] = to_num(d['Amount'])\nRESULT = d.groupby('d')['t'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_73c0f26e96dc", "type": "list", "answer": ["Trương Dương Hằng", "Trịnh Khoa An", "Cao Loan Hiếu", "Đặng Thu Chi", "Vương Long Phúc"], "_code": "d = DonHang_ChiTiet__all.copy(); d['d'] = parse_date(d['Ngày đặt hàng'])\nd = d[d['d'].between('2025-12-01','2025-12-31') & ~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả', case=False, na=False)].copy()\nd['t'] = to_num(d['Tổng tiền']); d['k'] = d['Tên khách hàng'].str.strip().str.lower().str.replace(r'\\s+', ' ', regex=True)\nd = d[~d['k'].isin(['khách lẻ','kl','khach le','lẻ',''])]\ng = d.groupby('k')['t'].sum().sort_values(ascending=False).head(5)\ndisp = d.groupby('k')['Tên khách hàng'].agg(lambda s: s.str.strip().value_counts().index[0])\nRESULT = [disp[k] for k in g.index]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c8273e950235", "type": "boolean", "answer": false, "_code": "d = DonHang_ChiTiet__all.copy()\noc = ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[oc] = d[oc].ffill(); d['d'] = parse_date(d['Ngày đặt hàng'])\nd = d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả', case=False, na=False)].copy()\nd['t'] = to_num(d['Tổng tiền'])\nm = lambda y, mo: d[(d['d'].dt.year==y) & (d['d'].dt.month==mo)]['t'].sum()\ns, o, n = m(2025,9), m(2025,10), m(2025,11)\nRESULT = bool(o > s and n > o)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3de3612a7279", "type": "percent", "answer": -0.31, "_code": "def money(s):\n    s = str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    if s.endswith('tr'): return float(s[:-2].replace(',','.'))*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    return float(s.replace('.','').replace(',',''))\nh = DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d'] = parse_date(h['Thời gian'])\nbad = h['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả', case=False, na=False)\nh = h[~bad]\nl = DanhSachHoaDonChiTiet.drop_duplicates(subset=['Mã hóa đơn','Mã hàng','Số lượng','Đơn giá','Giảm giá','Thành tiền'])\nl = l.merge(h[['Mã hóa đơn','d']], on='Mã hóa đơn')\nl['t'] = l['Thành tiền'].map(money)\nr = l.groupby(l['d'].dt.to_period('M').astype(str))['t'].sum()\nRESULT = f\"{round((r['2025-08']-r['2025-07'])/r['2025-07']*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_228efd786818", "type": "list", "answer": [6739400, 149738300], "_code": "def mny(s): return pd.to_numeric(s.astype(str).str.replace(r'[^\\d\\-]','',regex=True),errors='coerce')\nh = don_hang.copy(); h['d'] = pd.to_datetime(h['ThoiGianLap']).dt.normalize()\nrr = set(chi_tiet_don_lo[to_num(chi_tiet_don_lo.SLTraQuyDoi)>0].MaHoaDon)\nh = h[~h.MaHoaDon.isin(rr) & h.TinhTrang.isin(['completed','shipping']) & (h.d>='2026-06-01') & (h.d<='2026-06-28')]\nl = chi_tiet_don.drop_duplicates(['MaHoaDon','SoThuTu']).copy(); l['a'] = mny(l['TriGia'])\ns = l.groupby('MaHoaDon').a.sum()\nh['rev'] = h.MaHoaDon.map(s).fillna(0)\nt = h.groupby('KenhBanHang').rev.sum()\nRESULT = [int(t.get('phone',0)), int(t.get('store',0))]\n", "_attempts": 3, "_verdict": "correct"}
{"id": "q_e15496dc385c", "type": "number", "answer": 1, "_code": "df = So_chi_tiet_ban_hang__all.copy()\ndf['d'] = parse_date(df['Ngày'])\nbad = df['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả|Không giao được', case=False, na=False)\ndf = df[~df['Mã đơn hàng'].isin(set(df.loc[bad,'Mã đơn hàng']))]\ndf['n'] = df['Tên hàng hóa'].astype(str).str.replace(r'\\s+',' ',regex=True).str.strip().str.lower()\ntoday = pd.Timestamp(as_of_date)\nstart = today - pd.Timedelta(days=13)\nbefore = set(df.loc[df['d']<start,'n'])\ninper = set(df.loc[(df['d']>=start)&(df['d']<=today),'n'])\nRESULT = len(before - inper)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_eabd0d408998", "type": "boolean", "answer": false, "_code": "import re\ndef money(s):\n    s = str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    m = re.fullmatch(r'(\\d+)tr(\\d*)', s)\n    if m: return int(m.group(1))*1e6 + (int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    if s.endswith('tr'): return float(s[:-2].replace(',','.'))*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    return float(s.replace('.','').replace(',',''))\ntot = {}\nfor sh, d in SoBanHang.items():\n    d = d.copy()\n    bad = d['Ghi chú TT'].astype(str).str.contains('hủy|huỷ|cancel|trả', case=False, na=False)\n    d = d[~d['Mã phiếu'].isin(set(d.loc[bad,'Mã phiếu']))]\n    tot[sh] = d['Tiền'].map(money).sum()\nv = [tot['Tháng 04-2025'], tot['Tháng 05-2025'], tot['Tháng 06-2025']]\nRESULT = bool(v[0] < v[1] < v[2])\n", "_attempts": 1, "_verdict": "correct"}
