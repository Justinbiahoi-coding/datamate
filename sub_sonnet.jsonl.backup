{"id": "q_cec26efee6e1", "type": "percent", "answer": 10.44, "_code": "h=DanhSachHoaDon__all.copy()\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh['d']=parse_date(h['Thời gian'])\nh=h[(h.d>='2025-11-01')&(h.d<='2025-11-30')]\nc=DanhSachHoaDonChiTiet[DanhSachHoaDonChiTiet['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['amt']=to_num(c['Thành tiền'])\ng=DanhSachSanPham.set_index('Mã hàng')['Nhóm hàng(3 Cấp)']\nc['g']=c['Mã hàng'].map(g)\nRESULT=f\"{c[c.g=='tiêu hoá'].amt.sum()/c.amt.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0bfcbccec99e", "type": "number", "answer": 588.0, "_code": "d=don_hang.copy(); d['dt']=pd.to_datetime(d['ThoiGianLap'].astype(str).str[:10],errors='coerce')\nok=d[(d.dt>='2025-01-01')&(d.dt<='2025-01-31')&d.TinhTrang.isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates()\nc=c[c.MaHoaDon.isin(ok.MaHoaDon)&(c.MaHangHoa=='SP0030')]\nRESULT=float(pd.to_numeric(c.SLQuyDoi).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e311e396f7f0", "type": "number", "answer": 1098707000, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        a,b=m.groups(); return int(a)*1000000+(int(b)*10**(6-len(b)) if b else 0)\n    m=re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return int(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\no=don_hang.drop_duplicates().copy()\no['d']=pd.to_datetime(o['Ngày'])\no=o[(o['d']>='2026-03-01')&(o['d']<='2026-03-31')&~o['Tình trạng'].isin(['cancelled','returned'])]\nc=chi_tiet_don.drop_duplicates()\nc=c[c['Mã đơn hàng'].isin(o['Mã chứng từ'])].copy()\nc['a']=c['Amount'].map(money)\nRESULT=int(c['a'].sum())\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_0fdc6b9fe092", "type": "number", "answer": 141335800.0, "_code": "o=DanhSachHoaDon__all.drop_duplicates().copy()\no['d']=parse_date(o['Thời gian'])\no=o[(o.d.dt.year==2025)&(o.d.dt.month==6)]\no=o[~o['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(o['Mã hóa đơn'])]\nRESULT=float(to_num(c['Thành tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_87a31a45e707", "type": "number", "answer": 1968000.0, "_code": "df=DonHang_ChiTiet.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[oc]=df[oc].ffill()\nd=parse_date(df['Ngày đặt hàng'])\nm=(d>='2025-12-01')&(d<='2025-12-31')&df['Tên sản phẩm'].str.lower().str.strip().eq('sinh tố xoài (l)')\nm&=~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả|cancel',case=False,na=False)\nRESULT=float(to_num(df.loc[m,'Tổng tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_09581d4bcf0b", "type": "percent", "answer": -1.42, "_code": "a=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na['v']=to_num(a['Thành tiền'])\nbad=a['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)\nbadids=set(a.loc[bad,'Mã đơn hàng'])\ng=a[~a['Mã đơn hàng'].isin(badids)]\ncur=g[(g.dt>='2026-09-01')&(g.dt<='2026-09-07')].v.sum()\nprev=g[(g.dt>='2026-08-01')&(g.dt<='2026-08-07')].v.sum()\nRESULT=f\"{round((cur-prev)/prev*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
