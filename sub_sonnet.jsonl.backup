{"id": "q_81d7cbe97bd2", "type": "date", "answer": "2025-06-30", "_code": "import re\ndef m1(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr',1)\n        if re.search(r'[,\\.]',a): return float(a.replace(',','.'))*1000000\n        return int(a or 0)*1000000+(int(b.ljust(3,'0'))*1000 if b else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    neg=s.startswith('-')\n    v=float(re.sub(r'[^\\d]','',s) or 0)\n    return -v if neg else v\no=don_hang[don_hang.TinhTrang.isin(['completed','shipping'])].copy()\no['d']=pd.to_datetime(o['ThoiGianLap'].astype(str).str[:10])\no=o[(o.d.dt.year==2025)&(o.d.dt.month==6)]\nc=chi_tiet_don.drop_duplicates().copy(); c['amt']=c['TriGia'].map(m1)\nc=c.merge(o[['MaHoaDon','d']],on='MaHoaDon')\nRESULT=c.groupby('d')['amt'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3fc9d7922b49", "type": "number", "answer": 3046, "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=DonHang_ChiTiet.copy()\noc=[c for c in df.columns if df[c].isna().mean()>0.3 and c!='Tổng tiền']\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\nst=df['Trạng thái đơn hàng'].astype(str).str.lower()\nbad=set(df.loc[st.str.contains('hủy|huỷ|hoàn hàng|trả'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf['d']=parse_date(df['Ngày đặt hàng']); df['q']=df['Số lượng sản phẩm'].map(m)\nw=df[(df.d>='2025-06-01')&(df.d<'2025-07-01')]\nw=w[w['Tên sản phẩm'].astype(str).str.strip().str.lower().str.endswith('(m)')]\nRESULT=int(round(w.q.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_69bba357a993", "type": "date", "answer": "2025-12-20", "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\nh=DanhSachHoaDon.copy().drop_duplicates('Mã hóa đơn')\nst=h['Trạng thái'].astype(str).str.lower()\nh=h[~st.str.contains('hủy|huỷ|trả')]\nh['d']=parse_date(h['Thời gian'])\nc=DanhSachHoaDonChiTiet.copy().drop_duplicates()\nc['a']=c['Thành tiền'].map(m)\nc=c.merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\nw=c[(c.d>='2025-12-01')&(c.d<'2026-01-01')]\nRESULT=str(w.groupby('d').a.sum().idxmax().date())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7ccaa782c3f1", "type": "string", "answer": "Trương Thảo Long", "_code": "h=DuLieuBanHang['DanhSachHoaDon'].copy(); h['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)&h['Mã KH'].notna()]\nh=h[(h.dt>='2025-04-01')&(h.dt<='2025-04-30')].drop_duplicates('Mã hóa đơn')\ng=h.groupby('Mã KH').size().reset_index(name='n').sort_values(['n','Mã KH'],ascending=[False,True])\ntop=g['Mã KH'].iloc[0]\nRESULT=h[h['Mã KH']==top]['Khách hàng'].iloc[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d4fed702bcdd", "type": "number", "answer": 367, "_code": "import re\ndef pm(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,'0')[:3])*1000 if f else 0) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'(\\d+[.,]\\d+)\\s*(?:tr|triệu)',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1e6)\n    m=re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+\\.\\d+',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    if re.fullmatch(r'\\d+[.,]\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\nh=DuLieuBanHang['DanhSachHoaDon'].copy(); h['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh=h[(h.dt>='2025-09-01')&(h.dt<='2025-09-30')].drop_duplicates('Mã hóa đơn')\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['t']=c['Thành tiền'].apply(pm)\nRESULT=int((c.groupby('Mã hóa đơn').t.sum()>=180000).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bf4b4edb1f1f", "type": "string", "answer": "Phùng Thu Trang", "_code": "import re\ndef m1(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr',1)\n        if re.search(r'[,\\.]',a): return float(a.replace(',','.'))*1000000\n        return int(a or 0)*1000000+(int(b.ljust(3,'0'))*1000 if b else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    neg=s.startswith('-')\n    v=float(re.sub(r'[^\\d]','',s) or 0)\n    return -v if neg else v\no=don_hang[don_hang.TinhTrang.isin(['completed','shipping'])].copy()\no['d']=pd.to_datetime(o['ThoiGianLap'].astype(str).str[:10])\no=o[(o.d.dt.year==2025)&(o.d.dt.month==1)]\nc=chi_tiet_don.drop_duplicates().copy(); c['amt']=c['TriGia'].map(m1)\nc=c.merge(o[['MaHoaDon','MaNhanVien']],on='MaHoaDon')\nt=c.groupby('MaNhanVien')['amt'].sum().idxmax()\nRESULT=nhan_vien.set_index('MaNhanVien').loc[t,'TenGoi']\n", "_attempts": 1, "_verdict": "correct"}
