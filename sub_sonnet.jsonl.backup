{"id": "q_0c20dcf7fc9f", "type": "date", "answer": "2025-12-07", "_code": "h=don_hang[don_hang['Tình trạng'].isin(['completed','shipping'])].copy()\nh['dt']=pd.to_datetime(h['Ngày'])\nc=chi_tiet_don.drop_duplicates().copy()\nc['a']=pd.to_numeric(c['Amount'].astype(str).str.replace(r'\\D','',regex=True))\nt=c.groupby('Mã đơn hàng').a.sum().rename('tt')\nh=h.join(t,on='Mã chứng từ')\nx=h[(h.dt>='2025-12-01')&(h.dt<='2025-12-31')].groupby('dt').tt.sum()\nRESULT=x.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a7563e07926b", "type": "list", "answer": [101539122, 390803131], "_code": "h=don_hang[don_hang['Tình trạng'].isin(['completed','shipping'])].copy()\nh['dt']=pd.to_datetime(h['Ngày'])\nc=chi_tiet_don.drop_duplicates().copy()\nc['a']=pd.to_numeric(c['Amount'].astype(str).str.replace(r'\\D','',regex=True))\nt=c.groupby('Mã đơn hàng').a.sum().rename('tt')\nh=h.join(t,on='Mã chứng từ')\nm=h[(h.dt>='2025-03-01')&(h.dt<='2025-03-31')].groupby('Trả bằng').tt.sum()\nRESULT=[int(m['ewallet']),int(m['transfer'])]\n", "_attempts": 1, "_verdict": "wrong"}
{"id": "q_a62c4bac18ba", "type": "list", "answer": ["Xi măng Hà Tiên PCB40 bao 50kg", "Xi măng INSEE Power-S bao 50kg", "Gạch ống 8x8x18 Tuynel"], "_code": "\nd=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nhh=Bao_cao_ban_hang['Danh sách hàng hóa']\nd['dt']=parse_date(d['Ngày']); d['q']=to_num(d['Số lượng quy đổi'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\n\nm=d[(d.dt>='2026-03-01')&(d.dt<='2026-03-31')]\ns=m.groupby('Tên hàng hóa')['q'].sum().reset_index().sort_values(['q','Tên hàng hóa'],ascending=[False,True])\nRESULT=s['Tên hàng hóa'].head(3).tolist()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4028a7af692a", "type": "number", "answer": 13, "_code": "\nd=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nhh=Bao_cao_ban_hang['Danh sách hàng hóa']\nd['dt']=parse_date(d['Ngày']); d['q']=to_num(d['Số lượng quy đổi'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\n\nbn=set(hh[hh['Đơn vị tính']=='bình']['Tên hàng hóa'])\nm=d[(d.dt==pd.Timestamp(as_of_date)-pd.Timedelta(days=1))&d['Tên hàng hóa'].isin(bn)]\nRESULT=int(m['q'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5b695ab6bfde", "type": "list", "answer": ["Đàm Hà Duy", "La Sơn Lan", "Từ Giang Hiếu"], "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^(\\d+)[,.](\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    m=re.match(r'^[\\d,]+\\.\\d{4}$',s)       # 1,500.0000\n    if m: return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\nh=DanhSachHoaDon__all.drop_duplicates().copy(); h['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.lower().isin(['huỷ đơn','hủy đơn','trả hàng','đã trả hàng'])]\nh=h[h['Mã KH'].notna()]\nl=DanhSachHoaDonChiTiet.drop_duplicates().copy(); l['tt']=l['Thành tiền'].map(money)\nl=l.merge(h[['Mã hóa đơn','d','Mã KH']],on='Mã hóa đơn')\nx=l[(l.d>='2026-01-01')&(l.d<'2026-02-01')]\ns=x.groupby('Mã KH')['tt'].sum().reset_index().sort_values(['tt','Mã KH'],ascending=[False,True]).head(3)\nnm=DanhSachKhachHang.set_index('Mã khách hàng')['Tên khách hàng']\nimport re\nRESULT=[re.sub(r'\\s*([-(]\\s*)?[\\d ]{8,}\\)?\\s*$','',nm[k]).strip() for k in s['Mã KH']]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_556e98bb4ca9", "type": "list", "answer": [77000, 25766], "_code": "h=DuLieuBanHang__DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nst=h['Trạng thái'].map(normalize_text)\nh=h[~st.str.contains('huy')]\nh=h[(h['Phương thức thanh toán']=='Ghi nợ')&(h['Mã KH']=='KH0239')]\nh['tot']=to_num(h['Tổng sau giảm giá'])\nsq=DuLieuBanHang__SoQuy.copy()\nsq['pd']=parse_date(sq['Thời gian']); sq['v']=to_num(sq['Giá trị'])\nsq=sq.merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\npaid_same=sq[sq.pd.dt.normalize()==sq.d].groupby('Mã hóa đơn').v.sum()\ninp=h[(h.d>='2026-08-01')&(h.d<='2026-08-05')]\nno=(inp.tot-inp['Mã hóa đơn'].map(paid_same).fillna(0)).sum()\ntra=sq[(sq.pd.dt.normalize()>sq.d)&(sq.pd>='2026-08-01')&(sq.pd<'2026-08-06')].v.sum()\nRESULT=[int(no),int(tra)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_abc07027827a", "type": "date", "answer": "2025-06-28", "_code": "import re\ndef pm(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)(?:,(\\d+))?tr(\\d+)?',s)\n    if m:\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0')[:3])*1e3\n        else: a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        return -a if neg else a\n    m=re.fullmatch(r'(\\d+(?:,\\d+)?)k',s)\n    if m: v=float(m.group(1).replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except Exception: return float('nan')\n    return -v if neg else v\nd=DonHang_ChiTiet__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['amt']=d['Tổng tiền'].map(pm)\nd=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nm=d[(d.dt.dt.year==2025)&(d.dt.dt.month==6)]\nRESULT=str(m.groupby(m.dt.dt.date)['amt'].sum().idxmax())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_dcfec6518c19", "type": "number", "answer": 1, "_code": "import re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    if not s: return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    m=re.fullmatch(r'([\\d.,]+)tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d+,\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\n\ndf=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày']); df['n']=df['Tên hàng hóa'].map(normalize_text)\nbad=df[df['Trạng thái'].isin(['Trả hàng','hàng trả về','hủy','Không giao được'])]['Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\nbefore=set(df[df.d<'2025-09-06'].n)\ninp=set(df[(df.d>='2025-09-06')&(df.d<='2025-09-19')].n)\nRESULT=len(before-inp)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4ae38cbb16eb", "type": "percent", "answer": 3.26, "_code": "\no=don_hang[don_hang.TinhTrang.isin(['completed','shipping'])].copy(); o['d']=pd.to_datetime(o['ThoiGianLap'].str[:10])\no=o[(o.d>='2025-04-01')&(o.d<='2025-04-30')]\nc=chi_tiet_don.drop_duplicates().merge(o[['MaHoaDon']],on='MaHoaDon')\nrx=set(thong_tin_thuoc[thong_tin_thuoc.BanTheoDon.astype(str).isin(['1','True','TRUE'])].MaHangHoa)\nRESULT=f\"{round(c[c.MaHangHoa.isin(rx)].TriGia.sum()/c.TriGia.sum()*100,2)}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_0c20dcf7fc9f", "type": "date", "answer": "2025-12-07", "_code": "import re\ndef money(x):\n    x=str(x).strip()\n    m=re.match(r'^(\\d+)tr(\\d*)$',x)\n    if m:\n        return int(m.group(1))*1000000+(int(m.group(2).ljust(3,'0')) if m.group(2) else 0)*1000\n    return int(re.sub(r'\\D','',x))\nh=don_hang[don_hang['Tình trạng'].isin(['completed','shipping'])].copy()\nh['dt']=pd.to_datetime(h['Ngày'])\nc=chi_tiet_don.drop_duplicates().copy()\nc['a']=c['Amount'].map(money)\nt=c.groupby('Mã đơn hàng').a.sum().rename('tt')\nh=h.join(t,on='Mã chứng từ')\nx=h[(h.dt>='2025-12-01')&(h.dt<='2025-12-31')].groupby('dt').tt.sum()\nRESULT=x.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 2, "_verdict": "x"}
{"id": "q_a7563e07926b", "type": "list", "answer": [106656000, 420904000], "_code": "import re\ndef money(x):\n    x=str(x).strip()\n    m=re.match(r'^(\\d+)tr(\\d*)$',x)\n    if m:\n        return int(m.group(1))*1000000+(int(m.group(2).ljust(3,'0')) if m.group(2) else 0)*1000\n    return int(re.sub(r'\\D','',x))\nh=don_hang[don_hang['Tình trạng'].isin(['completed','shipping'])].copy()\nh['dt']=pd.to_datetime(h['Ngày'])\nc=chi_tiet_don.drop_duplicates().copy()\nc['a']=c['Amount'].map(money)\nt=c.groupby('Mã đơn hàng').a.sum().rename('tt')\nh=h.join(t,on='Mã chứng từ')\nm=h[(h.dt>='2025-03-01')&(h.dt<='2025-03-31')].groupby('Trả bằng').tt.sum()\nRESULT=[int(m['ewallet']),int(m['transfer'])]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_5f5c3b11314d", "type": "percent", "answer": -14.45, "_code": "import re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    if not s: return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    m=re.fullmatch(r'([\\d.,]+)tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d+,\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\n\ncal=pd.read_csv('train/calendar.csv'); cal['d']=pd.to_datetime(cal.date)\ndef tet(y):\n    s=cal[(cal.lunar_year==y-1)&(cal.lunar_month==12)&(cal.lunar_day==23)&(~cal.lunar_leap)].d.iloc[0]\n    e=cal[(cal.lunar_year==y)&(cal.lunar_month==1)&(cal.lunar_day==10)&(~cal.lunar_leap)].d.iloc[0]\n    return s,e\no=don_hang.copy(); o['d']=pd.to_datetime(o.ThoiGianLap).dt.normalize()\no=o[o.TinhTrang.isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().merge(o[['MaHoaDon','d']],on='MaHoaDon'); c['v']=to_num(c.TriGia)\ndef rev(y):\n    s,e=tet(y); return c[(c.d>=s)&(c.d<=e)].v.sum()\na,b=rev(2026),rev(2025)\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_403e5bbd7568", "type": "number", "answer": 71, "_code": "\nt=ton_kho\nr=t[t['Hàng hóa'].apply(vn_normalize)==vn_normalize('Siro ăn ngon Ích Nhi Plus chai 100ml')]\nRESULT=int(to_num(r['Ton kho']).iloc[0])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_770835759e9e", "type": "list", "answer": ["Panadol 500mg hộp 10 vỉ x 12 viên", "Berberin 100mg Mekophar chai 100 viên", "Hapacol 250 hộp 24 gói", "Panadol Extra hộp 15 vỉ x 12 viên", "Khẩu trang y tế 4 lớp Khánh An hộp 50 cái"], "_code": "\nh=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh['dt']=parse_date(h['Ngày bán'])\nh=h[~h['Trạng thái'].isin(['Không giao được','Đổi trả'])]\nc=BanHang_ChiTietHoaDon.drop_duplicates().merge(h[['Order ID','dt']],left_on='Mã giao dịch',right_on='Order ID')\nc['q']=to_num(c['SL cơ bản'])\nw=pd.Timestamp(as_of_date); s=w-pd.Timedelta(days=w.weekday()+7); e=s+pd.Timedelta(days=6)\nm=c[(c.dt>=s)&(c.dt<=e)]\nnm=dict(zip(BanHang_HangHoa['ma_sp'],BanHang_HangHoa['Món']))\ng=m.groupby('Ma hang')['q'].sum().reset_index(); g['n']=g['Ma hang'].map(nm)\ng=g.sort_values(['q','Ma hang'],ascending=[False,True])\nRESULT=g['n'].head(5).tolist()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4f2f6570ecfc", "type": "percent", "answer": 0.93, "_code": "\nh=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh['dt']=parse_date(h['Ngày bán'])\nm=h[(h.dt>='2026-01-01')&(h.dt<='2026-01-31')]\nRESULT=f\"{(m['Trạng thái']=='Không giao được').mean()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
