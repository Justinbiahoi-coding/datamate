{"id": "q_40995ec33f88", "type": "list", "answer": [158241500, 173866200, 156289700], "_code": "a=DonHang_ChiTiet__all.copy()\nfor c in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: a[c]=a[c].ffill()\na=a.drop_duplicates()\na['d']=parse_date(a['Ngày đặt hàng']); a['v']=to_num(a['Tổng tiền'])\na['bad']=a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả',case=False)\nok=a[~a.bad]\nRESULT=[int(round(ok[(ok.d>=s)&(ok.d<=e)].v.sum())) for s,e in [('2025-09-01','2025-09-30'),('2025-10-01','2025-10-31'),('2025-11-01','2025-11-30')]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_435acb306c2e", "type": "percent", "answer": 129.11, "_code": "h=BanHang_HoaDon.copy()\nh['od']=pd.to_datetime(h['Giờ tạo đơn']).dt.normalize()\nh['bad']=h['Trạng thái'].str.contains('Không giao được|Đổi trả|hủy|huỷ|trả',case=False)\nc=BanHang_ChiTietHoaDon.drop_duplicates().copy()\nc['a']=to_num(c['Thanh tien']); c['q']=to_num(c['SL cơ bản'])\nc=c.merge(h[['Order ID','od','bad','Tên KH','Mã KH mua']],left_on='Mã giao dịch',right_on='Order ID')\nok=c[~c.bad]\nD=pd.Timestamp(parse_date(BanHang_LichSuGia[BanHang_LichSuGia['Giá mới'].astype(str).str.strip()=='3600']['Ngày áp dụng']).iloc[0])\np=ok[ok['Ma hang']=='SP0018']\nn=p[(p.od>=D)&(p.od<=D+pd.Timedelta(days=29))].q.sum(); o=p[(p.od>=D-pd.Timedelta(days=30))&(p.od<D)].q.sum()\nRESULT=f\"{round((n-o)/o*100,2)}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_0db8d6ef55e9", "type": "date", "answer": "2025-05-11", "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if not s: return float('nan')\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        a,b=m.groups()\n        if b: return int(_re.sub(r'[.,]','',a))*1e6+int(b.ljust(3,'0'))*1000\n        return float(a.replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\na=SoBanHang__all.copy(); a=a[a['Mã phiếu'].notna()].drop_duplicates()\na['d']=pd.to_datetime(a['Giờ']).dt.normalize(); a['v']=a['Tiền'].map(money)\nbad=a.groupby('Mã phiếu')['Ghi chú TT'].apply(lambda s:s.str.contains('hủy|huỷ|trả',case=False).any())\nok=a[~a['Mã phiếu'].map(bad)]\nm=ok[(ok.d>='2025-05-01')&(ok.d<='2025-05-31')]\nRESULT=m.groupby('d').v.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e516237d5157", "type": "number", "answer": 1266210000, "_code": "a=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).dropna(subset=['Mã đơn hàng']).drop_duplicates()\na['d']=parse_date(a['Ngày']); a['v']=to_num(a['Thành tiền'])\nbad=a.groupby('Mã đơn hàng')['Trạng thái'].apply(lambda s:s.str.contains('hủy|huỷ|trả',case=False).any())\nok=a[~a['Mã đơn hàng'].map(bad)]\nRESULT=int(round(ok[(ok.d>='2025-04-01')&(ok.d<='2025-04-30')].v.sum()))\n", "_attempts": 2, "_verdict": "correct"}
