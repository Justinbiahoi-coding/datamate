{"id": "q_97b86931a635", "type": "number", "answer": 2502, "_code": "\nHG=[v for k,v in data.items() if k.startswith('Danh')][0]\ncanon={normalize_text(n):n for n in HG['Tên hàng hóa']}\na=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates()\nbad=set(a[a['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|hoàn trả',case=False,na=False)]['Mã đơn hàng'])\na=a[~a['Mã đơn hàng'].isin(bad)].copy()\na['dt']=parse_date(a['Ngày'])\na['q']=pd.to_numeric(a['Số lượng quy đổi'].astype(str).str.extract(r'(-?[\\d.]+)')[0])\na['n']=a['Tên hàng hóa'].map(lambda s: canon.get(normalize_text(s),s))\n\nx=a[(a.dt>='2026-04-01')&(a.dt<='2026-04-30')&a['n'].str.strip().str.lower().str.endswith('(l)')&(a['Đơn vị tính'].str.strip()=='ly')]\nRESULT=int(x['q'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a954a482d4bf", "type": "percent", "answer": 1.96, "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\nd=SoBanHang__all[SoBanHang__all['Mã phiếu'].notna()].copy()\nd['ts']=pd.to_datetime(d['Giờ'],errors='coerce')\nd['t']=d['Tiền'].apply(money)\nd['pos']=d['t']>=0\nst=d['Ghi chú TT'].fillna('')\nd['cancel']=st.str.contains('hủy|huỷ',case=False)\nd['ret']=st.str.contains('trả',case=False)\nog=d.groupby('Mã phiếu').agg(date=('ts','min'),cancel=('cancel','any'),ret=('ret','any'))\n\no=og[(og.date>='2026-04-01')&(og.date<'2026-05-01')]\nRESULT=f\"{o.cancel.sum()/len(o)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7c548fdb25ce", "type": "percent", "answer": 52.78, "_code": "d=DanhSachHoaDon__all.copy()\nd['t']=pd.to_datetime(d['Thời gian tạo'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|Đổi trả',case=False,na=False)]\nd=d[(d.t>='2026-06-01')&(d.t<'2026-06-08')]\nh=d.t.dt.hour\nsang=d[(h>=6)&(h<14)]['Mã hóa đơn'].nunique()\nchieu=d[(h>=14)&(h<22)]['Mã hóa đơn'].nunique()\nRESULT=f\"{(chieu-sang)/sang*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e4bb495a8c6b", "type": "percent", "answer": 11.43, "_code": "import re\ndef money(s):\n    s=str(s).strip()\n    if s=='' or s=='nan': return 0.0\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    return float(re.sub(r'[^\\d\\-]','',s) or 0)\nh=don_hang.copy()\nh['d']=parse_date(h['Ngày'])\nh=h[~h['Tình trạng'].str.contains('cancel|returned|hủy|huỷ|trả',case=False,na=False)]\nl=chi_tiet_don.drop_duplicates().copy()\nl['v']=l['Amount'].map(money)\nh=h[(h.d>='2026-01-01')&(h.d<='2026-01-31')]\nl=l[l['Mã đơn hàng'].isin(h['Mã chứng từ'])].copy()\nl['g']=l['Mã mặt hàng'].map(dict(zip(san_pham['Mã sản phẩm bán'],san_pham['Danh mục'])))\nRESULT=f\"{round(l[l.g=='cơm mì cháo'].v.sum()/l.v.sum()*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_9c009ff08e32", "type": "number", "answer": 7533000, "_code": "df=DonHang_ChiTiet__all.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\nbad=df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)\ndf['amt']=to_num(df['Tổng tiền'])\nok=df[~bad]\nm=ok[(ok.d>='2025-09-01')&(ok.d<='2025-09-30')&(ok['Tên sản phẩm']=='Dầu gội Clear 630g')]\nRESULT=int(m.amt.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d3f2e5421f28", "type": "percent", "answer": -4.5, "_code": "df=DonHang_ChiTiet__all.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\nbad=df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)\ndf['amt']=to_num(df['Tổng tiền'])\nok=df[~bad]\na=ok[(ok.d>='2025-12-01')&(ok.d<='2025-12-31')].amt.sum()\nb=ok[(ok.d>='2025-11-01')&(ok.d<='2025-11-30')].amt.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_049799837470", "type": "percent", "answer": 16.76, "_code": "\nh=DanhSachHoaDon__all.copy(); h['t']=parse_date(h['Thời gian'])\nA=pd.Timestamp(as_of_date)\nh=h[(h.t>=A.replace(day=1))&(h.t<=A)&~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['m']=to_num(c['Thành tiền'])\ntot=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].groupby('Mã hóa đơn').m.sum()\ng=h.merge(DanhSachKhachHang[['Mã khách hàng','Nhóm khách hàng']],left_on='Mã KH',right_on='Mã khách hàng',how='left')\nids=g[g['Nhóm khách hàng']=='thân thiết']['Mã hóa đơn']\nRESULT=f\"{tot.reindex(ids).sum()/tot.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e6c40a66d696", "type": "number", "answer": 23084500, "_code": "import re\ndef money(s):\n    s=str(s).strip()\n    if s=='' or s=='nan': return 0.0\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    return float(re.sub(r'[^\\d\\-]','',s) or 0)\nh=don_hang.copy()\nh['d']=parse_date(h['Ngày'])\nh=h[~h['Tình trạng'].str.contains('cancel|returned|hủy|huỷ|trả',case=False,na=False)]\nl=chi_tiet_don.drop_duplicates().copy()\nl['v']=l['Amount'].map(money)\nh=h[h.d==pd.Timestamp(as_of_date)-pd.Timedelta(days=1)]\nl=l[l['Mã đơn hàng'].isin(h['Mã chứng từ'])]\nRESULT=int(l.v.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bfe3b532115b", "type": "percent", "answer": -36.57, "_code": "\na=So_chi_tiet_ban_hang__all.drop_duplicates()\nbad=set(a[a['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]['Mã đơn hàng'])\na=a[~a['Mã đơn hàng'].isin(bad)].copy()\na['dt']=parse_date(a['Ngày']); a['v']=to_num(a['Thành tiền'])\nf=lambda s,e: a[(a.dt>=s)&(a.dt<=e)]['v'].sum()\nc=f('2026-02-01','2026-02-28'); p=f('2025-02-01','2025-02-28')\nRESULT=f\"{round((c-p)/p*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8d2f278b9ac9", "type": "number", "answer": 3462700, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\nd=DanhSachHoaDon__all.copy()\nd['dt']=pd.to_datetime(d['Thời gian'],format='%d/%m/%Y')\nyd=pd.Timestamp(as_of_date)-pd.Timedelta(days=1)\nd=d[(d.dt==yd)&~d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(d['Mã hóa đơn'])]\nRESULT=int(round(c['Thành tiền'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8c9ba8fc149b", "type": "percent", "answer": 84.0, "_code": "import pandas as pd, re, datetime as dt\nITEM='Trà chanh (L)'; D=pd.Timestamp('2025-03-27'); N=7\nframes=[v for k,v in data.items() if k.endswith('__all')]\na=pd.concat(frames,ignore_index=True)\ncid,cdate,citem,cst,cq='Mã hóa đơn','Ngày giao dịch','Hàng','Status','so_luong'\na=a[a[cid].astype(str).str.startswith('ORD')].drop_duplicates()\ndef pdate(x):\n    if isinstance(x,(int,float)) and not pd.isna(x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(x))\n    if hasattr(x,'year'): return pd.Timestamp(x)\n    s=str(x).strip()\n    if re.match(r'^\\d{4}-\\d{2}-\\d{2}',s): return pd.Timestamp(s[:10])\n    return pd.to_datetime(s,dayfirst=True,errors='coerce')\na['d']=a[cdate].map(pdate)\nbad=a[cst].astype(str).str.lower().str.contains('hủy|huỷ|cancel|trả|hoàn|đổi')\na=a[~a[cid].isin(set(a[bad][cid]))]\nx=a[a[citem].astype(str).str.strip().str.lower()==ITEM.lower()].copy()\nx['q']=pd.to_numeric(x[cq],errors='coerce')\ndef S(lo,hi): return x[(x.d>=lo)&(x.d<=hi)].q.sum()\naft=S(D,D+pd.Timedelta(days=N-1)); bef=S(D-pd.Timedelta(days=N),D-pd.Timedelta(days=1))\nprint(aft,bef,x.d.isna().sum())\nRESULT=f\"{round((aft-bef)/bef*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9aa4f6984a29", "type": "number", "answer": 2300.0, "_code": "\no=don_hang.copy(); o['t']=pd.to_datetime(o['ThoiGianLap']).dt.normalize()\nc=chi_tiet_don[chi_tiet_don.MaHangHoa=='SP0051'].merge(o[['MaHoaDon','t']],on='MaHoaDon')\nc=c[c.t=='2025-02-18'].copy()\nc['pu']=c.GiaDonVi/(c.SLQuyDoi/c.SL)\nprint(c[['DonViTinh','SL','SLQuyDoi','GiaDonVi','pu']].drop_duplicates())\nRESULT=float(c.pu.mode().iloc[0])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3c98a8824458", "type": "percent", "answer": 6.67, "_code": "\nimport re as _re\ndef pm(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n    if not s: return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=_re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: v=float(a+'.'+b)*1e6\n        else: v=int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    elif s.endswith('k'):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif _re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif _re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',',''))\n        except: v=float('nan')\n    return -v if neg else v\n\nd=don_hang.copy()\nd['dt']=parse_date(d['Ngày'])\nm=d[(d.dt>='2026-02-01')&(d.dt<='2026-02-28')&(~d['Tình trạng'].isin(['cancelled','returned']))]\nc=chi_tiet_don.drop_duplicates().copy(); c['a']=c['Amount'].map(pm)\ns=c.groupby('Mã đơn hàng')['a'].sum()\nm=m.assign(rev=m['Mã chứng từ'].map(s).fillna(0))\nRESULT=f\"{round(m[m['Loại bán']=='phone'].rev.sum()/m.rev.sum()*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_9157ed9bf706", "type": "number", "answer": 6037000.0, "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\nd=SoBanHang__all[SoBanHang__all['Mã phiếu'].notna()].drop_duplicates().copy()\nd['ts']=pd.to_datetime(d['Giờ'],errors='coerce')\nd['t']=d['Tiền'].apply(money)\nd['pos']=d['t']>=0\nst=d['Ghi chú TT'].fillna('')\nd['cancel']=st.str.contains('hủy|huỷ',case=False)\nd['ret']=st.str.contains('trả',case=False)\nog=d.groupby('Mã phiếu').agg(date=('ts','min'),cancel=('cancel','any'),ret=('ret','any'))\n\ngood=og[~og.cancel&~og.ret&(og.date>='2025-04-01')&(og.date<'2025-05-01')].index\nx=d[d['Mã phiếu'].isin(good)&d['pos']&d['Tên SP'].str.contains('T8 1.2m 18W',case=False)&d['Tên SP'].str.contains('rạng đông',case=False)]\nprint(x['Tên SP'].unique())\nRESULT=float(x.t.sum())\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_d55269aa2f36", "type": "list", "answer": ["Trương Dương Hằng", "Trịnh Khoa An", "Cao Loan Hiếu"], "_code": "\na=DonHang_ChiTiet__all.drop_duplicates().copy()\nbad=set(a[a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'])\na=a[~a['Mã đơn hàng'].isin(bad)].copy()\na['dt']=parse_date(a['Ngày đặt hàng']); a['v']=to_num(a['Tổng tiền'])\na['k']=a['Tên khách hàng'].map(normalize_text)\na=a[~a['k'].isin(['kl','le','khach le','']) ]\nx=a[(a.dt>='2025-12-01')&(a.dt<='2025-12-31')]\ng=x.groupby('k')['v'].sum().reset_index().sort_values(['v','k'],ascending=[False,True]).head(3)\ndisp=x.groupby('k')['Tên khách hàng'].agg(lambda s:s.value_counts().index[0])\nRESULT=[disp[k] for k in g['k']]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2a62e57df626", "type": "percent", "answer": 2.44, "_code": "\nd=don_hang.copy()\nd['dt']=parse_date(d['Ngày'])\nm=d[(d.dt>='2026-02-01')&(d.dt<='2026-02-28')]\nRESULT=f\"{round((m['Tình trạng']=='cancelled').sum()/len(m)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f2fa231f8444", "type": "percent", "answer": 27.75, "_code": "import unicodedata, re\nd=So_chi_tiet_ban_hang__all.copy().drop_duplicates()\nd['d']=parse_date(d['Ngày'])\nbad=d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)\nj=d[(d.d>='2026-01-01')&(d.d<='2026-01-31')&~bad]\nnm=j['Khách hàng'].map(lambda s: re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower())\nj=j[~nm.isin(['kl','khách lẻ','lẻ'])].assign(n=nm)\nc=j.groupby('n')['Mã đơn hàng'].nunique()\nRESULT=f\"{round((c>=4).sum()/len(c)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bcb09dce000f", "type": "percent", "answer": 23.42, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\na=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\na['d']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na=a[~a['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\na['v']=a['Thành tiền'].map(money)\nt=pd.Timestamp(as_of_date)\ncs=t.replace(day=1); ps=cs-pd.offsets.MonthBegin(1)\npe=min(ps+pd.Timedelta(days=t.day-1), cs-pd.Timedelta(days=1))\ncur=a[(a.d>=cs)&(a.d<=t)].v.sum(); prev=a[(a.d>=ps)&(a.d<=pe)].v.sum()\nRESULT=f\"{(cur-prev)/prev*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_582c1f6ce4c7", "type": "number", "answer": 226124900, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return 0.0\n    m=re.match(r'^(-?\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)tr$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000000)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)k$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000)\n    if re.match(r'^-?\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(re.sub(r'[^\\d.\\-]','',s) or 0)\ndf=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf['v']=df['Tổng tiền'].map(money)\nok=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nx=ok[(ok.d>='2025-08-01')&(ok.d<='2025-08-31')]\nRESULT=int(round(x.v.sum()))\n", "_attempts": 2, "_verdict": "correct"}
