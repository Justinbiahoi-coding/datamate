{"id": "q_ba298d899d0e", "type": "number", "answer": 5, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\nd=d[d['Mã đơn hàng'].notna()].drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt>='2025-04-01')&(d.dt<='2025-04-30')]\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]\nd['k']=d['Tên hàng hóa'].map(normalize_text)\nd=d[~d['k'].str.contains('phi phuc vu')]\nRESULT=int((d.groupby('k')['Mã đơn hàng'].nunique()>=231).sum())\n", "_attempts": 3, "_verdict": "correct"}
{"id": "q_64006dcec25e", "type": "percent", "answer": 6.04, "_code": "h=DuLieuBanHang__DanhSachHoaDon.copy()\nh['dt']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nh=h[(h.dt>='2026-01-01')&(h.dt<'2026-02-01')]\nh=h[~h['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả|cancel',case=False)]\nd=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nd=d[d['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\nd['v']=to_num(d['Thành tiền'])\np=DuLieuBanHang__DanhSachSanPham.drop_duplicates('Mã hàng').set_index('Mã hàng')['Nhóm hàng(3 Cấp)']\ng=d['Mã hàng'].map(p)\nRESULT='%.2f%%'%(d[g=='sữa'].v.sum()/d.v.sum()*100)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8efba6cd610e", "type": "number", "answer": 229268, "_code": "\nd=don_hang[(don_hang.TinhTrang!='cancelled')&(don_hang.PhuongThucTT!='cod')].copy()\nd['dt']=pd.to_datetime(d.ThoiGianLap).dt.normalize()\nasof=pd.Timestamp(as_of_date)\nd=d[(d.dt<=asof)&((asof-d.dt).dt.days>15)]\np=thanh_toan.copy(); p['t']=pd.to_datetime(p.NgayGioThu).dt.normalize(); p=p[p.t<=asof]\npaid=p.groupby('MaHoaDon')['SoTienThu'].apply(lambda s: pd.to_numeric(s).sum())\nd['paid']=d.MaHoaDon.map(paid).fillna(0)\nd['owe']=pd.to_numeric(d.TongThanhToan)-d['paid']\nRESULT=int(d[d.owe>0].owe.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_137db6c2259a", "type": "percent", "answer": 20.23, "_code": "\na=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True)\na=a.drop_duplicates()\na['d']=parse_date(a['Ngày'])\na['v']=to_num(a['Thành tiền'])\nassert a.v.notna().all()\ng=[v for k,v in data.items() if k.startswith('Danh s')][0]\ngm={normalize_text(n):x for n,x in zip(g['Tên hàng hóa'],g['Nhóm hàng hóa'])}\num={normalize_text(n):x for n,x in zip(g['Tên hàng hóa'],g['Đơn vị tính'])}\na['n']=a['Tên hàng hóa'].map(normalize_text)\na['g']=a.n.map(gm)\na['u']=a.n.map(um)\nbad=a['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nbo=set(a.loc[bad,'Mã đơn hàng'])\na=a[~a['Mã đơn hàng'].isin(bo)]\n\nm=(a.d.dt.year==2025)&(a.d.dt.month==5)\nRESULT=f\"{round(a.loc[m&(a.g=='trà sữa'),'v'].sum()/a.loc[m,'v'].sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_be2094121817", "type": "number", "answer": 123635700, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in('nan','','none'): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+[,.]\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): v=float(s.replace(',',''))\n    else: v=float(s.replace(',','.'))\n    return -v if neg else v\nh=BanHang_HoaDon.drop_duplicates().copy(); c=BanHang_ChiTietHoaDon.drop_duplicates().copy()\nh['t']=pd.to_datetime(h['Giờ tạo đơn'])\nok=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao',case=False,na=False)&(h['Mã NV bán']=='NV002')&(h.t>='2026-02-01')&(h.t<'2026-03-01')]\nc=c[c['Mã giao dịch'].isin(ok['Order ID'])]\nRESULT=int(round(c['Thanh tien'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4336aa159e7c", "type": "number", "answer": 2151, "_code": "\na=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True)\na=a.drop_duplicates()\na['d']=parse_date(a['Ngày'])\na['v']=to_num(a['Thành tiền'])\nassert a.v.notna().all()\ng=[v for k,v in data.items() if k.startswith('Danh s')][0]\ngm={normalize_text(n):x for n,x in zip(g['Tên hàng hóa'],g['Nhóm hàng hóa'])}\num={normalize_text(n):x for n,x in zip(g['Tên hàng hóa'],g['Đơn vị tính'])}\na['n']=a['Tên hàng hóa'].map(normalize_text)\na['g']=a.n.map(gm)\na['u']=a.n.map(um)\nbad=a['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nbo=set(a.loc[bad,'Mã đơn hàng'])\na=a[~a['Mã đơn hàng'].isin(bo)]\n\nm=(a.d.dt.year==2025)&(a.d.dt.month==4)&a.n.str.endswith('(l)')&(a.u=='ly')\nRESULT=int(to_num(a.loc[m,'Số lượng quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7600cba9d95b", "type": "number", "answer": 952365500, "_code": "a=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\na=a[a['Mã đơn hàng'].notna()].drop_duplicates().copy()\na['d']=parse_date(a['Ngày']); a['tt']=to_num(a['Thành tiền'])\nbad=a['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả',case=False)\ngood=a[~bad]\nRESULT=int(round(good[(good.d>='2025-02-01')&(good.d<='2025-02-28')].tt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d25f14d700e2", "type": "percent", "answer": 0.29, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in('nan','','none'): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+[,.]\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): v=float(s.replace(',',''))\n    else: v=float(s.replace(',','.'))\n    return -v if neg else v\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['d']=parse_date(d['Ngày'])\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao|hoàn',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)].copy(); d['v']=d['Thành tiền'].map(money)\nt=pd.Timestamp(as_of_date); cs=t.replace(day=1); ps=cs-pd.offsets.MonthBegin(1)\npe=min(ps+pd.Timedelta(days=t.day-1),cs-pd.Timedelta(days=1))\ncur=d[(d.d>=cs)&(d.d<=t)].v.sum(); prev=d[(d.d>=ps)&(d.d<=pe)].v.sum()\nRESULT=f\"{(cur-prev)/prev*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e250b3f9454c", "type": "percent", "answer": 2.15, "_code": "a=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\na=a[a['Mã đơn hàng'].notna()].drop_duplicates().copy()\na['d']=parse_date(a['Ngày']); a['tt']=to_num(a['Thành tiền'])\nbad=a['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả',case=False)\ngood=a[~bad]\nm=a[(a.d>='2026-08-01')&(a.d<='2026-08-29')]\nc=m[m['Trạng thái'].astype(str).str.contains('hủy|huỷ',case=False)]['Mã đơn hàng'].nunique()\nRESULT=f\"{round(c/m['Mã đơn hàng'].nunique()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5df5d47f81d7", "type": "number", "answer": 2013, "_code": "o=don_hang.copy(); o['dt']=parse_date(o['NgayBan'])\nok=o[~o['Xử lý'].isin(['cancelled','returned'])]\nok=ok[(ok.dt>='2026-06-01')&(ok.dt<='2026-06-30')]\nc=chi_tiet_don[chi_tiet_don['Ma don'].isin(ok['Mã chứng từ'])].merge(san_pham[['SKU','Sản phẩm','Đơn vị']],left_on='ID SP',right_on='SKU')\nc=c[c['Sản phẩm'].str.strip().str.lower().str.endswith('(l)')&(c['Đơn vị']=='ly')]\nRESULT=int(to_num(c['SL quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_31be06f05a4d", "type": "percent", "answer": 2.31, "_code": "o=don_hang.copy(); o['dt']=parse_date(o['NgayBan'])\nx=o[(o.dt>='2026-04-01')&(o.dt<='2026-04-30')]\nRESULT=f\"{(x['Xử lý']=='cancelled').mean()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_110238617caa", "type": "percent", "answer": -0.8, "_code": "a=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\na=a[a['Mã đơn hàng'].notna()].drop_duplicates().copy()\na['d']=parse_date(a['Ngày']); a['tt']=to_num(a['Thành tiền'])\nbad=a['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả',case=False)\ngood=a[~bad]\nx=good[(good.d>='2025-08-01')&(good.d<='2025-08-20')].tt.sum()\ny=good[(good.d>='2025-07-01')&(good.d<='2025-07-20')].tt.sum()\nRESULT=f\"{round((x-y)/y*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_717516916e1d", "type": "number", "answer": 115219, "_code": "p=DanhSachSanPham[DanhSachSanPham['Tên hàng'].str.contains('Smecta',case=False)]\ncode=p['Mã hàng'].iloc[0]\nn=DanhSachNhapHang.copy(); n['dt']=parse_date(n['Thời gian'])\nn=n[(n.dt>='2025-05-01')&(n.dt<='2025-05-31')&~n['Trạng thái'].astype(str).str.contains('hủy|huỷ',case=False)]\nl=DanhSachChiTietNhapHang[DanhSachChiTietNhapHang['Mã hàng']==code]\nl=l[l['Mã nhập hàng'].isin(n['Mã nhập hàng'])].copy()\nl['q']=to_num(l['Số lượng']);l['pr']=to_num(l['Đơn giá'])\nprint(l[['ĐVT','q','pr']].to_string())\nRESULT=int(round((l.q*l.pr).sum()/l.q.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b245b4023fbb", "type": "number", "answer": 70286, "_code": "import re, numpy as np, unicodedata\ndef money(x):\n    if x is None or (isinstance(x,float) and np.isnan(x)): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan'): return np.nan\n    if 'tr' in s:\n        a,b=s.split('tr',1); a=a.strip().replace(',','.')\n        v=float(a)*1e6 if a else 0\n        b=b.strip()\n        if b: v+=int(b.ljust(3,'0')[:3])*1000\n        return v\n    if s.endswith('k'):\n        return float(s[:-1].replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.fullmatch(r'-?\\d+,\\d+',s) else float(s)\ndef nt(s):\n    return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower()\nimport pandas as pd\nh=DanhSachHoaDon.copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates()\nd['v']=d['Thành tiền'].map(money)\nhh=h[(h.dt>='2025-05-01')&(h.dt<='2025-05-31')]\nrv=d[d['Mã hóa đơn'].isin(hh['Mã hóa đơn'])].groupby('Mã hóa đơn').v.sum()\nRESULT=int(rv.sum()/len(hh)+0.5)\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_5f2a8e3cc813", "type": "percent", "answer": 3.87, "_code": "\nimport re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s=='' : return 0.0\n    m=_re.match(r'^(-?\\d+)(?:[.,](\\d+))?\\s*tr\\s*(\\d+)?$',s)\n    if m:\n        a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0'))*1e3\n        return a\n    m=_re.match(r'^(-?\\d+(?:[.,]\\d+)?)\\s*k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.match(r'^-?\\d{1,3}([.,]\\d{3})+$',s): return float(_re.sub(r'[.,]','',s))\n    if _re.match(r'^-?\\d+[.,]\\d{4}$',s): return float(s.replace(',','.'))\n    s2=s.replace(',','.')\n    try: return float(s2)\n    except: return float('nan')\n\nh=BanHang_HoaDon.copy(); h['dt']=pd.to_datetime(h['Giờ tạo đơn']).dt.normalize()\nh=h[h['Trạng thái'].isin(['Đã giao','Đang vận chuyển'])&(h.dt>='2025-01-01')&(h.dt<='2025-01-31')]\nc=BanHang_ChiTietHoaDon.drop_duplicates()\nc=c[c['Mã giao dịch'].isin(h['Order ID'])].copy()\nc['v']=c['Thanh tien'].map(money)\nrx=set(BanHang_Thuoc[BanHang_Thuoc['Kê đơn'].astype(str).str.lower().isin(['true','1'])]['Mã HH'])\nRESULT=f\"{c[c['Ma hang'].isin(rx)].v.sum()/c.v.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5a2a8754491f", "type": "number", "answer": 6, "_code": "d=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt>='2025-05-01')&(d.dt<='2025-05-31')]\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|không giao',case=False,na=False)]\nd['k']=d['Tên hàng hóa'].map(normalize_text)\nd=d[~d['k'].str.contains('phi phuc vu')]\nRESULT=int((d.groupby('k')['Mã đơn hàng'].nunique()>=78).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9600fe33a3d0", "type": "number", "answer": 55182000, "_code": "d=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt>='2025-03-01')&(d.dt<='2025-03-31')]\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|không giao',case=False,na=False)]\nd=d[d['Tên hàng hóa'].map(normalize_text)==normalize_text('Dây điện Cadivi CV 1.5 cuộn 100m')]\nRESULT=int(round(to_num(d['Thành tiền']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8848e665f8d1", "type": "number", "answer": 1521, "_code": "import re, numpy as np, unicodedata\ndef money(x):\n    if x is None or (isinstance(x,float) and np.isnan(x)): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan'): return np.nan\n    if 'tr' in s:\n        a,b=s.split('tr',1); a=a.strip().replace(',','.')\n        v=float(a)*1e6 if a else 0\n        b=b.strip()\n        if b: v+=int(b.ljust(3,'0')[:3])*1000\n        return v\n    if s.endswith('k'):\n        return float(s[:-1].replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.fullmatch(r'-?\\d+,\\d+',s) else float(s)\ndef nt(s):\n    return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower()\nimport pandas as pd\nh=DanhSachHoaDon.copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates()\nd['v']=d['Thành tiền'].map(money)\nhh=h[(h.dt>='2026-03-16')&(h.dt<='2026-03-22')]\ndd=d[d['Mã hóa đơn'].isin(hh['Mã hóa đơn'])]\nbase=DanhSachSanPham.set_index('Mã hàng')['ĐVT']\ndd=dd[dd['Mã hàng'].map(base)=='ly']\nRESULT=int(dd['Số lượng quy đổi'].astype(float).sum())\n", "_attempts": 3, "_verdict": "correct"}
{"id": "q_7bbd5b2b5ad7", "type": "percent", "answer": 1.92, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in('nan','','none'): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+[,.]\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): v=float(s.replace(',',''))\n    else: v=float(s.replace(',','.'))\n    return -v if neg else v\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['d']=parse_date(d['Ngày'])\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao|hoàn',case=False,na=False)]['Mã đơn hàng'].unique()\nx=d[(d.d>='2026-07-01')&(d.d<='2026-07-31')]\ncanc=x[x['Trạng thái'].str.contains('hủy|huỷ|Không giao',case=False,na=False)]['Mã đơn hàng'].nunique()\nRESULT=f\"{canc/x['Mã đơn hàng'].nunique()*100:.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
