{"id": "q_97541e3502fb", "type": "list", "answer": [80000, 40000], "_code": "def money(x):\n    s=str(x).replace('đ','').replace('.','').replace(',','').strip()\n    return float(s) if s not in('','nan') else 0.0\nk=DanhSachKhachHang\ncodes=k[k['Tên khách hàng'].str.lower().str.contains('đinh tâm long')]['Mã khách hàng'].tolist()\nh=DanhSachHoaDon.copy(); h['t']=pd.to_datetime(h['Thời gian tạo'])\nh=h[h['Mã KH'].isin(codes)&(h['Phương thức thanh toán']=='Ghi nợ')&~h['Trạng thái'].isin(['hủy đơn','Đã hủy'])]\np=SoQuy.copy(); p['t']=pd.to_datetime(p['Thời gian']); p['v']=p['Giá trị'].map(money)\np=p.merge(h[['Mã hóa đơn','t']],on='Mã hóa đơn',suffixes=('','_o'))\nsame=p[p.t.dt.date==p.t_o.dt.date].groupby('Mã hóa đơn')['v'].sum()\nhm=h[(h.t>='2025-03-01')&(h.t<'2025-04-01')]\nadd=sum(max(money(r['Tổng sau giảm giá'])-same.get(r['Mã hóa đơn'],0),0) for _,r in hm.iterrows())\npaid=p[(p.t.dt.date>p.t_o.dt.date)&(p.t>='2025-03-01')&(p.t<'2025-04-01')]['v'].sum()\nRESULT=[round(add),round(paid)]\n", "_attempts": 1, "_verdict": "correct"}
