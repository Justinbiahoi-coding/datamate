{"id": "q_b152b20b0297", "type": "string", "answer": "Đặng Thảo Dương", "_code": "\nh=DanhSachHoaDon__all.drop_duplicates().copy(); h['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|Đổi',case=False,na=False)&h['Mã KH'].notna()&(h.d>='2026-02-01')&(h.d<'2026-03-01')]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['amt']=to_num(c['Thành tiền'])\nh['r']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn').amt.sum())\nk=h.groupby('Mã KH').r.sum().idxmax()\nRESULT=DanhSachKhachHang.set_index('Mã khách hàng').loc[k,'Tên khách hàng']", "_attempts": 1, "_verdict": "correct"}
{"id": "q_14d7decc3d79", "type": "date", "answer": "2025-11-30", "_code": "\nimport re as _re\ndef mny1(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=_re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m:\n        v=int(m.group(1))*1e6; r=m.group(2)\n        if r: v+=int(r)*(10**(6-len(r)))\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    elif _re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): v=float(_re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s)\n        except: v=float('nan')\n    return -v if neg else v\ndef mny(ser): return ser.map(mny1)\n\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all]).drop_duplicates()\nd=d[d['Giờ'].notna()]\nd['dt']=pd.to_datetime(d['Giờ'],errors='coerce')\nd['m']=mny(d['Trị giá'])\nd['q']=to_num(d['so_luong'])\nst=d['Status'].astype(str).str.lower()\nbad=d[st.str.contains('hủy|trả|đổi')|(d.q<0)]['Mã hóa đơn'].unique()\nd=d[~d['Mã hóa đơn'].isin(bad)]\nx=d[(d.dt>='2025-11-01')&(d.dt<'2025-12-01')]\nRESULT=x.groupby(x.dt.dt.date).m.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bf2e7c7baac7", "type": "string", "answer": "Tạ Giang Phúc", "_code": "\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if 'tr' in s:\n        a,b=s.split('tr'); return float(a.replace(',','.'))*1e6 if b=='' else float(a)*1e6+float(b.ljust(3,'0'))*1e3\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1e3\n    return float(s.replace('.','').replace(',',''))\no=don_hang[~don_hang['Tình trạng'].isin(['cancelled','returned'])&don_hang['Customer ID'].notna()].copy(); o['d']=parse_date(o['Ngày'])\no=o[(o.d>='2025-09-01')&(o.d<'2025-10-01')]\nc=chi_tiet_don.drop_duplicates().copy(); c['amt']=c['Amount'].apply(money)\no['r']=o['Mã chứng từ'].map(c.groupby('Mã đơn hàng').amt.sum())\nk=o.groupby('Customer ID').r.sum().idxmax()\nRESULT=khach_hang.set_index('Mã KH').loc[k,'Khách hàng (tên)']", "_attempts": 2, "_verdict": "correct"}
{"id": "q_e4fe38fbebb9", "type": "string", "answer": "La Hương Quang", "_code": "\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1e3\n    return float(s.replace('.','').replace(',',''))\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).dropna(subset=['Mã hóa đơn']).drop_duplicates().copy()\nd['d']=parse_date(d['Ngày giao dịch'])\nd['amt']=d['Trị giá'].apply(money)\nbad=d[d['Status'].str.contains('hủy|huỷ|trả|đổi',case=False)|(pd.to_numeric(d['so_luong'],errors='coerce')<0)]['Mã hóa đơn'].unique()\nm=d[~d['Mã hóa đơn'].isin(bad)&(d.d>='2025-06-30')&(d.d<='2025-07-06')]\nm=m[~m['Khách'].str.lower().str.strip().isin(['khách lẻ','kl','lẻ'])]\nRESULT=m.groupby('Khách').amt.sum().idxmax()", "_attempts": 2, "_verdict": "correct"}
{"id": "q_b90cd35c2d5c", "type": "string", "answer": "Hứa Nhung Dương", "_code": "import re\ndef pm(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,'0')[:3])*1000 if f else 0) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+\\.\\d+',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    if re.fullmatch(r'\\d+[.,]\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\nh=DanhSachHoaDon__all.reset_index(drop=True).copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[(h.dt>='2025-03-01')&(h.dt<='2025-03-31')]\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)&h['Mã KH'].notna()]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].merge(h[['Mã hóa đơn','Mã KH','Khách hàng']],on='Mã hóa đơn')\nc['t']=c['Thành tiền'].apply(pm)\ntop=c.groupby('Mã KH').t.sum().idxmax()\nRESULT=c[c['Mã KH']==top]['Khách hàng'].iloc[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_69113d97beac", "type": "number", "answer": 300000.0, "_code": "\nx=ban_hang[ban_hang['Sản phẩm'].str.contains('Jotun nội thất 40kg',case=False)].copy()\nx=x[parse_date(x['Ngày'])==pd.Timestamp('2026-05-03')]\nn=lambda s:pd.to_numeric(s.astype(str).str.replace(',','').str.extract(r'([\\d.]+)')[0])\n# unit price per base unit: price per line unit / (base qty per line unit)\nRESULT=float((n(x['Giá bán lẻ'])*n(x['Sluong'])/n(x['Quy ra ĐV lẻ'])).iloc[0])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_13fc08e94004", "type": "number", "answer": 8257000, "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\nh=DanhSachHoaDon.copy().drop_duplicates('Mã hóa đơn')\nst=h['Trạng thái'].astype(str).str.lower()\nh=h[~st.str.contains('hủy|huỷ|trả')]\nh['d']=parse_date(h['Thời gian'])\nc=DanhSachHoaDonChiTiet.copy().drop_duplicates()\nc['a']=c['Thành tiền'].map(m)\nsp=DanhSachSanPham[['Mã hàng','Nhóm hàng(3 Cấp)']]\nc=c.merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn').merge(sp,on='Mã hàng',how='left')\nw=c[(c.d>='2025-07-01')&(c.d<'2025-08-01')]\nRESULT=int(round(w[w['Nhóm hàng(3 Cấp)'].astype(str).str.lower().str.strip()=='thực phẩm'].a.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_700aa46c2c6d", "type": "date", "answer": "2025-09-21", "_code": "o=DonHang_ChiTiet__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\no[h]=o[h].ffill(); o=o.drop_duplicates()\no['d']=parse_date(o['Ngày đặt hàng']); o['amt']=to_num(o['Tổng tiền'])\no['q']=o['Số lượng sản phẩm'].astype(str).str.extract(r'^\\s*([\\d.]+)')[0].astype(float)\nbad=set(o[o['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|hoàn|trả',case=False)]['Mã đơn hàng'])\ng=o[~o['Mã đơn hàng'].isin(bad)]\nx=g[(g.d>='2025-09-01')&(g.d<='2025-09-30')]\nRESULT=x.groupby('d').amt.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0a0038f69d4e", "type": "date", "answer": "2025-10", "_code": "o=DonHang_ChiTiet__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\no[h]=o[h].ffill(); o=o.drop_duplicates()\no['d']=parse_date(o['Ngày đặt hàng']); o['amt']=to_num(o['Tổng tiền'])\no['q']=o['Số lượng sản phẩm'].astype(str).str.extract(r'^\\s*([\\d.]+)')[0].astype(float)\nbad=set(o[o['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|hoàn|trả',case=False)]['Mã đơn hàng'])\ng=o[~o['Mã đơn hàng'].isin(bad)]\nx=g[(g.d>='2025-08-01')&(g.d<='2025-10-31')]\nRESULT=x.groupby(x.d.dt.strftime('%Y-%m')).amt.sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
