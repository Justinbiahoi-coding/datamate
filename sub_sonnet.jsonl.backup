{"id": "q_788ab61d79d1", "type": "list", "answer": ["Xi măng Hà Tiên PCB40 bao 50kg", "Xi măng INSEE Power-S bao 50kg", "Thép cuộn phi 6 Hòa Phát", "Băng keo điện Nano 20 yard", "Thép Pomina D10 cây 11.7m"], "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nd=SoBanHang__all.drop_duplicates().copy()\nd=d[d['Mã phiếu'].astype(str).str.startswith('ORD')].copy()\nd['gio']=pd.to_datetime(d['Giờ']); d['dt']=d.gio.dt.normalize()\nd['t']=mon(d['Tiền'])\nd['q']=d['Số lượng hàng'].astype(str).str.extract(r'(-?\\d+(?:[.,]\\d+)?)')[0].str.replace(',','.').astype(float)\nbadst=d['Ghi chú TT'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nbad=set(d[badst|(d.q<0)]['Mã phiếu'])\nd=d[~d['Mã phiếu'].isin(bad)]\nimport re\nn=lambda s: re.sub(r'\\s+',' ',vn_normalize(s))\ncanon={n(x):x for x in TonKho['Product']}\nd=d[(d.dt>='2025-09-01')&(d.dt<='2025-09-30')].copy()\ndm={(n(r['Hàng']),n(r['ĐV lớn'])):float(r['Hệ số QĐ']) for _,r in DanhMuc.iterrows()}\nd['k']=d['Tên SP'].apply(n)\nd['f']=[dm.get((k,n(u)),1.0) for k,u in zip(d.k,d['DonVi'])]\nd['bq']=d.q*d.f\ng=d.groupby('k').bq.sum().sort_values(ascending=False)\nRESULT=[canon.get(k,k) for k in g.head(5).index]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d4f8f031e663", "type": "percent", "answer": 17.19, "_code": "h=data['DanhSachHoaDon__all'].drop_duplicates().copy()\nh['d']=parse_date(h['Thời gian'])\nh=h.drop_duplicates('Mã hóa đơn')\nok=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Đổi trả',case=False,na=False)]\nok=ok[(ok.d>='2025-08-01')&(ok.d<='2025-08-31')]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nc['tt']=to_num(c['Thành tiền'])\nrev=c.groupby('Mã hóa đơn')['tt'].sum()\nok=ok.assign(rev=ok['Mã hóa đơn'].map(rev).fillna(0))\ngrp=DanhSachKhachHang.set_index('Mã khách hàng')['Nhóm khách hàng']\nok['g']=ok['Mã KH'].map(grp)\nRESULT=f\"{round(ok[ok.g=='thân thiết'].rev.sum()/ok.rev.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
