{"id": "q_238225519d3a", "type": "number", "answer": 1, "_code": "import re\nd=DonHang_ChiTiet__all.copy()\nhdr=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hdr]=d[hdr].ffill()\nd=d.drop_duplicates()\nd['d']=parse_date(d['Ngày đặt hàng'])\nd['t']=d['Tổng tiền'].astype(str).str.replace(',','').astype(float)\nd['q']=d['Số lượng sản phẩm'].astype(str).str.extract(r'^\\s*([\\d.]+)')[0].astype(float)\nok=~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|Hoàn',case=False,na=False)\n\nx=d[ok&(d.d>='2025-06-25')&(d.d<='2026-07-01')]\nx=x[(x.d<='2026-07-01')&(x.d>='2026-06-25')]\nsold=set(d[ok&(d.d<'2026-06-25')]['Tên sản phẩm'])\nRESULT=len(sold-set(x['Tên sản phẩm']))\n", "_attempts": 1, "_verdict": "correct"}
