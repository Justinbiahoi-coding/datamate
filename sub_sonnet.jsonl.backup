{"id": "q_e76fa95d61b6", "type": "percent", "answer": 3.0, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\nh=BanHang_HoaDon.copy()\nh['dt']=parse_date(h['Ngày bán'])\nh=h[~h['Trạng thái'].str.contains('Không giao được|hủy|huỷ|Đổi trả|trả',case=False,na=False)]\nh['v']=h['Tiền hàng trước giảm'].map(money)\ndef rev(y,m): return h[(h.dt.dt.year==y)&(h.dt.dt.month==m)].v.sum()\nRESULT=f\"{(rev(2026,1)-rev(2025,12))/rev(2025,12)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_dc90f61d0af0", "type": "number", "answer": 146000, "_code": "\nimport pandas as pd\nx=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\nx['dt']=parse_date(x['Ngày'])\nx=x[(x.dt=='2026-01-17')&x['Tên hàng hóa'].astype(str).str.strip().str.lower().str.contains('mực chiên nước mắm')]\np=pd.to_numeric(x['Đơn giá'].astype(str).str.replace(',',''),errors='coerce')\nRESULT=int(p.mode().iloc[0])", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9bb2953b4c71", "type": "number", "answer": 99000, "_code": "\nimport pandas as pd\nx=SoBanHang.copy()\nx['dt']=parse_date(x['Ngày tháng'])\nx=x[(x.dt=='2026-05-03')&x['Ten hang'].astype(str).str.strip().str.lower().str.contains('vú heo nướng sa tế')]\np=pd.to_numeric(x['Price'].astype(str).str.replace(',','').str.replace('đ','').str.replace('.',''),errors='coerce')\nRESULT=int(p.mode().iloc[0])", "_attempts": 1, "_verdict": "correct"}
{"id": "q_dd6531374a2b", "type": "percent", "answer": 121.74, "_code": "\na=SoBanHang__all.drop_duplicates().copy()\na['q']=pd.to_numeric(a['Số lượng hàng'].astype(str).str.extract(r'(-?[\\d.]+)')[0])\nbad=set(a[a['Ghi chú TT'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)|(a.q<0)]['Mã phiếu'])\na=a[~a['Mã phiếu'].isin(bad)].copy()\na['dt']=pd.to_datetime(a['Giờ'],errors='coerce').dt.normalize()\nx=a[(a['Tên SP'].map(normalize_text)==normalize_text('Gas Petrolimex 12kg'))&(a.DonVi=='bình')]\ns=pd.Timestamp('2026-04-18')\npost=x[(x.dt>=s)&(x.dt<=s+pd.Timedelta(days=6))].q.sum()\npre=x[(x.dt>=s-pd.Timedelta(days=7))&(x.dt<s)].q.sum()\nRESULT=f\"{round((post-pre)/pre*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a8ac54bdbe06", "type": "percent", "answer": 9.79, "_code": "\nimport pandas as pd\ns=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\ns['dt']=parse_date(s['Ngày'])\ns['a']=pd.to_numeric(s['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\nok=s[~s['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao',case=False,na=False)]\na=ok[(ok.dt>='2025-03-01')&(ok.dt<='2025-03-31')].a.sum()\nb=ok[(ok.dt>='2025-02-01')&(ok.dt<='2025-02-28')].a.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e6a9f4af23f7", "type": "number", "answer": 117243400, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\nd=DuLieuBanHang['DanhSachHoaDon'].copy()\nd['t']=pd.to_datetime(d['Thời gian tạo'])\nd=d[(d.t>='2025-12-01')&(d.t<'2026-01-01')&(d.t.dt.hour>=6)&(d.t.dt.hour<14)]\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet[DanhSachHoaDonChiTiet['Mã hóa đơn'].isin(d['Mã hóa đơn'])]\nRESULT=int(round(c['Thành tiền'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_994960428219", "type": "number", "answer": 445333, "_code": "n=DuLieuBanHang__DanhSachNhapHang.copy(); n['d']=parse_date(n['Thời gian'])\nn=n[~n['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)&(n.d>='2025-09-01')&(n.d<='2025-09-30')]\nc=DuLieuBanHang__DanhSachChiTietNhapHang.drop_duplicates()\nx=c[(c['Mã hàng']=='SP0010')&(c['ĐVT']=='thùng')].merge(n[['Mã nhập hàng']],on='Mã nhập hàng')\nq=to_num(x['Số lượng']); p=to_num(x['Đơn giá'])\nRESULT=int(round((q*p).sum()/q.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b06715eec0f5", "type": "percent", "answer": -46.74, "_code": "h=DuLieuBanHang__DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hàng']=='SP0004'].merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\nc['q']=to_num(c['Số lượng quy đổi'])\na=c[(c.d>='2026-01-05')&(c.d<='2026-01-11')].q.sum()\nb=c[(c.d>='2025-12-29')&(c.d<='2026-01-04')].q.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b5c5f0a182ba", "type": "percent", "answer": 79.75, "_code": "\nimport pandas as pd\ns=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ns[hc]=s[hc].ffill()\ns=s.drop_duplicates()\ns['dt']=parse_date(s['Ngày đặt hàng'])\ns['a']=pd.to_numeric(s['Tổng tiền'].astype(str).str.replace(',',''),errors='coerce')\nok=s[~s['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]\na=ok[(ok.dt>='2026-02-01')&(ok.dt<='2026-02-20')].a.sum()\nb=ok[(ok.dt>='2026-01-01')&(ok.dt<='2026-01-20')].a.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bac17d689ee8", "type": "number", "answer": 87413000, "_code": "h=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)&(h.d>='2025-07-01')&(h.d<='2025-07-31')]\ngrp=DanhSachSanPham[DanhSachSanPham['Nhóm hàng(3 Cấp)'].str.lower().str.strip()=='cơm mì cháo']['Mã hàng']\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])&c['Mã hàng'].isin(grp)]\nRESULT=int(round(to_num(c['Thành tiền']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7ebd4d633970", "type": "percent", "answer": 4.8, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\na=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[hc]=a[hc].ffill()\na=a.drop_duplicates()\na['d']=pd.to_datetime(a['Ngày đặt hàng'],format='%d/%m/%Y')\na=a[~a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\na['v']=a['Tổng tiền'].map(money)\nt=pd.Timestamp(as_of_date)\ncs=t.replace(day=1); ps=cs-pd.offsets.MonthBegin(1)\npe=min(ps+pd.Timedelta(days=t.day-1), cs-pd.Timedelta(days=1))\ncur=a[(a.d>=cs)&(a.d<=t)].v.sum(); prev=a[(a.d>=ps)&(a.d<=pe)].v.sum()\nRESULT=f\"{(cur-prev)/prev*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_237610c595d7", "type": "number", "answer": 60, "_code": "d=DonHang_ChiTiet.copy()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[(d.dt>='2026-04-01')&(d.dt<='2026-04-30')]\nc=d[d['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|cancel',case=False)]\nRESULT=int(c['Mã đơn hàng'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
