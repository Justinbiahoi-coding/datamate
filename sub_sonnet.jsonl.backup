{"id": "q_caaa78ea3c1b", "type": "number", "answer": 53500, "_code": "\nimport pandas as pd\nH=DanhSachHoaDon.copy()\nD=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2]).drop_duplicates()\nH['d']=parse_date(H['Thời gian'])\ndef money(s): return pd.to_numeric(s.astype(str).str.replace(',',''),errors='coerce')\nst=H['Trạng thái'].astype(str).str.lower()\nbad=st.str.contains('hủy|huỷ|trả|hoàn trả')\n\nHs=H[H.d=='2026-03-30']\nx=D[D['Mã hóa đơn'].isin(Hs['Mã hóa đơn'])&(D['Mã hàng']=='SP0024')]\nRESULT=int(money(x['Đơn giá']).mode()[0])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b32a835936bc", "type": "number", "answer": 8275700, "_code": "h=DanhSachHoaDon.copy(); h[\"od\"]=pd.to_datetime(h[\"Thời gian tạo\"]).dt.normalize()\nh=h[~h[\"Trạng thái\"].str.contains(\"hủy|huỷ|cancel|trả\",case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c[\"a\"]=to_num(c[\"Thành tiền\"])\nh[\"v\"]=h[\"Mã hóa đơn\"].map(c.groupby(\"Mã hóa đơn\").a.sum()).fillna(0)\n\nRESULT=int(round(h[h.od==\"2025-12-09\"].v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d35ca1b853e1", "type": "percent", "answer": 5.44, "_code": "h=DanhSachHoaDon.drop_duplicates().copy(); h['od']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['a']=to_num(c['Thành tiền'])\nh['v']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn').a.sum()).fillna(0)\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)\nhv=h[~bad]\nr=lambda s,e,df=hv:df[(df.od>=s)&(df.od<=e)].v.sum()\nRESULT=f'{round((r(\"2025-12-01\",\"2025-12-31\")/r(\"2025-11-01\",\"2025-11-30\")-1)*100,2):.2f}%'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_23f99ee972ab", "type": "percent", "answer": 3.53, "_code": "h=DanhSachHoaDon.copy(); h[\"od\"]=pd.to_datetime(h[\"Thời gian tạo\"]).dt.normalize()\nh=h[~h[\"Trạng thái\"].str.contains(\"hủy|huỷ|cancel|trả\",case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c[\"a\"]=to_num(c[\"Thành tiền\"])\nh[\"v\"]=h[\"Mã hóa đơn\"].map(c.groupby(\"Mã hóa đơn\").a.sum()).fillna(0)\n\nt=h[(h.od>=\"2025-01-01\")&(h.od<=\"2025-01-31\")]\ncc=c[c[\"Mã hóa đơn\"].isin(t[\"Mã hóa đơn\"])].copy()\ngrp=DanhSachSanPham.set_index(\"Mã hàng\")[\"Nhóm hàng(3 Cấp)\"]\ncc[\"g\"]=cc[\"Mã hàng\"].map(grp)\nRESULT=f'{cc[cc.g==\"mì gói\"].a.sum()/t.v.sum()*100:.2f}%'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b5413adfa5e3", "type": "percent", "answer": 3.84, "_code": "h=DanhSachHoaDon.drop_duplicates().copy(); h['od']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['a']=to_num(c['Thành tiền'])\nh['v']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn').a.sum()).fillna(0)\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)\nhv=h[~bad]\nr=lambda s,e,df=hv:df[(df.od>=s)&(df.od<=e)].v.sum()\nt=hv[(hv.od>='2026-05-01')&(hv.od<='2026-05-29')]\nRESULT=f\"{round(t[t['Kênh bán']=='phone'].v.sum()/t.v.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7091ad8af1ba", "type": "number", "answer": 24851400, "_code": "h=DanhSachHoaDon.copy(); h[\"od\"]=pd.to_datetime(h[\"Thời gian tạo\"]).dt.normalize()\nh=h[~h[\"Trạng thái\"].str.contains(\"hủy|huỷ|cancel|trả\",case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c[\"a\"]=to_num(c[\"Thành tiền\"])\nh[\"v\"]=h[\"Mã hóa đơn\"].map(c.groupby(\"Mã hóa đơn\").a.sum()).fillna(0)\n\nx=pd.to_datetime(DanhSachHoaDon.set_index(\"Mã hóa đơn\")[\"Thời gian tạo\"])\nh[\"hr\"]=h[\"Mã hóa đơn\"].map(x).dt.hour\nt=h[(h.od>=\"2025-09-15\")&(h.od<=\"2025-09-21\")&(h.hr>=6)&(h.hr<=13)]\nRESULT=int(round(t.v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d178ac73b943", "type": "number", "answer": 63, "_code": "h=DanhSachHoaDon.drop_duplicates().copy(); h['od']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['a']=to_num(c['Thành tiền'])\nh['v']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn').a.sum()).fillna(0)\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)\nhv=h[~bad]\nr=lambda s,e,df=hv:df[(df.od>=s)&(df.od<=e)].v.sum()\nt=h[(h.od>='2026-04-01')&(h.od<='2026-04-30')]\nRESULT=int(t['Trạng thái'].str.contains('hủy|huỷ',case=False).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b4c7592651f9", "type": "number", "answer": 284581200, "_code": "h=DanhSachHoaDon.copy(); h[\"od\"]=pd.to_datetime(h[\"Thời gian tạo\"]).dt.normalize()\nh=h[~h[\"Trạng thái\"].str.contains(\"hủy|huỷ|cancel|trả\",case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c[\"a\"]=to_num(c[\"Thành tiền\"])\nh[\"v\"]=h[\"Mã hóa đơn\"].map(c.groupby(\"Mã hóa đơn\").a.sum()).fillna(0)\n\nt=h[(h.od>=\"2026-01-01\")&(h.od<=\"2026-01-31\")&(h[\"Kênh bán\"]==\"store\")]\nRESULT=int(round(t.v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b68591b17d24", "type": "percent", "answer": -4.31, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\nd=don_hang.copy(); c=chi_tiet_don.drop_duplicates().copy()\nc['amt']=c['Amount'].map(money)\nd=d[~d['Tình trạng'].isin(['cancelled','returned'])]\nd['dt']=pd.to_datetime(d['Ngày'])\nm=c.merge(d[['Mã chứng từ','dt']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\ndef rev(y,mo): return m[(m.dt.dt.year==y)&(m.dt.dt.month==mo)].amt.sum()\na=rev(2025,9);b=rev(2025,8)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_9246992fa01b", "type": "number", "answer": 276, "_code": "df = DonHang_ChiTiet__all.copy()\nhc = [\"Mã đơn hàng\", \"Ngày đặt hàng\", \"Trạng thái đơn hàng\", \"Tên khách hàng\"]\ndf[hc] = df[hc].ffill()\ndf = df.drop_duplicates()\ndf[\"d\"] = parse_date(df[\"Ngày đặt hàng\"])\ndf[\"amt\"] = pd.to_numeric(df[\"Tổng tiền\"].astype(str).str.replace(\",\", \"\"), errors=\"coerce\")\nbad = df.groupby(\"Mã đơn hàng\")[\"Trạng thái đơn hàng\"].apply(lambda s: s.str.contains(\"hủy|huỷ|hoàn trả|hoàn hàng|trả|cancel\", case=False, na=False).any())\ndf = df[~df[\"Mã đơn hàng\"].map(bad)]\nend = pd.Timestamp(as_of_date)\nw = df[(df.d > end - pd.Timedelta(days=7)) & (df.d <= end)]\nRESULT = int(w[\"Mã đơn hàng\"].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_cdb8ae3b395e", "type": "number", "answer": 169432400, "_code": "df = DonHang_ChiTiet__all.copy()\nhc = [\"Mã đơn hàng\", \"Ngày đặt hàng\", \"Trạng thái đơn hàng\", \"Tên khách hàng\"]\ndf[hc] = df[hc].ffill()\ndf = df.drop_duplicates()\ndf[\"d\"] = parse_date(df[\"Ngày đặt hàng\"])\ndf[\"amt\"] = pd.to_numeric(df[\"Tổng tiền\"].astype(str).str.replace(\",\", \"\"), errors=\"coerce\")\nbad = df.groupby(\"Mã đơn hàng\")[\"Trạng thái đơn hàng\"].apply(lambda s: s.str.contains(\"hủy|huỷ|hoàn trả|hoàn hàng|trả|cancel\", case=False, na=False).any())\ndf = df[~df[\"Mã đơn hàng\"].map(bad)]\nend = pd.Timestamp(as_of_date)\nw = df[(df.d > end - pd.Timedelta(days=30)) & (df.d <= end)]\nRESULT = int(w[\"amt\"].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c86e099eb394", "type": "number", "answer": 79, "_code": "\nH=danh_sach_hoa_don.drop_duplicates()\nH['d']=parse_date(H['Ngày giao dịch'])\nst=H['Status'].astype(str).str.lower()\nbad=st.str.contains('hủy|huỷ|cancel|trả')\nRESULT=int(((~bad)&(H.d==as_of_date)).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a26d79f3e08a", "type": "percent", "answer": 2.18, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nh=don_hang.drop_duplicates().drop_duplicates('Mã chứng từ')\nh=h[~h['Xử lý'].isin(['cancelled','returned'])]\nh=h.assign(dt=pdate(h['NgayBan']))\nc=chi_tiet_don.drop_duplicates(); c=c.assign(v=money(c['T.Tiền']))\nh=h.assign(v=h['Mã chứng từ'].map(c.groupby('Ma don').v.sum()).fillna(0))\ndef rv(s,e): return h[(h.dt>=s)&(h.dt<=e)]\na=rv('2025-08-01','2025-08-31').v.sum();b=rv('2025-07-01','2025-07-31').v.sum()\nRESULT=f'{(a-b)/b*100:.2f}%'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_92ec4186a398", "type": "number", "answer": 10251, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nh=don_hang.drop_duplicates().drop_duplicates('Mã chứng từ')\nh=h[~h['Xử lý'].isin(['cancelled','returned'])]\nh=h.assign(dt=pdate(h['NgayBan']))\nc=chi_tiet_don.drop_duplicates(); c=c.assign(v=money(c['T.Tiền']))\nh=h.assign(v=h['Mã chứng từ'].map(c.groupby('Ma don').v.sum()).fillna(0))\ndef rv(s,e): return h[(h.dt>=s)&(h.dt<=e)]\nRESULT=len(rv('2025-10-01','2025-12-31'))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d5fd9172a424", "type": "percent", "answer": 2.22, "_code": "h=don_hang.drop_duplicates('Mã chứng từ').copy()\nd=parse_date(h['NgayBan'])\nh=h[(d>='2026-07-01')&(d<='2026-07-31')]\nRESULT=f\"{h['Xử lý'].str.contains('cancel').sum()/len(h)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_895207cf1d60", "type": "number", "answer": 53938000, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nh=don_hang.drop_duplicates().drop_duplicates('Mã chứng từ')\nh=h[~h['Xử lý'].isin(['cancelled','returned'])]\nh=h.assign(dt=pdate(h['NgayBan']))\nc=chi_tiet_don.drop_duplicates(); c=c.assign(v=money(c['T.Tiền']))\nh=h.assign(v=h['Mã chứng từ'].map(c.groupby('Ma don').v.sum()).fillna(0))\ndef rv(s,e): return h[(h.dt>=s)&(h.dt<=e)]\nm=rv('2026-05-01','2026-05-31'); g=khach_hang.set_index('ma_kh')['Nhóm']\nRESULT=int(round(m[m['Số KH'].map(g)=='thân thiết'].v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
