{"id": "q_7689df0a8440", "type": "number", "answer": 27071, "_code": "\nd=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True)\nd['dt']=parse_date(d['Ngày']); d=d.drop_duplicates()\nd=d[d['Trạng thái'].isin(['xong','Đã hoàn thành','Đang vận chuyển'])]\nx=d[(d.dt>='2026-01-01')&(d.dt<=as_of_date)]\nRESULT=int(x['Mã đơn hàng'].nunique())\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_9be15002fb02", "type": "list", "answer": [74000, 37000], "_code": "h=DanhSachHoaDon.copy()\nh=h[(h['Mã KH']=='KH0180')&(h['Phương thức thanh toán']=='Ghi nợ')&(~h['Trạng thái'].isin(['hủy đơn','Đã hủy']))]\nh['od']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh['tot']=to_num(h['Tổng sau giảm giá'])\ns=SoQuy.copy()\ns['pd']=pd.to_datetime(s['Thời gian']).dt.normalize()\ns['v']=pd.to_numeric(s['Giá trị'].astype(str).str.replace(r'\\D','',regex=True))\ns=s[s['Mã hóa đơn'].isin(h['Mã hóa đơn'])].merge(h[['Mã hóa đơn','od']],on='Mã hóa đơn')\ninm=(h.od>='2025-03-01')&(h.od<='2025-03-31')\nsame=s[s.pd==s.od].groupby('Mã hóa đơn').v.sum()\nhh=h[inm]\nthem=int((hh.tot-hh['Mã hóa đơn'].map(same).fillna(0)).sum())\ntra=int(s[(s.pd>s.od)&(s.pd>='2025-03-01')&(s.pd<='2025-03-31')].v.sum())\nRESULT=[them,tra]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_515805e7992a", "type": "date", "answer": "2025-08-30", "_code": "import re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    if not s: return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    m=re.fullmatch(r'([\\d.,]+)tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d+,\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\n\no=don_hang.drop_duplicates('Số phiếu').copy(); o['d']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().merge(o[['Số phiếu','d']],left_on='Số CT',right_on='Số phiếu')\nc=c[(c.d>='2025-08-01')&(c.d<='2025-08-31')]; c['v']=c['Tiền bán'].map(money)\nRESULT=c.groupby('d').v.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4eb8c635b75b", "type": "date", "answer": "2026-07-18", "_code": "import re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    if not s: return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    m=re.fullmatch(r'([\\d.,]+)tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d+,\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\n\no=don_hang.drop_duplicates('Số phiếu').copy(); o['d']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().merge(o[['Số phiếu','d']],left_on='Số CT',right_on='Số phiếu')\nc=c[(c.d>='2026-07-01')&(c.d<='2026-07-31')]; c['v']=c['Tiền bán'].map(money)\nRESULT=c.groupby('d').v.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_341ef54de645", "type": "percent", "answer": 0.74, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^(\\d+)[,.](\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    m=re.match(r'^[\\d,]+\\.\\d{4}$',s)       # 1,500.0000\n    if m: return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\no=don_hang.drop_duplicates().copy(); o['d']=parse_date(o['Ngày']); o=o[o['Tình trạng'].isin(['completed','shipping'])]\nl=chi_tiet_don.drop_duplicates().copy(); l['tt']=l['Amount'].map(money)\nl=l.merge(o[['Mã chứng từ','d']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\nf=lambda y,m: l[(l.d.dt.year==y)&(l.d.dt.month==m)]['tt'].sum()\nRESULT=f\"{(f(2025,11)/f(2025,10)-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_46e5d20e6422", "type": "percent", "answer": -4.73, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^(\\d+)[,.](\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    m=re.match(r'^[\\d,]+\\.\\d{4}$',s)       # 1,500.0000\n    if m: return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\no=don_hang.drop_duplicates().copy(); o['d']=parse_date(o['Ngày']); o=o[o['Tình trạng'].isin(['completed','shipping'])]\nl=chi_tiet_don.drop_duplicates().copy(); l['tt']=l['Amount'].map(money)\nl=l.merge(o[['Mã chứng từ','d']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\nf=lambda y,m: l[(l.d.dt.year==y)&(l.d.dt.month==m)]['tt'].sum()\nRESULT=f\"{(f(2026,6)/f(2026,5)-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f95fc735e3bc", "type": "percent", "answer": -36.41, "_code": "import re\ndef pm(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)(?:,(\\d+))?tr(\\d+)?',s)\n    if m:\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0')[:3])*1e3\n        else: a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        return -a if neg else a\n    m=re.fullmatch(r'(\\d+(?:,\\d+)?)k',s)\n    if m: v=float(m.group(1).replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except Exception: return float('nan')\n    return -v if neg else v\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['amt']=d['Tổng tiền'].map(pm)\nd['sq']=pd.to_numeric(d['Số lượng sản phẩm'].astype(str).str.extract(r'([\\d.]+)')[0],errors='coerce')\nd['k']=d['Tên sản phẩm'].map(normalize_text)\nsp=DanhSachSanPham[['Mã SKU','Tên sản phẩm']].merge(DanhSachThuoc,on='Mã SKU')\nsp['k']=sp['Tên sản phẩm'].map(normalize_text)\nrx=set(sp[sp['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1','1.0'])]['k'])\nd=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nqd=DanhSachQuyDoi.copy(); qd['k']=qd['Tên sản phẩm'].map(normalize_text)\nf=qd.set_index(['k','Đơn vị quy đổi'])['Tỉ lệ quy đổi'].astype(float).to_dict()\nd['f']=[f.get((k,u),1.0) for k,u in zip(d.k,d['Đơn vị tính'])]\nd['bq']=d.sq*d.f\ns=d[d.k.str.contains('strepsils cool')]\na=s[(s.dt>='2026-03-05')&(s.dt<