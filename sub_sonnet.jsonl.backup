{"id": "q_823d917dff8b", "type": "date", "answer": "2025-05", "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^(\\d+)[,.](\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    m=re.match(r'^[\\d,]+\\.\\d{4}$',s)       # 1,500.0000\n    if m: return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\ndf=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill()\ndf=df.drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày đặt hàng'])\nbad=df.loc[df['Trạng thái đơn hàng'].isin(['Đã hủy','Đã hoàn hàng']),'Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf['tt']=df['Tổng tiền'].map(money)\ndf['ym']=df.d.dt.strftime('%Y-%m')\ns=df[df.ym.isin(['2025-04','2025-05','2025-06'])].groupby('ym')['tt'].sum(); RESULT=s.idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e8370dc3aa1f", "type": "date", "answer": "2026-02-11", "_code": "\nd=Bao_cao_ban_hang__So_chi_tiet_ban_hang.drop_duplicates().copy()\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả hàng|Không giao được',case=False,na=False)]\nd['dt']=parse_date(d['Ngày']); d=d[(d.dt>='2026-02-01')&(d.dt<='2026-02-28')]\nRESULT=d.groupby('dt')['Thành tiền'].apply(lambda s:to_num(s).sum()).idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
