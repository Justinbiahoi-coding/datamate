{"id": "q_e0ce7c75c91c", "type": "percent", "answer": 19.57, "_code": "h = DanhSachHoaDon__all.copy(); h['d'] = parse_date(h['Thời gian'])\nh = h[h['d'].between('2026-04-01','2026-04-30') & ~h['Trạng thái'].str.contains('hủy|huỷ|trả|Đổi trả', case=False, na=False)]\nc = DanhSachChiTietNhapHang if False else DanhSachHoaDonChiTiet.drop_duplicates(['Mã hóa đơn','STT'])\nc = c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].merge(DanhSachSanPham[['Mã hàng','Nhóm hàng(3 Cấp)']], on='Mã hàng', how='left')\nc['t'] = to_num(c['Thành tiền'])\nRESULT = f\"{c[c['Nhóm hàng(3 Cấp)']=='chiên xào']['t'].sum()/c['t'].sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_70bb43f64fb5", "type": "date", "answer": "2025-12-29", "_code": "o = danh_sach_hoa_don.copy()\nprint_na = o[o['Ngày giao dịch'].isna()]\no['d'] = pd.to_datetime(o['Ngày giao dịch'], format='%d/%m/%Y', errors='coerce')\no['amt'] = to_num(o['Tien hang'])\ng = o[o.Status.isin(['Hoàn thành','Chờ giao']) & o.d.notna()]\nm = g[(g.d>='2025-12-01')&(g.d<='2025-12-31')].groupby('d').amt.sum()\nRESULT = m.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
