{"id": "q_f519b57113e1", "type": "percent", "answer": -26.22, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return 0.0\n    m=re.match(r'^(-?\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)tr$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000000)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)k$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000)\n    if re.match(r'^-?\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(re.sub(r'[^\\d.\\-]','',s) or 0)\ncal=pd.read_csv('train/calendar.csv'); cal['date']=pd.to_datetime(cal['date']); cal['lunar_leap']=cal['lunar_leap'].astype(str).str.lower()=='true'\ndef tet(y):\n    a=cal[(cal.lunar_year==y-1)&(cal.lunar_month==12)&(cal.lunar_day==23)&(~cal.lunar_leap)].date.iloc[0]\n    b=cal[(cal.lunar_year==y)&(cal.lunar_month==1)&(cal.lunar_day==10)&(~cal.lunar_leap)].date.iloc[0]\n    return a,b\nh=DuLieuBanHang['DanhSachHoaDon'].drop_duplicates().copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh['v']=h['Tổng tiền hàng'].map(money)\ndef rev(y):\n    a,b=tet(y); return h[(h.d>=a)&(h.d<=b)].v.sum()\ny=pd.Timestamp(as_of_date).year\na,b=rev(y),rev(y-1)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a0172ef25cac", "type": "number", "answer": 202934300, "_code": "\nd=ban_hang.copy(); d['t']=parse_date(d['Ngày tháng']); d['m']=to_num(d['Thanh tien'])\nbad=d[d['Kết quả'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã hóa đơn'].unique()\nd=d[~d['Mã hóa đơn'].isin(bad)]\nRESULT=round(d[(d.t.dt.year==2025)&(d.t.dt.month==12)].m.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7c717866acd7", "type": "percent", "answer": 0.0, "_code": "import pandas as pd, re, datetime as dt\nITEM='Trà sữa ô long (L)'; D=pd.Timestamp('2026-07-13'); N=14\nframes=[v for k,v in data.items() if k.endswith('__all')]\na=pd.concat(frames,ignore_index=True)\ncid,cdate,citem,cst,cq='Mã đơn hàng','Ngày','Tên hàng hóa','Trạng thái','Số lượng quy đổi'\na=a[a[cid].astype(str).str.startswith('ORD')].drop_duplicates()\ndef pdate(x):\n    if isinstance(x,(int,float)) and not pd.isna(x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(x))\n    if hasattr(x,'year'): return pd.Timestamp(x)\n    s=str(x).strip()\n    if re.match(r'^\\d{4}-\\d{2}-\\d{2}',s): return pd.Timestamp(s[:10])\n    return pd.to_datetime(s,dayfirst=True,errors='coerce')\na['d']=a[cdate].map(pdate)\nbad=a[cst].astype(str).str.lower().str.contains('hủy|huỷ|cancel|trả|hoàn hàng|đổi trả')\na=a[~a[cid].isin(set(a[bad][cid]))]\nx=a[a[citem].astype(str).str.strip().str.lower()==ITEM.lower()].copy()\nx['q']=pd.to_numeric(x[cq],errors='coerce')\ndef S(lo,hi): return x[(x.d>=lo)&(x.d<=hi)].q.sum()\naft=S(D,D+pd.Timedelta(days=N-1)); bef=S(D-pd.Timedelta(days=N),D-pd.Timedelta(days=1))\nprint(aft,bef,x.d.isna().sum())\nRESULT=f\"{round((aft-bef)/bef*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_918a70e73af3", "type": "percent", "answer": 2.23, "_code": "df=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).drop_duplicates()\ndf['d']=parse_date(df['Ngày'])\ndf=df[(df.d>='2026-01-01')&(df.d<='2026-01-31')]\no=df.groupby('Mã đơn hàng')['Trạng thái'].first()\nRESULT=f\"{round(o.str.contains('hủy|huỷ',case=False).sum()/len(o)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6212770ec09e", "type": "percent", "answer": 6.35, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\nd=don_hang.copy(); d['dt']=parse_date(d['NgayBan'])\nd=d[(d.dt>='2026-01-01')&(d.dt<='2026-01-31')&~d['Xử lý'].str.lower().isin(['cancelled','returned'])]\nc=chi_tiet_don[chi_tiet_don['Ma don'].isin(d['Mã chứng từ'])].copy()\nc['v']=c['T.Tiền'].map(money)\nc['g']=c['ID SP'].map(san_pham.set_index('SKU')['Nhom hang'])\nRESULT=f\"{c[c.g=='nước ép'].v.sum()/c.v.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_66380f9d73b9", "type": "percent", "answer": -7.14, "_code": "import pandas as pd, re\na=DonHang_ChiTiet__all.copy()\ncols=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[cols]=a[cols].ffill()\na=a.drop_duplicates()\ndef pdate(x):\n    if isinstance(x,(int,float)) and not pd.isna(x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(x))\n    if hasattr(x,'year'): return pd.Timestamp(x)\n    s=str(x).strip()\n    if re.match(r'^\\d{4}-\\d{2}-\\d{2}',s): return pd.Timestamp(s[:10])\n    return pd.to_datetime(s,dayfirst=True,errors='coerce')\na['d']=a['Ngày đặt hàng'].map(pdate)\nbad=a['Trạng thái đơn hàng'].astype(str).str.lower().str.contains('hủy|huỷ|cancel|trả|hoàn hàng')\na=a[~a['Mã đơn hàng'].isin(set(a[bad]['Mã đơn hàng']))]\nx=a[a['Tên sản phẩm'].astype(str).str.strip().str.lower()=='xúc xích vissan 5 cây'].copy()\nx['q']=x['Số lượng sản phẩm'].astype(str).str.extract(r'(-?\\d+(?:\\.\\d+)?)')[0].astype(float)*x['Đơn vị tính'].map(lambda u:20 if str(u).strip()=='thùng' else 1)\nD=pd.Timestamp('2025-12-25'); N=7\nS=lambda lo,hi:x[(x.d>=lo)&(x.d<=hi)].q.sum()\naft=S(D,D+pd.Timedelta(days=N-1)); bef=S(D-pd.Timedelta(days=N),D-pd.Timedelta(days=1))\nRESULT=f\"{round((aft-bef)/bef*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9fd096dfdb84", "type": "percent", "answer": 87.86, "_code": "h=DanhSachHoaDon__all.copy()\nh['ts']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nh['d']=parse_date(h['Thời gian'])\nh['t']=h['Tổng tiền hàng'].astype(str).str.replace(',','').astype(float)\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nx=h[(h.d>='2025-06-30')&(h.d<='2025-07-06')]\nhr=x.ts.dt.hour\ns=x[(hr>=6)&(hr<14)].t.sum();c=x[(hr>=14)&(hr<22)].t.sum()\nRESULT=f\"{(c/s-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fb1a1dcf3a4b", "type": "percent", "answer": -23.95, "_code": "\nimport pandas as pd\ns=So_chi_tiet_ban_hang__all.copy()\ns['dt']=parse_date(s['Ngày'])\ns['a']=pd.to_numeric(s['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\nok=s[~s['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao',case=False,na=False)]\nok=ok.drop_duplicates()\n\na=ok[(ok.dt>='2025-10-01')&(ok.dt<='2025-10-22')].a.sum()\nb=ok[(ok.dt>='2025-09-01')&(ok.dt<='2025-09-22')].a.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a0b9a08f3993", "type": "number", "answer": 74218, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return 0.0\n    m=re.match(r'^(-?\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)tr$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000000)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)k$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000)\n    if re.match(r'^-?\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(re.sub(r'[^\\d.\\-]','',s) or 0)\ndf=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True)\ndf=df[df['Mã đơn hàng'].notna()].drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày'])\ndf['v']=df['Thành tiền'].map(money)\ndf=df[~df['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]\ns=pd.Timestamp(as_of_date); mon=s-pd.Timedelta(days=s.weekday()+7); sun=mon+pd.Timedelta(days=6)\nw=df[(df.d>=mon)&(df.d<=sun)]\nimport math\nRESULT=int(math.floor(w.v.sum()/w['Mã đơn hàng'].nunique()+0.5))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f276ab43b4cc", "type": "percent", "answer": 2.18, "_code": "a=Bao_cao_ban_hang__So_chi_tiet_ban_hang.copy()\na['d']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na=a[(a.d>='2026-04-01')&(a.d<='2026-04-30')]\no=a.groupby('Mã đơn hàng')['Trạng thái'].first()\nhuy=o.str.contains('hủy|huỷ|Không giao được',case=False,na=False).sum()\nRESULT=f\"{huy/len(o)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
