{"id": "q_7549dd8eaf58", "type": "list", "answer": ["Bia Tiger lon", "Bia Sài Gòn Special lon", "Cánh gà chiên nước mắm"], "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).drop_duplicates()\nst=df['Trạng thái'].astype(str).str.lower()\nbad=set(df.loc[st.str.contains('hủy|huỷ|trả'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf=df[~df['Tên hàng hóa'].astype(str).str.lower().str.contains('phí phục vụ')]\ndf['d']=parse_date(df['Ngày']); df['q']=df['Số lượng quy đổi'].map(m)\nw=df[(df.d>='2026-06-01')&(df.d<'2026-07-01')]\nRESULT=list(w.groupby('Tên hàng hóa').q.sum().sort_values(ascending=False).head(3).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3e57e05816fb", "type": "string", "answer": "Xi măng Hà Tiên PCB40 bao 50kg", "_code": "d=ban_hang.drop_duplicates().copy()\nd=d[~d['trang_thai'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd['d']=parse_date(d['Ngày']); d['q']=to_num(d['Quy ra ĐV lẻ'])\nd=d[(d.d.dt.year==2026)&(d.d.dt.month==5)]\nd['k']=d['Sản phẩm'].str.lower().str.split().str.join(' ')\ntop=d.groupby('k')['q'].sum().idxmax()\nRESULT=d[d.k==top]['Sản phẩm'].value_counts().index[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c164d6293108", "type": "number", "answer": 35, "_code": "h=DanhSachHoaDon__all.drop_duplicates().copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[(h.d.dt.year==2026)&(h.d.dt.month==6)]\nc=h[h['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nRESULT=int(c['Mã hóa đơn'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
