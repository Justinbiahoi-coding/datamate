{"id": "q_37177a05844b", "type": "list", "answer": ["Thân Anh An", "Tăng Đức Hải", "Lý Khánh Đức", "Bùi Thanh Duy", "Đào Ngọc Lan"], "_code": "df=DonHang_ChiTiet[DonHang_ChiTiet['Tên sản phẩm'].notna()].copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False,na=False)]\ndf=df[(df.d>='2025-09-01')&(df.d<='2025-09-30')]\ndf=df[df['Tên khách hàng'].notna() & ~df['Tên khách hàng'].str.strip().str.lower().isin(['lẻ','khách lẻ','kl'])]\ndf['tt']=to_num(df['Tổng tiền'])\ndf['k']=df['Tên khách hàng'].apply(normalize_text)\ng=df.groupby('k').agg(t=('tt','sum'),n=('Tên khách hàng','first')).sort_values('t',ascending=False)\nRESULT=list(g.n[:5])\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_db770627db21", "type": "percent", "answer": 10.17, "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    sg=-1 if s.startswith('-') else 1\n    s=s.lstrip('-').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return sg*(int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0))\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)\\s*k',s)\n    if m: return sg*float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return sg*float(s)\n    except: return float('nan')\n\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy(); l=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nh['dt']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nl['t']=l['Thành tiền'].map(money)\nh['r']=h['Mã hóa đơn'].map(l.groupby('Mã hóa đơn').t.sum())\nv=h[h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\n\np=DanhSachSanPham\nw=v[(v.dt>='2026-02-01')&(v.dt<='2026-02-28')]\nl2=l[l['Mã hóa đơn'].isin(w['Mã hóa đơn'])].copy()\nl2['g']=l2['Mã hàng'].map(dict(zip(p['Mã hàng'],p['Nhóm hàng(3 Cấp)'])))\nRESULT=f\"{l2[l2.g=='giảm đau hạ sốt'].t.sum()/l2.t.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_afbe1c75c766", "type": "list", "answer": ["Đoàn Mai Hồng", "Trương Hồng Lan", "Vũ Bảo Hạnh", "Tạ Chi Đức", "Hồ Linh Khoa"], "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    sg=-1 if s.startswith('-') else 1\n    s=s.lstrip('-').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return sg*(int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0))\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)\\s*k',s)\n    if m: return sg*float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return sg*float(s)\n    except: return float('nan')\n\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy(); l=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nh['dt']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nl['t']=l['Thành tiền'].map(money)\nh['r']=h['Mã hóa đơn'].map(l.groupby('Mã hóa đơn').t.sum())\nv=h[h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\n\nw=v[(v.dt>='2025-03-01')&(v.dt<='2025-03-31')&v['Mã KH'].notna()]\ng=w.groupby('Mã KH').r.sum().reset_index().sort_values(['r','Mã KH'],ascending=[False,True]).head(5)\nnm=dict(zip(DanhSachKhachHang['Mã khách hàng'],DanhSachKhachHang['Tên khách hàng']))\nRESULT=[nm[k] for k in g['Mã KH']]\n", "_attempts": 1, "_verdict": "correct"}
