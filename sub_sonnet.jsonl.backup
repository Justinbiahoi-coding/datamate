{"id": "q_9bc44da7a632", "type": "boolean", "answer": true, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True); d['t']=parse_date(d['Ngày'])\nd=d[d['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng'])]\ndef m(y,mo):\n    x=d[(d.t.dt.year==y)&(d.t.dt.month==mo)]; return to_num(x['Thành tiền']).sum()\na,b,c=m(2025,3),m(2025,4),m(2025,5)\nRESULT=bool(a<b<c)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9c77a00e8131", "type": "list", "answer": [1249474500, 1332037000, 1312108000], "_code": "d=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True); d['t']=parse_date(d['Ngày'])\nd=d[d['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng'])]\ndef m(y,mo):\n    x=d[(d.t.dt.year==y)&(d.t.dt.month==mo)]; return int(to_num(x['Thành tiền']).sum())\nRESULT=[m(2025,11),m(2025,12),m(2026,1)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_153f4e995558", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Mai Trang Dũng", 174667], ["Ngô Thảo Châu", 149500], ["Lưu Hà An", 90000]]}, "_code": "import re\ndg=lambda s: pd.to_numeric(s.astype(str).str.replace(r'\\D','',regex=True),errors='coerce').fillna(0)\nh=DanhSachHoaDon.copy(); h['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].isin(['hủy đơn','Đã hủy'])&(h['Phương thức thanh toán']!='Thu hộ (COD)')&(h.d<=as_of_date)]\np=SoQuy.copy(); p['t']=pd.to_datetime(p['Thời gian'].astype(str).str[:10],errors='coerce'); p=p[p.t<=as_of_date]\np['v']=dg(p['Giá trị']); paid=p.groupby('Mã hóa đơn').v.sum()\nh['debt']=dg(h['Tổng sau giảm giá'])-h['Mã hóa đơn'].map(paid).fillna(0)\nh=h[(h.debt>0)&h['Mã KH'].notna()]\ng=h.groupby('Mã KH').debt.sum().sort_values(ascending=False).head(3)\nnm=DanhSachKhachHang.set_index('Mã khách hàng')['Tên khách hàng'].astype(str).str.replace(r'\\s*[-\\(]*\\s*[\\d\\s]{9,}\\)?','',regex=True).str.strip()\nRESULT={\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[nm.get(k,k),int(v)] for k,v in g.items()]}\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ee111ef6c6ef", "type": "date", "answer": "2026-03-12", "_code": "h=DanhSachHoaDon__all.copy(); h['d']=parse_date(h['Thời gian'])\nh=h[h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])&(h.d>='2026-03-01')&(h.d<='2026-03-31')]\nc=DanhSachHoaDonChiTiet.drop_duplicates()[DanhSachHoaDonChiTiet['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['v']=to_num(c['Thành tiền']); c=c.merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\nRESULT=c.groupby('d').v.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 2, "_verdict": "correct"}
