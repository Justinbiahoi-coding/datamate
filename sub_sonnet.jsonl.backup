{"id": "q_076dfb541ac4", "type": "number", "answer": 255203400, "_code": "h=DanhSachHoaDon__all.copy(); h['d']=parse_date(h['Thời gian'])\nh=h[(h.d>='2025-02-01')&(h.d<='2025-02-28')&~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().merge(h[['Mã hóa đơn']],on='Mã hóa đơn')\nt=DanhSachThuoc.copy(); t['rx']=t['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1','1.0'])\nc=c.merge(t[['Mã hàng','rx']],on='Mã hàng',how='left')\nc=c[c.rx!=True]\nRESULT=int(round(to_num(c['Thành tiền']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_569bfbc0514b", "type": "percent", "answer": -26.54, "_code": "import re,unicodedata as u\nnm=lambda s:' '.join(u.normalize('NFC',str(s)).casefold().split())\ndef money(x):\n    s=str(x).strip().lower().replace('đ','')\n    if s in('','nan','none'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m: v=int(m.group(1))*1e6+(int((m.group(2)+'000')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    else:\n        s=s.replace(',','') if re.search(r',\\d{3}',s) else s.replace(',','.')\n        if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): s=s.replace('.','')\n        v=float(s)\n    return -v if neg else v\n\ndf=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[c]=df[c].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False)]\ndf['v']=df['Tổng tiền'].map(money)\na=df[(df.d>='2025-11-01')&(df.d<='2025-11-04')].v.sum(); b=df[(df.d>='2025-10-01')&(df.d<='2025-10-04')].v.sum()\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
