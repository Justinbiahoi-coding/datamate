{"id": "q_4a21596d5124", "type": "percent", "answer": -6.73, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\ndf=DonHang_ChiTiet.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\nd=parse_date(df['Ngày đặt hàng'])\nok=~df['Trạng thái đơn hàng'].str.contains(BAD,case=False,na=False)\np=df['Tên sản phẩm'].eq('Prospan siro ho chai 100ml')\nq=pd.to_numeric(df['Số lượng sản phẩm'],errors='coerce')\nD=pd.Timestamp('2025-07-29')\na=q[ok&p&(d>=D)&(d<D+pd.Timedelta(days=30))].sum()\nb=q[ok&p&(d>=D-pd.Timedelta(days=30))&(d<D)].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bfb16a0db32e", "type": "number", "answer": 19560000, "_code": "import re,sys\ndf=ban_hang.drop_duplicates()\na=df['Amount'].astype(str)\nprint(a[~a.str.match(r'^[\\d,\\.]+$')].unique()[:20],file=sys.stderr)\nd=parse_date(df['Ngày bán'])\nm=(d=='2025-12-19')&~df['Trạng thái xử lý'].str.contains('hủy|huỷ|trả',case=False,na=False)\nRESULT=int(to_num(a[m]).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_768b90abba7a", "type": "percent", "answer": 73.56, "_code": "import unicodedata,re\ns=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\ns['d']=pd.to_datetime(s['Giờ'],errors='coerce')\nbad=s[s['Ghi chú TT'].str.contains('hủy|huỷ|trả|hoàn hàng',case=False,na=False)]['Mã phiếu'].unique()\ns=s[~s['Mã phiếu'].isin(bad)]\ns=s[(s.d.dt.year==2026)&(s.d.dt.month==1)]\ndef nk(x):\n    return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(x)).lower().strip())\ns['k']=s['TenKH'].map(nk)\ns=s[~s['k'].isin(['lẻ','khách lẻ','kl','khach le','le','']) & s['TenKH'].notna()]\nn=s.groupby('k')['Mã phiếu'].nunique()\nRESULT=f\"{(n>=3).mean()*100:.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_33d62334679f", "type": "number", "answer": 2, "_code": "a=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\na['d']=parse_date(a['Ngày']); a['v']=to_num(a['Thành tiền'])\na=a[~a['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\nimport unicodedata as u, re\ndef key(s): return re.sub(r'\\s+',' ',u.normalize('NFD',str(s).replace('đ','d').replace('Đ','D')).encode('ascii','ignore').decode().lower()).strip()\na['k']=a['Tên hàng hóa'].map(key)\nbefore=set(a[a.d<'2025-10-05'].k); inp=set(a[(a.d>='2025-10-05')&(a.d<='2025-10-11')].k)\nRESULT=len(before-inp)\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_f87f57532f37", "type": "percent", "answer": -2.3, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\ndf=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\nd=parse_date(df['Ngày đặt hàng'])\nok=~df['Trạng thái đơn hàng'].str.contains(BAD,case=False,na=False)\np=df['Tên sản phẩm'].map(normalize_text).eq('plusssz max multivitamin vien sui tuyp 20 vien')\nq=pd.to_numeric(df['Số lượng sản phẩm'],errors='coerce')\nD=pd.Timestamp('2025-10-29')\na=q[ok&p&(d>=D)&(d<D+pd.Timedelta(days=30))].sum()\nb=q[ok&p&(d>=D-pd.Timedelta(days=30))&(d<D)].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ae62e96933e5", "type": "number", "answer": 237315600, "_code": "h=DuLieuBanHang__DanhSachHoaDon.copy().drop_duplicates()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.copy().drop_duplicates(); c['amt']=to_num(c['Thành tiền'])\nh['rev']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn').amt.sum()).fillna(0)\nRESULT=int(round(h[(h.d>='2025-11-01')&(h.d<='2025-11-30')].rev.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8a6f40f8b51b", "type": "percent", "answer": -33.1, "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)[.,]?(\\d*)tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if c: return float(a)*1e6+float(c)*10**(6-len(c))\n        return float(a+'.'+(b or '0'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m:\n        t=m.group(1)\n        return float(t.replace('.','').replace(',',''))*1000 if re.search(r'[.,]\\d{3}$',t) else float(t.replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\nd=don_hang.copy(); d['dt']=pd.to_datetime(d['Ngày bán'])\nok=d[d['Tình trạng đơn'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().copy(); c['v']=c['Tiền bán'].apply(money)\nc=c.merge(ok[['Số phiếu','dt']],left_on='Số CT',right_on='Số phiếu')\ndef rev(a,b): return c[(c.dt>=a)&(c.dt<=b)].v.sum()\ncur=rev('2026-02-01','2026-02-28'); prev=rev('2026-01-01','2026-01-31')\nRESULT=f\"{round((cur-prev)/prev*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b6d86f76cfc9", "type": "percent", "answer": 3.66, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s.startswith('-'): return -money(s[1:])\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        a,b=m.groups(); return int(a)*1000000+(int(b)*10**(6-len(b)) if b else 0)\n    m=re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return int(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\nd=DonHang_ChiTiet.copy()\nhc=[c for c in d.columns if d[c].isna().mean()>0.3 and c not in ('Tên sản phẩm','Số lượng sản phẩm','Giá sản phẩm','Tổng tiền','Đơn vị tính')]\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nlo=DuLieuXuat['DonHang_Lo'].copy(); lo['Mã đơn hàng']=lo['Mã đơn hàng'].ffill()\nretids=set(lo.loc[pd.to_numeric(lo['Số lượng trả'],errors='coerce')>0,'Mã đơn hàng'])\nbad=d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)|d['Mã đơn hàng'].isin(retids)\nd=d[~bad&(d['dt']>='2025-06-01')&(d['dt']<='2025-06-30')].copy()\nd['v']=d['Tổng tiền'].map(money)\nsp=DuLieuXuat['DanhSachSanPham']; th=DuLieuXuat['DanhSachThuoc']\nrx=th[th['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1','1.0'])]['Mã SKU'].astype(str).str.strip()\nnames=set(sp[sp['Mã SKU'].astype(str).str.strip().isin(rx)]['Tên sản phẩm'].map(vn_normalize))\ntot=d['v'].sum(); r=d[d['Tên sản phẩm'].map(vn_normalize).isin(names)]['v'].sum()\nRESULT=f\"{round(r/tot*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
