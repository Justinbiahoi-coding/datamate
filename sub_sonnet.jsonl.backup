{"id": "q_5258a06d7513", "type": "number", "answer": 833310100, "_code": "import re, unicodedata\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    t=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=t.startswith('-'); t=t.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',t)\n    if m:\n        a=int(m.group(1))*1_000_000; r=m.group(2)\n        v=a+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n    elif t.endswith('k'): v=float(t[:-1].replace(',','.'))*1000\n    else: v=float(re.sub(r'[.,]','',t))\n    return -v if neg else v\ndef qty(x):\n    if isinstance(x,(int,float)): return float(x)\n    m=re.match(r'\\s*(-?\\d+(?:[.,]\\d+)?)',str(x)); return float(m.group(1).replace(',','.'))\ns=SoBanHang__all.copy()\ns['dt']=pd.to_datetime(s['Giờ'],errors='coerce')\ns=s[s.dt.notna()&s['Mã phiếu'].notna()].drop_duplicates()\nst=s['Ghi chú TT'].astype(str).str.lower()\nbadm=set(s[st.str.contains('hủy|trả')|(s['Số lượng hàng'].map(qty)<0)]['Mã phiếu'])\ns=s[~s['Mã phiếu'].isin(badm)].copy()\ns['tien']=s['Tiền'].map(money); s['q']=s['Số lượng hàng'].map(qty)\nm=s[(s.dt>='2025-05-01')&(s.dt<'2025-06-01')&(s.dt.dt.hour>=6)&(s.dt.dt.hour<14)]\nRESULT=int(round(m.tien.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_472c2aa8e370", "type": "number", "answer": 150871500, "_code": "d=SoBanHang.copy()\nd['ngay_ban']=d['ngay_ban'].ffill()\nd['dt']=pd.Timestamp('1899-12-30')+pd.to_timedelta(d['ngay_ban'],unit='D')\nd=d[(d['dt']>='2025-07-01')&(d['dt']<'2025-08-01')&d['Trạng thái xử lý'].isin(['Đã hoàn thành','đang gửi'])]\nRESULT=int(to_num(d['Tổng tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f512a1665ff9", "type": "number", "answer": 496800, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in('','nan','none'): return 0.0\n    m=1\n    if s.endswith('tr'): m=1e6; s=s[:-2]\n    elif s.endswith('k'): m=1000; s=s[:-1]\n    s=re.sub(r'[đd₫\\s]|vnd','',s)\n    if re.fullmatch(r'-?\\d{1,3}([.,]\\d{3})+',s): s=re.sub(r'[.,]','',s)\n    else: s=s.replace(',','.')\n    return float(s)*m\nn=DanhSachNhapHang.copy()\nn=n[~n['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nn['d']=parse_date(n['Thời gian'])\nn=n[(n.d>='2025-04-01')&(n.d<='2025-04-30')]\nL=DanhSachChiTietNhapHang.merge(n[['Mã nhập hàng']],on='Mã nhập hàng')\nL=L[(L['Mã hàng']=='SP0022')&(L['ĐVT']=='thùng')]\nL['g']=L['Đơn giá'].map(money); L['q']=L['Số lượng'].map(money)\nRESULT=int(round((L.g*L.q).sum()/L.q.sum()))\n", "_attempts": 1, "_verdict": "correct"}
