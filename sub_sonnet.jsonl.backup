{"id": "q_3692d7766dba", "type": "percent", "answer": 6.19, "_code": "o=don_hang.copy(); o['d']=parse_date(o['NgayBan'])\no=o[~o['Xử lý'].isin(['cancelled','returned'])]\no=o[(o.d>='2025-06-01')&(o.d<='2025-06-30')]\nc=chi_tiet_don[chi_tiet_don['Ma don'].isin(o['Mã chứng từ'])].copy()\nc['v']=to_num(c['T.Tiền'])\nc=c.merge(san_pham[['SKU','Nhom hang']].drop_duplicates('SKU'),left_on='ID SP',right_on='SKU',how='left')\ntot=c.v.sum()\ng=c[c['Nhom hang'].astype(str).str.lower().str.contains('sinh tố')].v.sum()\nRESULT=f\"{g/tot*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
