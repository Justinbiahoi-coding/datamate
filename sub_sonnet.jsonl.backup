{"id": "q_250cf7d222c0", "type": "date", "answer": "2029-05-12", "_code": "\nsp=san_pham[san_pham['TenGoi'].str.lower().str.contains('acyclovir stella kem 5%',na=False)]\nprint(sp[['MaHangHoa','TenGoi']])\nmh=sp.iloc[0]['MaHangHoa']\nlo=lo_hang[lo_hang.MaHangHoa==mh].copy()\nlo['in']=pd.to_numeric(lo.SLNhapQuyDoi)\nd=chi_tiet_don_lo.merge(don_hang[['MaHoaDon','TinhTrang','NgayLap']],on='MaHoaDon')\nd=d[~d.TinhTrang.isin(['cancelled'])]\nd['net']=pd.to_numeric(d.SLQuyDoi)-pd.to_numeric(d.SLTraQuyDoi).fillna(0)\nd=d[parse_date(d.NgayLap)<=as_of_date]\nout=d.groupby('MaLo').net.sum()\nlo['rem']=lo['in']-lo.MaLo.map(out).fillna(0)\nlo['hsd']=parse_date(lo.HanSuDung)\nprint(lo[['MaLo','hsd','in','rem']].sort_values('hsd'))\nk=lo[(lo.rem>0)&(lo.hsd>=as_of_date)].sort_values('hsd')\nRESULT=str(k.iloc[0].hsd.date())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5db586652e91", "type": "list", "answer": ["Phạm Chi Quang", "Thái Thu Thu", "Phạm Hiếu Minh"], "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan','none'): return float('nan')\n    m=re.match(r'^(\\d+)\\s*tr\\s*(\\d*)$',s.replace(',','.')) if 'tr' in s else None\n    if m:\n        frac=m.group(2); return int(m.group(1))*1e6+(int(frac.ljust(3,'0')[:3])*1000 if frac else 0)\n    m=re.match(r'^(\\d+(?:[.,]\\d+)?)\\s*k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    try: return float(s)\n    except: return float('nan')\nd=DonHang_ChiTiet.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[(d.dt>='2025-04-01')&(d.dt<='2025-04-30')&~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False,na=False)]\nd=d[~d['Tên khách hàng'].astype(str).str.lower().str.strip().str.replace(r'\\s+',' ',regex=True).isin(['khách lẻ','lẻ','kl','khach le','vãng lai','khách vãng lai','nan','','kh lẻ','kh le'])]\nd['k']=d['Tên khách hàng'].map(lambda s:' '.join(str(s).lower().split()))\nd['a']=d['Tổng tiền'].map(money)\ncanon=d.groupby('k')['Tên khách hàng'].agg(lambda x:x.value_counts().index[0])\ns=d.groupby('k').a.sum().sort_values(ascending=False)\nRESULT=[canon[k] for k in s.index[:3]]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_d3d8857e8542", "type": "date", "answer": "2025-09-01", "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','')\n    if s in ('nan',''): return 0.0\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    return float(re.sub(r'[.,]','',s))\ndf=ban_hang.drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày'])\nbad=df[df['trang_thai'].str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False,na=False)]['Mã GD'].unique()\ndf=df[~df['Mã GD'].isin(bad)]\ndf=df[(df.d>='2025-09-01')&(df.d<='2025-09-30')]\ndf['tt']=df['Tổng'].apply(money)\nRESULT=df.groupby('d').tt.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9c81a130f93c", "type": "percent", "answer": 2.4, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    x=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if x in ('','nan','none'): return 0.0\n    neg=x.startswith('-'); x=x.lstrip('-')\n    m=re.match(r'^(\\d+)(?:[.,](\\d+))?tr(\\d+)?$',x)\n    if m:\n        v=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        if m.group(3): v=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0')[:3])*1e3\n    elif re.match(r'^\\d+(\\.\\d+)?k$',x): v=float(x[:-1])*1e3\n    elif ',' in x and '.' in x: v=float(x.replace(',',''))\n    elif re.match(r'^\\d{1,3}([.,]\\d{3})+$',x): v=float(re.sub(r'[.,]','',x))\n    else: v=float(x.replace(',','.'))\n    return -v if neg else v\nd=DonHang_ChiTiet.copy()\nd[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']]=d[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']].ffill()\nd=d.drop_duplicates().reset_index(drop=True)\nd['dt']=parse_date(d['Ngày đặt hàng'])\nbad=d.groupby('Mã đơn hàng')['Trạng thái đơn hàng'].apply(lambda s:s.str.contains('hủy|huỷ|cancel|hoàn hàng|trả',case=False,na=False).any())\nd=d[~d['Mã đơn hàng'].map(bad).astype(bool)&(d.dt>='2026-08-01')&(d.dt<='2026-08-31')].copy()\nd['v']=d['Tổng tiền'].map(money)\nsp=DuLieuXuat__DanhSachSanPham; th=DuLieuXuat__DanhSachThuoc\nrx=set(th[th['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1'])]['Mã SKU'])\nnm=dict(zip(sp['Tên sản phẩm'].map(normalize_text),sp['Mã SKU']))\nd['sku']=d['Tên sản phẩm'].map(normalize_text).map(nm)\nRESULT=f\"{round(d[d.sku.isin(rx)].v.sum()/d.v.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b08e3eda8d97", "type": "percent", "answer": 15.44, "_code": "a=data['So_chi_tiet_ban_hang__all'].copy()\na['d']=parse_date(a['Ngày']); a['v']=to_num(a['Thành tiền'])\nbad=a.groupby('Mã đơn hàng')['Trạng thái'].apply(lambda s:s.str.contains('hủy|huỷ|trả',case=False).any())\na=a.drop_duplicates()\na=a[~a['Mã đơn hàng'].map(bad)&(a.d>='2026-02-01')&(a.d<='2026-02-28')]\ng=data[__import__('unicodedata').normalize('NFD','Danh sách hàng hóa')][['Tên hàng hóa','Nhóm hàng hóa']].drop_duplicates('Tên hàng hóa')\na=a.merge(g,on='Tên hàng hóa',how='left')\nRESULT=f\"{round(a[a['Nhóm hàng hóa'].str.contains('gas',case=False,na=False)].v.sum()/a.v.sum()*100,2)}%\"\nprint(g['Nhóm hàng hóa'].unique())\n", "_attempts": 2, "_verdict": "correct"}
