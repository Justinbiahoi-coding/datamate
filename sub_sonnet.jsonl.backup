{"id": "q_f8463af39982", "type": "percent", "answer": -3.41, "_code": "h=DanhSachHoaDon__all.dropna(subset=['Mã hóa đơn']).drop_duplicates().drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['v']=to_num(c['Thành tiền'])\nh['r']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn')['v'].sum()).fillna(0)\ndef m(y,mo): return h[(h.d.dt.year==y)&(h.d.dt.month==mo)].r.sum()\nRESULT=f\"{round((m(2026,6)/m(2026,5)-1)*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c0b6cce2561c", "type": "percent", "answer": 23.64, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).dropna(subset=[\"Mã đơn hàng\"]).drop_duplicates()\nd=d.assign(dt=parse_date(d[\"Ngày\"]),v=to_num(d[\"Thành tiền\"]),q=to_num(d[\"Số lượng quy đổi\"]))\nbad=d[d[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả\",case=False)][\"Mã đơn hàng\"]\nd=d[~d[\"Mã đơn hàng\"].isin(bad)]\ndef rev(a,b): return d[(d.dt>=a)&(d.dt<=b)].v.sum()\ns=d[d[\"Tên hàng hóa\"]==\"Sụn gà rang muối\"]\na=s[(s.dt>=\"2025-11-14\")&(s.dt<=\"2025-11-20\")].q.sum(); b=s[(s.dt>=\"2025-11-07\")&(s.dt<=\"2025-11-13\")].q.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e39203487afa", "type": "number", "answer": 1195004500, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).dropna(subset=[\"Mã đơn hàng\"]).drop_duplicates()\nd=d.assign(dt=parse_date(d[\"Ngày\"]),v=to_num(d[\"Thành tiền\"]),q=to_num(d[\"Số lượng quy đổi\"]))\nbad=d[d[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả\",case=False)][\"Mã đơn hàng\"]\nd=d[~d[\"Mã đơn hàng\"].isin(bad)]\ndef rev(a,b): return d[(d.dt>=a)&(d.dt<=b)].v.sum()\nRESULT=int(round(rev(\"2025-05-10\",\"2025-06-08\")))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4cb3efa8bd01", "type": "percent", "answer": 38.88, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).dropna(subset=[\"Mã đơn hàng\"]).drop_duplicates()\nd=d.assign(dt=parse_date(d[\"Ngày\"]),v=to_num(d[\"Thành tiền\"]),q=to_num(d[\"Số lượng quy đổi\"]))\nbad=d[d[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả\",case=False)][\"Mã đơn hàng\"]\nd=d[~d[\"Mã đơn hàng\"].isin(bad)]\ndef rev(a,b): return d[(d.dt>=a)&(d.dt<=b)].v.sum()\na=rev(\"2025-03-01\",\"2025-03-15\"); b=rev(\"2025-02-01\",\"2025-02-15\")\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6d07710033dd", "type": "number", "answer": 274, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\ndf=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).drop_duplicates()\ndf=df[df['Mã đơn hàng'].notna()&df['Tên hàng hóa'].notna()&df['Ngày'].notna()].copy()\nd=parse_date(df['Ngày'])\nbadord=set(df.loc[df['Trạng thái'].str.contains(BAD,case=False,na=False),'Mã đơn hàng'])\nm=(d>='2026-06-01')&(d<='2026-06-30')&~df['Mã đơn hàng'].isin(badord)\nx=df[m].assign(t=df[m]['Thành tiền'].map(money)).groupby('Mã đơn hàng')['t'].sum()\nRESULT=int((x>=1000000).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8d8a38a0ab68", "type": "percent", "answer": 1.96, "_code": "d=don_hang.drop_duplicates('Mã chứng từ').copy(); d['dt']=parse_date(d['NgayBan'])\nm=d[(d.dt>='2025-08-01')&(d.dt<='2025-08-31')]\nRESULT=f\"{round((m['Xử lý']=='cancelled').sum()/len(m)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ab9ee17a32b3", "type": "percent", "answer": -3.56, "_code": "d=don_hang.drop_duplicates('Mã chứng từ').copy(); d['dt']=parse_date(d['NgayBan'])\nok=d[d['Xử lý'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().merge(ok[['Mã chứng từ','dt']],left_on='Ma don',right_on='Mã chứng từ')\nc['v']=pd.to_numeric(c['T.Tiền'],errors='coerce')\nrev=lambda a,b:c[(c.dt>=a)&(c.dt<=b)].v.sum()\ncur=rev('2025-07-01','2025-07-31');prev=rev('2025-06-01','2025-06-30')\nRESULT=f\"{round((cur-prev)/prev*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_93f7a1e8c0c1", "type": "percent", "answer": 73.68, "_code": "df=DonHang_ChiTiet.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[h]=df[h].ffill()\ndf=df.drop_duplicates()\ndf=df[df['Tên sản phẩm'].astype(str).str.contains('Prospan siro ho chai 100ml')]\nd=parse_date(df['Ngày đặt hàng'])\nok=~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)\nq=to_num(df['Số lượng sản phẩm'])\nD=pd.Timestamp('2025-07-29'); w=pd.Timedelta(days=7)\na=q[ok&(d>=D)&(d<D+w)].sum(); b=q[ok&(d>=D-w)&(d<D)].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
