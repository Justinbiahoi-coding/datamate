{"id": "q_ff04cc0fa5a6", "type": "number", "answer": 159004500, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in('','nan','none'): return 0.0\n    m=1\n    if s.endswith('tr'): m=1e6; s=s[:-2]\n    elif s.endswith('k'): m=1000; s=s[:-1]\n    s=re.sub(r'[đd₫\\s]|vnd','',s)\n    if re.fullmatch(r'-?\\d{1,3}([.,]\\d{3})+',s): s=re.sub(r'[.,]','',s)\n    else: s=s.replace(',','.')\n    return float(s)*m\nO=don_hang.drop_duplicates('Số phiếu').copy()\nO=O[O['Tình trạng đơn'].isin(['completed','shipping'])]\nO['d']=parse_date(O['Ngày bán'])\nG=san_pham[san_pham['Nhom hang']=='chiên xào']['Mã HH']\nL=chi_tiet_don.drop_duplicates().merge(O[['Số phiếu','d']],left_on='Số CT',right_on='Số phiếu')\nL=L[L['Mã hàng bán'].isin(G)]\nL['tt']=L['Tiền bán'].map(money)\nx=L[(L.d>='2025-02-01')&(L.d<='2025-02-28')]\nRESULT=int(round(x.tt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7cb0a11fcdf0", "type": "number", "answer": 198995000, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in('','nan','none'): return 0.0\n    m=1\n    if s.endswith('tr'): m=1e6; s=s[:-2]\n    elif s.endswith('k'): m=1000; s=s[:-1]\n    s=re.sub(r'[đd₫\\s]|vnd','',s)\n    if re.fullmatch(r'-?\\d{1,3}([.,]\\d{3})+',s): s=re.sub(r'[.,]','',s)\n    else: s=s.replace(',','.')\n    return float(s)*m\nO=don_hang.drop_duplicates('Số phiếu').copy()\nO=O[O['Tình trạng đơn'].isin(['completed','shipping'])]\nO['d']=parse_date(O['Ngày bán'])\nG=san_pham[san_pham['Nhom hang']=='chiên xào']['Mã HH']\nL=chi_tiet_don.drop_duplicates().merge(O[['Số phiếu','d']],left_on='Số CT',right_on='Số phiếu')\nL=L[L['Mã hàng bán'].isin(G)]\nL['tt']=L['Tiền bán'].map(money)\nx=L[(L.d>='2026-01-01')&(L.d<='2026-01-31')]\nRESULT=int(round(x.tt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2073441b0705", "type": "number", "answer": 342, "_code": "import re\ndef pm(x):\n    s=str(x).lower().strip().replace('đ','').replace(' ','')\n    if s in ('nan',''): return 0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr'); a=a.replace(',','.')\n        v=float(a)*1e6 + (int(b.ljust(3,'0'))*1000 if b else 0)\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\nd=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\nd['dt']=parse_date(d['Giờ'])\nd['v']=d['Tiền'].map(pm)\nbad=d['Ghi chú TT'].str.contains('hủy|huỷ|trả|hoàn hàng',case=False,na=False)\nbad_ids=set(d[bad]['Mã phiếu'])\ng=d.groupby('Mã phiếu').agg(dt=('dt','min'),v=('v','sum'),gio=('Giờ','min'))\ng=g[~g.index.isin(bad_ids)]\ng=g[(g.dt>='2025-01-01')&(g.dt<'2025-02-01')]\nRESULT=int((g.v>=560000).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_eb86182b21dd", "type": "percent", "answer": 40.23, "_code": "h=BanHang_HoaDon.copy(); c=BanHang_ChiTietHoaDon.copy()\nh['d']=parse_date(h['Ngày bán'])\nh=h[h['Trạng thái'].isin(['Đã giao','Đang vận chuyển'])]\nc=c.drop_duplicates(); c=c[c['Ma hang']=='SP0010'].copy(); c['q']=to_num(c['SL cơ bản'])\nm=c.merge(h[['Order ID','d']],left_on='Mã giao dịch',right_on='Order ID')\nD=pd.Timestamp('2025-08-18'); N=14\na=m[(m.d>=D)&(m.d<D+pd.Timedelta(days=N))].q.sum()\nb=m[(m.d>=D-pd.Timedelta(days=N))&(m.d<D)].q.sum()\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_e735d1d1fa90", "type": "number", "answer": 78713200, "_code": "import re\ndef pm(x):\n    s=str(x).lower().strip().replace('đ','').replace(' ','')\n    if s in ('nan',''): return 0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr'); a=a.replace(',','.')\n        v=float(a)*1e6 + (int(b.ljust(3,'0'))*1000 if b else 0)\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\nd=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\nd['dt']=parse_date(d['Giờ'])\nd['v']=d['Tiền'].map(pm)\nbad=d['Ghi chú TT'].str.contains('hủy|huỷ|trả|hoàn hàng',case=False,na=False)\nbad_ids=set(d[bad]['Mã phiếu'])\ng=d.groupby('Mã phiếu').agg(dt=('dt','min'),v=('v','sum'),gio=('Giờ','min'))\ng=g[~g.index.isin(bad_ids)]\ng=g[(g.dt>='2026-04-20')&(g.dt<'2026-04-27')]\nh=pd.to_datetime(g.gio).dt.hour\nRESULT=int(g[(h>=14)&(h<=21)].v.sum())\n", "_attempts": 1, "_verdict": "correct"}
