{"id": "q_7e4999ddabcf", "type": "number", "answer": 23800000, "_code": "a=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\na['od']=parse_date(a['Ngày']); a['m']=to_num(a['Thành tiền'])\nbadids=set(a[a['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False)]['Mã đơn hàng'])\ng=a[~a['Mã đơn hàng'].isin(badids)]\nr=lambda s,e,df=g:df[(df.od>=s)&(df.od<=e)].m.sum()\nRESULT=int(round(r('2026-02-01','2026-02-28',g[g['Tên hàng hóa'].str.strip()=='Xi măng INSEE Power-S bao 50kg'])))\n", "_attempts": 1, "_verdict": "correct"}
