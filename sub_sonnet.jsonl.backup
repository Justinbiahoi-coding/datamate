{"id": "q_a9513a9b89b6", "type": "unanswerable", "answer": "unanswerable", "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ncols=set()\nfor df in (So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2):\n    cols|=set(df.columns)\nkw=[c for c in cols if re.search('hạn|hsd|date|expir|lô',str(c),re.I)]\nRESULT='unanswerable' if not kw else 'has '+str(kw)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d151628a1486", "type": "unanswerable", "answer": "unanswerable", "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ncols=set()\nfor df in (So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2):\n    cols|=set(df.columns)\nkw=[c for c in cols if re.search('nhân viên|đánh giá|rating|yêu thích|nv',str(c),re.I)]\nRESULT='unanswerable' if not kw else 'has '+str(kw)\n", "_attempts": 1, "_verdict": "correct"}
