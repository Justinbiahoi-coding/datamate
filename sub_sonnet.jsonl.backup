{"id": "q_fe07ca19cfd8", "type": "percent", "answer": 12.59, "_code": "h=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian']); h=h[h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\nh['t']=to_num(h['Tổng tiền hàng'])\nm=lambda y:h[(h.d.dt.year==y)&(h.d.dt.month==3)].t.sum()\nRESULT=f\"{(m(2026)-m(2025))/m(2025)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fee5b1d42b55", "type": "percent", "answer": 40.3, "_code": "import re\ndef m1(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr',1)\n        if re.search(r'[,\\.]',a): return float(a.replace(',','.'))*1000000\n        return int(a or 0)*1000000+(int(b.ljust(3,'0'))*1000 if b else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    neg=s.startswith('-')\n    v=float(re.sub(r'[^\\d]','',s) or 0)\n    return -v if neg else v\no=don_hang.drop_duplicates().copy()\no=o[o['Xử lý'].isin(['completed','shipping'])]\no['d']=parse_date(o['NgayBan'])\no=o[(o.d.dt.year==2026)&(o.d.dt.month==7)]\nc=chi_tiet_don.drop_duplicates().copy(); c['amt']=c['T.Tiền'].map(m1)\nc=c[c['Ma don'].isin(o['Mã chứng từ'])]\ntot=c.amt.sum()\ncash=c[c['Ma don'].isin(o[o['Phương thức TT']=='cash']['Mã chứng từ'])].amt.sum()\nRESULT=f\"{round(cash/tot*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_226d90b72c7c", "type": "percent", "answer": -22.51, "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\nh=DanhSachHoaDon.copy().drop_duplicates()\nst=h['Trạng thái'].astype(str).str.lower()\nh=h[~st.str.contains('hủy|huỷ|trả|hoàn trả')]\nh=h.drop_duplicates('Mã hóa đơn')\nt=parse_date(h['Thời gian'])\ntc=pd.to_datetime(h['Thời gian tạo'].astype(str).str.strip(),errors='coerce',dayfirst=False)\nh['t']=tc; h['m']=t\nw=h[(h.m>='2026-02-01')&(h.m<'2026-03-01')]\nhr=w.t.dt.hour\ns=((hr>=6)&(hr<14)).sum(); c=((hr>=14)&(hr<22)).sum()\nRESULT=f\"{round((c-s)/s*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_02b7cc8b174d", "type": "percent", "answer": 9.37, "_code": "import re\ndef pm(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,'0')[:3])*1000 if f else 0) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+\\.\\d+',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    if re.fullmatch(r'\\d+[.,]\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\no=don_hang.copy(); o['dt']=parse_date(o['Ngày'])\no=o[(o.dt>='2026-02-01')&(o.dt<='2026-02-28')&o['Tình trạng'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates()\nc=c[c['Mã đơn hàng'].isin(o['Mã chứng từ'])].merge(san_pham[['Mã sản phẩm bán','Danh mục']],left_on='Mã mặt hàng',right_on='Mã sản phẩm bán',how='left')\nc['t']=c.Amount.apply(pm)\nRESULT=f\"{round(c[c['Danh mục']=='hải sản'].t.sum()/c.t.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bc6e400d302a", "type": "date", "answer": "2025-08-07", "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=SoBanHang__all.copy()\ndf['amt']=df['Tiền'].map(m)\nst=df['Ghi chú TT'].astype(str).str.lower()\nbad=set(df.loc[st.str.contains('hủy|huỷ|trả'),'Mã phiếu'])\ndf=df[~df['Mã phiếu'].isin(bad)].drop_duplicates()\ndf['d']=parse_date(df['Giờ']).dt.normalize()\nw=df[(df.d>='2025-08-01')&(df.d<'2025-09-01')]\nRESULT=str(w.groupby('d').amt.sum().idxmax().date())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6500a9bd7c72", "type": "list", "answer": ["Xi măng Hà Tiên PCB40 bao 50kg", "Gạch ống 8x8x18 Tuynel", "Xi măng INSEE Power-S bao 50kg", "Bạt xanh cam khổ 4m", "Thép cuộn phi 6 Hòa Phát"], "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=So_chi_tiet_ban_hang__all.copy().drop_duplicates()\nst=df['Trạng thái'].astype(str).str.lower()\nbad=set(df.loc[st.str.contains('hủy|huỷ|trả|không giao được'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf['d']=parse_date(df['Ngày']); df['q']=df['Số lượng quy đổi'].map(m)\nw=df[(df.d>='2026-07-01')&(df.d<'2026-08-01')]\nRESULT=list(w.groupby('Tên hàng hóa').q.sum().sort_values(ascending=False).head(5).index)\n", "_attempts": 1, "_verdict": "correct"}
