{"id": "q_2248491383ad", "type": "number", "answer": 10638100, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    x=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if x in ('','nan','none'): return 0.0\n    neg=x.startswith('-'); x=x.lstrip('-')\n    m=re.match(r'^(\\d+)(?:[.,](\\d+))?tr(\\d+)?$',x)\n    if m:\n        v=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        if m.group(3): v=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0')[:3])*1e3\n    elif re.match(r'^\\d+(\\.\\d+)?k$',x): v=float(x[:-1])*1e3\n    elif ',' in x and '.' in x: v=float(x.replace(',',''))\n    elif re.match(r'^\\d{1,3}([.,]\\d{3})+$',x): v=float(re.sub(r'[.,]','',x))\n    else: v=float(x.replace(',','.'))\n    return -v if neg else v\nd=DonHang_ChiTiet__all.drop_duplicates().reset_index(drop=True)\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])&(d.dt=='2025-03-10')]\nRESULT=int(round(d['Tổng tiền'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_894293484b95", "type": "list", "answer": [59400, 59400], "_code": "h=BanHang_HoaDon.drop_duplicates().copy()\nh['od']=pd.to_datetime(h['Giờ tạo đơn']).dt.normalize()\ncode=BanHang_KhachHang[BanHang_KhachHang['ten_kh'].str.strip()=='Hà Lan Nhung']['Customer ID'].iloc[0]\nh=h[(h['Mã KH mua']==code)&(h['Phương thức TT']=='Ghi nợ')&(~h['Trạng thái'].str.contains('Không giao được|hủy|huỷ',case=False,na=False))]\npt=BanHang_PhieuThu.copy()\npt['pd']=pd.to_datetime(pt['Thời gian thu']).dt.normalize()\npt['amt']=to_num(pt['Số tiền thu'])\npt=pt.merge(h[['Order ID','od','Tong tien']],left_on='Mã bill',right_on='Order ID')\ns,e=pd.Timestamp('2025-01-01'),pd.Timestamp('2025-01-31')\nsame=pt[pt.pd==pt.od].groupby('Order ID').amt.sum()\nnew=h[(h.od>=s)&(h.od<=e)]\nno_them=(to_num(new['Tong tien'])-new['Order ID'].map(same).fillna(0)).sum()\ntra=pt[(pt.pd>pt.od)&(pt.pd>=s)&(pt.pd<=e)].amt.sum()\nRESULT=[int(round(no_them)),int(round(tra))]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b352dfdba446", "type": "list", "answer": ["Mì Hảo Hảo tôm chua cay", "Snack Oishi tôm cay 40g", "Sữa tươi Vinamilk 180ml", "Trứng gà so", "Nước suối Aquafina 500ml"], "_code": "d=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[(d.dt>='2025-04-01')&(d.dt<='2025-04-30')&~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False,na=False)]\nd['k']=d['Tên sản phẩm'].map(lambda s:' '.join(str(s).lower().split()))\nqd=DanhSachQuyDoi.copy(); qd['k']=qd['Tên sản phẩm'].map(lambda s:' '.join(str(s).lower().split()))\nf={(r.k,str(r['Đơn vị quy đổi']).strip().lower()):float(r['Tỉ lệ quy đổi']) for _,r in qd.iterrows()}\nd['q']=pd.to_numeric(d['Số lượng sản phẩm'].astype(str).str.extract(r'^\\s*(\\d+(?:[.,]\\d+)?)')[0].str.replace(',','.'),errors='coerce')*[f.get((k,str(u).strip().lower()),1.0) for k,u in zip(d.k,d['Đơn vị tính'])]\ncanon=d.groupby('k')['Tên sản phẩm'].agg(lambda x:x.value_counts().index[0])\ns=d.groupby('k').q.sum().sort_values(ascending=False)\nRESULT=[canon[k] for k in s.index[:5]]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_ef810b14835c", "type": "number", "answer": 985537000, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','')\n    if s in ('nan',''): return 0.0\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    return float(re.sub(r'[.,]','',s))\nh=don_hang.drop_duplicates().copy()\nh['d']=parse_date(h['Ngày'])\nh=h[~h['Tình trạng'].str.contains('cancel|return',case=False,na=False)]\nh=h[(h.d>='2025-04-01')&(h.d<='2025-04-30')]\nc=chi_tiet_don.drop_duplicates()\nc=c[c['Mã đơn hàng'].isin(h['Mã chứng từ'])]\nRESULT=int(round(c['Amount'].apply(money).sum()))\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_e9a29330a629", "type": "percent", "answer": 8.41, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    x=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if x in ('','nan','none'): return 0.0\n    neg=x.startswith('-'); x=x.lstrip('-')\n    m=re.match(r'^(\\d+)(?:[.,](\\d+))?tr(\\d+)?$',x)\n    if m:\n        v=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        if m.group(3): v=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0')[:3])*1e3\n    elif re.match(r'^\\d+(\\.\\d+)?k$',x): v=float(x[:-1])*1e3\n    elif ',' in x and '.' in x: v=float(x.replace(',',''))\n    elif re.match(r'^\\d{1,3}([.,]\\d{3})+$',x): v=float(re.sub(r'[.,]','',x))\n    else: v=float(x.replace(',','.'))\n    return -v if neg else v\na=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2]).drop_duplicates().reset_index(drop=True)\na['d']=parse_date(a['Ngày'])\nbad=a.groupby('Mã đơn hàng')['Trạng thái'].apply(lambda s:s.str.contains('hủy|huỷ|cancel|trả',case=False,na=False).any())\na=a[~a['Mã đơn hàng'].map(bad).fillna(False).astype(bool)&(a.d>='2026-04-01')&(a.d<='2026-04-30')].copy()\na['v']=a['Thành tiền'].map(money)\npr=[v for k,v in data.items() if k.startswith('Danh') and isinstance(v,pd.DataFrame)][0]\ng=dict(zip(pr['Tên hàng hóa'].map(normalize_text),pr['Nhóm hàng hóa']))\na['g']=a['Tên hàng hóa'].map(normalize_text).map(g)\nRESULT=f\"{round(a[a.g=='hải sản'].v.sum()/a.v.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
