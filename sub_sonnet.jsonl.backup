{"id": "q_8c4380293447", "type": "percent", "answer": 0.41, "_code": "\nd=DonHang_ChiTiet__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['v']=to_num(d['Tổng tiền'])\nst=d['Trạng thái đơn hàng']\n\nok=d[st.isin(['Đã hoàn thành','Đang giao dịch'])]\na=ok[(ok.dt>='2025-11-01')&(ok.dt<='2025-11-30')]['v'].sum()\nb=ok[(ok.dt>='2025-10-01')&(ok.dt<='2025-10-31')]['v'].sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f24b99ddd7c8", "type": "number", "answer": 1339076, "_code": "df=Bao_cao_ban_hang__So_chi_tiet_ban_hang.drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày']); df['v']=to_num(df['Thành tiền'])\ndf=df[df['Trạng thái'].isin(['ok','Thành công','Đang vận chuyển'])]\nm=df[(df.d>='2025-09-01')&(df.d<='2025-09-30')]\nRESULT=int(m.v.sum()/m['Mã đơn hàng'].nunique()+0.5)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b42ecb762c43", "type": "percent", "answer": 7.2, "_code": "o=data['DanhSachHoaDon__all'].drop_duplicates(); c=data['DanhSachHoaDonChiTiet'].drop_duplicates(); p=data['DanhSachSanPham']\no['d']=parse_date(o['Thời gian'])\nst=o['Trạng thái'].astype(str).str.lower()\nok=~st.str.contains('hủy|huỷ|trả')\no=o[ok&(o.d>='2025-08-01')&(o.d<='2025-08-31')]\nc=c[c['Mã hóa đơn'].isin(o['Mã hóa đơn'])].copy()\nc['tt']=to_num(c['Thành tiền'])\ng=p.set_index('Mã hàng')['Nhóm hàng(3 Cấp)']\nc['g']=c['Mã hàng'].map(g)\nRESULT=f\"{c[c.g=='mắt mũi họng'].tt.sum()/c.tt.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_337bbe4c8725", "type": "percent", "answer": -19.67, "_code": "df=DonHang_ChiTiet__all.drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày đặt hàng']); df=df[df.d.notna()]\nbad=df.loc[df['Trạng thái đơn hàng'].isin(['Đã hủy','Đã hoàn hàng']),'Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf['tt']=to_num(df['Tổng tiền'])\nf=lambda y,m: df[(df.d.dt.year==y)&(df.d.dt.month==m)]['tt'].sum()\nRESULT=f\"{(f(2025,3)/f(2025,2)-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a8441d838909", "type": "percent", "answer": 50.63, "_code": "d=DonHang_ChiTiet.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd['dt']=pd.to_datetime(d['Ngày đặt hàng'],format='%d/%m/%Y')\nd=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nd=d[(d.dt>='2026-08-01')&(d.dt<='2026-08-31')]\nn=d['Tên khách hàng'].astype(str).str.lower().str.strip()\nd=d[~n.isin(['kl','khách lẻ','lẻ'])].assign(k=n)\nc=d.groupby('k')['Mã đơn hàng'].nunique()\nRESULT=f\"{round((c>=5).mean()*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a32dd6806e36", "type": "date", "answer": "2026-08", "_code": "d=DonHang_ChiTiet.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd['dt']=pd.to_datetime(d['Ngày đặt hàng'],format='%d/%m/%Y')\nd=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nd['tt']=to_num(d['Tổng tiền'])\nd['m']=d.dt.dt.strftime('%Y-%m')\ns=d[d.m.isin(['2026-06','2026-07','2026-08'])].groupby('m').tt.sum()\nRESULT=s.idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9b2a114d379f", "type": "list", "answer": [331125000, 323108000, 338062000], "_code": "df=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày']); df=df[df.d.notna()]\nbad=df.loc[df['Trạng thái'].isin(['cancel','Đã hủy đơn','trả hàng','Hoàn trả']),'Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf['tt']=to_num(df['Thành tiền'])\nRESULT=[int(round(df[(df.d.dt.year==2026)&(df.d.dt.month==m)]['tt'].sum())) for m in (3,4,5)]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_5a3ff90bc081", "type": "number", "answer": 40, "_code": "o=don_hang.drop_duplicates().drop_duplicates('Mã chứng từ').copy()\no['d']=parse_date(o['Ngày'])\no=o[(o.d>='2025-05-01')&(o.d<='2025-05-31')]\nRESULT=int((o['Tình trạng']=='cancelled').sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d93c57f6fc7a", "type": "list", "answer": [8, 6], "_code": "\nx=DonHang_ChiTiet.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nx[h]=x[h].ffill()\no=x.drop_duplicates('Mã đơn hàng')[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']]\no['dt']=parse_date(o['Ngày đặt hàng'])\no=o[(o.dt<=as_of_date)&(o['Trạng thái đơn hàng']!='Đã hủy')]\nV=DuLieuXuat\nsku=V['DanhSachSanPham'].loc[V['DanhSachSanPham']['Tên sản phẩm'].str.contains('Nam Hà Candy'),'Mã SKU'].iloc[0]\nl=V['DonNhapHang_ChiTiet'].merge(V['DonNhapHang'],on='Mã đơn nhập')\nl=l[l['Mã SKU']==sku]; l['d']=parse_date(l['Ngày nhập'])\nimp=l[l.d<=as_of_date]['Số lượng nhập'].sum()\ns=V['DonHang_Lo'][V['DonHang_Lo']['Mã lô'].isin(set(l['Mã lô']))]\ns=s[s['Mã đơn hàng'].isin(o['Mã đơn hàng'])]\nstock=int(imp-(s['Số lượng']-s['Số lượng trả']).sum())\nRESULT=[stock//8, stock%8]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_226862074fe9", "type": "percent", "answer": 21.01, "_code": "d=DonHang_ChiTiet.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd['dt']=pd.to_datetime(d['Ngày đặt hàng'],format='%d/%m/%Y')\nd=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nd=d[(d.dt>='2025-03-01')&(d.dt<='2025-03-31')]\nd['tt']=to_num(d['Tổng tiền'])\ng=DuLieuXuat__DanhSachSanPham.set_index('Tên sản phẩm')['Loại sản phẩm']\nd['g']=d['Tên sản phẩm'].map(g)\nRESULT=f\"{round(d[d.g.str.lower()=='vitamin khoáng chất'].tt.sum()/d.tt.sum()*100,2)}%\"\n", "_attempts": 1, "_verdict": "wrong"}
{"id": "q_a7180cc8c8ca", "type": "string", "answer": "NV001", "_code": "o=data['BanHang_HoaDon'].copy(); c=data['BanHang_ChiTietHoaDon'].drop_duplicates()\no['d']=parse_date(o['Ngày bán'])\no=o[o['Trạng thái'].isin(['Đã giao','Đang vận chuyển'])&(o.d>='2025-02-01')&(o.d<='2025-02-28')]\nc=c[c['Mã giao dịch'].isin(o['Order ID'])].copy(); c['tt']=to_num(c['Thanh tien'])\nc=c.merge(o[['Order ID','Mã NV bán']],left_on='Mã giao dịch',right_on='Order ID')\ns=c.groupby('Mã NV bán').tt.sum().sort_values(ascending=False)\nRESULT=s.index[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_790352105703", "type": "number", "answer": 26, "_code": "d=Bao_cao_ban_hang__So_chi_tiet_ban_hang.copy(); d['dt']=parse_date(d['Ngày'])\nm=d[(d.dt.dt.year==2026)&(d.dt.dt.month==4)]\nst=m.groupby('Mã đơn hàng')['Trạng thái'].first()\n# nhãn huỷ khác nhau theo kỳ: 'khách hủy' / 'Không giao được'\nRESULT=int(st.isin(['khách hủy','Không giao được']).sum())\n", "_attempts": 2, "_verdict": "correct"}
