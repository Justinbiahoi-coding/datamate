{"id": "q_ef90531c22b3", "type": "percent", "answer": 27.9, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return 0.0\n    m=re.match(r'^(-?\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)tr$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000000)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)k$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000)\n    if re.match(r'^-?\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(re.sub(r'[^\\d.\\-]','',s) or 0)\nh=DanhSachHoaDon.drop_duplicates().copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]\nh['v']=h['Tổng tiền hàng'].map(money)\ndef m(y,mo): return h[(h.d.dt.year==y)&(h.d.dt.month==mo)].v.sum()\na,b=m(2026,4),m(2025,4)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d915d5dbd1d0", "type": "number", "answer": 135090600, "_code": "\nimport re as _re\ndef pm(x):\n    s=str(x).strip().lower().replace('đ','')\n    return float(s.replace(',','')) if s.replace(',','').replace('.','').isdigit() else float('nan')\ns=SoBanHang[SoBanHang.ngay_ban.notna()].copy()\ns['dt']=parse_date(s['ngay_ban'])\ns=s[(s.dt>='2025-06-01')&(s.dt<='2025-06-30')]\ns=s[~s['Trạng thái xử lý'].str.contains('trả|Không giao',case=False,na=False)]\nRESULT=int(round(s['Tổng tiền'].map(pm).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d99dcf9830b8", "type": "number", "answer": 368766700, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+,\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    else: v=float(s.replace('.','')) if s else float('nan')\n    return -v if neg else v\na=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\na['dt']=parse_date(a['Ngày giao dịch']); a['q']=pd.to_numeric(a['so_luong'],errors='coerce'); a['v']=a['Trị giá'].map(money)\nbad=set(a[a['Status'].str.contains('hủy|huỷ|trả|đổi',case=False,na=False)|(a.q<0)]['Mã hóa đơn'])\na=a[~a['Mã hóa đơn'].isin(bad)].copy()\n\nx=a[(a.dt>='2025-08-01')&(a.dt<='2025-08-31')]\nRESULT=int(round(x.v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_31e44b253383", "type": "percent", "answer": -0.62, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+,\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    else: v=float(s.replace('.','')) if s else float('nan')\n    return -v if neg else v\na=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\na['dt']=parse_date(a['Ngày giao dịch']); a['q']=pd.to_numeric(a['so_luong'],errors='coerce'); a['v']=a['Trị giá'].map(money)\nbad=set(a[a['Status'].str.contains('hủy|huỷ|trả|đổi',case=False,na=False)|(a.q<0)]['Mã hóa đơn'])\na=a[~a['Mã hóa đơn'].isin(bad)].copy()\n\nx=a[(a['Hàng'].map(normalize_text)=='tra vai (l)')]\ns=pd.Timestamp('2026-05-24')\npost=x[(x.dt>=s)&(x.dt<=s+pd.Timedelta(days=29))].q.sum()\npre=x[(x.dt>=s-pd.Timedelta(days=30))&(x.dt<s)].q.sum()\nRESULT=f\"{round((post-pre)/pre*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a812c50a1220", "type": "percent", "answer": -39.96, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return 0.0\n    m=re.match(r'^(-?\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)tr$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000000)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)k$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000)\n    if re.match(r'^-?\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(re.sub(r'[^\\d.\\-]','',s) or 0)\ndf=DonHang_ChiTiet__all.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf['v']=df['Tổng tiền'].map(money)\nok=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\ndef m(y,mo): return ok[(ok.d.dt.year==y)&(ok.d.dt.month==mo)].v.sum()\na,b=m(2026,3),m(2026,2)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ac6c7d8fe088", "type": "number", "answer": 8907000, "_code": "\nimport pandas as pd\ns=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True)\ns['dt']=parse_date(s['Ngày'])\ns['a']=pd.to_numeric(s['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\nok=s[~s['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Hoàn trả',case=False,na=False)]\n\nRESULT=int(round(ok[ok.dt=='2025-07-28'].a.sum()))", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a00adf125b16", "type": "number", "answer": 338062000, "_code": "\nimport pandas as pd\ns=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True)\ns['dt']=parse_date(s['Ngày'])\ns['a']=pd.to_numeric(s['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\nok=s[~s['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Hoàn trả',case=False,na=False)]\n\nRESULT=int(round(ok[(ok.dt>='2026-05-01')&(ok.dt<='2026-05-31')].a.sum()))", "_attempts": 1, "_verdict": "correct"}
{"id": "q_843f0bd18b62", "type": "percent", "answer": 6.22, "_code": "h=BanHang_HoaDon.copy()\nh['d']=parse_date(h['Ngày bán'])\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)\nh=h[~bad]\nc=BanHang_ChiTietHoaDon.drop_duplicates().copy()\nc['amt']=to_num(c['Thanh tien'])\nrev=c.groupby('Mã giao dịch')['amt'].sum()\nh['rev']=h['Order ID'].map(rev).fillna(0)\na=h[(h.d>='2025-07-01')&(h.d<='2025-07-31')].rev.sum()\nb=h[(h.d>='2025-06-01')&(h.d<='2025-06-30')].rev.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b5bd23f316e7", "type": "percent", "answer": 1.32, "_code": "d=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhdr=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hdr]=d[hdr].ffill()\nd['d']=parse_date(d['Ngày đặt hàng'])\nx=d[(d.d>='2026-07-01')&(d.d<='2026-07-17')]\no=x.drop_duplicates('Mã đơn hàng')\nRESULT=f\"{o['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False).sum()/len(o)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ff3b413d7346", "type": "percent", "answer": -19.42, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\na=Bao_cao_ban_hang__So_chi_tiet_ban_hang.drop_duplicates().copy()\na['d']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na=a[~a['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\na['v']=a['Thành tiền'].map(money)\ndef rev(y,m): return a[(a.d.dt.year==y)&(a.d.dt.month==m)].v.sum()\nRESULT=f\"{(rev(2025,6)-rev(2025,5))/rev(2025,5)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3479c2ab0f71", "type": "percent", "answer": 16.67, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=float('nan')\n    return -v if neg else v\n\nd=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\nd['t']=pd.to_datetime(d['Giờ']).dt.normalize()\nbad=d[d['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã phiếu'].unique()\nd=d[~d['Mã phiếu'].isin(bad)].copy()\n\nd=d[d['Tên SP']=='Nước tinh khiết Bidrico 20L'].copy()\nd['q']=d['Số lượng hàng'].astype(str).str.extract(r'(-?[\\d.]+)')[0].astype(float)\nD=pd.Timestamp('2025-01-30')\na=d[(d.t>=D)&(d.t<=D+pd.Timedelta(days=6))].q.sum(); b=d[(d.t>=D-pd.Timedelta(days=7))&(d.t<D)].q.sum()\nprint(a,b)\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f063b216adce", "type": "percent", "answer": 52.86, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=float('nan')\n    return -v if neg else v\n\nd=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\nd['t']=pd.to_datetime(d['Giờ']).dt.normalize()\nbad=d[d['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã phiếu'].unique()\nd=d[~d['Mã phiếu'].isin(bad)].copy()\n\nd['m']=d['Tiền'].apply(money)\nA=pd.Timestamp(as_of_date); s=A.replace(day=1)\nps=s-pd.offsets.MonthBegin(1); pe=min(ps+pd.Timedelta(days=A.day-1),s-pd.Timedelta(days=1))\na=d[(d.t>=s)&(d.t<=A)].m.sum(); b=d[(d.t>=ps)&(d.t<=pe)].m.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f4c328691e9b", "type": "percent", "answer": -32.31, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=float('nan')\n    return -v if neg else v\n\nd=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\nd['t']=pd.to_datetime(d['Giờ']).dt.normalize()\nbad=d[d['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã phiếu'].unique()\nd=d[~d['Mã phiếu'].isin(bad)].copy()\n\nd['m']=d['Tiền'].apply(money)\nA=pd.Timestamp(as_of_date); s=A.replace(day=1)\nps=s-pd.offsets.MonthBegin(1); pe=min(ps+pd.Timedelta(days=A.day-1),s-pd.Timedelta(days=1))\na=d[(d.t>=s)&(d.t<=A)].m.sum(); b=d[(d.t>=ps)&(d.t<=pe)].m.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b32240314018", "type": "percent", "answer": -48.78, "_code": "\na=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nbad=set(a[a['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|không giao',case=False,na=False)]['Mã đơn hàng'])\na=a[~a['Mã đơn hàng'].isin(bad)].copy()\na['dt']=parse_date(a['Ngày'])\na['q']=pd.to_numeric(a['Số lượng quy đổi'].astype(str).str.extract(r'(-?[\\d.]+)')[0])\nx=a[a['Tên hàng hóa'].map(normalize_text)==normalize_text('Gạch ống 8x8x18 Tuynel')]\ns=pd.Timestamp('2026-09-02')\npost=x[(x.dt>=s)&(x.dt<=s+pd.Timedelta(days=6))].q.sum()\npre=x[(x.dt>=s-pd.Timedelta(days=7))&(x.dt<s)].q.sum()\nRESULT=f\"{round((post-pre)/pre*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bc665986d9d5", "type": "number", "answer": 530386, "_code": "df=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).drop_duplicates()\ndf['d']=parse_date(df['Ngày'])\ndf['t']=df['Thành tiền'].astype(str).str.replace(',','').astype(float)\ndf=df[~df['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\ndef orders(a,b):\n    x=df[(df.d>=a)&(df.d<=b)]\n    return x.groupby('Mã đơn hàng').t.sum()\n\no=orders('2026-03-02','2026-03-08')\nRESULT=int(round(o.mean()+1e-9))\n", "_attempts": 1, "_verdict": "correct"}
