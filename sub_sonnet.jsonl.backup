{"id": "q_99e7b472e05e", "type": "percent", "answer": 29.79, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in('nan','','none'): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+[,.]\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): v=float(s.replace(',',''))\n    else: v=float(s.replace(',','.'))\n    return -v if neg else v\nd=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates().copy()\nd['d']=parse_date(d['Ngày đặt hàng'])\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)].copy()\nd['v']=d['Tổng tiền'].map(money)\nd['n']=d['Tên sản phẩm'].map(vn_normalize)\nd=d[d.n==vn_normalize('Nước mắm Nam Ngư 750ml')].copy()\nd['q']=d['Số lượng sản phẩm'].astype(str).str.extract(r'(-?\\d+(?:[.,]\\d+)?)')[0].str.replace(',','.').astype(float)\nd['q']=d.q*d['Đơn vị tính'].map(lambda u:12 if str(u).strip()=='thùng' else 1)\nD=pd.Timestamp('2026-02-02')\na=d[(d.d>=D)&(d.d<D+pd.Timedelta(days=14))].q.sum(); b=d[(d.d>=D-pd.Timedelta(days=14))&(d.d<D)].q.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_526287894668", "type": "percent", "answer": -42.91, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in('nan','','none'): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+[,.]\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): v=float(s.replace(',',''))\n    else: v=float(s.replace(',','.'))\n    return -v if neg else v\nd=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates().copy()\nd['d']=parse_date(d['Ngày đặt hàng'])\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)].copy()\nd['v']=d['Tổng tiền'].map(money)\nm=lambda y,mo:d[(d.d.dt.year==y)&(d.d.dt.month==mo)].v.sum()\nRESULT=f\"{(m(2026,3)-m(2026,2))/m(2026,2)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c501df26488d", "type": "percent", "answer": 2.09, "_code": "\nd=don_hang.copy(); d['dt']=parse_date(d['Ngày bán'])\nx=d[(d.dt>='2025-12-01')&(d.dt<='2025-12-31')]\nRESULT=f\"{(x['Tình trạng đơn']=='cancelled').sum()/len(x)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_42f415d692be", "type": "number", "answer": 2358332, "_code": "\nd=don_hang.copy(); d['dt']=parse_date(d['Ngày bán']); d=d[d['Hình thức thanh toán']=='debt']\nd=d[d['Tình trạng đơn']!='cancelled']\np=thanh_toan.copy(); p['pt']=parse_date(p['Thời điểm'].str[:10])\nm=p.merge(d[['Số phiếu','dt']],left_on='Mã giao dịch',right_on='Số phiếu')\nm=m[(m.pt>m.dt)&(m.pt>='2026-06-01')&(m.pt<='2026-06-30')]\nRESULT=to_num(m['Tiền']).sum()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7ec332889195", "type": "number", "answer": 548195, "_code": "\nimport re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s=='' : return 0.0\n    m=_re.match(r'^(-?\\d+)(?:[.,](\\d+))?\\s*tr\\s*(\\d+)?$',s)\n    if m:\n        a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0'))*1e3\n        return a\n    m=_re.match(r'^(-?\\d+(?:[.,]\\d+)?)\\s*k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.match(r'^-?\\d{1,3}([.,]\\d{3})+$',s): return float(_re.sub(r'[.,]','',s))\n    if _re.match(r'^-?\\d+[.,]\\d{4}$',s): return float(s.replace(',','.'))\n    s2=s.replace(',','.')\n    try: return float(s2)\n    except: return float('nan')\n\nd=don_hang.copy(); d['dt']=parse_date(d['Ngày bán'])\nd=d[(d.dt>='2026-02-01')&(d.dt<='2026-02-28')&d['Tình trạng đơn'].isin(['completed','shipping'])]\nids=set(d['Số phiếu'])\nc=chi_tiet_don[chi_tiet_don['Số CT'].isin(ids)].drop_duplicates()\nRESULT=int(c['Tiền bán'].map(money).sum()/len(ids)+0.5)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ba298d899d0e", "type": "number", "answer": 6, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\nd=d[d['Mã đơn hàng'].notna()].drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt>='2025-04-01')&(d.dt<='2025-04-30')]\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]\nd['k']=d['Tên hàng hóa'].map(normalize_text)\nRESULT=int((d.groupby('k')['Mã đơn hàng'].nunique()>=231).sum())\n", "_attempts": 2, "_verdict": "wrong"}
{"id": "q_94fd5882870e", "type": "percent", "answer": 13.53, "_code": "import re\nd=data['So_chi_tiet_ban_hang__all'].copy()\nd['dt']=parse_date(d['Ngày'])\nd['v']=d['Thành tiền'].astype(str).str.replace(',','').astype(float)\nimport unicodedata as u\ng=[v for k,v in data.items() if u.normalize('NFC',k).startswith('Danh sách hàng')][0]\ngrp=dict(zip(g['Tên hàng hóa'].str.strip().str.lower(),g['Nhóm hàng hóa']))\nd=d[(d.dt>='2026-08-01')&(d.dt<='2026-08-31')]\nd=d[~d['Trạng thái'].str.lower().isin(['hủy','không giao được','hàng trả về','trả hàng'])]\nd['g']=d['Tên hàng hóa'].str.strip().str.lower().map(grp)\nprint(d.g.isna().sum())\nRESULT=f\"{d[d.g=='cát đá'].v.sum()/d.v.sum()*100:.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_93bc8d704a7e", "type": "percent", "answer": 2.09, "_code": "d=data['So_chi_tiet_ban_hang__all'].copy()\nd['dt']=parse_date(d['Ngày'])\no=d.drop_duplicates('Mã đơn hàng')\no=o[(o.dt>='2025-03-01')&(o.dt<='2025-03-31')]\nst=o['Trạng thái'].str.lower()\nfor pat in ['^hủy$','^hủy$|không giao']:\n    print(pat, round(st.str.contains(pat).mean()*100,2))\nRESULT=f\"{st.str.contains('^hủy$').mean()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
