{"id": "q_dd8ff8ef877e", "type": "string", "answer": "Xi măng INSEE Power-S bao 50kg", "_code": "d=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nd=d[d['Trạng thái'].str.lower().isin(['đã giao','đã xong','đang xử lý'])]\na=pd.Timestamp(as_of_date); ws=a-pd.Timedelta(days=a.weekday()+7); we=ws+pd.Timedelta(days=6)\nd=d[(d['dt']>=ws)&(d['dt']<=we)]\nd['q']=to_num(d['Số lượng quy đổi'])\nRESULT=d.groupby('Tên hàng hóa')['q'].sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c5639bf3d2a2", "type": "boolean", "answer": false, "_code": "d=DonHang_ChiTiet__all.copy()\nd[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']]=d[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['amt']=to_num(d['Tổng tiền'])\nst=d['Trạng thái đơn hàng'].str.lower()\nd=d[~st.str.contains('hủy|trả|hoàn')]\nm=d.groupby(d['dt'].dt.to_period('M'))['amt'].sum()\nv=[m[pd.Period(p)] for p in ['2026-04','2026-05','2026-06']]\nRESULT=bool(v[0]<v[1]<v[2])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_19c959df5c70", "type": "date", "answer": "2025-04-03", "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s.endswith('k'): return float(re.sub(r'[^\\d.]','',s[:-1]))*1000\n    return float(re.sub(r'\\D','',s) or 'nan')\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['amt']=d['Tổng tiền'].map(money)\nd=d[~d['Trạng thái đơn hàng'].str.lower().str.contains('hủy|hoàn hàng')]\nx=d[(d['dt']>='2025-04-01')&(d['dt']<'2025-05-01')].groupby('dt')['amt'].sum()\nRESULT=x.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3fc34d6baada", "type": "list", "answer": [16, 9], "_code": "sp=DuLieuXuat__DanhSachSanPham; sku=sp.loc[sp['Tên sản phẩm'].str.contains('Cetirizin 10mg Domesco'),'Mã SKU'].iloc[0]\nnh=DuLieuXuat__DonNhapHang.copy(); nh['dt']=parse_date(nh['Ngày nhập'])\nct=DuLieuXuat__DonNhapHang_ChiTiet.merge(nh[['Mã đơn nhập','dt']],on='Mã đơn nhập')\nct=ct[(ct['Mã SKU']==sku)&(ct['dt']<=pd.Timestamp(as_of_date))]\nlots=set(DuLieuXuat__DonNhapHang_ChiTiet.loc[DuLieuXuat__DonNhapHang_ChiTiet['Mã SKU']==sku,'Mã lô'])\nimp=to_num(ct['Số lượng nhập']).sum()\ndh=DonHang_ChiTiet.copy(); dh[['Mã đơn hàng','Trạng thái đơn hàng']]=dh[['Mã đơn hàng','Trạng thái đơn hàng']].ffill()\ncanc=set(dh.loc[dh['Trạng thái đơn hàng'].str.contains('hủy'),'Mã đơn hàng'])\nlo=DuLieuXuat__DonHang_Lo; lo=lo[lo['Mã lô'].isin(lots)&~lo['Mã đơn hàng'].isin(canc)]\nsold=(to_num(lo['Số lượng'])-to_num(lo['Số lượng trả'])).sum()\ns=int(imp-sold)\nRESULT=[s//10,s%10]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3614b8c3f2b9", "type": "boolean", "answer": false, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s.endswith('k'): return float(re.sub(r'[^\\d.]','',s[:-1]))*1000\n    return float(re.sub(r'\\D','',s) or 'nan')\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['amt']=d['Tổng tiền'].map(money)\nd=d[~d['Trạng thái đơn hàng'].str.lower().str.contains('hủy|hoàn hàng')]\nm=d.groupby(d['dt'].dt.to_period('M'))['amt'].sum()\nv=[m[pd.Period(p)] for p in ['2025-12','2026-01','2026-02']]\nRESULT=bool(v[0]<v[1]<v[2])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6a71d597879d", "type": "percent", "answer": -55.91, "_code": "import re\nd=SoBanHang__all[SoBanHang__all['Mã phiếu'].astype(str).str.startswith('ORD')].copy()\nd['ts']=pd.to_datetime(d['Giờ'],errors='coerce')\ndef money(x):\n    s=str(x).strip().lower(); neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a or 0)*1e6+(float(re.sub(r'\\D','',b).ljust(3,'0')[:3]) *1000 if re.sub(r'\\D','',b) else 0)\n    else: v=float(re.sub(r'\\D','',s) or 'nan')\n    return -v if neg else v\nd['amt']=d['Tiền'].map(money)\ndef qty(x):\n    m=re.match(r'\\s*(-?\\d+(?:[.,]\\d+)?)',str(x)); return float(m.group(1).replace(',','.')) if m else float('nan')\nd['qty']=d['Số lượng hàng'].map(qty)\ng=d.groupby('Mã phiếu')\no=pd.DataFrame({'ts':g['ts'].min(),'st':g['Ghi chú TT'].agg(lambda s:'|'.join(sorted(set(s.dropna().astype(str).str.lower())))),'ret':g['qty'].min()<0,'amt':g['amt'].sum()})\no['day']=o['ts'].dt.normalize()\nv=o[~o['st'].str.contains('hủy|trả')&~o['ret']]\nv=v[(v['day']>='2025-02-01')&(v['day']<'2025-03-01')]\nh=v['ts'].dt.hour\ns=v.loc[(h>=6)&(h<14),'amt'].sum(); c=v.loc[(h>=14)&(h<22),'amt'].sum()\nRESULT=f\"{(c-s)/s*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0e46069808e0", "type": "string", "answer": "Decolgen Forte hộp 30 vỉ x 4 viên", "_code": "d=DonHang_ChiTiet.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']\nd[h]=d[h].ffill(); d=d.dropna(subset=['Tên sản phẩm']).drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|hoàn hàng')]\na=pd.Timestamp(as_of_date); ws=a-pd.Timedelta(days=a.weekday()+7); we=ws+pd.Timedelta(days=6)\nd=d[(d['dt']>=ws)&(d['dt']<=we)]\nqd=DuLieuXuat__DanhSachQuyDoi.drop_duplicates(['Tên sản phẩm','Đơn vị quy đổi'])\nf={(r['Tên sản phẩm'],r['Đơn vị quy đổi']):float(r['Tỉ lệ quy đổi']) for _,r in qd.iterrows()}\nd['q']=[to_num(pd.Series([q])).iloc[0]*f.get((n,u),1) for n,u,q in zip(d['Tên sản phẩm'],d['Đơn vị tính'],d['Số lượng sản phẩm'])]\nRESULT=d.groupby('Tên sản phẩm')['q'].sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
