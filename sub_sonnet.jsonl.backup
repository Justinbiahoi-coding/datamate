{"id": "q_486e3139b1e7", "type": "list", "answer": [368766700, 348311500, 379300800], "_code": "d=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True)\nd=d[d['Mã hóa đơn'].notna()].drop_duplicates().copy()\nd['dt']=pd.to_datetime(d['Giờ'],errors='coerce')\nbad=set(d[d['Status'].str.contains('hủy|huỷ|cancel|trả|Hoàn trả',case=False,na=False)]['Mã hóa đơn'])\nd=d[~d['Mã hóa đơn'].isin(bad)].copy()\ndef money(x):\n    x=str(x).strip().lower()\n    k=x.endswith('k')\n    v=float(__import__('re').sub(r'[^\\d\\-]','',x) or 0)\n    return v*1000 if k else v\nd['v']=d['Trị giá'].map(money)\nm=d.groupby(d.dt.dt.to_period('M')).v.sum()\nRESULT=[int(m[pd.Period(p)]) for p in ('2025-08','2025-09','2025-10')]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_3de8d66158dc", "type": "number", "answer": 90577800, "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nh=DanhSachHoaDon.drop_duplicates().copy(); h['dt']=parse_date(h['Thời gian'])\nok=h[~h['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả',case=False,na=False)&(h.dt>='2025-09-01')&(h.dt<='2025-09-30')&(h['Người bán']=='NV003')]\nc=DanhSachHoaDonChiTiet.drop_duplicates(); c=c[c['Mã hóa đơn'].isin(ok['Mã hóa đơn'])]\nRESULT=int(mon(c['Thành tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f9c1c1549f63", "type": "list", "answer": [530000, 530000], "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan','none'): return float('nan')\n    m=re.match(r'^(\\d+)\\s*tr\\s*(\\d*)$',s.replace(',','.')) if 'tr' in s else None\n    if m:\n        frac=m.group(2); return int(m.group(1))*1e6+(int(frac.ljust(3,'0')[:3])*1000 if frac else 0)\n    m=re.match(r'^(\\d+(?:[.,]\\d+)?)\\s*k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    try: return float(s)\n    except: return float('nan')\nk=BanHang_KhachHang\nids=k[k.ten_kh.map(normalize_text).str.startswith('huynh nhung')]['Customer ID'].tolist()\nh=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh['dt']=parse_date(h['Ngày bán'])\nh=h[h['Mã KH mua'].isin(ids)&(h['Phương thức TT']=='Ghi nợ')&~h['Trạng thái'].str.contains('hủy|huỷ|cancel|không giao',case=False,na=False)]\np=BanHang_PhieuThu.copy()\np['t']=parse_date(p['Thời gian thu']); p['d']=p.t.dt.normalize(); p['a']=p['Số tiền thu'].map(money)\np=p.merge(h[['Order ID','dt','Tong tien']],left_on='Mã bill',right_on='Order ID')\nS,E='2026-05-01','2026-05-25'\nsame=p[p.d==p.dt].groupby('Order ID').a.sum()\nho=h[(h.dt>=S)&(h.dt<=E)]\nnothem=sum(ho['Tong tien'].map(money)-ho['Order ID'].map(same).fillna(0))\ntra=p[(p.d>p.dt)&(p.d>=S)&(p.d<=E)].a.sum()\nRESULT=[int(round(nothem)),int(round(tra))]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_746d1c505fd5", "type": "percent", "answer": -11.19, "_code": "df=pd.concat([data['So_chi_tiet_ban_hang_1__all'],data['So_chi_tiet_ban_hang_2026__all']]).drop_duplicates().reset_index(drop=True)\ndf['d']=parse_date(df['Ngày'])\nbad=df[df['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]['Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf=df[df['Tên hàng hóa'].apply(normalize_text)==normalize_text('Trà vải (L)')]\ndf['q']=to_num(df['Số lượng quy đổi'])\nD=pd.Timestamp('2025-06-05'); N=30\na=df[(df.d>=D)&(df.d<D+pd.Timedelta(days=N))].q.sum()\nb=df[(df.d>=D-pd.Timedelta(days=N))&(df.d<D)].q.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_462895903b95", "type": "percent", "answer": -30.91, "_code": "df=pd.concat([data['So_chi_tiet_ban_hang_1__all'],data['So_chi_tiet_ban_hang_2026__all']]).drop_duplicates().reset_index(drop=True)\ndf['d']=parse_date(df['Ngày'])\nbad=df[df['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]['Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf=df[df['Tên hàng hóa'].apply(normalize_text)==normalize_text('Nước ép cam (L)')]\ndf['q']=to_num(df['Số lượng quy đổi'])\nD=pd.Timestamp('2025-08-15'); N=14\na=df[(df.d>=D)&(df.d<D+pd.Timedelta(days=N))].q.sum()\nb=df[(df.d>=D-pd.Timedelta(days=N))&(df.d<D)].q.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_822c779f4e4d", "type": "number", "answer": 310192800, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan','none'): return float('nan')\n    m=re.match(r'^(\\d+)\\s*tr\\s*(\\d*)$',s.replace(',','.')) if 'tr' in s else None\n    if m:\n        frac=m.group(2); return int(m.group(1))*1e6+(int(frac.ljust(3,'0')[:3])*1000 if frac else 0)\n    m=re.match(r'^(\\d+(?:[.,]\\d+)?)\\s*k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    try: return float(s)\n    except: return float('nan')\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[(h.dt>='2025-10-01')&(h.dt<='2025-10-31')&~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nrx=set(DanhSachThuoc[DanhSachThuoc['Thuốc kê đơn'].astype(str).str.strip().str.lower().isin(['true','1','1.0'])]['Mã hàng'])\nc['tt']=c['Thành tiền'].map(money)\nRESULT=int(round(c[~c['Mã hàng'].isin(rx)].tt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a0e0238cd1f7", "type": "number", "answer": 23082000, "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    sg=-1 if s.startswith('-') else 1\n    s=s.lstrip('-').strip()\n    m=re.fullmatch(r'(\\d+)[.,](\\d+)\\s*tr',s)\n    if m: return sg*round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return sg*(int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0))\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)\\s*k',s)\n    if m: return sg*float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return sg*float(s)\n    except: return float('nan')\n\no=don_hang.drop_duplicates('Số phiếu').copy(); c=chi_tiet_don.drop_duplicates().copy()\nc['t']=c['Tiền bán'].map(money)\no['r']=o['Số phiếu'].map(c.groupby('Số CT').t.sum())\no['dt']=pd.to_datetime(o['Ngày bán'])\nv=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\nRESULT=int(v[v.dt==pd.Timestamp(as_of_date)-pd.Timedelta(days=1)].r.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_30d1e8c6c19d", "type": "number", "answer": 4686, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]\nx=d[(d.dt>='2025-06-01')&(d.dt<='2025-06-30')&d['Tên hàng hóa'].str.strip().str.lower().str.endswith('(m)')]\nRESULT=int(to_num(x['Số lượng quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_93ed66e3fad7", "type": "date", "answer": "2025-05-02", "_code": "import re\ndef money(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    m=re.match(r'^([\\d.,]+)\\s*tr\\s*(\\d*)$',s)\n    if m:\n        a=float(m.group(1).replace(',','.')) if m.group(2)=='' else float(m.group(1))+0\n        if m.group(2)!='': return a*1e6+float(m.group(2).ljust(3,'0'))*1e3\n        return a*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^\\d{1,3}([.,]\\d{3})+$',s): return float(re.sub(r'[.,]','',s))\n    if re.match(r'^[\\d,]+\\.\\d+$',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.match(r'^[\\d.,]+$',s) else 0.0\nd=ban_hang.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày']); d['a']=d['Tổng'].map(money)\nd=d[~d['trang_thai'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nx=d[(d.dt>='2025-05-01')&(d.dt<='2025-05-31')]\nRESULT=x.groupby('dt').a.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b00ae87945f5", "type": "list", "answer": ["Cà phê đen (M)", "Cà phê sữa (M)", "Trà đào cam sả (M)", "Cà phê sữa (L)", "Bạc xỉu (M)"], "_code": "d=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True)\nd=d[d['Mã hóa đơn'].notna()].drop_duplicates().copy()\nd['dt']=pd.to_datetime(d['Giờ']).dt.normalize()\nd['q']=to_num(d['so_luong'])\nbad=d[(d.q<0)|d['Status'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã hóa đơn'].unique()\nd=d[~d['Mã hóa đơn'].isin(bad)]\nf=DanhMuc.set_index('Tên món')['Hệ số']\nd['b']=d.q*[f.get(h,1) if u=='hộp' else 1 for h,u in zip(d['Hàng'],d['Unit'])]\nx=d[(d.dt>='2026-03-23')&(d.dt<='2026-03-27')]\nRESULT=list(x.groupby('Hàng').b.sum().sort_values(ascending=False,kind='stable').index[:5])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9f32cd979c54", "type": "number", "answer": 63, "_code": "o=don_hang.copy(); o['dt']=parse_date(o['NgayBan'])\no=o[o['Xử lý'].isin(['completed','shipping'])&(o.dt>='2025-02-01')&(o.dt<='2025-02-28')]\nc=chi_tiet_don[chi_tiet_don['Ma don'].isin(o['Mã chứng từ'])&(chi_tiet_don['ID SP']=='SP0008')]\nRESULT=int(to_num(c['SL quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ca29c57994d9", "type": "number", "answer": 290169, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    x=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if x in ('','nan','none'): return 0.0\n    neg=x.startswith('-'); x=x.lstrip('-')\n    m=re.match(r'^(\\d+)(?:[.,](\\d+))?tr(\\d+)?$',x)\n    if m:\n        v=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        if m.group(3): v=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0')[:3])*1e3\n    elif re.match(r'^\\d+(\\.\\d+)?k$',x): v=float(x[:-1])*1e3\n    elif ',' in x and '.' in x: v=float(x.replace(',',''))\n    elif re.match(r'^\\d{1,3}([.,]\\d{3})+$',x): v=float(re.sub(r'[.,]','',x))\n    else: v=float(x.replace(',','.'))\n    return -v if neg else v\nh=DanhSachHoaDon.copy(); p=SoQuy.copy()\nh['d']=parse_date(h['Thời gian']).dt.normalize(); h['tt']=h['Tổng sau giảm giá'].map(money)\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel',case=False,na=False)&(h['Phương thức thanh toán']!='Thu hộ (COD)')]\np['d']=parse_date(p['Thời gian']).dt.normalize(); p['a']=p['Giá trị'].map(money)\np=p[p.d<=as_of_date]\npaid=p.groupby('Mã hóa đơn').a.sum()\nh=h[h.d<=as_of_date]\nh['rem']=h.tt-h['Mã hóa đơn'].map(paid).fillna(0)\nage=(pd.Timestamp(as_of_date)-h.d).dt.days\nRESULT=int(h[(h.rem>0)&(age>15)].rem.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e2a430b1feec", "type": "list", "answer": ["Tống Ngọc Trung", "Tô Hải Khánh", "Phan Quân Thảo"], "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\no=don_hang.drop_duplicates().copy(); o['dt']=parse_date(o['Ngày'])\no=o[o['Tình trạng'].isin(['completed','shipping'])&(o.dt>='2026-01-01')&(o.dt<='2026-01-31')&o['Customer ID'].notna()]\nc=chi_tiet_don.drop_duplicates(); c=c[c['Mã đơn hàng'].isin(o['Mã chứng từ'])].copy(); c['t']=mon(c['Amount'])\no['rev']=o['Mã chứng từ'].map(c.groupby('Mã đơn hàng').t.sum())\ng=o.groupby('Customer ID').rev.sum().reset_index().sort_values(['rev','Customer ID'],ascending=[False,True]).head(3)\nnm=dict(zip(khach_hang['Mã KH'],khach_hang['Khách hàng (tên)']))\nRESULT=[nm[k] for k in g['Customer ID']]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5d5a5ffd5606", "type": "number", "answer": 602, "_code": "g=SoGiaoHang.drop_duplicates().copy()\ng['dt']=parse_date(g['Ngày chở'])\ng=g[(g.dt>='2026-05-01')&(g.dt<='2026-05-20')]\nRESULT=len(g[['Mã bill','Lượt giao']].drop_duplicates())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_114c372f1eef", "type": "date", "answer": "2026-05-02", "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','')\n    if s in ('nan',''): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    else: v=float(re.sub(r'[.,]','',s))\n    return -v if neg else v\ndf=pd.concat([data['SoBanHang_1__all'],data['SoBanHang_2026__all']]).drop_duplicates().reset_index(drop=True)\ndf['d']=parse_date(df['Ngày giao dịch'])\nbad=df[df['Status'].str.contains('hủy|huỷ|cancel|trả|Đổi trả',case=False,na=False)]['Mã hóa đơn'].unique()\ndf=df[~df['Mã hóa đơn'].isin(bad)]\ndf=df[(df.d>='2026-05-01')&(df.d<='2026-05-31')]\ndf['tt']=df['Trị giá'].apply(money)\ng=df.groupby('d').tt.sum()\nRESULT=g.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5830abede8f8", "type": "percent", "answer": 1.61, "_code": "d=don_hang.drop_duplicates('Mã chứng từ').copy()\nd['d']=parse_date(d['Ngày'])\nd=d[(d.d>='2025-10-01')&(d.d<='2025-10-31')]\nc=d['Tình trạng'].str.contains('cancel',case=False,na=False).sum()\nRESULT=f\"{round(c/len(d)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_edc6c6cd6326", "type": "number", "answer": 95, "_code": "h=DanhSachHoaDon__all.copy()\nh=h.drop_duplicates()\nh['dt']=parse_date(h['Thời gian'])\nbad=h['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả|Đổi trả',case=False,na=False)\nok=h[~bad]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nokd=ok[ok.dt=='2026-03-26']['Mã hóa đơn']\nc=c[c['Mã hóa đơn'].isin(okd)].merge(DanhSachSanPham[['Mã hàng','ĐVT']],on='Mã hàng',how='left')\nc=c[c['ĐVT']=='lon']\nRESULT=int(to_num(c['Số lượng quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e730b374d65b", "type": "percent", "answer": 0.24, "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    sg=-1 if s.startswith('-') else 1\n    s=s.lstrip('-').strip()\n    m=re.fullmatch(r'(\\d+)[.,](\\d+)\\s*tr',s)\n    if m: return sg*round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return sg*(int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0))\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)\\s*k',s)\n    if m: return sg*float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return sg*float(s)\n    except: return float('nan')\n\na=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[hc]=a[hc].ffill()\na=a.drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày đặt hàng'],format='%d/%m/%Y')\na['t']=a['Tổng tiền'].map(money)\nbad=set(a[a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]['Mã đơn hàng'])\nv=a[~a['Mã đơn hàng'].isin(bad)].copy()\n\ncur=v[(v.dt>='2025-12-01')&(v.dt<='2025-12-07')].t.sum(); prev=v[(v.dt>='2025-11-01')&(v.dt<='2025-11-07')].t.sum()\nRESULT=f\"{(cur-prev)/prev*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e69dcf0740d1", "type": "percent", "answer": 26.39, "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    sg=-1 if s.startswith('-') else 1\n    s=s.lstrip('-').strip()\n    m=re.fullmatch(r'(\\d+)[.,](\\d+)\\s*tr',s)\n    if m: return sg*round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return sg*(int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0))\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)\\s*k',s)\n    if m: return sg*float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return sg*float(s)\n    except: return float('nan')\n\na=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[hc]=a[hc].ffill()\na=a.drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày đặt hàng'],format='%d/%m/%Y')\na['t']=a['Tổng tiền'].map(money)\nbad=set(a[a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]['Mã đơn hàng'])\nv=a[~a['Mã đơn hàng'].isin(bad)].copy()\n\nv['q']=pd.to_numeric(v['Số lượng sản phẩm'].astype(str).str.extract(r'^\\s*([\\d.]+)')[0],errors='coerce')\nv['b']=v.q*v['Đơn vị tính'].map(lambda u:32 if u=='thùng' else 1)\ns=v[v['Tên sản phẩm'].str.contains(\"Lay's vị tự nhiên\",na=False)]\nD=pd.Timestamp('2025-12-18')\nn=s[(s.dt>=D)&(s.dt<D+pd.Timedelta(days=30))].b.sum(); p=s[(s.dt>=D-pd.Timedelta(days=30))&(s.dt<D)].b.sum()\nRESULT=f\"{(n-p)/p*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b4be1da8a3d6", "type": "list", "answer": ["Cà phê sữa (M)", "Cà phê đen (M)", "Trà đào cam sả (M)"], "_code": "import unicodedata,re\nd=DonHang_ChiTiet.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['q']=to_num(d['Số lượng sản phẩm'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)&(d.dt>='2025-04-01')&(d.dt<='2025-04-30')]\nf={'hộp':6} \nd['q']=d.q*d.apply(lambda r:6 if (r['Đơn vị tính']=='hộp' and 'croissant' in r['Tên sản phẩm'].lower()) else 1,axis=1)\nd['k']=d['Tên sản phẩm'].map(normalize_text)\ns=d.groupby('k').q.sum().sort_values(ascending=False,kind='stable')\nname=d.groupby('k')['Tên sản phẩm'].agg(lambda x:x.value_counts().index[0])\nRESULT=[name[k] for k in s.index[:3]]\n", "_attempts": 1, "_verdict": "correct"}
