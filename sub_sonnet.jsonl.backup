{"id": "q_85769fb47c38", "type": "percent", "answer": 17.65, "_code": "a=pd.concat([SoBanHang_1__all,SoBanHang_2026__all]).drop_duplicates().reset_index(drop=True)\na['d']=parse_date(a['Ngày giao dịch']); a['q']=to_num(a['so_luong'])\nbad=a.assign(b=a['Status'].str.contains('hủy|huỷ|trả|Đổi trả|về',case=False,na=False)|(a.q<0)).groupby('Mã hóa đơn').b.any()\na=a[~a['Mã hóa đơn'].map(bad).fillna(False).astype(bool)]\nx=a[a['Hàng'].str.lower().str.contains('thạch cà phê')]\nD=pd.Timestamp('2025-04-18')\naft=x[(x.d>=D)&(x.d<=D+pd.Timedelta(days=6))].q.sum()\nbef=x[(x.d>=D-pd.Timedelta(days=7))&(x.d<D)].q.sum()\nRESULT=f\"{round((aft-bef)/bef*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f14c7c3cd8ad", "type": "list", "answer": ["Giang Hải Linh", "Quách An Ngân", "Trịnh Khoa An"], "_code": "d=DonHang_ChiTiet__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['a']=to_num(d['Tổng tiền'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nd['k']=d['Tên khách hàng'].str.strip()\nd=d[~d.k.str.lower().isin(['kl','lẻ','khách lẻ','khach le'])]\nx=d[(d.dt>='2025-04-01')&(d.dt<='2025-04-30')]\nRESULT=list(x.groupby('k').a.sum().sort_values(ascending=False,kind='stable').index[:3])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3d6b67299c1d", "type": "list", "answer": [900, 300], "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\n\nd=don_hang.drop_duplicates('MaHoaDon')\nd=d[(d.MaKhachHang=='KH0027')&(d.PhuongThucTT=='debt')&(d.TinhTrang!='cancelled')].copy()\nd['od']=d.ThoiGianLap.str[:10]\nt=thanh_toan[thanh_toan.MaHoaDon.isin(d.MaHoaDon)].copy()\nt['pd']=t.NgayGioThu.str[:10]\nt=t.merge(d[['MaHoaDon','od','TongThanhToan']],on='MaHoaDon')\nsame=t[t.pd==t.od].groupby('MaHoaDon').SoTienThu.sum()\ndm=d[(d.od>='2026-06-01')&(d.od<='2026-06-28')]\nno=(dm.TongThanhToan-dm.MaHoaDon.map(same).fillna(0)).sum()\ntra=t[(t.pd>t.od)&(t.pd>='2026-06-01')&(t.pd<='2026-06-28')].SoTienThu.sum()\nRESULT=[int(no),int(tra)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d3dc6983c14d", "type": "date", "answer": "2025-07-27", "_code": "d=DonHang_ChiTiet__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['a']=to_num(d['Tổng tiền'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nx=d[(d.dt>='2025-07-01')&(d.dt<='2025-07-31')]\nRESULT=x.groupby('dt').a.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_70a1c25c63f2", "type": "number", "answer": 10406000, "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nd=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['t']=mon(d['Tổng tiền'])\nd=d[~d['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nRESULT=int(d[d.dt=='2026-03-22'].t.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6b4754b099c6", "type": "percent", "answer": 11.56, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates()\nd=d[d['Mã đơn hàng'].notna()].copy()\nd['dt']=parse_date(d['Ngày'])\nbad=set(d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bad)].copy()\nd['v']=to_num(d['Thành tiền'])\na=d[(d.dt>='2025-08-01')&(d.dt<='2025-08-11')].v.sum()\nb=d[(d.dt>='2025-07-01')&(d.dt<='2025-07-11')].v.sum()\nRESULT=f\"{(a/b-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8e27e9315c75", "type": "number", "answer": 1380000, "_code": "d=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nbad=d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|không giao',case=False,na=False)\nd=d[~d['Mã đơn hàng'].isin(d[bad]['Mã đơn hàng'])&(d.dt>='2025-02-01')&(d.dt<='2025-02-28')]\nd=d[d['Tên hàng hóa'].map(normalize_text).str.endswith('inh 5 phan')]\nRESULT=round(to_num(d['Thành tiền']).sum())\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_2c3829aa0f16", "type": "percent", "answer": 38.36, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\n\nh=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh['dt']=pdate(h['Ngày bán'])\nh=h[~h['Trạng thái'].isin(['Không giao được','Đổi trả'])]\nm=h[(h.dt>='2026-02-01')&(h.dt<='2026-02-28')&h['Mã KH mua'].notna()]\nc=m.groupby('Mã KH mua').size()\nRESULT=f\"{(c>=6).sum()/len(c)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b9c4c175fa78", "type": "list", "answer": ["Xi măng INSEE Power-S bao 50kg", "Xi măng Hà Tiên PCB40 bao 50kg", "Thép cuộn phi 6 Hòa Phát"], "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\n\ns=So_chi_tiet_ban_hang__all.dropna(subset=['Mã đơn hàng']).drop_duplicates().reset_index(drop=True)\ns['dt']=pdate(s['Ngày'])\nbad=set(s[s['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)]['Mã đơn hàng'])\ns=s[~s['Mã đơn hàng'].isin(bad)]\nm=s[(s.dt>='2026-04-01')&(s.dt<='2026-04-30')]\ng=m.groupby('Tên hàng hóa')['Số lượng quy đổi'].sum().sort_values(ascending=False)\nprint(g.head(5))\nRESULT=list(g.head(3).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_755195b2eb71", "type": "percent", "answer": 2.75, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy(); h['dt']=parse_date(h['Thời gian'])\nh=h[(h.dt.dt.year==2026)&(h.dt.dt.month==1)&~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)]\nc=DanhSachHoaDonChiTiet[DanhSachHoaDonChiTiet['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy(); c['a']=mser(c['Thành tiền'])\nrx=set(DanhSachThuoc[DanhSachThuoc['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1'])]['Mã hàng'])\nRESULT=f\"{c[c['Mã hàng'].isin(rx)].a.sum()/c.a.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_aaeb5fd9d5c4", "type": "percent", "answer": 35.79, "_code": "h=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy(); h['dt']=parse_date(h['Thời gian'])\nh['hr']=pd.to_datetime(h['Thời gian tạo']).dt.hour\nh=h[(h.dt.dt.year==2025)&(h.dt.dt.month==5)&~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)]\nm=((h.hr>=6)&(h.hr<=13)).sum(); a=((h.hr>=14)&(h.hr<=21)).sum()\nRESULT=f\"{(a-m)/m*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_eb31ab8ee42a", "type": "number", "answer": 18801500, "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nd=ban_hang.copy(); d['dt']=parse_date(d['Ngày bán']); d['t']=mon(d['Amount'])\nbad=set(d[d['Trạng thái xử lý'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Số phiếu'])\nRESULT=int(d[(d.dt=='2025-05-02')&~d['Số phiếu'].isin(bad)].t.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_50f88885489f", "type": "percent", "answer": 1.37, "_code": "h=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[(h.dt>='2026-02-01')&(h.dt<='2026-02-28')]\nRESULT=f\"{h['Trạng thái'].str.contains('hủy|huỷ|cancel',case=False,na=False).sum()/len(h)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7f073a4b0a54", "type": "list", "answer": [160685800, 183718800, 164094900], "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan','none'): return float('nan')\n    m=re.match(r'^(\\d+)\\s*tr\\s*(\\d*)$',s.replace(',','.')) if 'tr' in s else None\n    if m:\n        frac=m.group(2); return int(m.group(1))*1e6+(int(frac.ljust(3,'0')[:3])*1000 if frac else 0)\n    m=re.match(r'^(\\d+(?:[.,]\\d+)?)\\s*k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    try: return float(s)\n    except: return float('nan')\nd=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]\nd['tt']=d['Tổng tiền'].map(money)\nout=[]\nfor m in (3,4,5):\n    out.append(int(round(d[(d.dt.dt.year==2026)&(d.dt.dt.month==m)].tt.sum())))\nRESULT=out\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2a9c7770d574", "type": "number", "answer": 3221062800, "_code": "d=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd=d[d['Ngày'].notna()]\nd['dt']=parse_date(d['Ngày']); d['a']=to_num(d['Thành tiền'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nRESULT=int(d[(d.dt>='2025-04-01')&(d.dt<='2025-06-30')].a.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5055becf7714", "type": "list", "answer": ["Vương Phương Loan - 0973 189 069", "Kiều Hà Tâm - 0324 774 167", "Đào Dương Giang - 0912 365 003"], "_code": "h=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)&(h.dt>='2026-03-01')&(h.dt<='2026-03-31')&h['Mã KH'].notna()].copy()\nh['v']=to_num(h['Tổng tiền hàng'])\ns=h.groupby('Mã KH')['v'].sum().reset_index().sort_values(['v','Mã KH'],ascending=[False,True]).head(3)\nnm=DanhSachKhachHang.set_index('Mã khách hàng')['Tên khách hàng']\nRESULT=[nm[c] for c in s['Mã KH']]\n", "_attempts": 1, "_verdict": "wrong"}
