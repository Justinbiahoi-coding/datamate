{"id": "q_81cd061af3ae", "type": "boolean", "answer": false, "_code": "import re\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True)\nd=d[d['Mã hóa đơn'].astype(str).str.startswith('ORD')].copy()\ndef money(x):\n    s=str(x).strip().lower(); neg=s.startswith('-'); s=s.lstrip('-')\n    if s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    else: v=float(re.sub(r'\\D','',s) or 'nan')\n    return -v if neg else v\nd['amt']=d['Trị giá'].map(money)\ng=d.groupby('Mã hóa đơn')\no=pd.DataFrame({'ts':g['Giờ'].min(),'st':g['Status'].agg(lambda s:'|'.join(sorted(set(s.dropna().astype(str).str.lower())))),'ret':g['so_luong'].min()<0,'amt':g['amt'].sum()})\no['day']=o['ts'].dt.normalize()\nv=o[~o['st'].str.contains('hủy|trả')&~o['ret']]\nm=v.groupby(v['day'].dt.to_period('M'))['amt'].sum()\nps=[pd.Period(p) for p in ['2025-08','2025-09','2025-10']]\nRESULT=bool(all(m[ps[i+1]]>m[ps[i]] for i in range(2)))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_adef8c6a2761", "type": "percent", "answer": 1.62, "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\nd=don_hang.drop_duplicates('Mã chứng từ').copy()\nd['dt']=parse_date(d['NgayBan'])\nw=d[(d.dt>='2025-01-01')&(d.dt<'2025-02-01')]\ncanc=w['Xử lý'].astype(str).str.lower().str.contains('cancel|hủy|huỷ').sum()\nRESULT=f\"{round(canc/len(w)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
