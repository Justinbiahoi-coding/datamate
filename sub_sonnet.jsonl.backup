{"id": "q_583e4896e764", "type": "percent", "answer": 5.79, "_code": "h=DuLieuBanHang__DanhSachHoaDon.copy().drop_duplicates()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.copy().drop_duplicates(); c['amt']=to_num(c['Thành tiền'])\nh['rev']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn').amt.sum()).fillna(0)\nh=h[(h.d>='2025-06-01')&(h.d<='2025-06-30')]\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\ng=DuLieuBanHang__DanhSachSanPham.set_index('Mã hàng')['Nhóm hàng(3 Cấp)']\nc['g']=c['Mã hàng'].map(g)\nRESULT=f\"{c[c.g=='sữa'].amt.sum()/c.amt.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_88901492b028", "type": "number", "answer": 71065800, "_code": "h=DuLieuBanHang__DanhSachHoaDon.copy().drop_duplicates()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.copy().drop_duplicates(); c['amt']=to_num(c['Thành tiền'])\nh['rev']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn').amt.sum()).fillna(0)\nh=h[(h.d>='2025-05-01')&(h.d<='2025-05-31')&(h['Phương thức thanh toán']=='Chuyển khoản')]\nRESULT=int(round(h.rev.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5285ebdeb1bf", "type": "number", "answer": 1080551000, "_code": "import re\ndef _m(v):\n    if pd.isna(v): return float('nan')\n    s=str(v).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n    if s=='' : return float('nan')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m:\n        f=m.group(3); return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(f.ljust(3,'0')[:3])*1e3 if f else 0)) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'(-?)(\\d+)[,.](\\d+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2)+'.'+m.group(3))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\ndef money(series): return series.map(_m)\na,b=('2026-06-01','2026-06-30')\nd=don_hang.copy(); d['Ngày']=parse_date(d['Ngày'])\nd=d[(d['Ngày']>=a)&(d['Ngày']<=b)&d['Tình trạng'].isin(['completed','shipping'])]\nc=chi_tiet_don[chi_tiet_don['Mã đơn hàng'].isin(d['Mã chứng từ'])].drop_duplicates()\nRESULT=int(money(c['Amount']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_add96b913ccc", "type": "number", "answer": 33187500, "_code": "import re\ndef _m(v):\n    if pd.isna(v): return float('nan')\n    s=str(v).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n    if s=='' : return float('nan')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m:\n        f=m.group(3); return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(f.ljust(3,'0')[:3])*1e3 if f else 0)) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'(-?)(\\d+)[,.](\\d+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2)+'.'+m.group(3))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\ndef money(series): return series.map(_m)\na,b=('2026-07-10','2026-07-10')\nd=don_hang.copy(); d['Ngày']=parse_date(d['Ngày'])\nd=d[(d['Ngày']>=a)&(d['Ngày']<=b)&d['Tình trạng'].isin(['completed','shipping'])]\nc=chi_tiet_don[chi_tiet_don['Mã đơn hàng'].isin(d['Mã chứng từ'])].drop_duplicates()\nRESULT=int(money(c['Amount']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_51b60e9a3887", "type": "percent", "answer": 1.89, "_code": "d=DonHang_ChiTiet.dropna(subset=['Mã đơn hàng']).drop_duplicates()\nd=d.assign(dt=parse_date(d['Ngày đặt hàng']))\nm=d[(d.dt>='2026-01-01')&(d.dt<='2026-01-31')].drop_duplicates('Mã đơn hàng')\nRESULT=f\"{round(m['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False).sum()/len(m)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_908c0f903c5f", "type": "percent", "answer": -0.35, "_code": "d=DonHang_ChiTiet.dropna(subset=['Mã đơn hàng']).drop_duplicates()\nd=d.assign(dt=parse_date(d['Ngày đặt hàng']), v=to_num(d['Tổng tiền']))\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng',case=False)]['Mã đơn hàng']\nd=d[~d['Mã đơn hàng'].isin(bad)]\ndef rev(a,b): return d[(d.dt>=a)&(d.dt<=b)].v.sum()\nx=rev('2025-12-01','2025-12-31'); y=rev('2025-11-01','2025-11-30')\nRESULT=f\"{round((x-y)/y*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f436bd09ff12", "type": "number", "answer": 108, "_code": "h=DuLieuBanHang__DanhSachHoaDon.copy().drop_duplicates()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nh=h[(h.d<=pd.Timestamp(as_of_date))&(h['Mã KH'].notna())&(~h['Phương thức thanh toán'].str.contains('COD',na=False))]\ns=DuLieuBanHang__SoQuy.copy(); s['t']=pd.to_datetime(s['Thời gian']).dt.normalize()\ns=s[s.t<=pd.Timestamp(as_of_date)]\npaid=s.groupby('Mã hóa đơn')['Giá trị'].apply(lambda x:to_num(x).sum())\nh['debt']=to_num(h['Tổng sau giảm giá'])-h['Mã hóa đơn'].map(paid).fillna(0)\nRESULT=int(h[h.debt>0]['Mã KH'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a02351e19462", "type": "number", "answer": 120, "_code": "h=DuLieuBanHang__DanhSachHoaDon.copy().drop_duplicates()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nh=h[(h.d<=pd.Timestamp(as_of_date))&(h['Mã KH'].notna())&(~h['Phương thức thanh toán'].str.contains('COD',na=False))]\ns=DuLieuBanHang__SoQuy.copy(); s['t']=pd.to_datetime(s['Thời gian']).dt.normalize()\ns=s[s.t<=pd.Timestamp(as_of_date)]\npaid=s.groupby('Mã hóa đơn')['Giá trị'].apply(lambda x:to_num(x).sum())\nh['debt']=to_num(h['Tổng sau giảm giá'])-h['Mã hóa đơn'].map(paid).fillna(0)\nRESULT=int(h[h.debt>0]['Mã KH'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_acf5e6eebd7d", "type": "number", "answer": 1160362, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\ndf=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd=parse_date(df['Ngày'])\nbadord=set(df.loc[df['Trạng thái'].str.contains(BAD,case=False,na=False),'Mã đơn hàng'])\nm=(d>='2025-05-01')&(d<='2025-05-31')&~df['Mã đơn hàng'].isin(badord)\nx=df[m].assign(t=df[m]['Thành tiền'].map(money)).groupby('Mã đơn hàng')['t'].sum()\nRESULT=int(x.mean()+0.5)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ce9e622a3fff", "type": "percent", "answer": 42.14, "_code": "h=DanhSachHoaDon__all.drop_duplicates().drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian']); h['t']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['v']=to_num(c['Thành tiền'])\nh['r']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn')['v'].sum()).fillna(0)\nok=h[~bad]\ndef shift(s,e):\n    w=ok[(ok.d>=s)&(ok.d<=e)]; hr=w.t.dt.hour\n    sa=w[(hr>=6)&(hr<14)].r.sum(); ch=w[(hr>=14)&(hr<22)].r.sum()\n    return round((ch-sa)/sa*100,2)\nRESULT=f\"{shift('2026-01-01','2026-01-31')}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9a42e9f34e63", "type": "percent", "answer": 0.93, "_code": "h=DanhSachHoaDon__all.drop_duplicates().drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian']); h['t']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['v']=to_num(c['Thành tiền'])\nh['r']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn')['v'].sum()).fillna(0)\nok=h[~bad]\ndef shift(s,e):\n    w=ok[(ok.d>=s)&(ok.d<=e)]; hr=w.t.dt.hour\n    sa=w[(hr>=6)&(hr<14)].r.sum(); ch=w[(hr>=14)&(hr<22)].r.sum()\n    return round((ch-sa)/sa*100,2)\nw=h[(h.d>='2026-03-01')&(h.d<='2026-03-31')]\nRESULT=f\"{round(w['Trạng thái'].str.contains('hủy|huỷ',case=False).mean()*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a814bfa8b39a", "type": "percent", "answer": 20.34, "_code": "h=DanhSachHoaDon__all.drop_duplicates().drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian']); h['t']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['v']=to_num(c['Thành tiền'])\nh['r']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn')['v'].sum()).fillna(0)\nok=h[~bad]\ndef shift(s,e):\n    w=ok[(ok.d>=s)&(ok.d<=e)]; hr=w.t.dt.hour\n    sa=w[(hr>=6)&(hr<14)].r.sum(); ch=w[(hr>=14)&(hr<22)].r.sum()\n    return round((ch-sa)/sa*100,2)\nw=ok[(ok.d>='2025-06-01')&(ok.d<='2025-06-30')]\ncc=c[c['Mã hóa đơn'].isin(w['Mã hóa đơn'])].copy()\ngm=dict(zip(DanhSachSanPham['Mã hàng'],DanhSachSanPham['Nhóm hàng(3 Cấp)']))\ncc['g']=cc['Mã hàng'].map(gm)\nRESULT=f\"{round(cc[cc.g.str.contains('vitamin',case=False,na=False)].v.sum()/cc.v.sum()*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a45a7606894a", "type": "number", "answer": 1468, "_code": "d=DonHang_ChiTiet.drop_duplicates().copy()\nd=d[d['Tên sản phẩm'].notna()]\nd[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']]=d[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']].ffill()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nd=d[(d['dt']>='2025-06-01')&(d['dt']<='2025-06-30')]\nd=d[d['Tên sản phẩm'].str.contains(r'\\(l\\)\\s*$',case=False,na=False)&(d['Đơn vị tính']=='ly')]\nRESULT=int(pd.to_numeric(d['Số lượng sản phẩm']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fb50cf346d1a", "type": "percent", "answer": 62.25, "_code": "h=DanhSachHoaDon__all.drop_duplicates().drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian']); h['t']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['v']=to_num(c['Thành tiền'])\nh['r']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn')['v'].sum()).fillna(0)\nok=h[~bad]\ndef shift(s,e):\n    w=ok[(ok.d>=s)&(ok.d<=e)]; hr=w.t.dt.hour\n    sa=w[(hr>=6)&(hr<14)].r.sum(); ch=w[(hr>=14)&(hr<22)].r.sum()\n    return round((ch-sa)/sa*100,2)\nRESULT=f\"{shift('2025-05-12','2025-05-18')}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_89bd9d9dfb79", "type": "percent", "answer": 52.94, "_code": "df=DonHang_ChiTiet__all.reset_index(drop=True).copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[h]=df[h].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\nbad=df[df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)]['Mã đơn hàng'].unique()\nv=df[~df['Mã đơn hàng'].isin(bad)].copy()\nv['amt']=to_num(v['Tổng tiền'])\nv['q']=v['Số lượng sản phẩm'].astype(str).str.extract(r'([\\d.]+)')[0].astype(float)\nqd=DanhSachQuyDoi.copy(); qd['r']=to_num(qd['Tỉ lệ quy đổi'])\nv=v.merge(qd[['Tên sản phẩm','Đơn vị quy đổi','r']].rename(columns={'Đơn vị quy đổi':'Đơn vị tính'}),on=['Tên sản phẩm','Đơn vị tính'],how='left')\nv['base']=v['q']*v['r'].fillna(1)\nv=v[v['Tên sản phẩm'].str.contains('Lavie 1.5L',na=False)]\nD=pd.Timestamp('2026-01-27'); w=pd.Timedelta(days=14)\na=v[(v.d>=D)&(v.d<D+w)].base.sum(); b=v[(v.d>=D-w)&(v.d<D)].base.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_747ae991f1c1", "type": "number", "answer": 33388800.0, "_code": "df=DonHang_ChiTiet__all.reset_index(drop=True).copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[h]=df[h].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\nbad=df[df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)]['Mã đơn hàng'].unique()\nv=df[~df['Mã đơn hàng'].isin(bad)].copy()\nv['amt']=to_num(v['Tổng tiền'])\nv['q']=v['Số lượng sản phẩm'].astype(str).str.extract(r'([\\d.]+)')[0].astype(float)\nqd=DanhSachQuyDoi.copy(); qd['r']=to_num(qd['Tỉ lệ quy đổi'])\nv=v.merge(qd[['Tên sản phẩm','Đơn vị quy đổi','r']].rename(columns={'Đơn vị quy đổi':'Đơn vị tính'}),on=['Tên sản phẩm','Đơn vị tính'],how='left')\nv['base']=v['q']*v['r'].fillna(1)\nt=pd.Timestamp(as_of_date); m=t-pd.Timedelta(days=t.weekday())-pd.Timedelta(days=7)\nRESULT=float(v[(v.d>=m)&(v.d<=m+pd.Timedelta(days=6))].amt.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d9dffcc652db", "type": "percent", "answer": 4.52, "_code": "df=DonHang_ChiTiet__all.reset_index(drop=True).copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[h]=df[h].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\nbad=df[df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)]['Mã đơn hàng'].unique()\nv=df[~df['Mã đơn hàng'].isin(bad)].copy()\nv['amt']=to_num(v['Tổng tiền'])\nv['q']=v['Số lượng sản phẩm'].astype(str).str.extract(r'([\\d.]+)')[0].astype(float)\nqd=DanhSachQuyDoi.copy(); qd['r']=to_num(qd['Tỉ lệ quy đổi'])\nv=v.merge(qd[['Tên sản phẩm','Đơn vị quy đổi','r']].rename(columns={'Đơn vị quy đổi':'Đơn vị tính'}),on=['Tên sản phẩm','Đơn vị tính'],how='left')\nv['base']=v['q']*v['r'].fillna(1)\nt=pd.Timestamp(as_of_date); s0=t.replace(day=1); p0=s0-pd.DateOffset(months=1); p1=min(p0+pd.Timedelta(days=t.day-1),s0-pd.Timedelta(days=1))\na=v[(v.d>=s0)&(v.d<=t)].amt.sum(); b=v[(v.d>=p0)&(v.d<=p1)].amt.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d662b5e00bc0", "type": "percent", "answer": 26.0, "_code": "import sys\ndf=So_chi_tiet_ban_hang__all.drop_duplicates()\nG=[v for k,v in data.items() if __import__('unicodedata').normalize('NFC',k)=='Danh sách hàng hóa'][0]\nprint(sorted(set(G['Nhóm hàng hóa'])),file=sys.stderr)\nd=parse_date(df['Ngày'])\ndf=df[(d>='2025-08-01')&(d<='2025-08-31')&~df['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)].copy()\ng=[v for k,v in data.items() if __import__('unicodedata').normalize('NFC',k)=='Danh sách hàng hóa'][0].copy()\ndf['k']=df['Tên hàng hóa'].map(lambda s: normalize_text(str(s).lower().replace('đ','d')))\ng['k']=g['Tên hàng hóa'].map(lambda s: normalize_text(str(s).lower().replace('đ','d')))\nm=df.merge(g[['k','Nhóm hàng hóa']].drop_duplicates('k'),on='k',how='left')\nprint(m['Nhóm hàng hóa'].isna().sum(),file=sys.stderr)\nt=to_num(m['Thành tiền'])\nRESULT=f\"{round(t[m['Nhóm hàng hóa']=='điện'].sum()/t.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_259342644826", "type": "percent", "answer": 31.39, "_code": "h=DuLieuBanHang['DanhSachHoaDon'].drop_duplicates().copy()\nh['dt']=parse_date(h['Thời gian']); h['hr']=pd.to_datetime(h['Thời gian tạo']).dt.hour\nh=h[(h.dt>='2026-03-23')&(h.dt<='2026-03-29')]\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|Hủy|Trả',case=False,na=False)]\ns=((h.hr>=6)&(h.hr<14)).sum(); c=((h.hr>=14)&(h.hr<22)).sum()\nprint(s,c)\nRESULT=str(round((c-s)/s*100,2))+'%'\n", "_attempts": 2, "_verdict": "correct"}
