{"id": "q_3b2896d14668", "type": "number", "answer": 102, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in('','nan','none'): return 0.0\n    s=re.sub(r'[đd₫\\s]|vnd','',s)\n    if re.fullmatch(r'-?\\d{1,3}([.,]\\d{3})+',s): s=re.sub(r'[.,]','',s)\n    else: s=s.replace(',','.')\n    return float(s)\nH=DuLieuBanHang__DanhSachHoaDon.copy()\nH=H[~H['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nH=H[~H['Phương thức thanh toán'].str.contains('COD',na=False)]\nH['d']=pd.to_datetime(H['Thời gian tạo']).dt.normalize()\nH=H[(H.d<='2025-10-19')&H['Mã KH'].notna()]\nH['tot']=H['Tổng sau giảm giá'].map(money)\nP=DuLieuBanHang__SoQuy.copy(); P['d']=pd.to_datetime(P['Thời gian']).dt.normalize()\nP=P[P.d<='2025-10-19'].groupby('Mã hóa đơn')['Giá trị'].sum()\nH['paid']=H['Mã hóa đơn'].map(P).fillna(0)\nH['owe']=H.tot-H.paid\nRESULT=int(H[H.owe>0.5]['Mã KH'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f19c4e273491", "type": "number", "answer": 6236, "_code": "d=danh_sach_hoa_don.copy()\nprint(d['Mã bill'].duplicated().sum(), d.duplicated().sum())\nd['dt']=parse_date(d['Ngày giao dịch'])\nd=d.drop_duplicates('Mã bill')\nd=d[(d.dt>='2025-10-01')&(d.dt<='2025-12-31')&d.Status.isin(['Hoàn thành','Chờ giao'])]\nRESULT=int(len(d))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f0adbb2db8ff", "type": "number", "answer": 3584, "_code": "o=don_hang[don_hang['Xử lý'].isin(['completed','shipping'])].copy()\no['d']=parse_date(o['NgayBan'])\no=o[(o.d>='2025-07-01')&(o.d<='2025-07-31')]\nl=chi_tiet_don[chi_tiet_don['Ma don'].isin(o['Mã chứng từ'])].copy()\nsp=san_pham[san_pham['Sản phẩm'].str.strip().str.lower().str.endswith('(m)')]\nl=l[l['ID SP'].isin(sp.SKU)]\nRESULT=int(to_num(l['SL quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4d7fc53fcc41", "type": "number", "answer": 1828785, "_code": "o=don_hang[(don_hang['Xử lý']!='cancelled')&(don_hang['Phương thức TT']!='cod')].copy()\no['d']=parse_date(o['NgayBan']); o=o[o.d<='2026-08-19']\np=thanh_toan.copy(); p['t']=pd.to_datetime(p['Thời gian thu'].astype(str).str[:10]); p=p[p.t<='2026-08-19']\npaid=to_num(p['Tiền']).groupby(p['Số HĐ']).sum()\no['paid']=o['Mã chứng từ'].map(paid).fillna(0)\no['debt']=to_num(o['Tổng bill'])-o['paid']\nRESULT=int(o[o.debt>0].debt.sum())\n", "_attempts": 1, "_verdict": "correct"}
