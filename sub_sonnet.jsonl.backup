{"id": "q_b331303a8b8c", "type": "string", "answer": "Băng keo điện Nano 20 yard", "_code": "import re\nd=SoBanHang__all.copy().drop_duplicates()\nd['dt']=pd.to_datetime(d['Giờ'],errors='coerce')\nst=d['Ghi chú TT'].astype(str).str.lower()\nd['q']=d['Số lượng hàng'].astype(str).str.extract(r'(-?[\\d.]+)')[0].astype(float)\nbad=d[st.str.contains('hủy|huỷ|trả')|(d.q<0)]['Mã phiếu'].unique()\nd=d[~d['Mã phiếu'].isin(bad)]\ndm=DanhMuc.set_index('Hàng')\ndef conv(r):\n    if r['Tên SP'] in dm.index and r['DonVi']==dm.loc[r['Tên SP'],'ĐV lớn']:\n        return r.q*float(dm.loc[r['Tên SP'],'Hệ số QĐ'])\n    return r.q\nd['base']=d.apply(conv,axis=1)\nx=d[(d.dt>='2026-05-04')&(d.dt<'2026-05-11')]\nRESULT=x.groupby('Tên SP')['base'].sum().sort_values(ascending=False).index[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8a8fd459a0a3", "type": "string", "answer": "Thân Giang Giang", "_code": "df = DonHang_ChiTiet__all.copy()\ndf['d'] = parse_date(df['Ngày đặt hàng'])\ndf = df[(df.d.dt.year==2026)&(df.d.dt.month==1)]\ndf = df[df['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\ndf['v'] = to_num(df['Tổng tiền'])\ndf = df[~df['Tên khách hàng'].map(vn_normalize).isin(['khach le','kl','le'])]\nRESULT = df.groupby('Tên khách hàng')['v'].sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e2d23212a893", "type": "date", "answer": "2025-08-30", "_code": "d=DonHang_ChiTiet.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nd=d[(d.dt>='2025-08-01')&(d.dt<='2025-08-31')]\nd['v']=to_num(d['Tổng tiền'])\ng=d.groupby('dt')['v'].sum()\nRESULT=g.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6b684641ac51", "type": "percent", "answer": 1.17, "_code": "d=DonHang_ChiTiet.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nd['v']=to_num(d['Tổng tiền'])\nm=lambda y,mo:d[(d.dt.dt.year==y)&(d.dt.dt.month==mo)].v.sum()\na,b=m(2025,10),m(2025,9)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
