{"id": "q_91f79e9456a1", "type": "percent", "answer": -51.21, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\ndf=SoBanHang__all.drop_duplicates().copy()\ndf=df[df['Mã phiếu'].notna()].copy()\ndf['dt']=pd.to_datetime(df['Giờ'],errors='coerce')\nbadord=set(df.loc[df['Ghi chú TT'].str.contains(BAD,case=False,na=False),'Mã phiếu'])\ndf=df[~df['Mã phiếu'].isin(badord)].copy()\ndf['t']=df['Tiền'].map(money)\n# order time = first line time\not=df.groupby('Mã phiếu')['dt'].min()\ndf['odt']=df['Mã phiếu'].map(ot)\nw=(df.odt>='2025-05-12')&(df.odt<'2025-05-19')\nh=df.odt.dt.hour\nmo=df[w&(h>=6)&(h<14)]['t'].sum(); af=df[w&(h>=14)&(h<22)]['t'].sum()\nRESULT=f\"{round((af-mo)/mo*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a7da814c6e88", "type": "percent", "answer": 19.85, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\ndf=SoBanHang__all.drop_duplicates().copy()\ndf=df[df['Mã phiếu'].notna()].copy()\ndf['dt']=pd.to_datetime(df['Giờ'],errors='coerce')\nbadord=set(df.loc[df['Ghi chú TT'].str.contains(BAD,case=False,na=False),'Mã phiếu'])\ndf=df[~df['Mã phiếu'].isin(badord)].copy()\ndf['t']=df['Tiền'].map(money)\ndf['odt']=df['Mã phiếu'].map(df.groupby('Mã phiếu')['dt'].min())\na=df[(df.odt>='2026-04-01')&(df.odt<'2026-04-24')]['t'].sum()\nb=df[(df.odt>='2026-03-01')&(df.odt<'2026-03-24')]['t'].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f9d7b9c41145", "type": "number", "answer": 45860000, "_code": "import re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=_re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f)*10**(6-len(f)) if f else 0)\n    m=_re.fullmatch(r'(\\d+),(\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s)\nd=ban_hang.copy()\nd['dt']=parse_date(d['Ngày'])\nd=d[~d['trang_thai'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd=d[d.dt==pd.Timestamp(as_of_date)-pd.Timedelta(days=1)]\nRESULT=int(round(d['Tổng'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_60cf9bf3b9b5", "type": "percent", "answer": 11.09, "_code": "o=don_hang.copy()\no['d']=pd.to_datetime(o['ThoiGianLap']).dt.normalize()\no=o[(o['d']>='2025-06-01')&(o['d']<='2025-06-30')&~o['TinhTrang'].isin(['cancelled','returned'])]\nc=chi_tiet_don.drop_duplicates().copy(); c['v']=pd.to_numeric(c['TriGia'])\nv=c.groupby('MaHoaDon')['v'].sum()\no['v']=o['MaHoaDon'].map(v).fillna(0)\nkh=khach_hang.set_index('MaKhachHang')['LoaiKhachHang']\no['g']=o['MaKhachHang'].map(kh)\ntot=o['v'].sum(); si=o[o['g']=='sỉ']['v'].sum()\nRESULT=f\"{round(si/tot*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_264a7294b457", "type": "percent", "answer": 20.31, "_code": "import re\ndef _m(v):\n    if pd.isna(v): return float('nan')\n    s=str(v).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n    if s=='' : return float('nan')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m:\n        f=m.group(3); return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(f.ljust(3,'0')[:3])*1e3 if f else 0)) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'(-?)(\\d+)[,.](\\d+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2)+'.'+m.group(3))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\ndef money(series): return series.map(_m)\ndef go(a,b,mode,key):\n    d=don_hang.copy(); d['dt']=parse_date(d['Ngày bán'])\n    d=d[(d.dt>=a)&(d.dt<=b)&d['Tình trạng đơn'].isin(['completed','shipping'])]\n    c=chi_tiet_don[chi_tiet_don['Số CT'].isin(d['Số phiếu'])].drop_duplicates().copy()\n    c['v']=money(c['Tiền bán']); tot=c.v.sum()\n    if mode=='nhom':\n        m=c.merge(d[['Số phiếu','Mã khách mua']],left_on='Số CT',right_on='Số phiếu').merge(khach_hang[['Mã khách lẻ/sỉ','Nhóm']],left_on='Mã khách mua',right_on='Mã khách lẻ/sỉ')\n        part=m[m['Nhóm']==key].v.sum()\n    else:\n        m=c.merge(san_pham[['Mã HH','Nhom hang']],left_on='Mã hàng bán',right_on='Mã HH')\n        part=m[m['Nhom hang']==key].v.sum()\n    return f\"{round(part/tot*100,2):.2f}%\"\nRESULT=go('2025-10-01','2025-10-31','nhom','thân thiết')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1c9d18cad635", "type": "percent", "answer": 6.55, "_code": "import re\ndef _m(v):\n    if pd.isna(v): return float('nan')\n    s=str(v).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n    if s=='' : return float('nan')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m:\n        f=m.group(3); return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(f.ljust(3,'0')[:3])*1e3 if f else 0)) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'(-?)(\\d+)[,.](\\d+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2)+'.'+m.group(3))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\ndef money(series): return series.map(_m)\ndef go(a,b,mode,key):\n    d=don_hang.copy(); d['dt']=parse_date(d['Ngày bán'])\n    d=d[(d.dt>=a)&(d.dt<=b)&d['Tình trạng đơn'].isin(['completed','shipping'])]\n    c=chi_tiet_don[chi_tiet_don['Số CT'].isin(d['Số phiếu'])].drop_duplicates().copy()\n    c['v']=money(c['Tiền bán']); tot=c.v.sum()\n    if mode=='nhom':\n        m=c.merge(d[['Số phiếu','Mã khách mua']],left_on='Số CT',right_on='Số phiếu').merge(khach_hang[['Mã khách lẻ/sỉ','Nhóm']],left_on='Mã khách mua',right_on='Mã khách lẻ/sỉ')\n        part=m[m['Nhóm']==key].v.sum()\n    else:\n        m=c.merge(san_pham[['Mã HH','Nhom hang']],left_on='Mã hàng bán',right_on='Mã HH')\n        part=m[m['Nhom hang']==key].v.sum()\n    return f\"{round(part/tot*100,2):.2f}%\"\nRESULT=go('2026-05-01','2026-05-31','sp','khai vị')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_de3c8bc640c2", "type": "percent", "answer": 1.54, "_code": "import sys\ndf=DonHang_ChiTiet.drop_duplicates(); print(df['Trạng thái đơn hàng'].value_counts(),file=sys.stderr)\nt=df['Tổng tiền'].astype(str); print(t[~t.str.match(r'^[\\d,]+$')].unique()[:10],file=sys.stderr)\ndf=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|hoàn hàng',case=False,na=False)]\nd=parse_date(df['Ngày đặt hàng']); v=to_num(df['Tổng tiền'])\nn=v[(d>='2025-11-01')&(d<='2025-11-30')].sum(); p=v[(d>='2025-10-01')&(d<='2025-10-31')].sum()\nRESULT=f\"{round((n-p)/p*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1e6f3a8dece0", "type": "number", "answer": 39853500, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    m=re.match(r'^(\\d+)[,.]?(\\d*)\\s*tr(\\d*)$',s)\n    if m and 'tr' in s:\n        a,b,c=m.groups()\n        return round(float(a+'.'+b)*1e6) if not c else int(a)*1e6+int(c.ljust(3,'0'))*1e3\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    return float(re.sub(r'[^\\d\\-]','',s) or 0)\nh=don_hang.drop_duplicates().copy(); h['d']=parse_date(h['Ngày bán'])\nh=h[~h['Tình trạng đơn'].str.contains('cancel|return',case=False)]\nh=h[h.d=='2026-07-10']\nc=chi_tiet_don.drop_duplicates(); c=c[c['Số CT'].isin(h['Số phiếu'])]\nRESULT=int(c['Tiền bán'].map(money).sum())\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_2567e44ab7e4", "type": "number", "answer": 46, "_code": "h=don_hang.drop_duplicates().copy(); h['d']=parse_date(h['Ngày bán'])\nRESULT=int(((h.d.dt.year==2025)&(h.d.dt.month==7)&h['Tình trạng đơn'].str.contains('cancel',case=False)).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d05886ff8883", "type": "percent", "answer": -0.53, "_code": "h=DanhSachHoaDon__all.copy().drop_duplicates()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.copy().drop_duplicates(); c['amt']=to_num(c['Thành tiền'])\nh['rev']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn').amt.sum()).fillna(0)\na=h[(h.d>='2026-06-01')&(h.d<='2026-06-30')].rev.sum(); b=h[(h.d>='2025-06-01')&(h.d<='2025-06-30')].rev.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ce459ec8c1a1", "type": "number", "answer": 1113099800, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s.startswith('-'): return -money(s[1:])\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        a,b=m.groups(); return int(a)*1000000+(int(b)*10**(6-len(b)) if b else 0)\n    m=re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return int(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\na=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\na['d']=parse_date(a['Ngày'])\na=a[~a['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\na=a[(a['d']>='2025-12-01')&(a['d']<='2025-12-31')]\nRESULT=int(round(a['Thành tiền'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d0456babf008", "type": "percent", "answer": 7.57, "_code": "import unicodedata\na=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na['n']=a['Tên hàng hóa'].map(lambda s: ' '.join(unicodedata.normalize('NFC',str(s)).lower().split()))\na=a[a['Trạng thái'].isin(['xong','Đã hoàn thành','Đang vận chuyển'])]\ndef chg(name,D):\n    D=pd.Timestamp(D); x=a[a.n==name.lower()]\n    q=lambda s,e: pd.to_numeric(x[(x.dt>=s)&(x.dt<=e)]['Số lượng quy đổi']).sum()\n    n=q(D,D+pd.Timedelta(days=29)); p=q(D-pd.Timedelta(days=30),D-pd.Timedelta(days=1))\n    return str(round((n-p)/p*100,2))+'%'\nRESULT=chg('Nước ép cam (M)','2025-12-11')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f3d30bcd1487", "type": "percent", "answer": 7.04, "_code": "import unicodedata\na=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na['n']=a['Tên hàng hóa'].map(lambda s: ' '.join(unicodedata.normalize('NFC',str(s)).lower().split()))\na=a[a['Trạng thái'].isin(['xong','Đã hoàn thành','Đang vận chuyển'])]\ndef chg(name,D):\n    D=pd.Timestamp(D); x=a[a.n==name.lower()]\n    q=lambda s,e: pd.to_numeric(x[(x.dt>=s)&(x.dt<=e)]['Số lượng quy đổi']).sum()\n    n=q(D,D+pd.Timedelta(days=29)); p=q(D-pd.Timedelta(days=30),D-pd.Timedelta(days=1))\n    return str(round((n-p)/p*100,2))+'%'\nRESULT=chg('Sinh tố xoài (L)','2025-09-04')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_65efe32586b5", "type": "number", "answer": 1116621000, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\no=don_hang.drop_duplicates().copy(); l=chi_tiet_don.drop_duplicates().copy()\nd=parse_date(o['Ngày bán'])\no=o[(d>='2025-08-01')&(d<='2025-08-31')&o['Tình trạng đơn'].isin(['completed','shipping'])]\nl=l[l['Số CT'].isin(o['Số phiếu'])]\nRESULT=int(round(l['Tiền bán'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_16029963548e", "type": "number", "answer": 64297000, "_code": "import unicodedata\na=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na['n']=a['Tên hàng hóa'].map(lambda s: ' '.join(unicodedata.normalize('NFC',str(s)).lower().split()))\na=a[a['Trạng thái'].isin(['xong','Đã hoàn thành','Đang vận chuyển'])]\ndef chg(name,D):\n    D=pd.Timestamp(D); x=a[a.n==name.lower()]\n    q=lambda s,e: pd.to_numeric(x[(x.dt>=s)&(x.dt<=e)]['Số lượng quy đổi']).sum()\n    n=q(D,D+pd.Timedelta(days=29)); p=q(D-pd.Timedelta(days=30),D-pd.Timedelta(days=1))\n    return str(round((n-p)/p*100,2))+'%'\nx=a[(a.dt>='2025-05-05')&(a.dt<='2025-05-11')]\nRESULT=int(round(to_num(x['Thành tiền']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
