{"id": "q_ae5a19034686", "type": "percent", "answer": 10.11, "_code": "def money(x):\n    s=str(x).strip().lower().replace('đ','')\n    if s in ('','nan'): return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); return float(a.replace(',','').replace('.',''))*1e6+(float((b+'000')[:3]) *1e3 if b else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','').replace('.',''))*1e3\n    return float(s.replace(',','').replace('.',''))\ndf=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\ndf['d']=parse_date(df['Ngày'])\ndf=df[df['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng','Đang xử lý'])]\ndf['q']=pd.to_numeric(df['Số lượng quy đổi'],errors='coerce')\nD=pd.Timestamp('2026-06-22')\nf=df[df['Tên hàng hóa'].str.lower().str.contains('cơm chiên dương châu')]\na=f[(f.d>=D)&(f.d<D+pd.Timedelta(days=14))].q.sum(); b=f[(f.d>=D-pd.Timedelta(days=14))&(f.d<D)].q.sum()\nprint(a,b)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
