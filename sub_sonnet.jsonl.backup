{"id": "q_55ded7aefe2e", "type": "percent", "answer": 8.13, "_code": "h=don_hang.drop_duplicates().copy()\nh['d']=parse_date(h['NgayBan'])\nh=h[~h['Xử lý'].str.contains('cancel|return',case=False,na=False)]\nc=chi_tiet_don.drop_duplicates().copy()\nc['v']=to_num(c['T.Tiền'])\nrev=c.groupby('Ma don')['v'].sum()\nh['r']=h['Mã chứng từ'].map(rev).fillna(0)\ndef m(y,mo): return h[(h.d.dt.year==y)&(h.d.dt.month==mo)]['r'].sum()\nRESULT=f\"{round((m(2026,7)/m(2026,6)-1)*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
