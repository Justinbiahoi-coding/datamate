{"id": "q_cde1b334100f", "type": "percent", "answer": 31.29, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\nd['dt']=parse_date(d['Ngày']); d['q']=to_num(d['Số lượng quy đổi'])\nd=d[(d['Tên hàng hóa'].str.lower()=='cơm trắng')&(d['Trạng thái']=='Đã hoàn thành')]\nD=pd.Timestamp('2026-07-02'); k=pd.Timedelta(days=14)\nn1=d[(d.dt>=D)&(d.dt<D+k)].q.sum(); n0=d[(d.dt>=D-k)&(d.dt<D)].q.sum()\nRESULT=f\"{(n1-n0)/n0*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9d7475f71a94", "type": "list", "answer": [306937000, 311009000, 314808500], "_code": "\ndf=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày'])\ndf['m']=pd.to_numeric(df['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\nbad=df[df['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả|cancel',case=False)]['Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\nRESULT=[round(float(df[(df.d.dt.year==2025)&(df.d.dt.month==k)]['m'].sum())) for k in (10,11,12)]\n", "_attempts": 1, "_verdict": "correct"}
