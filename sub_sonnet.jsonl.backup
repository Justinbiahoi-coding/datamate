{"id": "q_4bf0ba4d3872", "type": "percent", "answer": 9.64, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s.startswith('-'): return -money(s[1:])\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        a,b=m.groups(); return int(a)*1000000+(int(b)*10**(6-len(b)) if b else 0)\n    m=re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return int(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\nd=DonHang_ChiTiet__all.copy()\nd=d[d['Tên sản phẩm'].notna()]\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nd['v']=d['Tổng tiền'].map(money)\na=d[(d['dt']>='2025-11-01')&(d['dt']<='2025-11-06')]['v'].sum()\nb=d[(d['dt']>='2025-10-01')&(d['dt']<='2025-10-06')]['v'].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6d4c51b222a7", "type": "percent", "answer": 2.67, "_code": "d=DonHang_ChiTiet__all.copy()\nd=d[d['Tên sản phẩm'].notna()]\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[(d['dt']>='2026-07-01')&(d['dt']<='2026-07-09')].drop_duplicates('Mã đơn hàng')\nc=d['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False,na=False).sum()\nRESULT=f\"{round(c/len(d)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1dbb4164545b", "type": "percent", "answer": 87.5, "_code": "print(DanhMuc[DanhMuc['Hàng'].str.contains('Gas')].to_string())\nd=SoBanHang__all.copy().drop_duplicates()\nprint(d['Ghi chú TT'].isna().sum(), d[d['Ghi chú TT'].isna()].head(3).to_string())\nd=d[d['Tên SP']=='Gas Petrolimex 12kg'].copy()\nd['dt']=pd.to_datetime(d['Giờ']).dt.normalize()\nd=d[~d['Ghi chú TT'].fillna('').str.contains('hủy|huỷ|trả',case=False)]\nd['q']=d['Số lượng hàng'].astype(str).str.extract(r'([\\d.,]+)')[0].str.replace(',','.').astype(float)\nD=pd.Timestamp('2026-04-18'); N=14\na=d[(d.dt>=D)&(d.dt<D+pd.Timedelta(days=N))].q.sum(); b=d[(d.dt>=D-pd.Timedelta(days=N))&(d.dt<D)].q.sum()\nprint(a,b)\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6639dbf30814", "type": "number", "answer": 54, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\nh=DanhSachHoaDon__all.drop_duplicates().copy(); l=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nh['d']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nl['t']=l['Thành tiền'].map(money)\ndef okh(a,b):\n    return h[(h.d>=a)&(h.d<=b)&~h['Trạng thái'].str.contains(BAD,case=False,na=False)]\ndef rev(a,b):\n    return l[l['Mã hóa đơn'].isin(okh(a,b)['Mã hóa đơn'])]\nRESULT=int(okh('2026-01-21','2026-01-21')['Mã hóa đơn'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_805e7ed807cc", "type": "percent", "answer": 0.37, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\nh=DanhSachHoaDon__all.drop_duplicates().copy(); l=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nh['d']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nl['t']=l['Thành tiền'].map(money)\ndef okh(a,b):\n    return h[(h.d>=a)&(h.d<=b)&~h['Trạng thái'].str.contains(BAD,case=False,na=False)]\ndef rev(a,b):\n    return l[l['Mã hóa đơn'].isin(okh(a,b)['Mã hóa đơn'])]\na=rev('2025-05-01','2025-05-31')['t'].sum(); b=rev('2025-04-01','2025-04-30')['t'].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_acd30d680a1f", "type": "number", "answer": 44.0, "_code": "import sys\nh=DanhSachHoaDon.drop_duplicates('Mã hóa đơn'); c=DanhSachHoaDonChiTiet.drop_duplicates()\nsp=DanhSachSanPham\nx=sp[sp['Tên hàng'].str.lower().str.contains('nếp cái')]; print(x[['Mã hàng','Tên hàng','ĐVT']],file=sys.stderr)\ncode=x[x['Tên hàng'].str.lower().str.contains('hoa vàng')]['Mã hàng'].iloc[0]\nd=parse_date(h['Thời gian'])\nids=set(h[(d>='2025-04-01')&(d<='2025-04-30')&~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã hóa đơn'])\nl=c[(c['Mã hàng']==code)&c['Mã hóa đơn'].isin(ids)]\nprint(l['Đơn vị tính'].value_counts(),file=sys.stderr)\nRESULT=float(to_num(l['Số lượng quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c521172503eb", "type": "percent", "answer": 5.99, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\nh=DanhSachHoaDon__all.drop_duplicates().copy(); l=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nh['d']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nl['t']=l['Thành tiền'].map(money)\ndef okh(a,b):\n    return h[(h.d>=a)&(h.d<=b)&~h['Trạng thái'].str.contains(BAD,case=False,na=False)]\ndef rev(a,b):\n    return l[l['Mã hóa đơn'].isin(okh(a,b)['Mã hóa đơn'])]\nr=rev('2026-07-01','2026-07-31')\ng=DanhSachSanPham.set_index('Mã hàng')['Nhóm hàng(3 Cấp)']\nr=r.assign(g=r['Mã hàng'].map(g))\nprint(h['Trạng thái'].value_counts().to_dict(), r.g.value_counts(dropna=False).to_dict())\nRESULT=f\"{round(r[r.g=='khai vị']['t'].sum()/r['t'].sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_505b6e15b440", "type": "percent", "answer": 13.56, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1000 if m.group(2) else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    return float(re.sub(r'[^\\d]','',s))\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['tt']=d['Tổng tiền'].map(money)\nd=d[d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nimport unicodedata\nnm=lambda s:' '.join(unicodedata.normalize('NFC',str(s)).lower().split())\nx=d[(d.dt>='2025-07-01')&(d.dt<='2025-07-31')]\ng=DanhSachSanPham.assign(k=DanhSachSanPham['Tên sản phẩm'].map(nm)).set_index('k')['Loại sản phẩm']\nx=x.assign(g=x['Tên sản phẩm'].map(nm).map(g))\nRESULT=str(round(x[x.g=='dùng ngoài'].tt.sum()/x.tt.sum()*100,2))+'%'\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_e43bac7f8d23", "type": "number", "answer": 522123500.0, "_code": "import unicodedata,re\ndef nk(x):\n    x=unicodedata.normalize('NFD',str(x)).replace('đ','d').replace('Đ','D')\n    x=''.join(c for c in x if unicodedata.category(c)!='Mn').lower()\n    return re.sub(r'\\s+',' ',x).strip()\ns=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates()\ns['d']=parse_date(s['Ngày'])\nbad=s[s['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao|hoàn hàng',case=False,na=False)]['Mã đơn hàng'].unique()\ns=s[~s['Mã đơn hàng'].isin(bad)]\ns['amt']=to_num(s['Thành tiền'].astype(str).str.replace(r'\\.0+$','',regex=True))\nt=pd.Timestamp(as_of_date)\nRESULT=float(s[(s.d>=t.replace(month=1,day=1))&(s.d<=t)].amt.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_433b302bf6a8", "type": "number", "answer": 99411700, "_code": "import sys\nh=DanhSachHoaDon.drop_duplicates('Mã hóa đơn'); c=DanhSachHoaDonChiTiet.drop_duplicates()\nprint(h['Người bán'].unique()[:10],file=sys.stderr)\nd=parse_date(h['Thời gian'])\nids=h[(d>='2025-09-01')&(d<='2025-09-30')&(h['Người bán'].astype(str).str.contains('NV002'))&~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã hóa đơn']\nRESULT=int(to_num(c[c['Mã hóa đơn'].isin(ids)]['Thành tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2ca8fd946a09", "type": "number", "answer": 5888993000, "_code": "df=pd.concat([data['So_chi_tiet_ban_hang_1'],data['So_chi_tiet_ban_hang_2']],ignore_index=True).drop_duplicates()\nd=parse_date(df['Ngày'])\nok=~df['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)\nRESULT=int(to_num(df['Thành tiền'][ok&(d>='2026-01-01')&(d<='2026-05-21')]).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3c64cc8b4a5b", "type": "number", "answer": 817000, "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)[.,]?(\\d*)tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if c: return float(a)*1e6+float(c)*10**(6-len(c))\n        return float(a+'.'+(b or '0'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m:\n        t=m.group(1)\n        return float(t.replace('.','').replace(',',''))*1000 if re.search(r'[.,]\\d{3}$',t) else float(t.replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\na=DonHang_ChiTiet[DonHang_ChiTiet['Mã đơn hàng'].notna()].drop_duplicates().copy()\na['dt']=parse_date(a['Ngày đặt hàng'])\nbad=set(a.loc[a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False),'Mã đơn hàng'])\ng=a[~a['Mã đơn hàng'].isin(bad)&(a.dt>='2025-09-01')&(a.dt<='2025-09-30')&(a['Tên sản phẩm']=='Topping Kem cheese')]\nRESULT=int(round(g['Tổng tiền'].apply(money).sum()))\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_a06ecb8ca547", "type": "percent", "answer": 2.11, "_code": "d=DonHang_ChiTiet__all.drop_duplicates()\nd=d.assign(dt=parse_date(d['Ngày đặt hàng']),v=to_num(d['Tổng tiền']))\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng',case=False)]['Mã đơn hàng']\nd=d[~d['Mã đơn hàng'].isin(bad)]\ndef rev(a,b): return d[(d.dt>=a)&(d.dt<=b)].v.sum()\nx=rev('2025-05-01','2025-05-31'); y=rev('2025-04-01','2025-04-30')\nRESULT=f\"{round((x-y)/y*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7f41b0bb886f", "type": "number", "answer": 38, "_code": "d=ban_hang.drop_duplicates()\nd=d.assign(dt=parse_date(d['Ngày bán']),q=to_num(d['Số lượng lẻ']))\nbad=d[d['Trạng thái xử lý'].str.contains('hủy|huỷ|trả',case=False)]['Số phiếu']\nd=d[~d['Số phiếu'].isin(bad)]\ns=d[(d['Hàng bán']=='Gỏi khoai môn hải sản')&(d.dt>='2025-03-01')&(d.dt<='2025-03-31')]\nRESULT=int(s.q.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8b593eebb129", "type": "number", "answer": 302714000, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s.startswith('-'): return -money(s[1:])\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        a,b=m.groups(); return int(a)*1000000+(int(b)*10**(6-len(b)) if b else 0)\n    m=re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return int(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\na=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates().copy()\na['d']=parse_date(a['Ngày'])\na=a[~a['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)]\na=a[(a['d']>='2025-07-01')&(a['d']<='2025-07-31')]\nRESULT=int(round(a['Thành tiền'].map(money).sum()))\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_7f4fb0a05458", "type": "percent", "answer": 19.68, "_code": "import unicodedata,re\ndef nk(x):\n    x=unicodedata.normalize('NFD',str(x)).replace('đ','d').replace('Đ','D')\n    x=''.join(c for c in x if unicodedata.category(c)!='Mn').lower()\n    return re.sub(r'\\s+',' ',x).strip()\ns=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates()\ns['d']=parse_date(s['Ngày'])\nbad=s[s['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao|hoàn hàng',case=False,na=False)]['Mã đơn hàng'].unique()\ns=s[~s['Mã đơn hàng'].isin(bad)]\ns['amt']=to_num(s['Thành tiền'].astype(str).str.replace(r'\\.0+$','',regex=True))\ng=data[[k for k in data if nk(k)=='danh sach hang hoa'][0]].copy(); g['k']=g['Tên hàng hóa'].map(nk); g=g[['k','Nhóm hàng hóa']].drop_duplicates('k')\ns['k']=s['Tên hàng hóa'].map(nk)\ns=s[(s.d.dt.year==2026)&(s.d.dt.month==1)].merge(g,on='k',how='left')\nRESULT=f\"{s[s['Nhóm hàng hóa']=='trà'].amt.sum()/s.amt.sum()*100:.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_5c0df60d8781", "type": "number", "answer": 56951900, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\ndf=SoBanHang.copy()\nd=parse_date(df['Ngày mua'])\nm=(d=='2026-03-04')&~df['Ghi chú TT'].str.contains(BAD,case=False,na=False)\nRESULT=int(round(df.loc[m,'thanh_tien'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
