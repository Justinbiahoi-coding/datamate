{"id": "q_0166f82c0223", "type": "percent", "answer": 1.66, "_code": "df = DonHang_ChiTiet.copy()\ndf['d'] = parse_date(df['Ngày đặt hàng'])\ndf = df[(df.d.dt.year==2025)&(df.d.dt.month==9)]\nst = df.groupby('Mã đơn hàng')['Trạng thái đơn hàng'].first()\nc = st.str.contains('hủy|huỷ', case=False, na=False).sum()\nRESULT = f\"{c/len(st)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
