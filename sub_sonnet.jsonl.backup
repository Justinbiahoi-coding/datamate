{"id": "q_d3837b22e001", "type": "percent", "answer": 53.85, "_code": "import re,unicodedata as u\nnm=lambda s:' '.join(u.normalize('NFC',str(s)).casefold().split())\ndef money(x):\n    s=str(x).strip().lower().replace('đ','')\n    if s in('','nan','none'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m: v=int(m.group(1))*1e6+(int((m.group(2)+'000')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    else:\n        s=s.replace(',','') if re.search(r',\\d{3}',s) else s.replace(',','.')\n        if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): s=s.replace('.','')\n        v=float(s)\n    return -v if neg else v\ndf=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\ndf['d']=parse_date(df['Ngày giao dịch'])\ndf['q']=pd.to_numeric(df['so_luong'],errors='coerce')\nbad=df[df['Status'].str.contains('hủy|huỷ|trả|Hoàn',case=False,na=False)]['Mã hóa đơn'].unique()\ndf=df[~df['Mã hóa đơn'].isin(bad)]\nc=df[df['Hàng'].map(nm)=='cappuccino (m)']\na=c[(c.d>='2025-08-21')&(c.d<='2025-08-27')].q.sum(); b=c[(c.d>='2025-08-14')&(c.d<='2025-08-20')].q.sum()\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_14d138cb0a76", "type": "number", "answer": 176282700, "_code": "import re,unicodedata as u\nnm=lambda s:' '.join(u.normalize('NFC',str(s)).casefold().split())\ndef money(x):\n    s=str(x).strip().lower().replace('đ','')\n    if s in('','nan','none'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m: v=int(m.group(1))*1e6+(int((m.group(2)+'000')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    else:\n        s=s.replace(',','') if re.search(r',\\d{3}',s) else s.replace(',','.')\n        if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): s=s.replace('.','')\n        v=float(s)\n    return -v if neg else v\ndf=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\ndf['d']=parse_date(df['Ngày giao dịch'])\ndf['q']=pd.to_numeric(df['so_luong'],errors='coerce')\nbad=df[df['Status'].str.contains('hủy|huỷ|trả|Hoàn',case=False,na=False)]['Mã hóa đơn'].unique()\ndf=df[~df['Mã hóa đơn'].isin(bad)]\ndf=df[(df.d>='2026-04-01')&(df.d<='2026-04-30')]\nh=pd.to_datetime(df['Giờ']).dt.hour\ndf=df[(h>=14)&(h<=21)]\nRESULT=int(round(df['Trị giá'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
