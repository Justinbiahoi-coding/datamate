{"id": "q_caee0d8a8de3", "type": "string", "answer": "Khẩu trang y tế 4 lớp Khánh An hộp 50 cái", "_code": "df=DonHang_ChiTiet.copy()\nfor c in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: df[c]=df[c].ffill()\ndf=df.drop_duplicates()\ndf=df[df['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])].copy()\ndf['d']=pd.to_datetime(df['Ngày đặt hàng'],format='%d/%m/%Y')\ndf['m']=df['Tổng tiền'].astype(str).str.replace(',','').astype(float)\nx=df[(df.d>='2025-06-01')&(df.d<='2025-06-30')].copy()\nqd=DuLieuXuat['DanhSachQuyDoi']\nf={(r['Tên sản phẩm'],r['Đơn vị quy đổi']):r['Tỉ lệ quy đổi'] for _,r in qd.iterrows()}\nx['q']=x['Số lượng sản phẩm'].astype(float)*[f.get((n,u),1) for n,u in zip(x['Tên sản phẩm'],x['Đơn vị tính'])]\nsp=DuLieuXuat['DanhSachSanPham'].set_index('Tên sản phẩm')['Mã SKU']\ng=x.groupby('Tên sản phẩm')['q'].sum().reset_index()\ng['sku']=g['Tên sản phẩm'].map(sp)\ng=g.sort_values(['q','sku'],ascending=[False,True])\nRESULT=g.iloc[0]['Tên sản phẩm']\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_42b56ae572e0", "type": "number", "answer": 314535600, "_code": "h=BanHang_HoaDon.copy()\nh['od']=pd.to_datetime(h['Giờ tạo đơn']).dt.normalize()\nc=BanHang_ChiTietHoaDon.drop_duplicates().copy()\nc['a']=to_num(c['Thanh tien'])\nt=c.groupby('Mã giao dịch').a.sum().rename('tt')\nh=h.join(t,on='Order ID')\nh['th']=to_num(h['Tiền hàng trước giảm'])\nhv=h[h['Trạng thái'].isin(['Đã giao','Đang vận chuyển'])]\nRESULT=int(hv[(hv.od>='2025-01-01')&(hv.od<='2025-01-31')].tt.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e2e41d53f803", "type": "date", "answer": "2026-02", "_code": "h=BanHang_HoaDon.copy()\nh['od']=pd.to_datetime(h['Giờ tạo đơn']).dt.normalize()\nc=BanHang_ChiTietHoaDon.drop_duplicates().copy()\nc['a']=to_num(c['Thanh tien'])\nt=c.groupby('Mã giao dịch').a.sum().rename('tt')\nh=h.join(t,on='Order ID')\nh['th']=to_num(h['Tiền hàng trước giảm'])\nhv=h[h['Trạng thái'].isin(['Đã giao','Đang vận chuyển'])]\nhv=hv.assign(m=hv.od.dt.strftime('%Y-%m'))\ns=hv[hv.m.isin(['2025-12','2026-01','2026-02'])].groupby('m').tt.sum()\nRESULT=s.idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a566c9b4142c", "type": "string", "answer": "Blackmores Bio C 1000mg hộp 31 viên", "_code": "o=data['don_hang'].copy(); c=data['chi_tiet_don'].drop_duplicates(); p=data['san_pham']\no['d']=parse_date(o['NgayLap'])\no=o[o['TinhTrang'].isin(['completed','shipping'])&(o.d>='2026-04-01')&(o.d<='2026-04-30')]\nc=c[c['MaHoaDon'].isin(o['MaHoaDon'])].copy()\nc['g']=to_num(c['TriGia'])-to_num(c['SL'])*to_num(c['GiaVonLucBan'])\ns=c.groupby('MaHangHoa').g.sum().sort_values(ascending=False,kind='stable')\nRESULT=p.set_index('MaHangHoa')['TenGoi'][s.index[0]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e5e37ba0324f", "type": "percent", "answer": 1.3, "_code": "\nd=data['So_chi_tiet_ban_hang__all'].copy()\nd['dt']=pd.to_datetime(d['Ngày'],format='%d/%m/%Y',errors='coerce')\nm=d[(d.dt>='2025-03-01')&(d.dt<='2025-03-31')]\no=m.drop_duplicates('Mã đơn hàng')\nRESULT=f\"{o['Trạng thái'].str.contains('hủy|huỷ').sum()/len(o)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_aa09c3f0f44d", "type": "number", "answer": 115, "_code": "\nd=data['So_chi_tiet_ban_hang__all'].copy()\nd['dt']=pd.to_datetime(d['Ngày'],format='%d/%m/%Y',errors='coerce')\nd['q']=pd.to_numeric(d['Số lượng quy đổi'].astype(str).str.replace(r'[^\\d.]','',regex=True),errors='coerce')\nm=d[(d.dt>='2025-05-01')&(d.dt<='2025-05-31')&d['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng'])&d['Tên hàng hóa'].str.contains('lavie',case=False)&d['Tên hàng hóa'].str.contains('19')]\nprint(m['Tên hàng hóa'].unique(), m['Đơn vị tính'].unique())\nRESULT=m['q'].sum()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_57cd2bc2320b", "type": "date", "answer": "2026-01-12", "_code": "\nd=data['So_chi_tiet_ban_hang__all'].copy()\nd['dt']=pd.to_datetime(d['Ngày'],format='%d/%m/%Y',errors='coerce')\nd['t']=to_num(d['Thành tiền'])\nm=d[(d.dt>='2026-01-01')&(d.dt<='2026-01-31')&d['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng'])]\nRESULT=str(m.groupby('dt').t.sum().idxmax().date())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6294954a0461", "type": "number", "answer": 110484, "_code": "d=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nd['dt']=parse_date(d['Thời gian'])\nbad=d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nd=d[~bad & (d.dt>='2025-12-01') & (d.dt<='2025-12-31')]\nRESULT=round(to_num(d['Tổng tiền hàng']).mean())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d8ecf789d6dc", "type": "date", "answer": "2025-07-21", "_code": "import re\ndef money(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    m=re.match(r'^([\\d.,]+)\\s*tr\\s*(\\d*)$',s)\n    if m:\n        a=float(m.group(1).replace(',','.')) if m.group(2)=='' else float(m.group(1))+0\n        if m.group(2)!='': return a*1e6+float(m.group(2).ljust(3,'0'))*1e3\n        return a*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^\\d{1,3}([.,]\\d{3})+$',s): return float(re.sub(r'[.,]','',s))\n    if re.match(r'^[\\d,]+\\.\\d+$',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.match(r'^[\\d.,]+$',s) else 0.0\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd['amt']=d['Tổng tiền'].map(money)\nok=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False)]\nx=ok[(ok.dt>='2025-07-01')&(ok.dt<='2025-07-31')]\nRESULT=x.groupby('dt').amt.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_046b75d6192e", "type": "date", "answer": "2025-02-15", "_code": "d=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nd['dt']=parse_date(d['Thời gian'])\nbad=d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nd=d[~bad & (d.dt>='2025-02-01') & (d.dt<='2025-02-28')]\nd['v']=to_num(d['Tổng tiền hàng'])\nRESULT=d.groupby('dt')['v'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_916407612bf4", "type": "list", "answer": [921000, 311500], "_code": "o=don_hang.copy(); p=thanh_toan.copy()\no['d']=parse_date(o['NgayLap']).dt.normalize()\no['tt']=to_num(o['TongThanhToan'])\no=o[(o.TinhTrang!='cancelled')&(o.PhuongThucTT=='debt')&(o.MaKhachHang=='KH0212')]\np['d']=parse_date(p['NgayGioThu']).dt.normalize(); p['a']=to_num(p['SoTienThu'])\np=p.merge(o[['MaHoaDon','d']].rename(columns={'d':'od'}),on='MaHoaDon')\ns,e='2026-04-01','2026-04-30'\nsame=p[p.d==p.od].groupby('MaHoaDon').a.sum()\noi=o[(o.d>=s)&(o.d<=e)]\nno=(oi.set_index('MaHoaDon').tt-same.reindex(oi.MaHoaDon).fillna(0)).sum()\ntra=p[(p.d>p.od)&(p.d>=s)&(p.d<=e)].a.sum()\nRESULT=[int(no),int(tra)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9a12437c0eaf", "type": "number", "answer": 298780500, "_code": "d=data['So_chi_tiet_ban_hang_1__all'].copy()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày']); d['t']=to_num(d['Thành tiền'])\nbad=d['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả|Hoàn trả',case=False,na=False)\nbad_o=set(d[bad]['Mã đơn hàng'])\nm=d[(d.dt>='2025-09-01')&(d.dt<='2025-09-30')&~d['Mã đơn hàng'].isin(bad_o)]\nRESULT=int(m.t.sum())\n", "_attempts": 1, "_verdict": "correct"}
