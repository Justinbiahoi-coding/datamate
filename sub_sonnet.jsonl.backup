{"id": "q_eef55227353d", "type": "percent", "answer": 23.02, "_code": "\ncal=pd.read_csv('train/calendar.csv'); cal['date']=pd.to_datetime(cal['date'])\ndef tet(y):\n    s=cal[(cal.lunar_year==y-1)&(cal.lunar_month==12)&(cal.lunar_day==23)&(~cal.lunar_leap)].date.iloc[0]\n    e=cal[(cal.lunar_year==y)&(cal.lunar_month==1)&(cal.lunar_day==10)&(~cal.lunar_leap)].date.iloc[0]\n    return s,e\nh=BanHang_HoaDon[~BanHang_HoaDon['Trạng thái'].str.contains('Không giao được|hủy|huỷ|trả',case=False,na=False)].copy()\nh['t']=pd.to_datetime(h['Giờ tạo đơn']).dt.normalize()\nc=BanHang_ChiTietHoaDon.drop_duplicates().copy(); c['m']=to_num(c['Thanh tien'])\ntot=c[c['Mã giao dịch'].isin(h['Order ID'])].groupby('Mã giao dịch').m.sum()\nh['m']=h['Order ID'].map(tot).fillna(0)\ndef rev(y):\n    s,e=tet(y); return h[(h.t>=s)&(h.t<=e)].m.sum()\na,b=rev(2026),rev(2025)\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b7728178ae59", "type": "number", "answer": 19371700, "_code": "\nh=DanhSachHoaDon__all.copy(); h['dt']=parse_date(h['Thời gian'])\nok=h[h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])&(h.dt>='2025-09-01')&(h.dt<='2025-09-30')]['Mã hóa đơn']\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(ok)].copy(); c['v']=to_num(c['Thành tiền'])\ncodes=set(DanhSachSanPham[DanhSachSanPham['Nhóm hàng(3 Cấp)'].str.strip().str.lower()=='vitamin khoáng chất']['Mã hàng'])\nRESULT=int(round(c[c['Mã hàng'].isin(codes)]['v'].sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_99543ed94f0b", "type": "number", "answer": 3428100, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return 0.0\n    m=re.match(r'^(-?\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)tr$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000000)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)k$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000)\n    if re.match(r'^-?\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(re.sub(r'[^\\d.\\-]','',s) or 0)\ndf=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf['v']=df['Tổng tiền'].map(money)\nok=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nx=ok[(ok.d>='2025-05-01')&(ok.d<='2025-05-31')].copy()\nsku=dict(zip(DanhSachSanPham['Tên sản phẩm'].map(normalize_text),DanhSachSanPham['Mã SKU']))\nhc=dict(zip(DanhSachThuoc['Mã SKU'],DanhSachThuoc['Hoạt chất'].astype(str).str.strip().str.lower()))\nx['hc']=x['Tên sản phẩm'].map(normalize_text).map(sku).map(hc)\nRESULT=int(round(x[x.hc=='cetirizin'].v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2592e9dbbf13", "type": "percent", "answer": 23.02, "_code": "d=DonHang_ChiTiet.copy()\nhdr=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hdr]=d[hdr].ffill()\nd=d.drop_duplicates()\nd['d']=parse_date(d['Ngày đặt hàng'])\nd['t']=d['Tổng tiền'].astype(str).str.replace(',','').astype(float)\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nd=d[(d.d>='2026-03-01')&(d.d<='2026-03-31')]\nsp=DuLieuXuat__DanhSachSanPham\nprint(sp['Loại sản phẩm'].unique())\ng=d['Tên sản phẩm'].map(dict(zip(sp['Tên sản phẩm'],sp['Loại sản phẩm'])))\nprint(g.isna().sum())\nRESULT=f\"{d[g=='thực phẩm chức năng'].t.sum()/d.t.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f241b877efe2", "type": "number", "answer": 2, "_code": "import unicodedata, re\nd=So_chi_tiet_ban_hang__all.copy().drop_duplicates()\nd['d']=parse_date(d['Ngày'])\nbad=d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)\nok=d[~bad]\nnm=lambda s: re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower()\nok=ok.assign(n=ok['Tên hàng hóa'].map(nm))\nbefore=set(ok[ok.d<'2026-03-16'].n)\ninp=set(ok[(ok.d>='2026-03-16')&(ok.d<='2026-03-22')].n)\nRESULT=len(before-inp)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_af669cdf2e81", "type": "percent", "answer": -50.0, "_code": "import pandas as pd, re, datetime as dt\nITEM='Nước ép dưa hấu (L)'; D=pd.Timestamp('2025-11-25'); N=7\nframes=[v for k,v in data.items() if k.endswith('__all')]\na=pd.concat(frames,ignore_index=True)\ncid,cdate,citem,cst,cq='Mã đơn hàng','Ngày','Tên hàng hóa','Trạng thái','Số lượng quy đổi'\na=a[a[cid].astype(str).str.startswith('ORD')].drop_duplicates()\ndef pdate(x):\n    if isinstance(x,(int,float)) and not pd.isna(x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(x))\n    if hasattr(x,'year'): return pd.Timestamp(x)\n    s=str(x).strip()\n    if re.match(r'^\\d{4}-\\d{2}-\\d{2}',s): return pd.Timestamp(s[:10])\n    return pd.to_datetime(s,dayfirst=True,errors='coerce')\na['d']=a[cdate].map(pdate)\nbad=a[cst].astype(str).str.lower().str.contains('hủy|huỷ|cancel|trả|hoàn|đổi')\na=a[~a[cid].isin(set(a[bad][cid]))]\nx=a[a[citem].astype(str).str.strip().str.lower()==ITEM.lower()].copy()\nx['q']=pd.to_numeric(x[cq],errors='coerce')\ndef S(lo,hi): return x[(x.d>=lo)&(x.d<=hi)].q.sum()\naft=S(D,D+pd.Timedelta(days=N-1)); bef=S(D-pd.Timedelta(days=N),D-pd.Timedelta(days=1))\nprint(aft,bef,x.d.isna().sum())\nRESULT=f\"{round((aft-bef)/bef*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f96c8fcce412", "type": "percent", "answer": 1.78, "_code": "\nh=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nx=h[(h.dt>='2025-10-01')&(h.dt<='2025-10-31')]\nc=x['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False).sum()\nRESULT=f\"{round(c/len(x)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f6451c2549ca", "type": "number", "answer": 27, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\nh=BanHang_HoaDon.copy()\nh['dt']=parse_date(h['Ngày bán'])\nend=pd.Timestamp(as_of_date)\nh=h[(h.dt<=end)&~h['Trạng thái'].str.contains('Không giao được|hủy|huỷ',case=False,na=False)]\nh=h[~h['Phương thức TT'].str.contains('COD',na=False)]\nh['tot']=h['Tong tien'].map(money)\np=BanHang_PhieuThu.copy()\np['t']=pd.to_datetime(p['Thời gian thu'])\np=p[p.t<end+pd.Timedelta(days=1)]\npaid=p.assign(v=p['Số tiền thu'].map(money)).groupby('Mã bill').v.sum()\nh['debt']=h['tot']-h['Order ID'].map(paid).fillna(0)\nx=h[(h.debt>0.5)&h['Mã KH mua'].notna()]\nRESULT=int(x['Mã KH mua'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3af62393d8ed", "type": "number", "answer": 5460000, "_code": "d=ban_hang.copy().drop_duplicates()\nd['d']=parse_date(d['Ngày'])\nbad=d['trang_thai'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)\nm=d[~bad&(d.d>='2025-06-01')&(d.d<='2025-06-30')&d['Sản phẩm'].str.strip().str.lower().eq('tấm thạch cao gyproc 9mm 1.2x2.4m')]\nRESULT=int(round(to_num(m['Tổng']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
