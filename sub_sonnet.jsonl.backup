{"id": "q_a84e3f5561ab", "type": "number", "answer": 10590900, "_code": "\ndf=DonHang_ChiTiet.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill()\ndf=df.drop_duplicates()\nlo=DuLieuXuat['DonHang_Lo']\nret=set(lo.loc[pd.to_numeric(lo['Số lượng trả'],errors='coerce').fillna(0)>0,'Mã đơn hàng'])\ndf['d']=parse_date(df['Ngày đặt hàng'])\nm=(df['d']==pd.Timestamp(as_of_date))&~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)&~df['Mã đơn hàng'].isin(ret)\nRESULT=int(to_num(df.loc[m,'Tổng tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5876f4bbe0a3", "type": "number", "answer": 23, "_code": "\ndf=DonHang_ChiTiet.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill()\ndf['d']=parse_date(df['Ngày đặt hàng'])\nm=(df['d'].dt.year==2026)&(df['d'].dt.month==5)&df['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False,na=False)\nRESULT=int(df.loc[m,'Mã đơn hàng'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_df9676287589", "type": "percent", "answer": 7.1, "_code": "import re, numpy as np, unicodedata\ndef money(x):\n    if x is None or (isinstance(x,float) and np.isnan(x)): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan'): return np.nan\n    if 'tr' in s:\n        a,b=s.split('tr',1); a=a.strip().replace(',','.')\n        v=float(a)*1e6 if a else 0\n        b=b.strip()\n        if b: v+=int(b.ljust(3,'0')[:3])*1000\n        return v\n    if s.endswith('k'):\n        return float(s[:-1].replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.fullmatch(r'-?\\d+,\\d+',s) else float(s)\ndef nt(s):\n    return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower()\nimport pandas as pd\na=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[oc]=a[oc].ffill()\na=a.drop_duplicates()\na['d']=pd.to_datetime(a['Ngày đặt hàng'],format='%d/%m/%Y')\na['v']=a['Tổng tiền'].map(money)\na['k']=a['Tên sản phẩm'].map(vn_normalize)\na=a[~a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nm=a[(a.d>='2025-11-01')&(a.d<='2025-11-30')]\ncat=DanhSachSanPham.assign(k=DanhSachSanPham['Tên sản phẩm'].map(vn_normalize)).set_index('k')['Loại sản phẩm']\nm=m.assign(c=m.k.map(cat))\nRESULT=f\"{m[m.c=='thực phẩm chức năng'].v.sum()/m.v.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c972201b657c", "type": "number", "answer": 82128900, "_code": "import sys; sys.path.insert(0,'/private/tmp/claude-501/-Users-buivanthien-Learn-zalo-chelen-datamate/7233357a-8405-4755-9e0c-0373d882e3e4/scratchpad')\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in('nan','','none'): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+[,.]\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): v=float(s.replace(',',''))\n    else: v=float(s.replace(',','.'))\n    return -v if neg else v\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\nd['d']=parse_date(d['Ngày giao dịch'])\nd['st']=d['Status'].fillna('')\nbad=d[d['st'].str.contains('hủy|huỷ|trả|Không giao|hoàn',case=False)|(d['so_luong']<0)]['Mã hóa đơn'].unique()\nd=d[~d['Mã hóa đơn'].isin(bad)]\nd['v']=d['Trị giá'].map(money)\nt=pd.Timestamp(as_of_date); s=t-pd.Timedelta(days=6)\nx=d[(d.d>=s)&(d.d<=t)]\nRESULT=int(round(x.v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_cd5692898ae3", "type": "percent", "answer": 41.7, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    m=re.match(r'^(\\d+)tr(\\d{3})?$',s)\n    if m: return int(m.group(1))*1000000+int(m.group(2) or 0)\n    return float(re.sub(r'[^\\d\\-]','',s) or 0)\no=don_hang.copy()\no['dt']=parse_date(o['Ngày'])\no=o[(o.dt>='2025-10-01')&(o.dt<='2025-10-31')&(o['Tình trạng'].isin(['completed','shipping']))]\nc=chi_tiet_don.copy(); c['a']=c['Amount'].map(money)\ns=c.groupby('Mã đơn hàng').a.sum()\no['t']=o['Mã chứng từ'].map(s).fillna(0)\nRESULT='%.2f%%'%(o[o['Trả bằng']=='transfer'].t.sum()/o.t.sum()*100)\n", "_attempts": 3, "_verdict": "wrong"}
{"id": "q_b5c6483cc5fd", "type": "percent", "answer": -7.4, "_code": "h=DuLieuBanHang__DanhSachHoaDon.drop_duplicates().copy()\nh['d']=parse_date(h['Thời gian'])\nh['st']=h['Trạng thái'].astype(str).str.lower()\nok=h[~h.st.str.contains('hủy|huỷ|trả|cancel')].drop_duplicates('Mã hóa đơn')\nd=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nd['tt']=to_num(d['Thành tiền'])\nrev=d.groupby('Mã hóa đơn').tt.sum()\nok=ok.assign(rev=ok['Mã hóa đơn'].map(rev).fillna(0))\ndef R(a,b): return ok[(ok.d>=a)&(ok.d<=b)]\na=R('2026-07-01','2026-07-31').rev.sum(); b=R('2025-07-01','2025-07-31').rev.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_20d5aeb823b2", "type": "number", "answer": 156348, "_code": "import re\nd=DonHang_ChiTiet__all.copy().drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[(d.dt>='2025-05-01')&(d.dt<='2025-05-31')]\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nd['amt']=pd.to_numeric(d['Tổng tiền'].astype(str).str.replace(',',''),errors='coerce')\nRESULT=int(round(d.amt.sum()/d['Mã đơn hàng'].nunique()))\n", "_attempts": 1, "_verdict": "correct"}
