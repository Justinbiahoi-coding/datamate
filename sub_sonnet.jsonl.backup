{"id": "q_c39654b0cc07", "type": "list", "answer": ["Tạ Giang Phúc", "Triệu Ngọc Hiếu", "Tạ Giang Khánh", "Tô Anh Minh", "Ông Phong Thắng"], "_code": "def money(x):\n    s=str(x).strip().lower().replace('đ','')\n    if s in ('','nan'): return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); return float(a.replace(',','').replace('.',''))*1e6+(float((b+'000')[:3]) *1e3 if b else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','').replace('.',''))*1e3\n    return float(s.replace(',','').replace('.',''))\no=don_hang[don_hang['Tình trạng'].isin(['completed','shipping'])&don_hang['Customer ID'].notna()].copy()\no['d']=pd.to_datetime(o['Ngày'],errors='coerce')\no=o[(o.d>='2025-09-01')&(o.d<'2025-10-01')]\nd=chi_tiet_don.drop_duplicates()\nd=d[d['Mã đơn hàng'].isin(o['Mã chứng từ'])].copy()\nd['v']=d['Amount'].map(money)\nd=d.merge(o[['Mã chứng từ','Customer ID']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\ns=d.groupby('Customer ID')['v'].sum().sort_values(ascending=False)\nnm=khach_hang.set_index('Mã KH')['Khách hàng (tên)']\nRESULT=[nm[k] for k in s.index[:5]]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_c76c1af8896e", "type": "number", "answer": 52.0, "_code": "o=DonHang_ChiTiet__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\no[h]=o[h].ffill(); o=o.drop_duplicates()\no['d']=parse_date(o['Ngày đặt hàng']); o['amt']=to_num(o['Tổng tiền'])\no['q']=o['Số lượng sản phẩm'].astype(str).str.extract(r'^\\s*([\\d.]+)')[0].astype(float)\nbad=set(o[o['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|hoàn hàng|hoàn trả|trả',case=False)]['Mã đơn hàng'])\ng=o[~o['Mã đơn hàng'].isin(bad)]\nx=g[(g.d>='2026-05-01')&(g.d<='2026-05-31')&(g['Tên sản phẩm']=='Nếp cái hoa vàng')]\nRESULT=float(x.q.sum())\n", "_attempts": 3, "_verdict": "correct"}
{"id": "q_49922221a2d2", "type": "date", "answer": "2025-06-23", "_code": "import re\ndef pm(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,'0')[:3])*1000 if f else 0) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+\\.\\d+',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    if re.fullmatch(r'\\d+[.,]\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\nd=SoBanHang.copy()\nd['dt']=parse_date(d['ngay_ban'])\nd=d[~d['Trạng thái xử lý'].isin(['Không giao được','trả hàng'])]\nd=d[(d.dt>='2025-06-01')&(d.dt<='2025-06-30')]\nd['t']=d['Tổng tiền'].apply(pm)\nRESULT=d.groupby('dt').t.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_14eca92559aa", "type": "number", "answer": 538549, "_code": "\nd=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).dropna(subset=['Mã đơn hàng']).drop_duplicates().copy(); d['d']=parse_date(d['Ngày']); d['amt']=to_num(d['Thành tiền'])\nbad=d[d['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả',case=False)]['Mã đơn hàng'].unique()\nm=d[~d['Mã đơn hàng'].isin(bad)&(d.d>='2026-05-01')&(d.d<'2026-06-01')]\nr=m.groupby('Mã đơn hàng').amt.sum()\nRESULT=int(r.mean()+0.5)", "_attempts": 3, "_verdict": "correct"}
{"id": "q_02eb42db6665", "type": "string", "answer": "Bia Tiger lon", "_code": "d=ban_hang.drop_duplicates().copy()\nd['d']=parse_date(d['Ngày bán'])\nd=d[(d.d.dt.year==2025)&(d.d.dt.month==5)]\nbad=d.groupby('Số phiếu')['Trạng thái xử lý'].apply(lambda s:s.str.contains('hủy|huỷ|trả',case=False).any())\nd=d[d['Số phiếu'].isin(bad[~bad].index)]\nd=d[~d['Hàng bán'].str.contains('Phí phục vụ',case=False,na=False)]\nd['q']=to_num(d['Số lượng lẻ'])\nd['k']=d['Hàng bán'].str.lower().str.split().str.join(' ')\ng=d.groupby('k')['q'].sum().sort_values(ascending=False)\ntop=g.index[0]\nRESULT=d[d.k==top]['Hàng bán'].value_counts().index[0]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_e86746fa9b28", "type": "percent", "answer": 1.34, "_code": "\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh['m']=pd.to_numeric(h['Tổng tiền hàng'].astype(str).str.replace(',',''),errors='coerce')\n\nh=h[(h.d>='2026-05-01')&(h.d<='2026-05-31')]\nn=h['Trạng thái'].astype(str).str.contains('hủy|huỷ',case=False).sum()\nRESULT=f\"{round(n/len(h)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2be345d37d89", "type": "percent", "answer": -8.51, "_code": "\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh['m']=pd.to_numeric(h['Tổng tiền hàng'].astype(str).str.replace(',',''),errors='coerce')\n\nok=h[~h['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả',case=False)]\na=ok[(ok.d>='2025-02-01')&(ok.d<='2025-02-28')]['m'].sum(); b=ok[(ok.d>='2025-01-01')&(ok.d<='2025-01-31')]['m'].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_164202c9de46", "type": "number", "answer": 114.0, "_code": "\np=DanhSachSanPham[DanhSachSanPham['Tên hàng'].str.contains('Costar Omega 3 1000mg',case=False)]\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[(h.d>='2026-03-01')&(h.d<='2026-03-31')&~h['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả',case=False)]\nd=DanhSachHoaDonChiTiet.drop_duplicates()\nd=d[d['Mã hóa đơn'].isin(h['Mã hóa đơn'])&d['Mã hàng'].isin(p['Mã hàng'])]\nRESULT=float(pd.to_numeric(d['Số lượng quy đổi'].astype(str).str.replace(',','')).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_36f450727089", "type": "string", "answer": "Mì Hảo Hảo tôm chua cay", "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=SoBanHang.copy()\nst=df['Trạng thái xử lý'].astype(str).str.lower()\ndf=df[~st.str.contains('hủy|huỷ|trả|không giao được')]\ndf['d']=parse_date(df['ngay_ban'])\ndf['q']=df['Số lượng lẻ'].map(m)\nw=df[(df.d>='2025-03-01')&(df.d<'2025-04-01')]\nRESULT=w.groupby('Nội dung').q.sum().sort_values(ascending=False).index[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5d9f6550bb9c", "type": "list", "answer": ["Mì Hảo Hảo tôm chua cay", "Snack Oishi tôm cay 40g", "Trứng gà so", "Mì Omachi sườn hầm", "Snack Lay's vị tự nhiên 56g"], "_code": "\nd=DonHang_ChiTiet__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill(); d=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['q']=d['Số lượng sản phẩm'].astype(str).str.extract(r'(-?\\d+(?:\\.\\d+)?)')[0].astype(float)\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|hoàn hàng|trả',case=False,na=False)|(d.q<0)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nf=DanhSachQuyDoi.set_index(['Tên sản phẩm','Đơn vị quy đổi'])['Tỉ lệ quy đổi'].map(float)\nd['k']=[f.get((a,b),1.0) for a,b in zip(d['Tên sản phẩm'],d['Đơn vị tính'])]\nd['base']=d.q*d.k\nx=d[(d.dt>='2025-12-01')&(d.dt<'2026-01-01')]\nRESULT=x.groupby('Tên sản phẩm').base.sum().sort_values(ascending=False).head(5).index.tolist()\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_5e75fcb3f8ce", "type": "unanswerable", "answer": "unanswerable", "_code": "d=DonHang_ChiTiet__all\ndt=parse_date(d['Ngày đặt hàng'].ffill())\nlo,hi=dt.min(),dt.max()\ns,e=pd.Timestamp('2025-03-01'),pd.Timestamp('2025-03-31')\nRESULT='unanswerable' if (hi<s or lo>e) else f'{lo} {hi}'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_cfea850ecaa2", "type": "unanswerable", "answer": "unanswerable", "_code": "d=DonHang_ChiTiet__all\ndt=parse_date(d['Ngày đặt hàng'].ffill())\nlo,hi=dt.min(),dt.max()\ns,e=pd.Timestamp('2025-03-01'),pd.Timestamp('2025-03-31')\nRESULT='unanswerable' if (hi<s or lo>e) else f'{lo} {hi}'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_739382e3c7b5", "type": "list", "answer": ["Tiffy Dey hộp 25 vỉ x 4 viên", "Decolgen Forte hộp 30 vỉ x 4 viên", "Khẩu trang y tế 4 lớp Khánh An hộp 50 cái"], "_code": "import re\ndef pm(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,'0')[:3])*1000 if f else 0) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+\\.\\d+',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    if re.fullmatch(r'\\d+[.,]\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\nsp=DanhSachSanPham.copy(); sp['k']=sp['Tên sản phẩm'].str.lower().str.strip()\ncanon=dict(zip(sp.k,sp['Tên sản phẩm'])); code=dict(zip(sp.k,sp['Mã SKU']))\nqd=DanhSachQuyDoi.copy(); qd['k']=qd['Tên sản phẩm'].str.lower().str.strip()\nratio={(r.k,r['Đơn vị quy đổi']):float(r['Tỉ lệ quy đổi']) for _,r in qd.iterrows()}\ndf=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[h]=df[h].ffill()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[(df.d>='2025-03-17')&(df.d<='2025-03-23')]\ndf=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng',case=False,na=False)].drop_duplicates()\ndf['k']=df['Tên sản phẩm'].str.lower().str.strip()\ndf['q']=pd.to_numeric(df['Số lượng sản phẩm'],errors='coerce')*[ratio.get((k,u),1.0) for k,u in zip(df.k,df['Đơn vị tính'])]\ng=df.groupby('k').q.sum().reset_index(); g['c']=g.k.map(code)\ng=g.sort_values(['q','c'],ascending=[False,True])\nRESULT=[canon.get(k,k) for k in g.k.head(3)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_eca9d1170a2b", "type": "number", "answer": 12211000, "_code": "\nh=DanhSachHoaDon.drop_duplicates().copy(); h['d']=pd.to_datetime(h['Thời gian tạo'])\nh=h[(h['Phương thức thanh toán']=='Thu hộ (COD)')&~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)&(h.d>='2026-03-01')&(h.d<'2026-04-01')]\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates()\nc['amt']=to_num(c['Thành tiền'])\nRESULT=int(c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].amt.sum())", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1f99d93acad3", "type": "list", "answer": [403500, 857334, 229836], "_code": "\nh=DanhSachHoaDon.drop_duplicates().copy(); h['d']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ',case=False)&(h['Phương thức thanh toán']!='Thu hộ (COD)')&(h.d<=as_of_date)]\ns=SoQuy.copy(); s['t']=pd.to_datetime(s['Thời gian']).dt.normalize()\ns['v']=s['Giá trị'].astype(str).str.replace('đ','').str.replace('.','').str.replace(',','').astype(float)\npaid=s[s.t<=as_of_date].groupby('Mã hóa đơn').v.sum()\nh['rem']=to_num(h['Tổng sau giảm giá'])-h['Mã hóa đơn'].map(paid).fillna(0)\nh=h[h.rem>0]\nage=(pd.Timestamp(as_of_date)-h.d).dt.days\nRESULT=[int(h[age<=7].rem.sum()),int(h[(age>=8)&(age<=15)].rem.sum()),int(h[age>15].rem.sum())]", "_attempts": 1, "_verdict": "correct"}
{"id": "q_cc1d4620a18e", "type": "string", "answer": "La Thu Quân", "_code": "\no=don_hang.drop_duplicates('MaHoaDon').copy()\no['d']=pd.to_datetime(o['ThoiGianLap']).dt.normalize()\no=o[~o['TinhTrang'].isin(['cancelled','returned'])]\nl=chi_tiet_don.drop_duplicates(['MaHoaDon','SoThuTu']).copy()\nl['m']=pd.to_numeric(l['TriGia'],errors='coerce')\n\no=o[(o.d>='2026-04-01')&(o.d<='2026-04-30')]\nt=l[l['MaHoaDon'].isin(o['MaHoaDon'])].merge(o[['MaHoaDon','MaNhanVien']],on='MaHoaDon')\nnv=t.groupby('MaNhanVien')['m'].sum().idxmax()\nRESULT=nhan_vien.set_index('MaNhanVien').loc[nv,'TenGoi']\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_47a1c26a50dd", "type": "date", "answer": "2025-09-01", "_code": "import re\ndef pm(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,'0')[:3])*1000 if f else 0) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+\\.\\d+',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    if re.fullmatch(r'\\d+[.,]\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\ndf=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[h]=df[h].ffill()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[(df.d>='2025-09-01')&(df.d<='2025-09-30')]\ndf=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng',case=False,na=False)].drop_duplicates()\ndf['t']=df['Tổng tiền'].apply(pm)\nRESULT=df.groupby('d').t.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_cea1b708d80a", "type": "number", "answer": 3, "_code": "\nt=DuLieuBanHang__BaoCaoTonKho\nRESULT=int(to_num(t[t['Tên hàng']=='Kem đánh răng P/S 180g']['Tồn cuối kỳ']).iloc[0])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b2d6d7e451ac", "type": "percent", "answer": "53.90%", "_code": "biz_123 Aug2025 customers (MaKhachHang notna, nunique orders excl cancelled/returned); share with >=4 orders", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b71b56dffceb", "type": "list", "answer": ["Xi măng Hà Tiên PCB40 bao 50kg", "Băng keo điện Nano 20 yard", "Xi măng INSEE Power-S bao 50kg"], "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().replace('đ','').replace(' ','').lower()\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr'); \n        v=float(a.replace(',','.'))*1e6 if (b=='' or ',' in a) else float(a)*1e6+float(b.ljust(3,'0'))*1e3\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\ndf=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\ndf['d']=parse_date(df['Giờ'])\ndf['amt']=df['Tiền'].apply(money)\nbad=df[df['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã phiếu'].unique()\nneg=df[df['Số lượng hàng'].astype(str).str.startswith('-')]['Mã phiếu'].unique()\nok=df[~df['Mã phiếu'].isin(set(bad)|set(neg))]\n\nm=ok[(ok.d>='2026-04-01')&(ok.d<'2026-05-01')].copy()\nm['q']=pd.to_numeric(m['Số lượng hàng'].astype(str).str.extract(r'(-?\\d+\\.?\\d*)')[0])\nf={(r['Hàng'],str(r['ĐV lớn']).strip()):float(r['Hệ số QĐ']) for _,r in DanhMuc.iterrows()}\nm['q']=m.q*[f.get((a,str(b).strip()),1) for a,b in zip(m['Tên SP'],m['DonVi'])]\nRESULT=list(m.groupby('Tên SP').q.sum().sort_values(ascending=False).head(3).index)\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_dbbfb4af332c", "type": "date", "answer": "2025-04-30", "_code": "d=ban_hang.drop_duplicates().copy()\nd=d[~d['trang_thai'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd['d']=parse_date(d['Ngày']); d['amt']=to_num(d['Tổng'])\nd=d[(d.d.dt.year==2025)&(d.d.dt.month==4)]\nRESULT=d.groupby('d')['amt'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e2b70d845dac", "type": "number", "answer": 9300, "_code": "\nh=DuLieuBanHang__DanhSachHoaDon.copy()\nh['dt']=parse_date(h['Thời gian']).dt.normalize()\no=h[h.dt=='2026-07-08']['Mã hóa đơn']\nl=DanhSachHoaDonChiTiet[DanhSachHoaDonChiTiet['Mã hóa đơn'].isin(o)&(DanhSachHoaDonChiTiet['Mã hàng']=='SP0012')].copy()\nq=DuLieuBanHang__DanhSachDonViTinh.set_index(['Mã hàng','ĐVT'])['Quy đổi'].map(float)\nl['k']=[q.get(('SP0012',u),1.0) for u in l['Đơn vị tính']]\nRESULT=int(round((to_num(l['Đơn giá'])/l.k).iloc[0]))\n", "_attempts": 1, "_verdict": "correct"}
