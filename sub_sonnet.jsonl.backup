{"id": "q_aea078d285c2", "type": "percent", "answer": 18.41, "_code": "\ninv=data['DanhSachHoaDon'].copy()\ninv['d']=parse_date(inv['Thời gian'])\ninv=inv[inv['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\ndet=data['DanhSachHoaDonChiTiet'].drop_duplicates(['Mã hóa đơn','STT']).copy()\ndet['amt']=to_num(det['Thành tiền'])\nrev=det.groupby('Mã hóa đơn')['amt'].sum()\ninv['rev']=inv['Mã hóa đơn'].map(rev).fillna(0)\n\nm=inv[(inv.d.dt.year==2025)&(inv.d.dt.month==3)]\nkh=data['DanhSachKhachHang']\ng=kh[kh['Nhóm khách hàng'].astype(str).str.contains('thân thiết',case=False)]['Mã khách hàng']\nRESULT=f\"{m[m['Mã KH'].isin(g)].rev.sum()/m.rev.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7e974a3f4552", "type": "date", "answer": "2026-01-31", "_code": "\ninv=data['DanhSachHoaDon'].copy()\ninv['d']=parse_date(inv['Thời gian'])\ninv=inv[inv['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\ndet=data['DanhSachHoaDonChiTiet'].drop_duplicates(['Mã hóa đơn','STT']).copy()\ndet['amt']=to_num(det['Thành tiền'])\nrev=det.groupby('Mã hóa đơn')['amt'].sum()\ninv['rev']=inv['Mã hóa đơn'].map(rev).fillna(0)\n\nm=inv[(inv.d.dt.year==2026)&(inv.d.dt.month==1)]\ns=m.groupby('d').rev.sum().sort_values(ascending=False)\nRESULT=s.index[0].strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
