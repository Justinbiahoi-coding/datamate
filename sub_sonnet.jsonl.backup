{"id": "q_636eafd783aa", "type": "number", "answer": 281036000, "_code": "\ns=So_chi_tiet_ban_hang_1__T04_2025.drop_duplicates().copy()\ns['st']=s['Trạng thái'].astype(str).str.lower()\nbad=s[s.st.str.contains('hủy|huỷ|cancel|trả|hoàn trả')]['Mã đơn hàng'].unique()\nRESULT=int(to_num(s[~s['Mã đơn hàng'].isin(bad)]['Thành tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_735d09a7e75a", "type": "percent", "answer": 6.77, "_code": "import re\ndef m1(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    if 'tr' in s:\n        a,b=s.split('tr',1)\n        return int(a or 0)*1000000+(int(b.ljust(3,'0'))*1000 if b else 0)\n    if s.endswith('k'): return float(s[:-1])*1000\n    return float(re.sub(r'[^\\d\\-]','',s) or 0)\no=don_hang.copy(); o=o[o['Tình trạng'].isin(['completed','shipping'])]\no['d']=pd.to_datetime(o['Ngày'])\nc=chi_tiet_don.drop_duplicates().copy(); c['amt']=c['Amount'].map(m1)\ndef rev(y,m):\n    ids=o[(o.d.dt.year==y)&(o.d.dt.month==m)]['Mã chứng từ']\n    return c[c['Mã đơn hàng'].isin(ids)]['amt'].sum()\na=rev(2026,4); b=rev(2025,4)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_d42bb63de182", "type": "list", "answer": ["Xi măng Hà Tiên PCB40 bao 50kg", "Xi măng INSEE Power-S bao 50kg", "Lưới B40 mạ kẽm khổ 1.5m"], "_code": "\nimport re\nd=SoBanHang__all.copy().drop_duplicates()\nd['dt']=pd.to_datetime(d['Giờ'],errors='coerce')\nst=d['Ghi chú TT'].astype(str).str.lower()\nd['q']=d['Số lượng hàng'].astype(str).str.extract(r'(-?[\\d.]+)')[0].astype(float)\nbad=d[st.str.contains('hủy|huỷ|trả')|(d.q<0)]['Mã phiếu'].unique()\nd=d[~d['Mã phiếu'].isin(bad)]\ndm=DanhMuc.set_index('Hàng')\ndef conv(r):\n    if r['Tên SP'] in dm.index and r['DonVi']==dm.loc[r['Tên SP'],'ĐV lớn']:\n        return r.q*float(dm.loc[r['Tên SP'],'Hệ số QĐ'])\n    return r.q\nd['base']=d.apply(conv,axis=1)\n\nx=d[(d.dt>='2025-11-01')&(d.dt<'2025-12-01')]\nRESULT=x.groupby('Tên SP')['base'].sum().sort_values(ascending=False).head(3).index.tolist()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b317bf80d30f", "type": "number", "answer": 729, "_code": "\ng=SoGiaoHang.copy()\ng['dt']=parse_date(g['Ngày chở'])\nx=g[(g.dt>='2025-08-01')&(g.dt<'2025-09-01')]\nRESULT=int(x[['Mã bill','Lượt giao']].drop_duplicates().shape[0])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5bd982aff4ad", "type": "number", "answer": 1500287200, "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=So_chi_tiet_ban_hang__all.copy().drop_duplicates()\ndf['amt']=df['Thành tiền'].map(m)\nst=df['Trạng thái'].astype(str).str.lower()\nbad=set(df.loc[st.str.contains('hủy|huỷ|trả'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf['d']=parse_date(df['Ngày'])\nw=df[(df.d>='2025-11-01')&(df.d<'2025-12-01')]\nRESULT=int(round(w.amt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a91735cf4993", "type": "percent", "answer": 2.42, "_code": "df=So_chi_tiet_ban_hang_1.copy()\ndf=pd.concat([df,So_chi_tiet_ban_hang_2],ignore_index=True)\ndf['d']=parse_date(df['Ngày'])\ndf=df[(df.d>='2025-10-01')&(df.d<='2025-10-31')]\no=df.groupby('Mã đơn hàng')['Trạng thái'].first()\nRESULT=f\"{round(o.str.contains('hủy|huỷ',case=False).mean()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a053fa5f27fb", "type": "percent", "answer": -1.92, "_code": "import re\ndef money(s):\n    s = str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\na=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\na['q']=a['so_luong'].map(money); a['v']=a['Trị giá'].map(money); a['d']=parse_date(a['Ngày giao dịch'])\na['d']=a.groupby('Mã hóa đơn')['d'].transform('first')\nbad=a['Status'].astype(str).str.contains('hủy|huỷ|trả|đổi',case=False,na=False)|(a.q<0)\nbid=set(a.loc[bad,'Mã hóa đơn'])\ng=a[~a['Mã hóa đơn'].isin(bid)]\nnm='Sữa tươi trân châu đường đen (M)'\nb=a[(a.Hàng==nm)&~a['Mã hóa đơn'].isin(bid)]\nD=pd.Timestamp('2026-06-11')\nn1=b[(b.d>=D)&(b.d<D+pd.Timedelta(days=7))].q.sum(); n0=b[(b.d>=D-pd.Timedelta(days=7))&(b.d<D)].q.sum()\nRESULT=f\"{(n1-n0)/n0*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_36e497167542", "type": "date", "answer": "2025-10-04", "_code": "\nd=ban_hang.copy(); d['d']=parse_date(d['Ngày tháng'])\nbad=d[d['Kết quả'].isin(['Đã hủy','Đổi trả'])]['Mã hóa đơn'].unique()\nm=d[~d['Mã hóa đơn'].isin(bad)&(d.d>='2025-10-01')&(d.d<'2025-11-01')]\nRESULT=str(to_num(m['Thanh tien']).groupby(m.d.dt.date).sum().idxmax())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_18d173308b03", "type": "string", "answer": "Trịnh Thanh Dương", "_code": "import re\ndef money(s):\n    s = str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\na=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\na['q']=a['so_luong'].map(money); a['v']=a['Trị giá'].map(money); a['d']=parse_date(a['Ngày giao dịch'])\na['d']=a.groupby('Mã hóa đơn')['d'].transform('first')\nbad=a['Status'].astype(str).str.contains('hủy|huỷ|trả|đổi',case=False,na=False)|(a.q<0)\nbid=set(a.loc[bad,'Mã hóa đơn'])\ng=a[~a['Mã hóa đơn'].isin(bid)]\nx=g[(g.d>='2025-06-01')&(g.d<='2025-06-30')&(g.Khách!='Khách lẻ')]\nRESULT=x.groupby('Khách').v.sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_85d5016966f2", "type": "list", "answer": ["Thái Ngọc Hoàng", "Phan Chi Anh", "Đặng Loan Phong"], "_code": "import re\ndef money(s):\n    s = str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\na=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\na['q']=a['so_luong'].map(money); a['v']=a['Trị giá'].map(money); a['d']=parse_date(a['Ngày giao dịch'])\na['d']=a.groupby('Mã hóa đơn')['d'].transform('first')\nbad=a['Status'].astype(str).str.contains('hủy|huỷ|trả|đổi',case=False,na=False)|(a.q<0)\nbid=set(a.loc[bad,'Mã hóa đơn'])\ng=a[~a['Mã hóa đơn'].isin(bid)]\nx=g[(g.d>=pd.Timestamp(as_of_date)-pd.Timedelta(days=pd.Timestamp(as_of_date).weekday()))&(g.d<=as_of_date)&(g.Khách!='Khách lẻ')]\nRESULT=list(x.groupby('Khách').v.sum().nlargest(3).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_261be063aa99", "type": "percent", "answer": 1.47, "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\nd=don_hang.copy(); c=chi_tiet_don.copy().drop_duplicates()\nd=d[d['Tình trạng'].isin(['completed','shipping'])]\nd['dt']=parse_date(d['Ngày'])\nc['a']=c['Amount'].map(m)\nc=c.merge(d[['Mã chứng từ','dt']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\ndef rev(a,b): return c[(c.dt>=a)&(c.dt<b)].a.sum()\ncur=rev('2025-10-01','2025-11-01'); pre=rev('2025-09-01','2025-10-01')\nRESULT=f\"{round((cur-pre)/pre*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_210839280113", "type": "string", "answer": "Mai Bích Dũng", "_code": "import re\na=So_chi_tiet_ban_hang__all.copy()\na=a.drop_duplicates()\na['d']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na=a[(a.d.dt.year==2026)&(a.d.dt.month==8)]\na['k']=a['Khách hàng'].astype(str).str.replace(r'[\\d\\s\\.\\-\\(\\)]+$','',regex=True).str.strip()\na=a[~a.k.str.lower().isin(['lẻ','khách lẻ','kl','nan',''])]\n# order-level status: any hủy/trả bad\nbad=a.groupby('Mã đơn hàng')['Trạng thái'].apply(lambda s:s.str.contains('hủy|huỷ|trả',case=False).any())\nok=bad[~bad].index\na=a[a['Mã đơn hàng'].isin(ok)]\nn=a.groupby('k')['Mã đơn hàng'].nunique().sort_values(ascending=False)\nRESULT=n.index[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ed929e98cc18", "type": "string", "answer": "Vương Phúc Dương", "_code": "import re\ndef pm(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,'0')[:3])*1000 if f else 0) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+\\.\\d+',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    if re.fullmatch(r'\\d+[.,]\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\nd=So_chi_tiet_ban_hang__all.reset_index(drop=True)\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt>='2026-01-01')&(d.dt<='2026-01-31')]\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả hàng',case=False)]\n# whole-order exclusion by order status (status per order)\nd=d.drop_duplicates()\nd['t']=d['Thành tiền'].apply(pm)\nk=d['Khách hàng'].astype(str).str.strip()\nd=d[~k.str.lower().isin(['kl','khách lẻ','lẻ','khach le','nan',''])]\nRESULT=d.groupby('Khách hàng')['t'].sum().sort_values(ascending=False).index[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bbdd76a5546c", "type": "number", "answer": 163, "_code": "\nt=BaoCaoTonKho[BaoCaoTonKho['Tên hàng'].str.contains('heineken',case=False)]\nRESULT=int(to_num(t['Tồn cuối kỳ']).iloc[0])  # data ends == as_of_date; README: Tồn cuối kỳ = tồn cuối ngày cuối\n", "_attempts": 3, "_verdict": "correct"}
{"id": "q_a4560b62b198", "type": "unanswerable", "answer": "unanswerable", "_code": "cols=[c for k,v in data.items() if hasattr(v,'columns') for c in v.columns]\naddr=[c for c in cols if any(w in str(c).lower() for w in ['địa chỉ','dia chi','đường','address','phố'])]\nRESULT='unanswerable' if not addr else str(addr)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_599af8beb51e", "type": "date", "answer": "2026-02-04", "_code": "\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy(); d['d']=parse_date(d['Ngày']); d['amt']=to_num(d['Thành tiền'])\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)]['Mã đơn hàng'].unique()\nok=d[~d['Mã đơn hàng'].isin(bad)]\n\nm=ok[(ok.d>='2026-02-01')&(ok.d<'2026-03-01')]\nRESULT=str(m.groupby(m.d.dt.date).amt.sum().idxmax())", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5c7a3aed2f4f", "type": "percent", "answer": -3.19, "_code": "\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy(); d['d']=parse_date(d['Ngày']); d['amt']=to_num(d['Thành tiền'])\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)]['Mã đơn hàng'].unique()\nok=d[~d['Mã đơn hàng'].isin(bad)]\n\na=ok[(ok.d>='2025-08-01')&(ok.d<'2025-09-01')].amt.sum(); b=ok[(ok.d>='2025-07-01')&(ok.d<'2025-08-01')].amt.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\" ", "_attempts": 1, "_verdict": "correct"}
{"id": "q_796100b5a70b", "type": "list", "answer": ["Gạch ống 8x8x18 Tuynel", "Ngói Đồng Nai 22 viên/m2", "Xi măng Hà Tiên PCB40 bao 50kg", "Xi măng INSEE Power-S bao 50kg", "Thép Pomina D10 cây 11.7m"], "_code": "\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy(); d['d']=parse_date(d['Ngày']); d['amt']=to_num(d['Thành tiền'])\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)]['Mã đơn hàng'].unique()\nok=d[~d['Mã đơn hàng'].isin(bad)]\n\nm=ok[(ok.d>='2025-02-01')&(ok.d<'2025-03-01')].copy()\nm['q']=pd.to_numeric(m['Số lượng quy đổi'])\ncode=dict(zip(vn_normalize_series(m['Tên hàng hóa']) if False else [], []))\ns=m.groupby('Tên hàng hóa').q.sum().reset_index()\nh=data['Danh sách hàng hóa'] if 'Danh sách hàng hóa' in data else None\nRESULT=list(s.sort_values('q',ascending=False).head(5)['Tên hàng hóa'])", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d5780f0acb78", "type": "percent", "answer": 78.57, "_code": "\no=don_hang[~don_hang.TinhTrang.isin(['cancelled','returned'])][['MaHoaDon','NgayLap']]\nl=chi_tiet_don[chi_tiet_don.MaHangHoa=='SP0061'].merge(o,on='MaHoaDon')\nl['dt']=parse_date(l['NgayLap']).dt.normalize()\nl['q']=to_num(l['SLQuyDoi'])\na=l[(l.dt>='2025-11-20')&(l.dt<='2025-11-26')].q.sum()\nb=l[(l.dt>='2025-11-13')&(l.dt<='2025-11-19')].q.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9cffc3664c62", "type": "string", "answer": "Xi măng Hà Tiên PCB40 bao 50kg", "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=SoBanHang.copy()\nst=df['Ghi chú TT'].astype(str).str.lower()\ndf=df[~st.str.contains('hủy|huỷ|trả')]\ndf['d']=parse_date(df['Ngày mua'])\ndf['q']=df['Số lượng lẻ'].map(m)\nw=df[(df.d>='2025-10-01')&(df.d<'2025-11-01')]\nRESULT=w.groupby('Mặt hàng').q.sum().sort_values(ascending=False).index[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f403991d1218", "type": "unanswerable", "answer": "unanswerable", "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=DonHang_ChiTiet__all.copy()\nd=parse_date(df['Ngày đặt hàng'])\nlo,hi=d.min(),d.max()\na,b=pd.Timestamp('2025-03-01'),pd.Timestamp('2025-03-31')\nif b<lo or a>hi: RESULT='unanswerable'\nelse:\n    RESULT='in range'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_50e6defb9ba3", "type": "percent", "answer": -0.23, "_code": "\ndef money(s):\n    return s.astype(str).str.replace(r'[^\\d]','',regex=True).replace('',None).astype(float)\ndef month(y,m):\n    df=get_month_df('DonHang_ChiTiet',y,m).copy()\n    hc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\n    df[hc]=df[hc].ffill()\n    df=df[~df['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|trả|hoàn hàng',case=False)]\n    df['d']=parse_date(df['Ngày đặt hàng']).dt.strftime('%Y-%m-%d')\n    df['m']=money(df['Tổng tiền'])\n    return df\n\na=month(2026,4)['m'].sum(); b=month(2026,3)['m'].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_13db1a0a7ea9", "type": "list", "answer": ["Thân Cường Bình", "Dương Duy Hồng", "Bùi Ngân Hồng"], "_code": "\ndef money(s):\n    return s.astype(str).str.replace(r'[^\\d]','',regex=True).replace('',None).astype(float)\ndef month(y,m):\n    df=get_month_df('DonHang_ChiTiet',y,m).copy()\n    hc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\n    df[hc]=df[hc].ffill()\n    df=df[~df['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|trả|hoàn hàng',case=False)]\n    df['d']=parse_date(df['Ngày đặt hàng']).dt.strftime('%Y-%m-%d')\n    df['m']=money(df['Tổng tiền'])\n    return df\n\ndf=month(2025,6); df=df[~df['Tên khách hàng'].astype(str).str.contains('lẻ|^kl$',case=False)]\nRESULT=list(df.groupby('Tên khách hàng')['m'].sum().nlargest(3).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_59fe1e80340f", "type": "date", "answer": "2026-04-01", "_code": "\ndef money(s):\n    return s.astype(str).str.replace(r'[^\\d]','',regex=True).replace('',None).astype(float)\ndef month(y,m):\n    df=get_month_df('DonHang_ChiTiet',y,m).copy()\n    hc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\n    df[hc]=df[hc].ffill()\n    df=df[~df['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|trả|hoàn hàng',case=False)]\n    df['d']=parse_date(df['Ngày đặt hàng']).dt.strftime('%Y-%m-%d')\n    df['m']=money(df['Tổng tiền'])\n    return df\nRESULT=month(2026,4).groupby('d')['m'].sum().idxmax()", "_attempts": 1, "_verdict": "correct"}
