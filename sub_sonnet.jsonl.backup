{"id": "q_b0ff97ca1db9", "type": "number", "answer": 771, "_code": "a=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all]).drop_duplicates().reset_index(drop=True)\na['d']=parse_date(a['Ngày'])\nbad=a.groupby('Mã đơn hàng')['Trạng thái'].apply(lambda s:s.str.contains('hủy|huỷ|cancel|trả',case=False,na=False).any())\na=a[~a['Mã đơn hàng'].map(bad)]\na=a[(a.d>='2025-12-08')&(a.d<='2025-12-11')&(a['Đơn vị tính']=='ly')]\nRESULT=int(to_num(a['Số lượng quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3aae102f4eb2", "type": "list", "answer": [4, 15], "_code": "d=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd['n']=d['Tên sản phẩm'].map(normalize_text)\nqd=DanhSachQuyDoi.copy(); qd['n']=qd['Tên sản phẩm'].map(normalize_text)\nf={(r.n,str(r['Đơn vị quy đổi']).strip().lower()):float(to_num(pd.Series([r['Tỉ lệ quy đổi']])).iloc[0]) for _,r in qd.iterrows()}\nd['q']=to_num(d['Số lượng sản phẩm'])*[f.get((n,str(u).strip().lower()),1.0) for n,u in zip(d.n,d['Đơn vị tính'])]\nok=~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False,na=False)\nsku='SP0009'; fac=24\nimp=DonNhapHang_ChiTiet[DonNhapHang_ChiTiet['Mã SKU']==sku].merge(DonNhapHang,on='Mã đơn nhập')\nimp=imp[parse_date(imp['Ngày nhập'])<='2026-07-17']\nlots=set(imp['Mã lô'])\nlo=pd.concat([DonHang_Lo_1,DonHang_Lo_2]).drop_duplicates()\nlo=lo[lo['Mã lô'].isin(lots)]\nod=d.drop_duplicates('Mã đơn hàng').set_index('Mã đơn hàng')\ncanc=od['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel',case=False,na=False)\nlo=lo[~lo['Mã đơn hàng'].map(canc).fillna(False)&(lo['Mã đơn hàng'].map(od.dt)<='2026-07-17')]\nstock=int(to_num(imp['Số lượng nhập']).sum()-to_num(lo['Số lượng']).sum()+to_num(lo['Số lượng trả']).sum())\nRESULT=[stock//fac,stock%fac]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_30d82008e621", "type": "list", "answer": [623734, 415234, 339868], "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\nh=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh['dt']=pd.to_datetime(h['Giờ tạo đơn']).dt.normalize()\nX=pd.Timestamp('2026-01-17')\nh=h[(h.dt<=X)&(h['Trạng thái']!='Không giao được')&~h['Phương thức TT'].str.contains('COD')]\np=BanHang_PhieuThu.copy(); p['dt']=pd.to_datetime(p['Thời gian thu']).dt.normalize(); p=p[p.dt<=X]; p['v']=mser(p['Số tiền thu'])\nh['tot']=mser(h['Tong tien']); h['owe']=h['Order ID'].map(p.groupby('Mã bill').v.sum()).fillna(0)\nh['owe']=h.tot-h.owe; h=h[h.owe>0]; age=(X-h.dt).dt.days\nRESULT=[int(round(h.owe[(age>=0)&(age<=7)].sum())),int(round(h.owe[(age>=8)&(age<=15)].sum())),int(round(h.owe[age>15].sum()))]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c956ab727960", "type": "percent", "answer": 1.33, "_code": "d=DonHang_ChiTiet_1__all[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']].drop_duplicates().drop_duplicates('Mã đơn hàng')\nd['d']=parse_date(d['Ngày đặt hàng'])\nd=d[(d.d>='2026-01-01')&(d.d<='2026-01-31')]\nc=d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel',case=False,na=False).sum()\nRESULT=f\"{round(c/len(d)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_eff13b7a16ef", "type": "date", "answer": "2025-03-28", "_code": "import re\ndef money(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    m=re.match(r'^([\\d.,]+)\\s*tr\\s*(\\d*)$',s)\n    if m:\n        a=float(m.group(1).replace(',','.')) if m.group(2)=='' else float(m.group(1))+0\n        if m.group(2)!='': return a*1e6+float(m.group(2).ljust(3,'0'))*1e3\n        return a*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^\\d{1,3}([.,]\\d{3})+$',s): return float(re.sub(r'[.,]','',s))\n    if re.match(r'^[\\d,]+\\.\\d+$',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.match(r'^[\\d.,]+$',s) else 0.0\nd=SoBanHang.copy(); d=d[d['Ngày tháng'].notna()]\nd['dt']=parse_date(d['Ngày tháng']); d['a']=d['Thành tiền (đ)'].map(money)\nd=d[~d['Trạng thái đơn'].str.contains('hủy|huỷ|trả|Không giao',case=False,na=False)]\nx=d[(d.dt>='2025-03-01')&(d.dt<='2025-03-31')]\nRESULT=x.groupby('dt').a.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_29f3255d8636", "type": "date", "answer": "2025-11", "_code": "df=data['So_chi_tiet_ban_hang__all'].drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày'])\nbad=df[df['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)]['Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf=df[(df.d>='2025-10-01')&(df.d<='2025-12-31')]\ndf['tt']=to_num(df['Thành tiền'])\ng=df.groupby(df.d.dt.strftime('%Y-%m')).tt.sum()\nRESULT=g.idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_36d4c28e5079", "type": "percent", "answer": 2.57, "_code": "d=DonHang_ChiTiet.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[oc]=d[oc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nbad=d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False,na=False)\nbadids=set(d[bad]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(badids)]\nd['v']=to_num(d['Tổng tiền'])\na=d[(d.dt>='2026-01-01')&(d.dt<='2026-01-31')].v.sum()\nb=d[(d.dt>='2025-12-01')&(d.dt<='2025-12-31')].v.sum()\nRESULT=f\"{(a/b-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "wrong"}
{"id": "q_2f3f5b43bb5d", "type": "percent", "answer": 3.05, "_code": "o=don_hang.drop_duplicates().copy()\no['dt']=pd.to_datetime(o['ThoiGianLap']).dt.normalize()\no=o[o.TinhTrang.isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().copy()\nc['t']=to_num(c['TriGia'])\nc=c.merge(o[['MaHoaDon','dt']],on='MaHoaDon')\nc=c[(c.dt>='2026-06-01')&(c.dt<='2026-06-28')]\nrx=set(thong_tin_thuoc[thong_tin_thuoc.BanTheoDon.astype(str)=='1'].MaHangHoa)\nRESULT=f\"{round(c[c.MaHangHoa.isin(rx)].t.sum()/c.t.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_36d4c28e5079", "type": "percent", "answer": 0.14, "_code": "d=DonHang_ChiTiet.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd=d[d['Mã đơn hàng'].notna()].copy()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nbad=d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False,na=False)\nbadids=set(d[bad]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(badids)]\nd['v']=to_num(d['Tổng tiền'])\na=d[(d.dt>='2026-01-01')&(d.dt<='2026-01-31')].v.sum()\nb=d[(d.dt>='2025-12-01')&(d.dt<='2025-12-31')].v.sum()\nRESULT=f\"{(a/b-1)*100:.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_a6c7de39ae5e", "type": "percent", "answer": 1.25, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\nd=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False)]\nd['a']=mser(d['Thành tiền'])\nr=lambda y: d[(d.dt.dt.year==y)&(d.dt.dt.month==5)].a.sum()\nRESULT=f\"{(r(2026)-r(2025))/r(2025)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
