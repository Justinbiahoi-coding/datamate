{"id": "q_94bfa97928af", "type": "date", "answer": "2025-10-03", "_code": "df = So_chi_tiet_ban_hang__all.copy()\ndf['d'] = parse_date(df['Ngày'])\nbad = df['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả', case=False, na=False)\ndf = df[~df['Mã đơn hàng'].isin(set(df.loc[bad,'Mã đơn hàng']))]\ndf = df[(df['d']>='2025-10-01')&(df['d']<='2025-10-31')]\ndf['t'] = to_num(df['Thành tiền'])\ng = df.groupby('d')['t'].sum().sort_values(ascending=False)\nRESULT = g.index[0].strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_19ca0034af55", "type": "number", "answer": 125, "_code": "d = don_hang.copy(); d['d'] = parse_date(d['NgayBan'])\nd = d[(d['d'] == as_of_date) & ~d['Xử lý'].isin(['cancelled', 'returned'])]\nRESULT = int(d['Mã chứng từ'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ecdbd349e0b2", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Ông Quang Hoàng", 145500], ["Tô Quân Bình", 125500], ["Từ Hải Thanh", 123000]]}, "_code": "d = don_hang.copy(); d['d'] = parse_date(d['NgayBan'])\nd = d[(d['d'] <= as_of_date) & (d['Xử lý'] != 'cancelled') & (d['Phương thức TT'] != 'cod') & d['Số KH'].notna()]\nt = thanh_toan.copy(); t['t'] = parse_date(t['Thời gian thu']); t = t[t['t'] < pd.Timestamp(as_of_date) + pd.Timedelta(days=1)]\npaid = t.groupby('Số HĐ')['Tiền'].apply(lambda s: to_num(s).sum())\nd['debt'] = to_num(d['Tổng bill']) - d['Mã chứng từ'].map(paid).fillna(0)\nd = d[d['debt'] > 0]\ng = d.groupby('Số KH')['debt'].sum().sort_values(ascending=False).head(3)\nnm = khach_hang.set_index('ma_kh')['Khách lẻ/sỉ'].str.replace(r'\\s*\\d{8,}$', '', regex=True).str.strip()\nRESULT = {\"columns\": [\"khach_hang\", \"so_tien_no\"], \"rows\": [[nm[k], int(v)] for k, v in g.items()]}\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9b1dce77c710", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Tạ Dương Đức", 109000], ["Thân Anh Cường", 99500], ["Từ Khoa Sơn", 97500]]}, "_code": "def mny(s): return pd.to_numeric(s.astype(str).str.replace(r'[^\\d\\-]','',regex=True),errors='coerce')\nh = DanhSachHoaDon.copy()\nh['d'] = parse_date(h['Thời gian'])\nh['tot'] = mny(h['Tổng sau giảm giá'])\nh['th'] = mny(h['Tổng tiền hàng'])\nh['canc'] = h['Trạng thái'].isin(['hủy đơn','Đã hủy'])\nh['ret'] = h['Trạng thái'].isin(['Hoàn trả','trả lại'])\ndef debt_table(X, n=3):\n    pay = SoQuy.copy(); pay['t'] = parse_date(pay['Thời gian']); pay['v']=mny(pay['Giá trị'])\n    paid = pay[pay.t.dt.normalize()<=X].groupby('Mã hóa đơn').v.sum()\n    x = h[(~h.canc)&(h['Phương thức thanh toán']!='Thu hộ (COD)')&(h.d<=X)&h['Mã KH'].notna()].copy()\n    x['rest'] = x.tot - x['Mã hóa đơn'].map(paid).fillna(0)\n    x = x[x.rest>0]\n    g = x.groupby('Mã KH').agg(rest=('rest','sum'), nm=('Khách hàng','first')).sort_values('rest',ascending=False).head(n)\n    return {\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[r.nm,int(r.rest)] for r in g.itertuples()]}\nRESULT = debt_table(pd.Timestamp('2026-06-30'))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3a2bccc332db", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Ngô Thảo Châu", 149500], ["Mai Trang Dũng", 122001], ["Lưu Hà An", 90000]]}, "_code": "def mny(s): return pd.to_numeric(s.astype(str).str.replace(r'[^\\d\\-]','',regex=True),errors='coerce')\nh = DanhSachHoaDon.copy()\nh['d'] = parse_date(h['Thời gian'])\nh['tot'] = mny(h['Tổng sau giảm giá'])\nh['th'] = mny(h['Tổng tiền hàng'])\nh['canc'] = h['Trạng thái'].isin(['hủy đơn','Đã hủy'])\nh['ret'] = h['Trạng thái'].isin(['Hoàn trả','trả lại'])\ndef debt_table(X, n=3):\n    pay = SoQuy.copy(); pay['t'] = parse_date(pay['Thời gian']); pay['v']=mny(pay['Giá trị'])\n    paid = pay[pay.t.dt.normalize()<=X].groupby('Mã hóa đơn').v.sum()\n    x = h[(~h.canc)&(h['Phương thức thanh toán']!='Thu hộ (COD)')&(h.d<=X)&h['Mã KH'].notna()].copy()\n    x['rest'] = x.tot - x['Mã hóa đơn'].map(paid).fillna(0)\n    x = x[x.rest>0]\n    names = DanhSachKhachHang.set_index('Mã khách hàng')['Tên khách hàng']\n    g = x.groupby('Mã KH').agg(rest=('rest','sum'))\n    g['nm'] = g.index.map(names)\n    g = g.sort_values('rest',ascending=False).head(n)\n    return {\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[r.nm,int(r.rest)] for r in g.itertuples()]}\nRESULT = debt_table(pd.Timestamp('2025-10-29'))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c61f2d15de92", "type": "number", "answer": 3030000, "_code": "def money(s):\n    s = str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    if s.endswith('tr'): return float(s[:-2].replace(',','.'))*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    return float(s.replace('.','').replace(',',''))\ndf = pd.concat([DonHang_ChiTiet_1__all, DonHang_ChiTiet_2026__all], ignore_index=True)\nhc = ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc] = df[hc].ffill()\ndf['d'] = parse_date(df['Ngày đặt hàng'])\nbad = df['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|cancel|hoàn hàng|trả', case=False, na=False)\ndf = df[~df['Mã đơn hàng'].isin(set(df.loc[bad,'Mã đơn hàng']))]\ndf = df[(df['d']>='2026-03-01')&(df['d']<='2026-03-31')]\ndf = df[df['Tên sản phẩm'].str.lower().str.replace(r'\\s+',' ',regex=True).str.strip()=='gaviscon hộp 24 gói x 10ml']\nRESULT = int(round(df[\"Tổng tiền\"].map(money).sum()))\n", "_attempts": 3, "_verdict": "correct"}
{"id": "q_a569fbc6b9fc", "type": "boolean", "answer": false, "_code": "def mny(s): return pd.to_numeric(s.astype(str).str.replace(r'[^\\d\\-]','',regex=True),errors='coerce')\nh = DanhSachHoaDon.copy()\nh['d'] = parse_date(h['Thời gian'])\nh['tot'] = mny(h['Tổng sau giảm giá'])\nh['th'] = mny(h['Tổng tiền hàng'])\nh['canc'] = h['Trạng thái'].isin(['hủy đơn','Đã hủy'])\nh['ret'] = h['Trạng thái'].isin(['Hoàn trả','trả lại'])\ndef debt_table(X, n=3):\n    pay = SoQuy.copy(); pay['t'] = parse_date(pay['Thời gian']); pay['v']=mny(pay['Giá trị'])\n    paid = pay[pay.t.dt.normalize()<=X].groupby('Mã hóa đơn').v.sum()\n    x = h[(~h.canc)&(h['Phương thức thanh toán']!='Thu hộ (COD)')&(h.d<=X)&h['Mã KH'].notna()].copy()\n    x['rest'] = x.tot - x['Mã hóa đơn'].map(paid).fillna(0)\n    x = x[x.rest>0]\n    names = DanhSachKhachHang.set_index('Mã khách hàng')['Tên khách hàng']\n    g = x.groupby('Mã KH').agg(rest=('rest','sum'))\n    g['nm'] = g.index.map(names)\n    g = g.sort_values('rest',ascending=False).head(n)\n    return {\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[r.nm,int(r.rest)] for r in g.itertuples()]}\nL = pd.concat([DanhSachHoaDonChiTiet_1, DanhSachHoaDonChiTiet_2])\nL['a'] = mny(L['Thành tiền'])\nok = h[~h.canc & ~h.ret].drop_duplicates('Mã hóa đơn').set_index('Mã hóa đơn')['d']\nL['d'] = L['Mã hóa đơn'].map(ok)\nL = L[L.d.notna()]\nm = L.groupby(L.d.dt.to_period('M')).a.sum()\na,b,c = [m[pd.Period(x)] for x in ['2026-04','2026-05','2026-06']]\nRESULT = bool(a<b<c)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ebf285497536", "type": "unanswerable", "answer": "unanswerable", "_code": "df = pd.concat([So_chi_tiet_ban_hang_1__all, So_chi_tiet_ban_hang_2026__all], ignore_index=True)\ndf['d'] = parse_date(df['Ngày'])\nif df['d'].min() > pd.Timestamp('2025-03-01'):\n    RESULT = 'unanswerable'  # data starts after the requested month\nelse:\n    m = df['d'].between('2025-03-01','2025-03-31') & (df['Tên hàng hóa']=='Trà vải (L)') & ~df['Trạng thái'].str.contains('hủy|cancel|trả', case=False, na=False)\n    RESULT = float(to_num(df[m]['Thành tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c42078e25d28", "type": "unanswerable", "answer": "unanswerable", "_code": "# No inventory/stock table exists for this business (only sales, delivery, debt-term, catalog)\nhas_stock = any(('tồn' in k.lower() or 'ton' in k.lower()) for k in data)\nRESULT = 'unanswerable' if not has_stock else 0\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_910640a29988", "type": "unanswerable", "answer": "unanswerable", "_code": "# No expiry-date (hạn dùng / HSD) column anywhere in the business data\ncols = [c.lower() for k, v in data.items() if hasattr(v, 'columns') for c in map(str, v.columns)]\nhas_exp = any(('hạn dùng' in c or 'hsd' in c or 'expiry' in c or 'exp' == c) for c in cols)\nRESULT = 'unanswerable' if not has_exp else 0\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0f6f50127e77", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Lâm Bảo Ngọc", 632000], ["Nghiêm Duy Linh", 620000], ["Lương Huy Quang", 360500]]}, "_code": "def mny(s): return pd.to_numeric(s.astype(str).str.replace(r'[^\\d\\-]','',regex=True),errors='coerce')\nX = pd.Timestamp(as_of_date)\nh = don_hang.copy()\nh['d'] = parse_date(h['Ngày']); h['tot'] = mny(h['Tổng đơn'])\npay = thanh_toan.copy(); pay['t']=parse_date(pay['Ngày thu']).dt.normalize(); pay['v']=mny(pay['Giá trị'])\npaid = pay[pay.t<=X].groupby('Số CT').v.sum()\nx = h[(h['Tình trạng']!='cancelled')&(h['Trả bằng']!='cod')&(h.d<=X)&h['Customer ID'].notna()].copy()\nx['rest'] = x.tot - x['Mã chứng từ'].map(paid).fillna(0)\nx = x[x.rest>0]\nnames = khach_hang.set_index('Mã KH')['Khách hàng (tên)']\ng = x.groupby('Customer ID').rest.sum().sort_values(ascending=False).head(3)\nRESULT = {\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[names.get(k,k),int(v)] for k,v in g.items()]}\n", "_attempts": 1, "_verdict": "correct"}
