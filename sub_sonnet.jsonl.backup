{"id": "q_4229b5a0f8b2", "type": "list", "answer": [11000, 5500], "_code": "h=DuLieuBanHang__DanhSachHoaDon.copy(); p=DuLieuBanHang__SoQuy.copy()\nh['d']=parse_date(h['Thời gian']).dt.normalize(); h['tt']=to_num(h['Tổng sau giảm giá'])\nh=h[(h['Phương thức thanh toán']=='Ghi nợ')&~h['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)&(h['Mã KH']=='KH0065')]\np['d']=parse_date(p['Thời gian']).dt.normalize(); p['a']=to_num(p['Giá trị'])\np=p.merge(h[['Mã hóa đơn','d']].rename(columns={'d':'od'}),on='Mã hóa đơn')\ns,e='2026-06-01','2026-06-30'\nsame=p[p.d==p.od].groupby('Mã hóa đơn').a.sum()\nhi=h[(h.d>=s)&(h.d<=e)]\nno=(hi.set_index('Mã hóa đơn').tt-same.reindex(hi['Mã hóa đơn']).fillna(0)).sum()\ntra=p[(p.d>p.od)&(p.d>=s)&(p.d<=e)].a.sum()\nRESULT=[int(no),int(tra)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c00dc4e2a578", "type": "number", "answer": 3, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\n\nd=DonHang_ChiTiet__all.reset_index(drop=True)\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd['dt']=pdate(d['Ngày đặt hàng'])\nd['n']=d['Tên sản phẩm'].astype(str).str.strip().str.lower().str.replace(r'\\s+',' ',regex=True)\nbad=set(d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả',case=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bad)]\nbefore=set(d[d.dt<'2025-07-21'].n)\ninp=set(d[(d.dt>='2025-07-21')&(d.dt<='2025-07-27')].n)\nRESULT=len(before-inp)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5d6037d9c194", "type": "list", "answer": [269031700, 398881600, 384850400], "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\nd['dt']=parse_date(d['Ngày giao dịch']); d['t']=mon(d['Trị giá']); d['q']=pd.to_numeric(d['so_luong'],errors='coerce')\nd['gio']=pd.to_datetime(d['Giờ'])\nbadst=d['Status'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nbad=set(d[badst|(d.q<0)]['Mã hóa đơn'])\nd=d[~d['Mã hóa đơn'].isin(bad)].copy()\n# order-level: date + hour\no=d.groupby('Mã hóa đơn').agg(dt=('dt','min'),gio=('gio','min'),rev=('t','sum')).reset_index()\no['ca']=o.gio.dt.hour.map(lambda h:'sang' if 6<=h<=13 else ('chieu' if 14<=h<=21 else 'khac'))\nRESULT=[int(o[(o.dt>=a)&(o.dt<=b)].rev.sum()) for a,b in [('2026-02-01','2026-02-28'),('2026-03-01','2026-03-31'),('2026-04-01','2026-04-30')]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_cd79235ce4e8", "type": "percent", "answer": -20.72, "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\nd['dt']=parse_date(d['Ngày giao dịch']); d['t']=mon(d['Trị giá']); d['q']=pd.to_numeric(d['so_luong'],errors='coerce')\nd['gio']=pd.to_datetime(d['Giờ'])\nbadst=d['Status'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nbad=set(d[badst|(d.q<0)]['Mã hóa đơn'])\nd=d[~d['Mã hóa đơn'].isin(bad)].copy()\n# order-level: date + hour\no=d.groupby('Mã hóa đơn').agg(dt=('dt','min'),gio=('gio','min'),rev=('t','sum')).reset_index()\no['ca']=o.gio.dt.hour.map(lambda h:'sang' if 6<=h<=13 else ('chieu' if 14<=h<=21 else 'khac'))\nm=o[(o.dt>='2025-12-01')&(o.dt<='2025-12-31')]\nc=m.ca.value_counts()\nRESULT=f\"{round((c['chieu']-c['sang'])/c['sang']*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8f4a89a3b3fe", "type": "list", "answer": [118148600, 13977600], "_code": "h=DuLieuBanHang__DanhSachHoaDon.copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[h['Trạng thái'].isin(['đã lấy','Hoàn thành','Đang xử lý'])&(h.d>='2026-07-01')&(h.d<='2026-07-31')]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['a']=to_num(c['Thành tiền'])\nt=c.groupby('Mã hóa đơn').a.sum()\nh['tt']=h['Mã hóa đơn'].map(t).fillna(0)\ns=h.groupby('Phương thức thanh toán').tt.sum()\nRESULT=[int(s['Tiền mặt']),int(s['Thu hộ (COD)'])]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_338ae382671b", "type": "percent", "answer": -16.41, "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\nd['dt']=parse_date(d['Ngày giao dịch']); d['t']=mon(d['Trị giá']); d['q']=pd.to_numeric(d['so_luong'],errors='coerce')\nd['gio']=pd.to_datetime(d['Giờ'])\nbadst=d['Status'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nbad=set(d[badst|(d.q<0)]['Mã hóa đơn'])\nd=d[~d['Mã hóa đơn'].isin(bad)].copy()\n# order-level: date + hour\no=d.groupby('Mã hóa đơn').agg(dt=('dt','min'),gio=('gio','min'),rev=('t','sum')).reset_index()\no['ca']=o.gio.dt.hour.map(lambda h:'sang' if 6<=h<=13 else ('chieu' if 14<=h<=21 else 'khac'))\nm=o[(o.dt>='2026-03-02')&(o.dt<='2026-03-08')]\nc=m.groupby('ca').rev.sum()\nRESULT=f\"{round((c['chieu']-c['sang'])/c['sang']*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_67a9df40be70", "type": "list", "answer": ["Mì Hảo Hảo tôm chua cay", "Snack Oishi tôm cay 40g", "Trứng gà so", "Sữa tươi Vinamilk 180ml", "Coca Cola 330ml"], "_code": "df=data['DonHang_ChiTiet__all'].copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False,na=False)]\ndf=df[(df.d>='2025-02-01')&(df.d<='2025-02-28')]\nqd=DanhSachQuyDoi.copy(); qd['r']=to_num(qd['Tỉ lệ quy đổi'])\nmp={(normalize_text(a),normalize_text(b)):r for a,b,r in zip(qd['Tên sản phẩm'],qd['Đơn vị quy đổi'],qd['r'])}\ndf['q']=pd.to_numeric(df['Số lượng sản phẩm'].astype(str).str.extract(r'^\\s*(-?[\\d.]+)')[0])\ndf['f']=[mp.get((normalize_text(a),normalize_text(b)),1) for a,b in zip(df['Tên sản phẩm'],df['Đơn vị tính'])]\ndf['qb']=df.q*df.f\ng=df.groupby('Tên sản phẩm').qb.sum().sort_values(ascending=False)\nRESULT=list(g.index[:5])\n", "_attempts": 3, "_verdict": "correct"}
{"id": "q_ece3c46e24d3", "type": "percent", "answer": 2.83, "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\nd['dt']=parse_date(d['Ngày giao dịch']); d['t']=mon(d['Trị giá']); d['q']=pd.to_numeric(d['so_luong'],errors='coerce')\nd['gio']=pd.to_datetime(d['Giờ'])\nbadst=d['Status'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nbad=set(d[badst|(d.q<0)]['Mã hóa đơn'])\nd=d[~d['Mã hóa đơn'].isin(bad)].copy()\n# order-level: date + hour\no=d.groupby('Mã hóa đơn').agg(dt=('dt','min'),gio=('gio','min'),rev=('t','sum')).reset_index()\no['ca']=o.gio.dt.hour.map(lambda h:'sang' if 6<=h<=13 else ('chieu' if 14<=h<=21 else 'khac'))\na=o[(o.dt>='2026-05-01')&(o.dt<='2026-05-29')].rev.sum(); b=o[(o.dt>='2026-04-01')&(o.dt<='2026-04-29')].rev.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6b5bc4607001", "type": "number", "answer": 366002000, "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    sg=-1 if s.startswith('-') else 1\n    s=s.lstrip('-').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return sg*(int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0))\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)\\s*k',s)\n    if m: return sg*float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return sg*float(s)\n    except: return float('nan')\n\nimport unicodedata as _u\n_k={_u.normalize('NFC',k):k for k in data}\na=data['So_chi_tiet_ban_hang__all'].drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y',errors='coerce')\na['t']=a['Thành tiền'].map(money)\n\nhd=data[_k['Danh sách hàng hóa']]\nbad=set(a[a['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]['Mã đơn hàng'])\nv=a[~a['Mã đơn hàng'].isin(bad)&(a.dt>='2025-05-01')&(a.dt<='2025-05-31')].copy()\ngrp=dict(zip(hd['Tên hàng hóa'].str.strip().str.lower(),hd['Nhóm hàng hóa']))\nv['g']=v['Tên hàng hóa'].str.strip().str.lower().map(grp)\nRESULT=int(v[v.g.str.lower().str.strip()=='điện'].t.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b9a27b8f42d1", "type": "percent", "answer": 1.79, "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    sg=-1 if s.startswith('-') else 1\n    s=s.lstrip('-').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr(?:(\\d+))?',s)\n    if m: return sg*(int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0))\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)\\s*k',s)\n    if m: return sg*float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): s=s.replace('.','')\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): s=s.replace(',','')\n    try: return sg*float(s)\n    except: return float('nan')\n\nimport unicodedata as _u\n_k={_u.normalize('NFC',k):k for k in data}\na=data['So_chi_tiet_ban_hang__all'].drop_duplicates().copy()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y',errors='coerce')\na['t']=a['Thành tiền'].map(money)\n\nm=a[(a.dt>='2026-04-01')&(a.dt<='2026-04-30')].drop_duplicates('Mã đơn hàng')\nRESULT=f\"{m['Trạng thái'].str.contains('hủy|huỷ|Không giao được',case=False,na=False).sum()/len(m)*100:.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_eee4a64d6b3c", "type": "number", "answer": 129527900, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy(); h['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['a']=mser(c['Thành tiền'])\nrev=lambda y,m: c[c['Mã hóa đơn'].isin(h[(h.dt.dt.year==y)&(h.dt.dt.month==m)]['Mã hóa đơn'])].a.sum()\nRESULT=int(round(rev(2025,2)))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_35f07818e5ae", "type": "list", "answer": ["Mai Hoa Nhung", "Tạ Thảo Tâm", "Ông Hằng Bảo"], "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy(); h['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)&(h.dt.dt.year==2025)&(h.dt.dt.month==9)&h['Mã KH'].notna()]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['a']=mser(c['Thành tiền'])\ns=c.merge(h[['Mã hóa đơn','Mã KH']],on='Mã hóa đơn').groupby('Mã KH').a.sum().sort_values(ascending=False,kind='stable')\nnm=DanhSachKhachHang.set_index('Mã khách hàng')['Tên khách hàng']\nRESULT=[nm[k] for k in s.index[:3]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_55ea8ba11491", "type": "percent", "answer": -11.87, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy(); h['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['a']=mser(c['Thành tiền'])\nrev=lambda y,m: c[c['Mã hóa đơn'].isin(h[(h.dt.dt.year==y)&(h.dt.dt.month==m)]['Mã hóa đơn'])].a.sum()\na,b_=rev(2026,3),rev(2025,3)\nRESULT=f\"{(a-b_)/b_*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_051bb0f610e4", "type": "list", "answer": [52063500, 432338000], "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan','none'): return float('nan')\n    m=re.match(r'^(\\d+)\\s*tr\\s*(\\d*)$',s.replace(',','.')) if 'tr' in s else None\n    if m:\n        frac=m.group(2); return int(m.group(1))*1e6+(int(frac.ljust(3,'0')[:3])*1000 if frac else 0)\n    m=re.match(r'^(\\d+(?:[.,]\\d+)?)\\s*k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    try: return float(s)\n    except: return float('nan')\no=don_hang.drop_duplicates('Mã chứng từ').copy()\no['dt']=parse_date(o['Ngày'])\no=o[(o.dt>='2026-07-01')&(o.dt<='2026-07-28')&o['Tình trạng'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().copy()\nc['a']=c['Amount'].map(money)\nc=c.merge(o[['Mã chứng từ','Trả bằng']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\ns=c.groupby('Trả bằng').a.sum()\nRESULT=[int(round(s.get('cod',0))),int(round(s.get('cash',0)))]\n\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_a32b374fb3e9", "type": "list", "answer": ["Cà phê sữa (M)", "Cà phê đen (M)", "Trà đào cam sả (M)"], "_code": "df=DonHang_ChiTiet.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False,na=False)]\ndf=df[(df.d>='2026-03-01')&(df.d<='2026-03-31')]\nqd=DanhSachQuyDoi.copy(); qd['r']=to_num(qd['Tỉ lệ quy đổi'])\nmp={(normalize_text(a),normalize_text(b)):r for a,b,r in zip(qd['Tên sản phẩm'],qd['Đơn vị quy đổi'],qd['r'])}\ndf['q']=pd.to_numeric(df['Số lượng sản phẩm'].astype(str).str.extract(r'^\\s*(-?[\\d.]+)')[0])\ndf['f']=[mp.get((normalize_text(a),normalize_text(b)),1) for a,b in zip(df['Tên sản phẩm'],df['Đơn vị tính'])]\ndf['qb']=df.q*df.f\ng=df.groupby('Tên sản phẩm').qb.sum().sort_values(ascending=False)\nRESULT=list(g.index[:3])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c131e600dc25", "type": "percent", "answer": 0.96, "_code": "h=DanhSachHoaDon__all.copy(); c=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nh['dt']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nt=c.assign(a=to_num(c['Thành tiền'])).groupby('Mã hóa đơn').a.sum()\nh['r']=h['Mã hóa đơn'].map(t).fillna(0)\ndef r(a,b): return h[(h.dt>=a)&(h.dt<=b)].r.sum()\nx=r('2026-04-01','2026-04-30'); y=r('2026-03-01','2026-03-31')\nRESULT=f\"{round((x-y)/y*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1885ab61433f", "type": "number", "answer": 89, "_code": "h=DanhSachHoaDon.copy()\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates()\nh['dt']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh=h[(h.dt>='2025-08-01')&(h.dt<='2025-08-31')]\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])&(c['Tên hàng'].str.strip().str.lower()=='bánh tiramisu')]\nRESULT=int(to_num(c['Số lượng quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c25d64a3f324", "type": "number", "answer": 1243459, "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày']); d['t']=mon(d['Thành tiền'])\nbad=set(d[d['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bad)]\nm=d[(d.dt>='2025-07-14')&(d.dt<='2025-07-20')]\nimport decimal\nRESULT=int(decimal.Decimal(str(m.t.sum()/m['Mã đơn hàng'].nunique())).quantize(decimal.Decimal('1'),rounding=decimal.ROUND_HALF_UP))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_446a146d3418", "type": "number", "answer": 5, "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày']); d['t']=mon(d['Thành tiền'])\nbad=set(d[d['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bad)]\nm=d[(d.dt>='2025-02-01')&(d.dt<='2025-02-28')]\nc=m.groupby('Tên hàng hóa')['Mã đơn hàng'].nunique()\nRESULT=int((c>=61).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0a8ec3050fe7", "type": "percent", "answer": -53.52, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\n\nH=DuLieuBanHang['DanhSachHoaDon'].drop_duplicates('Mã hóa đơn').copy()\nH['dt']=pdate(H['Thời gian'])\nH=H[~H['Trạng thái'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hàng']=='SP0059']\nc=c.merge(H[['Mã hóa đơn','dt']],on='Mã hóa đơn')\nc['q']=pd.to_numeric(c['Số lượng quy đổi'],errors='coerce')\nD=pd.Timestamp('2026-06-02')\na=c[(c.dt>=D)&(c.dt<=D+pd.Timedelta(days=29))].q.sum()\nb=c[(c.dt>=D-pd.Timedelta(days=30))&(c.dt<D)].q.sum()\nprint(a,b)\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_abf4f8e63233", "type": "number", "answer": 31715542, "_code": "h=DuLieuBanHang__DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['od']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh=h[(h['Phương thức thanh toán']=='Ghi nợ')&~h['Trạng thái'].str.contains('hủy|huỷ|cancel',case=False,na=False)]\ns=DuLieuBanHang__SoQuy.copy()\ns['pd']=pd.to_datetime(s['Thời gian']).dt.normalize()\ns=s.merge(h[['Mã hóa đơn','od']],on='Mã hóa đơn')\ns=s[(s.pd>s.od)&(s.pd>='2026-01-01')&(s.pd<='2026-01-31')]\nRESULT=int(to_num(s['Giá trị']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6af819abfb1d", "type": "percent", "answer": 2.94, "_code": "d=DonHang_ChiTiet__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd['dt']=parse_date(d['Ngày đặt hàng'])\no=d[(d.dt.dt.year==2025)&(d.dt.dt.month==10)].drop_duplicates('Mã đơn hàng')\nc=o['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False).sum()\nRESULT=f\"{c/len(o)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9efed5e37825", "type": "list", "answer": ["Mì Hảo Hảo tôm chua cay", "Trứng gà so", "Mì Omachi sườn hầm", "Nước suối Aquafina 500ml", "Snack Oishi tôm cay 40g"], "_code": "d=DonHang_ChiTiet__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill(); d=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[(d.dt>='2025-05-01')&(d.dt<='2025-05-31')&~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|hoàn hàng',case=False)]\nd['q']=pd.to_numeric(d['Số lượng sản phẩm'].astype(str).str.extract(r'([\\d.]+)')[0])\nf={(r['Tên sản phẩm'],r['Đơn vị quy đổi']):float(r['Tỉ lệ quy đổi']) for _,r in DanhSachQuyDoi.iterrows()}\nd['b']=d.q*[f.get((n,u),1.0) for n,u in zip(d['Tên sản phẩm'],d['Đơn vị tính'])]\ns=d.groupby('Tên sản phẩm').b.sum().sort_values(ascending=False,kind='stable')\nRESULT=list(s.index[:5])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_acb07a87ed21", "type": "number", "answer": 42, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2]).drop_duplicates().reset_index(drop=True)\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt.dt.year==2025)&(d.dt.dt.month==2)].drop_duplicates('Mã đơn hàng')\nRESULT=int(d['Trạng thái'].str.contains('hủy|huỷ',case=False).sum())\n", "_attempts": 1, "_verdict": "correct"}
