{"id": "q_70d78d0a36ff", "type": "boolean", "answer": true, "_code": "def money(s):\n    s = str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    if s.endswith('tr'): return float(s[:-2].replace(',','.'))*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    return float(s.replace('.','').replace(',',''))\ndf = pd.concat([So_chi_tiet_ban_hang_1, So_chi_tiet_ban_hang_2], ignore_index=True)\ndf['d'] = parse_date(df['Ngày'])\nbad = df['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả', case=False, na=False)\ndf = df[~df['Mã đơn hàng'].isin(set(df.loc[bad,'Mã đơn hàng']))]\ndf['t'] = df['Thành tiền'].map(money)\nr = df.groupby(df['d'].dt.to_period('M').astype(str))['t'].sum()\nv = [r['2025-02'], r['2025-03'], r['2025-04']]\nRESULT = bool(v[0] < v[1] < v[2])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_dcf310850fd9", "type": "date", "answer": "2026-04-26", "_code": "def money(s):\n    s = str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    if s.endswith('tr'): return float(s[:-2].replace(',','.'))*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    return float(s.replace('.','').replace(',',''))\ndf = pd.concat([SoBanHang_1__all, SoBanHang_2026__all], ignore_index=True)\ndf['d'] = parse_date(df['Ngày giao dịch'])\ndf['q'] = df['so_luong'].map(money)\nbad = df['Status'].astype(str).str.contains('hủy|huỷ|cancel|trả|đổi', case=False, na=False) | (df['q']<0)\ndf = df[~df['Mã hóa đơn'].isin(set(df.loc[bad,'Mã hóa đơn']))]\ndf = df[(df['d']>='2026-04-01')&(df['d']<='2026-04-30')]\ndf['t'] = df['Trị giá'].map(money)\ng = df.groupby('d')['t'].sum().sort_values(ascending=False)\nRESULT = g.index[0].strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
