{"id": "q_7232903d4ca7", "type": "date", "answer": "2025-04-26", "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    s=s.replace('.','').replace(',','')\n    try: return float(s)\n    except: return 0.0\ndf=SoBanHang__all.drop_duplicates().copy()\ndf['d']=pd.to_datetime(df['Giờ'],errors='coerce'); df=df[df.d.notna()]\nst=df['Ghi chú TT'].str.lower()\nbad=df.loc[st.isin(['hủy','trả lại','đã trả hàng']),'Mã phiếu'].unique()\ndf=df[~df['Mã phiếu'].isin(bad)]\ndf['tt']=df['Tiền'].map(money)\nx=df[(df.d>='2025-04-01')&(df.d<'2025-05-01')]\nRESULT=x.groupby(x.d.dt.date)['tt'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9638b6ed00f0", "type": "number", "answer": 137, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    s=s.replace('.','').replace(',','')\n    try: return float(s)\n    except: return 0.0\ndf=SoBanHang__all.drop_duplicates().copy()\ndf['d']=pd.to_datetime(df['Giờ'],errors='coerce'); df=df[df.d.notna()]\nst=df['Ghi chú TT'].str.lower()\nbad=df.loc[st.isin(['hủy','trả lại','đã trả hàng']),'Mã phiếu'].unique()\ndf=df[~df['Mã phiếu'].isin(bad)]\ndf['tt']=df['Tiền'].map(money)\n# tuần rồi: as_of 2025-08-16 (Sat) -> Mon 2025-08-04..Sun 2025-08-10; ca sáng 6-13:59; đếm đơn\nx=df[(df.d>='2025-08-04')&(df.d<'2025-08-11')&(df.d.dt.hour>=6)&(df.d.dt.hour<14)]\nRESULT=x['Mã phiếu'].nunique()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_72df5c2143bd", "type": "number", "answer": 549, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    s=s.replace('.','').replace(',','')\n    try: return float(s)\n    except: return 0.0\ndf=SoBanHang__all.drop_duplicates().copy()\ndf['d']=pd.to_datetime(df['Giờ'],errors='coerce'); df=df[df.d.notna()]\nst=df['Ghi chú TT'].str.lower()\nbad=df.loc[st.isin(['hủy','trả lại','đã trả hàng']),'Mã phiếu'].unique()\ndf=df[~df['Mã phiếu'].isin(bad)]\ndf['tt']=df['Tiền'].map(money)\n# xe đã giao tổng cộng mấy đợt hàng tháng 2/2025 (SoGiaoHang), đếm (mã bill, lượt giao) ; ngày chở trong tháng\ng=SoGiaoHang.drop_duplicates().copy()\ng['d']=parse_date(g['Ngày chở'])\nx=g[(g.d>='2025-02-01')&(g.d<'2025-03-01')]\nRESULT=len(x[['Mã bill','Lượt giao']].drop_duplicates())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_348e083e71aa", "type": "number", "answer": 50712000, "_code": "o=data['don_hang'].copy(); c=data['chi_tiet_don']; k=data['khach_hang']\no['d']=parse_date(o['NgayBan'])\no=o[(o['Xử lý'].isin(['completed','shipping']))&(o.d>='2026-04-01')&(o.d<='2026-04-30')]\no=o.merge(k[['ma_kh','Nhóm']],left_on='Số KH',right_on='ma_kh')\no=o[o['Nhóm']=='thân thiết']\nc=c.drop_duplicates(); c=c[c['Ma don'].isin(o['Mã chứng từ'])]\nRESULT=int(to_num(c['T.Tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
