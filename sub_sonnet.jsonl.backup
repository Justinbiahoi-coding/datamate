{"id": "q_21c312790767", "type": "number", "answer": 71143, "_code": "import sys\nsp=DanhSachSanPham\nc=sp[sp['Tên hàng'].str.lower().str.contains('acemuc kids')]\nprint(c[['Mã hàng','Tên hàng','ĐVT']].to_string(),file=sys.stderr)\ncode=c[c['Tên hàng'].str.lower().str.contains('200mg')&c['Tên hàng'].str.lower().str.contains('30 gói')]['Mã hàng'].iloc[0]\nn=DanhSachNhapHang; print(n['Trạng thái'].unique(),file=sys.stderr)\nn=n[~n['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nd=parse_date(n['Thời gian']); n=n[(d>='2025-11-01')&(d<='2025-11-30')]\nl=DanhSachChiTietNhapHang; l=l[(l['Mã hàng']==code)&l['Mã nhập hàng'].isin(n['Mã nhập hàng'])].copy()\nprint(l.to_string(),file=sys.stderr)\nq=to_num(l['Số lượng']); p=to_num(l['Đơn giá'])\nRESULT=round(float((q*p).sum()/q.sum()))\n", "_attempts": 1, "_verdict": "correct"}
