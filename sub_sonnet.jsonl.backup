{"id": "q_7c2331330d42", "type": "percent", "answer": -31.65, "_code": "df=Bao_cao_ban_hang__So_chi_tiet_ban_hang.drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày']); df['t']=to_num(df['Thành tiền'])\nbad=set(df.loc[df['Trạng thái'].map(normalize_text).str.contains('huy|tra hang|khong giao'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\na=df[(df.d>='2026-02-01')&(df.d<='2026-02-28')].t.sum()\nb=df[(df.d>='2026-01-01')&(df.d<='2026-01-31')].t.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5ec3109a5561", "type": "date", "answer": "2025-07-28", "_code": "df=Bao_cao_ban_hang__So_chi_tiet_ban_hang.drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày']); df['t']=to_num(df['Thành tiền'])\nbad=set(df.loc[df['Trạng thái'].map(normalize_text).str.contains('huy|tra hang|khong giao'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\nx=df[(df.d>='2025-07-01')&(df.d<='2025-07-31')].groupby('d').t.sum()\nRESULT=x.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_74fbcfbacde6", "type": "list", "answer": [302000, 178000], "_code": "\nD=DuLieuBanHang\nh=D['DanhSachHoaDon'].copy(); sq=D['SoQuy'].copy()\nh['dt']=parse_date(h['Thời gian']).dt.normalize()\nh['tot']=to_num(h['Tổng sau giảm giá'])\nh=h.drop_duplicates('Mã hóa đơn')\nbad=h['Trạng thái'].str.contains('hủy|huỷ|Hủy|Huỷ',case=False,na=False)\nh=h[(h['Phương thức thanh toán']=='Ghi nợ')&~bad&(h['Mã KH']=='KH0083')]\nsq['dt']=parse_date(sq['Thời gian']).dt.normalize(); sq['v']=to_num(sq['Giá trị'])\nsq=sq[sq['Mã hóa đơn'].isin(h['Mã hóa đơn'])].merge(h[['Mã hóa đơn','dt']],on='Mã hóa đơn',suffixes=('','_o'))\nsame=sq[sq.dt==sq.dt_o].groupby('Mã hóa đơn')['v'].sum()\nhm=h[(h.dt>='2026-01-01')&(h.dt<='2026-01-31')]\nadd=(hm['tot']-hm['Mã hóa đơn'].map(same).fillna(0)).sum()\nlater=sq[(sq.dt>sq.dt_o)&(sq.dt>='2026-01-01')&(sq.dt<='2026-01-31')]['v'].sum()\nRESULT=[int(add),int(later)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_72ecafb4520a", "type": "date", "answer": "2025-11-03", "_code": "\nd=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].copy()\nd['dt']=parse_date(d['Ngày']); d['tt']=to_num(d['Thành tiền'])\nok=d[d['Trạng thái'].isin(['ok','Thành công','Đang vận chuyển'])]\nx=ok[(ok.dt>='2025-11-01')&(ok.dt<='2025-11-30')]\nRESULT=str(x.groupby(x.dt.dt.date)['tt'].sum().idxmax())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_11d72b8e4f6a", "type": "list", "answer": [139000, 46333], "_code": "o=don_hang.copy()\no['d']=pd.to_datetime(o.ThoiGianLap).dt.normalize()\no=o[(o.MaKhachHang=='KH0164')&(o.PhuongThucTT=='debt')&(o.TinhTrang!='cancelled')]\np=thanh_toan.merge(o[['MaHoaDon','d','TongThanhToan']],on='MaHoaDon')\np['pd_']=pd.to_datetime(p.NgayGioThu).dt.normalize()\np['SoTienThu']=to_num(p.SoTienThu)\nsame=p[p.pd_==p.d].groupby('MaHoaDon').SoTienThu.sum()\noj=o[(o.d>='2026-01-01')&(o.d<='2026-01-31')]\nadd=sum(to_num(pd.Series([r.TongThanhToan])).iloc[0]-same.get(r.MaHoaDon,0) for r in oj.itertuples())\npaid=p[(p.pd_>p.d)&(p.pd_>='2026-01-01')&(p.pd_<='2026-01-31')].SoTienThu.sum()\nRESULT=[int(round(add)),int(round(paid))]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fb0b5ef48e60", "type": "date", "answer": "2026-01-09", "_code": "h=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nst=h['Trạng thái'].map(normalize_text)\nh=h[~st.str.contains('huy|tra ve|doi tra')]\nh=h[(h.d>='2026-01-01')&(h.d<='2026-01-31')]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['t']=to_num(c['Thành tiền'])\nc=c.merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\nx=c.groupby('d').t.sum()\nRESULT=x.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_84ab3fa7ec41", "type": "percent", "answer": 6.93, "_code": "d=Bao_cao_ban_hang__So_chi_tiet_ban_hang.copy(); d['dt']=parse_date(d['Ngày']); d['amt']=to_num(d['Thành tiền'])\ng=Bao_cao_ban_hang__Danh_sách_hàng_hóa[['Tên hàng hóa','Nhóm hàng hóa']].drop_duplicates('Tên hàng hóa')\nd=d.merge(g,on='Tên hàng hóa',how='left')\nm=d[(d.dt.dt.year==2026)&(d.dt.dt.month==3)]\nbad=m[m['Trạng thái'].isin(['khách hủy','trả hàng','Đã trả hàng','Không giao được'])]['Mã đơn hàng'].unique()\nm=m[~m['Mã đơn hàng'].isin(bad)]\nRESULT=f\"{m[m['Nhóm hàng hóa']=='xi măng'].amt.sum()/m.amt.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e0aef192cb11", "type": "date", "answer": "2026-06-01", "_code": "\nd=ban_hang.drop_duplicates().copy()\nd=d[~d['Kết quả'].isin(['Đã hủy','Đổi trả'])]\nd['dt']=parse_date(d['Ngày tháng']); d['v']=to_num(d['Thanh tien'])\nd=d[(d.dt>='2026-06-01')&(d.dt<='2026-06-30')]\ns=d.groupby('dt')['v'].sum()\nRESULT=s.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
