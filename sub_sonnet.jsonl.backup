{"id": "q_438bfe9d843a", "type": "date", "answer": "2026-03-26", "_code": "import re\ndef money(x):\n    x=str(x).strip().lower()\n    m=re.match(r'^(-?\\d+)\\s*tr(\\d*)$',x)\n    if m: return int(m.group(1))*1000000+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    s=re.sub(r'[^\\d\\-]','',x)\n    return float(s) if s not in ('','-') else 0.0\no=danh_sach_hoa_don.drop_duplicates('Mã bill').copy()\no['d']=parse_date(o['Ngày giao dịch'])\no=o[(o.d>='2026-03-01')&(o.d<='2026-03-31')&~o.Status.str.contains('hủy|huỷ|trả',case=False,na=False)]\no['v']=o['Tien hang'].map(money)\nRESULT=str(o.groupby('d').v.sum().idxmax().date())\n", "_attempts": 1, "_verdict": "correct"}
