{"id": "q_7761f1a6f55c", "type": "date", "answer": "2025-06-10", "_code": "import re as _re\ndef money(s):\n    def f(x):\n        x=str(x).strip().lower().replace('đ','').replace(' ','')\n        sg=1\n        if x.startswith('-'): sg=-1; x=x[1:]\n        m=_re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            fr=m.group(2); return sg*(int(m.group(1))*1_000_000+(int(fr.ljust(3,'0')[:3])*1000 if fr else 0))\n        m=_re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',x)\n        if m: return sg*float(m.group(1).replace(',','.'))*1000\n        x=_re.sub(r'[.,](?=\\d{3}(\\D|$))','',x)\n        try: return sg*float(x)\n        except: return float('nan')\n    return s.map(f)\ndf=SoBanHang['Tháng 06-2025'].drop_duplicates().copy()\nbad=df[df['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã phiếu'].unique()\ndf=df[~df['Mã phiếu'].isin(bad)]\ndf['d']=pd.to_datetime(df['Giờ'].astype(str).str[:10],errors='coerce')\ndf['m']=money(df['Tiền'])\nRESULT=df.groupby('d')['m'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0483a8398dfe", "type": "list", "answer": [173866200, 156289700, 158205600], "_code": "out=[]\nfor sh in ['10.2025','11.2025','12.2025']:\n    df=DonHang_ChiTiet[sh].copy()\n    for c in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: df[c]=df[c].ffill()\n    df=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|hoàn trả',case=False,na=False)].drop_duplicates()\n    out.append(int(to_num(df['Tổng tiền']).sum()))\nRESULT=out\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ffcc4f2ebca1", "type": "date", "answer": "2026-03-09", "_code": "import pandas as pd\ndf=pd.concat([data['So_chi_tiet_ban_hang_1'],data['So_chi_tiet_ban_hang_2']])\ndf=df.drop_duplicates()\ndf['d']=pd.to_datetime(df['Ngày'],format='%d/%m/%Y',errors='coerce')\ndf=df[(df['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng']))&(df.d>='2026-03-01')&(df.d<='2026-03-31')]\ndf['tt']=to_num(df['Thành tiền'])\ns=df.groupby('d')['tt'].sum().sort_values(ascending=False,kind='stable')\nRESULT=s.index[0].strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4f742bfda263", "type": "list", "answer": ["Thái Sơn Sơn", "Đỗ Bảo Long", "Đỗ Duy Khánh", "Tống Hùng Minh", "Phan Hải Phúc"], "_code": "df=DonHang_ChiTiet__all.copy()\nfor c in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: df[c]=df[c].ffill()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf['t']=to_num(df['Tổng tiền'])\nst=df['Trạng thái đơn hàng'].map(normalize_text)\nbad=st.str.contains('huy|tra')\nbadids=set(df.loc[bad,'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(badids)]\ndf=df[(df.d>='2025-04-28')&(df.d<='2025-05-04')]\ndf=df.drop_duplicates()\ndf['k']=df['Tên khách hàng'].map(normalize_text)\ndf=df[df.k!='khach le']\ng=df.groupby('k').agg(t=('t','sum'),n=('Tên khách hàng','first')).sort_values('t',ascending=False)\nprint(g.head(7))\nRESULT=list(g.n.head(5))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_de90d8e4c393", "type": "percent", "answer": 22.11, "_code": "df=DonHang_ChiTiet.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf['v']=to_num(df['Tổng tiền'])\ndf=df[df['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nt=pd.Timestamp(as_of_date)\na=df[(df.d>=t.replace(day=1))&(df.d<=t)].v.sum()\npm=(t.replace(day=1)-pd.Timedelta(days=1))\npe=min(pm,pm.replace(day=t.day)) if t.day<=pm.day else pm\nb=df[(df.d>=pm.replace(day=1))&(df.d<=pe)].v.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
