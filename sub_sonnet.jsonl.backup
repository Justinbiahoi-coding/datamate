{"id": "q_36cda8515d30", "type": "number", "answer": 1529206, "_code": "import pandas as pd, re\nd=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\ndef money(s):\n    s=str(s).strip().lower()\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        a=int(m.group(1))*1_000_000\n        if m.group(2): a+=int(m.group(2).ljust(3,'0')[:3] if len(m.group(2))<=3 else m.group(2))*1000\n        return a\n    m=re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    return float(re.sub(r'[^\\d]','',s) or 0)\nd['dt']=pd.to_datetime(d['Giờ'])\nd['v']=d['Tiền'].map(money)\nbad=d['Ghi chú TT'].str.lower().isin(['hủy','trả lại','đã trả hàng'])\nbad_orders=set(d.loc[bad,'Mã phiếu'])\nd=d[~d['Mã phiếu'].isin(bad_orders)]\nd=d[(d.dt>='2025-07-28')&(d.dt<'2025-08-04')]\nRESULT=int(round(d['v'].sum()/d['Mã phiếu'].nunique()+1e-9))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a18463d68eda", "type": "number", "answer": 167334, "_code": "h=DanhSachHoaDon.copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[(h['d']>='2025-12-01')&(h['d']<='2025-12-31')&h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\nl=DanhSachHoaDonChiTiet.drop_duplicates()\nl=l[l['Mã hóa đơn'].isin(set(h['Mã hóa đơn']))]\nRESULT=int(to_num(l['Thành tiền']).sum()/len(h)+0.5)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d775b67b6a46", "type": "number", "answer": 587647900, "_code": "o=don_hang[don_hang.TinhTrang.isin(['completed','shipping'])].copy()\no['d']=pd.to_datetime(o.ThoiGianLap.astype(str).str[:10])\no=o[(o.d>='2025-01-01')&(o.d<='2025-03-25')]\nl=chi_tiet_don.drop_duplicates()\nl=l[l.MaHoaDon.isin(o.MaHoaDon)]\nRESULT=int(to_num(l.TriGia).sum())\n", "_attempts": 3, "_verdict": "correct"}
{"id": "q_d0e5ff5e3a43", "type": "number", "answer": 530101, "_code": "import pandas as pd\nd=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).drop_duplicates().reset_index(drop=True)\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt>='2025-12-15')&(d.dt<='2025-12-21')&d['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng'])]\nd['v']=to_num(d['Thành tiền'])\nRESULT=int(d.v.sum()/d['Mã đơn hàng'].nunique()+0.5)\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_b0e965a3cb48", "type": "number", "answer": 38056035, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in('','nan','none'): return 0.0\n    m=1\n    if s.endswith('k'): m=1000; s=s[:-1]\n    s=re.sub(r'[đd₫\\s]|vnd','',s)\n    if re.fullmatch(r'-?\\d{1,3}([.,]\\d{3})+',s): s=re.sub(r'[.,]','',s)\n    else: s=s.replace(',','.')\n    return float(s)*m\nH=DuLieuBanHang__DanhSachHoaDon.copy()\nH=H[~H['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nH['d']=pd.to_datetime(H['Thời gian tạo']).dt.normalize()\nC=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nC=C.merge(H[['Mã hóa đơn','d','Người bán']],on='Mã hóa đơn')\nC['tt']=C['Thành tiền'].map(money)\nC['gv']=C['Giá vốn'].map(money)\nx=C[(C.d>='2025-04-01')&(C.d<='2025-04-30')]\nRESULT=int(round((x.tt-x['Số lượng']*x.gv).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c042a9c68717", "type": "number", "answer": 95549800, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in('','nan','none'): return 0.0\n    m=1\n    if s.endswith('k'): m=1000; s=s[:-1]\n    s=re.sub(r'[đd₫\\s]|vnd','',s)\n    if re.fullmatch(r'-?\\d{1,3}([.,]\\d{3})+',s): s=re.sub(r'[.,]','',s)\n    else: s=s.replace(',','.')\n    return float(s)*m\nH=DuLieuBanHang__DanhSachHoaDon.copy()\nH=H[~H['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nH['d']=pd.to_datetime(H['Thời gian tạo']).dt.normalize()\nC=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nC=C.merge(H[['Mã hóa đơn','d','Người bán']],on='Mã hóa đơn')\nC['tt']=C['Thành tiền'].map(money)\nC['gv']=C['Giá vốn'].map(money)\nx=C[(C.d>='2026-01-01')&(C.d<='2026-01-31')&(C['Người bán']=='NV003')]\nRESULT=int(round(x.tt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5e180397d4d2", "type": "number", "answer": 195733, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in('','nan','none'): return 0.0\n    m=1\n    if s.endswith('k'): m=1000; s=s[:-1]\n    s=re.sub(r'[đd₫\\s]|vnd','',s)\n    if re.fullmatch(r'-?\\d{1,3}([.,]\\d{3})+',s): s=re.sub(r'[.,]','',s)\n    else: s=s.replace(',','.')\n    return float(s)*m\nH=DuLieuBanHang__DanhSachHoaDon.copy()\nH=H[~H['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nH['d']=pd.to_datetime(H['Thời gian tạo']).dt.normalize()\nC=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nC=C.merge(H[['Mã hóa đơn','d','Người bán']],on='Mã hóa đơn')\nC['tt']=C['Thành tiền'].map(money)\nC['gv']=C['Giá vốn'].map(money)\nn=DuLieuBanHang__DanhSachNhapHang.copy()\nn=n[~n['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nn['d']=parse_date(n['Thời gian'])\nn=n[(n.d>='2025-03-01')&(n.d<='2025-03-31')]\nL=DuLieuBanHang__DanhSachChiTietNhapHang.merge(n[['Mã nhập hàng']],on='Mã nhập hàng')\nL=L[(L['Mã hàng']=='SP0005')&(L['ĐVT']=='thùng')]\nL['g']=L['Đơn giá'].map(money)\nRESULT=int(round((L.g*L['Số lượng']).sum()/L['Số lượng'].sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a6d148ff656e", "type": "percent", "answer": 1.06, "_code": "h=BanHang_HoaDon.copy()\nh['d']=parse_date(h['Ngày bán'])\nx=h[(h.d>='2025-09-01')&(h.d<='2025-09-30')]\nRESULT=f\"{round((x['Trạng thái']=='Không giao được').mean()*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4bdb1a8972ce", "type": "number", "answer": 7, "_code": "import pandas as pd\ndf=DonHang_ChiTiet.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill()\ndf=df.drop_duplicates()\ndf['dt']=parse_date(df['Ngày đặt hàng'])\ndf=df[(df.dt>='2025-11-01')&(df.dt<='2025-11-30')]\ndf=df[df['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\ndf['t']=to_num(df['Tổng tiền'])\ns=df.groupby('dt')['t'].sum()\nRESULT=int((s>=9600000).sum())\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_8c8dbb617ba0", "type": "number", "answer": 346167, "_code": "h=BanHang_HoaDon.copy(); p=BanHang_PhieuThu.copy()\nh['d']=parse_date(h['Ngày bán']); h['tot']=to_num(h['Tong tien'])\np['t']=pd.to_datetime(p['Thời gian thu']); p['m']=to_num(p['Số tiền thu'])\nX=pd.Timestamp('2025-10-26')\nh=h[(h['Trạng thái']!='Không giao được')&(h['Phương thức TT']!='Thu hộ (COD)')&(h.d<=X)]\npaid=p[p.t<X+pd.Timedelta(days=1)].groupby('Mã bill').m.sum()\nh['debt']=h.tot-h['Order ID'].map(paid).fillna(0)\nh['age']=(X-h.d).dt.days\nRESULT=int(round(h[(h.age>15)&(h.debt>0)].debt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5f126c4bef2c", "type": "number", "answer": 1985499, "_code": "o=don_hang.drop_duplicates().copy()\no=o[(o['Hình thức thanh toán']=='debt')&(o['Tình trạng đơn']!='cancelled')]\no['od']=parse_date(o['Ngày bán'])\nt=thanh_toan.drop_duplicates().copy()\nt['td']=parse_date(t['Thời điểm']).dt.normalize()\nt=t.merge(o[['Số phiếu','od']],left_on='Mã giao dịch',right_on='Số phiếu')\nt=t[(t.td>t.od)&(t.td>='2025-01-01')&(t.td<='2025-01-31')]\nRESULT=int(to_num(t['Tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
