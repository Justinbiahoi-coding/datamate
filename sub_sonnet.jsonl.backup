{"id": "q_629214960e6e", "type": "number", "answer": 107748, "_code": "d=DonHang_ChiTiet.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['tt']=to_num(d['Tổng tiền'])\nx=d[(d.dt>='2026-05-04')&(d.dt<='2026-05-10')&d['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nRESULT=int(round(x.tt.sum()/x['Mã đơn hàng'].nunique()+1e-9))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3400f2bffb00", "type": "percent", "answer": 35.17, "_code": "import sys,unicodedata\nnk=lambda s: normalize_text(str(s).lower().replace('đ','d'))\ndf=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates()\nprint(df['Trạng thái'].value_counts(),file=sys.stderr)\nG=[v for k,v in data.items() if unicodedata.normalize('NFC',k)=='Danh sách hàng hóa'][0]\nprint(G['Nhóm hàng hóa'].unique(),file=sys.stderr)\nd=parse_date(df['Ngày'])\ndf=df[(d>='2025-08-01')&(d<='2025-08-31')&~df['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn hàng|cancel|return|refund',case=False,na=False)].copy()\ndf['k']=df['Tên hàng hóa'].map(nk); G['k']=G['Tên hàng hóa'].map(nk)\nm=df.merge(G[['k','Nhóm hàng hóa']].drop_duplicates('k'),on='k',how='left')\nprint(m['Nhóm hàng hóa'].isna().sum(), m[m['Nhóm hàng hóa'].isna()]['Tên hàng hóa'].unique(),file=sys.stderr)\nt=to_num(m['Thành tiền'])\nRESULT=f\"{round(t[m['Nhóm hàng hóa']=='cà phê'].sum()/t.sum()*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_9d9fc3e581ad", "type": "number", "answer": 324985000, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s.startswith('-'): return -money(s[1:])\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        a,b=m.groups(); return int(a)*1000000+(int(b)*10**(6-len(b)) if b else 0)\n    m=re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return int(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\nimport unicodedata as _u\na=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).drop_duplicates().copy()\na['d']=parse_date(a['Ngày'])\na=a[~a['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\na=a[(a['d']>='2026-03-01')&(a['d']<='2026-03-31')]\nhh=[v for k,v in data.items() if 'ch h' in _u.normalize('NFC',k) and '__' not in k][0]\nmp={vn_normalize(n):g for n,g in zip(hh['Tên hàng hóa'],hh['Nhóm hàng hóa'])}\na['g']=a['Tên hàng hóa'].map(vn_normalize).map(mp)\nRESULT=int(round(a[a['g'].astype(str).str.strip().str.lower()=='lẩu']['Thành tiền'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_25501a11062a", "type": "number", "answer": 27145500.0, "_code": "o=DanhSachHoaDon__all.drop_duplicates().copy()\no['d']=parse_date(o['Thời gian'])\no=o[(o.d==pd.Timestamp(as_of_date))]\no=o[~o['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(o['Mã hóa đơn'])]\nRESULT=float(to_num(c['Thành tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_dbb72e9c73f1", "type": "percent", "answer": 18.92, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\no=don_hang.copy(); l=chi_tiet_don.copy()\no['d']=parse_date(o['NgayBan'])\nl['t']=l['T.Tiền'].map(money); l['q']=pd.to_numeric(l['SL quy đổi'],errors='coerce')\ndef okorders(a,b):\n    x=o[(o.d>=a)&(o.d<=b)&o['Xử lý'].isin(['completed','shipping'])]\n    return x\ndef rev(a,b):\n    x=okorders(a,b); return l[l['Ma don'].isin(x['Mã chứng từ'])]\nr=rev('2025-02-01','2025-02-28')\nsp=san_pham.set_index('SKU')['Nhom hang']\nr=r.assign(g=r['ID SP'].map(sp))\nRESULT=f\"{round(r[r.g=='trà']['t'].sum()/r['t'].sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fe769cf4ec48", "type": "number", "answer": 3123, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\no=don_hang.copy(); l=chi_tiet_don.copy()\no['d']=parse_date(o['NgayBan'])\nl['t']=l['T.Tiền'].map(money); l['q']=pd.to_numeric(l['SL quy đổi'],errors='coerce')\ndef okorders(a,b):\n    x=o[(o.d>=a)&(o.d<=b)&o['Xử lý'].isin(['completed','shipping'])]\n    return x\ndef rev(a,b):\n    x=okorders(a,b); return l[l['Ma don'].isin(x['Mã chứng từ'])]\nr=rev('2025-01-01','2025-01-31')\nnm=san_pham.set_index('SKU')['Sản phẩm']\nr=r.assign(n=r['ID SP'].map(nm))\nRESULT=int(r[r.n.str.strip().str.lower().str.endswith('(m)')]['q'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a2e949cc6bc8", "type": "percent", "answer": 3.09, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\no=don_hang.copy(); l=chi_tiet_don.copy()\no['d']=parse_date(o['NgayBan'])\nl['t']=l['T.Tiền'].map(money); l['q']=pd.to_numeric(l['SL quy đổi'],errors='coerce')\ndef okorders(a,b):\n    x=o[(o.d>=a)&(o.d<=b)&o['Xử lý'].isin(['completed','shipping'])]\n    return x\ndef rev(a,b):\n    x=okorders(a,b); return l[l['Ma don'].isin(x['Mã chứng từ'])]\na=rev('2026-05-01','2026-05-31')['t'].sum(); b=rev('2026-04-01','2026-04-30')['t'].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9f908a9cf5e8", "type": "number", "answer": 2504000, "_code": "import re as _re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s in('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d{1,3})?',s)\n    if m:\n        return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1e3 if m.group(2) else 0)\n    m=_re.fullmatch(r'([\\d.,]+)\\s*tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'-?\\d+\\.\\d{1,2}',s): return float(s)  # decimal\n    if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',',''))\n    except: return float('nan')\nBAD='hủy|huỷ|cancel|trả|hoàn hàng|Không giao được|hoàn trả'\no=don_hang.copy(); l=chi_tiet_don.copy()\no['d']=parse_date(o['NgayBan'])\nl['t']=l['T.Tiền'].map(money); l['q']=pd.to_numeric(l['SL quy đổi'],errors='coerce')\ndef okorders(a,b):\n    x=o[(o.d>=a)&(o.d<=b)&o['Xử lý'].isin(['completed','shipping'])]\n    return x\ndef rev(a,b):\n    x=okorders(a,b); return l[l['Ma don'].isin(x['Mã chứng từ'])]\nx=o[(o['Phương thức TT']=='debt')&~o['Xử lý'].str.contains('cancel',na=False)]\np=thanh_toan.merge(x[['Mã chứng từ','d']],left_on='Số HĐ',right_on='Mã chứng từ')\npd_=pd.to_datetime(p['Thời gian thu'])\nm=(pd_>='2025-12-01')&(pd_<'2026-01-01')&(pd_.dt.normalize()>p['d'])\nRESULT=int(p.loc[m,'Tiền'].map(money).sum())\n", "_attempts": 1, "_verdict": "correct"}
