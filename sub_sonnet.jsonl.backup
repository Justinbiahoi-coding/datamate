{"id": "q_96538f80bf0e", "type": "percent", "answer": 7.84, "_code": "p = data[[k for k in data if k.startswith('Danh')][0]]\nd = So_chi_tiet_ban_hang__all.copy(); d['d'] = parse_date(d['Ngày'])\nd = d[d['d'].between('2025-12-01','2025-12-31') & ~d['Trạng thái'].str.contains('hủy|huỷ|trả', case=False, na=False)].copy()\nd['t'] = to_num(d['Thành tiền'])\ng = d['Tên hàng hóa'].map(p.set_index('Tên hàng hóa')['Nhóm hàng hóa'])\nRESULT = f\"{d.loc[g=='ống nước','t'].sum()/d['t'].sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_dd16e37a8d4d", "type": "date", "answer": "2025-03-29", "_code": "def mny(s): return pd.to_numeric(s.astype(str).str.replace(r'[^\\d\\-]','',regex=True),errors='coerce')\nh = DanhSachHoaDon__all.copy(); h['d']=parse_date(h['Thời gian']); h['a']=mny(h['Tổng tiền hàng'])\ng = h[~h['Trạng thái'].isin(['Đã hủy','Đã trả hàng'])&(h.d>='2025-03-01')&(h.d<='2025-03-31')]\nRESULT = g.groupby('d').a.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
