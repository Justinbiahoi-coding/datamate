{"id": "q_b33c1f31d04d", "type": "percent", "answer": 5.9, "_code": "import re\ndef pm(x):\n    s=str(x).strip()\n    m=re.match(r'^(\\d+)(?:,(\\d+))?tr$',s)\n    if m: return float(m.group(1)+'.'+(m.group(2) or '0'))*1e6\n    return float(re.sub(r'[^\\d]','',s)) if re.sub(r'[^\\d]','',s) else 0.0\nc=chi_tiet_don.drop_duplicates().copy()\nc['tt']=c['Tiền bán'].map(pm)\nd=don_hang.drop_duplicates().copy(); d['dt']=parse_date(d['Ngày bán'])\nd=d[~d['Tình trạng đơn'].isin(['cancelled','returned'])]\nd=d[(d.dt>='2026-07-01')&(d.dt<='2026-07-31')]\nc=c[c['Số CT'].isin(d['Số phiếu'])].merge(san_pham[['Mã HH','Nhom hang']],left_on='Mã hàng bán',right_on='Mã HH',how='left')\nRESULT=f\"{round(c[c['Nhom hang']=='khai vị'].tt.sum()/c.tt.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_81d75bf535d0", "type": "number", "answer": 3088000, "_code": "h=data['DanhSachHoaDon__all'].copy()\nh['dt']=parse_date(h['Thời gian'])\ny=pd.Timestamp(as_of_date)-pd.Timedelta(days=1)\nok=h[(h.dt==y)&h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]['Mã hóa đơn']\nc=data['DanhSachHoaDonChiTiet'].drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(ok)]\nRESULT=int(to_num(c['Thành tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3b5bfbfb6938", "type": "percent", "answer": 2.64, "_code": "h=data['DanhSachHoaDon__all'].copy()\nh['dt']=parse_date(h['Thời gian'])\nok=h[(h.dt>='2025-03-01')&(h.dt<='2025-03-31')&h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]['Mã hóa đơn']\nc=data['DanhSachHoaDonChiTiet'].drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(ok)].copy()\nc['v']=to_num(c['Thành tiền'])\nt=data['DanhSachThuoc'].copy()\nrx=set(t[t['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1','có'])]['Mã hàng'])\nRESULT=f\"{c[c['Mã hàng'].isin(rx)].v.sum()/c.v.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0d3c74a07021", "type": "percent", "answer": 391.3, "_code": "\nimport re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s=='' : return 0.0\n    m=_re.match(r'^(-?\\d+)(?:[.,](\\d+))?\\s*tr\\s*(\\d+)?$',s)\n    if m:\n        a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0'))*1e3\n        return a\n    m=_re.match(r'^(-?\\d+(?:[.,]\\d+)?)\\s*k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.match(r'^-?\\d{1,3}([.,]\\d{3})+$',s): return float(_re.sub(r'[.,]','',s))\n    if _re.match(r'^-?\\d+[.,]\\d{4}$',s): return float(s.replace(',','.'))\n    s2=s.replace(',','.')\n    try: return float(s2)\n    except: return float('nan')\n\nh=BanHang_HoaDon.copy(); h['dt']=pd.to_datetime(h['Giờ tạo đơn']).dt.normalize()\nh=h[h['Trạng thái'].isin(['Đã giao','Đang vận chuyển'])]\nc=BanHang_ChiTietHoaDon.drop_duplicates()\nc=c[c['Ma hang']=='SP0033'].merge(h[['Order ID','dt']],left_on='Mã giao dịch',right_on='Order ID')\nc['q']=pd.to_numeric(c['SL cơ bản'].astype(str).str.replace(',',''),errors='coerce')\nD=pd.Timestamp('2025-07-09'); N=7\na=c[(c.dt>=D)&(c.dt<D+pd.Timedelta(days=N))].q.sum()\nb=c[(c.dt>=D-pd.Timedelta(days=N))&(c.dt<D)].q.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_44dcce0af67a", "type": "percent", "answer": 35.48, "_code": "\nimport re as _re\ndef money(x):\n    if pd.isna(x): return 0.0\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    if s=='' : return 0.0\n    m=_re.match(r'^(-?\\d+)(?:[.,](\\d+))?\\s*tr\\s*(\\d+)?$',s)\n    if m:\n        a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0'))*1e3\n        return a\n    m=_re.match(r'^(-?\\d+(?:[.,]\\d+)?)\\s*k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.match(r'^-?\\d{1,3}([.,]\\d{3})+$',s): return float(_re.sub(r'[.,]','',s))\n    if _re.match(r'^-?\\d+[.,]\\d{4}$',s): return float(s.replace(',','.'))\n    s2=s.replace(',','.')\n    try: return float(s2)\n    except: return float('nan')\n\nh=BanHang_HoaDon.copy(); h['dt']=pd.to_datetime(h['Giờ tạo đơn']).dt.normalize()\nh=h[h['Trạng thái'].isin(['Đã giao','Đang vận chuyển'])]\nc=BanHang_ChiTietHoaDon.drop_duplicates()\nc=c[c['Ma hang']=='SP0032'].merge(h[['Order ID','dt']],left_on='Mã giao dịch',right_on='Order ID')\nc['q']=pd.to_numeric(c['SL cơ bản'].astype(str).str.replace(',',''),errors='coerce')\nD=pd.Timestamp('2026-02-05'); N=14\na=c[(c.dt>=D)&(c.dt<D+pd.Timedelta(days=N))].q.sum()\nb=c[(c.dt>=D-pd.Timedelta(days=N))&(c.dt<D)].q.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9477fcddf45f", "type": "percent", "answer": 3.93, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True)\nd['dt']=parse_date(d['Ngày']); d['v']=to_num(d['Thành tiền'])\nbad=d[d['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả|hoàn trả',case=False)]['Mã đơn hàng'].unique()\ng=d[~d['Mã đơn hàng'].isin(bad)]\na=g[(g.dt>='2025-06-01')&(g.dt<='2025-06-15')].v.sum(); b=g[(g.dt>='2025-05-01')&(g.dt<='2025-05-15')].v.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
