{"id": "q_fbef1e31ad7a", "type": "number", "answer": 23368734, "_code": "import pandas as pd\nh=DuLieuBanHang['DanhSachHoaDon'].copy(); q=DuLieuBanHang['SoQuy'].copy()\nh['od']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\ndebt=h[(h['Phương thức thanh toán']=='Ghi nợ')&(~h['Trạng thái'].str.contains('hủy|huỷ',case=False))]\nq['qd']=pd.to_datetime(q['Thời gian']).dt.normalize()\nm=q.merge(debt[['Mã hóa đơn','od']],on='Mã hóa đơn')\nm=m[(m.qd>m.od)&(m.qd>='2025-08-01')&(m.qd<='2025-08-31')]\nRESULT=int(m['Giá trị'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fea67fe0f3cc", "type": "number", "answer": 226778500, "_code": "import pandas as pd\nh=DuLieuBanHang['DanhSachHoaDon'].copy()\nh['od']=pd.to_datetime(h['Thời gian tạo'])\nok=h[(~h['Trạng thái'].str.contains('hủy|huỷ|trả hàng',case=False))&(h.od>='2026-04-01')&(h.od<'2026-05-01')]\nd=DanhSachHoaDonChiTiet[DanhSachHoaDonChiTiet['Mã hóa đơn'].isin(ok['Mã hóa đơn'])]\nRESULT=int(to_num(d['Thành tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9b9f190953d7", "type": "number", "answer": 20, "_code": "import unicodedata\ns=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\ns['dt']=parse_date(s['Ngày'])\ns['n']=s['Tên hàng hóa'].map(lambda x:' '.join(unicodedata.normalize('NFC',str(x)).lower().split()))\nbad=set(s[s['Trạng thái'].isin(['Đã hủy','Đã trả hàng'])]['Mã đơn hàng'])\ns=s[~s['Mã đơn hàng'].isin(bad)]\nt=s[(s.dt>='2026-01-01')&(s.dt<='2026-01-31')&s.n.str.contains('kova ct-11a')]\nRESULT=int(to_num(t['Số lượng quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
