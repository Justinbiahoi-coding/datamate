{"id": "q_f7b8eb9ecf98", "type": "percent", "answer": 6.98, "_code": "\nd=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\nd=d[~d['Tên hàng hóa'].astype(str).str.upper().str.startswith('TỔNG')]\nd['t']=parse_date(d['Ngày']); d['m']=to_num(d['Thành tiền'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\na=d[(d.t.dt.year==2026)&(d.t.dt.month==7)].m.sum(); b=d[(d.t.dt.year==2026)&(d.t.dt.month==6)].m.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_5029b166aa34", "type": "percent", "answer": 2.25, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\na=data['DonHang_ChiTiet__all'].drop_duplicates().copy()\na['d']=pd.to_datetime(a['Ngày đặt hàng'],format='%d/%m/%Y')\na=a[~a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\na['v']=a['Tổng tiền'].map(money)\ndef rev(y,m): return a[(a.d.dt.year==y)&(a.d.dt.month==m)].v.sum()\ncur,prev=rev(2026,4),rev(2025,4)\nRESULT=f\"{(cur-prev)/prev*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a72313208f3d", "type": "number", "answer": 145, "_code": "d=SoBanHang.copy()\nd['d']=parse_date(d['Ngày mua'])\nbad=d['Ghi chú TT'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)\nm=(d.d>='2026-03-01')&(d.d<='2026-03-31')&~bad&(d['Mặt hàng']=='Thép Pomina D10 cây 11.7m')\nRESULT=int(to_num(d[m]['Số lượng lẻ']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a1be517fd596", "type": "number", "answer": 117620, "_code": "h=DanhSachHoaDon__all.drop_duplicates().copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh['v']=to_num(h['Tổng tiền hàng'])\nh=h[(h.d>='2026-03-01')&(h.d<='2026-03-31')]\nimport math\nRESULT=int(math.floor(h.v.mean()+0.5))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9a42bbd5ca19", "type": "percent", "answer": 88.83, "_code": "h=DanhSachHoaDon__all.drop_duplicates().copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh['v']=to_num(h['Tổng tiền hàng'])\nh=h[(h.d>='2026-06-01')&(h.d<=as_of_date)]\nRESULT=f\"{round(h[h['Kênh bán']=='store'].v.sum()/h.v.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ecd3c08dfb4d", "type": "number", "answer": 25368400, "_code": "h=DanhSachHoaDon__all.drop_duplicates().copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh['v']=to_num(h['Tổng tiền hàng'])\nh=h[(h.d>='2025-05-01')&(h.d<='2025-05-31')]\nl=DanhSachHoaDonChiTiet.drop_duplicates()\nl=l[l['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nl['g']=l['Mã hàng'].map(dict(zip(DanhSachSanPham['Mã hàng'],DanhSachSanPham['Nhóm hàng(3 Cấp)'])))\nRESULT=int(round(to_num(l[l.g=='ho cảm cúm']['Thành tiền']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4dd381828fe4", "type": "percent", "answer": 24.95, "_code": "import pandas as pd, re, unicodedata as ud\ndef N(s): return re.sub(r'\\s+',' ',ud.normalize('NFC',str(s)).strip().lower())\ndef money(x):\n    s=str(x).strip().replace('đ','').replace(' ','')\n    s=re.sub(r',(?=\\d{3}(\\D|$))','',s)\n    try: return float(s)\n    except: return float('nan')\na=data['So_chi_tiet_ban_hang__all'].copy().drop_duplicates()\na['v']=a['Thành tiền'].map(money)\na['d']=pd.to_datetime(a['Ngày'].astype(str),dayfirst=True,errors='coerce')\nbad=a['Trạng thái'].astype(str).map(N).str.contains('hủy|huỷ|cancel|trả|hoàn|không giao')\nbadord=set(a[bad]['Mã đơn hàng'])\na=a[~a['Mã đơn hàng'].isin(badord)]\nhh=[v for k,v in data.items() if 'Danh sách hàng' in ud.normalize('NFC',k)][0]\ng={N(r['Tên hàng hóa']):N(r['Nhóm hàng hóa']) for _,r in hh.iterrows()}\na['g']=a['Tên hàng hóa'].map(N).map(g)\nx=a[(a.d.dt.year==2026)&(a.d.dt.month==5)]\nprint(x.g.isna().sum(), x.v.isna().sum())\nRESULT=f\"{round(x[x.g=='điện'].v.sum()/x.v.sum()*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5c9cf907f474", "type": "percent", "answer": 6.24, "_code": "h=DanhSachHoaDon.copy()\nh['d']=parse_date(h['Thời gian'])\nh['ts']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nh['t']=h['Tổng tiền hàng'].astype(str).str.replace(',','').astype(float)\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\ndef rev(a,b,f=None):\n    x=h[(h.d>=a)&(h.d<=b)]\n    return x if f is None else x[f(x)]\n\na,b='2026-05-01','2026-05-29'\nRESULT=f\"{rev(a,b,lambda x:x['Kênh bán']=='zalo_oa').t.sum()/rev(a,b).t.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f47b3edba33e", "type": "percent", "answer": 8.25, "_code": "h=DanhSachHoaDon.copy()\nh['d']=parse_date(h['Thời gian'])\nh['ts']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nh['t']=h['Tổng tiền hàng'].astype(str).str.replace(',','').astype(float)\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\ndef rev(a,b,f=None):\n    x=h[(h.d>=a)&(h.d<=b)]\n    return x if f is None else x[f(x)]\n\na=rev('2026-04-01','2026-04-30').t.sum();b=rev('2026-03-01','2026-03-31').t.sum()\nRESULT=f\"{(a/b-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_39c1d2ede943", "type": "percent", "answer": -5.36, "_code": "h=DanhSachHoaDon.copy()\nh['d']=parse_date(h['Thời gian'])\nh['ts']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nh['t']=h['Tổng tiền hàng'].astype(str).str.replace(',','').astype(float)\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\ndef rev(a,b,f=None):\n    x=h[(h.d>=a)&(h.d<=b)]\n    return x if f is None else x[f(x)]\n\na,b='2026-05-11','2026-05-17'\nx=rev(a,b); hr=x.ts.dt.hour\ns=x[(hr>=6)&(hr<14)].t.sum(); c=x[(hr>=14)&(hr<22)].t.sum()\nRESULT=f\"{(c/s-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7b171247d1cc", "type": "percent", "answer": 13.77, "_code": "h=DanhSachHoaDon.copy()\nh['d']=parse_date(h['Thời gian'])\nh['ts']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nh['t']=h['Tổng tiền hàng'].astype(str).str.replace(',','').astype(float)\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\ndef rev(a,b,f=None):\n    x=h[(h.d>=a)&(h.d<=b)]\n    return x if f is None else x[f(x)]\n\nkh=DanhSachKhachHang\ngrp=set(kh[kh['Nhóm khách hàng'].astype(str).str.strip()=='thân thiết']['Mã khách hàng'])\na,b='2026-05-01','2026-05-29'\nx=rev(a,b)\nRESULT=f\"{x[x['Mã KH'].isin(grp)].t.sum()/x.t.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b862f909a477", "type": "percent", "answer": 5.43, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=float('nan')\n    return -v if neg else v\n\nc=chi_tiet_don.drop_duplicates().copy(); c['m']=c['Amount'].apply(money)\no=don_hang.copy(); o['t']=parse_date(o['Ngày'])\no=o[~o['Tình trạng'].isin(['cancelled','returned'])]\nc=c.merge(o[['Mã chứng từ','t']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\n\na=c[(c.t.dt.year==2026)&(c.t.dt.month==1)].m.sum(); b=c[(c.t.dt.year==2025)&(c.t.dt.month==12)].m.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4cdd53ddc6dc", "type": "percent", "answer": 18.06, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=float('nan')\n    return -v if neg else v\n\nc=chi_tiet_don.drop_duplicates().copy(); c['m']=c['Amount'].apply(money)\no=don_hang.copy(); o['t']=parse_date(o['Ngày'])\no=o[~o['Tình trạng'].isin(['cancelled','returned'])]\nc=c.merge(o[['Mã chứng từ','t']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\n\nc=c.merge(san_pham[['Mã sản phẩm bán','Danh mục']],left_on='Mã mặt hàng',right_on='Mã sản phẩm bán',how='left')\nf=c[(c.t.dt.year==2026)&(c.t.dt.month==2)]\nRESULT=f\"{f[f['Danh mục']=='chiên xào'].m.sum()/f.m.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_47e1ab6aee7d", "type": "number", "answer": 68, "_code": "d=don_hang.copy()\nd['dt']=parse_date(d['NgayBan'])\nm=d[(d.dt>='2025-08-01')&(d.dt<='2025-08-31')&(d['Xử lý'].str.lower()=='cancelled')]\nRESULT=int(m['Mã chứng từ'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_040c9dd7f4de", "type": "list", "answer": ["Xi măng Hà Tiên PCB40 bao 50kg", "Gạch ống 8x8x18 Tuynel", "Xi măng INSEE Power-S bao 50kg", "Băng keo điện Nano 20 yard", "Ống PVC Bình Minh D32 cây 4m"], "_code": "\nd=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nbad=set(d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|không giao',case=False,na=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bad)].copy()\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt>='2025-09-01')&(d.dt<='2025-09-30')]\nd['q']=pd.to_numeric(d['Số lượng quy đổi'].astype(str).str.extract(r'(-?[\\d.]+)')[0])\nL=Bao_cao_ban_hang['Danh sách hàng hóa']\ncanon={normalize_text(n):n for n in L['Tên hàng hóa']}\nd['n']=d['Tên hàng hóa'].map(lambda s: canon.get(normalize_text(s),s))\ng=d.groupby('n')['q'].sum().reset_index().sort_values(['q','n'],ascending=[False,True]).head(5)\nRESULT=list(g['n'])\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_b596c49e8651", "type": "number", "answer": 868700, "_code": "import pandas as pd, re\ndef money(x):\n    s=str(x).replace(',','').replace('đ','').strip()\n    try: return float(s)\n    except: return float('nan')\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=pd.to_datetime(h['Thời gian'].astype(str),dayfirst=True,errors='coerce')\nh=h[~h['Trạng thái'].astype(str).str.lower().str.contains('hủy|huỷ|trả')]\nc=DanhSachHoaDonChiTiet.copy(); c['v']=c['Thành tiền'].map(money)\nt=DanhSachThuoc[DanhSachThuoc['Hoạt chất'].astype(str).str.strip().str.lower()=='natri clorid']['Mã hàng']\nx=c[c['Mã hàng'].isin(t)].merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\nx=x[(x.d>='2026-06-01')&(x.d<='2026-06-12')]\nRESULT=int(round(x.v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
