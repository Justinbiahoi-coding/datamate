{"id": "q_16f9cc98ab35", "type": "percent", "answer": -0.7, "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=DonHang_ChiTiet__all.copy()\noc=[c for c in df.columns if df[c].isna().mean()>0.3 and c!='Tổng tiền']\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\nst=df['Trạng thái đơn hàng'].astype(str).str.lower()\nbad=set(df.loc[st.str.contains('hủy|huỷ|hoàn trả|trả'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf['d']=parse_date(df['Ngày đặt hàng']); df['a']=df['Tổng tiền'].map(m)\ncur=df[(df.d>='2025-12-01')&(df.d<='2025-12-12')].a.sum()\npre=df[(df.d>='2025-11-01')&(df.d<='2025-11-12')].a.sum()\nRESULT=f\"{round((cur-pre)/pre*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3f7dc57965db", "type": "list", "answer": ["Khẩu trang y tế 4 lớp Khánh An hộp 50 cái", "Prednisolon 5mg Boston chai 500 viên", "Hapacol 250 hộp 24 gói"], "_code": "inv=DanhSachHoaDon__T03_2026.copy()\ninv=inv[~inv['Trạng thái'].isin(['Đã hủy','Đã trả hàng'])]\ndet=DanhSachHoaDonChiTiet.drop_duplicates()\ndet=det[det['Mã hóa đơn'].isin(inv['Mã hóa đơn'])]\ndet['q']=to_num(det['Số lượng quy đổi'])\ns=det.groupby('Mã hàng')['q'].sum().sort_values(ascending=False)\nnames=DanhSachSanPham.set_index('Mã hàng')['Tên hàng']\nRESULT=[names[c] for c in s.index[:3]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_40de33fe6cdc", "type": "number", "answer": -62275893, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','')\n    if s in ('','nan'): return 0.0\n    if s.endswith('tr'): return float(s[:-2].replace(',','.'))*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','').replace('.',''))*1e3\n    return float(s.replace(',','').replace('.',''))\nh=BanHang_HoaDon.copy()\nh['dt']=pd.to_datetime(h['Giờ tạo đơn'])\nh=h[(h.dt>='2025-01-01')&(h.dt<'2025-02-01')&~h['Trạng thái'].isin(['Không giao được','Đổi trả'])]\nd=BanHang_ChiTietHoaDon.drop_duplicates()\nd=d[d['Mã giao dịch'].isin(h['Order ID'])]\nrev=d['Thanh tien'].map(money).sum()\ncost=(d['Giá vốn lúc bán'].map(money)*pd.to_numeric(d['Slg'])).sum()\nc=SoTay_ChiPhi.copy()\ndt=c['Ngày chi'].map(lambda x: pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(x)) if isinstance(x,(int,float)) else pd.to_datetime(x,dayfirst=True))\nc=c[(dt>='2025-01-01')&(dt<'2025-02-01')]\nexp=c['So tien'].map(money).sum()\nRESULT=round(rev-cost-exp)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d19ed683bea0", "type": "percent", "answer": 3.14, "_code": "df=DonHang_ChiTiet__T12_2025.copy()\no=df.drop_duplicates('Mã đơn hàng')\nRESULT=f\"{round((o['Trạng thái đơn hàng']=='Đã hủy').sum()/len(o)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_12acf57a8170", "type": "string", "answer": "Hứa Đạt Chi", "_code": "df=DonHang_ChiTiet.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[(df.d>='2025-10-01')&(df.d<'2025-11-01')]\no=df.drop_duplicates('Mã đơn hàng')\no=o[o['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nn=o['Tên khách hàng'].astype(str).str.replace(r'[\\s\\-–]*\\(?\\d{8,}\\)?\\s*$','',regex=True).str.strip()\nn=n[~n.str.lower().isin(['khách lẻ','kl','lẻ','khach le','nan',''])]\nprint(n.value_counts().head(6))\nRESULT=n.value_counts().index[0]\n", "_attempts": 2, "_verdict": "correct"}
