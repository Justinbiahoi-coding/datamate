{"id": "q_3c3a0109c0b5", "type": "string", "answer": "Costar Omega 3 1000mg lọ 100 viên", "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\nh=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh=h[~h['Trạng thái'].astype(str).str.lower().str.contains('hủy|huỷ|đổi trả|trả|không giao được')]\nh['d']=parse_date(h['Ngày bán'])\nc=BanHang_ChiTietHoaDon.drop_duplicates().copy()\nc['rev']=c['Thanh tien'].map(m); c['q']=c['Slg'].map(m)\nc['cost']=c['Giá vốn lúc bán'].map(m)*c['q']\nc=c.merge(h[['Order ID','d']],left_on='Mã giao dịch',right_on='Order ID')\nw=c[(c.d>='2025-04-01')&(c.d<'2025-05-01')]\nw['p']=w.rev-w.cost\nRESULT=BanHang_HangHoa.set_index('ma_sp')['Món'][w.groupby('Ma hang').p.sum().idxmax()]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bb4eb2e8e8b8", "type": "list", "answer": ["Kiều Ngọc Hoàng", "Lưu Khánh Chi", "Đỗ Hương Trung"], "_code": "import re\ndef m1(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr',1)\n        if re.search(r'[,\\.]',a): return float(a.replace(',','.'))*1000000\n        return int(a or 0)*1000000+(int(b.ljust(3,'0'))*1000 if b else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    neg=s.startswith('-')\n    v=float(re.sub(r'[^\\d]','',s) or 0)\n    return -v if neg else v\na=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\na['d']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na=a[(a.d.dt.year==2026)&(a.d.dt.month==4)]\na['k']=a['Khách hàng'].astype(str).str.replace(r'[\\d\\s\\.\\-\\(\\)]+$','',regex=True).str.strip()\na=a[~a.k.str.lower().isin(['lẻ','khách lẻ','kl','nan',''])]\nbad=a.groupby('Mã đơn hàng')['Trạng thái'].apply(lambda s:s.str.contains('hủy|huỷ|trả',case=False).any())\na=a[a['Mã đơn hàng'].isin(bad[~bad].index)]\na['amt']=a['Thành tiền'].map(m1)\nRESULT=list(a.groupby('k')['amt'].sum().sort_values(ascending=False).head(3).index)\n", "_attempts": 1, "_verdict": "correct"}
