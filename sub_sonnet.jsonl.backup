{"id": "q_1f08e59ff2d0", "type": "number", "answer": 14, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\nx=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].copy()\nx['dt']=pd.to_datetime(x['Ngày'],format='%d/%m/%Y')\nx=x[(x.dt.dt.year==2026)&(x.dt.dt.month==2)]\nx=x[x['Trạng thái'].astype(str).str.contains('hủy|huỷ',case=False)]\nRESULT=int(x['Mã đơn hàng'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3382028a8e59", "type": "percent", "answer": 5.28, "_code": "\nd=don_hang.drop_duplicates('MaHoaDon').copy()\nd['t']=pd.to_datetime(d.ThoiGianLap)\nd=d[(d.t.dt.year==2025)&(d.t.dt.month==11)&(~d.TinhTrang.isin(['cancelled','returned']))]\nc=chi_tiet_don.drop_duplicates(['MaHoaDon','SoThuTu']).copy()\nc['TriGia']=pd.to_numeric(c.TriGia)\nrev=c.groupby('MaHoaDon').TriGia.sum()\nd['rev']=d.MaHoaDon.map(rev).fillna(0)\nRESULT=f\"{round(d[d.KenhBanHang=='phone'].rev.sum()/d.rev.sum()*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_c6a0bb80b9f9", "type": "percent", "answer": 23.78, "_code": "d=DonHang_ChiTiet__all.copy()\nhc=[\"Mã đơn hàng\",\"Ngày đặt hàng\",\"Trạng thái đơn hàng\",\"Tên khách hàng\"]\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd[\"od\"]=parse_date(d[\"Ngày đặt hàng\"])\nd[\"a\"]=to_num(d[\"Tổng tiền\"]); d[\"q\"]=d[\"Số lượng sản phẩm\"].astype(str).str.extract(r\"(\\d+\\.?\\d*)\")[0].astype(float)\nok=d[~d[\"Trạng thái đơn hàng\"].str.contains(\"hủy|huỷ|trả|cancel\",case=False,na=False)]\n\nr=lambda s,e: ok[(ok.od>=s)&(ok.od<=e)].a.sum()\nx,y=r(\"2026-06-01\",\"2026-06-18\"),r(\"2026-05-01\",\"2026-05-18\")\nRESULT=f\"{(x-y)/y*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1ae34ce74d14", "type": "percent", "answer": 57.14, "_code": "d=DonHang_ChiTiet__all.copy()\nhc=[\"Mã đơn hàng\",\"Ngày đặt hàng\",\"Trạng thái đơn hàng\",\"Tên khách hàng\"]\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd[\"od\"]=parse_date(d[\"Ngày đặt hàng\"])\nd[\"a\"]=to_num(d[\"Tổng tiền\"]); d[\"q\"]=d[\"Số lượng sản phẩm\"].astype(str).str.extract(r\"(\\d+\\.?\\d*)\")[0].astype(float)\nok=d[~d[\"Trạng thái đơn hàng\"].str.contains(\"hủy|huỷ|trả|cancel\",case=False,na=False)]\n\nn=ok[ok[\"Tên sản phẩm\"]==\"Nhang Quảng Trí bó\"].copy()\nn[\"b\"]=n.q*n[\"Đơn vị tính\"].map({\"bó\":1,\"thùng\":20}).fillna(1)\nr=lambda s,e: n[(n.od>=s)&(n.od<=e)].b.sum()\nx,y=r(\"2026-01-24\",\"2026-01-30\"),r(\"2026-01-17\",\"2026-01-23\")\nprint(x,y,n[\"Đơn vị tính\"].unique())\nRESULT=f\"{(x-y)/y*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3b953d51d3e4", "type": "number", "answer": 72752, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nh=don_hang.drop_duplicates().drop_duplicates('Mã chứng từ')\nh=h[~h['Xử lý'].isin(['cancelled','returned'])]\nh=h.assign(dt=pdate(h['NgayBan']))\nc=chi_tiet_don.drop_duplicates(); c=c.assign(v=money(c['T.Tiền']))\nh=h.assign(v=h['Mã chứng từ'].map(c.groupby('Ma don').v.sum()).fillna(0))\ndef rv(s,e): return h[(h.dt>=s)&(h.dt<=e)]\nm=rv('2026-06-01','2026-06-30')\nRESULT=int(round(m.v.mean()))\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_65c443203f31", "type": "percent", "answer": 0.99, "_code": "h=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nd=parse_date(h['Ngày bán'])\nh=h[(d>='2026-05-01')&(d<='2026-05-25')]\nRESULT=f\"{h['Trạng thái'].str.contains('hủy|huỷ|Không giao được',case=False).sum()/len(h)*100:.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_7cb8d7ee96d9", "type": "number", "answer": 37631100, "_code": "df = SoBanHang.copy()\ndf['d'] = parse_date(df['Ngày mua'])\ndf['amt'] = pd.to_numeric(df['thanh_tien'].astype(str).str.replace(r'[^\\d]', '', regex=True), errors='coerce')\ndf = df[~df['Ghi chú TT'].str.contains('hủy|huỷ|trả|cancel', case=False, na=False)]\ny = pd.Timestamp(as_of_date) - pd.Timedelta(days=1)\nRESULT = int(df[df.d == y]['amt'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ee0f5dce73bd", "type": "percent", "answer": 14.37, "_code": "\nh=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh['t']=pd.to_datetime(h['Giờ tạo đơn'])\nh=h[(h.t.dt.year==2025)&(h.t.dt.month==6)&(~h['Trạng thái'].isin(['Không giao được','Đổi trả']))]\nc=BanHang_ChiTietHoaDon.drop_duplicates(['Mã giao dịch','TT dòng']).copy()\nc['v']=to_num(c['Thanh tien'])\nrev=c.groupby('Mã giao dịch').v.sum()\nh['rev']=h['Order ID'].map(rev).fillna(0)\nkh=BanHang_KhachHang.set_index('Customer ID')['Hạng']\nh['g']=h['Mã KH mua'].map(kh)\nRESULT=f\"{round(h[h.g=='thân thiết'].rev.sum()/h.rev.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ff00298626b6", "type": "number", "answer": 363, "_code": "\nh=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh['t']=pd.to_datetime(h['Giờ tạo đơn'])\nh=h[(h.t>='2025-06-16')&(h.t<'2025-06-23')&(~h['Trạng thái'].isin(['Không giao được','Đổi trả']))]\nRESULT=int(((h.t.dt.hour>=14)&(h.t.dt.hour<22)).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ea67d16ae4f5", "type": "number", "answer": 70, "_code": "df = SoBanHang.copy()\ndf['d'] = parse_date(df['Ngày mua'])\ndf['q'] = pd.to_numeric(df['Số lượng lẻ'].astype(str).str.replace(',', ''), errors='coerce')\ndf = df[~df['Ghi chú TT'].str.contains('hủy|huỷ|trả|cancel', case=False, na=False)]\nm = df[(df['Mặt hàng'] == 'Thép hộp 40x80 dày 1.4mm cây 6m') & (df.d.dt.year == 2025) & (df.d.dt.month == 7)]\nRESULT = int(m['q'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b4e634ae09b1", "type": "number", "answer": 1678470000, "_code": "df = SoBanHang.copy()\ndf['d'] = parse_date(df['Ngày tháng'])\ndf['amt'] = pd.to_numeric(df['Thành tiền (đ)'].astype(str).str.replace(r'[^\\d]', '', regex=True), errors='coerce')\ndf = df[~df['Trạng thái đơn'].str.contains('hủy|huỷ|trả|cancel', case=False, na=False)]\nm = df[(df.d >= '2025-04-01') & (df.d <= '2025-06-30')]\nRESULT = int(m['amt'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b276ba56b8b1", "type": "percent", "answer": -2.05, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\nx=DonHang_ChiTiet__all.copy()\nx['dt']=pd.to_datetime(x['Ngày đặt hàng'],format='%d/%m/%Y',errors='coerce')\nx['amt']=x['Tổng tiền'].map(money)\nx=x[~x['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\ndef rev(y,m): return x[(x.dt.dt.year==y)&(x.dt.dt.month==m)].amt.sum()\na,b=rev(2026,3),rev(2025,3)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b7648884bd88", "type": "number", "answer": 7500, "_code": "import re as _re\ndef money(x):\n    s=str(x).strip().lower()\n    if s in ('','nan','none'): return float('nan')\n    m=_re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1_000_000+(int(f.ljust(3,'0')[:3])*1000 if f else 0)\n    m=_re.match(r'^(\\d+),(\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1_000_000)\n    m=_re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    s=_re.sub(r'[đd₫\\s]','',s)\n    if _re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if _re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\na=SoBanHang__all.drop_duplicates().copy()\na['od']=pd.to_datetime(a['Giờ'],errors='coerce').dt.normalize(); a=a[a.od.notna()].copy()\na['m']=a['Tiền'].map(money); a['p']=a['Giá'].map(money)\na['q']=a['Số lượng hàng'].astype(str).str.extract(r'(-?[\\d.]+)')[0].astype(float)\na['bad']=a['Ghi chú TT'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False)|(a.q<0)\nbadids=set(a[a.bad]['Mã phiếu'])\nf=dict(zip(DanhMuc['ĐV lớn'],DanhMuc['Hệ số QĐ']))\nx=a[(a.od=='2026-02-25')&(a['Tên SP'].str.strip().str.lower()=='ống pvc bình minh d32 cây 4m')].copy()\nx['pb']=x.apply(lambda r:r.p/(f.get(r.DonVi,1) if r.DonVi in f else 1),axis=1)\nRESULT=int(round(x.pb.iloc[0]))\n", "_attempts": 1, "_verdict": "wrong"}
{"id": "q_28beeec0f60a", "type": "percent", "answer": 0.0, "_code": "\nA=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\nA=A.drop_duplicates()\nA['Mã đơn hàng']=A['Mã đơn hàng'].ffill()\nfor k in ['Ngày','Trạng thái']: A[k]=A.groupby('Mã đơn hàng')[k].transform(lambda s:s.ffill().bfill())\nA['d']=parse_date(A['Ngày'])\nst=A['Trạng thái'].astype(str).str.lower()\nA=A[~st.str.contains('hủy|huỷ|cancel|trả')]\nm=A[A['Tên hàng hóa'].str.contains('Má heo nướng nước mắm')]\nq=pd.to_numeric(m['Số lượng quy đổi'],errors='coerce')\nD0=pd.Timestamp('2026-06-04')\na=q[(m.d>=D0)&(m.d<D0+pd.Timedelta(days=7))].sum(); b=q[(m.d>=D0-pd.Timedelta(days=7))&(m.d<D0)].sum()\nRESULT=f'{round((a-b)/b*100,2)}%'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b0755b511c52", "type": "percent", "answer": 1.22, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nA=DonHang_ChiTiet.copy()\nhh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nA[hh]=A[hh].ffill(); A=A.drop_duplicates()\nA['d']=pdate(A['Ngày đặt hàng']); A['v']=money(A['Tổng tiền'])\nallo=A.drop_duplicates('Mã đơn hàng')\nok=A[~A['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\ndef rv(s,e): return ok[(ok.d>=s)&(ok.d<=e)]\ndef cr(s,e):\n    o=allo[(allo.d>=s)&(allo.d<=e)]\n    return f\"{o['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False).sum()/len(o)*100:.2f}%\"\nRESULT=cr('2026-03-01','2026-03-31')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_67297f4bdfc2", "type": "percent", "answer": 0.98, "_code": "d=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nd=d.dropna(subset=['Mã đơn hàng']).drop_duplicates('Mã đơn hàng').reset_index(drop=True)\ndt=parse_date(d['Ngày đặt hàng'])\nd=d[(dt>='2026-03-01')&(dt<='2026-03-31')]\nRESULT=f\"{d['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False).sum()/len(d)*100:.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_1a26a64abb5c", "type": "percent", "answer": 8.2, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nA=DonHang_ChiTiet.copy()\nhh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nA[hh]=A[hh].ffill(); A=A.drop_duplicates()\nA['d']=pdate(A['Ngày đặt hàng']); A['v']=money(A['Tổng tiền'])\nallo=A.drop_duplicates('Mã đơn hàng')\nok=A[~A['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\ndef rv(s,e): return ok[(ok.d>=s)&(ok.d<=e)]\ndef cr(s,e):\n    o=allo[(allo.d>=s)&(allo.d<=e)]\n    return f\"{o['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False).sum()/len(o)*100:.2f}%\"\na=rv('2026-08-01','2026-08-31').v.sum();b=rv('2025-08-01','2025-08-31').v.sum()\nRESULT=f'{(a-b)/b*100:.2f}%'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5c5ff524d0d9", "type": "number", "answer": 8253000, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nA=DonHang_ChiTiet.copy()\nhh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nA[hh]=A[hh].ffill(); A=A.drop_duplicates()\nA['d']=pdate(A['Ngày đặt hàng']); A['v']=money(A['Tổng tiền'])\nallo=A.drop_duplicates('Mã đơn hàng')\nok=A[~A['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\ndef rv(s,e): return ok[(ok.d>=s)&(ok.d<=e)]\ndef cr(s,e):\n    o=allo[(allo.d>=s)&(allo.d<=e)]\n    return f\"{o['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False).sum()/len(o)*100:.2f}%\"\nx=DuLieuXuat__DanhSachThuoc.merge(DuLieuXuat__DanhSachSanPham[['Mã SKU','Tên sản phẩm']],on='Mã SKU')\nn=set(x[x['Hoạt chất'].str.strip()=='Povidon iod']['Tên sản phẩm'])\nRESULT=int(round(rv('2025-10-01','2025-10-31')[lambda r:r['Tên sản phẩm'].isin(n)].v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b7648884bd88", "type": "number", "answer": 75000, "_code": "import re as _re\ndef money(x):\n    s=str(x).strip().lower()\n    if s.startswith('-'): return -money(s[1:])\n    if s in ('','nan','none'): return float('nan')\n    m=_re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1_000_000+(int(f.ljust(3,'0')[:3])*1000 if f else 0)\n    m=_re.match(r'^(\\d+),(\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1_000_000)\n    m=_re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    s=_re.sub(r'[đd₫\\s]','',s)\n    if _re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if _re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\na=SoBanHang__all.drop_duplicates().copy()\na['od']=pd.to_datetime(a['Giờ'],errors='coerce').dt.normalize(); a=a[a.od.notna()].copy()\na['m']=a['Tiền'].map(money); a['p']=a['Giá'].map(money)\na['q']=a['Số lượng hàng'].astype(str).str.extract(r'(-?[\\d.]+)')[0].astype(float)\na['bad']=a['Ghi chú TT'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False)|(a.q<0)\nbadids=set(a[a.bad]['Mã phiếu'])\nf={(r['Hàng'],r['ĐV lớn']):r['Hệ số QĐ'] for _,r in DanhMuc.iterrows()}\nx=a[(a.od=='2026-02-25')&(a['Tên SP'].str.strip().str.lower()=='ống pvc bình minh d32 cây 4m')].copy()\nx['pb']=x.apply(lambda r:r.p/f.get((r['Tên SP'],r.DonVi),1),axis=1)\nRESULT=int(round(x.pb.iloc[0]))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d224682865b3", "type": "number", "answer": 109.0, "_code": "\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)\nh=h[(h.d.dt.year==2025)&(h.d.dt.month==2)&~bad]\np=DanhSachSanPham[DanhSachSanPham['Tên hàng'].str.contains('Acyclovir Stella',case=False)]\ncodes=set(p['Mã hàng'])\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])&c['Mã hàng'].isin(codes)]\nRESULT=float(to_num(c['Số lượng quy đổi']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e6dd8fd4a42a", "type": "percent", "answer": 13.95, "_code": "\nX=DonHang_ChiTiet.copy()\nfor k in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: X[k]=X[k].ffill()\nX=X.drop_duplicates()\nX['d']=parse_date(X['Ngày đặt hàng'])\nst=X['Trạng thái đơn hàng'].astype(str).str.lower()\nX=X[~st.str.contains('hủy|huỷ|cancel|trả|hoàn hàng')]\nm=X[X['Tên sản phẩm'].astype(str).str.lower().str.contains('pharmaton essential')]\nq=pd.to_numeric(m['Số lượng sản phẩm'],errors='coerce')\nD0=pd.Timestamp('2025-05-20')\na=q[(m.d>=D0)&(m.d<D0+pd.Timedelta(days=30))].sum(); b=q[(m.d>=D0-pd.Timedelta(days=30))&(m.d<D0)].sum()\nRESULT=f'{round((a-b)/b*100,2)}%'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4726d037f8a8", "type": "percent", "answer": 14.4, "_code": "import re as _re\ndef money(x):\n    s=str(x).strip().lower()\n    if s.startswith('-'): return -money(s[1:])\n    if s in ('','nan','none'): return float('nan')\n    m=_re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1_000_000+(int(f.ljust(3,'0')[:3])*1000 if f else 0)\n    m=_re.match(r'^(\\d+),(\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1_000_000)\n    m=_re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    s=_re.sub(r'[đd₫\\s]','',s)\n    if _re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if _re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\na=SoBanHang__all.drop_duplicates().copy()\na['od']=pd.to_datetime(a['Giờ'],errors='coerce').dt.normalize(); a=a[a.od.notna()].copy()\na['m']=a['Tiền'].map(money); a['p']=a['Giá'].map(money)\na['q']=a['Số lượng hàng'].astype(str).str.extract(r'(-?[\\d.]+)')[0].astype(float)\na['bad']=a['Ghi chú TT'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False)|(a.q<0)\nbadids=set(a[a.bad]['Mã phiếu'])\ng=a[~a['Mã phiếu'].isin(badids)]\nr=lambda s,e:g[(g.od>=s)&(g.od<=e)].m.sum()\nRESULT=f\"{round((r('2026-03-01','2026-03-20')/r('2026-02-01','2026-02-20')-1)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b3b45f9adceb", "type": "number", "answer": 456544000, "_code": "d=danh_sach_hoa_don.dropna(subset=['Mã bill']).drop_duplicates('Mã bill').copy()\ndt=parse_date(d['Ngày giao dịch'])\nd=d[(dt>='2025-07-01')&(dt<='2025-09-30')]\nd=d[~d['Status'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nRESULT=int(to_num(d['Tien hang']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a6230fde4c15", "type": "number", "answer": 56, "_code": "d=don_hang.drop_duplicates('Số phiếu').copy()\ndt=parse_date(d['Ngày bán'])\nd=d[(dt=='2025-06-10')]\nd=d[d['Tình trạng đơn'].isin(['completed','shipping'])]\nRESULT=len(d)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c2ce1b9ec2df", "type": "percent", "answer": 3.25, "_code": "\nd=DonHang_ChiTiet__all.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[oc]=d[oc].ffill()\nd=d.drop_duplicates()\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[d['Tên sản phẩm'].str.contains('Aquafina 500',case=False,na=False)].copy()\nd['q']=d['Số lượng sản phẩm'].astype(str).str.extract(r'([\\d.]+)')[0].astype(float)\nf={'chai':1,'lốc':6,'thùng':24}\nd['q']=d.q*d['Đơn vị tính'].map(f)\nD=pd.Timestamp('2025-05-07')\na=d[(d.dt>=D)&(d.dt<D+pd.Timedelta(days=14))].q.sum()\nb=d[(d.dt>=D-pd.Timedelta(days=14))&(d.dt<D)].q.sum()\nRESULT=f\"{round((a/b-1)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ffcb6868973c", "type": "percent", "answer": 149.43, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nA=DonHang_ChiTiet.copy()\nhh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nA[hh]=A[hh].ffill(); A=A.drop_duplicates()\nA['d']=pdate(A['Ngày đặt hàng']); A['v']=money(A['Tổng tiền'])\nallo=A.drop_duplicates('Mã đơn hàng')\nok=A[~A['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\ndef rv(s,e): return ok[(ok.d>=s)&(ok.d<=e)]\ndef cr(s,e):\n    o=allo[(allo.d>=s)&(allo.d<=e)]\n    return f\"{o['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False).sum()/len(o)*100:.2f}%\"\nqd=DuLieuXuat__DanhSachQuyDoi\nqd=qd[qd['Tên sản phẩm']=='Strepsils Cool hộp 2 vỉ x 12 viên'].set_index('Đơn vị quy đổi')['Tỉ lệ quy đổi'].astype(float).to_dict()\np=ok[ok['Tên sản phẩm']=='Strepsils Cool hộp 2 vỉ x 12 viên'].copy()\np['q']=to_num(p['Số lượng sản phẩm'])*p['Đơn vị tính'].map(lambda u:qd.get(u,1))\nD=pd.Timestamp('2026-07-24')\nn=p[(p.d>=D)&(p.d<=D+pd.Timedelta(days=6))].q.sum();o=p[(p.d>=D-pd.Timedelta(days=7))&(p.d<D)].q.sum()\nRESULT=f'{(n-o)/o*100:.2f}%'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d0029ba2be47", "type": "number", "answer": 2575300, "_code": "import re\ndef mny(s):\n    s=str(s).strip().lower().replace(\"đ\",\"\").replace(\" \",\"\")\n    if s in (\"\",\"nan\",\"none\"): return float(\"nan\")\n    m=re.fullmatch(r\"(\\d+)tr(\\d*)\",s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,\"0\")[:3])*1000 if f else 0) if len(f)<=3 else float(\"nan\")\n    m=re.fullmatch(r\"([\\d.,]+)tr\",s)\n    if m: return round(float(m.group(1).replace(\",\",\".\"))*1e6)\n    m=re.fullmatch(r\"([\\d.,]+)k\",s)\n    if m: return round(float(m.group(1).replace(\",\",\".\"))*1000)\n    if re.fullmatch(r\"\\d+[.,]\\d{1,2}0*\",s) and not re.fullmatch(r\"\\d{1,3}([.,]\\d{3})+\",s): return round(float(s.replace(\",\",\".\")))\n    return float(re.sub(r\"[^\\d]\",\"\",s))\n\nd=DonHang_ChiTiet_1__all.copy()\nhc=[\"Mã đơn hàng\",\"Ngày đặt hàng\",\"Trạng thái đơn hàng\",\"Tên khách hàng\"]\nd[hc]=d[hc].ffill(); d=d.drop_duplicates()\nd[\"od\"]=parse_date(d[\"Ngày đặt hàng\"]); d[\"a\"]=d[\"Tổng tiền\"].map(mny)\nok=d[~d[\"Trạng thái đơn hàng\"].str.contains(\"hủy|huỷ|hoàn hàng|trả\",case=False,na=False)]\nth=DanhSachThuoc.merge(DanhSachSanPham[[\"Mã SKU\",\"Tên sản phẩm\"]],on=\"Mã SKU\")\nnames=th[th[\"Hoạt chất\"].str.strip().str.lower()==\"loratadin\"][\"Tên sản phẩm\"].str.lower().str.strip()\nt=ok[(ok.od>=\"2025-01-01\")&(ok.od<=\"2025-01-31\")&ok[\"Tên sản phẩm\"].str.lower().str.strip().isin(names)]\nprint(list(names))\nRESULT=int(round(t.a.sum()))\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_f1f68541c1b6", "type": "percent", "answer": -10.35, "_code": "hc = [\"Mã đơn hàng\", \"Ngày đặt hàng\", \"Trạng thái đơn hàng\", \"Tên khách hàng\"]\nparts = []\nfor t in (DonHang_ChiTiet_1__all, DonHang_ChiTiet_2026__all):\n    t = t.copy()\n    t[hc] = t[hc].ffill()\n    parts.append(t)\ndf = pd.concat(parts, ignore_index=True).drop_duplicates()\ndf[\"d\"] = parse_date(df[\"Ngày đặt hàng\"])\ndef pm(x):\n    s = str(x).strip().lower().replace(\"đ\", \"\")\n    if s.endswith(\"k\"):\n        return float(s[:-1]) * 1000\n    return float(__import__(\"re\").sub(r\"[^\\d]\", \"\", s) or \"nan\")\ndf[\"amt\"] = df[\"Tổng tiền\"].map(pm)\nst = df.groupby(\"Mã đơn hàng\")[\"Trạng thái đơn hàng\"].agg(lambda s: \" \".join(s.dropna().astype(str).unique()))\ncancel = st.str.contains(\"hủy|huỷ\", case=False)\nret = st.str.contains(\"hoàn hàng|trả\", case=False)\norders = df.groupby(\"Mã đơn hàng\")[\"d\"].first()\nok = df[~df[\"Mã đơn hàng\"].map(cancel | ret)]\ndef rev(y, m):\n    return ok[(ok.d.dt.year == y) & (ok.d.dt.month == m)][\"amt\"].sum()\ncur, prev = rev(2025, 8), rev(2025, 7)\nRESULT = f\"{round((cur - prev) / prev * 100, 2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_970f01ac7cec", "type": "percent", "answer": -2.37, "_code": "import re as _re\ndef money(s):\n    if s is None or (isinstance(s,float) and s!=s): return float('nan')\n    if isinstance(s,(int,float)): return float(s)\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if not s: return float('nan')\n    try:\n        if 'tr' in s:\n            a,b=s.split('tr',1)\n            a=a or '0'\n            if b=='': return float(a.replace(',','.'))*1e6\n            return int(a.replace('.','').replace(',',''))*1e6+int(b.ljust(3,'0')[:3])*1e3\n        if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n        if ',' in s and '.' in s:\n            return float(s.replace(',','')) if s.rfind('.')>s.rfind(',') else float(s.replace('.','').replace(',','.'))\n        if '.' in s:\n            return float(s.replace('.','')) if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s) else float(s)\n        if ',' in s:\n            return float(s.replace(',','')) if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+',s) else float(s.replace(',','.'))\n        return float(s)\n    except Exception: return float('nan')\nd=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày']); d['v']=d['Thành tiền'].map(money)\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được|hoàn hàng',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\ndef rev(y,m):\n    x=d[(d.dt.dt.year==y)&(d.dt.dt.month==m)]; return x['v'].sum()\na,b=rev(2026,1),rev(2025,12)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b8d464f6322a", "type": "number", "answer": 3263168800, "_code": "import re as _re\ndef money(s):\n    if s is None or (isinstance(s,float) and s!=s): return float('nan')\n    if isinstance(s,(int,float)): return float(s)\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if not s: return float('nan')\n    try:\n        if 'tr' in s:\n            a,b=s.split('tr',1)\n            a=a or '0'\n            if b=='': return float(a.replace(',','.'))*1e6\n            return int(a.replace('.','').replace(',',''))*1e6+int(b.ljust(3,'0')[:3])*1e3\n        if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n        if ',' in s and '.' in s:\n            return float(s.replace(',','')) if s.rfind('.')>s.rfind(',') else float(s.replace('.','').replace(',','.'))\n        if '.' in s:\n            return float(s.replace('.','')) if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s) else float(s)\n        if ',' in s:\n            return float(s.replace(',','')) if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+',s) else float(s.replace(',','.'))\n        return float(s)\n    except Exception: return float('nan')\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày']); d['v']=d['Thành tiền'].map(money)\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được|hoàn hàng',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nx=d[(d.dt.dt.year==2025)&(d.dt.dt.month.isin([10,11,12]))]\nRESULT=int(round(x['v'].sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2e1db198f5e4", "type": "number", "answer": 10889000, "_code": "\nX=SoBanHang.copy()\nX['d']=parse_date(X['Ngày tháng'])\nst=X['Trạng thái đơn'].astype(str).str.lower()\nX=X[~st.str.contains('hủy|huỷ|cancel|trả')]\namt=pd.to_numeric(X['Thành tiền (đ)'].astype(str).str.replace(r'\\D','',regex=True),errors='coerce')\nday=pd.Timestamp(as_of_date)-pd.Timedelta(days=1)\nRESULT=int(amt[X.d==day].sum())\n", "_attempts": 1, "_verdict": "correct"}
