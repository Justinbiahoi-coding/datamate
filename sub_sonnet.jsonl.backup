{"id": "q_d9602cf5da8d", "type": "date", "answer": "2025-08-18", "_code": "h=DanhSachHoaDon.copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[(h.d>='2025-08-01')&(h.d<'2025-09-01')&~h['Trạng thái'].isin(['Đã hủy','Đã trả hàng'])]\ns=h.assign(v=to_num(h['Tổng tiền hàng'])).groupby('d')['v'].sum()\nRESULT=s.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_cff4d074d1f3", "type": "list", "answer": [2800, 1866], "_code": "def money(x):\n    s=str(x).strip().lower().replace('đ','')\n    if s in ('','nan'): return 0.0\n    if s.endswith('tr'): return float(s[:-2].replace(',','.'))*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','').replace('.',''))*1e3\n    return float(s.replace(',','').replace('.',''))\nk=BanHang_KhachHang\ncodes=k[k['ten_kh'].str.lower().str.contains('nghiêm mai hiếu')]['Customer ID'].tolist()\nh=BanHang_HoaDon.copy()\nh['dt']=pd.to_datetime(h['Giờ tạo đơn'])\nh=h[h['Mã KH mua'].isin(codes)&(h['Phương thức TT']=='Ghi nợ')&(h['Trạng thái']!='Không giao được')]\np=BanHang_PhieuThu.copy(); p['t']=pd.to_datetime(p['Thời gian thu']); p['v']=p['Số tiền thu'].map(money)\np=p.merge(h[['Order ID','dt']],left_on='Mã bill',right_on='Order ID')\nsame=p[p.t.dt.date==p.dt.dt.date].groupby('Order ID')['v'].sum()\nhm=h[(h.dt>='2025-01-01')&(h.dt<'2025-02-01')]\nadd=sum(max(money(r['Tong tien'])-same.get(r['Order ID'],0),0) for _,r in hm.iterrows())\npaid=p[(p.t.dt.date>p.dt.dt.date)&(p.t>='2025-01-01')&(p.t<'2025-02-01')]['v'].sum()\nRESULT=[round(add),round(paid)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9af38217de13", "type": "number", "answer": 2539, "_code": "df=So_chi_tiet_ban_hang__all.copy()\ndf['d']=parse_date(df['Ngày'])\ndf=df[(df.d>='2025-07-01')&(df.d<'2025-10-01')&df['Trạng thái'].isin(['Đã hoàn thành','Đang giao hàng'])]\nRESULT=int(df['Mã đơn hàng'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d0d679c2a0c4", "type": "percent", "answer": -18.52, "_code": "h=DanhSachHoaDon.copy()\nh['t']=pd.to_datetime(h['Thời gian tạo'])\nh=h[(h.t>='2025-09-01')&(h.t<'2025-10-01')&h['Trạng thái'].isin(['Hoàn thành','xong','Đang giao dịch'])]\nh=h.drop_duplicates('Mã hóa đơn')\nm=h[(h.t.dt.hour>=6)&(h.t.dt.hour<14)]; c=h[(h.t.dt.hour>=14)&(h.t.dt.hour<22)]\nRESULT=f\"{round((len(c)-len(m))/len(m)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6f8eccba94c3", "type": "string", "answer": "Costar Omega 3 1000mg lọ 100 viên", "_code": "o=don_hang[don_hang['TinhTrang'].isin(['completed','shipping'])]\no=o[(pd.to_datetime(o['ThoiGianLap'])>='2026-01-01')&(pd.to_datetime(o['ThoiGianLap'])<'2026-02-01')]\nd=chi_tiet_don[chi_tiet_don['MaHoaDon'].isin(o['MaHoaDon'])].copy()\nd['p']=pd.to_numeric(d['TriGia'])-pd.to_numeric(d['SL'])*pd.to_numeric(d['GiaVonLucBan'])\ns=d.groupby('MaHangHoa')['p'].sum()\nRESULT=san_pham.set_index('MaHangHoa')['TenGoi'][s.idxmax()]\n", "_attempts": 1, "_verdict": "correct"}
