{"id": "q_252acdcf54fb", "type": "string", "answer": "Cty Chung Khoa", "_code": "\np=data['phieu_nhap'].copy()\np['d']=pd.to_datetime(p['NgayNhapKho'],errors='coerce')\np=p[(p.d.dt.year==2025)&(p.d.dt.month==1)&(~p['TinhTrang'].astype(str).str.contains('cancel',case=False))]\ns=p.groupby('MaNhaCungCap')['TongGiaTriNhap'].sum().sort_values(ascending=False)\nncc=data['nha_cung_cap'].set_index('MaNhaCungCap')['TenGoi']\nRESULT=ncc[s.index[0]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3db974fe3641", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Hoàng Ngọc Ngọc", 435734], ["Lê Giang Hiếu", 97000], ["Đặng Hải Đức", 90800]]}, "_code": "\no=data['don_hang'].copy()\no=o[(o.TinhTrang!='cancelled')&(o.PhuongThucTT!='cod')&o.MaKhachHang.notna()]\no['dt']=pd.to_datetime(o['ThoiGianLap'])\no=o[o.dt<=pd.Timestamp(as_of_date)+pd.Timedelta(days=1)-pd.Timedelta(seconds=1)]\nt=data['thanh_toan'].copy()\nt['dt']=pd.to_datetime(t['NgayGioThu'])\nt=t[t.dt<pd.Timestamp(as_of_date)+pd.Timedelta(days=1)]\npaid=t.groupby('MaHoaDon')['SoTienThu'].sum()\no['owe']=o['TongThanhToan']-o['MaHoaDon'].map(paid).fillna(0)\no=o[o.owe>0]\ns=o.groupby('MaKhachHang')['owe'].sum().sort_values(ascending=False).head(3)\nnm=data['khach_hang'].set_index('MaKhachHang')['TenGoi']\nRESULT={\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[nm[k],int(v)] for k,v in s.items()]}\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e16f85baa118", "type": "date", "answer": "2025-10-11", "_code": "d=DonHang_ChiTiet.copy()\nd=d[~d['Tên khách hàng'].astype(str).str.startswith('Tổng ngày')&d['Mã đơn hàng'].notna()].drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd['m']=to_num(d['Tổng tiền'])\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nx=d[(d.dt>='2025-10-01')&(d.dt<'2025-11-01')]\nRESULT=str(x.groupby('dt').m.sum().idxmax().date())\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_a383091ec4c7", "type": "percent", "answer": -4.62, "_code": "d=DonHang_ChiTiet.copy()\nd=d[~d['Tên khách hàng'].astype(str).str.startswith('Tổng ngày')&d['Mã đơn hàng'].notna()].drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd['m']=to_num(d['Tổng tiền'])\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\na=d[(d.dt>='2025-06-01')&(d.dt<'2025-07-01')].m.sum(); b=d[(d.dt>='2025-05-01')&(d.dt<'2025-06-01')].m.sum()\nRESULT=f'{round((a-b)/b*100,2):.2f}%'\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_1837da83c4a5", "type": "string", "answer": "Tạ Quang Khánh", "_code": "h = DanhSachHoaDon__all.copy()\nh['d'] = parse_date(h['Thời gian'])\nh = h[(h.d.dt.year==2026)&(h.d.dt.month==1)]\nh = h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|Đổi trả', case=False, na=False)]\nh = h[h['Mã KH'].notna()]\nh['v'] = to_num(h['Tổng tiền hàng'])\nmk = h.groupby('Mã KH')['v'].sum().idxmax()\nRESULT = h[h['Mã KH']==mk]['Khách hàng'].iloc[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ea094bdb2c13", "type": "number", "answer": 6093000, "_code": "d=danh_sach_hoa_don.drop_duplicates('Mã bill').copy()\nd['dt']=parse_date(d['Ngày giao dịch']); d['amt']=to_num(d['Tien hang'])\nd=d[d['Status'].isin(['Hoàn thành','Chờ giao'])]\nRESULT=int(d[d.dt==pd.Timestamp(as_of_date)].amt.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bd7f91b76149", "type": "list", "answer": ["Xi măng Hà Tiên PCB40 bao 50kg", "Xi măng INSEE Power-S bao 50kg", "Gạch ống 8x8x18 Tuynel", "Thép cuộn phi 6 Hòa Phát", "Băng keo điện Nano 20 yard"], "_code": "s=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].copy(); s['t']=parse_date(s['Ngày'])\nprint(s['Trạng thái'].unique(), s.columns.tolist())\nbad=set(s[~s['Trạng thái'].isin(['ok','Thành công','Đang vận chuyển'])]['Mã đơn hàng'])\ns=s[~s['Mã đơn hàng'].isin(bad)&(s.t>='2025-06-01')&(s.t<='2025-06-30')]\nRESULT=list(s.groupby('Tên hàng hóa')['Số lượng quy đổi'].apply(lambda x:to_num(x).sum()).sort_values(ascending=False).head(5).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_15d171d26f64", "type": "date", "answer": "2025-04-30", "_code": "h = DanhSachHoaDon.copy()\nh['d'] = parse_date(h['Thời gian'])\nh = h[(h.d.dt.year==2025)&(h.d.dt.month==4)]\nh = h[~h['Trạng thái'].str.contains('hủy|huỷ|trả', case=False, na=False)]\nh['v'] = to_num(h['Tổng tiền hàng'])\nRESULT = h.groupby('d')['v'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a85de15d7f73", "type": "number", "answer": 168218, "_code": "h = DanhSachHoaDon.copy()\nh['d'] = parse_date(h['Thời gian'])\nh = h[(h.d.dt.year==2025)&(h.d.dt.month==9)]\nh = h[~h['Trạng thái'].str.contains('hủy|huỷ|trả', case=False, na=False)]\nh['v'] = to_num(h['Tổng tiền hàng'])\nimport math\nRESULT = int(math.floor(h['v'].sum()/len(h) + 0.5))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e9930d87abdd", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Chung Linh Hương", 1329000], ["Tạ Hoa Lan", 1279000], ["Hà Ngọc Phương", 1264100], ["Dương Ngân Khánh", 1112700], ["Quách Thảo Mai", 813200]]}, "_code": "\nh=data['DuLieuBanHang']['DanhSachHoaDon'].copy()\nh['d']=parse_date(h['Thời gian'])\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)\ndet=data['DanhSachHoaDonChiTiet'].drop_duplicates(['Mã hóa đơn','STT']).copy()\ndet['amt']=to_num(det['Thành tiền'])\nh['rev']=h['Mã hóa đơn'].map(det.groupby('Mã hóa đơn')['amt'].sum()).fillna(0)\nok=h[~bad]\n\ng=h[~h['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)&(h['Phương thức thanh toán']!='Thu hộ (COD)')&h['Mã KH'].notna()].copy()\ng=g[g.d<=pd.Timestamp(as_of_date)]\nsq=data['DuLieuBanHang']['SoQuy'].copy(); sq['t']=pd.to_datetime(sq['Thời gian'])\nsq=sq[sq.t<pd.Timestamp(as_of_date)+pd.Timedelta(days=1)]\npaid=sq.groupby('Mã hóa đơn')['Giá trị'].sum()\ng['owe']=to_num(g['Tổng sau giảm giá'])-g['Mã hóa đơn'].map(paid).fillna(0)\ng=g[g.owe>0]\ns=g.groupby('Mã KH')['owe'].sum().sort_values(ascending=False).head(5)\nnm=data['DuLieuBanHang']['DanhSachKhachHang'].set_index('Mã khách hàng')['Tên khách hàng']\nRESULT={\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[nm[k],int(round(v))] for k,v in s.items()]}\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a1032633892d", "type": "boolean", "answer": false, "_code": "\nh=data['DuLieuBanHang']['DanhSachHoaDon'].copy()\nh['d']=parse_date(h['Thời gian'])\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)\ndet=data['DanhSachHoaDonChiTiet'].drop_duplicates(['Mã hóa đơn','STT']).copy()\ndet['amt']=to_num(det['Thành tiền'])\nh['rev']=h['Mã hóa đơn'].map(det.groupby('Mã hóa đơn')['amt'].sum()).fillna(0)\nok=h[~bad]\n\nv=[ok[(ok.d.dt.year==2026)&(ok.d.dt.month==m)].rev.sum() for m in (2,3,4)]\nRESULT=bool(v[0]<v[1]<v[2])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_16837dc57683", "type": "percent", "answer": 62.05, "_code": "\nh=data['DuLieuBanHang']['DanhSachHoaDon'].copy()\nh['d']=parse_date(h['Thời gian'])\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)\ndet=data['DanhSachHoaDonChiTiet'].drop_duplicates(['Mã hóa đơn','STT']).copy()\ndet['amt']=to_num(det['Thành tiền'])\nh['rev']=h['Mã hóa đơn'].map(det.groupby('Mã hóa đơn')['amt'].sum()).fillna(0)\nok=h[~bad]\n\nm=ok[(ok.d.dt.year==2026)&(ok.d.dt.month==1)&ok['Mã KH'].notna()]\nc=m.groupby('Mã KH').size()\nRESULT=f\"{(c>=3).sum()/len(c)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_adfc00eae2e2", "type": "percent", "answer": 9.45, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True).drop_duplicates()\nd['dt']=parse_date(d['Ngày'])\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)&(d.dt>='2025-05-01')&(d.dt<='2025-05-31')]\nd['v']=to_num(d['Thành tiền'])\nhh=[v for k,v in globals().items() if k.startswith('Danh')][0]\ngrp=d['Tên hàng hóa'].map(hh.set_index('Tên hàng hóa')['Nhóm hàng hóa'])\nRESULT=f\"{round(d.v[grp.str.lower()=='gỏi'].sum()/d.v.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
