{"id": "q_ac8af2708410", "type": "number", "answer": 29274252, "_code": "h=DuLieuBanHang['DanhSachHoaDon'].copy()\nprint(h['Phương thức thanh toán'].value_counts().to_dict(), h['Trạng thái'].value_counts().to_dict())\nh['od']=parse_date(h['Thời gian'])\nh=h[(h['Phương thức thanh toán']=='Ghi nợ')&~h['Trạng thái'].astype(str).str.contains('hủy|huỷ',case=False)]\nq=DuLieuBanHang['SoQuy'].copy()\nq['pd']=pd.to_datetime(q['Thời gian'])\nm=q.merge(h[['Mã hóa đơn','od']],on='Mã hóa đơn')\nm=m[(m['pd'].dt.normalize()>m['od'])&(m['pd']>='2025-07-01')&(m['pd']<'2025-08-01')]\nRESULT=int(to_num(m['Giá trị']).sum())\n", "_attempts": 1, "_verdict": "correct"}
