{"id": "q_4b46c3ac2b47", "type": "percent", "answer": -8.26, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d+\\.\\d{1,2}',s) and False: v=float(s)\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\ndef qty(x):\n    if isinstance(x,(int,float)): return float(x)\n    return float(re.match(r'-?[\\d\\.]+',str(x).strip()).group(0))\nimport sys\no=don_hang.drop_duplicates('Số phiếu'); print(o['Tình trạng đơn'].value_counts(),file=sys.stderr)\nc=chi_tiet_don.drop_duplicates()\nt=c['Tiền bán'].astype(str); print(t[~t.str.match(r'^[\\d\\.]+đ$')].sample(8,random_state=1).tolist(),file=sys.stderr)\nd=parse_date(o['Ngày bán'])\nokd=o[~o['Tình trạng đơn'].str.contains('cancel|return|hủy|huỷ',case=False,na=False)]\ndd=parse_date(okd['Ngày bán'])\nv=c['Tiền bán'].map(money)\ndef rev(a,b):\n    ids=set(okd[(dd>=a)&(dd<=b)]['Số phiếu']); return v[c['Số CT'].isin(ids)].sum()\nn=rev('2025-06-01','2025-06-30'); p=rev('2025-05-01','2025-05-31')\nRESULT=f\"{round((n-p)/p*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0bf48a939a7e", "type": "percent", "answer": 25.55, "_code": "o=DuLieuBanHang['DanhSachHoaDon'].drop_duplicates().copy()\no['t']=pd.to_datetime(o['Thời gian tạo'],errors='coerce')\no['d']=parse_date(o['Thời gian'])\no=o[(o.d.dt.year==2025)&(o.d.dt.month==5)&~o['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates(); c=c[c['Mã hóa đơn'].isin(o['Mã hóa đơn'])].copy()\nc['amt']=to_num(c['Thành tiền'].astype(str).str.replace(r'\\.0+$','',regex=True))\na=c.groupby('Mã hóa đơn').amt.sum()\no['amt']=o['Mã hóa đơn'].map(a).fillna(0)\nsa=o[(o.t.dt.hour>=6)&(o.t.dt.hour<=13)].amt.sum(); ch=o[(o.t.dt.hour>=14)&(o.t.dt.hour<=21)].amt.sum()\nRESULT=f\"{(ch-sa)/sa*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ecda32daaef2", "type": "percent", "answer": 4.85, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s.startswith('-'): return -money(s[1:])\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        a,b=m.groups(); return int(a)*1000000+(int(b)*10**(6-len(b)) if b else 0)\n    m=re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return int(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\nh=DanhSachHoaDon.drop_duplicates().drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[(h['d']>='2026-03-01')&(h['d']<='2026-03-31')&~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['v']=c['Thành tiền'].map(money)\ng=DanhSachSanPham.set_index('Mã hàng')['Nhóm hàng(3 Cấp)']\nc['g']=c['Mã hàng'].map(g)\nRESULT=f\"{round(c[c['g'].astype(str).str.strip().str.lower()=='bánh kẹo']['v'].sum()/c['v'].sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3fe3f0931b71", "type": "percent", "answer": 171.43, "_code": "c0='SP0061'\no=don_hang.drop_duplicates('MaHoaDon')\no=o[~o['TinhTrang'].isin(['cancelled','returned'])]\nd=parse_date(o['NgayLap']); o=o.assign(d=d)\nl=chi_tiet_don.drop_duplicates(); l=l[l['MaHangHoa']==c0].merge(o[['MaHoaDon','d']],on='MaHoaDon')\nD=pd.Timestamp('2025-11-20'); w=pd.Timedelta(days=14)\na=l[(l.d>=D)&(l.d<D+w)]['SLQuyDoi'].sum(); b=l[(l.d>=D-w)&(l.d<D)]['SLQuyDoi'].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_00e9f0bed567", "type": "percent", "answer": 5.27, "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)[.,]?(\\d*)tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if c: return float(a)*1e6+float(c)*10**(6-len(c))\n        return float(a+'.'+(b or '0'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m:\n        t=m.group(1)\n        return float(t.replace('.','').replace(',',''))*1000 if re.search(r'[.,]\\d{3}$',t) else float(t.replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\nd=DuLieuBanHang['DanhSachHoaDon'].copy(); d['dt']=pd.to_datetime(d['Thời gian tạo'].astype(str).str[:10])\nok=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)&(d.dt>='2025-01-01')&(d.dt<='2025-01-31')]\nc=DanhSachHoaDonChiTiet.drop_duplicates().merge(ok[['Mã hóa đơn','Kênh bán']],on='Mã hóa đơn')\nc['v']=c['Thành tiền'].apply(money)\nRESULT=f\"{round(c[c['Kênh bán']=='phone'].v.sum()/c.v.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8949c93343e6", "type": "number", "answer": 53, "_code": "d=don_hang.drop_duplicates().copy(); d['dt']=parse_date(d['Ngày bán'])\nd=d[(d.dt=='2025-02-20')&d['Tình trạng đơn'].isin(['completed','shipping'])]\nlon=set(san_pham.loc[san_pham['Đơn vị tính']=='lon','Mã HH'])\nc=chi_tiet_don.drop_duplicates(); c=c[c['Số CT'].isin(d['Số phiếu'])&c['Mã hàng bán'].isin(lon)]\nRESULT=int(to_num(c['Quy ra ĐV lẻ']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a1aa3adfb66b", "type": "percent", "answer": -2.17, "_code": "import re\ndef _m(v):\n    if pd.isna(v): return float('nan')\n    s=str(v).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n    if s=='' : return float('nan')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m:\n        f=m.group(3); return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(f.ljust(3,'0')[:3])*1e3 if f else 0)) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'(-?)(\\d+)[,.](\\d+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2)+'.'+m.group(3))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\ndef money(series): return series.map(_m)\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd=d.assign(dt=parse_date(d['Ngày đặt hàng']),v=money(d['Tổng tiền']))\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng',case=False)]['Mã đơn hàng']\nd=d[~d['Mã đơn hàng'].isin(bad)]\ndef rev(a,b): return d[(d.dt>=a)&(d.dt<=b)].v.sum()\nx=rev('2025-11-01','2025-11-27'); y=rev('2025-10-01','2025-10-27')\nRESULT=f\"{round((x-y)/y*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e70b94b4c13d", "type": "number", "answer": 2099412000.0, "_code": "s=ban_hang.drop_duplicates().copy()\ns['d']=parse_date(s['Ngày bán'])\nbad=s[s['Trạng thái xử lý'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]['Số phiếu'].unique()\ns=s[~s['Số phiếu'].isin(bad)&(s.d>='2025-10-01')&(s.d<='2025-12-31')]\nRESULT=float(to_num(s['Amount'].astype(str).str.replace(r'\\.0+$','',regex=True)).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b946dc6e9f2d", "type": "percent", "answer": 26.48, "_code": "import sys\nh=DuLieuBanHang['DanhSachHoaDon'].drop_duplicates('Mã hóa đơn'); sp=DuLieuBanHang['DanhSachSanPham']\nprint(h['Trạng thái'].value_counts(),sp['Nhóm hàng(3 Cấp)'].unique(),file=sys.stderr)\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nd=parse_date(h['Thời gian'])\nids=set(h[(d>='2026-03-01')&(d<='2026-03-31')&~h['Trạng thái'].str.contains('hủy|huỷ|trả|cancel|return',case=False,na=False)]['Mã hóa đơn'])\nc=c[c['Mã hóa đơn'].isin(ids)].merge(sp[['Mã hàng','Nhóm hàng(3 Cấp)']],on='Mã hàng',how='left')\nt=to_num(c['Thành tiền'])\nRESULT=f\"{round(t[c['Nhóm hàng(3 Cấp)']=='gia vị'].sum()/t.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fe005c16981b", "type": "number", "answer": 20000, "_code": "import re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s.startswith('-'): return -money(s[1:])\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        a,b=m.groups(); return int(a)*1000000+(int(b)*10**(6-len(b)) if b else 0)\n    m=re.match(r'^(\\d+)k$',s)\n    if m: return int(m.group(1))*1000\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return int(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hàng']=='SP0019'].merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\nc=c[c['d']=='2026-05-01']\np=(c['Đơn giá'].map(money)/pd.to_numeric(c['Số lượng quy đổi'])*pd.to_numeric(c['Số lượng']))\nRESULT=int(p.mode().iloc[0])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bf329c45fda4", "type": "percent", "answer": 33.79, "_code": "import unicodedata\nd=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\no=d[['Mã đơn hàng','dt','Trạng thái đơn hàng','Tên khách hàng']].drop_duplicates('Mã đơn hàng')\no=o[(o.dt>='2026-02-01')&(o.dt<='2026-02-28')&o['Trạng thái đơn hàng'].isin(['đã lấy','Thành công','Đang giao dịch'])]\nnm=lambda s:' '.join(unicodedata.normalize('NFC',str(s)).lower().split())\no['k']=o['Tên khách hàng'].map(nm)\no=o[o.k!='khách lẻ']\nv=o.k.value_counts()\nRESULT=str(round((v>=6).sum()/len(v)*100,2))+'%'\n", "_attempts": 1, "_verdict": "correct"}
