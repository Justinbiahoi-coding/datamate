{"id": "q_d012427bf858", "type": "date", "answer": "2025-11-15", "_code": "def money(s):\n    s=s.astype(str).str.replace('đ','',regex=False).str.strip()\n    s=s.str.replace(r'[.,](?=\\d{3}(\\D|$))','',regex=True)\n    return pd.to_numeric(s,errors='coerce')\nh=don_hang.copy()\nh['d']=parse_date(h['Ngày bán'])\nh=h[(h['d']>='2025-11-01')&(h['d']<='2025-11-30')&h['Tình trạng đơn'].isin(['completed','shipping'])]\nl=chi_tiet_don[chi_tiet_don['Số CT'].isin(h['Số phiếu'])].copy()\nl['m']=money(l['Tiền bán'])\nl=l.merge(h[['Số phiếu','d']],left_on='Số CT',right_on='Số phiếu')\nRESULT=l.groupby('d')['m'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_48cfe79d54ec", "type": "list", "answer": [42523000, 49376000], "_code": "import re as _re\ndef money(s):\n    def f(x):\n        x=str(x).strip().lower().replace('đ','').replace(' ','')\n        m=_re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            fr=m.group(2); return int(m.group(1))*1_000_000+(int(fr.ljust(3,'0')[:3])*1000 if fr else 0)\n        m=_re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        x=_re.sub(r'[.,](?=\\d{3}(\\D|$))','',x)\n        try: return float(x)\n        except: return float('nan')\n    return s.map(f)\nh=don_hang.copy().drop_duplicates('Mã chứng từ')\nh['d']=parse_date(h['Ngày'])\nh=h[(h['d']>='2025-07-01')&(h['d']<='2025-07-31')&h['Tình trạng'].isin(['completed','shipping'])]\nl=chi_tiet_don.drop_duplicates()\nl=l[l['Mã đơn hàng'].isin(h['Mã chứng từ'])].copy()\nl['m']=money(l['Amount'])\nl=l.merge(h[['Mã chứng từ','Loại bán']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\ng=l.groupby('Loại bán')['m'].sum()\nRESULT=[int(g.get('phone',0)),int(g.get('zalo_oa',0))]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_040c9dd7f4de", "type": "list", "answer": ["Xi măng Hà Tiên PCB40 bao 50kg", "Gạch ống 8x8x18 Tuynel", "Xi măng INSEE Power-S bao 50kg", "Băng keo điện Nano 20 yard", "Thép cuộn phi 6 Hòa Phát"], "_code": "df=Bao_cao_ban_hang__So_chi_tiet_ban_hang.drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày'])\ndf=df[(df['d']>='2025-09-01')&(df['d']<='2025-09-30')]\ndf=df[~df['Trạng thái'].str.contains('hủy|huỷ|trả|không giao',case=False,na=False)]\ndf['q']=pd.to_numeric(df['Số lượng quy đổi'],errors='coerce')\nRESULT=list(df.groupby('Tên hàng hóa')['q'].sum().sort_values(ascending=False).head(5).index)\n", "_attempts": 3, "_verdict": "wrong"}
