{"id": "q_f6833cf228b3", "type": "number", "answer": 1543.0, "_code": "d=DonHang_ChiTiet.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[(d.dt>='2025-05-01')&(d.dt<='2025-05-31')]\nst=d.groupby('Mã đơn hàng')['Trạng thái đơn hàng'].transform('first')\nd=d[~st.str.contains('hủy|huỷ|hoàn hàng|trả',case=False)]\nd=d[d['Tên sản phẩm'].str.strip().str.lower().str.endswith('(l)')]\nRESULT=float(to_num(d['Số lượng sản phẩm']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_79cbacbb2121", "type": "percent", "answer": 2.6, "_code": "import re\ndef money(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    m=re.match(r'^([\\d.,]+)\\s*tr\\s*(\\d*)$',s)\n    if m:\n        a=float(m.group(1).replace(',','.')) if m.group(2)=='' else float(m.group(1))+0\n        if m.group(2)!='': return a*1e6+float(m.group(2).ljust(3,'0'))*1e3\n        return a*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^\\d{1,3}([.,]\\d{3})+$',s): return float(re.sub(r'[.,]','',s))\n    if re.match(r'^[\\d,]+\\.\\d+$',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.match(r'^[\\d.,]+$',s) else 0.0\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd['amt']=d['Tổng tiền'].map(money)\nok=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False)]\nh=ok[ok['Tên sản phẩm'].str.strip().str.lower()=='hapacol 250 hộp 24 gói'].copy()\nh['q']=h['Số lượng sản phẩm']*h['Đơn vị tính'].map(lambda u:24 if u=='hộp' else 1)\na=h[(h.dt>='2026-05-21')&(h.dt<='2026-06-03')].q.sum()\nb=h[(h.dt>='2026-05-07')&(h.dt<='2026-05-20')].q.sum()\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d0aeb0f11e7d", "type": "list", "answer": ["Panadol 500mg hộp 10 vỉ x 12 viên", "Berberin 100mg Mekophar chai 100 viên", "Amoxicillin 500mg Domesco hộp 10 vỉ x 10 viên"], "_code": "h=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh['dt']=pd.to_datetime(h['Giờ tạo đơn'])\nok=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)&(h.dt>='2026-04-01')&(h.dt<'2026-05-01')]\nc=BanHang_ChiTietHoaDon[BanHang_ChiTietHoaDon['Mã giao dịch'].isin(ok['Order ID'])].copy()\nc['q']=to_num(c['SL cơ bản'])\ns=c.groupby('Ma hang')['q'].sum().reset_index()\nnm=BanHang_HangHoa.set_index('ma_sp')['Món']\ns['n']=s['Ma hang'].map(nm)\ns=s.sort_values(['q','Ma hang'],ascending=[False,True])\nRESULT=s['n'].head(3).tolist()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4d188c72f1f5", "type": "percent", "answer": 15.48, "_code": "h=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh['dt']=pd.to_datetime(h['Giờ tạo đơn'])\nok=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)&(h.dt>='2026-03-01')&(h.dt<'2026-04-01')].copy()\nc=BanHang_ChiTietHoaDon[BanHang_ChiTietHoaDon['Mã giao dịch'].isin(ok['Order ID'])].copy()\nc['v']=to_num(c['Thanh tien'])\ntot=c['v'].sum()\nkh=BanHang_KhachHang.set_index('Customer ID')['Hạng']\nok['h']=ok['Mã KH mua'].map(kh)\nvip=ok[ok['h']=='thân thiết']['Order ID']\nRESULT=f\"{c[c['Mã giao dịch'].isin(vip)]['v'].sum()/tot*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ddf91a8fe7e2", "type": "date", "answer": "2025-12-27", "_code": "\nd=SoBanHang.copy()\nd['dt']=parse_date(d['Ngày tháng'])\nd['t']=to_num(d['Thành tiền (đ)'])\nprint(d['Trạng thái đơn'].unique(), d.dt.isna().sum())\nm=d[(d.dt>='2025-12-01')&(d.dt<='2025-12-31')&d['Trạng thái đơn'].isin(['Đã giao','đang gửi'])]\ng=m.groupby(m.dt.dt.normalize()).t.sum().sort_values(ascending=False);print(g.head(3))\nRESULT=str(g.index[0].date())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f4a296b44c00", "type": "percent", "answer": 2.47, "_code": "d=DonHang_ChiTiet__03_2026.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\no=d.drop_duplicates('Mã đơn hàng')\nc=o['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False).sum()\nRESULT=f\"{c/len(o)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6e46ccad22e3", "type": "list", "answer": ["Mì Hảo Hảo tôm chua cay", "Gạo ST25", "Nước suối Aquafina 500ml"], "_code": "import re\nd=DonHang_ChiTiet__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\n# as_of 2025-09-07 (Sunday) -> last week Mon 2025-08-25..Sun 2025-08-31\nd=d[(d.dt>='2025-08-25')&(d.dt<='2025-08-31')]\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả',case=False)]\nd['q']=to_num(d['Số lượng sản phẩm'].astype(str).str.extract(r'([\\d.,]+)')[0])\nqd=DanhSachQuyDoi\nf={}\nfor _,r in qd.iterrows(): f[(r['Tên sản phẩm'],r['Đơn vị quy đổi'])]=float(r['Tỉ lệ quy đổi'])\nd['f']=[f.get((n,u),1.0) for n,u in zip(d['Tên sản phẩm'],d['Đơn vị tính'])]\nd['b']=d.q*d.f\ns=d.groupby('Tên sản phẩm').b.sum().sort_values(ascending=False,kind='stable')\nRESULT=list(s.index[:3])\n", "_attempts": 1, "_verdict": "correct"}
