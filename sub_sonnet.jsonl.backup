{"id": "q_79f9c340442f", "type": "string", "answer": "Xi măng Hà Tiên PCB40 bao 50kg", "_code": "a=data['SoBanHang'].copy()\na['d']=parse_date(a['Ngày mua'])\na=a[a['Ghi chú TT'].isin(['xong','Đang vận chuyển'])&(a.d>='2025-07-01')&(a.d<='2025-07-31')]\na['q']=to_num(a['Số lượng lẻ'])\ns=a.groupby('Mặt hàng').q.sum().sort_values(ascending=False,kind='stable')\nRESULT=s.index[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bf862acc15f6", "type": "percent", "answer": -14.87, "_code": "import re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    if not s: return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    m=re.fullmatch(r'([\\d.,]+)tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d+,\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\n\ndf=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill()\ndf=df.drop_duplicates().reset_index(drop=True)\ndf['d']=parse_date(df['Ngày đặt hàng']); df['v']=df['Tổng tiền'].map(money)\ndf=df[df['Trạng thái đơn hàng'].isin(['Thành công','đã lấy','Đang giao dịch'])]\na=df[(df.d>='2025-06-01')&(df.d<='2025-06-30')].v.sum()\nb=df[(df.d>='2025-05-01')&(df.d<='2025-05-31')].v.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f673036bdd05", "type": "percent", "answer": 49.23, "_code": "h=DanhSachHoaDon.copy()\nh['dt']=pd.to_datetime(h['Thời gian'],format='%d/%m/%Y')\nh=h[h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\nh['tt']=to_num(h['Tổng tiền hàng'])\na=h[(h.dt>='2026-02-01')&(h.dt<='2026-02-28')].tt.sum()\nb=h[(h.dt>='2026-01-01')&(h.dt<='2026-01-31')].tt.sum()\nRESULT=f\"{round((a/b-1)*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_97378cee7c0e", "type": "list", "answer": [30000, 10000], "_code": "\nh=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy(); sq=SoQuy.copy()\nh['dt']=parse_date(h['Thời gian']).dt.normalize(); h['tot']=to_num(h['Tổng sau giảm giá'])\nbad=h['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)\nh=h[(h['Phương thức thanh toán']=='Ghi nợ')&~bad&(h['Mã KH']=='KH0147')]\nsq['dt']=parse_date(sq['Thời gian']).dt.normalize(); sq['v']=sq['Giá trị'].astype(str).str.replace('đ','').str.replace('.','',regex=False).astype(float)\nsq=sq[sq['Mã hóa đơn'].isin(h['Mã hóa đơn'])].merge(h[['Mã hóa đơn','dt']],on='Mã hóa đơn',suffixes=('','_o'))\nsame=sq[sq.dt==sq.dt_o].groupby('Mã hóa đơn')['v'].sum()\nhm=h[(h.dt>='2025-09-01')&(h.dt<='2025-09-30')]\nadd=(hm['tot']-hm['Mã hóa đơn'].map(same).fillna(0)).sum()\nlater=sq[(sq.dt>sq.dt_o)&(sq.dt>='2025-09-01')&(sq.dt<='2025-09-30')]['v'].sum()\nRESULT=[int(add),int(later)]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_0bf10b77c2ba", "type": "percent", "answer": 5.33, "_code": "\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True)\nh=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian']).dt.normalize()\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả|Hoàn trả',case=False,na=False)\nh=h[~bad]\nc=c.drop_duplicates().merge(h[['Mã hóa đơn','dt']],on='Mã hóa đơn')\nc=c[c['Tên hàng'].str.lower()=='latte (l)'.lower()]\nc['q']=to_num(c['Số lượng quy đổi'])\nD=pd.Timestamp('2026-02-05')\na=c[(c.dt>=D)&(c.dt<=D+pd.Timedelta(days=29))]['q'].sum()\nb=c[(c.dt>=D-pd.Timedelta(days=30))&(c.dt<D)]['q'].sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_214e94e42454", "type": "date", "answer": "2025-06-07", "_code": "import re\ndef pm(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)(?:,(\\d+))?tr(\\d+)?',s)\n    if m:\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0')[:3])*1e3\n        else: a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        return -a if neg else a\n    m=re.fullmatch(r'(\\d+(?:,\\d+)?)k',s)\n    if m: v=float(m.group(1).replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except Exception: return float('nan')\n    return -v if neg else v\no=don_hang.drop_duplicates('Số phiếu').copy(); o['dt']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().copy(); c['amt']=c['Tiền bán'].map(pm)\nj=c.merge(o[['Số phiếu','dt']],left_on='Số CT',right_on='Số phiếu')\nm=j[(j.dt.dt.year==2025)&(j.dt.dt.month==6)]\nRESULT=str(m.groupby(m.dt.dt.date)['amt'].sum().idxmax())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_34dc1ecd863a", "type": "date", "answer": "2025-02-28", "_code": "h=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nst=h['Trạng thái'].map(normalize_text)\nh=h[~st.str.contains('huy|tra hang')]\nlo=DanhSachHoaDonChiTietLo\nret=set(lo.loc[to_num(lo['Số lượng trả (ĐVT cơ bản)'])>0,'Mã hóa đơn'])\nh=h[~h['Mã hóa đơn'].isin(ret)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['t']=to_num(c['Thành tiền']); c['q']=to_num(c['Số lượng quy đổi'])\nc=c.merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\nx=c[(c.d>='2025-02-01')&(c.d<='2025-02-28')].groupby('d').t.sum()\nprint(x.sort_values().tail(3))\nRESULT=x.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_954ab36d643c", "type": "date", "answer": "2026-01-29", "_code": "import re\ndef money(s):\n    s=str(s).strip()\n    if s.endswith('tr'): return round(float(s[:-2].replace(',','.'))*1e6)\n    if re.fullmatch(r'-?[\\d,]*\\.\\d+',s): return float(s.replace(',',''))\n    return float(re.sub(r'\\D','',s) or 0)\na=data['ban_hang'].drop_duplicates().copy()\nbad=a['trang_thai'].astype(str).str.lower().str.contains('hủy|huỷ|trả')\nbad_o=a[bad]['Mã GD'].unique()\na=a[~a['Mã GD'].isin(bad_o)]\na['d']=parse_date(a['Ngày'])\na=a[(a.d>='2026-01-01')&(a.d<='2026-01-31')]\na['t']=a['Tổng'].map(money)\ns=a.groupby('d').t.sum().sort_values(ascending=False,kind='stable')\nRESULT=s.index[0].strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_268de5b6b5b4", "type": "list", "answer": ["Bia Tiger lon", "Bia Sài Gòn Special lon", "Coca-Cola lon", "Rau muống xào tỏi", "Bia Heineken lon"], "_code": "\no=don_hang[don_hang['Tình trạng'].isin(['completed','shipping'])].copy()\no['dt']=parse_date(o['Ngày'])\no=o[(o.dt>='2025-05-01')&(o.dt<='2025-05-31')]\nl=chi_tiet_don.merge(o[['Mã chứng từ']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\nl['q']=to_num(l['Số lượng lẻ'])\nl=l.merge(san_pham[['Mã sản phẩm bán','Tên SP']],left_on='Mã mặt hàng',right_on='Mã sản phẩm bán')\nl=l[l['Tên SP']!='Phí phục vụ']\ng=l.groupby(['Mã mặt hàng','Tên SP']).q.sum().reset_index().sort_values(['q','Mã mặt hàng'],ascending=[False,True])\nRESULT=g['Tên SP'].head(5).tolist()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a357aa1e8b54", "type": "list", "answer": [437700, 862750, 59867], "_code": "\no=don_hang.copy(); o['d']=pd.to_datetime(o['ThoiGianLap'].str[:10])\ncut=pd.Timestamp(as_of_date)\no=o[(o.d<=cut)&(o.TinhTrang!='cancelled')&(o.PhuongThucTT!='cod')]\np=thanh_toan.copy(); p['d']=pd.to_datetime(p['NgayGioThu'].str[:10]); p=p[p.d<=cut]\npaid=p.groupby('MaHoaDon').SoTienThu.sum()\no['owe']=o.TongThanhToan-o.MaHoaDon.map(paid).fillna(0)\no=o[o.owe>0]; o['age']=(cut-o.d).dt.days\nRESULT=[int(o[o.age<=7].owe.sum()),int(o[(o.age>=8)&(o.age<=15)].owe.sum()),int(o[o.age>15].owe.sum())]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2d2d91435d5d", "type": "list", "answer": [616900, 427900, 650], "_code": "\no=don_hang.copy(); o['d']=pd.to_datetime(o['ThoiGianLap'].str[:10])\ncut=pd.Timestamp(as_of_date)\no=o[(o.d<=cut)&(o.TinhTrang!='cancelled')&(o.PhuongThucTT!='cod')]\np=thanh_toan.copy(); p['d']=pd.to_datetime(p['NgayGioThu'].str[:10]); p=p[p.d<=cut]\npaid=p.groupby('MaHoaDon').SoTienThu.sum()\no['owe']=o.TongThanhToan-o.MaHoaDon.map(paid).fillna(0)\no=o[o.owe>0]; o['age']=(cut-o.d).dt.days\nRESULT=[int(o[o.age<=7].owe.sum()),int(o[(o.age>=8)&(o.age<=15)].owe.sum()),int(o[o.age>15].owe.sum())]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e3047e65e537", "type": "list", "answer": [16, 1], "_code": "import re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    if not s: return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    m=re.fullmatch(r'([\\d.,]+)tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d+,\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\n\nsku='SP0016'\nnh=DuLieuXuat__DonNhapHang_ChiTiet; nh=nh[nh['Mã SKU']==sku]\nhead=DuLieuXuat__DonNhapHang.set_index('Mã đơn nhập')['Ngày nhập']\nnh=nh.assign(d=parse_date(nh['Mã đơn nhập'].map(head)))\nnh=nh[nh.d<=as_of_date]\nlots=set(nh['Mã lô'])\ninn=to_num(nh['Số lượng nhập']).sum()\no=DonHang_ChiTiet[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']].copy()\no[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng']]=o.ffill()\no=o.drop_duplicates('Mã đơn hàng'); o['d']=parse_date(o['Ngày đặt hàng'])\ngood=o[(o['Trạng thái đơn hàng']!='Đã hủy')&(o.d<=as_of_date)]['Mã đơn hàng']\nl=DuLieuXuat__DonHang_Lo; l=l[l['Mã lô'].isin(lots)&l['Mã đơn hàng'].isin(good)]\nout=to_num(l['Số lượng']).sum()-to_num(l['Số lượng trả']).sum()\nt=int(round(inn-out))\nRESULT=[t//10,t%10]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_efdde9b52ec3", "type": "number", "answer": 265861700, "_code": "h=DuLieuBanHang__DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nst=h['Trạng thái'].map(normalize_text)\nh=h[~st.str.contains('huy|tra hang')]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['t']=to_num(c['Thành tiền'])\nc=c.merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\nRESULT=int(round(c[(c.d>='2025-10-01')&(c.d<='2025-10-31')].t.sum()))\n", "_attempts": 1, "_verdict": "correct"}
