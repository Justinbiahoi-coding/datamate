{"id": "q_16d431fce5d6", "type": "percent", "answer": 29.2, "_code": "import unicodedata,re\ns=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\ns['d']=parse_date(s['Ngày'])\nbad=s[s['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao',case=False,na=False)]['Mã đơn hàng'].unique()\ns=s[~s['Mã đơn hàng'].isin(bad)&(s.d.dt.year==2026)&(s.d.dt.month==5)]\ndef nk(x): return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(x)).lower().strip())\ns['k']=s['Khách hàng'].map(nk)\nprint(s['k'].value_counts().head(8).to_dict())\ns=s[~s['k'].isin(['lẻ','khách lẻ','kl','khach le','le','','nan'])]\nn=s.groupby('k')['Mã đơn hàng'].nunique()\nRESULT=f\"{(n>=4).mean()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8d68a52cc63c", "type": "percent", "answer": 7.32, "_code": "d=don_hang.copy(); d['dt']=pd.to_datetime(d['ThoiGianLap'].astype(str).str[:10])\nok=d[d.TinhTrang.isin(['completed','shipping'])&(d.dt>='2025-07-01')&(d.dt<='2025-07-31')]\nc=chi_tiet_don.drop_duplicates()\nc=c[c.MaHoaDon.isin(ok.MaHoaDon)].merge(san_pham[['MaHangHoa','DanhMuc']],on='MaHangHoa')\nRESULT=f\"{round(c[c.DanhMuc=='mắt mũi họng'].TriGia.sum()/c.TriGia.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
