{"id": "q_d81abc9c0964", "type": "number", "answer": 26015700, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\nd=DonHang_ChiTiet.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill(); d=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False)]\nd['a']=mser(d['Tổng tiền'])\nRESULT=int(round(d[(d.dt>=\"2025-04-07\")&(d.dt<=\"2025-04-10\")].a.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e3ffb2e7d71b", "type": "list", "answer": ["Bùi Đức Hiếu", "Đoàn Sơn Linh", "Đỗ Tâm Ngân"], "_code": "df=data['Bao_cao_ban_hang__So_chi_tiet_ban_hang'].drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày'])\ndf=df[(df.d>='2025-06-01')&(df.d<='2025-06-30')]\nbad=df[df['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)]['Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf=df[~df['Khách hàng'].str.contains('lẻ',case=False,na=True)]\ndf['tt']=to_num(df['Thành tiền'])\ndf['k']=df['Khách hàng'].apply(normalize_text)\ng=df.groupby('k').agg(t=('tt','sum'),n=('Khách hàng','first')).sort_values('t',ascending=False)\nRESULT=list(g.n[:3])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_36d4c28e5079", "type": "percent", "answer": 2.57, "_code": "d=DonHang_ChiTiet.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[oc]=d[oc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nbad=d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False,na=False)\nbadids=set(d[bad]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(badids)]\nd['v']=to_num(d['Tổng tiền'])\na=d[(d.dt>='2026-01-01')&(d.dt<='2026-01-31')].v.sum()\nb=d[(d.dt>='2025-12-01')&(d.dt<='2025-12-31')].v.sum()\nRESULT=f\"{(a/b-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "wrong"}
{"id": "q_06340b45abc6", "type": "number", "answer": 1011002000, "_code": "import re\ndef money(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace('₫','').strip()\n    m=re.match(r'^([\\d.,]+)\\s*tr\\s*(\\d*)$',s)\n    if m:\n        a=float(m.group(1).replace(',','.')) if m.group(2)=='' else float(m.group(1))+0\n        if m.group(2)!='': return a*1e6+float(m.group(2).ljust(3,'0'))*1e3\n        return a*1e6\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^\\d{1,3}([.,]\\d{3})+$',s): return float(re.sub(r'[.,]','',s))\n    if re.match(r'^[\\d,]+\\.\\d+$',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.match(r'^[\\d.,]+$',s) else 0.0\no=don_hang.copy(); c=chi_tiet_don.drop_duplicates().copy()\no['dt']=parse_date(o['Ngày'])\no=o[~o['Tình trạng'].str.contains('cancel|return',case=False,na=False)]\nc['a']=c['Amount'].map(money)\nt=c.groupby('Mã đơn hàng').a.sum()\nx=o[(o.dt>='2026-05-01')&(o.dt<='2026-05-31')&(o['Loại bán']=='store')]\nRESULT=int(x['Mã chứng từ'].map(t).fillna(0).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c4f2107b911d", "type": "number", "answer": 5904, "_code": "o=don_hang.copy()\no['dt']=parse_date(o['Ngày'])\no=o[~o['Tình trạng'].str.contains('cancel|return',case=False,na=False)]\nRESULT=int(((o.dt>='2025-07-01')&(o.dt<='2025-09-30')).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fcdacd705ef0", "type": "percent", "answer": 3.45, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\n\ns=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].dropna(subset=['Mã đơn hàng']).drop_duplicates().reset_index(drop=True)\ns['dt']=parse_date(s['Ngày'])\ns['v']=money(s['Thành tiền'])\nbad=set(s[s['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False)]['Mã đơn hàng'])\ns=s[~s['Mã đơn hàng'].isin(bad)]\n\nhh=Bao_cao_ban_hang['Danh sách hàng hóa'].drop_duplicates('Tên hàng hóa').set_index('Tên hàng hóa')['Nhóm hàng hóa']\nm=s[(s.dt>='2025-12-01')&(s.dt<='2025-12-31')].copy()\nm['g']=m['Tên hàng hóa'].map(hh)\nprint(m['g'].isna().sum())\nRESULT=f\"{m[m.g=='hoàn thiện'].v.sum()/m.v.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_da7c857d6cf0", "type": "number", "answer": 31848600, "_code": "h=DanhSachHoaDon.copy()\nh['t']=pd.to_datetime(h['Thời gian tạo'])\nh['d']=parse_date(h['Thời gian'])\nh=h[(h.d>='2025-10-20')&(h.d<='2025-10-26')]\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]\nh=h[(h.t.dt.hour>=14)&(h.t.dt.hour<=21)]\nc=DanhSachHoaDonChiTiet[DanhSachHoaDonChiTiet['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\nRESULT=int(round(to_num(c['Thành tiền']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_aad69a2295fc", "type": "number", "answer": 1052284500, "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\no=don_hang.drop_duplicates('Mã chứng từ').copy(); o['dt']=parse_date(o['Ngày'])\no=o[o['Tình trạng'].isin(['completed','shipping'])&(o.dt.dt.year==2026)&(o.dt.dt.month==4)]\nc=chi_tiet_don.drop_duplicates().copy(); c['a']=mser(c['Amount'])\nRESULT=int(round(c[c['Mã đơn hàng'].isin(o['Mã chứng từ'])].a.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c208dfd86430", "type": "number", "answer": 44, "_code": "o=don_hang.drop_duplicates('Mã chứng từ').copy(); o['dt']=parse_date(o['Ngày'])\no=o[(o.dt.dt.year==2026)&(o.dt.dt.month==4)]\nRESULT=int((o['Tình trạng']=='cancelled').sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e9e0024a7378", "type": "list", "answer": ["Võ Hải Minh", "Từ Anh Mai", "Tống Hạnh Trang"], "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(float('0.'+m.group(2))*1e6 if m.group(2) else 0) if len(m.group(2))!=3 else int(m.group(1))*1e6+int(m.group(2))*1e3\n    m=re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return money(m.group(1))*1e3\n    if ',' in s and '.' in s:\n        s=s.replace(',','') if s.rfind('.')>s.rfind(',') else s.replace('.','').replace(',','.')\n        return float(s)\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    return float(s.replace(',','.'))\ndef mser(sr): return sr.map(money)\no=don_hang.drop_duplicates('Mã chứng từ').copy(); o['dt']=parse_date(o['Ngày'])\no=o[o['Tình trạng'].isin(['completed','shipping'])&(o.dt.dt.year==2025)&(o.dt.dt.month==8)&o['Customer ID'].notna()]\nc=chi_tiet_don.drop_duplicates().copy(); c['a']=mser(c['Amount'])\ns=c.merge(o[['Mã chứng từ','Customer ID']],left_on='Mã đơn hàng',right_on='Mã chứng từ').groupby('Customer ID').a.sum().sort_values(ascending=False,kind='stable')\nnm=khach_hang.set_index('Mã KH')['Khách hàng (tên)']\nRESULT=[nm[k] for k in s.index[:3]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9a3b9473390e", "type": "percent", "answer": 12.07, "_code": "import re as _re\ndef money(x):\n    if x is None: return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    m=_re.fullmatch(r'(\\d+)tr(\\d{1,3})',s)\n    if m: return int(m.group(1))*1e6+int(m.group(2).ljust(3,'0'))*1e3\n    m=_re.fullmatch(r'(\\d+)[,.](\\d+)tr',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=_re.fullmatch(r'(\\d+)tr',s)\n    if m: return int(m.group(1))*1e6\n    m=_re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if _re.fullmatch(r'\\d+(\\.\\d{3})+(,\\d+)?',s): return float(s.replace('.','').replace(',','.'))\n    try: return float(s.replace(',','.')) if s.count(',')==1 and '.' not in s else float(s)\n    except: return float('nan')\ndef mon(series): return series.apply(money)\nh=DanhSachHoaDon__all.copy()\nh=h.drop_duplicates()\nh['dt']=parse_date(h['Thời gian'])\nbad=h['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả|Đổi trả',case=False,na=False)\nok=h[~bad]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nokd=ok[(ok.dt>='2025-08-01')&(ok.dt<='2025-08-31')]['Mã hóa đơn']\nc=c[c['Mã hóa đơn'].isin(okd)].merge(DanhSachSanPham[['Mã hàng','Nhóm hàng(3 Cấp)']],on='Mã hàng',how='left')\nc['t']=mon(c['Thành tiền'])\nRESULT=f\"{round(c[c['Nhóm hàng(3 Cấp)']=='cơm mì cháo'].t.sum()/c.t.sum()*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_9ca8c9bcd510", "type": "list", "answer": ["Tăng Lan Hạnh", "Đoàn Cường Thắng", "Hứa Bảo Hùng", "Phùng Quang Ngân", "Vương Hiếu Thanh"], "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\n\ns=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].dropna(subset=['Mã đơn hàng']).drop_duplicates().reset_index(drop=True)\ns['dt']=parse_date(s['Ngày'])\ns['v']=money(s['Thành tiền'])\nbad=set(s[s['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False)]['Mã đơn hàng'])\ns=s[~s['Mã đơn hàng'].isin(bad)]\nm=s[(s.dt>='2026-03-01')&(s.dt<='2026-03-31')]\ng=m[~m['Khách hàng'].str.lower().str.strip().isin(['khách lẻ','lẻ','kl','khach le'])].groupby('Khách hàng')['v'].sum().sort_values(ascending=False)\nRESULT=list(g.head(5).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_197487e4b9a2", "type": "list", "answer": [264082800, 250892100, 259652600], "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\n\nd=DonHang_ChiTiet.copy().reset_index(drop=True)\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['v']=money(d['Tổng tiền'])\nbad=set(d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bad)]\nRESULT=[int(round(d[(d.dt>=a)&(d.dt<=b)].v.sum())) for a,b in [('2026-01-01','2026-01-31'),('2026-02-01','2026-02-28'),('2026-03-01','2026-03-31')]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_42ecf5280436", "type": "percent", "answer": 1.52, "_code": "h=data['DanhSachHoaDon__all'].drop_duplicates().copy()\nh['d']=parse_date(h['Thời gian'])\nh=h.drop_duplicates('Mã hóa đơn')\nok=h[~h['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Đổi trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nc['tt']=to_num(c['Thành tiền'])\nrev=c.groupby('Mã hóa đơn')['tt'].sum()\nok=ok.assign(rev=ok['Mã hóa đơn'].map(rev).fillna(0))\ndef per(a,b): return ok[(ok.d>=a)&(ok.d<=b)].rev.sum()\ncur=per('2026-08-01','2026-08-31'); prev=per('2026-07-01','2026-07-31')\nRESULT=f\"{round((cur-prev)/prev*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3b5c9002b013", "type": "number", "answer": 121, "_code": "\nh=DuLieuBanHang__DanhSachHoaDon.copy(); s=DuLieuBanHang__SoQuy.copy()\nprint(h['Trạng thái'].value_counts().to_dict(), h['Kênh bán'].value_counts().to_dict(), h['Phương thức thanh toán'].value_counts().to_dict())\nh['dt']=pd.to_datetime(h['Thời gian tạo'])\ns['dt']=pd.to_datetime(s['Thời gian'])\ns['v']=to_num(s['Giá trị'])\nh['tot']=to_num(h['Tổng sau giảm giá'])\nh=h[(h.dt<='2025-06-14 23:59:59')&~h['Trạng thái'].str.contains('hủy|huỷ',na=False)&(h['Phương thức thanh toán']!='Thu hộ (COD)')]\npay=s[s.dt<='2025-06-14 23:59:59'].groupby('Mã hóa đơn').v.sum()\nh['rem']=h.tot-h['Mã hóa đơn'].map(pay).fillna(0)\nd=h[h.rem>0]\nprint(len(d), d['Mã KH'].isna().sum(), d['Kênh bán'].value_counts().to_dict())\nRESULT=d['Mã KH'].dropna().nunique()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3919f65b83aa", "type": "string", "answer": "Bia Tiger Bạc lon", "_code": "d=ban_hang.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày bán'])\nd=d[~d['Trạng thái xử lý'].str.contains('hủy|huỷ|Huỷ|trả',case=False,na=False)&(d['Hàng bán']!='Phí phục vụ')]\nx=d[(d.dt>='2026-01-01')&(d.dt<='2026-01-31')]\ns=x.groupby('Hàng bán')['Số lượng lẻ'].sum().sort_values(ascending=False,kind='stable')\nRESULT=s.index[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_05b478fbe670", "type": "percent", "answer": 123.46, "_code": "d=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd['n']=d['Tên sản phẩm'].map(normalize_text)\nqd=DanhSachQuyDoi.copy(); qd['n']=qd['Tên sản phẩm'].map(normalize_text)\nf={(r.n,str(r['Đơn vị quy đổi']).strip().lower()):float(to_num(pd.Series([r['Tỉ lệ quy đổi']])).iloc[0]) for _,r in qd.iterrows()}\nd['q']=to_num(d['Số lượng sản phẩm'])*[f.get((n,str(u).strip().lower()),1.0) for n,u in zip(d.n,d['Đơn vị tính'])]\nok=~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False,na=False)\ndef chg(name,D,N=7):\n    D=pd.Timestamp(D); x=d[ok&(d.n==normalize_text(name))]\n    a=x[(x.dt>=D)&(x.dt<D+pd.Timedelta(days=N))].q.sum()\n    b=x[(x.dt>=D-pd.Timedelta(days=N))&(x.dt<D)].q.sum()\n    return f\"{(a-b)/b*100:.2f}%\"\nRESULT=chg('Magne-B6 Corbière hộp 5 vỉ x 10 viên','2025-11-29')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_dabcfd5894e7", "type": "percent", "answer": -38.46, "_code": "d=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd['n']=d['Tên sản phẩm'].map(normalize_text)\nqd=DanhSachQuyDoi.copy(); qd['n']=qd['Tên sản phẩm'].map(normalize_text)\nf={(r.n,str(r['Đơn vị quy đổi']).strip().lower()):float(to_num(pd.Series([r['Tỉ lệ quy đổi']])).iloc[0]) for _,r in qd.iterrows()}\nd['q']=to_num(d['Số lượng sản phẩm'])*[f.get((n,str(u).strip().lower()),1.0) for n,u in zip(d.n,d['Đơn vị tính'])]\nok=~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|trả|hoàn hàng',case=False,na=False)\ndef chg(name,D,N=7):\n    D=pd.Timestamp(D); x=d[ok&(d.n==normalize_text(name))]\n    a=x[(x.dt>=D)&(x.dt<D+pd.Timedelta(days=N))].q.sum()\n    b=x[(x.dt>=D-pd.Timedelta(days=N))&(x.dt<D)].q.sum()\n    return f\"{(a-b)/b*100:.2f}%\"\nRESULT=chg('Enterogermina 2 tỷ/5ml hộp 20 ống','2025-02-07')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e65da358fdc9", "type": "date", "answer": "2025-08-01", "_code": "df=data['So_chi_tiet_ban_hang__all'].drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày'])\nbad=df[df['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được',case=False,na=False)]['Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf=df[(df.d>='2025-08-01')&(df.d<='2025-08-31')]\ndf['tt']=to_num(df['Thành tiền'])\ng=df.groupby('d').tt.sum()\nRESULT=g.idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
