{"id": "q_7134a3112fb4", "type": "number", "answer": 976694200, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\nb=ban_hang.drop_duplicates().copy()\nb['dt']=pd.to_datetime(b['Ngày'],format='%d/%m/%Y',errors='coerce')\nb=b[~b.trang_thai.str.contains('hủy|huỷ|trả',case=False,na=False)]\nb=b[(b.dt.dt.year==2026)&(b.dt.dt.month==4)]\nRESULT=int(round(b['Tổng'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4eb3fb381433", "type": "number", "answer": 169913, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nd=DonHang_ChiTiet__all.copy()\nc=[\"Mã đơn hàng\",\"Ngày đặt hàng\",\"Trạng thái đơn hàng\",\"Tên khách hàng\"]\nd[c]=d[c].ffill(); d=d.drop_duplicates().reset_index(drop=True)\nd=d[~d[\"Trạng thái đơn hàng\"].str.contains(\"hủy|huỷ|hoàn hàng|trả\",case=False,na=False)].reset_index(drop=True)\ndt=parse_date(d[\"Ngày đặt hàng\"])\nd=d[(dt>='2026-02-01')&(dt<='2026-02-28')]\nRESULT=int(round(d['Tổng tiền'].map(m).sum()/d['Mã đơn hàng'].nunique()+1e-9))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7f6fd6d714ed", "type": "percent", "answer": 30.97, "_code": "h = BanHang_HoaDon.copy()\nh['d'] = parse_date(h['Ngày bán'])\nh = h[h['Trạng thái'].isin(['Đã giao', 'Đang vận chuyển'])]\nc = BanHang_ChiTietHoaDon.drop_duplicates().copy()\nc['amt'] = pd.to_numeric(c['Thanh tien'].astype(str).str.replace(r'[^\\d]', '', regex=True), errors='coerce')\nc = c.merge(h[['Order ID', 'd']], left_on='Mã giao dịch', right_on='Order ID')\ndef rev(y, m):\n    return c[(c.d.dt.year == y) & (c.d.dt.month == m)]['amt'].sum()\ncur, prev = rev(2026, 2), rev(2025, 2)\nRESULT = f\"{round((cur - prev) / prev * 100, 2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1c2e8610ac47", "type": "percent", "answer": 42.69, "_code": "import re\ndef pm(x):\n    s = str(x).strip().lower().replace('đ', '').replace(' ', '')\n    if 'tr' in s:\n        a, b = s.split('tr', 1)\n        if b == '':\n            return float(a.replace(',', '.')) * 1e6\n        return float(a) * 1e6 + float(b.ljust(3, '0')) * 1000\n    if s.endswith('k'):\n        return float(s[:-1].replace(',', '.')) * 1000\n    return float(re.sub(r'[^\\d]', '', s) or 'nan')\no = don_hang.copy()\no['d'] = parse_date(o['Ngày bán'])\no = o[o['Tình trạng đơn'].isin(['completed', 'shipping'])]\nc = chi_tiet_don.drop_duplicates().copy()\nc['amt'] = c['Tiền bán'].map(pm)\nc = c.merge(o[['Số phiếu', 'd']], left_on='Số CT', right_on='Số phiếu')\ndef rev(y, m):\n    return c[(c.d.dt.year == y) & (c.d.dt.month == m)]['amt'].sum()\ncur, prev = rev(2026, 3), rev(2026, 2)\nRESULT = f\"{round((cur - prev) / prev * 100, 2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f7728d131abb", "type": "number", "answer": 436963100, "_code": "\nH=DanhSachHoaDon__all.copy(); H['d']=parse_date(H['Thời gian'])\nst=H['Trạng thái'].astype(str).str.lower()\nH=H[~st.str.contains('hủy|huỷ|cancel|trả')]\nD=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nD['amt']=pd.to_numeric(D['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\nrev=D.groupby('Mã hóa đơn').amt.sum()\nH['rev']=H['Mã hóa đơn'].map(rev).fillna(0)\n\nRESULT=int(H[(H.d>='2025-01-01')&(H.d<='2025-03-31')].rev.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8c6d83185401", "type": "number", "answer": 88766800, "_code": "\nH=DanhSachHoaDon__all.copy(); H['d']=parse_date(H['Thời gian'])\nst=H['Trạng thái'].astype(str).str.lower()\nH=H[~st.str.contains('hủy|huỷ|cancel|trả')]\nD=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nD['amt']=pd.to_numeric(D['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\nrev=D.groupby('Mã hóa đơn').amt.sum()\nH['rev']=H['Mã hóa đơn'].map(rev).fillna(0)\n\nt=pd.to_datetime(H['Thời gian tạo']); h=t.dt.hour\nm=H[(H.d>='2025-09-01')&(H.d<='2025-09-30')&(h>=14)&(h<=21)]\nRESULT=int(m.rev.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_243c9fca1e72", "type": "number", "answer": 96110900, "_code": "\nN=DanhSachNhapHang.copy(); N['d']=parse_date(N['Thời gian'])\nN=N[~N['Trạng thái'].astype(str).str.lower().str.contains('hủy|huỷ|cancel')]\nRESULT=int(pd.to_numeric(N[(N.d>='2025-11-01')&(N.d<='2025-11-30')]['Cần trả NCC'].astype(str).str.replace(',',''),errors='coerce').sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5ec9e9d3a54d", "type": "number", "answer": 56845000.0, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nh=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn trả',case=False,na=False)]\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates(['Mã hóa đơn','STT'])\nc['v']=c['Thành tiền'].map(money)\nc=c.merge(h[['Mã hóa đơn','dt']],on='Mã hóa đơn')\n\ng=DanhSachSanPham.set_index('Mã hàng')['Nhóm hàng(3 Cấp)']\nc['g']=c['Mã hàng'].map(g)\nx=c[(c.dt.dt.year==2025)&(c.dt.dt.month==9)&(c.g=='trà sữa')]\nRESULT=float(x.v.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0fbd522a4f2f", "type": "percent", "answer": -41.86, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nh=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn trả',case=False,na=False)]\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates(['Mã hóa đơn','STT'])\nc['v']=c['Thành tiền'].map(money)\nc=c.merge(h[['Mã hóa đơn','dt']],on='Mã hóa đơn')\n\ncal=pd.read_csv('train/calendar.csv')\ncal['date']=pd.to_datetime(cal['date'])\ns=cal[(cal.lunar_month==12)&(cal.lunar_day==23)&(cal.lunar_year==2025)].date.iloc[0]\ne=cal[(cal.lunar_month==1)&(cal.lunar_day==10)&(cal.lunar_year==2026)&(~cal.lunar_leap)].date.iloc[0]\nn=(e-s).days+1\na=c[(c.dt>=s)&(c.dt<=e)].v.sum()\nb=c[(c.dt>=s-pd.Timedelta(days=n))&(c.dt<s)].v.sum()\nRESULT=f\"{round((a/b-1)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0fe7c0c36f42", "type": "number", "answer": 151230800, "_code": "import re as _re\ndef money(s):\n    if s is None or (isinstance(s,float) and s!=s): return float('nan')\n    if isinstance(s,(int,float)): return float(s)\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if not s: return float('nan')\n    try:\n        if 'tr' in s:\n            a,b=s.split('tr',1)\n            a=a or '0'\n            if b=='': return float(a.replace(',','.'))*1e6\n            return int(a.replace('.','').replace(',',''))*1e6+int(b.ljust(3,'0')[:3])*1e3\n        if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n        if ',' in s and '.' in s:\n            return float(s.replace(',','')) if s.rfind('.')>s.rfind(',') else float(s.replace('.','').replace(',','.'))\n        if '.' in s:\n            return float(s.replace('.','')) if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s) else float(s)\n        if ',' in s:\n            return float(s.replace(',','')) if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+',s) else float(s.replace(',','.'))\n        return float(s)\n    except Exception: return float('nan')\nd=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nh=Bao_cao_ban_hang['Danh sách hàng hóa']\nd['dt']=parse_date(d['Ngày']); d['v']=d['Thành tiền'].map(money)\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được|hoàn hàng',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nnt=lambda s: normalize_text(str(s).replace('đ','d').replace('Đ','D'))\ng={nt(a):b for a,b in zip(h['Tên hàng hóa'],h['Nhóm hàng hóa'])}\nd['g']=d['Tên hàng hóa'].map(nt).map(g)\nx=d[(d.dt.dt.year==2026)&(d.dt.dt.month==8)&(d.g.str.lower()=='sắt thép')]\nRESULT=int(round(x['v'].sum()))\n", "_attempts": 3, "_verdict": "correct"}
{"id": "q_396a12d45bb0", "type": "number", "answer": 88, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\ndf=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\ndf['d']=pd.to_datetime(df['Giờ'],errors='coerce')\ndf['amt']=money(df['Tiền'].astype(str).str.lstrip('-'))\nbad=set(df[df['Ghi chú TT'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã phiếu'])\nneg=set(df[df['Số lượng hàng'].astype(str).str.strip().str.startswith('-')]['Mã phiếu'])\nok=df[~df['Mã phiếu'].isin(bad|neg)]\no=ok.groupby('Mã phiếu').agg(d=('d','min'),t=('amt','sum'))\no=o[(o.d>='2025-12-01')&(o.d<'2026-01-01')]\nRESULT=int((o.t>=3100000).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6114fa7b1534", "type": "percent", "answer": 4.8, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=pdate(h['Thời gian']); h['v']=money(h['Tổng tiền hàng'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\na=h[(h.d>='2026-06-01')&(h.d<='2026-06-30')].v.sum(); b=h[(h.d>='2026-05-01')&(h.d<='2026-05-31')].v.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ac421b03dc18", "type": "number", "answer": 69, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nh=DuLieuBanHang[\"DanhSachHoaDon\"].drop_duplicates(\"Mã hóa đơn\").copy()\nh[\"od\"]=pd.to_datetime(h[\"Thời gian tạo\"]).dt.normalize()\nbad=h[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả\",case=False,na=False)\ng=h[~bad&(h.od>='2025-05-01')&(h.od<='2025-05-31')&h['Mã KH'].notna()]\nn=g.groupby('Mã KH')['Mã hóa đơn'].nunique()\nRESULT=int((n>=5).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b501ff8c6fc6", "type": "number", "answer": 165329, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nh=DuLieuBanHang[\"DanhSachHoaDon\"].drop_duplicates(\"Mã hóa đơn\").copy()\nh[\"od\"]=pd.to_datetime(h[\"Thời gian tạo\"]).dt.normalize()\nbad=h[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả\",case=False,na=False)\ng=h[~bad&(h.od>='2025-03-01')&(h.od<='2025-03-31')]\nRESULT=int(g['Tổng tiền hàng'].map(m).sum()/len(g)+0.5)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1dffe8f178a3", "type": "number", "answer": 26665796, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nh=DuLieuBanHang[\"DanhSachHoaDon\"].drop_duplicates(\"Mã hóa đơn\").copy()\nh[\"od\"]=pd.to_datetime(h[\"Thời gian tạo\"]).dt.normalize()\nbad=h[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả\",case=False,na=False)\ng=h[(h['Phương thức thanh toán']=='Ghi nợ')&~h[\"Trạng thái\"].str.contains(\"hủy|huỷ\",case=False,na=False)]\nsq=DuLieuBanHang['SoQuy'].copy()\nsq=sq.merge(g[['Mã hóa đơn','od']],on='Mã hóa đơn')\npd_=pd.to_datetime(sq['Thời gian']).dt.normalize()\nx=sq[(pd_>sq.od)&(pd_>='2025-11-01')&(pd_<='2025-11-30')]\nRESULT=int(round(x['Giá trị'].map(m).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8036e34515e9", "type": "percent", "answer": 62.5, "_code": "a=DonHang_ChiTiet__all.copy()\nfor c in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: a[c]=a[c].ffill()\na=a.drop_duplicates()\na['od']=parse_date(a['Ngày đặt hàng'])\no=a.groupby('Mã đơn hàng').agg(od=('od','first'),st=('Trạng thái đơn hàng','first'),k=('Tên khách hàng','first'))\no=o[~o.st.str.contains('hủy|huỷ|trả',case=False)]\no=o[(o.od>='2025-09-01')&(o.od<='2025-09-30')]\nimport unicodedata\no['kn']=o.k.map(lambda s:' '.join(unicodedata.normalize('NFC',str(s)).lower().split()))\no=o[~o.kn.isin(['khách lẻ','lẻ','khách vãng lai'])]\ncnt=o.groupby('kn').size()\nRESULT=f\"{round((cnt>=3).mean()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_653d87082ae4", "type": "number", "answer": 27, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nprint(ban_hang.trang_thai.value_counts().to_dict())\nb=ban_hang.drop_duplicates().copy(); b['d']=pdate(b['Ngày'])\nb=b[~b.trang_thai.str.contains('hủy|huỷ|trả',case=False,na=False)]\nRESULT=int(b[b.d=='2025-08-23']['Mã GD'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_55e037221ed7", "type": "number", "answer": 10030, "_code": "h = DuLieuBanHang['DanhSachHoaDon'].drop_duplicates().copy()\nh['d'] = parse_date(h['Thời gian'])\nh = h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|cancel', case=False, na=False)]\ny = pd.Timestamp(as_of_date).year\nm = h[(h.d >= pd.Timestamp(y, 1, 1)) & (h.d <= pd.Timestamp(as_of_date))]\nRESULT = int(m['Mã hóa đơn'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ac1abef8d5aa", "type": "number", "answer": 1123310800.0, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nd=So_chi_tiet_ban_hang__all.drop_duplicates().reset_index(drop=True)\nbo=set(d[d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bo)].copy()\nd['dt']=parse_date(d['Ngày'])\nd['v']=d['Thành tiền'].map(money)\ndef mon(y,m): return d[(d.dt.dt.year==y)&(d.dt.dt.month==m)].v.sum()\nRESULT=float(mon(2025,7))", "_attempts": 1, "_verdict": "correct"}
{"id": "q_22f18e5bda36", "type": "number", "answer": 2849091700.0, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nd=So_chi_tiet_ban_hang__all.drop_duplicates().reset_index(drop=True)\nbo=set(d[d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bo)].copy()\nd['dt']=parse_date(d['Ngày'])\nd['v']=d['Thành tiền'].map(money)\ndef mon(y,m): return d[(d.dt.dt.year==y)&(d.dt.dt.month==m)].v.sum()\nRESULT=float(sum(mon(2026,m) for m in (1,2,3)))", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f6bb21e6ebb7", "type": "number", "answer": 4023, "_code": "df = So_chi_tiet_ban_hang__all.copy()\ndf['d'] = parse_date(df['Ngày'])\nst = df.groupby('Mã đơn hàng')['Trạng thái'].agg(lambda s: ' '.join(s.dropna().astype(str).unique()))\nbad = st[st.str.contains('hủy|huỷ|trả|không giao được|cancel', case=False)].index\ndf = df[~df['Mã đơn hàng'].isin(bad)]\ny = pd.Timestamp(as_of_date).year\nm = df[(df.d >= pd.Timestamp(y, 1, 1)) & (df.d <= pd.Timestamp(as_of_date))]\nRESULT = int(m['Mã đơn hàng'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0ef3574c2b44", "type": "percent", "answer": 66.01, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nd=So_chi_tiet_ban_hang__all.drop_duplicates().reset_index(drop=True)\nbo=set(d[d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bo)].copy()\nd['dt']=parse_date(d['Ngày'])\nd['v']=d['Thành tiền'].map(money)\ndef mon(y,m): return d[(d.dt.dt.year==y)&(d.dt.dt.month==m)].v.sum()\nRESULT=f\"{round((mon(2026,3)/mon(2026,2)-1)*100,2):.2f}%\"", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3f6ddf38634d", "type": "percent", "answer": 10.88, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\nh=DanhSachHoaDon__all.drop_duplicates().copy()\nh['dt']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c['amt']=c['Thành tiền'].map(money)\nm=c.merge(h[['Mã hóa đơn','dt']],on='Mã hóa đơn')\ndef rev(y,mo): return m[(m.dt.dt.year==y)&(m.dt.dt.month==mo)].amt.sum()\na,b=rev(2026,8),rev(2025,8)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4c7f65214480", "type": "percent", "answer": -3.33, "_code": "h=DanhSachHoaDon.copy(); h[\"od\"]=parse_date(h[\"Thời gian\"])\nh=h[~h[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả|cancel\",case=False,na=False)]\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2]).drop_duplicates(); c[\"a\"]=to_num(c[\"Thành tiền\"])\nh[\"v\"]=h[\"Mã hóa đơn\"].map(c.groupby(\"Mã hóa đơn\").a.sum()).fillna(0)\nr=lambda s,e: h[(h.od>=s)&(h.od<=e)].v.sum()\nx,y=r(\"2026-08-01\",\"2026-08-31\"),r(\"2026-07-01\",\"2026-07-31\")\nRESULT=f\"{(x-y)/y*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f063b216adce", "type": "percent", "answer": 51.87, "_code": "\nimport re\nX=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\nX['d']=parse_date(X['Giờ'])\nst=X['Ghi chú TT'].astype(str).str.lower()\nX=X[~st.str.contains('hủy|huỷ|cancel|trả')]\ndef pm(v):\n    s=str(v).strip().lower()\n    if s in('nan',''): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr'); val=int(re.sub(r'\\D','',a) or 0)*1_000_000+(int(re.sub(r'\\D','',b).ljust(3,'0')[:3])*1000 if re.sub(r'\\D','',b) else 0)\n    else: val=int(re.sub(r'\\D','',s) or 0)\n    return -val if neg else val\nX['amt']=X['Tiền'].map(pm)\nt=pd.Timestamp(as_of_date); a0=t.replace(day=1); p0=a0-pd.DateOffset(months=1); pe=min(p0+pd.Timedelta(days=t.day-1),a0-pd.Timedelta(days=1))\na=X[(X.d>=a0)&(X.d<=t)].amt.sum(); b=X[(X.d>=p0)&(X.d<=pe)].amt.sum()\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 1, "_verdict": "wrong"}
{"id": "q_f4c328691e9b", "type": "percent", "answer": -29.18, "_code": "\nimport re\nX=SoBanHang__all.dropna(subset=['Mã phiếu']).drop_duplicates().copy()\nX['d']=parse_date(X['Giờ'])\nst=X['Ghi chú TT'].astype(str).str.lower()\nX=X[~st.str.contains('hủy|huỷ|cancel|trả')]\ndef pm(v):\n    s=str(v).strip().lower()\n    if s in('nan',''): return 0.0\n    neg=s.startswith('-'); s=s.lstrip('-')\n    if 'tr' in s:\n        a,b=s.split('tr'); val=int(re.sub(r'\\D','',a) or 0)*1_000_000+(int(re.sub(r'\\D','',b).ljust(3,'0')[:3])*1000 if re.sub(r'\\D','',b) else 0)\n    else: val=int(re.sub(r'\\D','',s) or 0)\n    return -val if neg else val\nX['amt']=X['Tiền'].map(pm)\nt=pd.Timestamp(as_of_date); a0=t.replace(day=1); p0=a0-pd.DateOffset(months=1); pe=min(p0+pd.Timedelta(days=t.day-1),a0-pd.Timedelta(days=1))\na=X[(X.d>=a0)&(X.d<=t)].amt.sum(); b=X[(X.d>=p0)&(X.d<=pe)].amt.sum()\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 1, "_verdict": "wrong"}
{"id": "q_96a8f62a3f0e", "type": "number", "answer": 125000, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\nb=SoBanHang.copy()\nb['dt']=pd.to_datetime(b['Ngày mua'],format='%d/%m/%Y',errors='coerce')\nb=b[(b.dt=='2025-10-04')&(b['Mặt hàng']=='Ống PVC Bình Minh D50 cây 4m')]\np=b['Đơn giá bán'].map(money).unique()\nRESULT=int(p[0])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bdd9937828c1", "type": "number", "answer": 328957800, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nh=BanHang_HoaDon.drop_duplicates('Order ID').copy(); h['d']=pdate(h['Ngày bán'])\nh=h[~h['Trạng thái'].isin(['Không giao được','Đổi trả'])]\nh=h[(h.d>='2025-07-01')&(h.d<='2025-07-31')]\nc=BanHang_ChiTietHoaDon.drop_duplicates(); c=c[c['Mã giao dịch'].isin(h['Order ID'])]\nRESULT=int(round(money(c['Thanh tien']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6f877dfe79e8", "type": "number", "answer": 313922000, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\ns=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates().copy()\ns['t']=pdate(s['Ngày']); s['a']=money(s['Thành tiền'])\nbad=set(s[s['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]['Mã đơn hàng'])\nx=s[~s['Mã đơn hàng'].isin(bad)]\nRESULT=int(round(x[(x.t>='2026-05-20')&(x.t<='2026-06-18')].a.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_26bd17df26e7", "type": "percent", "answer": 12.5, "_code": "d=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates().copy()\nd[\"od\"]=parse_date(d[\"Ngày\"])\nok=d[~d[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả|cancel\",case=False,na=False)]\nn=ok[ok[\"Tên hàng hóa\"]==\"Topping Pudding trứng\"].copy(); n[\"q\"]=to_num(n[\"Số lượng quy đổi\"])\nr=lambda s,e: n[(n.od>=s)&(n.od<=e)].q.sum()\nx,y=r(\"2026-07-20\",\"2026-07-26\"),r(\"2026-07-13\",\"2026-07-19\")\nprint(x,y)\nRESULT=f\"{(x-y)/y*100:.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
