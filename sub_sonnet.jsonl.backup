{"id": "q_5979da21cf4f", "type": "date", "answer": "2026-05-03", "_code": "import re\ndef money(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    if not s: return float('nan')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    m=re.fullmatch(r'([\\d.,]+)tr',s)\n    if m: return float(m.group(1).replace(',','.'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d+,\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\n\no=don_hang.drop_duplicates().copy(); o['d']=parse_date(o['NgayBan'])\no=o[o['Xử lý'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().merge(o[['Mã chứng từ','d']],left_on='Ma don',right_on='Mã chứng từ')\nc=c[(c.d>='2026-05-01')&(c.d<='2026-05-31')]; c['v']=c['T.Tiền'].map(money)\nRESULT=c.groupby('d').v.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4f58385314e6", "type": "percent", "answer": 5.21, "_code": "\no=don_hang[don_hang['Xử lý'].isin(['completed','shipping'])].copy()\no['dt']=parse_date(o['NgayBan'])\no=o[(o.dt>='2025-08-01')&(o.dt<='2025-08-31')]\nl=chi_tiet_don.merge(o[['Mã chứng từ','Bán qua']],left_on='Ma don',right_on='Mã chứng từ')\na=to_num(l['T.Tiền'])\nRESULT=f\"{round(a[l['Bán qua']=='zalo_oa'].sum()/a.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b0728619f5b4", "type": "percent", "answer": 22.73, "_code": "df=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates()\ndf['d']=parse_date(df['Ngày']); df['t']=to_num(df['Thành tiền']); df['q']=to_num(df['Số lượng quy đổi'])\nst=df['Trạng thái'].map(normalize_text)\nbad=set(df.loc[st.str.contains('cancel|huy|tra hang|hoan tra'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\nx=df[df['Tên hàng hóa'].map(normalize_text)=='ca phe muoi (m)']\nD=pd.Timestamp('2025-08-23')\na=x[(x.d>=D)&(x.d<D+pd.Timedelta(days=7))].q.sum()\nb=x[(x.d>=D-pd.Timedelta(days=7))&(x.d<D)].q.sum()\nprint(a,b)\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_194556651253", "type": "number", "answer": 125457000, "_code": "import re\ndef pm(x):\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)(?:,(\\d+))?tr(\\d+)?',s)\n    if m:\n        if m.group(3): a=int(m.group(1))*1e6+int(m.group(3).ljust(3,'0')[:3])*1e3\n        else: a=float(m.group(1)+('.'+m.group(2) if m.group(2) else ''))*1e6\n        return -a if neg else a\n    m=re.fullmatch(r'(\\d+(?:,\\d+)?)k',s)\n    if m: v=float(m.group(1).replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except Exception: return float('nan')\n    return -v if neg else v\no=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy(); o['t']=pd.to_datetime(o['Thời gian tạo'])\no=o[o['Trạng thái'].isin(['xong','Hoàn thành','Đang giao dịch'])]\nc=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2]).drop_duplicates().copy(); c['amt']=c['Thành tiền'].map(pm)\nj=c.merge(o[['Mã hóa đơn','t']],on='Mã hóa đơn')\nm=j[(j.t.dt.year==2025)&(j.t.dt.month==8)&(j.t.dt.hour>=14)&(j.t.dt.hour<=21)]\nRESULT=int(round(m.amt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5178da2e9933", "type": "percent", "answer": 1.63, "_code": "import re\ndef money(s):\n    s=str(s).strip()\n    if s.endswith('tr'): return round(float(s[:-2].replace(',','.'))*1e6)\n    if re.fullmatch(r'-?[\\d,]*\\.\\d+',s): return float(s.replace(',',''))\n    return float(re.sub(r'\\D','',s) or 0)\na=data['So_chi_tiet_ban_hang__all'].drop_duplicates().copy()\na['d']=parse_date(a['Ngày'])\nbad=a['Trạng thái'].astype(str).str.lower().str.contains('hủy|huỷ|trả|không giao')\na=a[~a['Mã đơn hàng'].isin(a[bad]['Mã đơn hàng'])]\na['t']=a['Thành tiền'].map(money)\ndef rev(s,e): return a[(a.d>=s)&(a.d<=e)].t.sum()\nx,y=rev('2026-08-01','2026-08-31'),rev('2026-07-01','2026-07-31')\nRESULT=f\"{(x-y)/y*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
