{"id": "q_c7889c583f91", "type": "number", "answer": 784196000, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\na=ban_hang.drop_duplicates().copy()\na['d']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na=a[~a['trang_thai'].str.contains('hủy|huỷ|trả',case=False,na=False)]\na=a[(a.d>='2025-01-01')&(a.d<='2025-01-31')]\nRESULT=int(round(a['Tổng'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_41b3968eb526", "type": "percent", "answer": 19.36, "_code": "\no=don_hang.copy(); o['t']=parse_date(o['NgayBan'])\no=o[~o['Xử lý'].isin(['cancelled','returned'])]\no=o[(o.t.dt.year==2026)&(o.t.dt.month==2)]\nc=chi_tiet_don.drop_duplicates()\nc=c[c['Ma don'].isin(o['Mã chứng từ'])].merge(san_pham[['SKU','Nhom hang']],left_on='ID SP',right_on='SKU',how='left')\nc['m']=to_num(c['T.Tiền'])\nRESULT=f\"{c[c['Nhom hang']=='trà sữa'].m.sum()/c.m.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bbe7e6add6b0", "type": "percent", "answer": -31.58, "_code": "df=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates()\ndf['d']=parse_date(df['Ngày'])\ndf=df[~df['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]\ndf=df[df['Tên hàng hóa'].str.contains('Espresso (double)',case=False,regex=False)]\ndf['q']=df['Số lượng quy đổi'].astype(str).str.extract(r'^\\s*(-?[\\d.]+)')[0].astype(float)\nD=pd.Timestamp('2025-11-06')\naft=df[(df.d>=D)&(df.d<=D+pd.Timedelta(days=29))].q.sum()\nbef=df[(df.d>=D-pd.Timedelta(days=30))&(df.d<D)].q.sum()\nRESULT=f\"{(aft/bef-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5ea2a7c33d10", "type": "number", "answer": 4501000, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return 0.0\n    m=re.match(r'^(-?\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)tr$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000000)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)k$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000)\n    if re.match(r'^-?\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(re.sub(r'[^\\d.\\-]','',s) or 0)\ndf=DonHang_ChiTiet[DonHang_ChiTiet['Tên sản phẩm'].notna()].copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf['v']=df['Tổng tiền'].map(money)\nok=df[~df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nRESULT=int(round(ok[ok.d==as_of_date].v.sum()))\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_a33f7817a5c2", "type": "number", "answer": 307150300, "_code": "h=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)\nh=h[~bad&(h.d>='2026-01-01')&(h.d<='2026-01-31')]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nc['amt']=to_num(c['Thành tiền'])\nRESULT=int(round(c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].amt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e85d94c274b2", "type": "number", "answer": 220195300.0, "_code": "n=DanhSachNhapHang.copy()\nn['d']=parse_date(n['Thời gian'])\nn=n[~n['Trạng thái'].astype(str).str.contains('hủy|huỷ',case=False)]\nn['t']=n['Cần trả NCC'].astype(str).str.replace(',','').astype(float)\nRESULT=float(n[(n.d>='2025-04-01')&(n.d<='2025-04-30')].t.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7c717866acd7", "type": "percent", "answer": 0.0, "_code": "import pandas as pd, re, datetime as dt\nITEM='Trà sữa ô long (L)'; D=pd.Timestamp('2026-07-13'); N=14\nframes=[v for k,v in data.items() if k.endswith('__all')]\na=pd.concat(frames,ignore_index=True)\ncid,cdate,citem,cst,cq='Mã đơn hàng','Ngày','Tên hàng hóa','Trạng thái','Số lượng quy đổi'\na=a[a[cid].astype(str).str.startswith('ORD')].drop_duplicates()\ndef pdate(x):\n    if isinstance(x,(int,float)) and not pd.isna(x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(x))\n    if hasattr(x,'year'): return pd.Timestamp(x)\n    s=str(x).strip()\n    if re.match(r'^\\d{4}-\\d{2}-\\d{2}',s): return pd.Timestamp(s[:10])\n    return pd.to_datetime(s,dayfirst=True,errors='coerce')\na['d']=a[cdate].map(pdate)\nbad=a[cst].astype(str).str.lower().str.contains('hủy|huỷ|cancel|trả|hoàn hàng|đổi trả')\na=a[~a[cid].isin(set(a[bad][cid]))]\nx=a[a[citem].astype(str).str.strip().str.lower()==ITEM.lower()].copy()\nx['q']=pd.to_numeric(x[cq],errors='coerce')\ndef S(lo,hi): return x[(x.d>=lo)&(x.d<=hi)].q.sum()\naft=S(D,D+pd.Timedelta(days=N-1)); bef=S(D-pd.Timedelta(days=N),D-pd.Timedelta(days=1))\nprint(aft,bef,x.d.isna().sum())\nRESULT=f\"{round((aft-bef)/bef*100,2)}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_5214682a5c4f", "type": "number", "answer": 19880000, "_code": "\nh=DanhSachHoaDon__all.copy(); h['dt']=parse_date(h['Thời gian'])\no=h[h['Trạng thái'].isin(['xong','Thành công','Đang giao hàng'])&(h.dt=='2026-01-24')]['Mã hóa đơn']\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nRESULT=int(round(to_num(c[c['Mã hóa đơn'].isin(o)]['Thành tiền']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7882e23cdfab", "type": "number", "answer": 395368, "_code": "\nn=DanhSachNhapHang.copy(); n['dt']=parse_date(n['Thời gian'])\no=n[(n.dt>='2025-05-01')&(n.dt<='2025-05-31')&~n['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]['Mã nhập hàng']\nc=DanhSachChiTietNhapHang[DanhSachChiTietNhapHang['Mã nhập hàng'].isin(o)&(DanhSachChiTietNhapHang['Mã hàng']=='SP0002')&(DanhSachChiTietNhapHang['ĐVT']=='thùng')].copy()\nc['q']=to_num(c['Số lượng']); c['p']=to_num(c['Đơn giá'])\nRESULT=int(round((c.q*c.p).sum()/c.q.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4cecccad0919", "type": "percent", "answer": -30.23, "_code": "\nd=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True)\nd['t']=parse_date(d['Ngày']); d['q']=to_num(d['Số lượng quy đổi'])\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]\nd=d[d['Tên hàng hóa'].str.strip().str.lower()=='nước ép dưa hấu (l)']\nD=pd.Timestamp('2025-11-25'); N=14\na=d[(d.t>=D)&(d.t<D+pd.Timedelta(days=N))].q.sum(); b=d[(d.t>=D-pd.Timedelta(days=N))&(d.t<D)].q.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_87d9230ff9e9", "type": "number", "answer": 109636000, "_code": "\nimport pandas as pd, unicodedata as ud, re\ndef nz(x):\n    x=ud.normalize('NFD',str(x).lower().replace('đ','d')).encode('ascii','ignore').decode()\n    return re.sub(r'\\s+',' ',x).strip()\ns=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True)\ns['dt']=parse_date(s['Ngày'])\ns['a']=pd.to_numeric(s['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\ns['n']=s['Tên hàng hóa'].map(nz)\nbad=s['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Hoàn trả',case=False,na=False)\nok=s[~bad]\ng=[v for k,v in data.items() if ud.normalize('NFC',k).startswith('Danh sách')][0]\n\nnames=set(g[g['Nhóm hàng hóa'].astype(str).str.strip().str.lower()=='cà phê']['Tên hàng hóa'].map(nz))\nx=ok[(ok.dt>='2025-10-01')&(ok.dt<='2025-10-31')&ok.n.isin(names)]\nRESULT=int(round(x.a.sum()))", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c2cf63cc7bc0", "type": "percent", "answer": 30.43, "_code": "\nimport pandas as pd, unicodedata as ud, re\ndef nz(x):\n    x=ud.normalize('NFD',str(x).lower().replace('đ','d')).encode('ascii','ignore').decode()\n    return re.sub(r'\\s+',' ',x).strip()\ns=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True)\ns['dt']=parse_date(s['Ngày'])\ns['a']=pd.to_numeric(s['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\ns['n']=s['Tên hàng hóa'].map(nz)\nbad=s['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Hoàn trả',case=False,na=False)\nok=s[~bad]\ng=[v for k,v in data.items() if ud.normalize('NFC',k).startswith('Danh sách')][0]\n\nx=ok[ok.n==nz('Topping Kem cheese')].copy()\nx['q']=pd.to_numeric(x['Số lượng quy đổi'],errors='coerce')\nD=pd.Timestamp('2025-11-25')\na=x[(x.dt>=D)&(x.dt<=D+pd.Timedelta(days=13))].q.sum()\nb=x[(x.dt>=D-pd.Timedelta(days=14))&(x.dt<=D-pd.Timedelta(days=1))].q.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a536e1622568", "type": "percent", "answer": 4.83, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\nd=don_hang.copy(); d['dt']=pd.to_datetime(d['Ngày bán'])\nd=d[~d['Tình trạng đơn'].str.contains('cancel|return',case=False,na=False)]\nc=chi_tiet_don.drop_duplicates()\nc=c[c['Số CT'].isin(d['Số phiếu'])].merge(d[['Số phiếu','dt']],left_on='Số CT',right_on='Số phiếu')\nc['v']=c['Tiền bán'].map(money)\ndef rev(y,m): return c[(c.dt.dt.year==y)&(c.dt.dt.month==m)].v.sum()\nRESULT=f\"{(rev(2025,5)-rev(2025,4))/rev(2025,4)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_af669cdf2e81", "type": "percent", "answer": -50.0, "_code": "import pandas as pd, re, datetime as dt\nITEM='Nước ép dưa hấu (L)'; D=pd.Timestamp('2025-11-25'); N=7\nframes=[v for k,v in data.items() if k.endswith('__all')]\na=pd.concat(frames,ignore_index=True)\ncid,cdate,citem,cst,cq='Mã đơn hàng','Ngày','Tên hàng hóa','Trạng thái','Số lượng quy đổi'\na=a[a[cid].astype(str).str.startswith('ORD')].drop_duplicates()\ndef pdate(x):\n    if isinstance(x,(int,float)) and not pd.isna(x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(x))\n    if hasattr(x,'year'): return pd.Timestamp(x)\n    s=str(x).strip()\n    if re.match(r'^\\d{4}-\\d{2}-\\d{2}',s): return pd.Timestamp(s[:10])\n    return pd.to_datetime(s,dayfirst=True,errors='coerce')\na['d']=a[cdate].map(pdate)\nbad=a[cst].astype(str).str.lower().str.contains('hủy|huỷ|cancel|trả|hoàn hàng|đổi trả')\na=a[~a[cid].isin(set(a[bad][cid]))]\nx=a[a[citem].astype(str).str.strip().str.lower()==ITEM.lower()].copy()\nx['q']=pd.to_numeric(x[cq],errors='coerce')\ndef S(lo,hi): return x[(x.d>=lo)&(x.d<=hi)].q.sum()\naft=S(D,D+pd.Timedelta(days=N-1)); bef=S(D-pd.Timedelta(days=N),D-pd.Timedelta(days=1))\nprint(aft,bef,x.d.isna().sum())\nRESULT=f\"{round((aft-bef)/bef*100,2)}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_9ebd7e03c206", "type": "percent", "answer": -16.12, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return 0.0\n    m=re.match(r'^(-?\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)tr$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000000)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)k$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000)\n    if re.match(r'^-?\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(re.sub(r'[^\\d.\\-]','',s) or 0)\ndf=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True)\ndf=df[df['Mã hóa đơn'].notna()].drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày giao dịch'])\ndf['t']=pd.to_datetime(df['Giờ'])\ndf['v']=df['Trị giá'].map(money)\ndf['q']=pd.to_numeric(df['so_luong'],errors='coerce')\nbadst=df['Status'].str.contains('hủy|huỷ|trả|Đổi trả',case=False,na=False)|(df['q']<0)\nbad_orders=set(df.loc[badst,'Mã hóa đơn'])\nok=df[~df['Mã hóa đơn'].isin(bad_orders)]\ns=pd.Timestamp(as_of_date); mon=s-pd.Timedelta(days=s.weekday()+7); sun=mon+pd.Timedelta(days=6)\nw=ok[(ok.d>=mon)&(ok.d<=sun)]\nhr=w.t.dt.hour\nsa=w[(hr>=6)&(hr<14)].v.sum(); ch=w[(hr>=14)&(hr<22)].v.sum()\nRESULT=f\"{round((ch-sa)/sa*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8c9ba8fc149b", "type": "percent", "answer": 84.0, "_code": "import pandas as pd, re, datetime as dt\nITEM='Trà chanh (L)'; D=pd.Timestamp('2025-03-27'); N=7\nframes=[v for k,v in data.items() if k.endswith('__all')]\na=pd.concat(frames,ignore_index=True)\ncid,cdate,citem,cst,cq='Mã hóa đơn','Ngày giao dịch','Hàng','Status','so_luong'\na=a[a[cid].astype(str).str.startswith('ORD')].drop_duplicates()\ndef pdate(x):\n    if isinstance(x,(int,float)) and not pd.isna(x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(x))\n    if hasattr(x,'year'): return pd.Timestamp(x)\n    s=str(x).strip()\n    if re.match(r'^\\d{4}-\\d{2}-\\d{2}',s): return pd.Timestamp(s[:10])\n    return pd.to_datetime(s,dayfirst=True,errors='coerce')\na['d']=a[cdate].map(pdate)\nbad=a[cst].astype(str).str.lower().str.contains('hủy|huỷ|cancel|trả|hoàn hàng|đổi trả')\na=a[~a[cid].isin(set(a[bad][cid]))]\nx=a[a[citem].astype(str).str.strip().str.lower()==ITEM.lower()].copy()\nx['q']=pd.to_numeric(x[cq],errors='coerce')\ndef S(lo,hi): return x[(x.d>=lo)&(x.d<=hi)].q.sum()\naft=S(D,D+pd.Timedelta(days=N-1)); bef=S(D-pd.Timedelta(days=N),D-pd.Timedelta(days=1))\nprint(aft,bef,x.d.isna().sum())\nRESULT=f\"{round((aft-bef)/bef*100,2)}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_e736042784fe", "type": "number", "answer": 204125100, "_code": "import re\ndef money(s):\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s in('','nan','none'): return 0.0\n    m=re.match(r'^(-?\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1000000+(int((m.group(2)+'000')[:3])*1000 if m.group(2) else 0)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)tr$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000000)\n    m=re.match(r'^(-?\\d+(?:[.,]\\d+)?)k$',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1000)\n    if re.match(r'^-?\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(re.sub(r'[^\\d.\\-]','',s) or 0)\ndf=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True)\ndf=df[df['Mã hóa đơn'].notna()].drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày giao dịch'])\ndf['t']=pd.to_datetime(df['Giờ'])\ndf['v']=df['Trị giá'].map(money)\ndf['q']=pd.to_numeric(df['so_luong'],errors='coerce')\nbadst=df['Status'].str.contains('hủy|huỷ|trả|Đổi trả',case=False,na=False)|(df['q']<0)\nbad_orders=set(df.loc[badst,'Mã hóa đơn'])\nok=df[~df['Mã hóa đơn'].isin(bad_orders)]\nw=ok[(ok.d>='2025-10-01')&(ok.d<='2025-10-31')]\nhr=w.t.dt.hour\nRESULT=int(round(w[(hr>=6)&(hr<14)].v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_55f248332e17", "type": "number", "answer": 244603500, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=float('nan')\n    return -v if neg else v\n\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\ncols=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[cols]=d[cols].ffill()\nd=d.drop_duplicates()\nd['t']=parse_date(d['Ngày đặt hàng']); d['m']=d['Tổng tiền'].apply(money)\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nA=pd.Timestamp(as_of_date)\nRESULT=round(d[(d.t>A-pd.Timedelta(days=30))&(d.t<=A)].m.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c893acce3ef3", "type": "number", "answer": 236132200, "_code": "\ns=ban_hang.copy(); s['dt']=parse_date(s['Ngày tháng'])\ns=s[(s.dt>='2026-07-01')&(s.dt<='2026-07-31')]\ns=s[~s['Kết quả'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nRESULT=int(round(pd.to_numeric(s['Thanh tien'].astype(str).str.replace(',',''),errors='coerce').sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8abb824689fc", "type": "number", "answer": 2138, "_code": "\nimport pandas as pd\ns=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True)\ns=s[s['Mã hóa đơn'].notna()].drop_duplicates()\ns['q']=pd.to_numeric(s['so_luong'],errors='coerce')\ns['dt']=parse_date(s['Ngày giao dịch'])\nretord=set(s[s.q<0]['Mã hóa đơn'])\nbad=s['Status'].str.contains('hủy|huỷ|trả|đổi',case=False,na=False)|s['Mã hóa đơn'].isin(retord)\nbadord=set(s[bad]['Mã hóa đơn'])\nx=s[~s['Mã hóa đơn'].isin(badord)]\nx=x[(x.dt>='2025-02-01')&(x.dt<='2025-02-28')&x['Hàng'].str.strip().str.lower().str.endswith('(l)')&(x['Unit']=='ly')]\nRESULT=int(x.q.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_41c360c34398", "type": "number", "answer": 3030, "_code": "\na=DonHang_ChiTiet.drop_duplicates().copy()\nbad=set(a[a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'])\na=a[~a['Mã đơn hàng'].isin(bad)].copy()\na['dt']=parse_date(a['Ngày đặt hàng']); a['v']=to_num(a['Tổng tiền']); a['p']=to_num(a['Giá sản phẩm'])\na['q']=pd.to_numeric(a['Số lượng sản phẩm'],errors='coerce')\na['q']=a['q'].fillna((a.v/a.p).round())\n\nx=a[(a.dt>='2025-04-01')&(a.dt<='2025-04-30')&a['Tên sản phẩm'].map(normalize_text).str.endswith('(m)')&(a['Đơn vị tính']=='ly')]\nRESULT=int(x.q.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a061449d15fe", "type": "number", "answer": 48, "_code": "h=DuLieuBanHang['DanhSachHoaDon'].copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả|hoàn hàng',case=False)]\nRESULT=int(h[h.d=='2026-03-06']['Mã hóa đơn'].nunique())\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_8a2a46882e39", "type": "number", "answer": 11416900, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\nd=DanhSachHoaDon.copy()\nd['dt']=pd.to_datetime(d['Thời gian'],format='%d/%m/%Y')\nyd=pd.Timestamp(as_of_date)-pd.Timedelta(days=1)\nd=d[(d.dt==yd)&~d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(d['Mã hóa đơn'])]\nRESULT=int(round(c['Thành tiền'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e20aeef40c7f", "type": "number", "answer": 166209, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\nd=DanhSachHoaDon.copy()\nd['dt']=pd.to_datetime(d['Thời gian'],format='%d/%m/%Y')\nd=d[(d.dt>='2025-11-01')&(d.dt<='2025-11-30')&~d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(d['Mã hóa đơn'])]\nRESULT=int(np.floor(c['Thành tiền'].map(money).sum()/d['Mã hóa đơn'].nunique()+0.5))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1af02cd5fe06", "type": "number", "answer": 44, "_code": "\na=ban_hang.drop_duplicates().copy()\nbad=set(a[a['Kết quả'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)]['Mã hóa đơn'])\na=a[~a['Mã hóa đơn'].isin(bad)].copy(); a['dt']=parse_date(a['Ngày tháng'])\nRESULT=int(a[a.dt=='2026-04-13']['Mã hóa đơn'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
