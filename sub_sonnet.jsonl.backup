{"id": "q_47f3584a37c9", "type": "string", "answer": "Ông Trang Đạt", "_code": "\no=BanHang_HoaDon.drop_duplicates('Order ID').copy()\no['d']=parse_date(o['Ngày bán'])\no=o[(o.d>='2025-07-01')&(o.d<='2025-07-31')&o['Mã KH mua'].notna()&~o['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả|Đổi trả|cancel',case=False)]\nl=BanHang_ChiTietHoaDon.drop_duplicates()\nl=l[l['Mã giao dịch'].isin(o['Order ID'])].copy()\nl['m']=pd.to_numeric(l['Thanh tien'].astype(str).str.replace(',',''),errors='coerce')\nt=l.merge(o[['Order ID','Mã KH mua','Tên KH']],left_on='Mã giao dịch',right_on='Order ID')\nRESULT=t.groupby('Mã KH mua')['m'].sum().idxmax()\nk=RESULT; RESULT=t[t['Mã KH mua']==k]['Tên KH'].iloc[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b1feb7411099", "type": "date", "answer": "2028-11-20", "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\nsp=san_pham[san_pham.TenGoi.str.contains('Kẹo ngậm Bổ phế Nam Hà Candy',na=False)]\ncode=sp.MaHangHoa.iloc[0]\nct=chi_tiet_nhap[chi_tiet_nhap.MaHangHoa==code].merge(phieu_nhap[['MaPhieuNhap','NgayNhapKho']],on='MaPhieuNhap')\nct=ct[pd.to_datetime(ct.NgayNhapKho)<=pd.Timestamp(as_of_date)]\nlots=lo_hang[lo_hang.MaLo.isin(ct.MaLo)].copy()\nok=don_hang[don_hang.TinhTrang!='cancelled'][['MaHoaDon']]\nl=chi_tiet_don_lo.merge(ok,on='MaHoaDon')\nfor c in ('SLQuyDoi','SLTraQuyDoi'): l[c]=pd.to_numeric(l[c],errors='coerce').fillna(0)\nused=l.groupby('MaLo').SLQuyDoi.sum()-l.groupby('MaLo').SLTraQuyDoi.sum()\nlots['rem']=pd.to_numeric(lots.SLNhapQuyDoi,errors='coerce')-lots.MaLo.map(used).fillna(0)\nlots['hsd']=pd.to_datetime(lots.HanSuDung)\nv=lots[(lots.rem>0)&(lots.hsd>=pd.Timestamp(as_of_date))].sort_values('hsd')\nRESULT=str(v.hsd.iloc[0].date())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b06f9ddf5419", "type": "string", "answer": "Mai Dương Dương", "_code": "o=don_hang.drop_duplicates('MaHoaDon').copy()\no['d']=parse_date(o['ThoiGianLap']).dt.normalize()\no=o[o.TinhTrang.isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().merge(o[['MaHoaDon','d','MaKhachHang']],on='MaHoaDon')\nc['v']=to_num(c['TriGia']); c['cost']=to_num(c['SL'])*to_num(c['GiaVonLucBan'])\nt=pd.Timestamp(as_of_date); s=t-pd.Timedelta(days=t.weekday())\nx=c[(c.d>=s)&(c.d<=t)&c.MaKhachHang.notna()]\nk=x.groupby('MaKhachHang').v.sum().idxmax()\nRESULT=khach_hang.set_index('MaKhachHang').TenGoi[k]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8217870b6fa8", "type": "string", "answer": "Costar Glucosamine HCl 1500mg lọ 30 viên", "_code": "o=don_hang.drop_duplicates('MaHoaDon').copy()\no['d']=parse_date(o['ThoiGianLap']).dt.normalize()\no=o[o.TinhTrang.isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().merge(o[['MaHoaDon','d','MaKhachHang']],on='MaHoaDon')\nc['v']=to_num(c['TriGia']); c['cost']=to_num(c['SL'])*to_num(c['GiaVonLucBan'])\nx=c[(c.d>='2025-07-01')&(c.d<='2025-07-31')].copy(); x['p']=x.v-x.cost\nk=x.groupby('MaHangHoa').p.sum().idxmax()\nRESULT=san_pham.set_index('MaHangHoa').TenGoi[k]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_91256346c432", "type": "percent", "answer": 6.72, "_code": "import re\ndef pm(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,'0')[:3])*1000 if f else 0) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'(\\d+[.,]\\d+)\\s*(?:tr|triệu)',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1e6)\n    m=re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+\\.\\d+',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    if re.fullmatch(r'\\d+[.,]\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\no=don_hang.copy(); o['dt']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().merge(o[['Số phiếu','dt']],left_on='Số CT',right_on='Số phiếu')\nc['t']=c['Tiền bán'].apply(pm)\nprint(c.t.isna().sum())\ndef rev(y,m): return c[(c.dt.dt.year==y)&(c.dt.dt.month==m)].t.sum()\nRESULT=f\"{round((rev(2026,7)-rev(2026,6))/rev(2026,6)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_68d262d101db", "type": "list", "answer": [5005901, 4768387, 5155326], "_code": "\nh=DuLieuBanHang__DanhSachHoaDon.copy(); s=DuLieuBanHang__SoQuy.copy()\nh['dt']=pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh['tot']=to_num(h['Tổng sau giảm giá'])\nasof=pd.Timestamp(as_of_date)\nh=h[(h.dt<=asof)&~h['Trạng thái'].str.contains('hủy|huỷ',na=False)&(h['Phương thức thanh toán']!='Thu hộ (COD)')]\ns['t']=pd.to_datetime(s['Thời gian']).dt.normalize()\npaid=s[s.t<=asof].groupby('Mã hóa đơn')['Giá trị'].apply(lambda x:to_num(x).sum())\nh['paid']=h['Mã hóa đơn'].map(paid).fillna(0)\nh['debt']=h.tot-h.paid\nh=h[h.debt>0]\nh['age']=(asof-h.dt).dt.days\nr=[h[(h.age<=7)].debt.sum(),h[(h.age>=8)&(h.age<=15)].debt.sum(),h[h.age>15].debt.sum()]\nRESULT=[int(round(x)) for x in r]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_33c1739f7daf", "type": "percent", "answer": 13.87, "_code": "import re\ndef m1(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr',1)\n        if re.search(r'[,\\.]',a): return float(a.replace(',','.'))*1000000\n        return int(a or 0)*1000000+(int(b.ljust(3,'0'))*1000 if b else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    neg=s.startswith('-')\n    v=float(re.sub(r'[^\\d]','',s) or 0)\n    return -v if neg else v\na=SoBanHang__all.drop_duplicates().copy()\na['d']=pd.to_datetime(a['Giờ'],errors='coerce').dt.normalize()\nbad=a.groupby('Mã phiếu')['Ghi chú TT'].apply(lambda s:s.str.contains('hủy|huỷ|trả',case=False).any())\na=a[a['Mã phiếu'].isin(bad[~bad].index)]\na['amt']=a['Tiền'].map(m1)\ndef r(s,e): return a[(a.d>=s)&(a.d<=e)].amt.sum()\ncur=r('2026-05-01','2026-05-07'); prev=r('2026-04-01','2026-04-07')\nRESULT=f\"{round((cur-prev)/prev*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e0c049730523", "type": "list", "answer": ["Hoàng Trung Long", "Ngô Thu Hùng", "Hà Nam Bình", "Châu Chi Giang", "Tăng Mai Thảo"], "_code": "import re\ndef pm(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,'0')[:3])*1000 if f else 0) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'(\\d+[.,]\\d+)\\s*(?:tr|triệu)',s)\n    if m: return round(float(m.group(1).replace(',','.'))*1e6)\n    m=re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+\\.\\d+',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    if re.fullmatch(r'\\d+[.,]\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\no=don_hang.copy(); o['dt']=parse_date(o['Ngày bán'])\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])&o['Mã khách mua'].notna()]\no=o[(o.dt>='2026-06-01')&(o.dt<='2026-06-30')]\nc=chi_tiet_don.drop_duplicates().merge(o[['Số phiếu','Mã khách mua']],left_on='Số CT',right_on='Số phiếu')\nc['t']=c['Tiền bán'].apply(pm)\ng=c.groupby('Mã khách mua').t.sum().reset_index().sort_values(['t','Mã khách mua'],ascending=[False,True]).head(5)\nnm=dict(zip(khach_hang['Mã khách lẻ/sỉ'],khach_hang['KH']))\nRESULT=[nm[k] for k in g['Mã khách mua']]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_faf7802261fb", "type": "unanswerable", "answer": "unanswerable", "_code": "\ncols=[c for t in (SoBanHang_1__all,SoBanHang_2026__all) for c in t.columns]\nRESULT='unanswerable' if not any(('nợ' in c.lower() or 'thanh toán' in c.lower() or 'đã trả' in c.lower()) for c in cols) else 'has debt'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_725f54f95253", "type": "date", "answer": "2026-07-30", "_code": "\ndf=ban_hang.drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày tháng'])\nbad=df[df['Kết quả'].astype(str).str.contains('hủy|huỷ|trả|hoàn|cancel',case=False)&~df['Kết quả'].astype(str).str.contains('hoàn thành',case=False)]['Mã hóa đơn'].unique()\ndf=df[~df['Mã hóa đơn'].isin(bad)&(df.d>='2026-07-01')&(df.d<='2026-07-31')]\ndf['m']=pd.to_numeric(df['Thanh tien'].astype(str).str.replace(',',''),errors='coerce')\nRESULT=df.groupby('d')['m'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
