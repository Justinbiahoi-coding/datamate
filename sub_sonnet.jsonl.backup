{"id": "q_28ce28381db2", "type": "date", "answer": "2025-12", "_code": "\nd=DonHang_ChiTiet.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[h]=d[h].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['m']=to_num(d['Tổng tiền'])\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nd['ym']=d.dt.dt.strftime('%Y-%m')\ns=d[d.ym.isin(['2025-11','2025-12','2026-01'])].groupby('ym').m.sum()\nRESULT=s.idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5e16fe0cf0b5", "type": "list", "answer": ["Châu Thanh Tâm", "Tạ Hoa Long", "Dương Hà Thu", "Trần An Hoa", "Tăng Tâm Minh"], "_code": "import re\ndef m1(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr',1)\n        if re.search(r'[,\\.]',a): return float(a.replace(',','.'))*1000000\n        return int(a or 0)*1000000+(int(b.ljust(3,'0'))*1000 if b else 0)\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    neg=s.startswith('-')\n    v=float(re.sub(r'[^\\d]','',s) or 0)\n    return -v if neg else v\no=don_hang.copy()\no=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\no['d']=pd.to_datetime(o['Ngày bán'])\nids=o[(o.d.dt.year==2025)&(o.d.dt.month==2)&o['Mã khách mua'].notna()]\nc=chi_tiet_don.drop_duplicates().copy(); c['amt']=c['Tiền bán'].map(m1)\nc=c[c['Số CT'].isin(ids['Số phiếu'])].merge(ids[['Số phiếu','Mã khách mua']],left_on='Số CT',right_on='Số phiếu')\ng=c.groupby('Mã khách mua')['amt'].sum().sort_values(ascending=False).head(5)\nnm=khach_hang.set_index('Mã khách lẻ/sỉ')['KH']\nRESULT=[nm[k] for k in g.index]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b5f5bdce03ca", "type": "string", "answer": "Lưu Thảo Minh", "_code": "\ndf=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày'])\ndf['m']=pd.to_numeric(df['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\n# status per order: any line cancel/return -> whole order excluded\nbad=df[df['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả|zzzz',case=False)]['Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\n\nt=pd.Timestamp(as_of_date); s=t-pd.Timedelta(days=t.weekday()+7); e=s+pd.Timedelta(days=6)\nw=df[(df.d>=s)&(df.d<=e)&~df['Khách hàng'].astype(str).str.contains('lẻ|^kl$',case=False)]\nRESULT=w.groupby('Khách hàng')['m'].sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ec5c0d7eed96", "type": "unanswerable", "answer": "unanswerable", "_code": "RESULT='unanswerable'  # no cancel-reason column in biz_118 (only Trạng thái 'hủy')", "_attempts": 1, "_verdict": "correct"}
{"id": "q_065aa2aac90c", "type": "date", "answer": "2026-02-05", "_code": "import re\ndef pm(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,'0')[:3])*1000 if f else 0) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+\\.\\d+',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    if re.fullmatch(r'\\d+[.,]\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\nd=ban_hang.copy()\nd['dt']=parse_date(d['Ngày'])\nbad=d[d.trang_thai.isin(['Đã hủy đơn','Trả hàng'])]['Mã GD'].unique()\nd=d[~d['Mã GD'].isin(bad)].drop_duplicates()\nd=d[(d.dt>='2026-02-01')&(d.dt<='2026-02-28')]\nd['t']=d['Tổng'].apply(pm)\nRESULT=d.groupby('dt').t.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_10dae9bfeec3", "type": "string", "answer": "Xi măng Hà Tiên PCB40 bao 50kg", "_code": "d=ban_hang.copy()\nd['dt']=parse_date(d['Ngày'])\nbad=d[d.trang_thai.isin(['Đã hủy đơn','Trả hàng'])]['Mã GD'].unique()\nd=d[~d['Mã GD'].isin(bad)].drop_duplicates()\nd=d[(d.dt>='2025-08-01')&(d.dt<='2025-08-31')]\nd['q']=pd.to_numeric(d['Quy ra ĐV lẻ'].astype(str).str.extract(r'^\\s*([\\d.]+)')[0],errors='coerce')\nRESULT=d.groupby('Sản phẩm').q.sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5bcdb1713b89", "type": "list", "answer": [92090000, 430962500], "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if 'tr' in s:\n        a,b=s.split('tr'); return float(a.replace(',','.'))*1e6 if b=='' else float(a)*1e6+float(b.ljust(3,'0'))*1e3\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1e3\n    return float(s.replace('.','').replace(',',''))\no=don_hang.drop_duplicates().copy(); o['d']=parse_date(o['Ngày bán'])\no=o[(o.d>='2026-06-01')&(o.d<'2026-07-01')&~o['Tình trạng đơn'].isin(['cancelled','returned'])]\nc=chi_tiet_don.drop_duplicates().copy(); c['amt']=c['Tiền bán'].apply(money)\ns=c.groupby('Số CT').amt.sum()\nf=lambda k: int(s.reindex(o[o['Hình thức thanh toán']==k]['Số phiếu']).sum())\nRESULT=[f('ewallet'),f('cash')]", "_attempts": 2, "_verdict": "correct"}
{"id": "q_61e8485825b3", "type": "date", "answer": "2025-10-18", "_code": "\nh=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh=h[~h['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả',case=False)]\nh['d']=parse_date(h['Thời gian']); h['m']=pd.to_numeric(h['Tổng tiền hàng'].astype(str).str.replace(',',''),errors='coerce')\nh=h[(h.d>='2025-10-01')&(h.d<='2025-10-31')]\nRESULT=h.groupby('d')['m'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_88f4eaa9981e", "type": "string", "answer": "Đặng Ngọc Đạt", "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=DonHang_ChiTiet.copy()\noc=[c for c in df.columns if df[c].isna().mean()>0.3 and c!='Tổng tiền']\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\nst=df['Trạng thái đơn hàng'].astype(str).str.lower()\nbad=set(df.loc[st.str.contains('hủy|huỷ|hoàn hàng|trả'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf['d']=parse_date(df['Ngày đặt hàng']); df['a']=df['Tổng tiền'].map(m)\nw=df[(df.d>='2025-12-01')&(df.d<'2026-01-01')]\nw=w[~w['Tên khách hàng'].astype(str).str.lower().str.strip().isin(['khách lẻ','kl','lẻ','khach le'])]\nRESULT=w.groupby('Tên khách hàng').a.sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ef173115902d", "type": "unanswerable", "answer": "unanswerable", "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\nmn=min(parse_date(So_chi_tiet_ban_hang_1__all['Ngày']).min(),parse_date(So_chi_tiet_ban_hang_2026__all['Ngày']).min())\nmx=max(parse_date(So_chi_tiet_ban_hang_1__all['Ngày']).max(),parse_date(So_chi_tiet_ban_hang_2026__all['Ngày']).max())\na,b=pd.Timestamp('2025-02-01'),pd.Timestamp('2025-02-28')\nRESULT='unanswerable' if (b<mn or a>mx) else 'in range %s %s'%(mn,mx)\n", "_attempts": 1, "_verdict": "correct"}
