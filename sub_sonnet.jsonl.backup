{"id": "q_763e48cae1bb", "type": "percent", "answer": 5.87, "_code": "h=BanHang_HoaDon.drop_duplicates().copy()\nh['d']=parse_date(h['Ngày bán'])\nh=h[(h.d.dt.year==2025)&(h.d.dt.month==10)]\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao',case=False,na=False)]\nl=BanHang_ChiTietHoaDon.drop_duplicates()\nl=l[l['Mã giao dịch'].isin(h['Order ID'])].copy()\nl['v']=to_num(l['Thanh tien'])\nm=dict(zip(BanHang_HangHoa['ma_sp'],BanHang_HangHoa['Phân loại']))\nl['g']=l['Ma hang'].map(m)\nRESULT=f\"{round(l[l.g=='giảm đau hạ sốt'].v.sum()/l.v.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d5cc7e3df5fb", "type": "percent", "answer": 1.16, "_code": "df=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[oc]=df[oc].ffill()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[(df.d>='2026-04-01')&(df.d<='2026-04-30')]\no=df.drop_duplicates('Mã đơn hàng')\nc=o['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False,na=False).sum()\nRESULT=f\"{round(c/len(o)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_93d4030bafe4", "type": "number", "answer": 156, "_code": "h=don_hang.copy()\nh['d']=parse_date(h['NgayLap'])\nh=h[(h.d.dt.year==2025)&(h.d.dt.month==12)]\nh=h[h['TinhTrang'].isin(['completed','shipping'])]\nh=h[h['MaKhachHang'].notna()&(h['MaKhachHang'].astype(str).str.strip()!='')]\nc=h.groupby('MaKhachHang')['MaHoaDon'].nunique()\nRESULT=int((c>=4).sum())\n", "_attempts": 1, "_verdict": "correct"}
