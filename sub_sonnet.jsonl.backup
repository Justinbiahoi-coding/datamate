{"id": "q_0a76d3680594", "type": "table", "answer": {"columns": ["khach_hang", "so_tien_no"], "rows": [["Đỗ Đức An", 404500], ["Dương Tâm Bích", 158600], ["Phùng Hồng Nam", 126000], ["Bạch Dương Phúc", 116000], ["La Dương Thu", 92000]]}, "_code": "o=don_hang.copy(); o['d']=parse_date(o['NgayLap'])\no=o[(o.d<=as_of_date)&(o.TinhTrang!='cancelled')&(o.PhuongThucTT!='cod')&o.MaKhachHang.notna()]\nt=thanh_toan.copy(); t['dt']=pd.to_datetime(t.NgayGioThu).dt.normalize()\npaid=t[t.dt<=as_of_date].groupby('MaHoaDon').SoTienThu.sum()\no['debt']=o.TongThanhToan-o.MaHoaDon.map(paid).fillna(0)\no=o[o.debt>0]\ns=o.groupby('MaKhachHang').debt.sum().nlargest(5)\nnm=khach_hang.set_index('MaKhachHang').TenGoi\nRESULT={\"columns\":[\"khach_hang\",\"so_tien_no\"],\"rows\":[[nm[k],int(v)] for k,v in s.items()]}", "_attempts": 1, "_verdict": "correct"}
{"id": "q_62bcb2923258", "type": "string", "answer": "Trương Long Hoa", "_code": "import re as _re\ndef money(x):\n    s=str(x).strip().lower()\n    m=_re.match(r'^(-?)(\\d+)tr(\\d{1,3})?$',s)\n    if m:\n        v=int(m.group(2))*10**6+(int(m.group(3).ljust(3,'0'))*1000 if m.group(3) else 0)\n        return -v if m.group(1) else v\n    d=_re.sub(r'[^\\d\\-]','',s)\n    return int(d) if d not in ('','-') else 0\no = SoBanHang__all.copy()\no['d'] = parse_date(o['Giờ'])\no['st'] = o['Ghi chú TT'].astype(str).str.strip().str.lower()\ncanc = set(o[o.st.isin(['hủy'])]['Mã phiếu'])\nret = set(o[o.st.isin(['trả lại','đã trả hàng'])]['Mã phiếu'])\no['amt'] = o['Tiền'].map(money)\no['kh'] = o['TenKH'].astype(str).map(normalize_text)\nod = o.groupby('Mã phiếu').agg(d=('d','min'), kh=('kh','first'), name=('TenKH','first'), amt=('amt','sum'))\nod['canc'] = od.index.isin(canc); od['ret'] = od.index.isin(ret)\ngood = od[~od.canc & ~od.ret]\ndef rng(a,b): return good[(good.d>=a)&(good.d<=b+' 23:59:59')]\ndef nonlee(df): return df[~df.kh.isin(['khach le','kl','le',''])]\ng = nonlee(rng('2025-08-01','2025-08-31')).groupby('kh').agg(a=('amt','sum'), n=('name','first')).sort_values('a',ascending=False)\nRESULT = g.iloc[0].n\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b403f2ea71e5", "type": "percent", "answer": -55.0, "_code": "h = DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['d'] = parse_date(h['Thời gian'])\nbad = h['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả', case=False, na=False)\nh = h[~bad][['Mã hóa đơn','d']]\nl = pd.concat([DanhSachHoaDonChiTiet_1, DanhSachHoaDonChiTiet_2])\nl = l[l['Tên hàng'].str.lower().str.strip()=='espresso (double)']\nl = l.merge(h, on='Mã hóa đơn')\nq = to_num(l['Số lượng quy đổi'])\nD = pd.Timestamp('2026-02-06')\nafter = q[(l['d']>=D)&(l['d']<D+pd.Timedelta(days=7))].sum()\nbefore = q[(l['d']>=D-pd.Timedelta(days=7))&(l['d']<D)].sum()\nRESULT = f\"{round((after-before)/before*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
