{"id": "q_5b6c3a6fc740", "type": "date", "answer": "2025-03-20", "_code": "df=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\ndf=df[~df['Trạng thái'].isin(['Đã hủy','Đã trả hàng'])]\nbad=So_chi_tiet_ban_hang__all[So_chi_tiet_ban_hang__all['Trạng thái'].isin(['Đã hủy','Đã trả hàng'])]['Mã đơn hàng'].unique()\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf['d']=pd.to_datetime(df['Ngày'],format='%d/%m/%Y',errors='coerce')\ndf=df[(df.d>='2025-03-01')&(df.d<='2025-03-31')]\ndf['m']=df['Thành tiền'].astype(str).str.replace(',','').astype(float)\nRESULT=df.groupby('d')['m'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e92262825aa0", "type": "list", "answer": ["Mì Hảo Hảo tôm chua cay", "Trứng gà so", "Gạo ST25", "Mì Omachi sườn hầm", "Pepsi 330ml"], "_code": "h=DanhSachHoaDon.drop_duplicates().copy()\nh['d']=pd.to_datetime(h['Thời gian'],format='%d/%m/%Y',errors='coerce')\nok=h[(h.d>='2025-11-01')&(h.d<='2025-11-30')&h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]['Mã hóa đơn'].unique()\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(ok)].copy()\nc['q']=to_num(c['Số lượng quy đổi'])\ng=c.groupby('Mã hàng')['q'].sum().reset_index().sort_values(['q','Mã hàng'],ascending=[False,True]).head(5)\nnm=DanhSachSanPham.set_index('Mã hàng')['Tên hàng']\nRESULT=[nm[x] for x in g['Mã hàng']]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_04ad09f4f1fc", "type": "date", "answer": "2025-03-01", "_code": "d=ban_hang.drop_duplicates().copy()\nd['dt']=pd.to_datetime(d['Ngày bán'],format='%d/%m/%Y')\nd=d[d['Trạng thái xử lý'].isin(['Đã hoàn thành','Đang xử lý'])&(d.dt>='2025-03-01')&(d.dt<='2025-03-31')]\nd['m']=d['Amount'].astype(str).str.replace(',','').astype(float)\nRESULT=d.groupby('dt')['m'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_281d6d8a83c6", "type": "list", "answer": [389514000, 269031700, 398881600], "_code": "import re\ndef money(x):\n    x=str(x).strip().lower().replace('đ','').replace(' ','')\n    if x in ('','nan','none'): return float('nan')\n    sg=-1 if x.startswith('-') else 1\n    x=x.lstrip('-')\n    m=re.fullmatch(r'(\\d+)(?:[.,](\\d+))?tr(\\d*)',x)\n    if m:\n        v=int(m.group(1))*1000000\n        if m.group(2): v+=round(float('0.'+m.group(2))*1000000)\n        if m.group(3): v+=int(m.group(3).ljust(3,'0'))*1000\n        return sg*v\n    m=re.fullmatch(r'(\\d+)(?:[.,](\\d+))?k',x)\n    if m: return sg*round(float(m.group(1)+'.'+(m.group(2) or '0'))*1000)\n    return sg*float(re.sub(r'\\D','',x) or 0)\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).dropna(subset=['Mã hóa đơn']).drop_duplicates().reset_index(drop=True)\nd['dt']=parse_date(d['Ngày giao dịch'])\nd['q']=to_num(d['so_luong']); d['m']=d['Trị giá'].map(money)\nbad=d[d['Status'].astype(str).str.contains('hủy|huỷ|trả|Trả|hoàn',case=False)|(d.q<0)]['Mã hóa đơn'].unique()\nd=d[~d['Mã hóa đơn'].isin(bad)]\nRESULT=[int(d[(d.dt>=s)&(d.dt<=e)]['m'].sum()) for s,e in [('2026-01-01','2026-01-31'),('2026-02-01','2026-02-28'),('2026-03-01','2026-03-31')]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ac6250fbda50", "type": "number", "answer": 112, "_code": "H=DuLieuBanHang['DanhSachHoaDon'].drop_duplicates().copy()\nH['dt']=pd.to_datetime(H['Thời gian tạo'].astype(str).str[:10])\nH=H[H['Trạng thái'].isin(['đã lấy','Hoàn thành','Đang xử lý'])]\nx=H[(H.dt>='2025-10-01')&(H.dt<='2025-10-31')&H['Mã KH'].notna()]\nn=x.groupby('Mã KH').size()\nRESULT=int((n>=4).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ff23c49dedda", "type": "string", "answer": "Berberin 100mg Mekophar chai 100 viên", "_code": "h=BanHang_HoaDon.copy()\nh['d']=pd.to_datetime(h['Giờ tạo đơn'].astype(str).str[:10])\nok=h[(h.d>='2025-04-28')&(h.d<='2025-05-04')&h['Trạng thái'].isin(['Đã giao','Đang vận chuyển'])]['Order ID']\nc=BanHang_ChiTietHoaDon[BanHang_ChiTietHoaDon['Mã giao dịch'].isin(ok)].copy()\nc['q']=to_num(c['SL cơ bản'])\ng=c.groupby('Ma hang')['q'].sum().reset_index().sort_values(['q','Ma hang'],ascending=[False,True])\nRESULT=BanHang_HangHoa.set_index('ma_sp')['Món'][g.iloc[0]['Ma hang']]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ded44555f479", "type": "percent", "answer": -0.85, "_code": "H=DuLieuBanHang['DanhSachHoaDon'].drop_duplicates().copy()\nH['dt']=pd.to_datetime(H['Thời gian tạo'].astype(str).str[:10])\nH=H[H['Trạng thái'].isin(['đã lấy','Hoàn thành','Đang xử lý'])]\nsp=DuLieuBanHang['DanhSachSanPham']\ncode=sp[sp['Tên hàng'].str.replace(r'\\s+',' ',regex=True).str.contains('Tiger 330ml')]['Mã hàng'].tolist()\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hàng'].isin(code)&c['Mã hóa đơn'].isin(H['Mã hóa đơn'])].merge(H[['Mã hóa đơn','dt']],on='Mã hóa đơn')\nc['q']=to_num(c['Số lượng quy đổi'])\na=c[(c.dt>='2025-06-20')&(c.dt<='2025-07-03')]['q'].sum()\nb=c[(c.dt>='2025-06-06')&(c.dt<='2025-06-19')]['q'].sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b09ceaeabdc5", "type": "string", "answer": "Quách Phúc Hải", "_code": "import re\ndef money(x):\n    x=str(x).strip().lower()\n    m=re.fullmatch(r'(\\d+)(?:[.,](\\d+))?tr(\\d*)',x)\n    if m:\n        v=int(m.group(1))*1000000\n        if m.group(2): v+=round(float('0.'+m.group(2))*1000000)\n        if m.group(3): v+=int(m.group(3).ljust(3,'0'))*1000\n        return v\n    return float(re.sub(r'\\D','',x) or 0)\nh=don_hang.drop_duplicates().copy()\nh['d']=parse_date(h['Ngày bán'])\nh=h[(h.d>='2026-04-01')&(h.d<='2026-04-30')&h['Tình trạng đơn'].isin(['completed','shipping'])&h['Mã khách mua'].notna()]\nc=chi_tiet_don.drop_duplicates()\nc=c[c['Số CT'].isin(h['Số phiếu'])].copy()\nc['m']=c['Tiền bán'].map(money)\nh['r']=h['Số phiếu'].map(c.groupby('Số CT')['m'].sum()).fillna(0)\ng=h.groupby('Mã khách mua')['r'].sum().reset_index().sort_values(['r','Mã khách mua'],ascending=[False,True])\nRESULT=khach_hang.set_index('Mã khách lẻ/sỉ')['KH'][g.iloc[0]['Mã khách mua']]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c58562169cf0", "type": "number", "answer": 1055674500, "_code": "import re\ndef money(x):\n    x=str(x).strip().lower()\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n    if m: return int(m.group(1))*1000000+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    return float(re.sub(r'\\D','',x) or 0)\nh=don_hang.drop_duplicates().copy()\nh['d']=pd.to_datetime(h['Ngày'],errors='coerce')\nok=h[(h.d>='2025-10-01')&(h.d<='2025-10-31')&h['Tình trạng'].isin(['completed','shipping'])]['Mã chứng từ'].unique()\nc=chi_tiet_don.drop_duplicates()\nc=c[c['Mã đơn hàng'].isin(ok)]\nRESULT=int(c['Amount'].map(money).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6e3896c1d2db", "type": "number", "answer": 269053100, "_code": "import unicodedata,re\ndef nk(s):\n    s=unicodedata.normalize('NFD',str(s).lower().replace('đ','d'))\n    s=''.join(c for c in s if unicodedata.category(c)!='Mn')\n    return re.sub(r'\\s+',' ',s).strip()\ndf=DonHang_ChiTiet.copy()\nfor c in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: df[c]=df[c].ffill()\ndf=df.drop_duplicates()\ndf=df[df['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])].copy()\ndf['d']=pd.to_datetime(df['Ngày đặt hàng'],format='%d/%m/%Y')\ndf['m']=df['Tổng tiền'].astype(str).str.replace(',','').astype(float)\nx=df[(df.d>='2026-08-01')&(df.d<='2026-08-31')].copy()\nsp=DuLieuXuat['DanhSachSanPham']; k2s={nk(n):s for n,s in zip(sp['Tên sản phẩm'],sp['Mã SKU'])}\nx['sku']=x['Tên sản phẩm'].map(lambda n:k2s.get(nk(n)))\nth=DuLieuXuat['DanhSachThuoc']\nrx=set(th[th['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1','1.0'])]['Mã SKU'])\nRESULT=int(x[~x['sku'].isin(rx)]['m'].sum()) if x.sku.notna().all() else 'missing'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f1bfb1c1ea00", "type": "percent", "answer": 4.23, "_code": "h=DanhSachHoaDon.drop_duplicates().copy()\nh['d']=pd.to_datetime(h['Thời gian'],format='%d/%m/%Y',errors='coerce')\nh=h[(h.d>='2025-12-01')&(h.d<='2025-12-31')&h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['m']=to_num(c['Thành tiền'])\nrev=c.groupby('Mã hóa đơn')['m'].sum()\nh['r']=h['Mã hóa đơn'].map(rev).fillna(0)\nRESULT=f\"{h[h['Kênh bán']=='zalo_oa']['r'].sum()/h['r'].sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
