{"id": "q_e0287c87f366", "type": "percent", "answer": 4.91, "_code": "\nh=DanhSachHoaDon.copy(); c=DanhSachHoaDonChiTiet.copy()\nh['dt']=parse_date(h['Thời gian'])\nok=h[h['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\n\nok=ok.copy(); ok['v']=to_num(ok['Tổng tiền hàng'])\nf=lambda a,b: ok[(ok.dt>=a)&(ok.dt<=b)]['v'].sum()\ncur=f('2025-08-01','2025-08-31'); pre=f('2025-07-01','2025-07-31')\nRESULT=f\"{round((cur-pre)/pre*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2b7ef521bb48", "type": "number", "answer": 82.0, "_code": "import re\ndf=pd.concat([So_chi_tiet_ban_hang_1,So_chi_tiet_ban_hang_2],ignore_index=True)\ndf['d']=parse_date(df['Ngày'])\ndf=df.drop_duplicates()\nm=df[(df.d>='2025-07-01')&(df.d<='2025-07-31')&(df['Tên hàng hóa'].str.contains('Gỏi khoai môn hải sản',case=False))]\nm=m[~m['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nprint(m['Tên hàng hóa'].unique(),m['Đơn vị tính'].unique())\nRESULT=float(to_num(m['Số lượng quy đổi']).sum()) if 'Số lượng quy đổi' in m else None\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_538c300ffd10", "type": "percent", "answer": 8.47, "_code": "d=So_chi_tiet_ban_hang__all.copy()\nd['d']=parse_date(d['Ngày'])\nd=d.drop_duplicates()\nd=d[~d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd['t']=to_num(d['Thành tiền'])\ndef rev(y,m): \n    x=d[(d.d.dt.year==y)&(d.d.dt.month==m)]; return x.t.sum()\na,b=rev(2025,9),rev(2025,8)\nRESULT=f\"{(a/b-1)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_040c9dd7f4de", "type": "list", "answer": ["Xi măng Hà Tiên PCB40 bao 50kg", "Gạch ống 8x8x18 Tuynel", "Xi măng INSEE Power-S bao 50kg", "Băng keo điện Nano 20 yard", "Thép cuộn phi 6 Hòa Phát"], "_code": "\nd=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nbad=set(d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|không giao',case=False,na=False)]['Mã đơn hàng'])\nd=d[~d['Mã đơn hàng'].isin(bad)].copy()\nd['dt']=parse_date(d['Ngày'])\nd=d[(d.dt>='2025-09-01')&(d.dt<='2025-09-30')]\nd['q']=pd.to_numeric(d['Số lượng quy đổi'].astype(str).str.extract(r'(-?[\\d.]+)')[0])\ng=d.groupby('Tên hàng hóa')['q'].sum().reset_index().sort_values(['q','Tên hàng hóa'],ascending=[False,True]).head(5)\nRESULT=list(g['Tên hàng hóa'])\n", "_attempts": 1, "_verdict": "wrong"}
{"id": "q_1dfefb6201cf", "type": "percent", "answer": -0.11, "_code": "import pandas as pd\nd=don_hang.copy(); c=chi_tiet_don.copy()\nprint(d[['NgayLap','ThoiGianLap','TinhTrang']].head(3).to_string()); print(d.TinhTrang.value_counts().to_dict(), d.MaHoaDon.duplicated().sum(), c.duplicated(['MaHoaDon','SoThuTu']).sum())\nd=d[d.TinhTrang.isin(['completed','shipping'])].drop_duplicates('MaHoaDon')\nd['dt']=pd.to_datetime(d.ThoiGianLap.astype(str).str[:10],errors='coerce')\nc=c.drop_duplicates(['MaHoaDon','SoThuTu'])\nc['TriGia']=pd.to_numeric(c.TriGia,errors='coerce')\nm=c.merge(d[['MaHoaDon','dt']],on='MaHoaDon')\ndef rev(y,mo): return m[(m.dt.dt.year==y)&(m.dt.dt.month==mo)].TriGia.sum()\na=rev(2025,11);b=rev(2025,10)\nprint(a,b)\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7366dcb457a5", "type": "percent", "answer": 4.43, "_code": "import pandas as pd\ndef pdate(s):\n    s=str(s).strip()\n    if s.isdigit(): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(s))\n    p=s.split()\n    if len(p)==4 and p[1]=='thg': return pd.Timestamp(int(p[3]),int(p[2]),int(p[0]))\n    return pd.to_datetime(s,errors='coerce',dayfirst=True)\nd=don_hang.copy()\nd['dt']=d['NgayBan'].map(pdate)\nd=d[~d['Xử lý'].astype(str).str.lower().isin(['cancelled','returned'])]\nd=d[(d.dt>='2025-02-01')&(d.dt<='2025-02-28')]\nc=chi_tiet_don.copy(); c['T.Tiền']=pd.to_numeric(c['T.Tiền'],errors='coerce')\nc=c[c['Ma don'].isin(d['Mã chứng từ'])]\ntot=c['T.Tiền'].sum()\nph=d[d['Bán qua']=='phone']['Mã chứng từ']\nRESULT=f\"{round(c[c['Ma don'].isin(ph)]['T.Tiền'].sum()/tot*100,2)}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_cc8baa972e4f", "type": "percent", "answer": -15.79, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=float('nan')\n    return -v if neg else v\n\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\nd['t']=parse_date(d['Giờ']).dt.normalize()\nbad=d[d.Status.str.contains('hủy|huỷ|trả|Đổi trả',case=False,na=False)]['Mã hóa đơn'].unique()\nd=d[~d['Mã hóa đơn'].isin(bad)]\nd=d[d['Hàng'].str.lower().str.strip()=='sinh tố xoài (l)']\nD=pd.Timestamp('2026-03-21')\na=d[(d.t>=D)&(d.t<=D+pd.Timedelta(days=6))].so_luong.sum()\nb=d[(d.t>=D-pd.Timedelta(days=7))&(d.t<D)].so_luong.sum()\nprint(a,b)\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1c41ad190bbd", "type": "percent", "answer": 6.35, "_code": "import pandas as pd\ndef pdate(s):\n    s=str(s).strip()\n    if s.isdigit(): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(s))\n    p=s.split()\n    if len(p)==4 and p[1]=='thg': return pd.Timestamp(int(p[3]),int(p[2]),int(p[0]))\n    return pd.to_datetime(s,errors='coerce',dayfirst=True)\nd=don_hang.copy()\nd['dt']=d['NgayBan'].map(pdate)\nd=d[~d['Xử lý'].astype(str).str.lower().isin(['cancelled','returned'])]\nd=d[(d.dt>='2025-09-01')&(d.dt<='2025-09-30')]\nc=chi_tiet_don.copy(); c['T.Tiền']=pd.to_numeric(c['T.Tiền'],errors='coerce')\nc=c[c['Ma don'].isin(d['Mã chứng từ'])]\ng=san_pham.set_index('SKU')['Nhom hang']\nRESULT=f\"{round(c[c['ID SP'].map(g)=='sinh tố']['T.Tiền'].sum()/c['T.Tiền'].sum()*100,2)}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_b143fabbd8ae", "type": "percent", "answer": -1.86, "_code": "\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\nd['t']=parse_date(d['Giờ']).dt.normalize()\nbad=d[d.Status.str.contains('hủy|huỷ|trả|Đổi trả',case=False,na=False)]['Mã hóa đơn'].unique()\n\nv=d[~d['Mã hóa đơn'].isin(bad)]\nv=v[v['Hàng'].str.lower().str.strip()=='matcha latte (m)']\nD=pd.Timestamp('2025-09-29')\na=v[(v.t>=D)&(v.t<=D+pd.Timedelta(days=29))].so_luong.sum()\nb=v[(v.t>=D-pd.Timedelta(days=30))&(v.t<D)].so_luong.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_50d0abf41d5f", "type": "percent", "answer": 1.62, "_code": "\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\nd['t']=parse_date(d['Giờ']).dt.normalize()\nbad=d[d.Status.str.contains('hủy|huỷ|trả|Đổi trả',case=False,na=False)]['Mã hóa đơn'].unique()\n\nm=d[(d.t.dt.year==2025)&(d.t.dt.month==3)].drop_duplicates('Mã hóa đơn')\nRESULT=f\"{m.Status.str.contains('hủy|huỷ',case=False).mean()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_baa0ec03e542", "type": "percent", "answer": 26.03, "_code": "import unicodedata as U\ndef G(n): return [v for k,v in data.items() if U.normalize('NFC',k)==n][0]\ndf=So_chi_tiet_ban_hang__all.drop_duplicates()\ndf['d']=parse_date(df['Ngày'])\ndf=df[(df.d.dt.year==2025)&(df.d.dt.month==7)]\ndf=df[~df['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\ndf['v']=to_num(df['Thành tiền'])\ng=G('Danh sách hàng hóa')\nmp={normalize_text(a):U.normalize('NFC',str(b)).strip().lower() for a,b in zip(g['Tên hàng hóa'],g['Nhóm hàng hóa'])}\ndf['g']=df['Tên hàng hóa'].map(normalize_text).map(mp)\nRESULT=f\"{round(df[df.g=='điện'].v.sum()/df.v.sum()*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_b3b16e699a67", "type": "percent", "answer": -6.36, "_code": "\nimport re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif s.endswith('tr'): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    elif re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): v=float(s.replace(',',''))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=float('nan')\n    return -v if neg else v\n\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\nd['t']=parse_date(d['Giờ']).dt.normalize()\nbad=d[d.Status.str.contains('hủy|huỷ|trả|Đổi trả',case=False,na=False)]['Mã hóa đơn'].unique()\n\nv=d[~d['Mã hóa đơn'].isin(bad)].copy(); v['m']=v['Trị giá'].apply(money)\nA=pd.Timestamp(as_of_date); s=A.replace(day=1)\nps=s-pd.offsets.MonthBegin(1); pe=min(ps+pd.Timedelta(days=A.day-1),s-pd.Timedelta(days=1))\na=v[(v.t>=s)&(v.t<=A)].m.sum(); b=v[(v.t>=ps)&(v.t<=pe)].m.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_17c7ddd15b22", "type": "percent", "answer": 10.59, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\nh=[v for k,v in data.items() if k.startswith('Danh')][0]\na=pd.concat([data['So_chi_tiet_ban_hang_1'],data['So_chi_tiet_ban_hang_2']],ignore_index=True)\na=a[a['Ngày'].notna()].drop_duplicates()\na['d']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y',errors='coerce')\na=a[(a.d>='2025-09-01')&(a.d<='2025-09-30')]\na=a[~a['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\na['v']=a['Thành tiền'].map(money)\ng=h.set_index('Tên hàng hóa')['Nhóm hàng hóa']\na['g']=a['Tên hàng hóa'].map(g)\nRESULT=f\"{a[a.g=='cơm mì cháo'].v.sum()/a.v.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_faf8a2678559", "type": "number", "answer": 562140000, "_code": "import pandas as pd, re\ndf=SoBanHang.copy()\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m: return int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1000 if m.group(2) else 0)\n    m=re.match(r'^(\\d+),(\\d+)tr$',s)\n    if m: return float(m.group(1)+'.'+m.group(2))*1e6\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+(\\.\\d+)?$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\ndf['v']=df['Thành tiền (đ)'].map(money)\ndef pdate(x):\n    if hasattr(x,'year'): return pd.Timestamp(x)\n    s=str(x).strip()\n    if re.match(r'^\\d{4}-\\d{2}-\\d{2}',s): return pd.Timestamp(s[:10])\n    return pd.to_datetime(s,dayfirst=True,errors='coerce')\ndf['d']=df['Ngày tháng'].map(pdate)\nbad=df.v.isna().sum(); print('nan money',bad, df.d.isna().sum())\nst=df['Trạng thái đơn'].astype(str).str.lower()\nok=~st.str.contains('hủy|huỷ|cancel|trả|hoàn')\nx=df[ok&(df.d.dt.year==2025)&(df.d.dt.month==3)]\nRESULT=int(round(x.v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_894f7a3e6389", "type": "number", "answer": 11754500, "_code": "h=DanhSachHoaDon.copy()\nh['d']=parse_date(h['Thời gian'])\nm=(h.d>='2025-05-01')&(h.d<='2025-05-31')&(h['Phương thức thanh toán']=='Thu hộ (COD)')\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả|Hoàn trả',case=False,na=False)\nRESULT=int(to_num(h[m&~bad]['Tổng tiền hàng']).sum())\n", "_attempts": 1, "_verdict": "correct"}
