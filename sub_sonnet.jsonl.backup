{"id": "q_2d8aea0f27af", "type": "percent", "answer": 2.89, "_code": "df=DonHang_ChiTiet.copy()\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[(df.d>='2025-12-01')&(df.d<='2025-12-31')]\nbad=df['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)\ndf=df[~bad]\ndf['amt']=to_num(df['Tổng tiền'])\nrx=get_rx_product_names(DuLieuXuat__DanhSachThuoc,DuLieuXuat__DanhSachSanPham)\nisrx=df['Tên sản phẩm'].apply(normalize_text).isin(rx)\nRESULT=f\"{round(df[isrx].amt.sum()/df.amt.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
