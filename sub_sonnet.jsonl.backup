{"id": "q_2d3ce08ff39d", "type": "percent", "answer": 11.51, "_code": "import re, numpy as np, unicodedata\ndef money(x):\n    if x is None or (isinstance(x,float) and np.isnan(x)): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan'): return np.nan\n    if 'tr' in s:\n        a,b=s.split('tr',1); a=a.strip().replace(',','.')\n        v=float(a)*1e6 if a else 0\n        b=b.strip()\n        if b: v+=int(b.ljust(3,'0')[:3])*1000\n        return v\n    if s.endswith('k'):\n        return float(s[:-1].replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.fullmatch(r'-?\\d+,\\d+',s) else float(s)\ndef nt(s):\n    return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower()\nimport pandas as pd\nd=don_hang.copy(); d['dt']=pd.to_datetime(d['Ngày bán'])\nd=d[(d.dt>='2025-04-01')&(d.dt<='2025-04-30')&d['Tình trạng đơn'].isin(['completed','shipping'])]\nc=chi_tiet_don[chi_tiet_don['Số CT'].isin(d['Số phiếu'])].copy()\nc['v']=c['Tiền bán'].map(money)\ng=san_pham.set_index('Mã HH')['Nhom hang']\nc['g']=c['Mã hàng bán'].map(g)\nRESULT=f\"{c[c.g=='nướng'].v.sum()/c.v.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_06adbccf5be5", "type": "percent", "answer": 15.84, "_code": "h=DanhSachHoaDon__all.drop_duplicates().copy()\nh['dt']=parse_date(h['Thời gian'])\nh=h[(h.dt>='2025-04-01')&(h.dt<='2025-04-30')]\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nc['amt']=to_num(c['Thành tiền'])\nc=c.merge(DanhSachSanPham[['Mã hàng','Nhóm hàng(3 Cấp)']],on='Mã hàng',how='left')\ng=c[c['Nhóm hàng(3 Cấp)'].map(normalize_text)=='tieu hoa'].amt.sum()\nRESULT=f\"{g/c.amt.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ef76bfbc0321", "type": "number", "answer": 39, "_code": "import re, numpy as np, unicodedata\ndef money(x):\n    if x is None or (isinstance(x,float) and np.isnan(x)): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').strip()\n    if s in ('','nan'): return np.nan\n    if 'tr' in s:\n        a,b=s.split('tr',1); a=a.strip().replace(',','.')\n        v=float(a)*1e6 if a else 0\n        b=b.strip()\n        if b: v+=int(b.ljust(3,'0')[:3])*1000\n        return v\n    if s.endswith('k'):\n        return float(s[:-1].replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    return float(s.replace(',','.')) if re.fullmatch(r'-?\\d+,\\d+',s) else float(s)\ndef nt(s):\n    return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s))).strip().lower()\nimport pandas as pd\nd=don_hang.copy(); d['dt']=pd.to_datetime(d['Ngày bán'])\nRESULT=int(((d.dt>='2026-04-01')&(d.dt<='2026-04-30')&(d['Tình trạng đơn']=='cancelled')).sum())\n", "_attempts": 1, "_verdict": "correct"}
