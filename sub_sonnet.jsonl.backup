{"id": "q_521fed0ffe38", "type": "number", "answer": 131, "_code": "import pandas as pd, re\ndef pdate(x):\n    s=str(x).strip()\n    if re.match(r'^\\d+(\\.0+)?$',s): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(s)))\n    m=re.match(r'^(\\d+)\\s*thg\\s*(\\d+)\\s*(\\d{4})$',s)\n    if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n    if re.match(r'^\\d{4}-\\d{2}-\\d{2}',s): return pd.Timestamp(s[:10])\n    return pd.to_datetime(s,dayfirst=True,errors='coerce')\ndef num(x):\n    s=re.sub(r'[^\\d.\\-]','',str(x).replace(',',''))\n    return pd.to_numeric(s,errors='coerce')\nd=don_hang.drop_duplicates('Mã chứng từ').copy(); d['d']=d.NgayBan.map(pdate)\nd=d[d['Xử lý'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().copy(); c['v']=c['T.Tiền'].map(num); c['q']=c['SL quy đổi'].map(num)\nm=c.merge(d[['Mã chứng từ','d','Số KH']],left_on='Ma don',right_on='Mã chứng từ')\np=san_pham.drop_duplicates('SKU')\nsk=p[p['Sản phẩm'].str.strip().str.lower()=='sinh tố xoài (m)']['SKU']\nx=m[m['ID SP'].isin(sk)&(m.d>='2026-01-01')&(m.d<='2026-01-31')]\nRESULT=int(x.q.sum())\n", "_attempts": 1, "_verdict": "correct"}
