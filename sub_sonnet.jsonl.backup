{"id": "q_acb4ea37b9d0", "type": "number", "answer": 14005000, "_code": "a=ban_hang.drop_duplicates().copy()\na['od']=parse_date(a['Ngày bán']); a['m']=to_num(a['Amount'])\nbad=set(a[a['Trạng thái xử lý'].str.contains('huỷ|hủy|trả',case=False)]['Số phiếu'])\ng=a[~a['Số phiếu'].isin(bad)]\nRESULT=int(g[g.od=='2025-10-21'].m.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_859a22204661", "type": "percent", "answer": 1.22, "_code": "hc = [\"Mã đơn hàng\", \"Ngày đặt hàng\", \"Trạng thái đơn hàng\", \"Tên khách hàng\"]\nparts = []\nfor t in (DonHang_ChiTiet_1__all, DonHang_ChiTiet_2026__all):\n    t = t.copy()\n    t[hc] = t[hc].ffill()\n    parts.append(t)\ndf = pd.concat(parts, ignore_index=True).drop_duplicates()\ndf[\"d\"] = parse_date(df[\"Ngày đặt hàng\"])\ndef pm(x):\n    s = str(x).strip().lower().replace(\"đ\", \"\")\n    if s.endswith(\"k\"):\n        return float(s[:-1]) * 1000\n    return float(__import__(\"re\").sub(r\"[^\\d]\", \"\", s) or \"nan\")\ndf[\"amt\"] = df[\"Tổng tiền\"].map(pm)\nst = df.groupby(\"Mã đơn hàng\")[\"Trạng thái đơn hàng\"].agg(lambda s: \" \".join(s.dropna().astype(str).unique()))\ncancel = st.str.contains(\"hủy|huỷ\", case=False)\nret = st.str.contains(\"hoàn hàng|trả\", case=False)\norders = df.groupby(\"Mã đơn hàng\")[\"d\"].first()\no = orders[(orders.dt.year == 2025) & (orders.dt.month == 12)].index\nRESULT = f\"{round(cancel[o].sum() / len(o) * 100, 2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3e46e96b989e", "type": "number", "answer": 21790000, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nsp=san_pham[san_pham['Tên sản phẩm'].str.contains('cơm chiên dương châu',case=False,na=False)]\ncodes=set(sp['Mã HH'])\no=don_hang.drop_duplicates('Số phiếu'); o=o[o['Tình trạng đơn'].isin(['completed','shipping'])]\no=o[(parse_date(o['Ngày bán'])>='2026-03-01')&(parse_date(o['Ngày bán'])<='2026-03-31')]\nc=chi_tiet_don[chi_tiet_don['Số CT'].isin(o['Số phiếu'])&chi_tiet_don['Mã hàng bán'].isin(codes)]\nRESULT=int(round(c['Tiền bán'].map(m).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d784b9a6937f", "type": "number", "answer": 192664000, "_code": "d=DonHang_ChiTiet.copy().drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng']); d['m']=to_num(d['Tổng tiền'])\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nRESULT=int(round(d[(d.dt>='2026-05-01')&(d.dt<='2026-05-31')].m.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_eb8f92be22c3", "type": "percent", "answer": 2.28, "_code": "df=DonHang_ChiTiet.copy()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[(df['d']>='2025-04-01')&(df['d']<='2025-04-30')]\no=df.drop_duplicates('Mã đơn hàng')\nRESULT=f\"{round(o['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False).sum()/len(o)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_db575cf29bdc", "type": "percent", "answer": 9.17, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\na=pd.concat(So_chi_tiet_ban_hang.values(),ignore_index=True).drop_duplicates()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y'); a['amt']=a['Thành tiền'].map(money)\na=a[~a['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn hàng',case=False,na=False)]\nimport unicodedata as ud\nN=lambda s:ud.normalize('NFC',str(s)).strip().lower()\ndk=[k for k in data if N(k)==N('Danh sách hàng hóa')][0]\ndl=data[dk]\ng={N(k):N(v) for k,v in zip(dl['Tên hàng hóa'],dl['Nhóm hàng hóa'])}\nm=a[(a.dt.dt.year==2025)&(a.dt.dt.month==10)]\nst=m[m['Tên hàng hóa'].map(N).map(g)=='sắt thép'].amt.sum()\nRESULT=f\"{round(st/m.amt.sum()*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_f5cc619a1ad2", "type": "percent", "answer": 1.01, "_code": "h=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['dt']=parse_date(h['Thời gian'])\no=h[(h.dt>='2025-01-01')&(h.dt<='2025-01-31')]\nRESULT=f\"{o['Trạng thái'].str.contains('hủy|huỷ',case=False).sum()/len(o)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_903211e438e3", "type": "number", "answer": 274300, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\na=pd.concat(So_chi_tiet_ban_hang.values(),ignore_index=True).drop_duplicates()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y'); a['amt']=a['Thành tiền'].map(money)\na=a[~a['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn hàng',case=False,na=False)]\nm=a[(a.dt.dt.year==2025)&(a.dt.dt.month==5)&(a['Tên hàng hóa']=='Gạch ống 8x8x18 Tuynel')]\nRESULT=int(round(m.amt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9186f7677be0", "type": "number", "answer": 1053370500, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\na=pd.concat(So_chi_tiet_ban_hang.values(),ignore_index=True).drop_duplicates()\na['dt']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y'); a['amt']=a['Thành tiền'].map(money)\na=a[~a['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn hàng',case=False,na=False)]\nm=a[(a.dt.dt.year==2025)&(a.dt.dt.month==10)]\nRESULT=int(round(m.amt.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3c652d369fb6", "type": "number", "answer": 7243600, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nA=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nA[hh]=A[hh].ffill(); A=A.drop_duplicates()\nA['d']=pdate(A['Ngày đặt hàng']); A['v']=money(A['Tổng tiền'])\nok=A[~A['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nRESULT=int(round(ok[ok.d=='2025-02-19'].v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5fa8f7834d32", "type": "percent", "answer": -0.29, "_code": "import re as _re\ndef money(s):\n    if s is None or (isinstance(s,float) and s!=s): return float('nan')\n    if isinstance(s,(int,float)): return float(s)\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if not s: return float('nan')\n    try:\n        if 'tr' in s:\n            a,b=s.split('tr',1)\n            a=a or '0'\n            if b=='': return float(a.replace(',','.'))*1e6\n            return int(a.replace('.','').replace(',',''))*1e6+int(b.ljust(3,'0')[:3])*1e3\n        if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n        if ',' in s and '.' in s:\n            return float(s.replace(',','')) if s.rfind('.')>s.rfind(',') else float(s.replace('.','').replace(',','.'))\n        if '.' in s:\n            return float(s.replace('.','')) if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s) else float(s)\n        if ',' in s:\n            return float(s.replace(',','')) if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+',s) else float(s.replace(',','.'))\n        return float(s)\n    except Exception: return float('nan')\nd=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày']); d['v']=d['Thành tiền'].map(money)\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được|hoàn hàng',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\ndef rev(y,m):\n    x=d[(d.dt.dt.year==y)&(d.dt.dt.month==m)]; return x['v'].sum()\na,b=rev(2025,7),rev(2025,6)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7d460ecdd402", "type": "number", "answer": 32, "_code": "d=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được|hoàn hàng',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\ny=pd.Timestamp(as_of_date)-pd.Timedelta(days=1)\nRESULT=int(d[d.dt==y]['Mã đơn hàng'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ab189f9bec71", "type": "percent", "answer": 13.74, "_code": "\nX=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nG=Bao_cao_ban_hang['Danh sách hàng hóa']\nX['d']=parse_date(X['Ngày'])\nst=X['Trạng thái'].astype(str).str.lower()\nX=X[~st.str.contains('hủy|huỷ|cancel|trả|không giao được|hoàn hàng')]\nX['amt']=pd.to_numeric(X['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\ndef rev(a,b,df=X): return df[(df.d>=a)&(df.d<=b)].amt.sum()\n\nm=X[(X.d>='2026-03-01')&(X.d<='2026-03-31')]\ng=m.merge(G[['Tên hàng hóa','Nhóm hàng hóa']],on='Tên hàng hóa',how='left')\nRESULT=f\"{round(g[g['Nhóm hàng hóa']=='cát đá'].amt.sum()/m.amt.sum()*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_cdbf2bbaa37d", "type": "percent", "answer": 56.82, "_code": "\nX=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nG=Bao_cao_ban_hang['Danh sách hàng hóa']\nX['d']=parse_date(X['Ngày'])\nst=X['Trạng thái'].astype(str).str.lower()\nX=X[~st.str.contains('hủy|huỷ|cancel|trả|không giao được|hoàn hàng')]\nX['amt']=pd.to_numeric(X['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\ndef rev(a,b,df=X): return df[(df.d>=a)&(df.d<=b)].amt.sum()\n\na=rev('2026-03-01','2026-03-31'); b=rev('2026-02-01','2026-02-28')\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_27eebcccdf1f", "type": "percent", "answer": -9.65, "_code": "\nX=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy()\nG=Bao_cao_ban_hang['Danh sách hàng hóa']\nX['d']=parse_date(X['Ngày'])\nst=X['Trạng thái'].astype(str).str.lower()\nX=X[~st.str.contains('hủy|huỷ|cancel|trả|không giao được|hoàn hàng')]\nX['amt']=pd.to_numeric(X['Thành tiền'].astype(str).str.replace(',',''),errors='coerce')\ndef rev(a,b,df=X): return df[(df.d>=a)&(df.d<=b)].amt.sum()\n\na=rev('2026-06-01','2026-06-30'); b=rev('2026-05-01','2026-05-31')\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e0859f9dae10", "type": "number", "answer": 1, "_code": "d=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|Không giao được|hoàn hàng',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nbefore=set(d[d.dt<'2025-07-01']['Tên hàng hóa'])\ninp=set(d[(d.dt>='2025-07-01')&(d.dt<='2025-07-07')]['Tên hàng hóa'])\nRESULT=len(before-inp)\n", "_attempts": 1, "_verdict": "correct"}
