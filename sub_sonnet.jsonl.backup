{"id": "q_e667e9848cc4", "type": "number", "answer": 119000, "_code": "code=san_pham[san_pham['Tên SP'].str.contains('Ếch chiên nước mắm',case=False,na=False)]['Mã sản phẩm bán'].tolist()\nh=don_hang.drop_duplicates().copy(); h['d']=parse_date(h['Ngày'])\nc=chi_tiet_don.drop_duplicates()\nc=c[c['Mã mặt hàng'].isin(code)&c['Mã đơn hàng'].isin(h[h.d=='2025-03-16']['Mã chứng từ'])]\np=to_num(c['Đơn giá (đ)'])/(to_num(c['Số lượng lẻ'])/to_num(c['SoLuong']))\nRESULT=int(round(p.mode().iloc[0]))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2615aa591115", "type": "number", "answer": 215.0, "_code": "import sys\ndf=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True)\nprint(df['Status'].value_counts(),file=sys.stderr)\nprint(df['so_luong'].map(type).value_counts(),file=sys.stderr)\ndf['dt']=pd.to_datetime(df['Giờ'],errors='coerce')\ndf=df[df['dt'].notna()&df['Mã hóa đơn'].notna()].drop_duplicates()\ndf['q']=pd.to_numeric(df['so_luong'],errors='coerce')\nbad=df['Status'].str.contains('hủy|huỷ|trả|đổi',case=False,na=False)|(df['q']<0)\nbadids=set(df.loc[bad,'Mã hóa đơn'])\nm=(df['dt']>='2025-06-01')&(df['dt']<'2025-07-01')&(df['Hàng'].str.strip().str.lower()=='cà phê muối (m)')&~df['Mã hóa đơn'].isin(badids)\nRESULT=float(df.loc[m,'q'].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_64e2ac42f1d6", "type": "percent", "answer": 11.93, "_code": "import re\ndef money(x):\n    if pd.isna(x): return float('nan')\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)[.,]?(\\d*)tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if c: return float(a)*1e6+float(c)*10**(6-len(c))\n        return float(a+'.'+(b or '0'))*1e6\n    m=re.fullmatch(r'([\\d.,]+)k',s)\n    if m:\n        t=m.group(1)\n        return float(t.replace('.','').replace(',',''))*1000 if re.search(r'[.,]\\d{3}$',t) else float(t.replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\nd=DanhSachHoaDon.copy(); d['dt']=pd.to_datetime(d['Thời gian tạo'].astype(str).str[:10])\nok=d[d['Trạng thái'].isin(['Hoàn thành','Đang giao hàng'])]\nc=DanhSachHoaDonChiTiet.drop_duplicates().merge(ok[['Mã hóa đơn','dt']],on='Mã hóa đơn')\nc['v']=c['Thành tiền'].apply(money)\nrev=lambda a,b:c[(c.dt>=a)&(c.dt<=b)].v.sum()\ncur=rev('2025-05-01','2025-05-31');prev=rev('2025-04-01','2025-04-30')\nRESULT=f\"{round((cur-prev)/prev*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ba9c6a5b7863", "type": "percent", "answer": -44.19, "_code": "d=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nd=d[d['Tên sản phẩm'].notna()].copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[hc]=d[hc].ffill()\nd=d.drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nlo=pd.concat([DonHang_Lo_1,DonHang_Lo_2],ignore_index=True)\nlo['Mã đơn hàng']=lo['Mã đơn hàng'].ffill()\nret=set(lo.loc[pd.to_numeric(lo['Số lượng trả'],errors='coerce')>0,'Mã đơn hàng'])\nbad=d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)|d['Mã đơn hàng'].isin(ret)\nd=d[~bad&(d['Tên sản phẩm']=='Tiffy Dey hộp 25 vỉ x 4 viên')].copy()\nf={'viên':1,'vỉ':4,'hộp':100}\nd['q']=pd.to_numeric(d['Số lượng sản phẩm'])*d['Đơn vị tính'].map(f)\na=d[(d['dt']>='2026-06-09')&(d['dt']<='2026-06-22')]['q'].sum()\nb=d[(d['dt']>='2026-05-26')&(d['dt']<='2026-06-08')]['q'].sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
