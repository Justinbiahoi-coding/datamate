{"id": "q_47c61a42ca17", "type": "percent", "answer": 1.04, "_code": "df=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[h]=df[h].ffill()\ndf['d']=parse_date(df['Ngày đặt hàng'])\no=df[(df.d.dt.year==2025)&(df.d.dt.month==2)].drop_duplicates('Mã đơn hàng')\nRESULT=f\"{(o['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False).mean()*100):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_66f5440df47e", "type": "number", "answer": 25921800, "_code": "h=DanhSachHoaDon.copy().drop_duplicates()\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh['t']=pd.to_datetime(h['Thời gian tạo']); h['d']=h.t.dt.normalize(); hr=h.t.dt.hour\nh['shift']=hr.map(lambda x:'s' if 6<=x<14 else ('c' if 14<=x<22 else 'o'))\nc=DanhSachHoaDonChiTiet.copy().drop_duplicates(); c['amt']=to_num(c['Thành tiền'])\nh['rev']=h['Mã hóa đơn'].map(c.groupby('Mã hóa đơn').amt.sum()).fillna(0)\nRESULT=int(round(h[(h.d>='2025-08-25')&(h.d<='2025-08-31')&(h['shift']=='s')].rev.sum()))\n", "_attempts": 1, "_verdict": "correct"}
