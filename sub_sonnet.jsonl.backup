{"id": "q_8b6ed12da21d", "type": "date", "answer": "2026-01-17", "_code": "\no=data['don_hang'].copy(); o['d']=parse_date(o['Ngày'])\no=o[o['Tình trạng'].isin(['completed','shipping'])]\nc=data['chi_tiet_don'].drop_duplicates(['Mã đơn hàng','No.']).copy()\nc['amt']=c['Amount'].astype(str).str.replace(r'\\D','',regex=True).astype(float)\no['rev']=o['Mã chứng từ'].map(c.groupby('Mã đơn hàng')['amt'].sum()).fillna(0)\nm=o[(o.d.dt.year==2026)&(o.d.dt.month==1)]\nRESULT=m.groupby('d').rev.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1fa63c38c946", "type": "list", "answer": ["Ngô Minh Dũng", "Lâm Đức Quân", "Thân Thắng Phương"], "_code": "o=don_hang.drop_duplicates('Mã chứng từ').copy(); o['d']=parse_date(o['Ngày'])\no=o[(o.d>='2026-05-01')&(o.d<='2026-05-31')&o['Tình trạng'].isin(['completed','shipping'])&o['Customer ID'].notna()]\nl=chi_tiet_don.drop_duplicates()\nl=l[l['Mã đơn hàng'].isin(o['Mã chứng từ'])].copy()\nl['v']=to_num(l['Amount'])\nl['c']=l['Mã đơn hàng'].map(o.set_index('Mã chứng từ')['Customer ID'])\ng=l.groupby('c').v.sum().reset_index().sort_values(['v','c'],ascending=[False,True]).head(3)\nnm=khach_hang.set_index('Mã KH')['Khách hàng (tên)']\nr=[nm[c] for c in g.c]\nRESULT=r\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_21c12147e6d6", "type": "string", "answer": "Thân Hồng Nhung", "_code": "o=don_hang.drop_duplicates('Mã chứng từ').copy(); o['d']=parse_date(o['Ngày'])\no=o[(o.d>='2025-06-01')&(o.d<='2025-06-30')&o['Tình trạng'].isin(['completed','shipping'])&o['Customer ID'].notna()]\nl=chi_tiet_don.drop_duplicates()\nl=l[l['Mã đơn hàng'].isin(o['Mã chứng từ'])].copy()\nl['v']=to_num(l['Amount'])\nl['c']=l['Mã đơn hàng'].map(o.set_index('Mã chứng từ')['Customer ID'])\ng=l.groupby('c').v.sum().reset_index().sort_values(['v','c'],ascending=[False,True]).head(1)\nnm=khach_hang.set_index('Mã KH')['Khách hàng (tên)']\nr=[nm[c] for c in g.c]\nRESULT=r[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7c5414be23f4", "type": "list", "answer": [10000, 10000], "_code": "h = BanHang_HoaDon.copy()\nh['t'] = pd.to_datetime(h['Giờ tạo đơn'])\nh['od'] = h['t'].dt.normalize()\nh = h[(h['Mã KH mua']=='KH0217') & (h['Phương thức TT']=='Ghi nợ') & (~h['Trạng thái'].str.contains('Không giao', na=False))]\npt = BanHang_PhieuThu.copy()\npt['pd'] = pd.to_datetime(pt['Thời gian thu']).dt.normalize()\npt['v'] = to_num(pt['Số tiền thu'])\npt = pt.merge(h[['Order ID','od']], left_on='Mã bill', right_on='Order ID')\nmo = h[(h.od>='2025-02-01')&(h.od<='2025-02-28')]\npaid_same = pt[pt['pd']==pt['od']].groupby('Mã bill')['v'].sum()\nno_them = sum(to_num(pd.Series([r['Tong tien']])).iloc[0] - paid_same.get(r['Order ID'],0) for _,r in mo.iterrows())\ntra = pt[(pt['pd']>pt['od'])&(pt['pd']>='2025-02-01')&(pt['pd']<='2025-02-28')]['v'].sum()\nRESULT = [round(no_them), round(tra)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6501ddf05b36", "type": "number", "answer": 79, "_code": "df=DonHang_ChiTiet.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf=df[df['Mã đơn hàng'].notna()|df['Tên sản phẩm'].notna()]\ndf[hc]=df[hc].ffill()\ndf['d']=parse_date(df['Ngày đặt hàng'])\ndf=df[(df.d>='2025-07-01')&(df.d<'2025-08-01')]\no=df.drop_duplicates('Mã đơn hàng')\no=o[o['Trạng thái đơn hàng'].isin(['Đã hoàn thành','Đang giao dịch'])]\nn=o['Tên khách hàng'].astype(str).str.replace(r'[\\s\\-–]*\\(?\\d{8,}\\)?\\s*$','',regex=True).str.strip()\nn=n[~n.str.lower().isin(['khách lẻ','kl','lẻ','khach le','nan',''])]\nRESULT=int((n.value_counts()>=6).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0f3c04bf12df", "type": "date", "answer": "2026-06-08", "_code": "h=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian']); h['v']=to_num(h['Tổng tiền hàng'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nm=h[(h.d>='2026-06-01')&(h.d<'2026-07-01')]\nRESULT=str(m.groupby(m.d.dt.normalize()).v.sum().idxmax().date())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d670f1efb00c", "type": "date", "answer": "2025-06-21", "_code": "h = BanHang_HoaDon.copy()\nh['d'] = pd.to_datetime(h['Giờ tạo đơn']).dt.normalize()\nh = h[(h.d>='2025-06-01')&(h.d<='2025-06-30')]\nh = h[~h['Trạng thái'].str.contains('Không giao|Đổi trả', na=False)]\nh['v'] = to_num(h['Tiền hàng trước giảm'])\nRESULT = h.groupby('d')['v'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e6684f00995f", "type": "list", "answer": ["Bia Heineken lon", "Coca-Cola lon", "Bia Tiger Bạc lon", "Bia Tiger lon", "Bia Sài Gòn Special lon"], "_code": "\ndf=pd.concat([data['So_chi_tiet_ban_hang_1'],data['So_chi_tiet_ban_hang_2']],ignore_index=True).drop_duplicates()\ndf['d']=parse_date(df['Ngày'])\ndf['amt']=to_num(df['Thành tiền']); df['q']=to_num(df['Số lượng quy đổi'])\nst=df['Trạng thái'].astype(str).str.lower()\ndf['bad']=st.str.contains('hủy|huỷ|trả')\ndf['cx']=st.str.contains('hủy|huỷ')\n\nw=df[(df.d>='2026-03-23')&(df.d<='2026-03-29')&~df.bad&~df['Tên hàng hóa'].str.contains('phí phục vụ',case=False)].copy()\nw['k']=w['Tên hàng hóa'].map(normalize_text)\ncanon=w.groupby('k')['Tên hàng hóa'].agg(lambda s:s.value_counts().index[0])\ns=w.groupby('k')['q'].sum().sort_values(ascending=False)\nRESULT=[canon[k] for k in s.head(5).index]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e8c47d0d3400", "type": "percent", "answer": 2.05, "_code": "\ndf=pd.concat([data['So_chi_tiet_ban_hang_1'],data['So_chi_tiet_ban_hang_2']],ignore_index=True).drop_duplicates()\ndf['d']=parse_date(df['Ngày'])\ndf['amt']=to_num(df['Thành tiền']); df['q']=to_num(df['Số lượng quy đổi'])\nst=df['Trạng thái'].astype(str).str.lower()\ndf['bad']=st.str.contains('hủy|huỷ|trả')\ndf['cx']=st.str.contains('hủy|huỷ')\n\nm=df[(df.d.dt.year==2025)&(df.d.dt.month==5)]\na=m.drop_duplicates('Mã đơn hàng')\nRESULT=f\"{a.cx.sum()/len(a)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ec52b91bfbd0", "type": "unanswerable", "answer": "unanswerable", "_code": "\ncols=set(data['So_chi_tiet_ban_hang_1'].columns)|set(data['So_chi_tiet_ban_hang_2'].columns)\nassert not any('thanh toán' in x.lower() or 'hình thức' in x.lower() or 'phương thức' in x.lower() for x in cols)\nRESULT='unanswerable'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_75fef9f7f9c5", "type": "date", "answer": "2026-05-06", "_code": "\ndf=pd.concat([data['So_chi_tiet_ban_hang_1'],data['So_chi_tiet_ban_hang_2']],ignore_index=True).drop_duplicates()\ndf['d']=parse_date(df['Ngày'])\ndf['amt']=to_num(df['Thành tiền']); df['q']=to_num(df['Số lượng quy đổi'])\nst=df['Trạng thái'].astype(str).str.lower()\ndf['bad']=st.str.contains('hủy|huỷ|trả')\ndf['cx']=st.str.contains('hủy|huỷ')\n\nm=df[(df.d.dt.year==2026)&(df.d.dt.month==5)&~df.bad]\nRESULT=m.groupby('d').amt.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_409cf8f109ac", "type": "number", "answer": 1473231, "_code": "s=So_chi_tiet_ban_hang__all.copy().drop_duplicates()\ns['d']=parse_date(s['Ngày']); s['a']=to_num(s['Thành tiền'])\nbad=set(s[s['Trạng thái'].isin(['hủy','Trả hàng','hàng trả về','Không giao được'])]['Mã đơn hàng'])\ns=s[~s['Mã đơn hàng'].isin(bad)]\nx=s[(s.d>='2026-01-01')&(s.d<'2026-02-01')]\nRESULT=int(x.a.sum()/x['Mã đơn hàng'].nunique()+0.5)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_afedc107ddb1", "type": "string", "answer": "Đinh Giang Hạnh", "_code": "s=So_chi_tiet_ban_hang__all.copy().drop_duplicates()\ns['d']=parse_date(s['Ngày']); s['a']=to_num(s['Thành tiền'])\nbad=set(s[s['Trạng thái'].isin(['hủy','Trả hàng','hàng trả về','Không giao được'])]['Mã đơn hàng'])\ns=s[~s['Mã đơn hàng'].isin(bad)]\nx=s[(s.d>='2026-01-01')&(s.d<'2026-02-01')]\ny=x[~x['Khách hàng'].astype(str).str.lower().str.strip().isin(['khách lẻ','kl','lẻ','khach le','nan'])].drop_duplicates('Mã đơn hàng')\nRESULT=y['Khách hàng'].value_counts().index[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ada6457c9ccc", "type": "string", "answer": "NV002", "_code": "h = DuLieuBanHang['DanhSachHoaDon'].copy()\nh['d'] = parse_date(h['Thời gian'])\nh = h[(h.d.dt.year==2025)&(h.d.dt.month==1)]\nh = h[~h['Trạng thái'].str.contains('hủy|huỷ|trả', case=False, na=False)]\nh['v'] = to_num(h['Tổng tiền hàng'])\nRESULT = h.groupby('Người bán')['v'].sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_43df08e6cce8", "type": "list", "answer": [130500, 43500], "_code": "h = DuLieuBanHang['DanhSachHoaDon'].copy()\nkh = DuLieuBanHang['DanhSachKhachHang']\ncodes = kh[kh['Tên khách hàng'].map(vn_normalize)=='giang phuong thu']['Mã khách hàng'].tolist()\nh['od'] = pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nh = h[h['Mã KH'].isin(codes) & (h['Phương thức thanh toán']=='Ghi nợ') & ~h['Trạng thái'].str.contains('hủy|huỷ', case=False, na=False)]\nsq = DuLieuBanHang['SoQuy'].copy()\nsq['pd'] = pd.to_datetime(sq['Thời gian']).dt.normalize()\nsq['v'] = to_num(sq['Giá trị'])\nsq = sq.merge(h[['Mã hóa đơn','od']], on='Mã hóa đơn')\nmo = h[(h.od>='2025-03-01')&(h.od<='2025-03-31')]\nsame = sq[sq.pd==sq.od].groupby('Mã hóa đơn')['v'].sum()\nnt = sum(to_num(pd.Series([r['Tổng sau giảm giá']])).iloc[0] - same.get(r['Mã hóa đơn'],0) for _,r in mo.iterrows())\ntra = sq[(sq.pd>sq.od)&(sq.pd>='2025-03-01')&(sq.pd<='2025-03-31')]['v'].sum()\nRESULT = [round(nt), round(tra)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_19fd4b015e4b", "type": "number", "answer": 111, "_code": "h = DuLieuBanHang['DanhSachHoaDon'].copy()\nh['od'] = pd.to_datetime(h['Thời gian tạo']).dt.normalize()\nend = pd.Timestamp('2026-04-24')\nh = h[(h.od<=end) & h['Mã KH'].notna() & (h['Phương thức thanh toán']!='Thu hộ (COD)') & (h['Kênh bán']!='tmdt') & ~h['Trạng thái'].str.contains('hủy|huỷ', case=False, na=False)]\nsq = DuLieuBanHang['SoQuy'].copy()\nsq['pd'] = pd.to_datetime(sq['Thời gian']).dt.normalize()\nsq = sq[sq.pd<=end]\nsq['v'] = to_num(sq['Giá trị'])\npaid = sq.groupby('Mã hóa đơn')['v'].sum()\nh['debt'] = to_num(h['Tổng sau giảm giá']) - h['Mã hóa đơn'].map(paid).fillna(0)\nRESULT = int(h[h.debt>0]['Mã KH'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_daa477dd5e4a", "type": "number", "answer": 33.0, "_code": "\nd=data['ban_hang'].drop_duplicates().copy()\nd['d']=parse_date(d['Ngày tháng'])\nbad=d.loc[d['Kết quả'].isin(['Đã hủy','Đổi trả']),'Mã hóa đơn'].unique()\nm=d[(d.d.dt.year==2026)&(d.d.dt.month==6)&~d['Mã hóa đơn'].isin(bad)&(d['Nội dung'].map(normalize_text)=='nep cai hoa vang')]\nRESULT=float(to_num(m['Quy ra ĐV lẻ']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d687b5ea56de", "type": "string", "answer": "Nguyễn An Hiếu", "_code": "o=don_hang.drop_duplicates('Số phiếu').copy(); o['d']=parse_date(o['Ngày bán'])\no=o[(o.d>='2025-04-01')&(o.d<='2025-04-30')&o['Tình trạng đơn'].isin(['completed','shipping'])&o['Mã khách mua'].notna()]\nl=chi_tiet_don.drop_duplicates()\nl=l[l['Số CT'].isin(o['Số phiếu'])].copy()\ndef pm(x):\n    x=str(x)\n    if x.endswith('tr'): return float(x[:-2].replace(',','.'))*1e6\n    return float(x.replace('đ','').replace('.',''))\nl['v']=l['Tiền bán'].map(pm)\nl['c']=l['Số CT'].map(o.set_index('Số phiếu')['Mã khách mua'])\nc=l.groupby('c').v.sum().sort_values(ascending=False).index[0]\nkh=khach_hang\nRESULT=kh.loc[kh['Mã khách lẻ/sỉ']==c,'KH'].iloc[0]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_6a623646996a", "type": "unanswerable", "answer": "unanswerable", "_code": "cols=' '.join(str(c).lower() for k,v in data.items() if hasattr(v,'columns') for c in v.columns if k.startswith('DonNhap') or k.startswith('Danh'))\nRESULT='unanswerable' if not any(w in cols for w in ['giá nhập','đơn giá','thành tiền','giá vốn']) else 'check'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_327ffb3f517d", "type": "list", "answer": ["Đỗ Duy Khánh", "Tô Phương Hương", "Ngô Bảo Nam"], "_code": "df=DonHang_ChiTiet__all.copy()\ndf=df[~df['Tên khách hàng'].astype(str).str.startswith('Tổng')]\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\ndf[hc]=df[hc].ffill(); df=df.drop_duplicates()\ndf['d']=parse_date(df['Ngày đặt hàng'])\nbad=df['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\ndf=df[~df['Mã đơn hàng'].isin(set(df.loc[bad,'Mã đơn hàng']))]\ndf=df[(df.d>='2025-06-02')&(df.d<='2025-06-08')]\ndf=df[~df['Tên khách hàng'].astype(str).str.contains('lẻ',case=False)]\ndf['t']=to_num(df['Tổng tiền'])\nRESULT=list(df.groupby('Tên khách hàng')['t'].sum().sort_values(ascending=False).head(3).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_aacf9543a235", "type": "string", "answer": "Vương Phương Loan - 0973 189 069", "_code": "\nh=data['DanhSachHoaDon'].drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả|Hoàn trả',case=False,na=False)\ndet=pd.concat([data['DanhSachHoaDonChiTiet_1'],data['DanhSachHoaDonChiTiet_2']]).drop_duplicates(['Mã hóa đơn','STT']).copy()\ndet['amt']=to_num(det['Thành tiền'])\nh['rev']=h['Mã hóa đơn'].map(det.groupby('Mã hóa đơn')['amt'].sum()).fillna(0)\nok=h[~bad]\n\nm=ok[(ok.d.dt.year==2026)&(ok.d.dt.month==3)&ok['Mã KH'].notna()]\ns=m.groupby('Mã KH').rev.sum().sort_values(ascending=False)\nnm=data['DanhSachKhachHang'].set_index('Mã khách hàng')['Tên khách hàng']\nRESULT=nm[s.index[0]]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_97654148d172", "type": "number", "answer": 5.0, "_code": "\nh=data['DanhSachHoaDon'].drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nbad=h['Trạng thái'].str.contains('hủy|huỷ|trả|Hoàn trả',case=False,na=False)\ndet=pd.concat([data['DanhSachHoaDonChiTiet_1'],data['DanhSachHoaDonChiTiet_2']]).drop_duplicates(['Mã hóa đơn','STT']).copy()\ndet['amt']=to_num(det['Thành tiền'])\nh['rev']=h['Mã hóa đơn'].map(det.groupby('Mã hóa đơn')['amt'].sum()).fillna(0)\nok=h[~bad]\n\nsp=data['DanhSachSanPham']; print(sp.columns.tolist())\ncode=sp[sp['Tên hàng'].str.contains('croissant',case=False)]['Mã hàng'].iloc[0]\nf=dict(zip(data['DanhSachDonViTinh']['Mã hàng']+'|'+data['DanhSachDonViTinh']['ĐVT'],to_num(data['DanhSachDonViTinh']['Quy đổi'])))\nph=data['DanhSachNhapHang'].copy(); ph['d']=parse_date(ph['Thời gian'])\nph=ph[(ph.d.dt.year==2025)&(ph.d.dt.month==10)&~ph['Trạng thái'].str.contains('hủy|huỷ',case=False,na=False)]\nct=data['DanhSachChiTietNhapHang']; ct=ct[ct['Mã nhập hàng'].isin(ph['Mã nhập hàng'])&(ct['Mã hàng']==code)]\nnhap=sum(to_num(pd.Series([r['Số lượng']])).iloc[0]*f.get(code+'|'+r['ĐVT'],1) for _,r in ct.iterrows())\ndd=det[det['Mã hàng']==code].merge(ok[(ok.d.dt.year==2025)&(ok.d.dt.month==10)][['Mã hóa đơn']],on='Mã hóa đơn')\nban=to_num(dd['Số lượng quy đổi']).sum()\nRESULT=float(nhap-ban)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e3a84595133f", "type": "string", "answer": "Vũ Quân Hằng", "_code": "h=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[(h.d>='2025-08-01')&(h.d<='2025-08-31')&h['Mã KH'].notna()]\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|Huỷ|trả|Đổi trả',case=False,na=False)]\nl=DanhSachHoaDonChiTiet.drop_duplicates()\nl=l[l['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nl['v']=to_num(l['Thành tiền'])\nl['c']=l['Mã hóa đơn'].map(h.set_index('Mã hóa đơn')['Mã KH'])\nc=l.groupby('c').v.sum().sort_values(ascending=False).index[0]\nRESULT=DanhSachKhachHang.loc[DanhSachKhachHang['Mã khách hàng']==c,'Tên khách hàng'].iloc[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f7b5101e0899", "type": "number", "answer": 974738600, "_code": "d = ban_hang.copy()\nd['d'] = parse_date(d['Ngày'])\nd = d[(d.d.dt.year==2025)&(d.d.dt.month==7)]\nbad = d[d['trang_thai'].str.contains('hủy|huỷ|Trả', case=False, na=False)]['Mã GD'].unique()\nd = d[~d['Mã GD'].isin(bad)]\nRESULT = round(to_num(d['Tổng']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e4af6840f35a", "type": "percent", "answer": 19.76, "_code": "o = don_hang.copy()\no['d'] = parse_date(o['NgayBan'])\no = o[(o.d.dt.year==2026)&(o.d.dt.month==6)]\no = o[o['Xử lý'].isin(['completed','shipping'])]\nl = chi_tiet_don.copy(); l['v'] = to_num(l['T.Tiền'])\nrev = l.groupby('Ma don')['v'].sum()\no['rev'] = o['Mã chứng từ'].map(rev).fillna(0)\ngrp = khach_hang.set_index('ma_kh')['Nhóm']\no['g'] = o['Số KH'].map(grp)\nRESULT = f\"{o[o.g=='thân thiết']['rev'].sum()/o['rev'].sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5b6a3b66bd13", "type": "date", "answer": "2025-11-30", "_code": "o = don_hang.copy()\no['d'] = parse_date(o['NgayBan'])\no = o[(o.d.dt.year==2025)&(o.d.dt.month==11)]\no = o[o['Xử lý'].isin(['completed','shipping'])]\nl = chi_tiet_don.copy(); l['v'] = to_num(l['T.Tiền'])\no['rev'] = o['Mã chứng từ'].map(l.groupby('Ma don')['v'].sum()).fillna(0)\nRESULT = o.groupby('d')['rev'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_677857a48e39", "type": "number", "answer": 145.0, "_code": "d=So_chi_tiet_ban_hang_1__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày'])\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả|hoàn trả',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)&(d.dt>='2026-04-01')&(d.dt<='2026-04-30')]\nd=d[d['Tên hàng hóa'].str.lower().str.strip()=='sinh tố xoài (m)']\nRESULT=float(to_num(d['Số lượng']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9b8e86f964ef", "type": "percent", "answer": -4.66, "_code": "import re as _re\ndef mny(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=_re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*10**6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    elif _re.fullmatch(r'\\d+(,\\d{3})*\\.0+',s): v=float(s.replace(',',''))\n    elif _re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    else: v=float(_re.sub(r'[^\\d.]','',s.replace(',','')) or 'nan')\n    return -v if neg else v\no=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\no=o[~o['Tên khách hàng'].astype(str).str.startswith('Tổng')]\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\no[hc]=o[hc].ffill(); o=o.drop_duplicates()\no['d']=parse_date(o['Ngày đặt hàng']); o['a']=o['Tổng tiền'].map(mny)\nbad=set(o[o['Trạng thái đơn hàng'].astype(str).str.contains('hủy|huỷ|hoàn hàng|trả',case=False)]['Mã đơn hàng'])\ng=o[~o['Mã đơn hàng'].isin(bad)]\nt=pd.Timestamp(as_of_date)\ncur=g[(g.d>=t.replace(day=1))&(g.d<=t)].a.sum()\np=(t.replace(day=1)-pd.Timedelta(days=1)); pe=min(p.replace(day=t.day) if t.day<=p.day else p, p)\nprev=g[(g.d>=p.replace(day=1))&(g.d<=pe)].a.sum()\nRESULT=f\"{(cur-prev)/prev*100:.2f}%\"\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_cd7bfdbf4d08", "type": "unanswerable", "answer": "unanswerable", "_code": "\ncols=[]\nfor k,v in data.items():\n    if k.startswith('_') or '__' in k: continue\n    if isinstance(v,dict): v=next(iter(v.values()))\n    cols+=list(v.columns)\nassert not any(w in x.lower() for x in cols for w in ('giá vốn','gia von','vốn','cost')), cols\nRESULT='unanswerable'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ecca6bcc3dfc", "type": "unanswerable", "answer": "unanswerable", "_code": "\ncols=[]\nfor k,v in data.items():\n    if k.startswith('_') or '__' in k: continue\n    if isinstance(v,dict): v=next(iter(v.values()))\n    cols+=list(v.columns)\nassert not any(w in x.lower() for x in cols for w in ('nợ','còn','thanh toán','đã trả','công nợ','khách trả')), cols\nRESULT='unanswerable'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_11d14818cbfc", "type": "string", "answer": "Panadol Extra hộp 15 vỉ x 12 viên", "_code": "o = don_hang.copy()\no['d'] = pd.to_datetime(o['ThoiGianLap']).dt.normalize()\no = o[(o.d>='2025-07-01')&(o.d<='2025-07-31')&o.TinhTrang.isin(['completed','shipping'])]\nc = chi_tiet_don.drop_duplicates()\nc = c[c.MaHoaDon.isin(o.MaHoaDon)].copy()\nc['q'] = to_num(c['SLQuyDoi'])\ntop = c.groupby('MaHangHoa')['q'].sum().sort_values(ascending=False).index[0]\nRESULT = san_pham[san_pham.MaHangHoa==top]['TenGoi'].iloc[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_33f75059825a", "type": "list", "answer": [10849600, 15777900], "_code": "o = don_hang.copy()\no['d'] = pd.to_datetime(o['ThoiGianLap']).dt.normalize()\no = o[(o.d>='2026-04-01')&(o.d<='2026-04-30')&o.TinhTrang.isin(['completed','shipping'])]\nc = chi_tiet_don.drop_duplicates().copy()\nc['v'] = to_num(c['TriGia'])\nrev = c.groupby('MaHoaDon')['v'].sum()\no['rev'] = o.MaHoaDon.map(rev).fillna(0)\ns = o.groupby('PhuongThucTT')['rev'].sum()\nRESULT = [round(s.get('cod',0)), round(s.get('ewallet',0))]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5186dc3dd581", "type": "list", "answer": [264914500, 305793500, 295438500], "_code": "h=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nl=pd.concat([DanhSachHoaDonChiTiet_1,DanhSachHoaDonChiTiet_2],ignore_index=True).drop_duplicates()\nl=l[l['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nl['v']=to_num(l['Thành tiền'])\nl['m']=l['Mã hóa đơn'].map(h.set_index('Mã hóa đơn')['d']).dt.strftime('%Y-%m')\ng=l.groupby('m').v.sum()\nRESULT=[int(round(g.get(k,0))) for k in ['2025-11','2025-12','2026-01']]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_dcc0b785c232", "type": "number", "answer": 158315, "_code": "\ndf=data['DonHang_ChiTiet__all'].drop_duplicates().copy()\ndf['d']=parse_date(df['Ngày đặt hàng']); df['amt']=to_num(df['Tổng tiền'])\nst=df['Trạng thái đơn hàng'].str.lower()\nbad=df.loc[st.str.contains('hủy|huỷ|hoàn hàng|trả'),'Mã đơn hàng'].unique()\nm=df[(df.d.dt.year==2025)&(df.d.dt.month==2)&~df['Mã đơn hàng'].isin(bad)]\nRESULT=int(m.amt.sum()/m['Mã đơn hàng'].nunique()+0.5)\n", "_attempts": 1, "_verdict": "correct"}
