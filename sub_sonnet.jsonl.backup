{"id": "q_f708372b97df", "type": "number", "answer": 84, "_code": "import re\nd=ban_hang.copy()\nd=d.drop_duplicates()\ndt=parse_date(d['Ngày'])\nd=d[(dt.dt.year==2025)&(dt.dt.month==9)]\nd=d[~d['trang_thai'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nd=d[d['Sản phẩm'].str.lower().str.strip()=='đinh 5 phân']\nRESULT=to_num(d['Quy ra ĐV lẻ']).sum()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_852a88cb4c90", "type": "percent", "answer": -5.84, "_code": "d=DonHang_ChiTiet.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\nd['v']=to_num(d['Tổng tiền'])\ndef rev(y,m): \n    x=d[(d.dt.dt.year==y)&(d.dt.dt.month==m)]; return x['v'].sum()\na,b=rev(2025,9),rev(2025,8)\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_54209fe01815", "type": "number", "answer": 121500.0, "_code": "import re as _re\ndef money(s):\n    if s is None or (isinstance(s,float) and s!=s): return float('nan')\n    if isinstance(s,(int,float)): return float(s)\n    s=str(s).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if not s: return float('nan')\n    try:\n        if 'tr' in s:\n            a,b=s.split('tr',1)\n            a=a or '0'\n            if b=='': return float(a.replace(',','.'))*1e6\n            return int(a.replace('.','').replace(',',''))*1e6+int(b.ljust(3,'0')[:3])*1e3\n        if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n        if ',' in s and '.' in s:\n            return float(s.replace(',','')) if s.rfind('.')>s.rfind(',') else float(s.replace('.','').replace(',','.'))\n        if '.' in s:\n            return float(s.replace('.','')) if _re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s) else float(s)\n        if ',' in s:\n            return float(s.replace(',','')) if _re.fullmatch(r'-?\\d{1,3}(,\\d{3})+',s) else float(s.replace(',','.'))\n        return float(s)\n    except Exception: return float('nan')\nd=SoBanHang__all.copy()\nd['dt']=pd.to_datetime(d['Giờ'].astype(str).str[:10],errors='coerce')\nx=d[(d['dt']=='2025-09-17')&(d['Tên SP'].str.contains('Hà Tiên PCB40',na=False))]\nconv=dict(zip(DanhMuc['Hàng'],zip(DanhMuc['ĐV lớn'],DanhMuc['Hệ số QĐ'])))\ndef per_base(r):\n    p=money(r['Giá']); u=str(r['DonVi']).strip().lower()\n    if r['Tên SP'] in conv and conv[r['Tên SP']][0].lower()==u: return p/float(conv[r['Tên SP']][1])\n    return p\nRESULT=float(x.apply(per_base,axis=1).iloc[0])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_deda5ca0e895", "type": "number", "answer": 1305000, "_code": "a=DonHang_ChiTiet__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[h]=a[h].ffill(); a=a.drop_duplicates()\na['d']=parse_date(a['Ngày đặt hàng']); a['v']=to_num(a['Tổng tiền'])\na=a[~a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]\np=a[a['Tên sản phẩm'].str.contains('Colgate',case=False)&(a.d>='2025-09-01')&(a.d<='2025-09-30')]\nRESULT=int(round(p.v.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d1afd5b54439", "type": "number", "answer": 2687, "_code": "d=don_hang.copy().drop_duplicates()\nd['od']=parse_date(d['NgayBan'])\nok=d[d['Xử lý'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().copy()\nc['a']=to_num(c['T.Tiền']); c['q']=to_num(c['SL quy đổi'])\nc=c.merge(ok[['Mã chứng từ','od']],left_on='Ma don',right_on='Mã chứng từ')\nsp=san_pham.copy(); sp['SKU']=sp['SKU'].ffill()\nc=c.merge(sp[['SKU','Sản phẩm','Đơn vị']],left_on='ID SP',right_on='SKU',how='left')\nm=c[(c.od>='2026-02-01')&(c.od<='2026-02-28')&c['Sản phẩm'].str.strip().str.lower().str.endswith('(m)')&(c['Đơn vị']=='ly')]\nRESULT=int(m.q.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_63501211fe59", "type": "percent", "answer": -66.67, "_code": "a=DonHang_ChiTiet__all.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[h]=a[h].ffill(); a=a.drop_duplicates()\na['d']=parse_date(a['Ngày đặt hàng'])\na=a[~a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|cancel',case=False,na=False)]\np=a[a['Tên sản phẩm'].str.contains('Maggi',case=False)].copy()\nf={'thùng':12}\np['q']=to_num(p['Số lượng sản phẩm'])*p['Đơn vị tính'].map(lambda u:12 if u=='thùng' else 1)\nD=pd.Timestamp('2026-02-17')\nn=p[(p.d>=D)&(p.d<=D+pd.Timedelta(days=6))].q.sum(); o=p[(p.d>=D-pd.Timedelta(days=7))&(p.d<D)].q.sum()\nRESULT=f\"{round((n-o)/o*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_720eeed8ec53", "type": "percent", "answer": 19.59, "_code": "d=don_hang.copy().drop_duplicates()\nd['od']=parse_date(d['NgayBan'])\nd=d[d['Xử lý'].isin(['completed','shipping'])]\nc=chi_tiet_don.drop_duplicates().copy(); c['a']=to_num(c['T.Tiền'])\nd['v']=d['Mã chứng từ'].map(c.groupby('Ma don').a.sum()).fillna(0)\nd=d[(d.od>='2026-08-01')&(d.od<='2026-08-19')]\ng=khach_hang.set_index('ma_kh')['Nhóm']\nd['g']=d['Số KH'].map(g)\nRESULT=f\"{round(d[d.g=='thân thiết'].v.sum()/d.v.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4afebc6d1d4b", "type": "percent", "answer": 16.99, "_code": "h=DanhSachHoaDon.copy(); h[\"od\"]=pd.to_datetime(h[\"Thời gian tạo\"]).dt.normalize()\nh=h[~h[\"Trạng thái\"].str.contains(\"hủy|huỷ|cancel|trả\",case=False,na=False)]\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy(); c[\"a\"]=to_num(c[\"Thành tiền\"])\nh[\"v\"]=h[\"Mã hóa đơn\"].map(c.groupby(\"Mã hóa đơn\").a.sum()).fillna(0)\n\nt=h[(h.od>=\"2026-05-01\")&(h.od<=\"2026-05-29\")].copy()\ng=DanhSachKhachHang.set_index(\"Mã khách hàng\")[\"Nhóm khách hàng\"]\nt[\"g\"]=t[\"Mã KH\"].map(g)\nRESULT=f'{t[t.g==\"sỉ\"].v.sum()/t.v.sum()*100:.2f}%'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c081925709b7", "type": "percent", "answer": -17.94, "_code": "df = DonHang_ChiTiet__all.drop_duplicates().copy()\ndf['d'] = parse_date(df['Ngày đặt hàng'])\ndf['amt'] = pd.to_numeric(df['Tổng tiền'].astype(str).str.replace(',', ''), errors='coerce')\nbad = df.groupby('Mã đơn hàng')['Trạng thái đơn hàng'].apply(lambda s: s.str.contains('hủy|huỷ|hoàn hàng|trả|cancel', case=False, na=False).any())\ndf = df[~df['Mã đơn hàng'].map(bad)]\ndef rev(y, m):\n    return df[(df.d.dt.year == y) & (df.d.dt.month == m)]['amt'].sum()\ncur = rev(2025, 2)\npm, py = (2 - 1, 2025) if 2 > 1 else (12, 2025 - 1)\nprev = rev(py, pm)\nRESULT = f\"{round((cur - prev) / prev * 100, 2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
