{"id": "q_1c8ebf49a78b", "type": "percent", "answer": 2.95, "_code": "d=DonHang_ChiTiet.copy()\nd[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']]=d[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']].ffill()\nd=d.drop_duplicates()\ndt=parse_date(d['Ngày đặt hàng'])\nd=d[(dt>='2025-03-01')&(dt<='2025-03-31')]\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\nsp=DuLieuXuat['DanhSachSanPham']; th=DuLieuXuat['DanhSachThuoc']\nrx=set(sp[sp['Mã SKU'].isin(th[th['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1'])]['Mã SKU'])]['Tên sản phẩm'].map(vn_normalize))\nd['a']=to_num(d['Tổng tiền'])\ntot=d.a.sum(); r=d[d['Tên sản phẩm'].map(vn_normalize).isin(rx)].a.sum()\nRESULT=f\"{r/tot*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1ccb81c372d3", "type": "number", "answer": 69, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\nh=DanhSachHoaDon.copy()\nh['dt']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|hoàn trả',case=False,na=False)]\nh=h[(h.dt.dt.year==2025)&(h.dt.dt.month==8)&h['Mã KH'].notna()]\nc=h.groupby('Mã KH')['Mã hóa đơn'].nunique()\nRESULT=int((c>=12).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_983e4fc2d9f7", "type": "percent", "answer": 5.18, "_code": "h = DanhSachHoaDon__all.copy()\nh[\"d\"] = parse_date(h[\"Thời gian\"])\nh = h[~h[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả\", case=False, na=False)]\nl = DanhSachHoaDonChiTiet.drop_duplicates().copy()\nl[\"amt\"] = pd.to_numeric(l[\"Thành tiền\"].astype(str).str.replace(r\"[^\\d]\", \"\", regex=True), errors=\"coerce\")\nl = l.merge(h[[\"Mã hóa đơn\", \"d\"]], on=\"Mã hóa đơn\")\n\nm = l[(l.d.dt.year == 2025) & (l.d.dt.month == 11)]\ngrp = DanhSachSanPham.set_index(\"Mã hàng\")[\"Nhóm hàng(3 Cấp)\"]\nnum = m[m[\"Mã hàng\"].map(grp) == \"dị ứng\"][\"amt\"].sum()\nRESULT = f\"{round(num / m['amt'].sum() * 100, 2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ad5955091414", "type": "number", "answer": 4670900, "_code": "h = DanhSachHoaDon__all.copy()\nh[\"d\"] = parse_date(h[\"Thời gian\"])\nh = h[~h[\"Trạng thái\"].str.contains(\"hủy|huỷ|trả\", case=False, na=False)]\nl = DanhSachHoaDonChiTiet.drop_duplicates().copy()\nl[\"amt\"] = pd.to_numeric(l[\"Thành tiền\"].astype(str).str.replace(r\"[^\\d]\", \"\", regex=True), errors=\"coerce\")\nl = l.merge(h[[\"Mã hóa đơn\", \"d\"]], on=\"Mã hóa đơn\")\n\nm = l[(l.d >= \"2026-07-01\") & (l.d <= pd.Timestamp(as_of_date))]\ncodes = DanhSachThuoc[DanhSachThuoc[\"Hoạt chất\"].str.strip().str.lower() == \"ibuprofen\"][\"Mã hàng\"]\nRESULT = int(m[m[\"Mã hàng\"].isin(codes)][\"amt\"].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_521894a57efb", "type": "percent", "answer": 1.96, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\no=don_hang.drop_duplicates().drop_duplicates('Mã chứng từ').copy(); o['d']=pdate(o['Ngày'])\nm=o[(o.d>='2025-07-01')&(o.d<='2025-07-31')]\nRESULT=f\"{m['Tình trạng'].eq('cancelled').sum()/len(m)*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6d25579304d1", "type": "number", "answer": 72462, "_code": "\nd=pd.concat([So_chi_tiet_ban_hang_1__all,So_chi_tiet_ban_hang_2026__all],ignore_index=True).drop_duplicates().reset_index(drop=True)\nd['dt']=parse_date(d['Ngày'])\nbad=d['Trạng thái'].str.contains('hủy|huỷ|cancel|trả',case=False,na=False)\nbad_orders=set(d[bad]['Mã đơn hàng'])\nd=d[(d.dt.dt.year==2026)&(d.dt.dt.month==4)&~d['Mã đơn hàng'].isin(bad_orders)].copy()\nd['v']=d['Thành tiền'].astype(str).str.replace(',','').astype(float)\no=d.groupby('Mã đơn hàng').v.sum()\nimport math\nRESULT=int(math.floor(o.mean()+0.5))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_f1fe75cfb100", "type": "percent", "answer": 19.21, "_code": "d=DonHang_ChiTiet.copy()\nd[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']]=d[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']].ffill()\nd=d.drop_duplicates()\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)]\ndt=parse_date(d['Ngày đặt hàng']); d['a']=to_num(d['Tổng tiền'])\nr=lambda s,e:d[(dt>=s)&(dt<=e)].a.sum()\na=r('2025-10-01','2025-10-16'); b=r('2025-09-01','2025-09-16')\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b7022bab5d6c", "type": "number", "answer": 43, "_code": "a=DonHang_ChiTiet__all.dropna(subset=['Mã đơn hàng']).drop_duplicates().copy()\na['od']=parse_date(a['Ngày đặt hàng'])\no=a.groupby('Mã đơn hàng').agg(od=('od','first'),st=('Trạng thái đơn hàng','first'))\nbad=o.st.str.contains('hủy|huỷ|hoàn hàng|trả',case=False)\nRESULT=int(((o.od=='2025-11-19')&~bad).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d4cbe9dbe3d0", "type": "percent", "answer": 2.8, "_code": "h=DanhSachHoaDon__all.copy(); h[\"ts\"]=pd.to_datetime(h[\"Thời gian tạo\"]); h[\"od\"]=h.ts.dt.normalize()\nh=h[~h[\"Trạng thái\"].str.contains(\"hủy|huỷ|cancel|trả\",case=False,na=False)]\nc=DanhSachHoaDonChiTiet.copy(); c[\"a\"]=to_num(c[\"Thành tiền\"])\n\nt=h[(h.od>=\"2025-12-01\")&(h.od<=\"2025-12-31\")]\ncc=c[c[\"Mã hóa đơn\"].isin(t[\"Mã hóa đơn\"])].copy()\nrx=set(DanhSachThuoc[DanhSachThuoc[\"Thuốc kê đơn\"].astype(str)==\"True\"][\"Mã hàng\"])\nRESULT=f'{cc[cc[\"Mã hàng\"].isin(rx)].a.sum()/cc.a.sum()*100:.2f}%'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b218cee27fe9", "type": "percent", "answer": 47.54, "_code": "h=DanhSachHoaDon__all.copy(); h[\"ts\"]=pd.to_datetime(h[\"Thời gian tạo\"]); h[\"od\"]=h.ts.dt.normalize()\nh=h[~h[\"Trạng thái\"].str.contains(\"hủy|huỷ|cancel|trả\",case=False,na=False)]\nc=DanhSachHoaDonChiTiet.copy(); c[\"a\"]=to_num(c[\"Thành tiền\"])\n\nt=h[(h.od>=\"2025-04-01\")&(h.od<=\"2025-04-30\")]\nm=t[(t.ts.dt.hour>=6)&(t.ts.dt.hour<=13)][\"Mã hóa đơn\"].nunique(); n=t[(t.ts.dt.hour>=14)&(t.ts.dt.hour<=21)][\"Mã hóa đơn\"].nunique()\nRESULT=f\"{(n-m)/m*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_a77c5a478efe", "type": "percent", "answer": 23.1, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\no=don_hang.drop_duplicates().drop_duplicates('Mã chứng từ').copy(); o['d']=pdate(o['Ngày'])\nc=chi_tiet_don.drop_duplicates().copy(); c['v']=money(c['Amount'])\nsp=san_pham.set_index('Mã sản phẩm bán')['Danh mục']\ng=o[(o.d>='2026-06-01')&(o.d<='2026-06-30')&o['Tình trạng'].isin(['completed','shipping'])]\ncc=c[c['Mã đơn hàng'].isin(g['Mã chứng từ'])]\nRESULT=f\"{cc[cc['Mã mặt hàng'].map(sp).str.lower()=='lẩu'].v.sum()/cc.v.sum()*100:.2f}%\"\nprint(san_pham['Danh mục'].unique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b0a25a04e976", "type": "percent", "answer": 7.95, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\no=don_hang.drop_duplicates().drop_duplicates('Số phiếu').copy(); o['d']=pdate(o['Ngày bán'])\nc=chi_tiet_don.drop_duplicates().copy(); c['v']=money(c['Tiền bán'])\ng=o[(o.d>='2025-03-01')&(o.d<='2025-03-31')&o['Tình trạng đơn'].isin(['completed','shipping'])]\ncc=c[c['Số CT'].isin(g['Số phiếu'])]\nnh=san_pham.set_index('Mã HH')['Nhom hang']\nRESULT=f\"{cc[cc['Mã hàng bán'].map(nh)=='hải sản'].v.sum()/cc.v.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_dea8cc5d0d50", "type": "number", "answer": 1225.0, "_code": "\nO=don_hang.drop_duplicates().copy(); C=chi_tiet_don.drop_duplicates().copy()\nO['d']=parse_date(O['NgayBan'])\nst=O['Xử lý'].astype(str).str.lower()\nO=O[~st.str.contains('cancel|hủy|huỷ|return|trả')]\nO=O[(O.d>=as_of_date[:8]+'01')&(O.d<=as_of_date)]\nC=C[C['Ma don'].isin(O['Mã chứng từ'])].merge(san_pham[['SKU','Sản phẩm']],left_on='ID SP',right_on='SKU')\nC=C[C['Sản phẩm'].str.strip().str.lower().str.endswith('(l)')]\nRESULT=float(pd.to_numeric(C['SL quy đổi'].astype(str).str.extract(r'([\\d.]+)')[0]).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_c79ab64fce22", "type": "number", "answer": 83569100, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn')\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nt=pd.to_datetime(h['Thời gian tạo'])\nh=h[(t>='2026-05-01')&(t<'2026-06-01')&(t.dt.hour>=14)&(t.dt.hour<=21)]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\nRESULT=int(round(c['Thành tiền'].map(m).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_98483986096b", "type": "percent", "answer": 2.49, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn')\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nt=pd.to_datetime(h['Thời gian tạo'])\nh=h[(t>='2025-05-01')&(t<'2025-06-01')]\nc=DanhSachHoaDonChiTiet.drop_duplicates()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy(); c['a']=c['Thành tiền'].map(m)\nrx=set(DanhSachThuoc[DanhSachThuoc['Thuốc kê đơn'].astype(str).str.lower().isin(['true','1'])]['Mã hàng'])\nRESULT=f\"{c[c['Mã hàng'].isin(rx)].a.sum()/c.a.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b85681f4c12b", "type": "percent", "answer": 1.65, "_code": "a=DonHang_ChiTiet.dropna(subset=['Mã đơn hàng']).drop_duplicates().copy()\na['od']=parse_date(a['Ngày đặt hàng']); a['m']=to_num(a['Tổng tiền'])\nst=a.groupby('Mã đơn hàng')['Trạng thái đơn hàng'].first()\no=a.groupby('Mã đơn hàng').agg(od=('od','first'),v=('m','sum')); o['st']=st\nbad=o.st.str.contains('hủy|huỷ|hoàn hàng|trả',case=False)\nt=o[(o.od>='2026-05-01')&(o.od<='2026-05-20')]\nRESULT=f\"{round(t.st.str.contains('hủy|huỷ',case=False).mean()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_54a0ebc48c6a", "type": "number", "answer": 96, "_code": "a=DonHang_ChiTiet.dropna(subset=['Mã đơn hàng']).drop_duplicates().copy()\na['od']=parse_date(a['Ngày đặt hàng']); a['m']=to_num(a['Tổng tiền'])\nst=a.groupby('Mã đơn hàng')['Trạng thái đơn hàng'].first()\no=a.groupby('Mã đơn hàng').agg(od=('od','first'),v=('m','sum')); o['st']=st\nbad=o.st.str.contains('hủy|huỷ|hoàn hàng|trả',case=False)\nRESULT=int(((o.od=='2026-01-29')&~bad).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3b29ba188ca3", "type": "percent", "answer": 42.46, "_code": "a=DonHang_ChiTiet.dropna(subset=['Mã đơn hàng']).drop_duplicates().copy()\na['od']=parse_date(a['Ngày đặt hàng']); a['m']=to_num(a['Tổng tiền'])\nst=a.groupby('Mã đơn hàng')['Trạng thái đơn hàng'].first()\no=a.groupby('Mã đơn hàng').agg(od=('od','first'),v=('m','sum')); o['st']=st\nbad=o.st.str.contains('hủy|huỷ|hoàn hàng|trả',case=False)\ng=o[~bad]; r=lambda s,e:g[(g.od>=s)&(g.od<=e)].v.sum()\nRESULT=f\"{round((r('2026-03-01','2026-03-31')/r('2026-02-01','2026-02-28')-1)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2a9f4fc5fb1f", "type": "percent", "answer": -4.09, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[oc]=d[oc].ffill()\nd=d.drop_duplicates().reset_index(drop=True)\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)].copy()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd['v']=d['Tổng tiền'].map(money)\na=d[(d.dt.dt.year==2026)&(d.dt.dt.month==5)].v.sum()\nb=d[(d.dt.dt.year==2026)&(d.dt.dt.month==4)].v.sum()\nRESULT=f\"{round((a/b-1)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8bbd7654443e", "type": "percent", "answer": -41.3, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\noc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nd[oc]=d[oc].ffill()\nd=d.drop_duplicates().reset_index(drop=True)\nd=d[~d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|hoàn hàng|trả',case=False,na=False)].copy()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd=d[d['Tên sản phẩm']=='Siro Tiffy chai 30ml'].copy()\nd['q']=pd.to_numeric(d['Số lượng sản phẩm'].astype(str).str.extract(r'(-?[\\d.]+)')[0])\nD=pd.Timestamp('2026-05-09')\na=d[(d.dt>=D)&(d.dt<D+pd.Timedelta(days=14))].q.sum()\nb=d[(d.dt>=D-pd.Timedelta(days=14))&(d.dt<D)].q.sum()\nRESULT=f\"{round((a/b-1)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_28c7be609e45", "type": "number", "answer": 108, "_code": "d=DonHang_ChiTiet.copy()\nd[[\"Mã đơn hàng\",\"Ngày đặt hàng\",\"Trạng thái đơn hàng\"]]=d[[\"Mã đơn hàng\",\"Ngày đặt hàng\",\"Trạng thái đơn hàng\"]].ffill()\nd=d.drop_duplicates(); d[\"od\"]=parse_date(d[\"Ngày đặt hàng\"])\nok=d[~d[\"Trạng thái đơn hàng\"].str.contains(\"hủy|huỷ|hoàn hàng|trả\",case=False,na=False)]\nt=ok[(ok.od>=\"2025-12-01\")&(ok.od<=\"2025-12-31\")&(ok[\"Tên sản phẩm\"].str.strip().str.lower()==\"cà phê muối (m)\")]\nRESULT=int(round(to_num(t[\"Số lượng sản phẩm\"]).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_08403edda3c7", "type": "number", "answer": 1694000, "_code": "import unicodedata, re\ndef nk(s):\n    return re.sub(r\"\\s+\", \" \", unicodedata.normalize(\"NFC\", str(s)).strip().lower())\nhc = [\"Mã đơn hàng\", \"Ngày đặt hàng\", \"Trạng thái đơn hàng\", \"Tên khách hàng\"]\ndf = DonHang_ChiTiet.copy()\ndf[hc] = df[hc].ffill()\ndf = df.drop_duplicates()\ndf[\"d\"] = parse_date(df[\"Ngày đặt hàng\"])\ndf[\"amt\"] = pd.to_numeric(df[\"Tổng tiền\"].astype(str).str.replace(r\"[^\\d]\", \"\", regex=True), errors=\"coerce\")\nst = df.groupby(\"Mã đơn hàng\")[\"Trạng thái đơn hàng\"].agg(lambda s: \" \".join(s.dropna().astype(str).unique()))\nbad = st[st.str.contains(\"hủy|huỷ|hoàn hàng|trả\", case=False)].index\ndf = df[~df[\"Mã đơn hàng\"].isin(bad)]\nm = df[(df.d.dt.year == 2026) & (df.d.dt.month == 8)].copy()\nsp = DuLieuXuat[\"DanhSachSanPham\"]; th = DuLieuXuat[\"DanhSachThuoc\"]\ncodes = th[th[\"Hoạt chất\"].astype(str).str.strip().str.lower() == \"vitamin c\"][\"Mã SKU\"]\nnames = {nk(n) for n in sp[sp[\"Mã SKU\"].isin(codes)][\"Tên sản phẩm\"]}\nm = m[m[\"Tên sản phẩm\"].map(nk).isin(names)]\nRESULT = int(m[\"amt\"].sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_75d48f1bfc6d", "type": "percent", "answer": 58.77, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\nx=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nx[hc]=x[hc].ffill()\nx=x.drop_duplicates()\nx['dt']=pd.to_datetime(x['Ngày đặt hàng'],format='%d/%m/%Y',errors='coerce')\nx=x[~x['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)]\nx=x[(x.dt.dt.year==2025)&(x.dt.dt.month==7)]\nx['k']=x['Tên khách hàng'].astype(str).str.strip().str.lower().str.replace(r'\\s+',' ',regex=True)\nx=x[~x.k.str.contains('khách lẻ|vãng lai|^lẻ$')]\nc=x.groupby('k')['Mã đơn hàng'].nunique()\nRESULT=f\"{round((c>=3).sum()/len(c)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_770ce52e8313", "type": "number", "answer": 497099000, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\nh=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=pdate(h['Thời gian']); h['t']=pd.to_datetime(h['Thời gian tạo'],errors='coerce')\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh=h[(h.d>='2025-12-01')&(h.d<='2025-12-31')&(h.t.dt.hour>=14)&(h.t.dt.hour<=21)]\nc=DanhSachHoaDonChiTiet.drop_duplicates(); c=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\nRESULT=int(round(money(c['Thành tiền']).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_68baa146bf59", "type": "percent", "answer": 2.85, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nh=BanHang_HoaDon.drop_duplicates('Order ID')\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|Không giao được|Đổi trả',case=False,na=False)]\nd=parse_date(h['Ngày bán']); h=h[(d>='2025-05-01')&(d<='2025-05-31')]\nc=BanHang_ChiTietHoaDon.drop_duplicates()\nc=c[c['Mã giao dịch'].isin(h['Order ID'])].copy(); c['a']=c['Thanh tien'].map(m)\nrx=set(BanHang_Thuoc[BanHang_Thuoc['Kê đơn'].astype(str).str.lower().isin(['true','1'])]['Mã HH'])\nRESULT=f\"{c[c['Ma hang'].isin(rx)].a.sum()/c.a.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d505726596c7", "type": "percent", "answer": 34.95, "_code": "\nimport unicodedata,re\nX=DonHang_ChiTiet__all.copy()\nfor k in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: X[k]=X[k].ffill()\nX=X.drop_duplicates()\nX['d']=parse_date(X['Ngày đặt hàng'])\nst=X['Trạng thái đơn hàng'].astype(str).str.lower()\nX=X[~st.str.contains('hủy|huỷ|cancel|trả')]\nX['amt']=pd.to_numeric(X['Tổng tiền'].astype(str).str.replace(',',''),errors='coerce')\ndef nm(s): return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s)).strip().lower())\nX['kh']=X['Tên khách hàng'].map(nm)\n\nm=X[(X.d>='2025-04-01')&(X.d<='2025-04-30')]\nm=m[~m.kh.isin(['khách lẻ','kl','khach le','vãng lai'])]\nn=m.groupby('kh')['Mã đơn hàng'].nunique()\nRESULT=f\"{round((n>=4).sum()/len(n)*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_57cfd4ad4045", "type": "percent", "answer": -15.1, "_code": "\nimport unicodedata,re\nX=DonHang_ChiTiet__all.copy()\nfor k in ['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']: X[k]=X[k].ffill()\nX=X.drop_duplicates()\nX['d']=parse_date(X['Ngày đặt hàng'])\nst=X['Trạng thái đơn hàng'].astype(str).str.lower()\nX=X[~st.str.contains('hủy|huỷ|cancel|trả')]\nX['amt']=pd.to_numeric(X['Tổng tiền'].astype(str).str.replace(',',''),errors='coerce')\ndef nm(s): return re.sub(r'\\s+',' ',unicodedata.normalize('NFC',str(s)).strip().lower())\nX['kh']=X['Tên khách hàng'].map(nm)\n\nt=pd.Timestamp(as_of_date); a0=t.replace(day=1); p0=a0-pd.DateOffset(months=1); pe=min(p0+pd.Timedelta(days=t.day-1),a0-pd.Timedelta(days=1))\na=X[(X.d>=a0)&(X.d<=t)].amt.sum(); b=X[(X.d>=p0)&(X.d<=pe)].amt.sum()\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_2345a0429e0d", "type": "number", "answer": 34.0, "_code": "\nX=SoBanHang.copy(); X['d']=parse_date(X['ngay_ban'])\nst=X['Trạng thái xử lý'].astype(str).str.lower()\nX=X[~st.str.contains('hủy|huỷ|cancel|trả|không giao được')]\nm=X[(X['Nội dung'].str.lower().str.contains('nếp cái hoa vàng'))&(X.d>='2025-07-01')&(X.d<='2025-07-31')]\nprint(m['Đơn vị (tính)'].value_counts().to_dict())\nRESULT=float(pd.to_numeric(m['Số lượng lẻ'],errors='coerce').sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_54b11019393a", "type": "percent", "answer": 9.04, "_code": "import re\ndef money(s):\n    def f(x):\n        if pd.isna(x): return 0.0\n        if isinstance(x,(int,float)): return float(x)\n        x=str(x).strip().lower().replace('đ','').replace('vnd','').replace(' ','')\n        m=re.fullmatch(r'(\\d+)tr(\\d*)',x)\n        if m:\n            r=m.group(2); return int(m.group(1))*1e6+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n        m=re.fullmatch(r'(\\d+),(\\d+)tr',x)\n        if m: return float(m.group(1)+'.'+m.group(2))*1e6\n        m=re.fullmatch(r'([\\d,.]+)k',x)\n        if m: return float(m.group(1).replace(',','.'))*1000\n        if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d+)?',x): return float(x.replace(',',''))\n        if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',x): return float(x.replace('.',''))\n        try: return float(x.replace(',',''))\n        except: return float('nan')\n    return s.map(f)\ndef pdate(s):\n    def f(x):\n        if pd.isna(x): return pd.NaT\n        x=str(x).strip()\n        if re.fullmatch(r'\\d{5}(\\.0)?',x): return pd.Timestamp('1899-12-30')+pd.Timedelta(days=int(float(x)))\n        m=re.match(r'(\\d{1,2}) thg (\\d{1,2}) (\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{1,2})/(\\d{1,2})/(\\d{4})',x)\n        if m: return pd.Timestamp(int(m.group(3)),int(m.group(2)),int(m.group(1)))\n        m=re.match(r'(\\d{4})-(\\d{2})-(\\d{2})',x)\n        if m: return pd.Timestamp(int(m.group(1)),int(m.group(2)),int(m.group(3)))\n        return pd.NaT\n    return s.map(f)\ns=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\ns['t']=pdate(s['Ngày']); s['a']=money(s['Thành tiền'])\nBAD=['hủy','huỷ','Trả hàng','hàng trả về','Không giao được']\nbad=set(s[s['Trạng thái'].str.contains('|'.join(BAD),case=False,na=False)]['Mã đơn hàng'])\nx=s[~s['Mã đơn hàng'].isin(bad)]\ndef rv(a,b): return x[(x.t>=a)&(x.t<=b)]\na=rv('2025-09-01','2025-09-16').a.sum(); b=rv('2025-08-01','2025-08-16').a.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_516c1bc19d66", "type": "number", "answer": 36243000, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nc=[\"Mã đơn hàng\",\"Ngày đặt hàng\",\"Trạng thái đơn hàng\",\"Tên khách hàng\"]\nd[c]=d[c].ffill(); d=d.drop_duplicates().reset_index(drop=True)\nd=d[~d[\"Trạng thái đơn hàng\"].str.contains(\"hủy|huỷ|hoàn hàng|trả\",case=False,na=False)].reset_index(drop=True)\ndt=parse_date(d[\"Ngày đặt hàng\"]); d[\"a\"]=d[\"Tổng tiền\"].map(m)\nsp=DanhSachSanPham[DanhSachSanPham['Loại sản phẩm']=='dùng ngoài']['Tên sản phẩm'].map(vn_normalize)\nx=d[(dt>='2025-12-01')&(dt<='2025-12-31')&d['Tên sản phẩm'].map(vn_normalize).isin(set(sp))]\nRESULT=int(round(x.a.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6b6bdecc1726", "type": "percent", "answer": 10.86, "_code": "import re\ndef m(x):\n    if pd.isna(x): return 0.0\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s=='' : return 0.0\n    if 'tr' in s:\n        a,b=s.split('tr'); v=float(a.replace(',','.'))*1e6 if a else 0\n        if b: v+=float(b)*(1000 if len(b)==3 else 10**(6-len(b)))\n        return v\n    if s.endswith('k'): return float(s[:-1].replace(',','.'))*1000\n    if re.match(r'^-?\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\nd=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nc=[\"Mã đơn hàng\",\"Ngày đặt hàng\",\"Trạng thái đơn hàng\",\"Tên khách hàng\"]\nd[c]=d[c].ffill(); d=d.drop_duplicates().reset_index(drop=True)\nd=d[~d[\"Trạng thái đơn hàng\"].str.contains(\"hủy|huỷ|hoàn hàng|trả\",case=False,na=False)].reset_index(drop=True)\ndt=parse_date(d[\"Ngày đặt hàng\"]); d[\"a\"]=d[\"Tổng tiền\"].map(m)\nr=lambda s,e:d[(dt>=s)&(dt<=e)].a.sum()\na=r('2026-04-01','2026-04-10'); b=r('2026-03-01','2026-03-10')\nRESULT=f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9728db568c40", "type": "number", "answer": 172.0, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates().reset_index(drop=True)\nd['q']=pd.to_numeric(d['so_luong'])\nd['dt']=parse_date(d['Ngày giao dịch'])\nbad=d['Status'].str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)|(d.q<0)\nbo=set(d[bad]['Mã hóa đơn'])\nd=d[~d['Mã hóa đơn'].isin(bo)].copy()\nd['v']=d['Trị giá'].map(money)\n\nx=d[(d['Hàng'].str.lower()=='cappuccino (m)')&(d.dt.dt.year==2026)&(d.dt.dt.month==1)]\nRESULT=float(x.q.sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d767d5ca414e", "type": "percent", "answer": 104.95, "_code": "import re\ndef money(x):\n    \"\"\"parse VN money strings: 1tr090, 45k, 1,5tr, 45.000đ, 1,500.0000, plain numbers\"\"\"\n    if x is None or (isinstance(x,float) and x!=x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace('vnd','').replace(' ','')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        if b: return float(a+'.'+b)*1e6\n        return int(a)*1e6+(int(c.ljust(3,'0')[:3])*1000 if c else 0)\n    m=re.fullmatch(r'(\\d+(?:[.,]\\d+)?)k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+(\\.\\d*)?',s): return float(s.replace(',',''))\n    try: return float(s.replace(',','.'))\n    except: return float('nan')\n\nx=DonHang_ChiTiet__all.copy()\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\nx[hc]=x[hc].ffill(); x=x.drop_duplicates()\nx['dt']=pd.to_datetime(x['Ngày đặt hàng'],format='%d/%m/%Y',errors='coerce')\nx=x[~x['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)]\nx=x[x['Tên sản phẩm']=='Nước suối Lavie 1.5L']\nq=pd.to_numeric(x['Số lượng sản phẩm'].astype(str).str.extract(r'([\\d.]+)')[0])\nf=x['Đơn vị tính'].map({'chai':1,'lốc':6,'thùng':12})\nx['q']=q*f\nD=pd.Timestamp('2026-01-27')\na=x[(x.dt>=D)&(x.dt<=D+pd.Timedelta(days=29))].q.sum()\nb=x[(x.dt>=D-pd.Timedelta(days=30))&(x.dt<D)].q.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ea9608e77cc1", "type": "number", "answer": 81885000.0, "_code": "def money(x):\n    import re\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.fullmatch(r'(-?)(\\d+)tr(\\d*)',s)\n    if m: return (-1 if m.group(1) else 1)*(int(m.group(2))*1e6+(int(m.group(3).ljust(3,'0'))*1e3 if m.group(3) else 0))\n    m=re.fullmatch(r'(-?)([\\d.,]+)tr',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e6\n    m=re.fullmatch(r'(-?)([\\d.,]+)k',s)\n    if m: return (-1 if m.group(1) else 1)*float(m.group(2).replace(',','.'))*1e3\n    if re.fullmatch(r'-?\\d{1,3}(,\\d{3})*(\\.\\d+)?',s) and ',' in s: return float(s.replace(',',''))\n    if re.fullmatch(r'-?\\d{1,3}(\\.\\d{3})+',s): return float(s.replace('.',''))\n    return float(s.replace(',',''))\n\nd=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates().reset_index(drop=True)\nd['q']=pd.to_numeric(d['so_luong'])\nd['dt']=parse_date(d['Ngày giao dịch'])\nbad=d['Status'].str.contains('hủy|huỷ|trả|hoàn',case=False,na=False)|(d.q<0)\nbo=set(d[bad]['Mã hóa đơn'])\nd=d[~d['Mã hóa đơn'].isin(bo)].copy()\nd['v']=d['Trị giá'].map(money)\n\nx=d[(d.dt>='2025-03-27')&(d.dt<='2025-04-02')]\nRESULT=float(x.v.sum())\n", "_attempts": 1, "_verdict": "correct"}
