{"id": "q_845f5b9b9c82", "type": "string", "answer": "Snack Oishi tôm cay 40g", "_code": "d=DonHang_ChiTiet__all.copy()\nd[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']]=d[['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']].ffill()\nd=d.drop_duplicates()\nd['d']=parse_date(d['Ngày đặt hàng'])\nbad=d.loc[d['Trạng thái đơn hàng'].str.contains('hủy|huỷ|trả',case=False,na=False),'Mã đơn hàng'].unique()\nref=pd.Timestamp(as_of_date); mon=ref-pd.Timedelta(days=ref.weekday()); s,e=mon-pd.Timedelta(days=7),mon-pd.Timedelta(days=1)\nd=d[~d['Mã đơn hàng'].isin(bad)&(d.d>=s)&(d.d<=e)]\nd['q']=pd.to_numeric(d['Số lượng sản phẩm'].astype(str).str.extract(r'^\\s*([\\d.,]+)')[0].str.replace(',','.'),errors='coerce')\nf={(r['Tên sản phẩm'],r['Đơn vị quy đổi']):float(r['Tỉ lệ quy đổi']) for _,r in DanhSachQuyDoi.iterrows()}\nd['q']=d.q*[f.get((n,u),1) for n,u in zip(d['Tên sản phẩm'],d['Đơn vị tính'])]\nRESULT=d.groupby('Tên sản phẩm').q.sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_d28ba56752c1", "type": "number", "answer": 180.0, "_code": "\no=don_hang.drop_duplicates('Mã chứng từ').copy()\no['d']=parse_date(o['NgayBan'])\no=o[(o.d==pd.Timestamp(as_of_date)-pd.Timedelta(days=1))&~o['Xử lý'].isin(['cancelled','returned'])]\nl=chi_tiet_don.drop_duplicates()\nl=l[l['Ma don'].isin(o['Mã chứng từ'])]\nsp=san_pham.set_index('SKU')['Đơn vị']\nl=l[l['ID SP'].map(sp)=='ly']\nRESULT=float(pd.to_numeric(l['SL quy đổi'].astype(str).str.replace(',',''),errors='coerce').sum())\n", "_attempts": 1, "_verdict": "correct"}
