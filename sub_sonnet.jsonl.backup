{"id": "q_fbce2202d8da", "type": "percent", "answer": 16.62, "_code": "import re\no=don_hang.copy(); c=chi_tiet_don.copy()\no['d']=parse_date(o['NgayBan'])\nc['t']=to_num(c['T.Tiền'])\nok=o[o['Xử lý'].isin(['completed','shipping'])]\nrev=c.merge(ok[['Mã chứng từ','d']],left_on='Ma don',right_on='Mã chứng từ').groupby('d').t.sum()\ndef R(a,b): return rev[(rev.index>=a)&(rev.index<=b)].sum()\na=R('2026-04-01','2026-04-30'); b=R('2025-04-01','2025-04-30')\nRESULT=f\"{round((a-b)/b*100,2)}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_67e2cfa0df1d", "type": "number", "answer": 4510000, "_code": "o=don_hang.copy(); c=chi_tiet_don.copy()\no['d']=parse_date(o['NgayBan']); c['t']=to_num(c['T.Tiền'])\nok=o[o['Xử lý'].isin(['completed','shipping'])]\nm=c.merge(ok[['Mã chứng từ','d']],left_on='Ma don',right_on='Mã chứng từ')\nsp=san_pham[san_pham['Sản phẩm'].str.strip().str.lower()=='trà sữa trân châu (l)']['SKU'].tolist()\nx=m[(m.d>='2025-02-01')&(m.d<='2025-02-28')&(m['ID SP'].isin(sp))]\nRESULT=int(round(x.t.sum()))\n", "_attempts": 1, "_verdict": "correct"}
