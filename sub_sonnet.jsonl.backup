{"id": "q_ef9ec0a860f8", "type": "number", "answer": 9792001, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\nd=don_hang.copy(); d['dt']=pd.to_datetime(d['Ngày'])\nd=d[(d['Trả bằng']=='debt')&(d['Tình trạng']!='cancelled')]\nt=thanh_toan.copy(); t['t']=pd.to_datetime(t['Ngày thu'])\nt=t.merge(d[['Mã chứng từ','dt']],left_on='Số CT',right_on='Mã chứng từ')\nt=t[(t.t.dt.normalize()>t.dt)&(t.t>='2026-06-01')&(t.t<'2026-07-01')]\nRESULT=int(round(t['Giá trị'].map(money).sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_81044c9adbba", "type": "percent", "answer": 35.71, "_code": "d=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\nd['dd']=parse_date(d['Ngày giao dịch'])\nd['q']=to_num(d['so_luong'])\nd['bad']=d['Status'].str.contains('hủy|huỷ|trả|Hoàn trả',case=False,na=False)\nsel=d[(d['Hàng'].str.strip().str.lower()=='cappuccino (l)')&~d.bad]\na=sel[(sel.dd>='2025-09-24')&(sel.dd<='2025-09-30')].q.sum()\nb=sel[(sel.dd>='2025-09-17')&(sel.dd<='2025-09-23')].q.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_5f7e8fb41a29", "type": "percent", "answer": 1.82, "_code": "d=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates()\nd['dd']=parse_date(d['Ngày giao dịch'])\nd['q']=to_num(d['so_luong'])\nd['bad']=d['Status'].str.contains('hủy|huỷ|trả|Hoàn trả',case=False,na=False)\npos=d[d.q>0].drop_duplicates('Mã hóa đơn')\npos=pos[(pos.dd>='2026-04-01')&(pos.dd<='2026-04-30')]\nc=pos['Status'].str.contains('hủy|huỷ',case=False,na=False).sum()\nRESULT=f\"{round(c/len(pos)*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4ba19937fdda", "type": "percent", "answer": 33.33, "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+,\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\na=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[hc]=a[hc].ffill()\na=a.drop_duplicates()\nbad=set(a[a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'])\na=a[~a['Mã đơn hàng'].isin(bad)].copy()\na['dt']=parse_date(a['Ngày đặt hàng']); a['v']=a['Tổng tiền'].map(money)\na['q']=pd.to_numeric(a['Số lượng sản phẩm'],errors='coerce')\na['n']=a['Tên sản phẩm'].map(normalize_text)\n\nx=a[(a.n==normalize_text('Povidine 10% chai 90ml'))&(a['Đơn vị tính']=='chai')]\ns=pd.Timestamp('2026-03-14')\npost=x[(x.dt>=s)&(x.dt<=s+pd.Timedelta(days=6))].q.sum()\npre=x[(x.dt>=s-pd.Timedelta(days=7))&(x.dt<s)].q.sum()\nRESULT=f\"{round((post-pre)/pre*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8af350dfb3b7", "type": "percent", "answer": 11.49, "_code": "\nimport re\ndef money(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*1e6+(int(m.group(2).ljust(3,'0')[:3])*1e3 if m.group(2) else 0)\n    elif re.fullmatch(r'\\d+,\\d+tr',s): v=float(s[:-2].replace(',','.'))*1e6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1e3\n    else: v=float(s.replace('.','').replace(',',''))\n    return -v if neg else v\na=pd.concat([DonHang_ChiTiet_1__all,DonHang_ChiTiet_2026__all],ignore_index=True)\nhc=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\na[hc]=a[hc].ffill()\na=a.drop_duplicates()\nbad=set(a[a['Trạng thái đơn hàng'].str.contains('hủy|huỷ|cancel|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'])\na=a[~a['Mã đơn hàng'].isin(bad)].copy()\na['dt']=parse_date(a['Ngày đặt hàng']); a['v']=a['Tổng tiền'].map(money)\na['q']=pd.to_numeric(a['Số lượng sản phẩm'],errors='coerce')\na['n']=a['Tên sản phẩm'].map(normalize_text)\n\ng=set(DanhSachSanPham[DanhSachSanPham['Loại sản phẩm'].str.strip().str.lower()=='ho cảm cúm']['Tên sản phẩm'].map(normalize_text))\nx=a[(a.dt>='2025-09-01')&(a.dt<='2025-09-30')]\nRESULT=f\"{round(x[x.n.isin(g)].v.sum()/x.v.sum()*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7b7e9b737498", "type": "percent", "answer": 17.62, "_code": "import re, numpy as np\ndef money(x):\n    if pd.isna(x): return np.nan\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    if s=='' : return np.nan\n    neg=s.startswith('-'); s=s.lstrip('-+')\n    m=re.fullmatch(r'(\\d+)(?:[,.](\\d+))?tr(\\d*)',s)\n    if m:\n        a,b,c=m.groups()\n        v=int(a)*1e6+(float('0.'+b)*1e6 if b else 0)+(int(c.ljust(3,'0'))*1e3 if c else 0)\n    elif re.fullmatch(r'[\\d.,]+k',s):\n        v=float(s[:-1].replace(',','.'))*1000\n    elif ',' in s and '.' in s:\n        v=float(s.replace(',',''))\n    elif re.fullmatch(r'\\d{1,3}(\\.\\d{3})+',s) or re.fullmatch(r'\\d{1,3}(,\\d{3})+',s):\n        v=float(re.sub(r'[.,]','',s))\n    else:\n        try: v=float(s.replace(',','.'))\n        except: v=np.nan\n    return -v if neg else v\na=Bao_cao_ban_hang__So_chi_tiet_ban_hang.drop_duplicates().copy()\nh=Bao_cao_ban_hang__Danh_sách_hàng_hóa if 'Bao_cao_ban_hang__Danh_sách_hàng_hóa' in globals() else [v for k,v in Bao_cao_ban_hang.items() if k.startswith('Danh')][0]\na['d']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na=a[(a.d>='2025-08-01')&(a.d<='2025-08-31')]\na=a[~a['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao được',case=False,na=False)]\na['v']=a['Thành tiền'].map(money)\na['g']=join_by_name(a,'Tên hàng hóa',h,'Tên hàng hóa','Nhóm hàng hóa')\nRESULT=f\"{a[a.g=='sơn'].v.sum()/a.v.sum()*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
