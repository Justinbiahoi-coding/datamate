{"id": "q_3a28ee2a98fd", "type": "date", "answer": "2025-09-05", "_code": "d=SoBanHang.copy()\nd=d[~d['Trạng thái xử lý'].astype(str).str.contains('hủy|huỷ|trả',case=False,na=False)]\nd['d']=parse_date(d['ngay_ban'])\nd['amt']=to_num(d['Tổng tiền'])\nd=d[(d.d.dt.year==2025)&(d.d.dt.month==9)]\ng=d.groupby('d')['amt'].sum().sort_values(ascending=False)\nRESULT=g.index[0].strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6d6f14c7978d", "type": "list", "answer": [1454703600, 1442924600, 1627106800], "_code": "import re\ndef pm(x):\n    if pd.isna(x): return float('nan')\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('vnd','').replace('₫','').strip()\n    m=re.fullmatch(r'(\\d+)\\s*tr\\s*(\\d*)',s)\n    if m:\n        f=m.group(2); return int(m.group(1))*1e6+(int(f.ljust(3,'0')[:3])*1000 if f else 0) if len(f)<=3 else float('nan')\n    m=re.fullmatch(r'([\\d.,]+)\\s*k',s)\n    if m: return float(m.group(1).replace(',','.'))*1000\n    if re.fullmatch(r'\\d{1,3}(,\\d{3})+\\.\\d+',s): return float(s.replace(',',''))\n    if re.fullmatch(r'\\d{1,3}([.,]\\d{3})+',s): return float(re.sub(r'[.,]','',s))\n    if re.fullmatch(r'\\d+[.,]\\d{1,2}',s): return float(s.replace(',','.'))\n    try: return float(s)\n    except: return float('nan')\nd=So_chi_tiet_ban_hang__all.reset_index(drop=True)\nd['dt']=parse_date(d['Ngày'])\nbad=d[d['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)].drop_duplicates()\nd['t']=d['Thành tiền'].apply(pm)\nRESULT=[int(round(d[(d.dt.dt.year==2025)&(d.dt.dt.month==m)].t.sum())) for m in (7,8,9)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bb1d24dfdf7a", "type": "date", "answer": "2026-01-18", "_code": "o=DonHang_ChiTiet.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\no[h]=o[h].ffill()\no=o.drop_duplicates()\no['d']=pd.to_datetime(o['Ngày đặt hàng'],format='%d/%m/%Y')\no['amt']=to_num(o['Tổng tiền']); o['q']=to_num(o['Số lượng sản phẩm'])\nbad=set(o[o['Trạng thái đơn hàng'].isin(['Đã hủy','Đã hoàn hàng'])]['Mã đơn hàng'])\ng=o[~o['Mã đơn hàng'].isin(bad)]\nqd=DuLieuXuat__DanhSachQuyDoi\nf={(r['Tên sản phẩm'],r['Đơn vị quy đổi']):r['Tỉ lệ quy đổi'] for _,r in qd.iterrows()}\ng=g.assign(base=[x*f.get((n,u),1) for x,n,u in zip(g.q,g['Tên sản phẩm'],g['Đơn vị tính'])])\nx=g[(g.d>='2026-01-01')&(g.d<='2026-01-31')]\nRESULT=x.groupby('d').amt.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_cae59e126590", "type": "date", "answer": "2026-03-14", "_code": "\nd=SoBanHang.copy(); d['d']=parse_date(d['Ngày tháng'])\ndef mn(x):\n    if isinstance(x,(int,float)): return float(x)\n    return float(str(x).replace('đ','').replace('.','').replace(',',''))\nd['amt']=d['Thành tiền (đ)'].apply(mn)\nm=d[~d['Trạng thái đơn'].str.contains('hủy|huỷ|trả',case=False)&(d.d>='2026-03-01')&(d.d<'2026-04-01')]\nRESULT=str(m.groupby(m.d.dt.date).amt.sum().idxmax())", "_attempts": 1, "_verdict": "correct"}
{"id": "q_7292dd37232d", "type": "number", "answer": 131825900, "_code": "\nh=BanHang_HoaDon.copy(); h['t']=pd.to_datetime(h['Giờ tạo đơn'])\nok=h[~h['Trạng thái'].isin(['Không giao được','Đổi trả'])]\nm=ok[(ok.t>='2025-01-01')&(ok.t<'2025-02-01')&(ok.t.dt.hour>=6)&(ok.t.dt.hour<14)]\nRESULT=int(to_num(m['Tiền hàng trước giảm']).sum())", "_attempts": 1, "_verdict": "correct"}
{"id": "q_4d62702edd62", "type": "list", "answer": ["Tiffy Dey hộp 25 vỉ x 4 viên", "Hapacol 250 hộp 24 gói", "Smecta hộp 30 gói"], "_code": "o=DonHang_ChiTiet.copy()\nh=['Mã đơn hàng','Ngày đặt hàng','Trạng thái đơn hàng','Tên khách hàng']\no[h]=o[h].ffill()\no=o.drop_duplicates()\no['d']=pd.to_datetime(o['Ngày đặt hàng'],format='%d/%m/%Y')\no['amt']=to_num(o['Tổng tiền']); o['q']=to_num(o['Số lượng sản phẩm'])\nbad=set(o[o['Trạng thái đơn hàng'].isin(['Đã hủy','Đã hoàn hàng'])]['Mã đơn hàng'])\ng=o[~o['Mã đơn hàng'].isin(bad)]\nqd=DuLieuXuat__DanhSachQuyDoi\nf={(r['Tên sản phẩm'],r['Đơn vị quy đổi']):r['Tỉ lệ quy đổi'] for _,r in qd.iterrows()}\ng=g.assign(base=[x*f.get((n,u),1) for x,n,u in zip(g.q,g['Tên sản phẩm'],g['Đơn vị tính'])])\nt=pd.Timestamp(as_of_date); s=t-pd.Timedelta(days=t.weekday()+7); e=s+pd.Timedelta(days=6)\nx=g[(g.d>=s)&(g.d<=e)]\nRESULT=list(x.groupby('Tên sản phẩm').base.sum().sort_values(ascending=False).head(3).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_20aa992c0d3f", "type": "date", "answer": "2026-05-09", "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=ban_hang.copy().drop_duplicates()\nst=df['Kết quả'].astype(str).str.lower()\nbad=set(df.loc[st.str.contains('hủy|huỷ|trả|hoàn hàng'),'Mã hóa đơn'])\ndf=df[~df['Mã hóa đơn'].isin(bad)]\ndf['d']=parse_date(df['Ngày tháng']); df['a']=df['Thanh tien'].map(m)\nw=df[(df.d>='2026-05-01')&(df.d<'2026-06-01')]\nRESULT=str(w.groupby('d').a.sum().idxmax().date())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bbd22de66e7e", "type": "number", "answer": 27, "_code": "a=So_chi_tiet_ban_hang__all.drop_duplicates().copy()\na['d']=pd.to_datetime(a['Ngày'],format='%d/%m/%Y')\na=a[(a.d.dt.year==2025)&(a.d.dt.month==7)]\nbad=a.groupby('Mã đơn hàng')['Trạng thái'].apply(lambda s:s.str.contains('hủy|huỷ|trả',case=False).any())\na=a[a['Mã đơn hàng'].isin(bad[~bad].index)]\nn=a.groupby('Tên hàng hóa')['Mã đơn hàng'].nunique()\nRESULT=int((n>=42).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_af2916afaf8e", "type": "number", "answer": 5822500, "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=DonHang_ChiTiet__all.copy()\noc=[c for c in df.columns if df[c].isna().mean()>0.3 and c not in ('Tổng tiền',)]\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\nst=df['Trạng thái đơn hàng'].astype(str).str.lower()\nbad=set(df.loc[st.str.contains('hủy|huỷ|hoàn hàng|trả'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf['d']=parse_date(df['Ngày đặt hàng']); df['a']=df['Tổng tiền'].map(m)\nRESULT=int(round(df[df.d==pd.Timestamp(as_of_date)].a.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_3ec323f48d62", "type": "string", "answer": "Kiều Khoa Thu", "_code": "\nd=DonHang_ChiTiet.copy().drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd['m']=to_num(d['Tổng tiền'])\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\n\nx=d[(d.dt>='2026-01-01')&(d.dt<'2026-02-01')&(d['Tên khách hàng'].map(normalize_text)!='khach le')]\nRESULT=x.groupby('Tên khách hàng')['m'].sum().idxmax()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_307ac5840cca", "type": "percent", "answer": 3.7, "_code": "\nd=DonHang_ChiTiet.copy().drop_duplicates()\nd['dt']=parse_date(d['Ngày đặt hàng'])\nd['m']=to_num(d['Tổng tiền'])\nbad=d[d['Trạng thái đơn hàng'].str.contains('hủy|hoàn hàng|trả',case=False,na=False)]['Mã đơn hàng'].unique()\nd=d[~d['Mã đơn hàng'].isin(bad)]\n\na=d[(d.dt>='2026-05-01')&(d.dt<'2026-06-01')].m.sum(); b=d[(d.dt>='2026-04-01')&(d.dt<'2026-05-01')].m.sum()\nRESULT=f\"{round((a-b)/b*100,2):.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_9a288f7ce6e4", "type": "number", "answer": 68, "_code": "d=don_hang.copy()\nd['dt']=parse_date(d['NgayLap'])\nd=d[(d.dt>='2026-05-01')&(d.dt<='2026-05-31')&(d.TinhTrang.isin(['completed','shipping']))].drop_duplicates('MaHoaDon')\nd=d[d.MaKhachHang.notna()&(d.MaKhachHang.astype(str).str.strip()!='')]\nc=d.groupby('MaKhachHang').size()\nRESULT=int((c>=5).sum())\n", "_attempts": 1, "_verdict": "correct"}
