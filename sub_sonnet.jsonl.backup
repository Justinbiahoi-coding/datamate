{"id": "q_3a6fd46da72a", "type": "list", "answer": [437360000, 459715500], "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\nd=don_hang.copy(); c=chi_tiet_don.copy().drop_duplicates()\nd=d[d['Tình trạng'].isin(['completed','shipping'])]\nd['dt']=parse_date(d['Ngày'])\nc['a']=c['Amount'].map(m)\nc=c.merge(d[['Mã chứng từ','dt','Trả bằng']],left_on='Mã đơn hàng',right_on='Mã chứng từ')\nw=c[(c.dt>='2025-10-01')&(c.dt<'2025-11-01')]\ng=w.groupby('Trả bằng').a.sum()\nRESULT=[int(round(g.get('transfer',0))),int(round(g.get('cash',0)))]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_151d139d77ca", "type": "list", "answer": ["Chung Huy Sơn", "Lý Bình Dũng", "Giang Lan Ngọc"], "_code": "import re\ndef m(s):\n    s=str(s).strip().lower().replace('đ','').replace(' ','')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    mm=re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if mm:\n        v=int(mm.group(1))*1000000\n        if mm.group(2): v+=int(mm.group(2).ljust(3,'0'))*1000\n    elif re.fullmatch(r'\\d+k',s): v=int(s[:-1])*1000\n    elif re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=int(s.replace('.',''))\n    elif re.fullmatch(r'\\d+(,\\d{3})+(\\.0+)?',s): v=int(s.split('.')[0].replace(',',''))\n    else:\n        try: v=float(s)\n        except: v=0.0\n    return -v if neg else v\n\ndf=DonHang_ChiTiet__all.copy()\noc=[c for c in df.columns if df[c].isna().mean()>0.3 and c not in ('Tổng tiền',)]\ndf[oc]=df[oc].ffill()\ndf=df.drop_duplicates()\nst=df['Trạng thái đơn hàng'].astype(str).str.lower()\nbad=set(df.loc[st.str.contains('hủy|huỷ|hoàn hàng|trả'),'Mã đơn hàng'])\ndf=df[~df['Mã đơn hàng'].isin(bad)]\ndf['d']=parse_date(df['Ngày đặt hàng']); df['a']=df['Tổng tiền'].map(m)\nw=df[(df.d>='2026-03-01')&(df.d<'2026-04-01')]\nw=w[~w['Tên khách hàng'].astype(str).str.lower().str.strip().isin(['khách lẻ','kl','lẻ','khach le'])]\nRESULT=list(w.groupby('Tên khách hàng').a.sum().sort_values(ascending=False).head(3).index)\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_46c28b67e33a", "type": "percent", "answer": 14.89, "_code": "\no=don_hang[~don_hang.TinhTrang.isin(['cancelled','returned'])].copy(); o['d']=parse_date(o['NgayLap'])\nc=chi_tiet_don.drop_duplicates().copy(); c['amt']=to_num(c['TriGia'])\ns=c.groupby('MaHoaDon').amt.sum()\no['r']=o['MaHoaDon'].map(s)\na=o[(o.d>='2026-03-01')&(o.d<'2026-04-01')].r.sum(); b=o[(o.d>='2026-02-01')&(o.d<'2026-03-01')].r.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\" ", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e2c5b02df95c", "type": "percent", "answer": -8.4, "_code": "\no=don_hang.drop_duplicates().copy(); o['d']=parse_date(o['NgayBan'])\no=o[~o['Xử lý'].isin(['cancelled','returned'])]\nc=chi_tiet_don.copy(); c['amt']=to_num(c['T.Tiền'])\no['r']=o['Mã chứng từ'].map(c.groupby('Ma don').amt.sum())\na=o[(o.d>='2025-02-01')&(o.d<'2025-03-01')].r.sum(); b=o[(o.d>='2025-01-01')&(o.d<'2025-02-01')].r.sum()\nRESULT=f\"{(a-b)/b*100:.2f}%\" ", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b710460c01da", "type": "list", "answer": [17000, 8500], "_code": "h=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[(h['Phương thức thanh toán']=='Ghi nợ')&~h['Trạng thái'].astype(str).str.contains('hủy|huỷ',case=False,na=False)]\nh['tot']=to_num(h['Tổng sau giảm giá'])\nsq=SoQuy.copy()\nsq['v']=sq['Giá trị'].astype(str).str.replace('đ','').str.replace('.','').astype(float)\nsq['t']=parse_date(sq['Thời gian']).dt.normalize()\nsq=sq.merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\nS,E='2026-07-01','2026-07-31'\nhh=h[h['Mã KH']=='KH0156']\nsame=sq[sq.t==sq.d].groupby('Mã hóa đơn').v.sum()\na=hh[(hh.d>=S)&(hh.d<=E)]\nadd=(a.tot-a['Mã hóa đơn'].map(same).fillna(0)).sum()\nsp=sq[sq['Mã hóa đơn'].isin(set(hh['Mã hóa đơn']))]\npay=sp[(sp.t>sp.d)&(sp.t>=S)&(sp.t<=E)].v.sum()\nRESULT=[int(round(add)),int(round(pay))]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_426baab167a3", "type": "list", "answer": [78000, 25000], "_code": "h=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[(h['Phương thức thanh toán']=='Ghi nợ')&~h['Trạng thái'].astype(str).str.contains('hủy|huỷ',case=False,na=False)]\nh['tot']=to_num(h['Tổng sau giảm giá'])\nsq=SoQuy.copy()\nsq['v']=sq['Giá trị'].astype(str).str.replace('đ','').str.replace('.','').astype(float)\nsq['t']=parse_date(sq['Thời gian']).dt.normalize()\nsq=sq.merge(h[['Mã hóa đơn','d']],on='Mã hóa đơn')\nS,E='2025-07-01','2025-07-31'\nhh=h[h['Mã KH']=='KH0038']\nsame=sq[sq.t==sq.d].groupby('Mã hóa đơn').v.sum()\na=hh[(hh.d>=S)&(hh.d<=E)]\nadd=(a.tot-a['Mã hóa đơn'].map(same).fillna(0)).sum()\nsp=sq[sq['Mã hóa đơn'].isin(set(hh['Mã hóa đơn']))]\npay=sp[(sp.t>sp.d)&(sp.t>=S)&(sp.t<=E)].v.sum()\nRESULT=[int(round(add)),int(round(pay))]\n", "_attempts": 1, "_verdict": "correct"}
