{"id": "q_cd191850b1fb", "type": "date", "answer": "2026-03-14", "_code": "h=DanhSachHoaDon__all.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả',case=False,na=False)]\nh=h[(h.d>='2026-03-01')&(h.d<='2026-03-31')]\nl=DanhSachHoaDonChiTiet.drop_duplicates()\nl=l[l['Mã hóa đơn'].isin(h['Mã hóa đơn'])].copy()\nl['v']=to_num(l['Thành tiền'])\nl['d']=l['Mã hóa đơn'].map(h.set_index('Mã hóa đơn')['d'])\nRESULT=l.groupby('d').v.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b1ded3f92782", "type": "list", "answer": [9, 2], "_code": "\nX=data['DuLieuXuat']\nsku=X['DanhSachSanPham']; sku=sku[sku['Tên sản phẩm'].map(normalize_text)==normalize_text('Amoxicillin 500mg Domesco hộp 10 vỉ x 10 viên')]['Mã SKU'].iloc[0]\nnh=X['DonNhapHang'].copy(); nh['d']=parse_date(nh['Ngày nhập']); nh=nh[nh.d<=pd.Timestamp(as_of_date)]\nct=X['DonNhapHang_ChiTiet']; ct=ct[ct['Mã đơn nhập'].isin(nh['Mã đơn nhập'])&(ct['Mã SKU']==sku)]\nnhap=to_num(ct['Số lượng nhập']).sum()\nlots=set(X['DonNhapHang_ChiTiet'].loc[X['DonNhapHang_ChiTiet']['Mã SKU']==sku,'Mã lô'])\no=data['DonHang_ChiTiet'].drop_duplicates(['Mã đơn hàng','Tên sản phẩm','Số lượng sản phẩm','Đơn vị tính'])\no=o.groupby('Mã đơn hàng',as_index=False).agg({'Ngày đặt hàng':'first','Trạng thái đơn hàng':'first'}); o['d']=parse_date(o['Ngày đặt hàng'])\nokids=o[~o['Trạng thái đơn hàng'].str.contains('hủy|huỷ',case=False,na=False)&(o.d<=pd.Timestamp(as_of_date))]['Mã đơn hàng']\nL=X['DonHang_Lo']; L=L[L['Mã lô'].isin(lots)&L['Mã đơn hàng'].isin(okids)]\nban=(to_num(L['Số lượng'])-to_num(L['Số lượng trả'])).sum()\nt=int(nhap-ban)\nRESULT=[t//10,t%10]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_99a0f6d709bd", "type": "number", "answer": 31, "_code": "d = danh_sach_hoa_don.copy()\nd['d'] = parse_date(d['Ngày giao dịch'])\nd = d[d.d==pd.Timestamp(as_of_date)]\nd = d[~d['Status'].str.contains('hủy|huỷ|trả', case=False, na=False)]\nRESULT = int(d['Mã bill'].nunique())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_88c8483da44a", "type": "date", "answer": "2026-03-22", "_code": "import re as _re\ndef mny(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=_re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*10**6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    elif _re.fullmatch(r'\\d+[,.]\\d+tr',s): v=float(s[:-2].replace(',','.'))*10**6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    elif _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?|\\d+\\.0{4,}|\\d+\\.\\d{1,2}',s): v=float(s.replace(',',''))\n    elif _re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    else: v=float(_re.sub(r'[^\\d.]','',s.replace(',','')) or 'nan')\n    return -v if neg else v\no=don_hang.drop_duplicates('Số phiếu').copy(); o['d']=parse_date(o['Ngày bán'])\no=o[~o['Tình trạng đơn'].isin(['cancelled','returned'])]\nl=chi_tiet_don.drop_duplicates()\nl=l[l['Số CT'].isin(o['Số phiếu'])].copy(); l['t']=l['Tiền bán'].map(mny)\nl=l.merge(o[['Số phiếu','d']],left_on='Số CT',right_on='Số phiếu')\nx=l[(l.d>='2026-03-01')&(l.d<'2026-04-01')]\nRESULT=x.groupby('d').t.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 3, "_verdict": "correct"}
{"id": "q_5cc913d371cd", "type": "percent", "answer": -3.71, "_code": "import re as _re\ndef mny(x):\n    s=str(x).strip().lower().replace('đ','').replace(' ','')\n    if s in ('','nan','none'): return float('nan')\n    neg=s.startswith('-'); s=s.lstrip('-')\n    m=_re.fullmatch(r'(\\d+)tr(\\d*)',s)\n    if m: v=int(m.group(1))*10**6+(int(m.group(2).ljust(3,'0'))*1000 if m.group(2) else 0)\n    elif _re.fullmatch(r'\\d+[,.]\\d+tr',s): v=float(s[:-2].replace(',','.'))*10**6\n    elif s.endswith('k'): v=float(s[:-1].replace(',','.'))*1000\n    elif _re.fullmatch(r'\\d+(,\\d{3})+(\\.\\d+)?|\\d+\\.0{4,}|\\d+\\.\\d{1,2}',s): v=float(s.replace(',',''))\n    elif _re.fullmatch(r'\\d+(\\.\\d{3})+',s): v=float(s.replace('.',''))\n    else: v=float(_re.sub(r'[^\\d.]','',s.replace(',','')) or 'nan')\n    return -v if neg else v\no=don_hang.drop_duplicates('Số phiếu').copy(); o['d']=parse_date(o['Ngày bán'])\no=o[~o['Tình trạng đơn'].isin(['cancelled','returned'])]\nl=chi_tiet_don.drop_duplicates()\nl=l[l['Số CT'].isin(o['Số phiếu'])].copy(); l['t']=l['Tiền bán'].map(mny)\nl=l.merge(o[['Số phiếu','d']],left_on='Số CT',right_on='Số phiếu')\na=l[(l.d>='2026-07-01')&(l.d<'2026-08-01')].t.sum(); b=l[(l.d>='2025-07-01')&(l.d<'2025-08-01')].t.sum()\nRESULT=f'{(a-b)/b*100:.2f}%'\n", "_attempts": 3, "_verdict": "correct"}
{"id": "q_e6f31d9b2f3e", "type": "date", "answer": "2025-09-06", "_code": "import re\ndef pm(x):\n    if isinstance(x,(int,float)): return float(x)\n    x=str(x).strip().lower().replace('đ','').replace(' ','')\n    m=re.match(r'^(-?[\\d,\\.]+)(tr|k)?$',x)\n    if not m: return float('nan')\n    n,u=m.groups()\n    if u=='tr': return float(n.replace(',','.'))*1e6\n    if u=='k': return float(n.replace(',','.'))*1e3\n    return float(n.replace(',','').replace('.',''))\nd=ban_hang.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày bán'])\nbad=d[d['Trạng thái xử lý'].str.contains('hủy|huỷ|trả',case=False,na=False)]['Số phiếu'].unique()\nd=d[~d['Số phiếu'].isin(bad)&(d.dt>='2025-09-01')&(d.dt<='2025-09-30')]\nd['v']=d['Amount'].map(pm)\nRESULT=d.groupby('dt').v.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0fc33ac2add7", "type": "boolean", "answer": false, "_code": "\nh=data['BanHang_HoaDon'].drop_duplicates('Order ID').copy(); h['d']=parse_date(h['Ngày bán'])\nh=h[h['Trạng thái'].isin(['Đã giao','Đang vận chuyển'])]\ndet=data['BanHang_ChiTietHoaDon'].drop_duplicates(['Mã giao dịch','TT dòng']).copy()\ndet['amt']=to_num(det['Thanh tien'])\nh['rev']=h['Order ID'].map(det.groupby('Mã giao dịch')['amt'].sum()).fillna(0)\nv=[h[(h.d.dt.year==2025)&(h.d.dt.month==m)].rev.sum() for m in (4,5,6)]\nprint(v)\nRESULT=bool(v[0]<v[1]<v[2])\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b89b4faddfec", "type": "list", "answer": ["Cà phê sữa (M)", "Trà đào cam sả (M)", "Cà phê đen (M)"], "_code": "d = pd.concat([SoBanHang_1__all, SoBanHang_2026__all], ignore_index=True)\nd['d'] = parse_date(d['Ngày giao dịch'])\nd['q'] = to_num(d['so_luong'])\nd = d[(d.d>='2026-01-19')&(d.d<='2026-01-25')]\nbad = d[d['Status'].str.contains('hủy|huỷ|trả', case=False, na=False) | (d.q<0)]['Mã hóa đơn'].unique()\nd = d[~d['Mã hóa đơn'].isin(bad)]\nf = DanhMuc.set_index('Tên món')['Hệ số'].map(float)\nd['mult'] = d.apply(lambda r: f.get(r['Hàng'],1) if r['Unit']=='hộp' else 1, axis=1)\nd['qb'] = d.q*d.mult\ns = d.groupby('Hàng')['qb'].sum().sort_values(ascending=False)\nRESULT = s.index[:3].tolist()\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_ee9d6f998de7", "type": "unanswerable", "answer": "unanswerable", "_code": "cols=' '.join(str(c).lower() for k,v in data.items() if hasattr(v,'columns') for c in v.columns)\nRESULT='unanswerable' if not any(w in cols for w in ['giới tính','gioi tinh','gender','nữ']) else 'check'\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_e25776b49e09", "type": "string", "answer": "Rau muống xào tỏi", "_code": "d=SoBanHang.copy()\nd['dt']=parse_date(d['Ngày tháng'])\nd=d[~d['Trạng thái đơn'].str.contains('hủy|huỷ|trả',case=False,na=False)&(d.dt>='2026-01-01')&(d.dt<='2026-01-31')]\nd=d[d['Ten hang'].str.lower()!='phí phục vụ']\nd['q']=pd.to_numeric(d['SL lẻ'],errors='coerce')\ng=d.groupby('Ten hang').q.sum().reset_index().sort_values(['q','Ten hang'],ascending=[False,True])\nRESULT=g.iloc[0,0]\n", "_attempts": 2, "_verdict": "correct"}
{"id": "q_205821096a29", "type": "date", "answer": "2026-01-03", "_code": "import re\ndef pm(x):\n    if isinstance(x,(int,float)): return float(x)\n    x=str(x).strip().lower().replace('đ','').replace(' ','')\n    m=re.match(r'^(-?[\\d,\\.]+)(tr|k)?$',x)\n    if not m: return float('nan')\n    n,u=m.groups()\n    if u=='tr': return float(n.replace(',','.'))*1e6\n    if u=='k': return float(n.replace(',','.'))*1e3\n    return float(n.replace(',','').replace('.',''))\nd=SoBanHang.copy()\nd['dt']=parse_date(d['Ngày tháng'])\nd=d[~d['Trạng thái đơn'].str.contains('hủy|huỷ|trả',case=False,na=False)&(d.dt>='2026-01-01')&(d.dt<='2026-01-31')]\nd['v']=d['Thành tiền (đ)'].map(pm)\nRESULT=d.groupby('dt').v.sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_6b97346f858f", "type": "string", "answer": "Đinh Đức Bích", "_code": "h = DanhSachHoaDon.copy()\nh['d'] = parse_date(h['Thời gian'])\nbad = h['Trạng thái'].astype(str).str.contains('hủy|huỷ|cancel|trả|hoàn trả', case=False, na=False)\nh = h[~bad & h['Mã KH'].notna() & (h['Mã KH'].astype(str).str.strip()!='')]\nh = h[(h['d']>='2025-07-01')&(h['d']<='2025-07-31')]\nh = h.drop_duplicates('Mã hóa đơn')\nc = h.groupby('Mã KH').size().sort_values(ascending=False)\ntop = c[c==c.max()].index.sort_values()[0]\nk = DanhSachKhachHang\nRESULT = k.loc[k['Mã khách hàng']==top,'Tên khách hàng'].iloc[0]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_bc83ba885777", "type": "number", "answer": 18163000, "_code": "h=DanhSachHoaDon.drop_duplicates('Mã hóa đơn').copy()\nh['d']=parse_date(h['Thời gian'])\nh=h[~h['Trạng thái'].astype(str).str.contains('hủy|huỷ|trả',case=False)]\nh=h[(h.d>='2025-09-01')&(h.d<='2025-09-30')]\ng=DanhSachSanPham.set_index('Mã hàng')['Nhóm hàng(3 Cấp)']\nc=DanhSachHoaDonChiTiet.drop_duplicates().copy()\nc=c[c['Mã hóa đơn'].isin(h['Mã hóa đơn'])]\nc['g']=c['Mã hàng'].map(g); c['t']=to_num(c['Thành tiền'])\nRESULT=int(round(c[c.g.astype(str).str.lower()=='gạo'].t.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_823a468c0d3c", "type": "percent", "answer": -27.61, "_code": "d = So_chi_tiet_ban_hang__all.copy()\nd['d'] = parse_date(d['Ngày'])\nbad = d[d['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao', case=False, na=False)]['Mã đơn hàng'].unique()\nd = d[~d['Mã đơn hàng'].isin(bad)]\nd = d[d['Tên hàng hóa']=='Thép cuộn phi 6 Hòa Phát']\nd['q'] = to_num(d['Số lượng quy đổi'])\na = d[(d.d>='2026-05-31')&(d.d<='2026-06-13')].q.sum()\nb = d[(d.d>='2026-05-17')&(d.d<='2026-05-30')].q.sum()\nRESULT = f\"{(a-b)/b*100:.2f}%\"\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_73f634377787", "type": "number", "answer": 7, "_code": "import re\ndef pm(x):\n    if isinstance(x,(int,float)): return float(x)\n    x=str(x).strip().lower().replace('đ','').replace(' ','')\n    m=re.match(r'^(-?[\\d,\\.]+)(tr|k)?$',x)\n    if not m: return float('nan')\n    n,u=m.groups()\n    if u=='tr': return float(n.replace(',','.'))*1e6\n    if u=='k': return float(n.replace(',','.'))*1e3\n    return float(n.replace(',','').replace('.',''))\nd=SoBanHang_1__all.drop_duplicates().copy()\nd['dt']=parse_date(d['Ngày giao dịch'])\nd['v']=d['Trị giá'].map(pm)\nbad=d[d['Status'].str.contains('hủy|huỷ|trả|Đổi trả',case=False,na=False)|(pd.to_numeric(d['so_luong'],errors='coerce')<0)]['Mã hóa đơn'].unique()\nd=d[~d['Mã hóa đơn'].isin(bad)&(d.dt>='2025-10-01')&(d.dt<='2025-10-31')]\ng=d.groupby('dt').v.sum()\nRESULT=int((g>=13000000).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_0183529f9d61", "type": "list", "answer": [287435200, 346554700, 309693800], "_code": "import re\ndef pm(x):\n    if isinstance(x,(int,float)): return float(x)\n    x=str(x).strip().lower().replace('đ','').replace(' ','')\n    m=re.match(r'^(-?[\\d,\\.]+)(tr|k)?$',x)\n    if not m: return float('nan')\n    n,u=m.groups()\n    if u=='tr': return float(n.replace(',','.'))*1e6\n    if u=='k': return float(n.replace(',','.'))*1e3\n    return float(n.replace(',','').replace('.',''))\nh=BanHang_HoaDon.drop_duplicates('Order ID').copy()\nh['d']=parse_date(h['Ngày bán'])\nh=h[~h['Trạng thái'].str.contains('hủy|huỷ|trả|Không giao',case=False,na=False)]\nl=BanHang_ChiTietHoaDon.drop_duplicates()\nl=l[l['Mã giao dịch'].isin(h['Order ID'])].copy()\nl['v']=l['Thanh tien'].map(pm)\nl['m']=l['Mã giao dịch'].map(h.set_index('Order ID')['d']).dt.strftime('%Y-%m')\ng=l.groupby('m').v.sum()\nRESULT=[int(round(g.get(k,0))) for k in ['2025-04','2025-05','2025-06']]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_fe14e521d3e0", "type": "list", "answer": [8, 9], "_code": "end = pd.Timestamp(as_of_date)\nnh = DonNhapHang_ChiTiet.merge(DonNhapHang, on='Mã đơn nhập')\nnh['d'] = parse_date(nh['Ngày nhập'])\nnh = nh[(nh['Mã SKU']=='SP0015') & (nh.d<=end)]\nlots = set(nh['Mã lô'])\ninn = to_num(nh['Số lượng nhập']).sum()\n# lot-level base-unit quantities of sales, excluding cancelled orders\nod = pd.concat([DonHang_ChiTiet_1__all, DonHang_ChiTiet_2026__all])\ncanc = set(od[od['Trạng thái đơn hàng'].str.contains('hủy|huỷ', case=False, na=False)]['Mã đơn hàng'])\nlo = pd.concat([DonHang_Lo_1, DonHang_Lo_2])\nlo = lo[lo['Mã lô'].isin(lots) & ~lo['Mã đơn hàng'].isin(canc)]\nout = to_num(lo['Số lượng']).sum() - to_num(lo['Số lượng trả']).sum()\nstock = int(round(inn - out))\nf = DanhSachQuyDoi[(DanhSachQuyDoi['Tên sản phẩm']=='Strepsils Cool hộp 2 vỉ x 12 viên')&(DanhSachQuyDoi['Đơn vị quy đổi']=='hộp')]['Tỉ lệ quy đổi'].astype(float).iloc[0]\nRESULT = [stock//int(f), stock%int(f)]\n", "_attempts": 1, "_verdict": "correct"}
