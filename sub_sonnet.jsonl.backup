{"id": "q_5258a06d7513", "type": "number", "answer": 833310100, "_code": "import re, unicodedata\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    t=str(x).strip().lower().replace('đ','').replace(' ','')\n    neg=t.startswith('-'); t=t.lstrip('-')\n    m0=re.fullmatch(r'(\\d+[,.]\\d+)tr',t)\n    m=re.fullmatch(r'(\\d+)tr(\\d*)',t)\n    if m0: v=round(float(m0.group(1).replace(',','.'))*1_000_000)\n    elif m:\n        a=int(m.group(1))*1_000_000; r=m.group(2)\n        v=a+(int(r.ljust(3,'0')[:3])*1000 if r else 0)\n    elif t.endswith('k'): v=float(t[:-1].replace(',','.'))*1000\n    else: v=float(re.sub(r'[.,]','',t))\n    return -v if neg else v\ndef qty(x):\n    if isinstance(x,(int,float)): return float(x)\n    m=re.match(r'\\s*(-?\\d+(?:[.,]\\d+)?)',str(x)); return float(m.group(1).replace(',','.'))\ns=SoBanHang__all.copy()\ns['dt']=pd.to_datetime(s['Giờ'],errors='coerce')\ns=s[s.dt.notna()&s['Mã phiếu'].notna()].drop_duplicates()\nst=s['Ghi chú TT'].astype(str).str.lower()\nbadm=set(s[st.str.contains('hủy|trả')|(s['Số lượng hàng'].map(qty)<0)]['Mã phiếu'])\ns=s[~s['Mã phiếu'].isin(badm)].copy()\ns['tien']=s['Tiền'].map(money); s['q']=s['Số lượng hàng'].map(qty)\nm=s[(s.dt>='2025-05-01')&(s.dt<'2025-06-01')&(s.dt.dt.hour>=6)&(s.dt.dt.hour<14)]\nRESULT=int(round(m.tien.sum()))\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_1295f18bd2fe", "type": "number", "answer": 29235200, "_code": "s=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy(); s['t']=parse_date(s['Ngày'])\ns=s[s['Trạng thái'].isin(['ok','Thành công','Đang vận chuyển'])]\nRESULT=int(to_num(s[s.t=='2025-10-06']['Thành tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_8e67014c87fb", "type": "number", "answer": 12710000, "_code": "s=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy(); s['t']=parse_date(s['Ngày'])\ns=s[s['Trạng thái'].isin(['ok','Thành công','Đang vận chuyển'])]\nx=s[(s.t>='2026-02-01')&(s.t<='2026-02-28')&s['Tên hàng hóa'].str.contains('40x80',na=False)&s['Tên hàng hóa'].str.contains('1.4mm',na=False)]\nRESULT=int(to_num(x['Thành tiền']).sum())\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_287292f3f5e1", "type": "number", "answer": 1, "_code": "import unicodedata\ndef nk(x):\n    x=unicodedata.normalize('NFD',str(x).lower().replace('đ','d'))\n    return ' '.join(''.join(ch for ch in x if unicodedata.category(ch)!='Mn').split())\ns=Bao_cao_ban_hang['So_chi_tiet_ban_hang'].drop_duplicates().copy(); s['t']=parse_date(s['Ngày'])\ns=s[s['Trạng thái'].isin(['ok','Thành công','Đang vận chuyển'])]\ns['k']=s['Tên hàng hóa'].map(nk)\nbefore=set(s[s.t<'2026-06-20'].k); inp=set(s[(s.t>='2026-06-20')&(s.t<='2026-06-26')].k)\nRESULT=len(before-inp)\n", "_attempts": 3, "_verdict": "correct"}
