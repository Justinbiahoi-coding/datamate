{"id": "q_4e07beda2f37", "type": "list", "answer": [266675100, 263443400, 275971900], "_code": "\nH=DuLieuBanHang['DanhSachHoaDon'].drop_duplicates().copy()\nH['dt']=parse_date(H['Thời gian'])\nH=H[H['Trạng thái'].isin(['đã lấy','Hoàn thành','Đang xử lý'])]\nC=DanhSachHoaDonChiTiet.drop_duplicates().merge(H[['Mã hóa đơn','dt']],on='Mã hóa đơn')\nC['tt']=to_num(C['Thành tiền']); C['qd']=to_num(C['Số lượng quy đổi'])\n\nx=C[(C.dt>='2025-03-01')&(C.dt<='2025-05-31')]\ns=x.groupby(x.dt.dt.month).tt.sum()\nRESULT=[int(round(s[m])) for m in (3,4,5)]\n", "_attempts": 1, "_verdict": "correct"}
{"id": "q_b9c4020a1bf8", "type": "date", "answer": "2025-01-04", "_code": "import re\ndef money(x):\n    if isinstance(x,(int,float)): return float(x)\n    s=str(x).strip().lower().replace('đ','').replace('₫','').replace(' ','')\n    m=re.match(r'^(\\d+)tr(\\d*)$',s)\n    if m:\n        d=m.group(2); return int(m.group(1))*1e6+(int(d.ljust(3,'0')[:3])*1e3 if d else 0)\n    m=re.match(r'^(\\d+)[,.](\\d+)tr$',s)\n    if m: return round(float(m.group(1)+'.'+m.group(2))*1e6)\n    m=re.match(r'^([\\d.,]+)k$',s)\n    if m: return float(m.group(1).replace(',','.'))*1e3\n    m=re.match(r'^[\\d,]+\\.\\d{4}$',s)       # 1,500.0000\n    if m: return float(s.replace(',',''))\n    if re.match(r'^\\d{1,3}(\\.\\d{3})+$',s): return float(s.replace('.',''))\n    if re.match(r'^\\d{1,3}(,\\d{3})+$',s): return float(s.replace(',',''))\n    try: return float(s)\n    except: return float('nan')\no=don_hang.drop_duplicates().copy(); o['d']=parse_date(o['NgayBan'])\no=o[o['Xử lý'].isin(['completed','shipping'])]\nl=chi_tiet_don.drop_duplicates().copy(); l['tt']=l['T.Tiền'].map(money)\nl=l.merge(o[['Mã chứng từ','d']],left_on='Ma don',right_on='Mã chứng từ')\nx=l[(l.d>='2025-01-01')&(l.d<'2025-02-01')]\nRESULT=x.groupby('d')['tt'].sum().idxmax().strftime('%Y-%m-%d')\n", "_attempts": 1, "_verdict": "correct"}
