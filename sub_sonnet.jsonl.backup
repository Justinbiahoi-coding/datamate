{"id": "q_b6e73ed9e8e4", "type": "percent", "answer": -20.88, "_code": "a=pd.concat([SoBanHang_1__all,SoBanHang_2026__all],ignore_index=True).drop_duplicates().copy()\na['dt']=parse_date(a['Ngày giao dịch'])\na['tt']=to_num(a['Trị giá']); a['q']=to_num(a['so_luong'])\na['gio']=pd.to_datetime(a['Giờ'],errors='coerce')\nbad=a['Status'].str.contains('hủy|huỷ|trả|Trả|Hủy|Hoàn trả',case=False,na=False)|(a['q']<0)\nbadorders=set(a.loc[bad,'Mã hóa đơn'])\na=a[~a['Mã hóa đơn'].isin(badorders)]\na=a[(a.dt>='2025-12-01')&(a.dt<='2025-12-31')]\nhr=a.gio.dt.hour\ns=a[(hr>=6)&(hr<14)].tt.sum(); c=a[(hr>=14)&(hr<22)].tt.sum()\nRESULT=str(round((c-s)/s*100,2))+'%'\n", "_attempts": 2, "_verdict": "correct"}
